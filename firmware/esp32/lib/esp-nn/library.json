{
  "name": "esp-nn",
  "version": "1.1.2",
  "description": "espressif/esp-nn v1.1.2 を PlatformIO(Arduino) で組むための写し。ESP32-S3 の命令で畳み込みなどを速くする",
  "license": "Apache-2.0",
  "frameworks": "*",
  "platforms": "espressif32",
  "build": {
    "srcDir": "src",
    "includeDir": "include",
    "srcFilter": [
      "-<*>",
      "+<activation_functions/esp_nn_relu_ansi.c>",
      "+<basic_math/esp_nn_add_ansi.c>",
      "+<basic_math/esp_nn_mul_ansi.c>",
      "+<convolution/esp_nn_conv_ansi.c>",
      "+<convolution/esp_nn_conv_opt.c>",
      "+<convolution/esp_nn_depthwise_conv_ansi.c>",
      "+<convolution/esp_nn_depthwise_conv_opt.c>",
      "+<fully_connected/esp_nn_fully_connected_ansi.c>",
      "+<softmax/esp_nn_softmax_ansi.c>",
      "+<softmax/esp_nn_softmax_opt.c>",
      "+<pooling/esp_nn_avg_pool_ansi.c>",
      "+<pooling/esp_nn_max_pool_ansi.c>",
      "+<common/esp_nn_common_functions_esp32s3.S>",
      "+<common/esp_nn_multiply_by_quantized_mult_esp32s3.S>",
      "+<common/esp_nn_multiply_by_quantized_mult_ver1_esp32s3.S>",
      "+<activation_functions/esp_nn_relu_s8_esp32s3.S>",
      "+<basic_math/esp_nn_add_s8_esp32s3.S>",
      "+<basic_math/esp_nn_mul_s8_esp32s3.S>",
      "+<convolution/esp_nn_conv_esp32s3.c>",
      "+<convolution/esp_nn_depthwise_conv_s8_esp32s3.c>",
      "+<convolution/esp_nn_conv_s16_mult8_esp32s3.S>",
      "+<convolution/esp_nn_conv_s8_mult8_1x1_esp32s3.S>",
      "+<convolution/esp_nn_conv_s16_mult4_1x1_esp32s3.S>",
      "+<convolution/esp_nn_conv_s8_filter_aligned_input_padded_esp32s3.S>",
      "+<convolution/esp_nn_depthwise_conv_s8_mult1_3x3_padded_esp32s3.S>",
      "+<convolution/esp_nn_depthwise_conv_s16_mult1_esp32s3.S>",
      "+<convolution/esp_nn_depthwise_conv_s16_mult1_3x3_esp32s3.S>",
      "+<convolution/esp_nn_depthwise_conv_s16_mult1_3x3_no_pad_esp32s3.S>",
      "+<convolution/esp_nn_depthwise_conv_s16_mult8_3x3_esp32s3.S>",
      "+<convolution/esp_nn_depthwise_conv_s16_mult4_esp32s3.S>",
      "+<convolution/esp_nn_depthwise_conv_s16_mult8_esp32s3.S>",
      "+<fully_connected/esp_nn_fully_connected_s8_esp32s3.S>",
      "+<fully_connected/esp_nn_fully_connected_per_ch_s8_esp32s3.S>",
      "+<pooling/esp_nn_max_pool_s8_esp32s3.S>",
      "+<pooling/esp_nn_avg_pool_s8_esp32s3.S>"
    ],
    "flags": ["-I src/common", "-mlongcalls", "-fno-unroll-loops", "-O2", "-Wno-unused-function"],
    "libArchive": false
  }
}
