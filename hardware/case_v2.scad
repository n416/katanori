//    916mm3 貫いた）。⇒ 関数にして、呼ばれた時点で解決させる
function knob_at_x()   = KNOB_AT[0];   // 🔒 KNOB_AT はこの行より後ろ。関数で遅延させる
// 🔴 **+0.4 では足りない。**つまみの実体の外半径がちょうど 13.5（= 26.2/2 + 0.4）で、
//    逃げが 0 になって面で触れていた（3.2mm3）。⇒ **+1.0** にして 0.6 空ける
// 🔴 **2026-08-21、1.0 → 2.0。**1.0 では AS5600 の基板の角が電池トンネルの端板へ
//    **半径方向に約 1mm** 食い込んでいた（Z 32.2〜33.8 ＝ 基板の厚みの帯・0.851mm3）。
//    ⚠ **体積が小さいことは食い込みが浅いことを意味しない。**この値を 1.5 にすると
//       0.139mm3、2.0 で 0 になる ⇒ 深さは 1mm 級だった。**深さは必ずこうして測る**
KNOB_NOTCH_M = 2.0;   // 逃げの上乗せ。🔒 これを振ると食い込みの深さが測れる
function knob_r()      = knob_dish_d() / 2 + KNOB_NOTCH_M;   // 裾の外半径
function knob_seat_x0() = KNOB_AT[0] - knob_bay_x() / 2;
function knob_seat_x1() = KNOB_AT[0] + knob_bay_x() / 2;
BR_ZT = LIPO_Z;                    // 上面 ＝ 電池の下面
BR_ZB = BR_ZT - BR_DEPTH;          // 下面。🔒 深さは DECK_Z の隣で決めてある
BR_T  = 1.6;                       // 部材の太さ
BR_BAYS = 8;                       // 三角の数（ジグザグの山谷）

// 🔴 **2026-08-20、作り直した。前のは「三角の穴を開けた板」でトラスではなかった。**
//    「横から見た断面がギザギザ」を**立面**と読み違えて、X-Z 面のジグザグを Y に 39mm
//    そのまま押し出していた。断面はスパンに**直角**に取るもので、正しくは Y-Z 面。
//    ⇒ **波板（コルゲート）**にする。山と谷がスパン方向（X）に走り、薄い板が曲げに耐える。
//      段ボールの中芯・トタン屋根と同じ形。
// 🔒 電池を載せる面は平らでなければいけないので、**平らな上板 ＋ その下に波**の構成にする
BR_TOP_T = 1.6;                    // 上板（トンネルの床になる。ここは平ら）
BR_WAVES = 6;                      // 山の数（Y 方向）

// スパンに直角な断面（Y-Z 面）
module bridge_section() {
    // 上板
    translate([BR_Y0, BR_ZT - BR_TOP_T]) square([BR_Y1 - BR_Y0, BR_TOP_T]);
    // 波。上板の裏から下弦の高さまでを行き来する
    st = (BR_Y1 - BR_Y0) / BR_WAVES;
    for (i = [0 : BR_WAVES - 1])
        hull() for (k = [i, i + 1])
            translate([BR_Y0 + k * st,
                       (k % 2 == 0) ? BR_ZB + BR_T / 2 : BR_ZT - BR_TOP_T - BR_T / 2])
                circle(d = BR_T, $fn = 16);
    // 波の谷を結ぶ下弦（波が開かないように留める）
    translate([BR_Y0, BR_ZB]) square([BR_Y1 - BR_Y0, BR_T]);
}
// 🔒 邪魔者は実体で引く。座標は相手の定義から来るので、相手が動けば追従する
//    ⚠ **ソケット本体（Y 10.0〜20.0）だけでなく、その裏を線が通るぶん**まで抜く。
//       上段のソケットは Z 27.5〜29.5 でブリッジと同じ高さなので、ここでしか上がれない
module bridge_clear() {
    translate([RSP_X + respeaker_L() - 20.5, RSP_BD_Y1 - 0.5, BR_ZB - 2])  // XIAO ソケット
        cube([19.0, 14.5, BR_ZT - BR_ZB + 4]);
    // ✅ JST のスリットは**要らなくなった**（2026-08-20）。板を下げて下側のネジ列を
    //    ブリッジの下面に合わせたら、下を向いた JST の先が Z 16.77 ＝ ブリッジ（24〜30.1）
    //    より下へ出た。**穴を開ける理由そのものが消えた。**
}
module bridge_raw() {
    // 🔒 断面を X 方向へ押し出す。山と谷がスパンに沿って走る
    // 🔒 **右端は板の面（IN_X - PB_TH）で終える。**そこから右は PowerBoost が
    //    構造を担う（上板と下弦が板の面に突き当たり、ネジで留まる）
    rotate([90, 0, 90]) linear_extrude(IN_X - PB_TH) bridge_section();
    // 🔴 **2026-08-21、上のネジ（Z 29.0）を拾い直すための増し肉。**
    //    DECK_Z を 1.6 下げて上面が 30.1 → 28.5 になった一方、PowerBoost は
    //    PB_LIFT で元の高さに残したので、**板は動かず、ブリッジだけが下へ逃げた。**
    //    実測: 前のネジ（Z 27.0）はブリッジを 10.7mm3 貫いて効いているが、
    //    奥のネジ（Z 29.0）は 1.7mm3 で、頭の 0.4mm をかすめるだけになっていた。
    //    ⇒ 右端だけ台を立てて拾う。🔒 数字は PB_HOLES から。板が動けば追従する
    // ⚠ **上2本（Z 42.14 / 44.78）を拾わないこと。**あれは元からブリッジの外で、
    //    条件を「BR_ZT より上」だけにすると柱が2本伸びてつまみを 42mm3 貫く（実際にやった）
    for (h = PB_HOLES) if (h[1] > BR_ZT - 1.0 && h[1] < BR_ZT + 2.0)
        translate([IN_X - PB_TH - 6, h[0] - 2.4, BR_ZB])
            cube([6, 4.8, h[1] + 1.2 - BR_ZB]);
}
module bridge() { difference() { bridge_raw(); bridge_clear(); } }
// 🔒 中身のビュー用の半透明のブリッジ。**これが無いと「上へ逃げられるか」が
//    画で判断できない**（ユーザー指摘 2026-08-20）。inside と rail の両方に出す
module ghost_bridge() { color("#7f9ec4", 0.35) bridge(); }

// ============================================================
// 2.7 電池のトンネル（右の壁から差し込む）
// ============================================================
// ✅ ユーザー決定（2026-08-20）: 当て板とねじで押さえるのをやめ、**トンネルに通す**。
//    揺れる環境なので、点で留めるより全長を面で拘束するほうが強い。当て板は電池の端
//    7mm しか押さえられず（つまみの座の下は 1.907mm）、残り 42mm が片持ちの重りになる。
//    樹脂のねじは振動で緩み、パウチセルを点で押すのも良くない。
// ✅ **天井と電池の 1.9mm はスポンジで埋める**（⚠ 厚みは未検証）。
// 🔒 **つまみの座の下では天井を張らない。** 座の下端 38.007 と天井の内面 38.0 が
//    ぶつかる。そこは**座の裏がそのまま天井**になる
// ============================================================
// 2.8 電池の蓋（右の口・Y方向スライド ＋ 磁石）
// ============================================================
// ✅ ユーザー決定（2026-08-20）: **爪は使わない。レジンなので曲げる部品は折れる。**
//    ⇒ 曲げを使う部品をゼロにする。**溝が荷重を受け、磁石は滑り止めだけ**を担当する。
//      ・電池が押す力（+X）… 蓋のツメが天井と床の溝に掛かって受ける
//      ・蓋が Y へ滑り出すの… 磁石が止める（電池の慣性はこの向きには掛からない）
// 🔒 スライドの向きは**電池を抜く向きと直角**。同じ向きだと振動がそのまま蓋を押す
// ⚠ **ツメと溝の噛み合いは未検証。** 印刷して確かめること（レジンの寸法は PRINT.md）
// 🔴 2026-08-20 に一旦オフにしていた（ユーザー指示「電池の口とかそういうのは後で
//    一気にやるべき」）。**2026-08-21、配置が固まったので戻した。**
// 🔴 **オフの間、左の壁には穴が 1mm3 も開いていなかった**（実測: 帯 1700mm3 に対して
//    穴 0）。⇒ 電池が取り出せない状態のまま「工具なしで交換できる」と書いていた
BAT_HOUSING = true;
COV_CL   = 0.3;    // 蓋まわりの隙間
COV_SL   = 6.0;    // 差し込んでから滑らせる量
COV_TAB  = 1.2;    // ツメの厚み
MAG_D    = 6.10;   // ✅ ゲージ確定（parts.scad のリード用と同じ φ6）
MAG_H    = 2.15;   // ✅ 実測
// ✅ **蓋の磁石とリードスイッチの距離は心配しなくてよい**（2026-08-20 ユーザー
//    「かなり離れていますから」）。蓋は右の壁、リード磁石はつまみの中。⇒ 測らない
function cov_y0() = BAT_C0[1];
function cov_y1() = BAT_C1[1];
function cov_z0() = BAT_C0[2];
function cov_z1() = BAT_C1[2];
function cov_w()  = cov_y1() - cov_y0();

// 蓋そのもの（刷る部品）。原点は箱の座標のまま
// 🔴 2026-08-20、右の壁 → **左の壁**。座標を直に書き直した（mirror は使わない）
module battery_cover() {
    // 壁の中に入る板（外面とツライチ）
    translate([-WALL, cov_y0() + COV_CL, cov_z0() + COV_CL])
        cube([WALL, cov_w() - COV_CL * 2, cov_z1() - cov_z0() - COV_CL * 2]);
    // 内側のツメ2本（上と下）。滑らせた先で天井と床の溝に潜る
    for (z = [cov_z0() + COV_CL, cov_z1() - COV_CL - COV_TAB])
        translate([0, cov_y0() + COV_CL, z])
            cube([COV_SEAT, cov_w() - COV_CL * 2 - COV_SL, COV_TAB]);
    // 磁石のポケットは蓋の外面側から。板の中に埋める
    difference() {
        translate([-WALL, cov_y1() - 5 - MAG_D / 2, (cov_z0() + cov_z1()) / 2])
            rotate([0, 90, 0]) cylinder(d = MAG_D + 2.4, h = 1.2, $fn = 32);
        translate([-WALL + 0.2, cov_y1() - 5 - MAG_D / 2, (cov_z0() + cov_z1()) / 2])
            rotate([0, 90, 0]) cylinder(d = MAG_D, h = MAG_H, $fn = 32);
    }
}
// 🔴 **2026-08-21、これが無かった。**蓋の板は X -2〜0 に描いてあるのに、
//    **壁を抜くモジュールがどこにも無かった。**
//    ⚠ **側面の壁は上シェルの持ち物**（下シェルは床しか無い）。`lower_cuts()` に
//       書いても効かない。⇒ `upper_raw()` の difference で引く
module battery_port_cut() { if (BAT_HOUSING) {
    translate([-WALL - 1, cov_y0(), cov_z0()])
        cube([WALL + 1 + 0.01, cov_w(), cov_z1() - cov_z0()]);
} }
// 蓋のために筐体から引くもの（溝と、相手側の磁石ポケット）
module battery_cover_cuts() { if (BAT_HOUSING) {
    // ツメが潜る溝（天井と床。X 0〜COV_SEAT の帯を Y いっぱいに）
    for (z = [cov_z0(), cov_z1() - COV_TAB - COV_CL])
        translate([-0.01, cov_y0(), z])
            cube([COV_SEAT + 0.02, cov_w(), COV_TAB + COV_CL]);
    // 相手側の磁石ポケット（壁の内側から）
    translate([COV_SEAT, cov_y1() - 5 - MAG_D / 2 - COV_SL, (cov_z0() + cov_z1()) / 2])
        rotate([0, 90, 0]) cylinder(d = MAG_D, h = MAG_H, $fn = 32);
} }

module battery_tunnel() {
    if (BAT_HOUSING) difference() {
        // 筒（閉じているのは +X 側なので、そこへ端板ぶん伸ばす）
        translate([BAT_C0[0], BR_Y0, BAT_C0[2]])
            cube([BAT_C1[0] - BAT_C0[0] + TUN_T, BR_Y1 - BR_Y0,
                  BAT_C1[2] + TUN_T - BAT_C0[2]]);
        // 電池の通り道（**左（-X）へ抜ける**）
        translate([BAT_C0[0] - WALL - 2, BAT_C0[1], BAT_C0[2]])
            cube([BAT_C1[0] - BAT_C0[0] + WALL + 2, BAT_C1[1] - BAT_C0[1],
                  BAT_C1[2] - BAT_C0[2]]);
        // 🔒 **電池線の口。** 奥（+X）の端板を線が抜ける。無いと壁を貫く
        //    ⚠ 線は短辺（保護基板側）から出る。左右どちらの向きで入れてもよいので、
        //       口は幅いっぱいに取る
        // 🔴 **2026-08-21、両端の残しを 4 → 1 に。**端子を奥の隅へ移したので、
        //    4 残しだと口の縁（Y 53.8）に束（Y 51.7〜54.3）が 1.5mm3 掛かる。
        //    🔒 **幅いっぱいのまま**にしておく——セルは左右どちらの向きでも入れられ、
        //       端子は手前隅・奥隅のどちらにも来られる（ユーザー）。片側だけ開けない
        translate([BAT_C1[0] - 1, BAT_C0[1] + 1, BAT_C0[2] + 1])
            cube([TUN_T + 2, BAT_C1[1] - BAT_C0[1] - 2, LIPO_TH - 2]);
        translate([knob_seat_x0(), BR_Y0 - 1, BAT_C1[2] - 0.01])   // 座の下は天井を抜く
            cube([knob_seat_x1() - knob_seat_x0(), BR_Y1 - BR_Y0 + 2, TUN_T + 2]);
        // 🔴 **2026-08-21、会話ボタンの線の溝。**天井が下がって BTN2 の段が屋根の板と
        //    重なった。⚠ **屋根の板だけを細く抜く。**スポンジの層には手を付けない
        // 🔴 幅 3.5 → 8.4。タクトSW の足は X 18.7〜26.5 に広がっていて、
        //    3.5 では両端が屋根に残っていた
        translate([BTN_AT[0] - 4.2, BR_Y0 - 1, BAT_C1[2]])
            cube([8.4, BR_Y1 - BR_Y0 + 2, TUN_T + 0.01]);
        // ✅ **2026-08-21、端板を削る／円弧で抜くのはやめた。**
        //    いったんは「つまみは動かせない（右へ 0.6 で PowerBoost に当たる）」と判断して
        //    端板を削っていたが、**当たっていたのは基板ではなく座の板の右端 0.4mm**
        //    （実測 X 81.1〜81.5）で、基板の右端 76.4 と PowerBoost 79.2 の間は 2.8mm
        //    空いていた（ユーザー指摘）。⇒ 座の板の角を逃がして **つまみを 0.8 右へ**。
        //    🔒 **端板は 1.6mm 通しのまま。**電池の止めを削らない
        bridge_clear();
        battery_cover_cuts();
    }
}

// ---- トグル（尻尾）----
// 🔴 **2026-08-21、Z 47 → 46**。天井が 55.207 → 50.6 に下がって、胴の頭（Z 51.0）が
//    天板（50.6〜53.1）を 62.4mm3 突き抜けた。⇒ 1.0 下げて天井の下へ入れる
// 🔴 **2026-08-21、46 → 44.5。**胴の頭は TGL_AT[1] + 4.0 なので、天井 48.8 に対して
//    44.5 なら 0.3 残る。⬜ **下に何があるかは未測定**（当たり検査で見る）
// 🔴 **2026-08-21、天井に紐づけた。**絶対値で持っていたので、天井を下げるたびに
//    胴の頭（TGL_AT[1] + 4.0）が天板を突き抜けていた
TGL_AT = [40, IN_Z - 4.3];
TAIL_L = 34.0; TAIL_D0 = 13.0; TAIL_D1 = 3.5; TAIL_BORE = 3.2;
TAIL_GAP = 3.0; TAIL_ANG = 25.0;
ANT_CH_D = 1.6; ANT_OFF = 4.5; ANT_SLOT_W = 2.2;
ANT_TUBE_D = 3.0; ANT_NOZ_L = 2.5;

// ---- 天面: スピーカー（位置は §2.5）----
SPK_L = spk_l(); SPK_W = spk_w(); SPK_TH = spk_th(); SPK_DIA = spk_dia();
SPK_Z = IN_Z - SPK_TH;
SPK_RIM = 0.8; SPK_RIM_M = 0.8; SPK_REL = 0.4;
EMB_H = 1.2; EMB_M = 3.0;

// ---- 天面: 会話ボタン（位置は §2.5）----
BTN_L = 18.0; BTN_W = 12.0; BTN_GAP = 0.5;
BTN_DISH_L = BTN_L + BTN_GAP * 2 + 0.2;
BTN_DISH_W = BTN_W + BTN_GAP * 2 + 0.2;
BTN_TRAVEL = tsw_travel() + 0.25;
// 🔴 **2026-08-21、キャップの全高を 1.0 詰めた（+2.5 → +1.5）。**外へ出る量
//    （BTN_OUT 3.0）は変えないので、見た目は同じ。へこみが 3.0 → 2.0 になる
BTN_OUT = 3.0; BTN_H = BTN_OUT + 1.5;
BTN_DISH_T = BTN_H - BTN_OUT + BTN_TRAVEL;
BTN_WALL = 1.6; BTN_PLG_D = 5.0; BTN_HOLE_D = BTN_PLG_D + 0.6;
BTN_NECK_D = 3.2; BTN_CLIP_T = 1.2; BTN_CLIP_D = 7.0; BTN_LIP_H = 0.8;
// 🔒 Z は**天面から下へ何mm**で読む。IN_Z はつまみで動くので絶対値を書かない
Z_BTN_DISH = Z_TOP - BTN_DISH_T;
// 🔴 **2026-08-21、2.6 → 1.6。**受け板を 1.0 薄くした
BTN_PAD_T  = 1.6;
Z_BTN_PAD  = Z_BTN_DISH - BTN_PAD_T;
Z_NECK0    = Z_BTN_PAD - 0.2;
Z_NECK1    = Z_NECK0 - BTN_CLIP_T - BTN_TRAVEL - 0.2;
Z_TIP      = Z_NECK1 - BTN_LIP_H;
Z_TSW_TOP  = Z_TIP - (tsw_h() - tsw_body_h());
Z_TSW_BOT  = Z_TSW_TOP - tsw_body_h();
BTN_PAD_X = 25.0; BTN_PAD_Y = 15.0;
BTN_CLAW_W = 5.0; BTN_CLAW_G = 0.5; BTN_PKT_T = 1.2; BTN_POST_I = 3.6;

// ============================================================
// 2.5 天面のレイアウト（🔒 意匠。ここだけ見れば天面の配置が分かる）
// ============================================================
// ⭐ 2026-08-19 ユーザー指定「なんらかのデザイン意匠が欲しい。今は置いただけにしか
//    見えない」→ 3案を出して **B案（左に縦積み・右につまみ）** を採用。
//    マージンは 10 → **13mm**（ユーザー指定）。
//
//   ┌──────────────────────────┐
//   │ 13                       │   ・小さい2つ（スピーカー・会話ボタン）を左に束ね、
//   │  ┌────┐          ,-----. │     大きいつまみと**重さで釣り合わせる**
//   │  │spk │   13.8  (  knob )│   ・束の中心とつまみの中心が**同じ高さ**に乗る
//   │  └────┘          `-----' │   ・すき間は 左13 / 中13.8 / 右13 / 縦13
//   │ 13                    13 │
//   │  ┌────┐                  │   🔒 13 は1か所だけ決めた数字。ほかは全部そこから出る
//   │  │btn │                  │
//   │  └────┘                  │
//   └──────────────────────────┘  ← 正面（OLED・顔）
//
// ⚠ **見える円は座（30）ではなく、へこみ φ26.2 のほう。** マージンは見えるほうで測る。
//    ⬜ 26.2 は knob_v5 の DISH_D と同じ値。**向こうに関数で出してもらうまでの仮置き**
//       （数字を二重に持っている状態なので、v5 が変わると気づけない）
TOP_MARGIN  = 13.0;
KNOB_DISH_D = knob_dish_d();              // 🔒 knob_v5 から引く（写すと必ず古くなる。
                                          //    2026-08-19、26.2 の写しが 28.2 になって実際に古くなった）
SPK_EMB_W = SPK_DIA[0] + EMB_M * 2;       // 20  へこみの幅（見える大きさ）
SPK_EMB_D = SPK_DIA[1] + EMB_M * 2;       // 14  へこみの奥行き

// 左の束: スピーカーが前、会話ボタンが後ろ。間も 13
SPK_C = [TOP_MARGIN + SPK_EMB_W / 2, TOP_MARGIN + SPK_EMB_D / 2];
BTN_AT = [TOP_MARGIN + BTN_DISH_L / 2,
          TOP_MARGIN + SPK_EMB_D + TOP_MARGIN + BTN_DISH_W / 2];
// スピーカー部品の原点（へこみの中心から逆算）
SPK_X = SPK_C[0] - SPK_L / 2;
SPK_Y = SPK_C[1] - SPK_W / 2;
// つまみ: 右のマージン 13。高さは**束の中心**に合わせる
KNOB_YC = (SPK_C[1] + BTN_AT[1]) / 2;
// 🔒 つまみだけ右へずらす量（天面のマージンは他の部品も見ているので触らない）
// 🔴 **2026-08-21、0 → 6.0**（ユーザー承認）。電池（X 2〜52）の右端から、つまみの
//    実体（φ27）を抜くのに要る量。4.0 では電池の角に 21.9mm3 刺さり、**6.0 で 0**。
//    7・8 にすると今度は上シェル側が 119.6 / 180.2 に悪化する（右へ寄せ過ぎ）。
//    ⚠ 代償は天面の左右差。へこみ φ26.2 の右の余白が 13 → **8.0**（左は 13 のまま）
// 🔴 **2026-08-21、6.0 → 6.8**（ユーザー指摘「どう見ても動かせる」——そのとおりだった）。
//    6.0 では AS5600 の板（X 53.4〜）が電池トンネルの端板（〜54.0）へ 0.6 重なり、
//    端板を削って逃がしていた。**削る代わりに動かす。**板は 54.2 から始まって端板を外れる。
//    ⚠ 私は「右へ 0.6 動かすと PowerBoost に当たるから動かせない」と書いたが、
//      当たっていたのは**基板ではなく座の板の右端 0.4mm**（実測 X 81.1〜81.5）。
//      基板の右端 76.4 と PowerBoost 79.2 の間は 2.8mm 空いている。⇒ 板の角を逃がす
KNOB_DX = 6.8;
KNOB_AT = [IN_X - TOP_MARGIN - KNOB_DISH_D / 2 + KNOB_DX, KNOB_YC, Z_TOP];
KNOB_Y0 = KNOB_YC - knob_bay_y() / 2;
KNOB_Y1 = KNOB_Y0 + knob_bay_y();

// ---- 前の押さえリブ（§4.8）の X。左右の余白がそろう位置に置く ----
// 🔒 **両隣から出す。** 左はスピーカーの右端、右はつまみの座の左端。
//    レイアウトを動かしてもリブが勝手に付いてくる
RIB1_W  = 6.0;                                  // 幅（余白を取るため 8 から削った）
RIB1_L  = SPK_X + SPK_L;                        // 左どなり: スピーカーの右端
RIB1_R  = KNOB_AT[0] - knob_bay_x() / 2;        // 右どなり: つまみの座の左端
RIB1_X  = (RIB1_L + RIB1_R - RIB1_W) / 2;       // 余白が左右そろう位置

// ---- 正面の窓 ----
WIN_CR = 2.0; WIN_CH = 1.2; WIN_R = 0.4;
OLED_HOLES  = [for (h = oled_mount()) [OLED_X0 + h[0], OLED_Z0 + h[1]]];
OLED_BOSS_L = oled_pcb_y();
OLED_WASH_T = 2.0;
WIN_X0 = OLED_X0 + oled_glass_x() - 0.3;  WIN_X1 = WIN_X0 + oled_glass()[0] + 0.6;
WIN_Z0 = OLED_Z0 + oled_glass_y() - 0.3;  WIN_Z1 = WIN_Z0 + oled_glass()[1] + 0.6;

// ---- マイクのヒゲ ----
WSK_L = 6.0; WSK_W = 1.0; WSK_CH = 0.5; WSK_R = 0.4;
// 上下のヒゲの開き角[deg]。真ん中は 0、上が +・下が − に倒れる
// ✅ 2026-08-21 ユーザー: 「上下のヒゲの角度が急すぎる」⇒ 12 → 4 へ寝かせた
WSK_ANG = 4;

// ---- 充電口（PowerBoost の microUSB）----
// 🔴 **2026-08-19、モックを実体にして分かった: いまの置き方だと充電口は床を向く。**
//    micro USB は板の -X 端にあり、この置き方では箱の **Z 7.8・開口は −Z（下）**に来る
//    （hardware/scratch/_pb_where.scad で確認）。下シェルの床を貫かないと挿せない。
//    ⬜ **口の向きを直すか、板の置き方を変えるかは未決。**下の USB_PB は天面向きの XY で、
//       この向きと合っていない（どこにも開けていないので実害は無い）
// ✅ 2026-08-19 左の壁へ立てたので、**充電口は天井（+Z）を向く。床向きは解消した。**
//    口の中心は Z = 板の上端、X は板の厚みの中、Y は板の中ほど
USB_PB = [PB_AT[1] + pb_usb()[1], PB_AT[2] + PB_L];   // [Y, Z]
// ⬜ **天井まで 16.6mm ある**（板の上端 Z 38.568 ↔ 内寸 Z 55.207）。
//    筒で抜くか、板を持ち上げるかは未決。どこにも開けていないので実害は無い
// ✅ 電池の JST は**サイドエントリ**。ハウジングは板と平行に +Y（背面）へ抜ける。
//    板厚方向は 6.8 のまま。突き出しは pb_jst_out() = 4.694

// ============================================================
// 2.9 線（実体）
// ============================================================
// 🔒 口の座標は hub_board_parts.scad の HUB_HEADERS から引く。数字を書かない
function port_at(id) =
    [for (h = HUB_HEADERS) if (h[0] == id)
        [HUB_AT[0] + (h[4] + h[6]) / 2,
         HUB_AT[1] + (h[5] + h[7]) / 2,
         HUB_AT[2] + HUB_T]][0];
function port_n(id) = [for (h = HUB_HEADERS) if (h[0] == id) h[3]][0];
// 🔒 線は**ハウジングの頭から**描く。根元から描くとハウジングを突き抜けて嘘の当たりが出る
HOUS_H = 10.0;   // ⚠ DuPont ハウジングの高さ（未実測）
// 🔒 さらに**束の半径ぶん**上げる。頭ちょうどに中心線を置くと束の下半分が
//    ハウジングとヘッダに埋まり、0.02〜0.05mm3 の嘘の当たりが4本ぶん出る（2026-08-20）
// 🔒 さらに**束の半径ぶん**上げる。頭ちょうどに中心線を置くと束の下半分が
//    ハウジングとヘッダに埋まり、嘘の当たりが出る
// ⚠ ガイドの床（上面 15.7）より上から線を出す。2.4 だと 4本束の下端 14.72 が床に埋まる
HOUS_R = 3.6;
function port_out(id) = port_at(id) + [0, 0, HOUS_H + HOUS_R];
// 🔒 線の通り道でファイル全体から見る X（wires_v2 の外からも参照する）
PWR_X  = 77.6;   // PowerBoost へ抜ける X（ハブの右端 76 ↔ 部品面 79.2 の中央）
BATX_A = 30.4;   // BAT  が上下する X
BATX_B = 30.6;   // BAT2 が上下する X
PHO_X2 = 12.0;   // PHOUT が棚まで上がる X
SPK_OY2 = 48.0;  // PHOUT が棚まで上がる Y（ガイドの手前・ブリッジの外）
AS_X   = 63.0;   // AS5600 が上がる X。⚠ 57 はリードの立ち上がり（X 58.9 / Y 61.6）、
                 //    53 は電池（X 〜52）、54.5 は電池線の起点（X 54）と当たる
// 🔴 **2026-08-21、32.5 → 31.0。**ブリッジの頭が 28.5 へ、つまみの裾が 32.1 へ下りて、
//    束（φ3.565）の通り道が 3.6mm になった。32.5 のままだと裾を 12.8mm3 噛む。
//    🔒 実測: この X（61〜64）では裾の底は 33.4。⇒ 31.0 なら 下 29.22 / 上 32.78 で
//       ブリッジに 0.72、裾に 0.62 残る。**どちらかが動いたら必ず取り直すこと**
// 🔴 **2026-08-21、31.0 → 29.4。**つまみの下は1本ずつ平らに並べる（φ1.78）ことに
//    したので、段をブリッジの頭 28.5 のすぐ上まで落とせる。下端 28.51 / 上端 30.29
// 🔴 **2026-08-21、29.4 → ブリッジの頭 ＋ 3.0。**29.4 はつまみの裾の下をくぐるための
//    値だった。くぐるのをやめたので、ブリッジの上を素直に走らせる（下端 29.72）
AS_UP  = BR_ZT + 3.0;
// 🔒 **1本ずつ出せるようにしておく。** 当たりが出たときに、どの束かを切り分けるのに要る
//    -D 'part="chk_wire"' -D 'WIRE_PICK="BTN2"' のように使う
WIRE_PICK = "";   // "" なら全部
// 🔒 **終端の止め代。** 既定 4.0 は当たり検査のため（wires.scad 58行）。終点まで描くと
//    必ず相手の部品と交差して、本物の当たりが埋もれる。
//    ⚠ そのぶん**絵では線がどこにも繋がって見えない**（2026-08-20 ユーザー指摘）。
//    ⇒ 見るときは **-D WIRE_TRIM=0** で終点まで描く。**検査のときは 0 にしない**
WIRE_TRIM = 4.0;   // [0:0.5:6]
// 🔒 **束ごとに色を変える。** 全部同じ紫だと、どの口から出た線か絵で追えない
//    （2026-08-20 ユーザー「どこの端子から出てるのか見えない」）
function wire_color(id) =
      (id == "XIAO")   ? "#e6194b"   // 赤
    : (id == "OLED")   ? "#3cb44b"   // 緑
    : (id == "AS5600") ? "#4363d8"   // 青
    : (id == "PWR")    ? "#f58231"   // 橙
    : (id == "INA")    ? "#911eb4"   // 紫
    : (id == "BTN2")   ? "#42d4f4"   // 水
    : (id == "TOGGLE") ? "#f032e6"   // 桃
    : (id == "REED")   ? "#bfef45"   // 黄緑
    : (id == "PHOUT")  ? "#000075"   // 紺
    : (id == "PHIN")   ? "#808000"   // 橄欖
    : (id == "BAT")    ? "#9a6324"   // 茶
    : (id == "BAT2")   ? "#a9a9a9"   // 灰
    :                    "#8e44ad";
// 🔒 WIRE_PICK は **1本でもリストでも**受ける。リストにできると「X と Y だけ」を
//    描けるので、線どうしの重なりを組で測れる（-D 'WIRE_PICK=["PWR","INA"]'）
function wire_picked(id) =
    WIRE_PICK == "" ? true
  : is_list(WIRE_PICK) ? len([for (q = WIRE_PICK) if (q == id) 1]) > 0
  : WIRE_PICK == id;
module harness(id, dest, mid = [], n = undef) {
    if (wire_picked(id))
        color(wire_color(id)) bundle(wire_trim_end(concat([port_out(id)], mid, [dest]), WIRE_TRIM),
                                     is_undef(n) ? port_n(id) : n);
}
// 電池線は口が無いので id を手で渡す
module loose(id, pts, n) {
    if (wire_picked(id))
        color(wire_color(id)) bundle(wire_trim_end(pts, WIRE_TRIM), n);
}
// 🔒 PowerBoost のパッド → 箱の座標。置き方（parts_v2）と同じ変換をここに1つだけ置く
//    🔴 2026-08-20、右の壁へ立てて長辺を下にしたので書き直した。
//    🔒 **上下逆**（JST を下へ向けた）。板(x,y,z) → 箱(PB_X1 - z, PB_AT[1] + x,
//       PB_AT[2] + PB_W - y)。行列式は +1 で、鏡像ではなく回転（🚫 mirror は使わない）
function pb2box(p) = [PB_X1 - p[2], PB_AT[1] + p[0], PB_AT[2] + PB_W - p[1]];
PB_PAD_Z = 1.6;
// 🔒 パッドの真上ではなく、**実装の頂点（板厚 PB_TH）より外**で止める。
//    5.0 だと X 6.6 で、部品面（X 6.8 まで）の中に入っていた（2026-08-20）
// ⚠ 4.0 だとパッドが X 75.2 に来て、つまみの座の右端 74.9 と 0.3 しか離れない
function pb_pad(xy) = pb2box([xy[0], xy[1], PB_TH + 2.5]);

// ---- 相手側の座標 ----
// 🔒 電流計の 5ピンヘッダの口。**数字を手で書かない。**parts.scad の ina_hdr() から出す
//    板は 180度 返して貼るので、口は箱の **-Y（手前）**を向く
// 🔴 2026-08-20 まで INA の行き先は `[16, 21, 44]` の手書きで、**電流計を移す前の場所**を
//    指していた。当たり検査は「何も無い空間」を指しても 0 なので捕まらない
function ina_hdr_port() = let (h = ina_hdr())
    [INA_AT[0] + h[0] + h[1] / 2,
     INA_AT[1] + ina_size()[1] - (h[2] + h[3]),
     INA_AT[2] + ina_h() - ina_size()[2] - h[4] / 2];
// 🔒 ReSpeaker の**スピーカーソケット J2**（PHIN の相手）。板は 180度 回して載るので、
//    局所の右端が箱の**左端**に来る。🔴 2026-08-20 まで PHIN は XIAO ソケットの辺り
//    （X 67）を指していた。**全く別の場所だった**（ユーザー指摘）
function rsp_j2_box() = let (j = respeaker_spk_j2())
    [[RSP_X + respeaker_L() - j[1], RSP_BD_Y1,        RSP_Z + j[2]],
     [RSP_X + respeaker_L() - j[0], RSP_BD_Y1 + j[4], RSP_Z + j[3]]];
function rsp_spk_port() = let (b = rsp_j2_box())
    [(b[0][0] + b[1][0]) / 2, b[1][1], (b[0][2] + b[1][2]) / 2];
// ReSpeaker の XIAO ソケット（板は X が反転して載っている）
function xiao_x()  = RSP_X + respeaker_L() - 11.0;      // 列の中央（局所 2〜20）
function xiao_y()  = RSP_BD_Y1 + HOUS_H;
function xiao_zl() = RSP_Z + 7.0;
function xiao_zh() = RSP_Z + respeaker_H() - 9.0;
// OLED の裏（正面パネル）。⚠ これは**パネルの中心**であって口ではない
function oled_c()  = [OLED_X0 + OLED_L / 2, oled_back() + 2, OLED_Z0 + OLED_W / 2];
// 🔒 **OLED の I2C の口 = 上辺の中央寄り・ストレートのヘッダが後ろ（+Y）へ出る。**
//    ✅ ユーザー（2026-08-17「中央最上部にある」／2026-08-20「L型ではなく直」）。
//    位置は背面写真から **上端から下へ約6mm・板の左右 58%**（⚠ 写真読み）。
//    🔴 「正面から見て左辺の4ピン」「L型」は**どちらも古い**。引かないこと
//    ⚠ 後ろへ 25mm 要るのは**ヘッダ本体ではなく、そこに挿さる DuPont ハウジング＋
//       線の曲がり**の逃げ（断面 10.16 × 2.54）。⚠ **OLED を測った値ではない。**
//       AS5600 の 26.0（ヘッダ2.5＋ハウジング14.0＋曲がり9.5）と同じ一般値
//    ⬜ この 25mm はモデルにまだ予約していない
function oled_port() = [OLED_X0 + OLED_L * 0.58, oled_back() + 2, OLED_Z0 + OLED_W - 6];
// 🔒 ReSpeaker の**スピーカーソケット J2**（PHIN の相手）。板は 180度 回して載るので、
//    局所の右端が箱の**左端**に来る。🔴 2026-08-20 まで PHIN は XIAO ソケットの辺り
//    （X 67）を指していた。**全く別の場所だった**（ユーザー指摘）
function rsp_j2_box() = let (j = respeaker_spk_j2())
    [[RSP_X + respeaker_L() - j[1], RSP_BD_Y1,        RSP_Z + j[2]],
     [RSP_X + respeaker_L() - j[0], RSP_BD_Y1 + j[4], RSP_Z + j[3]]];
function rsp_spk_port() = let (b = rsp_j2_box())
    [(b[0][0] + b[1][0]) / 2, b[1][1], (b[0][2] + b[1][2]) / 2];
// ReSpeaker の XIAO ソケット（板は X が反転して載っている）
function xiao_x()  = RSP_X + respeaker_L() - 11.0;      // 列の中央（局所 2〜20）
function xiao_y()  = RSP_BD_Y1 + HOUS_H;
function xiao_zl() = RSP_Z + 7.0;
function xiao_zh() = RSP_Z + respeaker_H() - 9.0;
// OLED の裏（正面パネル）。⚠ これは**パネルの中心**であって口ではない
function oled_c()  = [OLED_X0 + OLED_L / 2, oled_back() + 2, OLED_Z0 + OLED_W / 2];

// INA226 の端子（ネジ端子は使わないので板の穴へ直付け）
// 🔴 部品面が下を向いたので、端子は**PCB の部品面（下から 1.6 の所 ＝ Z 22.4）**。
//    ⚠ 板の下面（16.4）に取ると、ハブの頭 15.1 との隙間 1.3mm に線を通すことになる
// 🔒 端子は板の +Y 端から 2mm。Y は反転するので INA_AT[1] + 奥行き - 2
function ina_z()   = INA_AT[2] + ina_h() - 1.6;
function ina_in()  = [INA_AT[0] + 8.5,  INA_AT[1] + ina_size()[1] - 2, ina_z()];
function ina_out() = [INA_AT[0] + 18.5, INA_AT[1] + ina_size()[1] - 2, ina_z()];
// 電池の JST（トンネルの左端から出る）
// 🔒 **トンネルの左の口の外**から描く。電池の中から描くと電池を貫く（2026-08-20）
// 🔒 PowerBoost の電池コネクタ（箱の座標）。ハウジングは +X へ抜ける
function pb_jst_box() = pb2box([pb_jst()[0], pb_jst()[1], 6]);
// 🔒 線が実際に来るのは**プラグの先**。ソケットの中心ではない
function pb_jst_tip() = pb2box([pb_jst()[0], PB_W + pb_jst_out(), 6]);
// ============================================================
// 🔒 micro-USB のプラグが入る空間。**線の空間は部品として置く**（docs の流儀）
// ============================================================
// ✅ 2026-08-20 ユーザー決定: micro-USB は箱の外へ出さない。中でケーブルを受けて
//    外は Type-C にする。⇒ 壁に穴は開けない。**空間だけ要る。**
// 実測: 口は X 81.4〜84.4 / Z 28.8〜36.3、開口は -Y（正面）。前は ReSpeaker の
//    背面（Y 10.0）まで 13.5mm 空いている。⚠ XIAO ソケットの上段（Z 27.5〜29.5 /
//    X 63.5〜82.5）が口の下端を 0.7mm かすめる
PB_USB_PLUG = 12.0;   // プラグ本体＋曲げ代として確保する長さ
PB_USB_MARG = 1.5;    // 外皮のぶんの余白
module pb_usb_space() {
    // 🔒 起点はレセプタクルの**外面**（板の端から PB_USB_OUT だけ出ている）。
    //    板の端から取ると、レセプタクル自身が空間の中に入って偽の当たりになる
    c = pb2box([-0.5, pb_usb()[1], pb_pcb_t() + pb_usb_sz()[2] / 2]);
    translate([c[0] - pb_usb_sz()[2] / 2 - PB_USB_MARG,
               c[1] - PB_USB_PLUG,
               c[2] - pb_usb_sz()[1] / 2 - PB_USB_MARG])
        cube([pb_usb_sz()[2] + PB_USB_MARG * 2,
              PB_USB_PLUG,
              pb_usb_sz()[1] + PB_USB_MARG * 2]);
}
// 🔒 端子は右端（奥・閉じている側）。電流計がすぐ右下にある
// 🔴 **2026-08-21、短辺の真ん中 → 奥の隅**（ユーザー指摘）。
//    ✅ **セルは左右どちらの向きでも入れられ、端子は手前隅・奥隅のどちらにも選べる**
//    （ユーザー）。真ん中に置いていたのは既定値のままで、根拠は無かった。
//    🔴 そして真ん中は3つの中でいちばん悪い: X 54 の断面でつまみの円（中心 64.9・
//       半径 13.5）が覆う Y は 25.3〜41.3 で、**真ん中 39.5 はその中**（実測 0.149mm3）。
//       手前隅（約24）は外だが余裕 1.3mm しかない。**奥隅（約53）は 12.7mm 空く**うえ、
//       線の行き先（Y 62 で降りて電流計の 47.55）にも近い
function bat_out() = [LIPO_AT[0] + LIPO_L + 2, LIPO_AT[1] + LIPO_W - 4,
                      LIPO_AT[2] + LIPO_TH / 2];

module wires_v2() {
    // ============================================================
    // 🔒 通り道は4本だけ。**斜めに引かない・交差させない**
    //    （relay_board.html の配線と同じ約束。中だけ真逆になっていた）
    // ============================================================
    //   LZ … 板の上を這う高さ Z 18（ハブの最高点 15.1 の上・ブリッジ 24 の下）
    //   HZ … 棚の上を這う高さ Z 48（電流計 46.1 の上・スピーカー 51 の下）
    //   F  … 前の縦路 Y 16（ReSpeaker の裏 13.43 ↔ ブリッジ 20 の間）
    //   R  … 後ろの縦路 Y 63（ブリッジ 59 ↔ 背板 66 の間）
    // ⚠ 後ろの縦路で**上がれない X** が3つある。合わせボス X 0〜7 と 79〜86（Z 44 以上）、
    //    トグルの胴 X 33.5〜46.5（Z 41〜53）。⇒ 上がる X は 8〜33 と 47〜78 から選ぶ
    // ⚠ 電流計の L字ヘッダ（X 9.1〜21.9 / **Y 24〜31** / Z 41〜46.1）が棚の上の障害物。
    //    ⇒ HZ は**束の半径ぶん**を見て決める。47 だと束の下端 45.4 が頭 46.1 に触れる。
    //    48.5 なら下端 46.9 で逃げる
    // 🔴 **会話ボタンの塊が棚の上の横路を断ち切っている**（2026-08-20 に実測して判明）。
    //    タクトスイッチ（X 18.7〜26.5 / Y 43.6〜49.6 / Z 42.6〜49.2）と、
    //    上シェルの受け皿（X 17.8〜27.4 / Y 41.8〜51.4 / **Z 44〜52**）が1つの塊になる。
    //    受け皿は「Z 50 以上」ではなく **Z 44 から**あった。前の記述は誤り
    // 🔒 **Y 38〜64 を貫ける X（実測の空き地図・2026-08-20）**
    //      Z 46.9〜50.2（HZ の帯）… X 8〜17 と **X 27.4〜33.5** の2本だけ
    //      Z 41.5〜44.0        … X 8〜19 と **X 27.4〜33.5**
    //    左は 合わせボス（X 0〜7）と受け皿（X 17.8〜）で、右は受け皿とトグルの胴
    //    （X 33.5〜46.5）で挟まれている。⇒ **後ろから前へ渡る束はこの2本に割り振る**
    //      左の通路 … PWR3(X 10) / PWR EN(X 14) / BTN2(X 16.5・ただし Z 42.8 で低く渡る)
    //      右の通路 … INA(X 29.2) / PHOUT(X 32.15)
    // ⚠ スピーカーは端子だけが下へ出ている（X 14.1〜16.9 / Y 25.9〜26.8 / Z 49.5〜50.2）。
    //    HZ で左半分を前へ抜けるときはここに当たる。Y 21 まで出てから左へ振ること
    // 🔴 HZ を 48.5 と手で書いていたので、天井を 55.207 → 52.1 に下げたとき
    //    スピーカー（天板の裏）へ 6.8mm3 刺さった。⇒ **天井から引く**
    LZ = 18.0;  HZ = IN_Z - 6.7;  F = 16.0;  R = 63.0;
    // 🔒 **右の通路（X 27.4〜33.5）の割り付け。**幅 6.1mm に 3.22 と 2.28 を並べる
    CR_INA = 29.2;    // 束 φ3.22 → X 27.59〜30.81（受け皿 27.4 から 0.19）
    // 🔒 PHOUT が棚まで上がる X。会話ボタンの塊（X 17.8〜27.4）の左の通路
    // 🔒 **実測（1mm 刻みの柱で走査・2026-08-20）: X 36〜48 のどこでも、Z 18→46 を
    //    貫けるのは Y 12〜18 の約 8mm。**塞いでいるのは ReSpeaker の裏（〜11.2）と
    //    ブリッジの前面（19.2）。⚠ つまみの座（14.8）は **X 42.9 から**なのでここには効かない
    // ⚠ 上を右へ走るので、つまみの座（Y 14.8 から・Z 38 から）の手前に収める
    // ⚠ ReSpeaker の裏の部品は X 30 付近で Y 11.7 まで来ている（実測）。
    //    つまみの座は Y 14.8 から。⇒ 中を取る
    OLED_WY = 13.2;   // 束 11.59〜14.81
    // 🔒 PowerBoost まわり。ハブの右端 76 ↔ 部品面 79.2 の 3.2mm が唯一の通り道
    // 🔒 PowerBoost へ抜ける X。ハブの右端 76 ↔ 部品面 79.2 の 3.2mm の中央
    PWR_Z = LZ;       // 板の上を這う高さ
    INA_WZ = ina_hdr_port()[2];   // 電流計のヘッダの中心の高さ（＝19.4）
    PAD3 = pb_pad([(pb_out()[0][0] + pb_out()[1][0]) / 2,
                   (pb_out()[0][1] + pb_out()[1][1]) / 2]);
    PADE = pb_pad(pb_en());
    // 🔒 電池線。電池は左（X 2〜52）だが**線は奥（+X）の端板から出る**ので X 57。
    //    つまみの座（X 42.9〜74.9 / Y 14.8〜51.8 / Z 38〜）とトグル（X 33.5〜46.5 /
    //    Y 48〜 / Z 43〜）に挟まれて、上を左へ渡れない。⇒ **背面側（Y 60）を回る**
    BATY = 60.0;      // 背面側の渡り
    BATZ = 40.0;      // 電池の頭 36.1 の上・ブリッジの上
    BATX = 12.0;      // 左で上下する X（会話ボタンの塊 17.8〜 の左）
    // 🔒 電池線が上下する X。電流計の板（〜29）と電池（34〜）の間
    // ⚠ 右の壁は電池（X 34〜）ではなく**上シェルのトンネルの屋根（X 32.0 から / Z 35.1〜39.6）**。
    //    31.0 に置いたら 0.111mm3 噛んだ（2026-08-20）

    {
        // ---- 前の縦路（上下をつなぐ唯一の前側の道）----
        // 🔒 板の上（LZ）は**口の X か口の Y のどちらかを保って直角に折る。**
        //    斜めに引いていた3本（XIAO・AS5600・PHIN）を 2026-08-20 に直した。
        //    斜めだとガイドの向き（dir）が決まらず、クリップが置けない
        // XIAO 7本 … ソケットの逃げ（X 63.5〜82.5 / Y 9.5〜24）の中で上下する
        // ⚠ 縦に上がる Y は 21.8。21.5 だと 4本束（半径 1.61）の下端 19.89 が
        //    ReSpeaker の裏（Y 20.0）を 0.011mm3 噛んだ。上はソケットの逃げ（Y 24）まで 0.6 ある
        harness("XIAO", [xiao_x(), 21.8, xiao_zh()],
                [[port_at("XIAO")[0], port_at("XIAO")[1], LZ],
                 [70, port_at("XIAO")[1], LZ],
                 [70, 21.8, LZ], [70, 21.8, xiao_zh()]], n = 4);
        harness("XIAO", [xiao_x(), 21.8, xiao_zl()],
                [[port_at("XIAO")[0], port_at("XIAO")[1], LZ],
                 [66, port_at("XIAO")[1], LZ],
                 [66, 21.8, LZ], [66, 21.8, xiao_zl()]], n = 3);
        // OLED 4本 … 前の縦路を上がって OLED の裏へ
        // 🔒 口は上辺の中央寄りで**まっすぐ後ろを向く**ので、後ろから正対して挿す。
        //    ⚠ 通り道は **ReSpeaker の裏（Y 10.035）とつまみの座（Y 14.8）の間**。
        //       上がるのはつまみの座（X 42.9〜）の左で
        // 🔒 **口の真上で上げて、上（Z 45.65）を右へ走る。** 板の上を右へ這うと
        //    XIAO の走り（Y 15.04・Z 18・X 31.4〜70）と 10mm にわたって重なる。
        //    前の帯は上下に抜けられるのが Y 12〜18 の 6mm しかなく、XIAO の7本束が
        //    13.4〜16.7 を占めているので、ずらす余地が無い。⇒ **面を変えて上を走る**
        // 🔒 **後ろへ回って上がり、上を通って前へ**（2026-08-20 ユーザー案）。
        //    前の面は XIAO(7本)・AS5600・PHIN で埋まっていて、OLED の 3.2 が入る隙間が
        //    残っていない。上下できるのはブリッジ（Y 19.2〜59.8）の外だけなので後ろで上げる
        // ⚠ 前へ降りる X は OLED_JX。口の 34.11 のまま降りると、XIAO の走り
        //    （Y 15.04 / X 35.38〜70）の付け根と 4.7mm3 重なる
        harness("OLED", oled_port(),
                [[port_at("OLED")[0], port_at("OLED")[1], LZ],
                 [OLED_JX, port_at("OLED")[1], LZ],
                 [OLED_JX, OLED_WY, LZ],
                 [OLED_JX, OLED_WY, oled_port()[2]],
                 [oled_port()[0], OLED_WY, oled_port()[2]]]);
        // ---- 後ろのガイド（開口は X 14 / 44 / 70 の3つだけ）----
        // 🔒 **開口を中心に組む。**線はいちばん近い開口で壁を越える。
        //    ガイドの中を走るのは爪の下（RAIL_RUN）、上へ抜けるのは爪より奥（RAIL_UP）
        // 🔒 斜めに引いてよい（2026-08-20 ユーザー「直角じゃないといけないわけじゃない」）
        RZ2 = RAIL_ZB + bundle_d(2) / 2;
        RZ3 = RAIL_ZB + bundle_d(3) / 2;
        RZ4 = RAIL_ZB + bundle_d(4) / 2;
        OP_L = RAIL_OPEN[0];  OP_C = RAIL_OPEN[1];  OP_R = RAIL_OPEN[2];
        // 🔴 **2026-08-20、線どうしが 12組 463.7mm3 重なっていた。**原因は段の高さ
        //    （RZ2/RZ3/RZ4 = 16.96 / 17.24 / 17.48）が 0.5mm しか違わないこと。
        //    これは「床から半径ぶん」であって**車線ではない。**同じ開口へ集めれば必ず重なる。
        // 🔒 **同じ開口を通る束は、X か Z のどちらかで必ず離す。**開口は幅 6・高さ 8 なので、
        //    2本束（φ2.52）なら横に2本並ぶ（5.04）。太い束は上へ重ねる
        // 🔴 **レールの中を東西に走れるのは2本まで。**PHIN（16.96）と PHOUT（20.16）で
        //    埋まっている。3本目を上へ重ねると 21.42+1.78=23.2 になり、ブリッジの
        //    下面 24.0 を突き抜ける（実測 38.4mm3）。⇒ **AS5600 はレールへ入れない。**
        // 🔴 **2026-08-21、20.5 → 20.2。**ブリッジの下面が 24.0 → 22.4 に下りて、
        //    曲がり角の膨らみが 0.7mm3 噛んだ。⚠ 下は PHIN の段（頭 18.22）で、
        //    束の下端が 18.42。**上下とも 0.2〜0.4 しか無い。**どちらかが動いたら再計算
        AS_RZ    = 20.2;   // ⚠ 床の上（17.48）だと、PHIN の南北の車線（X 15.5 /
                           //    Z 16.96）が AS5600 の口の真上を通って 9.5mm3 重なる。
                           //    ⇒ 一段上げる。ブリッジの下面 24.0 まで 1.72 空く
        AS_NX    = 19.5;   // AS5600 が南北に走る X（PHIN の 15.5 から離す）
        AS_EY    = 65.5;   // AS5600 が東西に走る Y（トグルの立ち上がり 61.6 より奥）
        AS_RUN_Y = 71.5;   // AS5600 が X 方向に走る Y。⚠ 70 だと束の手前 68.22 が
                           //    爪（Y 〜69.1 / Z 22.3〜23.7）に入り、上がるときに 1.8mm3 噛む
        PHOUT_UY = 70.4;   // PHOUT が上がる Y。⚠ 爪（Y 〜69.1）より奥・束の半径 1.26 ぶん
        // 🔴 **2026-08-21、21.6 → 19.9**（ユーザー指示「INA の段を下げて 50.6 を取る」）。
        //    この1本だけがブリッジの下面を横断していて、下面 24.0 との隙間が 1.3mm しか
        //    無く、**ブリッジが下がれない原因になっていた**（実測 89.5mm3）。
        //    🔒 下限はトグルの段の上端 18.22。束 φ2.52 の半径 1.26 ＋ 余白 → 19.9。
        //    ⇒ 段の頭 21.16。新しいブリッジ下面 22.4 まで 1.24 空く
        INA_RZ   = 19.9;
        // 🔒 **BTN2・BAT・PWR はレールへ入らない。**ブリッジの背（59.8）と壁（64.5）の
        //    間の帯で上下する。3本とも口が後ろ寄りで、そこにはもうブリッジが無い。
        //    ⚠ 開口は幅 6 しかない。PWR（φ3.09）と PHIN（φ2.52）を横に並べると
        //       壁との隙間が 0.14 になり、曲がり角の膨らみが壁を 0.4mm3 噛んだ
        BTN2_UY  = 61.5;
        BTN2_X   = 12.5;   // 🔒 **口の真上。**東西に振ると AS5600 の南北の車線を横切る
        PWR_UY   = 62.0;
        BAT_NX   = 55.5;  BAT_DY = 62.0;   // ⚠ 東（X 74）へ回して降ろすと、PHIN と
                           //    PHOUT が南北に走る X 70 を必ず横切る（6.7mm3）。⇒ 西で降ろす
        BAT_FY   = 56.0;   // BAT が前へ出る Y。⚠ PHOUT（Y 51.87）と BAT2（50.75）から離す
        PHOUT_UX = 8.5;    // PHOUT が上がる X。⚠ 13 だと AS5600 の走り（Y 71.5）を横切り、
                           //    8.0 だと左後ろの合わせボス（X 〜7）を 0.5mm3 噛む
        INA_FY   = 58.0;   // INA が X 方向に走る Y。⚠ 口の 60.76 のままだと
                           //    トグルの立ち上がり（X 40 / Y 61.6）を 8.7mm3 噛む
        OLED_JX  = 30.0;   // OLED が前へ降りる X。⚠ 口の 34.11 のままだと XIAO の走り
                           //    （Y 15.04 / X 35.38〜70）の付け根と 4.7mm3 重なる
        // PWR … 口は右。右の開口で出て、**爪より奥（RAIL_UP）で上へ抜けて**
        //    デッキの上の PowerBoost へ。⚠ ブリッジは Y 20〜59 なので、
        //    上下できるのはその後ろ（RAIL_UP = 72）だけ
        PWR_X0 = port_at("PWR")[0];
        harness("PWR", PAD3, [[PWR_X0, port_at("PWR")[1], RZ3],
                              [PWR_X0, PWR_UY, RZ3],
                              [PWR_X0, PWR_UY, PAD3[2]],
                              [PAD3[0], PWR_UY, PAD3[2]]], n = 3);
        harness("PWR", PADE, [[PWR_X0, port_at("PWR")[1], RZ3],
                              [PWR_X0, PWR_UY, RZ3],
                              [PWR_X0, PWR_UY, PADE[2]],
                              [PADE[0], PWR_UY, PADE[2]]], n = 1);
        // INA … 口は中。中の開口で出て、電流計のヘッダへ
        // ⚠ 段は INA_RZ。口の高さ（19.4）のまま走るとトグルの束（上端 18.22）と 0.6 重なる
        harness("INA", ina_hdr_port(),
                [[port_at("INA")[0], port_at("INA")[1], INA_RZ],
                 [port_at("INA")[0], INA_FY, INA_RZ],
                 [OP_C, INA_FY, INA_RZ],
                 [OP_C, RAIL_RUN, INA_RZ], [OP_C, 21, INA_RZ],
                 [ina_hdr_port()[0], 21, INA_RZ]]);
        // BTN2 … 口は左。ガイドの手前なので壁を越えない。そのまま上がって横から挿す
        // 🔴 42.8 の手書きだった。会話ボタンは天板に付くので **Z_TOP から引く**
        // 🔴 **2026-08-21、14.9 → 13.1。**キャップとパッドで 2.0 詰めたぶん、
        //    足の位置も上がる。14.9 のままだと屋根のスポンジ層へ 1.1mm3 入る
        BTN2_Z = Z_TOP - 13.1;
        // ⚠ 電池が左（X 2〜52 / Y 22〜57 / Z 30.1〜36.1）に移ったので、**左では上がれない**。
        //    ⇒ ガイドの奥（Y 61）で上げてから前へ出る
        harness("BTN2", [BTN_AT[0], BTN_AT[1], BTN2_Z],
                [[port_at("BTN2")[0], port_at("BTN2")[1], RZ2 + 3.2],
                 [BTN2_X, port_at("BTN2")[1], RZ2 + 3.2],
                 [BTN2_X, BTN2_UY, RZ2 + 3.2],
                 [BTN2_X, BTN2_UY, BTN2_Z],
                 [BTN_AT[0], BTN2_UY, BTN2_Z]]);
        // TOGGLE … ガイドの中を走り、爪より奥で上がる
        // 🔒 この2本はガイドへ入らない。口の所（Y 60.76・壁の手前）でそのまま上がる
        // ⚠ 上がる Y は 61.6。口の 60.76 のままだと束の手前端 59.5 がブリッジの背
        //    （59.8）を 0.05mm3 かすめる
        TR_Y = 61.6;
        harness("TOGGLE", [TGL_AT[0], TR_Y, TGL_AT[1] - 4],
                [[port_at("TOGGLE")[0], TR_Y, RZ2],
                 [TGL_AT[0], TR_Y, RZ2]]);
        harness("REED", [KNOB_AT[0], 53, 42],
                [[port_at("REED")[0], TR_Y, RZ2],
                 [KNOB_AT[0], TR_Y, RZ2],
                 [KNOB_AT[0], TR_Y, 42]]);
        // ---- 音声2本 … 口は右。右の開口で入り、ガイドの中を左へ、左の開口で出る ----
        harness("PHIN", rsp_spk_port() + [0, 6, 0],
                [[port_at("PHIN")[0], port_at("PHIN")[1], RZ2],
                 [OP_R, port_at("PHIN")[1], RZ2],
                 [OP_R, RAIL_RUN, RZ2],
                 [OP_L, RAIL_RUN, RZ2],
                 [OP_L, rsp_spk_port()[1] + 8, RZ2],
                 [rsp_spk_port()[0], rsp_spk_port()[1] + 8, RZ2]]);
        harness("PHOUT", [SPK_X + SPK_L / 2, SPK_Y + SPK_W / 2, IN_Z - 6],
                [[port_at("PHOUT")[0], port_at("PHOUT")[1], RZ2 + 3.2],
                 [OP_R, port_at("PHOUT")[1], RZ2 + 3.2],
                 [OP_R, RAIL_RUN, RZ2 + 3.2],
                 [OP_L, RAIL_RUN, RZ2 + 3.2],
                 [PHOUT_UX, RAIL_RUN, RZ2 + 3.2],
                 [PHOUT_UX, PHOUT_UY, RZ2 + 3.2], [PHOUT_UX, PHOUT_UY, HZ],
                 [PHOUT_UX, SPK_Y + SPK_W / 2, HZ]]);
        // AS5600 … 口は左。左の開口で入り、ガイドの中を右へ、爪より奥で上がる
        // ⚠ 段は AS_RZ（上段）。RZ4 のままだと PHIN と BTN2 と同じ高さで重なる
        // 🔒 レールへ入らない。ブリッジの背（59.8）と壁（64.5）の間で上がってから、
        //    壁の上（Z 35.5・壁は 23.7 まで）を東へ渡る
        // 🔴 **2026-08-21、つまみの裾の下をくぐるのをやめた**（ユーザー指摘）。
        //    ⚠ **これが箱の高さを決めていた。**裾の底（Z_TOP−21.0）とブリッジの頭 28.5 の
        //      隙間に束を通していたので、IN_Z ≥ 49.4 から下げられなかった。
        //    ✅ **AS5600 の板は 23×23 の正方形で、四隅はつまみの円（半径 13.5）から
        //       2.8mm はみ出す**（角までの半径 16.26）。⇒ **奥左の隅へ外から着ける。**
        //      裾の下をくぐらないので、隙間の制約が消える
        //    🔒 隅の座標は板の寸法から引く。つまみが動けば追従する
        AS_PCB_HALF = 11.5;                      // ✅ 実測 23×23 の半分
        AS_CX = KNOB_AT[0] - AS_PCB_HALF;        // 奥左の隅（X）
        AS_CY = KNOB_AT[1] + AS_PCB_HALF;        // 同（Y）。⚠ この X では円は Y 40.4 まで
        AS_CZ = Z_TOP - knob_deep() + 0.8;       // 板の厚みの中ほど
        harness("AS5600", [AS_CX, AS_CY, AS_CZ],
                [[port_at("AS5600")[0], port_at("AS5600")[1], AS_RZ],
                 [AS_NX, port_at("AS5600")[1], AS_RZ],
                 [AS_NX, 63.0, AS_RZ],
                 // ⚠ 上がる Y は 63.0。62 だとブリッジの背の下角を 0.3mm3 かすめる
                 [AS_NX, 63.0, AS_UP],
                 [AS_NX, AS_EY, AS_UP],
                 [AS_CX + 3, AS_EY, AS_UP],
                 // ⚠ 前へ出る X は隅の真上ではなく **+3**。真上（55.2）だと束の外側が
                 //    53.4 まで来て、電池トンネルの外壁（〜54.0）を 8.3mm3 噛む
                 [AS_CX + 3, AS_CY + 4, AS_UP]], n = 4);
        // ---- 電池線（ハブを通らない4本。電流計の右で完結する）----
        // 🔒 電池 → INA226(INPUT) → INA226(OUT) → PowerBoost の JST
        // 🔒 上下するのは**電流計の板（X 2〜29）と電池（X 34〜）の間の X 29〜34**だけ。
        //    r=1.14 なので中心は 30.14〜32.86 しか置けない
        // 🔒 **HZ の帯（Z 46.9〜50.2）へ入らない。**そこは INA と PHOUT が前へ抜ける道。
        //    ⇒ 電池線の横走りは Z 44 と Z 43 に置く（上端 45.1 / 44.1）
        // 🔒 BAT の縦は Y 33、BAT2 の縦は Y 45.4。**Y で分けて交差を避ける**
        // 🔒 端子は左端。電流計の板（X 2〜29 / Y 30〜50.1）の**後ろ（Y 55）で上がる**
        // 🔒 電流計はブリッジの下（Z 16.4〜24）。端子は板の +Y 端で Z 22.4。
        //    ブリッジ（Y 20〜59 / Z 24〜30.1）は幅いっぱいなので、**その後ろ（Y 61）で上下する**
        // ✅ 箱が 10mm 深くなって解けた。電池の層（Z 33）から電流計の端子（Z 22.4）へは
        //    ブリッジ（Y 19.2〜59.8）を越えるしかないが、**ハブ基板の背面より奥**なら
        //    ブリッジが無い。⇒ 右の開口の X で奥へ回り、そこで降りる
        // 🔒 レールへは入らない。ブリッジの背（59.8）より奥・壁（64.5）より手前で降りる
        // ⚠ 端子を出たらすぐ Z 31.5 へ落とす。33.1 のまま東へ走ると AS5600 の
        //    渡り（Z 35.5・下端 33.72）と 0.6 重なる。下は電池の底＝ブリッジの頭 30.1
        // 🔴 **2026-08-21、31.7 → 30.1。**電池の底＝ブリッジの頭が 30.1 → 28.5 へ
        //    下がったので、31.7 のままだと**電池の中**を走る。⇒ 同じ 1.6 を引く。
        //    ⚠ 束の下端 28.84 で、ブリッジの角 28.5 に 0.34 残る
        // 🔴 **2026-08-21、30.1 → 29.4 かつ「2本を平らに並べる」。**
        //    ここもつまみの下の隙間（ブリッジ 28.5 ↔ つまみの底）を通る。
        //    丸2束 φ2.52 では入らない。1本ずつなら 28.51〜30.29 で収まる
        // 🔴 **2026-08-21、29.4 → 30.5。**29.4 はつまみの下の隙間を通すための値で、
        //    端子が奥隅へ移ってその必要が消えた。29.4 だと束の下端 28.14 が
        //    ブリッジの頭 28.5 を 0.8mm3 かすめる
        BAT_EZ = 30.5;
        // 🔴 **2026-08-21、2本を平らに開くのをやめて丸束へ戻した。**開いていたのは
        //    つまみの下の隙間を通すためで、端子が奥隅へ移ってつまみの下を通らなくなった
        loose("BAT", [bat_out(),
                      [BAT_NX, bat_out()[1], BAT_EZ],
                      [BAT_NX, BAT_DY, BAT_EZ],
                      // ⚠ 電流計の PCB の下を通って端子へ。22.4 で寄せると板の面を
                      //    舐めて 18.9mm3 噛む。
                      // 🔴 **2026-08-21、20 → 18.4。**電流計はブリッジからぶら下がって
                      //    いる（INA_AT は DECK_Z 基準）ので、DECK_Z −1.6 で板も
                      //    22.4〜24 → 20.8〜22.4 へ下りた。20 のままだと板の中を走る
                      [BAT_NX, BAT_DY, 18.4],
                      // ⚠ 最後の一区間は WIRE_TRIM（4.0）より長くする。同じだと原点へ落ちる
                      [BAT_NX, ina_in()[1] + 5, 18.4],
                      ina_in()], 2);
        // 🔒 OUT は PowerBoost の JST（X 80 / Z 21.1）のすぐ隣。**箱を横断しない**
        // ⚠ 起点は端子そのものではなく、板の +Y 端の外（束の半径ぶん）。
        //    端子の上から描くと、束の下半分が板に埋まって嘘の当たりが出る
        // 🔒 行き先は**デッキの溝に降りてきた JST のプラグ先**（Z 26.65）。
        //    デッキの下（Z 22.4）を走って、溝の真下で上がる
        BJ = pb_jst_tip();
        // ⚠ 電流計の PCB は Z 22.4〜24。**その下（Z 20）を通る。**22.4 のまま
        //    右へ寄せると板の面を舐めて 41.7mm3 噛む（2026-08-20 に再発）
        // 🔴 **2026-08-21、20.0 → 18.4。**上と同じ理由（電流計が 1.6 下りた）
        BAT2_Z = 18.4;
        // 🔒 JST は板の下端から**下を向いて**出ている（先 Z 16.77）。**下から入る。**
        //    ⚠ Z 20 のまま X 80 へ寄せるとプラグの胴（Z 16.8〜21.5）を 7.1mm3 噛む
        // ⚠ 降りる X は 77.7。ハブ基板の右端 76 と板の面 79.2 の間で、
        //    2本束（φ2.52）の外側が 76.44 と 78.96。どちらにも当たらない
        BAT2_XD = 77.7;
        // 🔴 **WIRE_TRIM（4.0）と同じ長さにしないこと。**最後の一区間がちょうど 4.0 だと
        //    wire_trim_end で長さ 0 になり、向きがゼロ除算で束が原点へ落ちる（2026-08-20）
        BAT2_ZL = BJ[2] - 6.0;
        loose("BAT2", [ina_out() + [0, 3.2, 0],
                       [ina_out()[0], ina_out()[1] + 3.2, BAT2_Z],
                       [ina_out()[0], BJ[1], BAT2_Z],
                       [BAT2_XD, BJ[1], BAT2_Z],
                       [BAT2_XD, BJ[1], BAT2_ZL],
                       [BJ[0], BJ[1], BAT2_ZL],
                       BJ], 2);
    }
}

// ============================================================
// 3. 共通の小物（v1 と同じ）
// ============================================================
NUT_AF = 5.3; NUT_T = 3.2; SCR_D = 2.9; SCR_CB = 5.2; SCR_CBT = 0.8; BOSS = 7.0;
BOSS_H = 9.0;   // 柱の高さ。🔒 奥の2本はこの高さぶん天井から下げる

module cham_box(p0, sz, k) {
    hull() {
        translate([p0[0] + k, p0[1], p0[2]]) cube([sz[0] - 2 * k, sz[1], sz[2]]);
        translate([p0[0], p0[1] + k, p0[2]]) cube([sz[0], sz[1] - 2 * k, sz[2]]);
        translate([p0[0], p0[1], p0[2] + k]) cube([sz[0], sz[1], sz[2] - 2 * k]);
    }
}
module outer_envelope() { cham_box([-WALL, -BEZ_T, -WALL], [OUT_X, OUT_Y, OUT_Z], CHAM); }

// 基板を受ける柱（床から立てる）
// ⭐ **ナットは床の裏のポケットに埋め、ゴム足で蓋をする**（2026-08-18・ユーザー案
//    「ハブ基板の4本は筐体の中央だから、ゴム足付けちゃえばいい」）。
//    🔒 これで ①ねじ山が印刷樹脂でなくなる（セルフタップの摩耗・割れが消える）
//       ②ねじは今までどおり**上から**挿せる（下から通す案より組みやすい）
//       ③ナットは足が押さえるので落ちない ④頭も穴も外から見えない
//       ⑤机の上で滑らない・底が浮く、という本来のゴム足の効き目もそのまま付いてくる
//    ⚠ 位置は 68 × 46mm のスタンス（箱は 86 × 80）。四隅寄りに散っているので足として広い
module floor_post(x, y, h, d = M2_POST) {
    translate([x, y, 0]) difference() {
        cylinder(d = d, h = h);
        translate([0, 0, 1]) cylinder(d = M2_PILOT, h = h);
    }
}
// 床の裏のナットポケット ＋ ゴム足の座（lower_cuts から引く）
// 🔒 六角は**呼び+0.3でジャスト**（docs/PRINT.md の実績値）
NUT2_AF = 4.0 + 0.3;   // M2 ナットの対辺
NUT2_T  = 1.6 + 0.2;   // 厚み
FOOT_D  = 10.0;        // ゴム足の座
FOOT_T  = 0.6;         // 座の深さ（足が沈んで位置が決まる）
module nut_pocket_below(x, y) {
    translate([x, y, -WALL - 0.01]) {
        // ゴム足の座（いちばん外・浅い）
        cylinder(d = FOOT_D, h = FOOT_T + 0.01);
        // ナットのポケット（座の底からさらに奥へ）
        translate([0, 0, FOOT_T])
            rotate([0, 0, 90]) cylinder(d = NUT2_AF / cos(30), h = NUT2_T, $fn = 6);
        // ねじの通り
        cylinder(d = SCR_D - 0.4, h = WALL + 2);
    }
}
// 壁から出す柱（-Y 向き）
// 左（-X）の壁から生やす柱。wall_post の X 版
module side_post(y, z, x_face, len, d = M2_POST) {
    translate([x_face, y, z]) rotate([0, 90, 0]) difference() {
        cylinder(d = d, h = len + 1);
        translate([0, 0, -0.01]) cylinder(d = M2_PILOT, h = len + 2);
    }
}

module wall_post(x, z, y_face, len, d = M2_POST) {
    translate([x, y_face, z]) rotate([-90, 0, 0]) difference() {
        cylinder(d = d, h = len + 1);
        translate([0, 0, -0.01]) cylinder(d = M2_PILOT, h = len + 2);
    }
}

// ============================================================
// 4. 下シェル（底 ＋ 背 ＋ 正面の下枠）
// ============================================================
module lower_raw() {
    union() {
        translate([-WALL, -BEZ_T, -WALL]) cube([OUT_X, OUT_Y, WALL]);   // 底板
        translate([0, IN_Y, -WALL]) cube([IN_X, WALL, IN_Z + WALL]);    // 背板
        back_rail();                                                    // 背面のガイド

        // ---- 正面の下枠（窓の下のふち）----
        // 🔴 2026-08-18 まで**移植し忘れていた**（ユーザーが図で指摘）。窓の下が開いていた。
        // ⚠ X は窓の幅だけ。左右の枠は上シェルの持ち物。
        //    四隅の R のぶん板を WIN_CR だけ高くしてから窓を引くので、両端に角が残る
        difference() {
            translate([WIN_X0, -BEZ_T, 0])
                cube([WIN_X1 - WIN_X0, BEZ_T, WIN_Z0 + WIN_CR]);
            win_prism();
        }
        // ---- OLED が乗る棚 ----
        // 🔴 2026-08-19: 奥行きが OLED_Y1（8.5）だった。8.5 は**フィルムのたわみ込み**の
        //    数字で、板の裏は 4.6 で終わる。ReSpeaker を前へ詰めたら棚が 146mm3 刺さった。
        translate([OLED_X0, 0, 0]) cube([OLED_L, oled_back(), OLED_Z0]);
        // ---- 位置決めのリップ（上シェルの壁がこの外側に落ちる）----
        translate([0, 0, 0])          cube([1.5, IN_Y, 1.5]);
        translate([IN_X - 1.5, 0, 0]) cube([1.5, IN_Y, 1.5]);
        // ---- 合わせのねじボス4本 ----
        for (b = BOSSES) screw_boss(b[0], b[1]);

        // ---- ハブ基板: 四隅の柱4本（🔒 溝もフィンも作らない。位置は柱が決める）----
        // ⚠ 穴は φ3.2 なので、柱の頭を φ3.0 に絞って**穴に入れて位置を出す**。
        //    根元は φ6 のまま座面にする
        for (h = HUB_HOLES) {
            floor_post(h[0], h[1], HUB_STANDOFF);
            translate([h[0], h[1], HUB_STANDOFF]) cylinder(d = 3.0, h = HUB_T + 0.5);
        }

        // ---- ReSpeaker: 立てる（v1 と同じ考え方）----
        // 位置を決める前の土手
        translate([RSP_X, RSP_BD_Y0 - 2, 0])
            cube([respeaker_L(), 2, RSP_Z + 3]);
        // ✅ **ReSpeaker はねじで留めない**（2026-08-18・ユーザー提案「ねじ止め以外の
        //    方法で固定したら？」）。床の溝で挟み、上シェルのリブで上端を押さえる。
        // 🔴 きっかけは衝突: 低いほうの穴は Z 4.657 で、寝かせたハブ基板（Z 2.5〜4.1）と
        //    **同じ高さにあった。** 柱は板の裏から 5mm 後ろへ伸びる必要があり、そこはもう
        //    基板の上（chk_lower が 92.0mm3 で捕まえた）。
        // ⭐ ねじをやめると、高いほうの柱（ヘッダを回り込む腕。v1 自身が「サポートが
        //    付かない面がある」と書いていた）も一緒に消える。**箱も大きくならない。**
        // ⚠ 「基板は立てるだけにしない」の意図は「位置決めだけで固定した気になるな」で、
        //    ねじでなければならないという意味ではない。溝＋上からの押さえは 6方向を拘束する。
        // ---- 後ろの土手（🔒 ハブ基板（X 6〜80）を避けて両端だけ）----
        // ⚠ 左端は **3.5mm ジャックの胴**が Z 5.4〜8 に張り出している（v1 も
        //    「基板の左端側は 3.5mm ジャックの胴」と書いて土手を切っていた）。
        //    ⇒ 左だけ低く（Z 5 まで）。右は板の頭まで立ててよい
        for (g = [[RSP_X, 4, 5.0], [80, 4, RSP_Z + 4]])
            translate([g[0], RSP_BD_Y1 + 0.3, 0]) cube([g[1], 1.7, g[2]]);
        // ---- 左右の端の振れ止め（X 方向。USB-C を挿しても板が横へ逃げない）----
        for (g = [[RSP_X - 1.6, 5.0], [RSP_X + respeaker_L(), RSP_Z + 6]])
            translate([g[0], RSP_BD_Y0 - 2, 0]) cube([1.6, 6, g[1]]);

        // ---- 電池の小部屋 ----
        // 🔴 2026-08-20 撤去。**電池は床から立ち上げられる場所に居ない。**
        //    ハブ基板の上（Z 17〜23）へ移ったので、床から箱を生やすとハブを貫く。
        //    🔴 実際に貫いた: 撤去し忘れたこの箱が床から Z 24.6 まで伸び、
        //       chk_lower が 188 → 19,283mm3 になった（電池が丸ごと塊の中に入った）。
        //    ⬜ **棚をどこで支えるかは未決**（右の壁からの片持ち／天板から吊る）。
        //       機構なので、決まってから作る

        // ---- PowerBoost: 左の壁に留める ----
        // 🔴 2026-08-19 背板から左の壁へ移した。**柱は立てない。**
        //    スロットは 10.024mm しかなく、板が 6.8mm を使う。3.2mm の残りに柱を挟むと
        //    部品面がハブ基板の縁に触れる。⇒ **PCB の背を壁に密着させ、壁を貫くねじで留める**
        //    （背板に留めていたときと同じやり方で、面が変わっただけ）

        // ---- INA226 ----
        // 🔴 2026-08-20 背板からの腕2本を撤去。**INA は背板から遠い場所へ移った**ので、
        //    Y 66 から前へ伸ばす腕では届かない（腕だけが宙に残っていた）。
        //    ⬜ **受けをどこから出すかは未決。電池の棚と同じ問題**なので、まとめて決める。
        //       床からは立てられない（寝かせたハブ基板を貫く・2026-08-17 に 122.9mm3）。
        // ⬜ 取付穴も未実測（着荷 8/21〜29）

        // ---- ケーブルガイド ----
    }
}

// ============================================================
// 🔴 ケーブルガイドは置かない
// ============================================================
// 2026-08-20、背板の多連コーム（cable_comb）とクリップ一式を全部やめて、消した。
// 🔒 **ガイドは見栄えのための物**（開けて見せる機体なので、線が決まった道を通っている
//    こと自体が見た目になる）。ところが実物の絵はそうならなかった:
//    ・束が縦に抜ける X ごとにスリットが要り、11 か所で台が千切れる。高さを絞って
//      残りを 27mm → 58mm（全長 72mm）まで戻したが、それでも「棚」には見えない
//    ・後ろの1枚の面に12本を集めて高さで分けるので、**縦と横が 8 か所で交差する**。
//      段の割り当てを総当たりで解いても最小 6。基板配線の流儀（交差させない）と逆の絵
//    ⇒ ユーザー判断（2026-08-20）「価値なし」。**ガイドで見栄えは作れない**
// 🔒 死んだコードは残さない。戻したくなったら git を見ること
// ⚠ **段（LANE_RZ）は残す。** これはガイドではなく、後ろの縦路 Y 63 で束どうしを
//    高さで離すための**経路の決めごと**。wires_v2() がこれを使っている
// 🔒 **後ろの横路の段。** Y 63 は全部の束が共有するので、**高さで分ける**。
//    ブリッジ（Z 24〜30.1）の上、Z 32〜52 が空いているのでそこに5段。
//    ⚠ 段へ上がる X は口の真上。**上がれない X がある**（合わせボス X 0〜7 と 79〜86 は
//       Z 44 以上、トグルの胴 X 33.5〜46.5 は Z 41〜53）。段の割り当てはそれを見て決める
// 🔴 **トグルの胴（X 33.5〜46.5 / Y 48〜66 / Z 41〜53）が後ろの横路を分断する。**
//    そこを跨ぐ束は **Z 41 より下**しか通れない。⇒ 段は 17 / 22 / 31 / 36 の4本。
//    ⭐ **X の範囲が重ならない束は同じ段を共有できる**（INA は X 25〜38、
//       トグルは X 40〜61 で重ならない）。これで4段に6本が載る
//    ・19 … PWR 3本（X 71→10）
//    ・25 … PWR EN 1本（X 71→14）
//    ・31 … PHOUT（X 80→32.15）
//    ・37 … INA（X 38→29.2） ＋ TOGGLE（X 61→40）
//    ・43 … REED（X 53→59）。**トグルの右だけ**の別コーム
//    ⚠ BTN2 は段を使わない。口の X（16.5）がそのまま左の通路なので**真上へ上げる**
//    ⚠ 一番下の段は 19。17 だとコームの下端 14.1 がハブの会話ボタン（頭 Z 15.1）に当たる
LANE_RZ  = [19, 25, 31, 37];
LANE_RZ2 = [43];   // トグルより右だけ

// 線を出す。**切るなら薄切り（intersection）にする。** "cut" と同じ引き算だと、
// 残った半分を外から見ることになって束の並びが読めない
CUT_TH = 0;   // [0:1:20]  0 なら切らない。>0 なら CUT_AT から CUT_TH mm を薄く切り出す
module wires_view() {
    if (CUT_TH <= 0) wires_v2();
    else intersection() {
        wires_v2();
        translate([CUT_AXIS == 0 ? CUT_AT : -100,
                   CUT_AXIS == 1 ? CUT_AT : -100,
                   CUT_AXIS == 2 ? CUT_AT : -100])
            cube([CUT_AXIS == 0 ? CUT_TH : 400,
                  CUT_AXIS == 1 ? CUT_TH : 400,
                  CUT_AXIS == 2 ? CUT_TH : 400]);
    }
}

// ============================================================
// 背面のガイド ── **開口は3つだけ（左・中・右）**
// ============================================================
// 🔴 ここまでに2回失敗している。コーム（スリット11か所）と、1本ずつ仕切ったレール
//    （開口45か所）。どちらも**線が横切るたびに部品へ穴を開けた**のが原因で、
//    残った物が「千切れた小片」に見えた。
// 🔒 **2026-08-20 ユーザー指示で作り直し:**
//    ・ケーブルは直角でなくてよい（斜めに引いてよい）
//    ・**開口は左・中・右の3つだけ。**線はいちばん近い開口へ集める
//    ・爪を長くして**挟む**（載せるだけにしない）
//    ⇒ **開口を先に決めて、そこを中心に経路を設計する**
RAIL_X0 = 4.0;  RAIL_X1 = 78.0;
// 🔒 ガイドは**ハブ基板の背面（Y 63.9）より奥**に置く。ハウジングに載せない
RAIL_Y0 = 64.5;              // 樋の手前の壁
RAIL_ZB = 15.7;              // 床の上面（ハウジングの頭 14.1 の上）
RAIL_T  = 1.6;               // 板厚
RAIL_H  = 8.0;               // 手前の壁の高さ
RAIL_CLAW = 3.0;             // 爪の出（奥へ張り出して束を挟む）
RAIL_CLAW_T = 1.4;           // 爪の厚み
RAIL_NOTCH = [13.0, 19.2];   // 床だけ抜く（ハブの背の高い部品）
// 🔒 **開口。ここだけで線が壁を越える。**左・中・右
// 🔒 左は 9.5。**BTN2 も AS5600 も開口を通らない**ので、13 にも 15.5 にも縛られない。
//    ⚠ PHIN の南北の車線はここで決まる。**BTN2 の口（X 12.52）と AS5600 の口（15.06）
//       から立ち上がる束が塞いでいる帯（X 11.26〜16.84）を避ける**必要がある
RAIL_OPEN = [9.5, 44.0, 70.0];
// 🔒 **開口は狭く。**広げるとレールに見えない（2026-08-20 ユーザー）。
//    ⇒ 線は開口の X で一度そろえてから、**まっすぐ壁を抜ける**
RAIL_OW   = 6.0;             // 開口の幅（いちばん太い束 3.57 ＋ 逃げ）
// 🔒 線が走る Y。**爪の下**（爪は Y 60.6 まで張り出す）
RAIL_RUN = 68.0;   // ⚠ 壁の裏面 66.1 ＋ 束の半径
// 🔒 上へ抜ける束の Y。**爪より奥**でないと爪に当たる
RAIL_UP  = 72.0;
module back_rail() {
    difference() {
        union() {
            translate([RAIL_X0, RAIL_Y0, RAIL_ZB - RAIL_T])                 // 床
                cube([RAIL_X1 - RAIL_X0, IN_Y - RAIL_Y0, RAIL_T]);
            translate([RAIL_X0, RAIL_Y0, RAIL_ZB])                          // 手前の壁
                cube([RAIL_X1 - RAIL_X0, RAIL_T, RAIL_H]);
            translate([RAIL_X0, RAIL_Y0, RAIL_ZB + RAIL_H - RAIL_CLAW_T])   // 爪
                cube([RAIL_X1 - RAIL_X0, RAIL_T + RAIL_CLAW, RAIL_CLAW_T]);
        }
        translate([RAIL_NOTCH[0], RAIL_Y0 - 1, RAIL_ZB - RAIL_T - 1])
            cube([RAIL_NOTCH[1] - RAIL_NOTCH[0], IN_Y - RAIL_Y0 + 2, RAIL_T + 2]);
        for (ox = RAIL_OPEN)                                                // 開口3つ
            translate([ox - RAIL_OW / 2, RAIL_Y0 - 1, RAIL_ZB - 0.01])
                cube([RAIL_OW, RAIL_T + RAIL_CLAW + 2, RAIL_H + 1]);
    }
}

module lower_cuts() {
    // ハブ基板: ねじの通り穴 ＋ 床の裏のナットポケット ＋ ゴム足の座
    // ⚠ 下穴（φ1.7）ではなく**通し穴**にする。ねじ山はナットが持つ
    for (h = HUB_HOLES) {
        translate([h[0], h[1], -WALL - 1])
            cylinder(d = SCR_D - 0.4, h = WALL + HUB_STANDOFF + 3);
        nut_pocket_below(h[0], h[1]);
    }
    // 🔴 ReSpeaker の下穴は**削除した**（2026-08-18）。ねじ止めをやめて溝＋押さえリブに
    //    したのに、下穴を開ける行だけ残っていた。柱が無いので、床と背板に意味のない
    //    φ1.7 の穴が2つ開くだけになっていた。**やめた機構の痕跡を残さない。**
    // 🔴 PowerBoost の下穴は**上シェルへ移した**（2026-08-20）。右の壁は上シェルの
    //    持ち物（下シェルは床しか無い）なので、ここに書いても板に届かなかった
    // ---- スイッチ K1 の逃げ（右前のねじボス）----
    // 🔴 2026-08-19 ReSpeaker を前へ詰めたら、マイク面のスイッチ K1 が
    //    右前のねじボス（X 79〜86 / Y 0〜7）へ 25.8mm3 埋まった。
    //    ⭐ 当たるのは**押しボタン**なので、接触では済まない（押しっぱなしになる）。
    //    ⇒ ボスの側面をスイッチのぶんだけ欠く（0.3 の逃げ付き）。ボスの芯は残る
    translate([RSP_X + respeaker_L() - 6.132, RSP_BD_Y0 - RSP_SW_OUT - 0.3, RSP_Z + 3.812])
        cube([5.2, RSP_SW_OUT + 0.6, 4.1]);
    // トグルのパネル穴
    translate([TGL_AT[0], IN_Y + WALL + 1, TGL_AT[1]])
        rotate([90, 0, 0]) mts102_hole(WALL + 2);
    // 同軸を出すスリット（鍵穴の縦棒。ブッシングの丸と繋げて1つの口にする）
    translate([TGL_AT[0] - ANT_SLOT_W / 2, IN_Y - 1, TGL_AT[1]])
        cube([ANT_SLOT_W, WALL + 2, ANT_OFF + ANT_SLOT_W / 2]);
    // 窓の縁の 45度カット（下枠のぶん）。🔒 上シェルと同じ形を引くので段差にならない
    win_chamfer_cut();
}

module shell_lower() {
    intersection() {
        difference() { lower_raw(); lower_cuts(); }
        outer_envelope();
    }
}

// ============================================================
// 4.5 合わせのねじボス（v1 と同じ）
// ============================================================
function boss_nut_x(pos, dir) =
    (dir < 0) ? pos[0] + 0.6 : pos[0] + BOSS - 0.6 - NUT_T;
module screw_boss(pos, dir) {
    difference() {
        union() {
            translate(pos) cube([BOSS, BOSS, BOSS_H]);
            if (pos[2] > 0)
                translate([pos[0], pos[1] + BOSS, pos[2]]) rotate([90, 0, 0])
                    linear_extrude(BOSS)
                        polygon([[BOSS - 3.5, 0], [BOSS, 0], [BOSS, -3.5]]);
        }
        translate([pos[0] - 1, pos[1] + BOSS / 2, pos[2] + 4.5])
            rotate([0, 90, 0]) cylinder(d = SCR_D, h = BOSS + 2);
        translate([boss_nut_x(pos, dir), pos[1] + BOSS / 2, pos[2] + 4.5])
            rotate([0, 90, 0]) rotate([0, 0, 90])
                cylinder(d = NUT_AF / cos(30), h = NUT_T, $fn = 6);
        translate([boss_nut_x(pos, dir), pos[1] - 1, pos[2] + 4.5 - NUT_AF / 2])
            cube([NUT_T, BOSS / 2 + 1, NUT_AF]);
    }
}
module screw_hole(pos, dir) {
    x = (dir < 0) ? pos[0] : pos[0] + BOSS;
    translate([x, pos[1] + BOSS / 2, pos[2] + 4.5]) rotate([0, 90 * dir, 0]) {
        cylinder(d = SCR_D, h = WALL + 1);
        translate([0, 0, WALL - SCR_CBT]) cylinder(d = SCR_CB, h = SCR_CBT + 1);
    }
}
// 🔴 **奥の2本は 44 の手書きだった。**天井を 55.207 → 52.1 に下げたら、柱の頭
//    53.0 が天板（52.1〜）を 88.2mm3 突き抜けた。⇒ 天井から BOSS_H ぶん下げる
BOSSES = [[[0,           0,           0], -1],
          [[IN_X - BOSS, 0,           0], +1],
          [[0,           IN_Y - BOSS, IN_Z - BOSS_H], -1],
          [[IN_X - BOSS, IN_Y - BOSS, IN_Z - BOSS_H], +1]];

// ============================================================
// 4.6 正面の窓・ヒゲ・音の穴（v1 からそのまま）
// ============================================================
// 二次ベジエ1本。k=0 なら 45度の直線に戻る
function bev_pts(c, k, n = 10) =
    [for (i = [0 : n]) let (t = i / n, p = (1 - k) * c / 2)
        [2 * t * (1 - t) * p + t * t * c,
         (1 - t) * (1 - t) * c + 2 * t * (1 - t) * p]];

module win_rrect(g = 0) {
    hull() for (x = [WIN_X0 + WIN_CR, WIN_X1 - WIN_CR],
                z = [WIN_Z0 + WIN_CR, WIN_Z1 - WIN_CR])
        translate([x, z]) circle(r = WIN_CR + g, $fn = 40);
}
module win_prism() {
    translate([0, 1, 0]) rotate([90, 0, 0]) linear_extrude(BEZ_T + 2) win_rrect();
}
module win_bev_slab(g, y) {
    translate([0, y + 0.01, 0]) rotate([90, 0, 0]) linear_extrude(0.01) win_rrect(g);
}
module win_chamfer_cut() {
    hull() {
        win_bev_slab(WIN_CH, -BEZ_T - 0.5);
        for (p = bev_pts(WIN_CH, WIN_R)) win_bev_slab(p[1], -BEZ_T + p[0]);
    }
}

module whisker_plate(l, w, y) {
    translate([-l / 2, y, -w / 2]) rotate([90, 0, 0]) spk_obround(l, w, 0.01);
}
module whisker_cut(l, w, ch) {
    fy = -BEZ_T / 2;
    hull() {
        whisker_plate(l + ch * 2, w + ch * 2, fy - 0.5);
        for (p = bev_pts(ch, WSK_R))
            whisker_plate(l + p[1] * 2, w + p[1] * 2, fy + p[0]);
    }
    hull() {
        whisker_plate(l, w, fy + ch);
        whisker_plate(l, w, fy + BEZ_T + 1);
    }
}

// 音を出す穴（六方格子）
module grille_xy(cx, cy, w, d, z0, t, dia = 2.6, pitch = 4.2) {
    nx = floor(w / pitch);
    ny = floor(d / (pitch * 0.866));
    for (j = [0 : ny], i = [0 : nx]) {
        px = cx - nx * pitch / 2 + i * pitch + (j % 2 ? pitch / 2 : 0);
        py = cy - ny * pitch * 0.866 / 2 + j * pitch * 0.866;
        if (abs(px - cx) <= w / 2 && abs(py - cy) <= d / 2)
            translate([px, py, z0 - 0.01]) cylinder(d = dia, h = t + 0.02);
    }
}

// ============================================================
// 4.7 会話ボタン（ポケット・キャップ・半月クリップ）— v1 からそのまま
// ============================================================
module btn_socket() {
    B  = tsw_body();
    yi = B / 2 + 0.3;
    translate([-BTN_PAD_X / 2, -BTN_PAD_Y / 2, Z_BTN_PAD])
        cube([BTN_PAD_X, BTN_PAD_Y, IN_Z - Z_BTN_PAD]);
    difference() {
        translate([-BTN_POST_I - BTN_PKT_T, -BTN_POST_I - BTN_PKT_T, Z_TSW_TOP])
            cube([(BTN_POST_I + BTN_PKT_T) * 2, (BTN_POST_I + BTN_PKT_T) * 2,
                  Z_NECK1 - Z_TSW_TOP]);
        translate([0, 0, Z_TSW_TOP - 1])
            cylinder(d = BTN_HOLE_D, h = Z_NECK1 - Z_TSW_TOP + 2);
    }
    for (sx = [-1, 1], sy = [-1, 1])
        translate([sx * BTN_POST_I + (sx < 0 ? -BTN_PKT_T : 0),
                   sy * BTN_POST_I + (sy < 0 ? -BTN_PKT_T : 0), Z_NECK1])
            cube([BTN_PKT_T, BTN_PKT_T, Z_BTN_PAD - Z_NECK1]);
    for (sy = [-1, 1]) mirror([0, sy < 0 ? 1 : 0, 0])
        translate([-BTN_CLAW_W / 2, yi, 0]) {
            translate([0, 0, Z_TSW_BOT - BTN_CLAW_G])
                cube([BTN_CLAW_W, BTN_PKT_T, Z_TSW_TOP - Z_TSW_BOT + BTN_CLAW_G + 0.01]);
            translate([0, 0, Z_TSW_BOT]) rotate([90, 0, 90]) linear_extrude(BTN_CLAW_W)
                polygon([[0, 0], [-BTN_CLAW_G, 0], [0, -BTN_CLAW_G - 0.8]]);
        }
    for (sx = [-1, 1])
        translate([sx * yi + (sx < 0 ? -BTN_PKT_T : 0), -1.0, Z_TSW_TOP - 1.2])
            cube([BTN_PKT_T, 2.0, 1.2]);
}

module button_cap() {
    z_head = Z_TOP - (BTN_H - BTN_OUT);
    z_top  = z_head + BTN_H;
    difference() {
        hull() {
            translate([-BTN_L / 2, -BTN_W / 2, z_head])
                spk_obround(BTN_L, BTN_W, BTN_H - 0.8);
            translate([-(BTN_L - 1.6) / 2, -(BTN_W - 1.6) / 2, z_top - 0.01])
                spk_obround(BTN_L - 1.6, BTN_W - 1.6, 0.01);
        }
        difference() {
            translate([-(BTN_L - BTN_WALL * 2) / 2, -(BTN_W - BTN_WALL * 2) / 2,
                       z_head - 0.01])
                spk_obround(BTN_L - BTN_WALL * 2, BTN_W - BTN_WALL * 2, BTN_H - BTN_WALL);
            cylinder(d = BTN_PLG_D + 2.4, h = 100);
        }
    }
    translate([0, 0, Z_NECK0]) cylinder(d = BTN_PLG_D, h = z_head - Z_NECK0 + 0.01);
    translate([0, 0, Z_NECK1]) cylinder(d = BTN_NECK_D, h = Z_NECK0 - Z_NECK1 + 0.01);
    translate([0, 0, Z_TIP])   cylinder(d = BTN_PLG_D, h = BTN_LIP_H + 0.01);
}

module button_clip() {
    linear_extrude(BTN_CLIP_T) difference() {
        circle(d = BTN_CLIP_D);
        circle(d = BTN_NECK_D + 0.15);
        polygon([[-1.45, -1.0], [1.45, -1.0], [2.3, -BTN_CLIP_D], [-2.3, -BTN_CLIP_D]]);
    }
}

module oled_washer() {
    linear_extrude(OLED_WASH_T) difference() { circle(d = 6.0); circle(d = 2.3); }
}

// 尻尾（レバーに挿すカバー）
module tail_cap() {
    difference() {
        hull() {
            translate([0, 0, TAIL_D0 / 2]) sphere(d = TAIL_D0);
            translate([0, 0, TAIL_L - TAIL_D1 / 2]) sphere(d = TAIL_D1);
        }
        translate([0, 0, -0.01]) cylinder(d = TAIL_BORE, h = 9.5);
        translate([0, ANT_OFF, -0.01]) cylinder(d = ANT_CH_D, h = 11);
        translate([0, 0, 9]) cylinder(d = ANT_CH_D, h = TAIL_L - 9 - 1.2);
        hull() {
            translate([0, ANT_OFF, 10]) cylinder(d = ANT_CH_D, h = 0.01);
            translate([0, 0, 11]) cylinder(d = ANT_CH_D, h = 0.01);
        }
    }
}

// ============================================================
// 4.8 上シェル（天面 ＋ 左右の側面 ＋ 窓の枠）
//     印刷: **天面を下にして置く**
// ============================================================
module upper_raw() {
    difference() {
        union() {
            translate([-WALL, -BEZ_T, IN_Z]) cube([OUT_X, OUT_Y, TOP_T]);   // 天面
            for (sx = [-WALL, IN_X])                                        // 左右の側面
                translate([sx, -BEZ_T, 0]) cube([WALL, OUT_Y, IN_Z]);
            // 窓の枠（下枠と下の角2つは下シェルの持ち物なので引いておく）
            difference() {
                translate([0, -BEZ_T, 0]) cube([IN_X, BEZ_T, IN_Z]);
                win_prism();
                translate([WIN_X0, -BEZ_T - 1, -1])
                    cube([WIN_X1 - WIN_X0, BEZ_T + 2, WIN_Z0 + WIN_CR + 1]);
            }
            // ---- ブリッジ（電池を載せる）＋ 電池のトンネル ----
            bridge();
            battery_tunnel();
            // OLED のねじボス4本（裏から M2×8）
            for (h = OLED_HOLES)
                translate([h[0], 0, h[1]]) rotate([-90, 0, 0])
                    cylinder(d = 5.0, h = OLED_BOSS_L);
            // スピーカーの位置出しの縁（貼るだけ。受け皿は作らない）
            translate([SPK_X - SPK_RIM_M, SPK_Y - SPK_RIM_M, IN_Z - SPK_RIM])
            difference() {
                spk_obround(SPK_L + SPK_RIM_M * 2, SPK_W + SPK_RIM_M * 2, SPK_RIM);
                // ⚠ 逃げは片側 0.6（2026-08-19）。0.3 だと chk_upper に 8.0mm3 出た。
                //    縁は**位置出しだけ**の部品なので、広げても役目は変わらない
                translate([SPK_RIM_M - 0.6, SPK_RIM_M - 0.6, -1])
                    spk_obround(SPK_L + 1.2, SPK_W + 1.2, SPK_RIM + 2);
            }
            translate(KNOB_AT) knob_station_add();          // つまみの座
            translate([BTN_AT[0], BTN_AT[1], 0]) btn_socket();
            // ---- ReSpeaker の上端を押さえるリブ（ねじの代わり）----
            // 🔒 天板から降りて、板の頭（Z 36.007）に 0.3mm の押し代で当たる。
            //    これで床の溝と合わせて 6方向とも拘束される。
            // 🔒 **前のリブの X は両隣から計算する。数字で書かない。**
            //    ✅ 2026-08-19 ユーザー指定「マージンをそろえてくれればなんでもいい」
            //    ⚠ 以前は sx = 32 と直書きしていて、§2.5 でスピーカーが +3 動いたときに
            //       置き去りになり、天面に 0.0911mm3 食い込んだ（旧 X 8.5〜31.5 前提の数字）
            for (sx = [RIB1_X, 74])
                translate([sx, RSP_BD_Y0 - 0.5, RSP_TOP + 0.3])
                    cube([sx == RIB1_X ? RIB1_W : 8, respeaker_T() + 1.0,
                          IN_Z - RSP_TOP - 0.3]);
        }

        // ============ 引くもの ============
        translate(KNOB_AT) knob_station_cut();
        // 🔒 2026-08-21: ここには一度「座の右下を 1.6mm 欠く」逃げを入れていた。**外した。**
        //    つまみ側で板全体を 8.0 に厚くしたせいで座の下端が Z 41.6 → 40.1 へ下がり、
        //    PowerBoost へ 13.68mm3 噛んだのを、こちらで削って辻褄合わせしていた。
        //    ⇒ つまみ側を**中央だけの段（BOSS）**に直したので、外周は 6.5mm のまま＝
        //      座の下端は Z 41.6 に戻り、**筐体を削る理由が消えた**（当たりは 0.0000mm3）。
        //    ⚠ **座は knob_v5 の PAD_X / PAD_Y / PAD_T そのもの**（1729行の knob_station_add）。
        //      向こうの外周の厚みを増やすと、必ずここへ出る。増やす前に chk_one IDX=5 を見ること
        // 皿（俵型）
        translate([BTN_AT[0] - BTN_DISH_L / 2, BTN_AT[1] - BTN_DISH_W / 2, Z_BTN_DISH])
            spk_obround(BTN_DISH_L, BTN_DISH_W, BTN_DISH_T + 1);
        translate([BTN_AT[0], BTN_AT[1], Z_TOP - 0.3]) hull() {
            translate([-BTN_DISH_L / 2, -BTN_DISH_W / 2, 0])
                spk_obround(BTN_DISH_L, BTN_DISH_W, 0.01);
            translate([-BTN_DISH_L / 2 - 0.3, -BTN_DISH_W / 2 - 0.3, 0.3])
                spk_obround(BTN_DISH_L + 0.6, BTN_DISH_W + 0.6, 0.01);
        }
        translate([BTN_AT[0], BTN_AT[1], Z_BTN_PAD - 1])
            cylinder(d = BTN_HOLE_D, h = BTN_PAD_T + 2);
        // 振動板の逃げ
        translate([SPK_X + (SPK_L - SPK_DIA[0]) / 2 - 0.5,
                   SPK_Y + (SPK_W - SPK_DIA[1]) / 2 - 0.5, IN_Z - 0.01])
            spk_obround(SPK_DIA[0] + 1, SPK_DIA[1] + 1, SPK_REL + 0.01);
        // 天面のへこみ（壁は45度）
        translate([SPK_X + SPK_L / 2, SPK_Y + SPK_W / 2, 0]) hull() {
            translate([0, 0, Z_TOP - EMB_H]) linear_extrude(0.01)
                offset(r = 2) square([SPK_DIA[0] + EMB_M * 2 - 4,
                                      SPK_DIA[1] + EMB_M * 2 - 4], center = true);
            translate([0, 0, Z_TOP + 1]) linear_extrude(0.01)
                offset(r = 2) square([SPK_DIA[0] + EMB_M * 2 - 4 + (EMB_H + 1) * 2,
                                      SPK_DIA[1] + EMB_M * 2 - 4 + (EMB_H + 1) * 2],
                                     center = true);
        }
        // 音の穴（🔒 振動板の上だけ）
        grille_xy(SPK_X + SPK_L / 2, SPK_Y + SPK_W / 2,
                  SPK_DIA[0], SPK_DIA[1], IN_Z, TOP_T, 2.2, 3.4);
        win_chamfer_cut();
        // マイクのヒゲ（正面のベゼル。位置は PARTS_CAD から引く）
        for (ref = ["U4", "U5"]) {
            m = cad_part(ref, -1);
            bx = RSP_X + respeaker_L() - (m[2] + m[3]) / 2;
            bz = RSP_Z + (m[4] + m[5]) / 2;
            out = (bx < IN_X / 2) ? 1 : -1;
            for (i = [-1, 0, 1])
                translate([bx - out * 1.0, -BEZ_T / 2, bz + i * 3.6])
                    rotate([0, out * i * WSK_ANG, 0]) whisker_cut(WSK_L, WSK_W, WSK_CH);
        }
        // XIAO の USB-C（右の壁）
        translate([IN_X - 1, RSP_BD_Y1 - 0.5, RSP_Z + 14 - 1.5])
            cube([WALL + 2, 10.5, 12]);
        battery_port_cut();   // 🔒 電池の口（左の壁）。上シェルでしか抜けない
        // 🔴 **2026-08-21、つまみの島の柱が電池の通り道へ入った。**柱の下端は
        //    `Z_TOP − 18.1`（AS5600 の板の面）で、天井を下げると電池の頭 34.5 を
        //    割る（実測 2.4mm3・左手前の1本）。🔒 **電池の通り道は誰も侵さない**
        //    ——トンネルの内側を上シェルからも引いて、構造の側に譲らせる
        translate([BAT_C0[0] - WALL - 2, BAT_C0[1], BAT_C0[2]])
            cube([BAT_C1[0] - BAT_C0[0] + WALL + 2, BAT_C1[1] - BAT_C0[1],
                  BAT_C1[2] - BAT_C0[2]]);
        // 🔴 **2026-08-21、PWR の線が つまみの座の板（Z 45.3〜46.8）の右奥の角に
        //    入る**（実測 7.3mm3）。つまみを右へ 6mm 寄せたことで、板の右端 80.9 が
        //    PowerBoost の端子（X 〜79 / Y 〜48）の上へ被さったため。
        //    🔒 **角だけ落とす。**ねじの柱（つまみの中心から 13 以内）には掛からない
        // 🔴 **2026-08-21、拡張。**つまみを右へ動かしたぶん、座の板の右端が
        //    PowerBoost の部品（X 81.1 から・Z 42.9〜47.3）へ入る。板の角を落とす
        translate([81.0, 28.0, Z_TOP - 9.5]) cube([IN_X - 81.0, 25.0, 7.5]);
        translate([74.5, 45.5, Z_TOP - 9.5]) cube([IN_X - 74.5, 7.0, 7.5]);
        // PowerBoost の下穴（**右の壁**を横向きに貫く）。PB_HOLES は [Y, Z]
        // 🔒 板はブリッジの構造の一部なので、この4本はブリッジの右端も留めている
        for (h = PB_HOLES)
            translate([IN_X - 1, h[0], h[1]]) rotate([0, 90, 0])
                cylinder(d = M2_PILOT, h = WALL + 2);
        // ✅ 2026-08-20 ユーザー決定: **充電口は外へ出さない。**中でケーブルを受けて、
        //    箱の外は Type-C にする。⇒ **壁には開けない。**要るのはプラグが挿さる空間だけ
        //    （下の pb_usb_space。chk_usb で見張る）
        // OLED のねじの下穴
        for (h = OLED_HOLES)
            translate([h[0], -BEZ_T + 0.6, h[1]]) rotate([-90, 0, 0])
                cylinder(d = M2_PILOT, h = BEZ_T - 0.6 + OLED_BOSS_L + 0.5);
        for (b = BOSSES) screw_hole(b[0], b[1]);
    }
}
// ⚠ スピーカーの盛り上げのぶんだけ天面より上を許す
module shell_upper() {
    difference() {
    intersection() {
        upper_raw();
        union() {
            outer_envelope();
            translate([SPK_X - 6, SPK_Y - 6, Z_TOP - 1])
                cube([SPK_L + 12, SPK_W + 12, EMB_H + 1]);
        }
    }
    // 🔴 **2026-08-21、右の壁の電池の引き出し口を削除した**（ユーザー指摘）。
    //    2026-08-20 に電池の口を**右の壁 → 左の壁**へ移した（`battery_port_cut()`）のに、
    //    右の穴を開ける行が残っていて、**右側面に大穴が開いたままだった。**
    }
}

// ============================================================
// 5. 中身（当たり検査用）
// ============================================================
// 🔒 **部品の置き場所はここにしか書かない。** 1つだけ当てたいときもこの module を呼ぶ。
//   検査側で座標を書き直すと、同じ名前の違う部品を比べることになる。
// 🔴 2026-08-19、まさにそれをやった。parts_v2() がスピーカーを [8.5, 9.5] と直書きして
//   いて、§2.5 のレイアウトが 11.5/12.5 へ動いたときに部品だけ取り残された。
//   別ファイルで単体に当てたときは正しい SPK_X/SPK_Y を書いてしまっていたので、
//   どの部品も単体では 0 なのに全体では 3.2mm3 出る、という存在しない当たりを追った。
//
//   使い方: openscad -o one.stl -D 'part="chk_one"' -D IDX=4 hardware/case_v2.scad
//   （IDX は PARTS_V2 の何番目か。-1 なら全部。SHELL="lower" で下シェルと当てる）
PARTS_V2 = ["respeaker", "oled", "hub", "knob", "speaker",
            "powerboost", "lipo", "ina226", "toggle", "tailcap", "tactsw"];
// i 番目の部品だけを通すフィルター。pick が負なら全部通す
module p_(i, pick) { if (pick < 0 || pick == i) children(); }
module parts_v2(pick = -1) {
    p_(0, pick) translate([RSP_X + respeaker_L(), RSP_BD_Y1, RSP_Z]) rotate([0, 0, 180])
        respeaker_lite();
    p_(1, pick) translate([OLED_X0, OLED_Y1, OLED_Z0]) rotate([90, 0, 0]) oled_242();
    p_(2, pick) translate(HUB_AT) hub_board(false);
    p_(3, pick) translate(KNOB_AT) assembly(show_deck = false);
    p_(4, pick) translate([SPK_X, SPK_Y, IN_Z - spk_th() - 0.2]) speaker_112495();
    // 🔒 立てる。rotate([0,90,0]) で 板のX→箱の-Z / 板のY→箱のY / 板のZ→箱の+X
    // 🔒 立てて長辺を下へ。板のX→箱の-Y / 板のY→箱の+Z / 板のZ→箱の-X
    //    ⚠ 面内で 180 度返してある。返さないと**電池の JST が下を向いて床を突き抜ける**
    //       （2026-08-20 実際にそうなり chk_lower が 188 → 320 になった）
    // 🔒 pb2box と同じ回転をここに書く。rotate([0,0,90]) が「上下逆」のぶん
    p_(5, pick) translate([PB_X1, PB_AT[1], PB_AT[2] + PB_W]) rotate([0, -90, 0]) rotate([0, 0, 90]) {
        powerboost_1000c();
        pb_jst_plug();
    }
    p_(6, pick) translate(LIPO_AT) lipo_1000mah();   // 🔒 寝かせる（背面に立てるのをやめた）
    // 🔒 **L字ヘッダを手前（-Y）へ向ける。** +Y のままだとリレー（Y 39.2〜）へ 2.2mm3 噛む
    // 🔒 ブリッジの下面へ**部品面を下に向けて**貼る。rotate([180,0,0]) で局所 z が -Z へ
    p_(7, pick) translate([INA_AT[0], INA_AT[1] + ina_size()[1], INA_AT[2] + ina_h()])
        rotate([180, 0, 0]) ina226_module();
    p_(8, pick) translate([TGL_AT[0], IN_Y, TGL_AT[1]]) rotate([-90, 0, 0]) mts102(TAIL_ANG);
    p_(9, pick) color("#9aa5b1") translate([TGL_AT[0], IN_Y + WALL, TGL_AT[1]])
        rotate([-90, 0, 0]) rotate([TAIL_ANG, 0, 0]) translate([0, 0, TAIL_GAP]) tail_cap();
    p_(10, pick) translate([BTN_AT[0], BTN_AT[1], Z_TSW_BOT]) tactswitch();
}

// 印刷部品（筐体ではないが組み立てビューに要る）
module printed_extras() {
    color("#d8dde3") translate([BTN_AT[0], BTN_AT[1], 0]) button_cap();
    color("#8892a0") translate([BTN_AT[0], BTN_AT[1], Z_NECK1]) button_clip();
}

// ============================================================
// 5.5 見るための部品（形には影響しない）
// ============================================================
module both_shells() {
    color("#9aa5b1", SHELL_A)        shell_lower();
    color("#b6c0cc", SHELL_A * 0.85) shell_upper();
}
// 🔒 **線は部品と一緒に出す。** 当たりの体積は「通らない」を教えてくれない。
//    指が入るか、束が曲がり切るか、順番に組めるかは**目で見るしかない**
//    （2026-08-20 ユーザー「この配線無理だろみたいなのが分からないと困る」）
// 🔴 2026-08-20、機器位置のやり直し中は**線を出さない**（ユーザー指示）。
//    配置が固まってから true に戻す
SHOW_WIRES = true;   // 線を一緒に描くか
module assembly_view() {
    both_shells(); printed_extras(); parts_v2();
    if (SHOW_WIRES) wires_v2();
}

// 断面。CUT_AXIS の向きに CUT_AT より先を切り落とす
module cut_view() {
    difference() {
        assembly_view();
        translate([CUT_AXIS == 0 ? CUT_AT : -60,
                   CUT_AXIS == 1 ? CUT_AT : -60,
                   CUT_AXIS == 2 ? CUT_AT : -60])
            cube([CUT_AXIS == 0 ? 300 : 400,
                  CUT_AXIS == 1 ? 300 : 400,
                  CUT_AXIS == 2 ? 300 : 400]);
    }
}

// ============================================================
// 6. 出力
// ============================================================
// ---- 刷る物 ----
if      (part == "none")   ;
else if (part == "lower")  shell_lower();
else if (part == "upper")  translate([0, 0, Z_TOP]) rotate([180, 0, 0]) shell_upper();
else if (part == "button")
    translate([0, 0, Z_TOP + BTN_OUT]) rotate([180, 0, 0]) button_cap();
else if (part == "clip")   button_clip();
else if (part == "batcover")
    translate([-IN_X - WALL, 0, 0]) battery_cover();   // 刷るときは寝かせて置き直す
else if (part == "washer") oled_washer();
else if (part == "tail")   tail_cap();

// ---- 見る ----
// 中身だけ（筐体を外して部品と線の並びを見る）
else if (part == "inside")  { parts_v2(); ghost_bridge(); if (SHOW_WIRES) wires_v2(); }
else if (part == "inside_only") parts_v2();   // 線を外した中身だけ
// 筐体だけ
else if (part == "shells")  both_shells();
// ケーブルガイドだけ（下シェルから生えているので、これ以外の見方だと筐体に埋もれる）
// 断面。CUT_AXIS と CUT_AT を Customizer のスライダーで動かす
else if (part == "cut")     cut_view();
// 分解図
else if (part == "explode") {
    shell_lower();
    translate([0, 0, EXPLODE]) shell_upper();
    translate([BTN_AT[0], BTN_AT[1], EXPLODE * 1.4]) button_cap();
    translate([0, 0, EXPLODE * 0.47]) parts_v2();
}

// ---- 当たり検査 ----
// 🔒 読み方: **体積 0 は「接している」だけで正常。** 体積のある塊が出たら当たっている。
// 🔒 **1つだけ当てられる: `-D 'part="chk_one"' -D IDX=4`。** 番号は §5 の PARTS_V2。
//   置き場所は parts_v2() が唯一の出どころなので、**単体の合計は必ず全体と一致する。**
//   ✅ 2026-08-19 実測: 全体 6.6435 ＝ IDX=3（つまみ）の 6.6435。他10個はすべて 0
// 🔒 **「わざと残してある重なり」が2種類ある。これ以外が出たら本物:**
//   ・chk_lower に 約46.6mm3 × 4（ハブ基板の四隅・Z 0.5〜2.5）
//       … hub_board() が半田面を「一様な2mmの箱」で描いているだけ。実物は取付穴の
//         まわりに足が出ていない。v1 から同じ
//   ・chk_upper に 約3.32mm3 × 2（つまみ座標で x ±7.9 / y 0 / z -9.0〜-6.7）
//       … つまみ v5 の**島を留めるねじ2本**（`SCREW_ANG=[0,180]` / `SCREW_R=7.9`）。
//         胴 φ2.5 をナイロンのまま天板の下穴 φ2.1 へねじ込む噛み代で、
//         π×(1.25²−1.05²)×2.3 ＝ 3.32mm3。**意図した重なりなので消さない**
//         ⚠ 2026-08-19 に 1本（半径 8.8・286度）から 2本（半径 7.9・左右）へ変わった
//       ⚠ 2026-08-19、これを「AS5600 を受ける柱」と誤読した。`POST_XY_LO = 8.5` は
//         穴のピッチであって半径ではない（柱の半径は 8.5×√2 ＝ 12.02）。
//         🔒 **位置を推測で名指ししない。角度と半径を入れて座標を出してから言う。**
// 🔴 **部品どうし**の当たり。2026-08-17 追加。それまで筐体と部品しか見ておらず、
//    「寝かせたハブ基板と、背面に立つ PowerBoost が Y で重なる」のを誰も捕まえられなかった
// 🔴 **2026-08-21 まで、これはハブ基板 × 4部品だけの手書きだった。**
//    しかも PowerBoost は昔の置き方（寝かせていた頃）のままで、実際の板を見ていなかった。
//    そのせいで **つまみ × 電池の 154.2mm3 を一度も検査していなかった。**
//    ⇒ **総当たりにする。**部品を足したら自動で入る
// 🔒 8×9（トグル × 尻尾のキャップ）だけは除く。**キャップは胴に被せる部品**なので
//    重なって正しい（13.0mm3）。他は全部 0 でなければいけない
// 🔴 裸の if を書くと、**次の else if がこの if に食われる**（chk_lower の枝が消えて
//    部品が丸ごと出た）。⇒ 必ず { } で囲む
else if (part == "chk_parts") {
    for (i = [0 : len(PARTS_V2) - 1]) for (j = [i + 1 : len(PARTS_V2) - 1]) {
        if (!(i == 8 && j == 9)) intersection() { parts_v2(i); parts_v2(j); }
    }
}
else if (part == "chk_lower") intersection() { shell_lower(); parts_v2(); }
else if (part == "chk_upper") intersection() { shell_upper(); parts_v2(); }
else if (part == "chk_one")   intersection() {
    if (SHELL == "lower") shell_lower(); else shell_upper();
    parts_v2(IDX);
}
else if (part == "chk_shell") intersection() { shell_lower(); shell_upper(); }
// 🔒 充電のプラグが入る空間を、他の物が食っていないか
else if (part == "chk_usb")   intersection() {
        pb_usb_space();
        // ⚠ PowerBoost 自身（5）は入れない。レセプタクルが自分の空間を食う
        union() { shell_lower(); shell_upper(); parts_v2(0);
                  parts_v2(1); parts_v2(2); parts_v2(3); wires_v2(); } }
// 線 ↔ 部品／線 ↔ 筐体／箱からはみ出した線
// 🔒 **ガイド＋線＋部品だけ。**筐体は出さない（2026-08-20 ユーザー指示）
else if (part == "rail")      { color("#9aa5b1") back_rail(); parts_v2(); ghost_bridge(); wires_v2(); }
else if (part == "wires")     wires_view();
else if (part == "chk_wire")  intersection() { wires_v2(); parts_v2(); }
else if (part == "chk_wshell") intersection() { wires_v2(); union() { shell_lower(); shell_upper(); } }
else if (part == "chk_wout")  difference() { wires_v2();
    translate([0, 0, 0]) cube([IN_X, IN_Y, IN_Z]); }
else if (part == "chk_button")
    intersection() { translate([BTN_AT[0], BTN_AT[1], 0]) button_cap(); shell_upper(); }
else assembly_view();

echo(str("前の押さえリブ: X ", RIB1_X, "〜", RIB1_X + RIB1_W,
         "  余白 左 ", RIB1_X - RIB1_L, " / 右 ", RIB1_R - (RIB1_X + RIB1_W)));
echo(str("chk_one の番号: ", [for (i = [0:len(PARTS_V2)-1]) str(i, "=", PARTS_V2[i])]));
echo(str("外寸 ", OUT_X, " x ", OUT_Y, " x ", OUT_Z, " = ", OUT_X * OUT_Y * OUT_Z / 1000, " cm3"));
echo(str("ハブ 四隅の柱: ", HUB_HOLES));
echo(str("つまみの座 Y ", KNOB_Y0, "〜", KNOB_Y1, " / 座の下端 Z ", Z_TOP - knob_deep()));
// 🔒 座と PowerBoost の関係（2026-08-21）。**公称では食い込んでいるのが正常。**
//    保証しているのは実部品モデルの当たり検査（chk_one IDX=5 SHELL="upper" = 0）であって、
//    この行の数字ではない。数字は「替えたら測り直す」ための目印
echo(str("   座の右端 ", knob_seat_x1(), " ↔ PowerBoost の板の面 ", IN_X - PB_TH,
         " → 公称で ", knob_seat_x1() - (IN_X - PB_TH),
         "mm 食い込む（🔒 承知のうえ・つまみを動かさない判断）"));
echo(str("   へこみの外周 ", KNOB_AT[0] + KNOB_DISH_D / 2, " ↔ 同 ", IN_X - PB_TH,
         " → ", (KNOB_AT[0] + KNOB_DISH_D / 2) - (IN_X - PB_TH),
         "mm。**この分だけ、座を上まで切るとへこみが PowerBoost の部屋へ抜ける**"));
echo(str("   座の下端 Z ", KNOB_AT[2] - knob_pad_h(),
         "（外周の厚み ", knob_pad_h(),
         "）⚠ ここが下がると PowerBoost に当たる。逃げは入れていない"));
echo(str("天面: スピーカー中心 ", SPK_C, " / ボタン ", BTN_AT,
         " / つまみ ", [KNOB_AT[0], KNOB_AT[1]], " / マージン ", TOP_MARGIN));
echo(str("つまみの座 X ", KNOB_AT[0] - knob_bay_x()/2, "〜", KNOB_AT[0] + knob_bay_x()/2,
         " / Y ", KNOB_Y0, "〜", KNOB_Y1, "  ↔ INA の前端 ", INA_AT[1]));
    