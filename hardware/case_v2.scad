TUN_CL  = 0.4;    // 電池とトンネルの隙間
TUN_T   = 1.6;    // トンネルの壁厚
TUN_SPG = 1.9;    // 天井と電池の間。✅ スポンジで埋める（ユーザー決定）
// 🔒 BAT_C0 は X の小さい側＝**開いている側（左の壁）**。BAT_C1 が閉じている側
BAT_C0 = [0, LIPO_AT[1] - TUN_CL, LIPO_AT[2]];
BAT_C1 = [LIPO_AT[0] + LIPO_L + TUN_CL, LIPO_AT[1] + LIPO_W + TUN_CL,
