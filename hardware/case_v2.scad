// 筐体 v2 ── 実物のケース
//
//   openscad -o lower.stl -D 'part="lower"' hardware/case_v2.scad
//   GUI なら **36行目の `part = "..."` を書き換えて F5**（Customizer でも変えられる）。
//
// ---- part に入れられる値（🔒 増やしたらここに1行足す）----
//   刷る物   "lower" 下シェル / "upper" 上シェル / "button" ボタン頭 / "clip" ボタン受け
//            "washer" OLEDワッシャ / "tail" 尻尾のキャップ
//   見る     未指定＝組み立て全部（線込み） / "inside" 中身＋線（筐体を外す）
//            "inside_only" 線を外した中身だけ / "wires" 線だけ / "shells" 筐体だけ
//            🔒 SHOW_WIRES=false で線を消せる
//            "rail" **背面のガイド＋線＋部品だけ**（筐体を出さない）
//            "explode" 分解図 / "cut" 断面 / "none" 何も出さない
//   🔒 **線は行き先の 4mm 手前で止めて描く**（当たり検査のため）。繋がって見えないので、
//      見るときは **-D WIRE_TRIM=0**。⚠ 検査のときは 0 にしないこと
//   🔒 "wires" は **CUT_AXIS / CUT_AT / CUT_TH で薄く切れる**。真上や斜めからでは
//      束の並びが読めない。後ろの縦路の断面は X 方向から見た Y-Z 面（CUT_AXIS=0）
//   当たり   "chk_lower" 下シェル⇔部品 / "chk_upper" 上シェル⇔部品 / "chk_parts" 部品どうし
//            "chk_shell" 上下シェル / "chk_button" ボタン ガイド⇔部品
//            "chk_one" 部品1つだけ: -D 'part="chk_one"' -D IDX=4（番号は §5 の PARTS_V2）
//
//   🔒 **透けて見えるのは F5（プレビュー）だけ。** F6 は色も透過も捨てる。
//      筐体の中の物を見るときは `SHELL_A` を下げて F5 か、"cut" で切る
//
// ============================================================
// 🔒 v1 から何を引き継ぎ、何を変えるのか
// ============================================================
// **外側は v1 のまま。** 12辺 45度 2mm 面取り、正面いっぱいの OLED、天面のつまみと
// ボタンとスピーカー、背面の尻尾。ユーザー指定（2026-08-17「v1 のことは見た目程度で
// 忘れて良い」）＝ 見た目は残す、中身は捨てる。
//
// 🔴 **中身が変わった理由: v1 は配線できなかった。**
// 立てたハブ基板が箱を前後に分断する壁になり、10口すべてが線の逃げ 25mm を箱の外に
// 要求していた（17,844mm3・case_v1.scad の🔴）。
// ⇒ **v2 はハブ基板を床に寝かせる。** 逃げは箱の高さから取る。壁が消えるので
//    「板の向こう側」も消える。検証済み（case_v2_pack.scad）:
//      ・箱の外へ出た線 **0mm3** ／ 線と部品の当たり **0.1mm3**
//      ・口を立てても頭は Z 29.1、つまみの座の下端 Z 35.0 まで 5.9mm 空く
//
// ---- 変わったもの ----
//   ハブ基板  … 立てる → **床に寝かせる。** 溝・フィン・腕をやめ、四隅の穴へ柱4本
//   電池・PB  … 背面の壁のまま。⚠ **左右を入れ替えた**（PowerBoost が左）。
//                ハブの PWR の口が板の左後ろにあり、5V/GND の渡りが 60mm → 10mm 台になる
//   INA226    … 新規。天板の裏側の高さに寝かせるが、**留めるのは下シェルから立てた柱**
//                （上下の分割を太い電池線がまたがないように）
//   ケーブルガイド … 新規。線が決まった道を通る（開けて見せる機体なので見た目に効く）
//
// ---- ⬜ まだ実測していない（刷る前に潰す）----
//   ・🔴 **OLED のヘッダは L型ではなく「直」**（2026-08-20 ユーザー）。
//     旧記述「L型・板の面から 2mm・横への飛び出し 10mm」は**古い。引かないこと**。
//     ✅ **上辺の中央寄り**（2026-08-17「中央最上部にある」）。oled_port() を見ること
//   ・DuPont 線の外径と、束の最小曲げ半径（いまは φ1.4 / r5 の一般値）
//   ・INA226 の取付穴の径と位置（着荷 8/21〜29）→ 柱はそれから
//   ・充電口（PowerBoost の microUSB）の位置と向き。v1 は天面だった
//     🔴 2026-08-19: いまの置き方では**床を向いている**（§2.5 の USB_PB の🔴）

part = "inside";
$fn  = 48;
// chk_one 用。IDX は PARTS_V2 の何番目か（-1 = 全部）、SHELL は当てる側
IDX   = -1;
SHELL = "upper";

// ---- 中を見るための設定（形には影響しない）----
// 🔒 筐体の透け具合。0 = 完全に透明 / 1 = 不透明。
//    ⚠ **F5（プレビュー）でしか効かない。** F6（レンダー）は色も透過も捨てて単色になる。
//    Window → Customizer を開くと、この行がスライダーになる
SHELL_A = 0.2;   // [0:0.05:1]
// part="cut" のときの切る位置と向き。CUT_AXIS = 0:X / 1:Y / 2:Z
CUT_AXIS = 2;     // [0:2]
CUT_AT   = 30.0;  // [0:1:90]
// part="explode" の広がり
EXPLODE  = 55.0;  // [0:5:120]

use <parts.scad>
use <respeaker_lite.scad>
HUB_EMBEDDED = true;
use <hub_board.scad>
use <knob_v5.scad>   // 2026-08-19 v5: 半月廃止・Eリングとねじ止めへ（knob_deep は 19.7 のまま）
use <wires.scad>
include <hub_board_parts.scad>

// ============================================================
// 1. 箱（v1 と同じ）
// ============================================================
IN_X = 86.0;
// 🔴 **2026-08-20、75.9 → 66.0。目的はここ**（ユーザー・2026-08-19「今回の一連の要望は
//    奥行きをもう少し狭められないかという話」）。背面の帯 12mm に居た**電池・PowerBoost・
//    INA226 を全部そこから追い出した**ので、帯そのものが要らなくなった。
//    ・電池   → ハブ基板とつまみの間（Z 17〜23）。右の壁から引き出す
//    ・PowerBoost → 左の内壁に立てる
//    ・INA226 → 電池と同じ層の左（X 8〜35）
// 🔒 **奥行きを決めているのは、いまや寝かせたハブ基板の 52mm だけ。**
//    数字を直書きしない。ハブ基板の背面 ＋ 逃げ で出す
// ⚠ 内寸 64（背面に 0.1mm）でも当たり検査は通るが、それは寸法が通るだけで組めない
HUB_Y0   = 11.9;   // ハブ基板の手前（ReSpeaker の背面 10.035 の後ろ）
// 🔴 **2026-08-20、2.1 → 12.1（箱を 10mm 深く）**（ユーザー指示）。
//    理由: 背面のガイドをハブ基板の**背面より奥**に立てるため。2.1 のままだと
//    ガイドの床がピンヘッダのハウジング（頭 Z 14.1）の上に隙間ゼロで載り、
//    コネクタが挿し抜きできなかった（ユーザー指摘「どうみてもピンヘッダの上に載ってる」）
// 🔴 **2026-08-20、12.1 は取り過ぎだった。**レールを足すとき 10mm 広げたが、
//    実際に奥まで使うのは PHOUT が上がる Y 70.4（束の奥端 71.66）まで。
//    1mm 刻みで詰めたところ **8.1（IN_Y 72）が下限**で、7.1 にすると線が背板から
//    15.0mm3 はみ出す。⇒ 4mm 返した。レールの正味の代償は 10mm ではなく 6mm
BACK_CL  = 8.1;    // ハブ基板の背面 ↔ 背板の内面
IN_Y = HUB_Y0 + HUB_W + BACK_CL;   // = 66.0
TOP_T = 2.5;
WALL  = 2.0;
BEZ_T = 2.0;
CHAM  = 2.0;

// 🔒 **板の下端はこの1面に揃える**（2026-08-19 ユーザー）。ハブ基板はスペーサーで
//    2.5 上がるので、他の板も保持パーツで同じ高さへ上げる
BOARD_Z = 2.5;
RSP_X = 2.0;  RSP_Z = BOARD_Z;
RSP_TOP = RSP_Z + respeaker_H();
KNOB_CL = 1.5;
// 🔴 **2026-08-21、ここは板の頭（RSP_TOP 36.507）を見ていた。間違い。**
//    板は Y 8.185〜10.035 に立っていて、つまみの座は Y 14.8 から始まる。
//    **板は座の下に入っていない。**座の真下にある ReSpeaker の物を実体で抜くと
//    227.7mm3 だけで、正体は XIAO のピンヘッダー上段（頭 Z 29.507）だった。
//    ⇒ 7mm 保守的だった。直すと第1項が 48.2 に落ち、OLED の項 52.1 が勝つ
// 🔴 **2026-08-21、3.1mm 下げてから戻した。**XIAO のピンヘッダー（29.507）で計算すると
//    IN_Z は 52.1 まで落ちるが、そうすると**つまみの裾（Z_TOP - 21.0）が電池の頭 36.1 を
//    154.2mm3 食う。**本当に効いているのは ReSpeaker でも OLED でもなく、**電池とつまみ**。
//    元の式（板の頭 36.507）は、たまたまその条件を満たしていただけだった。
//    ⇒ 下げられない。RSP_TOP に戻す。⚠ 下げるなら電池かつまみを動かす話になる
KNOB_BASE = RSP_TOP;
// 🔴 **2026-08-21、max() をやめて OLED が決める高さにした**（ユーザー指示
//    「最大まで下げた OLED の最も高さがある部分が天面の裏になるべき」）。
//    ⇒ IN_Z = OLED の頭 = BOARD_Z + 板の縦 = **50.6**。外寸 59.707 → 55.1
//      （408.4 → 376.9 cm3。−7.7%）
//
//    ⚠ **捨てたのは第1項（つまみ）で、これは物差しが間違っていた。**
//    KNOB_BASE = RSP_TOP は「つまみの下に ReSpeaker の頭がある」という前提だったが、
//    ReSpeaker は Y 5.6〜20.0、つまみの座は Y 14.8〜51.8 で、丸いつまみとは実際には
//    当たらない（chk_parts で確認）。つまみの**実体**の下端は座の底より 1.3 低い
//    Z_TOP − 21.0（軸と AS5600 が座を突き抜けるぶん）で、その真下にあるのは**電池**。
//    ✅ **つまみを右へ 6mm ずらして電池を外した**（KNOB_DX。ユーザー承認 2026-08-21
//       「右よりで良い。むしろバランスが良い」）ので、この 50.6 で **chk_parts = 0**。
//    🔒 **つまみを左へ戻すなら高さも戻る。**KNOB_DX と IN_Z は一組で動く
//    ⚠ 第2項だった 52.1（=48.1+4.0）は「上下 2mm ずつ余白」の下限で、OLED を床側へ
//      揃えたいま意味が無い。板の頭が天井そのものになった
//    🔴 **50.6 には落とせなかった（実測）。**天面から下へ伸びる物が2つ引っかかる:
//    ・会話ボタンの胴は天面から 15.1 下がる。電池トンネルの屋根の頭は 39.6 なので、
//      天面 ≥ 54.7 ＝ **IN_Z ≥ 52.2**（50.6 だとボタンが屋根へ 3.1mm3・線が 23.8mm3）
//    ・AS5600 の4本束は φ3.565。ブリッジの頭 30.1 と つまみの裾（Z_TOP−21.0）の間を
//      通るので、**IN_Z ≥ 52.2**（50.6 では隙間 2.0mm しかなく 17.9mm3 埋まる）
//    ⇒ 実測で全部ゼロになる **53.2** を採る。外寸 59.707 → 57.7（408.4 → 394.7 cm3）
//    ⬜ 50.6 まで行くには**会話ボタンをトンネルの上から動かす**話になる（未着手）
//    ✅ **2026-08-21、53.2 → 50.6 → 48.8。**50.6 を決めていたのは3つ同時で、
//       ①OLED の下の 2.5（BOARD_Z）②会話ボタンの丈 15.1 ③AS5600 の束 φ3.565。
//       3つとも外した: ①板を天井づけにして棚を 0.7 に ②キャップとパッドで −2.0
//       ③つまみの下だけ4本を平らに開いて φ1.78。
//    🔒 **いまの底は③。**つまみの底（Z_TOP−21.0）とブリッジの頭 28.5 の間に
//       1本ぶん（1.78）が要る ⇒ IN_Z ≥ 47.0 + 1.78 = **48.78**
//    🔴 **48.8 では届かなかった（実測）。**つまみの底とブリッジの頭の隙間には
//       AS5600 の4本だけでなく**電池線 BAT も通る**。48.8 だと隙間 1.8mm で、
//       1本ぶん 1.78 を入れても余白 0.01。⇒ 上下 0.3 ずつ見て **49.4**（隙間 2.4）
//    ✅ **2026-08-21、48.1 に到達。**49.4 で止まっていたのは AS5600 の束を
//       つまみの裾の下（ブリッジの頭との隙間）に通していたから。
//       **板の四隅は円から 2.8mm はみ出す**ので、外から隅へ着ければくぐる必要が無い
//       （ユーザー指摘）。⇒ 隙間の制約が消えて、**OLED の丈がそのまま内寸**になった
IN_Z = oled_w();   // 48.1 🔒 OLED を床に置いて、頭が天井

OUT_X = IN_X + WALL * 2;
OUT_Y = IN_Y + WALL + BEZ_T;
OUT_Z = IN_Z + TOP_T + WALL;
Z_TOP = IN_Z + TOP_T;

M2_PILOT = 1.7;
M2_POST  = 6.0;

// ============================================================
// 2. 中身の位置（case_v2_pack.scad と同じ。🔒 数字を二重に持たない）
// ============================================================
OLED_Y1   = 8.5;
// ✅ **2026-08-19 ユーザー指示で前へ詰めた（5.09mm）。**
//    マイク面でいちばん出ているのは **スイッチ K1/K2（2.585・右下）**で、
//    ✅「これにくっ付いても問題ない」「フィルムも当たって問題なし」（ユーザー）。
//    ⇒ **スイッチの先端を OLED の裏（正面から 4.6）に接触させる。**
RSP_SW_OUT = 2.585;                      // 📄 K1/K2 の出っ張り（公式CAD）
RSP_GAP    = 1.0;                        // ✅ 2026-08-19 ユーザー指示「そこから1mm開けて」
RSP_BD_Y0 = oled_back() + RSP_SW_OUT + RSP_GAP;   // 8.185 基板の前面
RSP_Y     = RSP_BD_Y0 - 1.275;           // 5.91 マイク(U4/U5)の先端
RSP_BD_Y1 = RSP_BD_Y0 + respeaker_T();
function rsp_hole(h) = [RSP_X + respeaker_L() - h[0], RSP_Z + h[1]];
RSP_H_LO = rsp_hole([60.202,  2.657]);
RSP_H_HI = rsp_hole([ 2.492, 31.577]);

// 🔒 数字を書き写さない（2026-08-19 板幅が 70.1→75.7 に変わった）
OLED_L = oled_l(); OLED_W = oled_w();
OLED_X0 = RSP_X + (respeaker_L() - OLED_L) / 2;
// 🔴 **2026-08-21、上下中央 → 板の共通面（BOARD_Z）へ下げた**（ユーザー指示「一旦下げて」）。
//    元は `(IN_Z - OLED_W) / 2` で、根拠は case_v1 の「上下ベゼルを揃えるため上下中央」
//    （2026-08-16）。⇒ ベゼルは上下非対称になる（下 2.5 / 上 4.607）。
//    ⚠ **これは仮**。機体を小さくする案と並べて選ぶための状態（比較が済むまで戻さない）
// 🔴 **2026-08-21、板は天井づけにする。**頭を天井に合わせ、下は棚で受ける
//    （✅ フィルムは切り欠きの中で下面に触れない＝棚に直接載せてよい・ユーザー）
OLED_Z0 = IN_Z - OLED_W;   // 0.7

// ⭐ 天面のレイアウトは §2.5 で一括して決める（ここでは定義しない）

// ---- ハブ基板: 床に寝かせる ----
HUB_STANDOFF = BOARD_Z;             // 半田面の足の逃げ（＝板の面）
// 🔴 **2026-08-20、右端そろえ → 左端そろえ**（ユーザー指示「中継基板を出来る限り左へ」）。
//    目的は**電池の口を右から左へ move すること**。板を左へ寄せると右に 10.024 空き、
//    そこへ PowerBoost が立つ。空いた左の棚が電池の通り道になる
// 🔒 数字を書き写さない。**左端を ReSpeaker の左端に揃える**
// 🔒 2026-08-20 **中央に戻した。**左へ寄せていたのは、右に 10mm 空けて PowerBoost を
//    床から立てるためだった。板がブリッジの構造へ上がって Z 16.8 から始まるので、
//    ハブ基板の高さ（〜15.1）とはもう重ならない。⇒ 寄せる理由が消えた
HUB_X = (IN_X - HUB_L) / 2;
HUB_AT = [HUB_X, HUB_Y0, HUB_STANDOFF];   // 🔒 Y は IN_Y と同じ出どころ
// 四隅の取付穴（📄 hub_board_parts.scad の HUB_MOUNT = 68 × 46）
HUB_HOLES = [for (sx = [-1, 1], sy = [-1, 1])
                [HUB_AT[0] + HUB_L / 2 + sx * HUB_MOUNT[0] / 2,
                 HUB_AT[1] + HUB_W / 2 + sy * HUB_MOUNT[1] / 2]];

// ---- 背面の壁 ----
// 🔒 数字を書き写さない。parts.scad から読む
//    🔴 2026-08-19 まで 54 × 34 を写して持っていた（正は 50 × 35）
LIPO_L = lipo_size()[0]; LIPO_W = lipo_size()[1]; LIPO_TH = lipo_size()[2];
// 🔒 **数字を書き写さない。** 平面も高さも parts.scad（.brd 由来）から読む
//    🔴 2026-08-19 まで `PB_TH = 10.0` と手で書いていた。10 は **USB-Aジャック込みの
//       カタログ値**で、ジャック無しのこの個体には当たらない。背面に 10mm の板が
//       立っている前提で箱詰めしていた（ユーザー指摘「どう見ても分厚すぎる」）
PB_L = pb_size()[0]; PB_W = pb_size()[1]; PB_TH = pb_size()[2];   // ⚠ 高さは実測待ち
PB_POST = 4.5;
// ============================================================
// 🔒 電源系は**箱の左**にまとめる（2026-08-19 ユーザー指示）
// ============================================================
// 電池 → INA226 → PowerBoost → ハブの PWR、という順に電気が流れる系を左へ寄せる。
//
// 🔴 **PowerBoost は背板から左の壁へ引っ越した。** ハブ基板を右端へ揃えたことで
//    左に 8.024mm の縦のスロットが空き、PowerBoost は板厚 6.8mm で立てて入る
//    （hardware/scratch/_pb_left_gap.scad で検算）。
//    ✅ 6.8 で足りるのは電池コネクタが**サイドエントリ**だから（parts.scad の JST の節）。
//       トップエントリなら 12.8 になって入らなかった。
//
// ---- 向き ----
//   板の長辺(36.068) → 箱の Z（立てる）／ 板の短辺(22.86) → 箱の Y
//   部品面は +X（ハブ側）を向く。**PCB の背は左の壁に密着**する
//   ⇒ micro-USB（板の -X 端）は **+Z＝天井**を向く。⬜ 充電口をどう抜くかは未決だが、
//      少なくとも「床を向いている」状態は解消した（旧 §2.5 の 🔴）
//   ⇒ 電池の JST（板の +Y 端）は **箱の +Y＝背面**を向き、電池へまっすぐ届く
//   ⇒ 出力の2本（板の +X 端）は **-Z＝床**side、寝かせたハブ基板と同じ高さへ落ちる
// ✅ 2026-08-19「すこし後ろにずらして」（ユーザー）。3.0 → 1.5 で 1.5mm 下がる。
// 🔴 **これ以上は下がらない。** 後ろの止まりは電池で、電池の左端が X2 にあるあいだは
//    JST のハウジング（板の +Y 端から 4.694 出る）が電池の前面 Y70.9 に当たる。
PB_CL = 1.5;                        // JST のハウジングと電池の間に残す隙間
// 🔴 2026-08-20 Y の決め方を直した。旧式は「電池の前で止める」で、電池が背面の帯から
//    出ていった今は**理由が消えている**。⇒ **背板を基準に、いちばん後ろへ寄せる。**
// ============================================================
// 🔒 **棚の高さ（ブリッジの上面）。ここに載る物は全部これを見る**
// ============================================================
//    ハブの口を立てたときの頭が Z 29.1。その上へ 1.0 逃がす
// 🔴 **2026-08-21、30.1 → 28.5**（−1.6）。ここを下げると 電池・トンネルの屋根・
//    つまみの裾 が一緒に下がり、**IN_Z がそのまま 1:1 で下がる**（会話ボタンの深さと
//    AS5600 の束が、どちらもこの面から数えているため）。⇒ IN_Z 52.2 → 50.6。
//    ⚠ **4mm は下がらない**（ユーザー案）。実測で −4.0 は 線×シェル 613.9mm3。
//      下の階は線で埋まっていて、空いていたのは INA の段のぶんだけだった
DECK_Z = 28.5;
