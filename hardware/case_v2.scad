INA_AT = [48, 20 + (39 - ina_size()[1]) / 2, DECK_Z - BR_DEPTH - ina_h()];
// 🔴 **2026-08-20 ブリッジの上へ載せた**（ユーザー「ブリッジに乗るでしょ・・・そのサイズなら」）。
//    ネジ端子をやめて 11.6 → 7.6mm になったので載る。
//    ⭐ **Z 30.1 は口の柱の頭 29.1 より上**。AS5600 の口を塞ぐ問題も同時に消えた。
//    ⭐ 板の下を這わせる必要が無くなり、リレーとの当たり 2.2mm3 も消える。
//    🔒 電池（X 36〜86）の左に並べる。X 8〜35 で 1.0mm 空く
INA_POST_D = 5.0;

// ============================================================
// 2.6 ブリッジ（左右の壁に渡す1本。上に電池を載せる）
// ============================================================
// ✅ ユーザー案（2026-08-20）「左右に渡るブリッジを作って、その上に乗せましょう。
//    2本は要りません1本かつ、横からみた断面がギザギザになるように」。
//    ⇒ **ワーレントラス**（上下の弦を斜材でジグザグに繋ぐ形）。薄い材で曲げに耐える定石。
// 🔒 **上シェルの持ち物。** 左右の側面は上シェル側なので、下シェルへ付けると宙に浮く。
// 🔒 Y の帯は PowerBoost（Y 40.8〜63.7）と INA226 を避けて決める
// 🔴 当初 Y 18〜38 にしたら **PowerBoost（Y 36.95〜59.81）へ 1.05mm 食い込んだ**。
//    奥行きを 66 へ詰めたとき PowerBoost が前へ出たのを見落としていた。⇒ 前へずらす
//    🔴 さらに Y15 だと **ReSpeaker の XIAO ソケット上段**（X 64〜82 / Y 10.0〜20.0 /
//       Z 27.5〜29.5）へ 132.7mm3 食い込む。⇒ 手前を 21 まで下げる
// 🔴 **2026-08-20、帯を電池の幅まで広げた。** 14mm では電池（35mm）がはみ出して、
