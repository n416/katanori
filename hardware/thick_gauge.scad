// 板厚のゲージ ── 2.5 / 2.8 / 3.1 / 3.4 / 3.7 / 4.0mm の溝 6 本だけ
// ============================================================
// 2026-08-30 ユーザー「4mm〜2.5mm を計れるやつ」。天板が 2.5mm ではなく 4.0mm で出る件
// （docs/PRINT.md 冒頭の「未解決の機械の不具合」）を、ノギス無しで読むためのゲージ。
//
// 🔒 **レジン 0.96ml / 68 層。** 🔴 単体で刷る物ではない。**flat_area_test.scad が
//   3 枚目としてこのゲージを同じプレートに載せる**（大小の板を焼いた、その場で厚みを読むため）。
//   単体で焼きたいときのために、この ファイル 単独でも STL が出るようにしてある。
//
// ------------------------------------------------------------
// 使い方
// ------------------------------------------------------------
//   板の**縁を溝に差し込む**。すっと入る一番細い溝が、その板の厚み。
//   数字は溝の手前に浮き出している（25 = 2.5mm、40 = 4.0mm）。
//   ⚠ 天板の外周は角が落としてある。**角の落ちていない所**（割った断面、ネジ穴の脇、
//     内側の平らな縁）で当てること。角で測ると薄く出る。
//
// ------------------------------------------------------------
// 精度について（正直に）
// ------------------------------------------------------------
//   刻みは 0.3mm。**2.5 か 4.0 かを見分けるための道具**であって、0.05 を保証する物ではない。
//   🔒 溝は呼び + 0.20 で彫ってある（docs/PRINT.md §2「可動部でない穴の見込み +0.2〜0.4mm」）。
//   ⚠ このゲージ自体も同じ機械で焼く。ただし接地は 480mm2 と小さく、btntest（1128mm2）が
//     正しく出ている側なので、面積の不具合は乗らないはず。**それでも、出たら 1 本だけ
//     ノギスで溝幅を実測して、ズレを覚えておくこと。**
//
// ------------------------------------------------------------
// 刷り方
// ------------------------------------------------------------
//   伏せて**プレートに直置き**（数字が上）。サポートも傾けもラフトも要らない。焼く:
//   openscad --backend=manifold -o stl/test/thick_gauge.stl hardware/thick_gauge.scad
// ============================================================
$fn = 48;

SLOTS   = [2.5, 2.8, 3.1, 3.4, 3.7, 4.0];   // 呼び（＝板厚）
ALLOW   = 0.20;                              // 🔒 見込み（PRINT.md §2）。彫る幅 = 呼び + これ
WALL    = 2.5;                               // 溝と溝のあいだの肉
SLOT_Y  = 8.0;                               // 溝の深さ（板を差し込む量）
BACK_Y  = 4.0;                               // 溝の奥に残す背
T       = 3.0;                               // ゲージの厚み（＝背の高さ。層数を増やさない）
TXT_H   = 0.4;                               // 数字の浮き出し
END     = 1.0;                               // 両端の余り

// 溝の左端の X を順に積む
function slot_x(i) = END + WALL + (i == 0 ? 0 :
    slot_x(i - 1) - END - WALL + SLOTS[i - 1] + ALLOW + WALL);
BODY_X  = slot_x(len(SLOTS) - 1) + SLOTS[len(SLOTS) - 1] + ALLOW + WALL + END;
BODY_Y  = SLOT_Y + BACK_Y;

// ⚠ module にしてある。flat_area_test.scad が use<> で呼んで、同じプレートに載せる。
//   （use<> は top-level の geometry を実行しないので、下の呼び出しと二重にはならない）
module thick_gauge() {
    difference() {
        cube([BODY_X, BODY_Y, T]);
        // 溝は手前（Y=0）の縁から奥へ彫る
        for (i = [0 : len(SLOTS) - 1])
            translate([slot_x(i), -0.1, -0.1])
                cube([SLOTS[i] + ALLOW, SLOT_Y + 0.1, T + 0.2]);
    }
    // 数字（呼びの 10 倍・2 桁）を溝の奥の背に浮き出す
    for (i = [0 : len(SLOTS) - 1])
        translate([slot_x(i) + (SLOTS[i] + ALLOW) / 2, SLOT_Y + BACK_Y / 2, T])
            linear_extrude(TXT_H)
                text(str(round(SLOTS[i] * 10)), size = 2.6, halign = "center",
                     valign = "center", font = "Liberation Sans:style=Bold");
}
thick_gauge();

echo(str("外形 ", BODY_X, " x ", BODY_Y, " x ", T + TXT_H, "mm"));
echo(str("接地 ", round(BODY_X * BODY_Y), "mm2 （btntest 1128 より小さい）"));
echo(str("層数 ", round((T + TXT_H) / 0.05), " 層"));   // レジンは実体積 1.0ml（STL から実測）
echo(str("彫る溝の幅: ", [for (s = SLOTS) s + ALLOW]));
