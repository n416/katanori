BTN_NECK_D = 3.2;              // クリップが掴む首
BTN_CLIP_T = 1.2;              // クリップの厚み（平らに刷る）
BTN_CLIP_D = 7.0;              // クリップの外径。🔒 穴(5.6)より太く、柱の間(7.2)より細く
