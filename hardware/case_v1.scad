echo(str("外寸 ", OUT_X, " x ", OUT_Y, " x ", OUT_Z,
         " = ", OUT_X * OUT_Y * OUT_Z / 1000, " cm3 / 角の面取り ", CHAM, "mm"));
echo(str("ねじ止め: ReSpeaker (", RSP_H_LO[0], ",", RSP_H_LO[1], ") と (",
         RSP_H_HI[0], ",", RSP_H_HI[1], ") ／ ハブ基板 4か所 ／ PowerBoost 4か所"));
echo(str("高さの内訳: ハブ基板 ", HUB_Z0 + hub_size()[1] + 1.0,
         " / つまみ ", RSP_TOP + KNOB_CL + knob_deep() - TOP_T,
         " / OLED ", OLED_W + 4.0, " → 内寸 ", IN_Z));
echo(str("つまみ 下端 Z ", Z_TOP - KNOB_DEEP, " ↔ ReSpeaker の頭 ", RSP_TOP,
         " → ", Z_TOP - KNOB_DEEP - RSP_TOP, "mm"));
echo(str("ボタン: 俵型 ", BTN_L, " x ", BTN_W, " / 天面から ", BTN_OUT, "mm（つまみは ",
         knob_grip_h(), "mm）/ 中心 X ", BTN_AT[0], " / つまみの座の左端 ",
