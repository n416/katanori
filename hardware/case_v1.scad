// ⚠ 代償: 胴が 19.8mm 入るので、奥行きを 77 → 80mm にした（+3mm・+16cm3）。
//    背面でこの深さが取れるのはハブ基板より後ろだけで、電池(Z≤36)と PowerBoost(Z≤40)の
//    上、かつ合わせのボス(X 0〜7・79〜86)の内側 ＝ X 8〜78 / Z 42〜54 に限られる
TGL_AT = [40, 47];      // [X, Z] 背面。胴 φ13 が前へ 19.8mm 入る
// ---- 尻尾（印刷部品）----
TAIL_L    = 34.0;       // 全長
TAIL_D0   = 13.0;       // 付け根。⚠ 鍵穴のスリット（軸から 5.6mm まで）を覆う太さが要る
TAIL_D1   = 3.5;        // 先
TAIL_BORE = 3.2;        // レバー φ3 に挿す穴
TAIL_GAP  = 3.0;        // 壁から浮かせる量。⚠ 振ったとき付け根が壁を叩かないように
TAIL_ANG  = 25.0;       // レバーの倒れ。⭐ 上＝入 / 下＝切。**外から状態が見える**
// ---- 尻尾を Wi-Fi アンテナにする（2026-08-16・ユーザー案）----
// ⭐ **電源が切れているとき Wi-Fi は使わない。使うときは尻尾が立っている。**
//    「可動部にアンテナを置くな」という定石が、この製品では効かない（ユーザー指摘）。
// 🔒 やるのは「レジンの尻尾に線を1本通す」だけ。u.FL から給電する 1/4波長のホイップで、
//    2.4GHz の 1/4波長は **31.2mm**、尻尾は 34mm。ちょうど収まる。
// ⚠ 同軸の芯線を延ばす形なので、**網線(GND)は XIAO の基板に落とすこと**。
//    レバーの金属（φ3 × 9mm）が根元の脇に立つので、同調は必ずずれる。
//    🔒 **長さで追い込む。** ファームが RSSI を出す（アンテナ無し -86 / 有り -46dBm の実績）
//       ので、切りながら測って決める。⚠ 買ったアンテナは捨てない。戻せるようにしておく
// 🔒 同軸（u.FL・φ1.13）は**網線が付いたまま給電点まで引く**。網線があるところは
//    金属の横を通っても実質効かない。効くのは網線が終わってから先の 31.2mm だけ。
//    ⇒ 網線の端＝給電点を尻尾の根元に置き、そこから先を樹脂の中で伸ばす
ANT_CH_D  = 1.6;        // 線の通り道（同軸 φ1.13 ＋ 逃げ）
// ⭐ 2026-08-16「穴を丸にせず、スイッチの横に小さくつければ」（ユーザー）。
//    パネルの口を**鍵穴（ブッシングの丸 ＋ 上へ伸びるスリット）**にした。
//    🔒 胴は 13 × 8 なので、内側から壁に届くのは |Z-47| > 4 の帯。**真上なら軸から 4.5mm**で
//       済む（横だと胴の幅 13 に阻まれて 9mm 必要だった）。
//    ⭐ 上に出したのは、**使用中＝尻尾が上を向いている**ときに付け根が口を隠すから。
ANT_OFF    = 4.5;       // 軸からの距離（＝スリットの位置）
ANT_SLOT_W = 2.2;       // スリットの幅
// ---- 線を隠すチューブ（2026-08-16・ユーザー案「付け根からチューブで隠すか」）----
// 🔒 線の穴はトグルに寄せられない。**胴が 13 × 8mm あって X 33.5〜46.5 を占めている**ので、
//    内側から線を持ってこられるのは X 48 より外。付け根から 8mm 離れた穴になり、
//    そこを渡る線は必ず見える。⇒ **チューブで渡す前提で、両端に挿し口を作る。**
// ---- 付け根を太らせる案（2026-08-16・見た目の比較用）----
// TAIL_BELL = true で、付け根を球状に膨らませて**線の穴ごと覆う**。チューブは不要になる。
// ⚠ 首振りのために、背板側に**球の受け座**が要る（平らな壁のままだと、25度 倒したとき
//    リムが壁に 4.3mm 食い込む）。⬜ 受け座の作り込みは、見た目を採用してから
TAIL_BELL   = false;
TAIL_ROOT_D = 25.0;     // 付け根の球
TAIL_RIM    = 1.0;      // 壁とのすき間
TAIL_SEAT_D = 26.0;     // 背板側の受け座（外形）
ANT_TUBE_D  = 3.0;      // ⬜ 使うチューブの外径（シリコン/熱収縮）。現物で決める
ANT_NOZ_L   = 2.5;      // 背板側の口（差し込みしろ）
ANT_SOCK_L  = 3.5;      // 尻尾側の受け（深さ）

// -------- 充電口: PowerBoost の microUSB は上を向く --------
// 🔒 Y は基板から数える（IN_Y 直書きだと柱の長さを変えたとき口が置き去りになる）
USB_PB = [PB_AT[0] + PB_W - 8, PB_AT[1] + PB_TH - 2];

// ============================================================
// 3. 共通の小物
// ============================================================
NUT_AF  = 5.0 + 0.3;
NUT_T   = 3.0 + 0.2;
SCR_D   = 2.5 + 0.4;
SCR_CB  = 5.2;
SCR_CBT = 0.8;
BOSS    = 7.0;

// 45度で12辺を落とした箱。🔒 外形はこれで切る（上下2部品で同じ形を使う）
module cham_box(p0, sz, k) {
    hull() {
        translate([p0[0] + k, p0[1], p0[2]]) cube([sz[0] - 2 * k, sz[1], sz[2]]);
        translate([p0[0], p0[1] + k, p0[2]]) cube([sz[0], sz[1] - 2 * k, sz[2]]);
        translate([p0[0], p0[1], p0[2] + k]) cube([sz[0], sz[1], sz[2] - 2 * k]);
    }
}
module outer_envelope() {
    cham_box([-WALL, -BEZ_T, -WALL], [OUT_X, OUT_Y, OUT_Z], CHAM);
}

function boss_nut_x(pos, dir) =
    (dir < 0) ? pos[0] + 0.6 : pos[0] + BOSS - 0.6 - NUT_T;
module screw_boss(pos, dir) {
    difference() {
        union() {
            translate(pos) cube([BOSS, BOSS, 9]);
            // 床から立っていないボスには 45度 の支えを付ける。
            // ⚠ 高さは 3.5mm まで。7mm 落とすと PowerBoost の頭（Z 40.07）に当たる
            if (pos[2] > 0)
                translate([pos[0], pos[1] + BOSS, pos[2]]) rotate([90, 0, 0])
                    linear_extrude(BOSS)
                        polygon([[BOSS - 3.5, 0], [BOSS, 0], [BOSS, -3.5]]);
        }
        translate([pos[0] - 1, pos[1] + BOSS / 2, pos[2] + 4.5])
            rotate([0, 90, 0]) cylinder(d = SCR_D, h = BOSS + 2);
        translate([boss_nut_x(pos, dir), pos[1] + BOSS / 2, pos[2] + 4.5])
            rotate([0, 90, 0]) rotate([0, 0, 90])
                cylinder(d = NUT_AF / cos(30), h = NUT_T, $fn = 6);
        translate([boss_nut_x(pos, dir), pos[1] - 1, pos[2] + 4.5 - NUT_AF / 2])
            cube([NUT_T, BOSS / 2 + 1, NUT_AF]);
    }
}
module screw_hole(pos, dir) {
    x = (dir < 0) ? pos[0] : pos[0] + BOSS;
    translate([x, pos[1] + BOSS / 2, pos[2] + 4.5]) rotate([0, 90 * dir, 0]) {
        cylinder(d = SCR_D, h = WALL + 1);
        translate([0, 0, WALL - SCR_CBT]) cylinder(d = SCR_CB, h = SCR_CBT + 1);
    }
}
BOSSES = [[[0,           0,           0], -1],
          [[IN_X - BOSS, 0,           0], +1],
          [[0,           IN_Y - BOSS, 44], -1],
          [[IN_X - BOSS, IN_Y - BOSS, 44], +1]];

// 基板をねじで受ける柱。板の面 (y_face) から len だけ後ろへ伸ばし、下穴を通す
//   dir = +1: 板の +Y 側に柱（ねじは -Y から入る）
module board_post(x, z, y_face, len, dir = 1, d = M2_POST) {
    translate([x, y_face, z]) rotate([dir > 0 ? -90 : 90, 0, 0]) difference() {
        cylinder(d = d, h = len);
        translate([0, 0, -0.01]) cylinder(d = M2_PILOT, h = len + 0.02);
    }
}

// 音を出す穴（六方格子）。天面に開ける（法線は +Z）
module grille_xy(cx, cy, w, d, z0, t, dia = 2.6, pitch = 4.2) {
    nx = floor(w / pitch);
    ny = floor(d / (pitch * 0.866));
    for (j = [0 : ny], i = [0 : nx]) {
        px = cx - nx * pitch / 2 + i * pitch + (j % 2 ? pitch / 2 : 0);
        py = cy - ny * pitch * 0.866 / 2 + j * pitch * 0.866;
        if (abs(px - cx) <= w / 2 && abs(py - cy) <= d / 2)
            translate([px, py, z0 - 0.01]) cylinder(d = dia, h = t + 0.02);
    }
}

// ---- 面取りの断面（45度の直線 ↔ 丸み の中間）----
// ✅ 2026-08-17 ユーザー:「すこしだけ丸みが欲しい」
// 🔒 これは「Rではなく斜めにカット」（同じ日の指定）を覆すものではない。**斜めのまま、
//    両端の角だけを落とす。** k=0 なら以前とまったく同じ 45度の直線に戻る。
// 二次ベジエ 1本で書いてある。制御点を斜辺の真ん中（k=0）から内側の角（k=1）へ寄せると、
// 真ん中は 45度のまま、正面の面に出るところと穴の壁に入るところが丸くなる。
//   c … 面取りの大きさ（奥行きも外への広がりも c）
//   k … 丸みの強さ 0〜1
// 返すのは [奥行き u, 外への広がり v] の列。u が進むほど v が減る**凹**の並びなので、
// 呼ぶ側が hull() で繋ぐとこの曲線がそのまま面になる（直線に化けない）
function bev_pts(c, k, n = 10) =
    [for (i = [0 : n]) let (t = i / n, p = (1 - k) * c / 2)
        [2 * t * (1 - t) * p + t * t * c,
         (1 - t) * (1 - t) * c + 2 * t * (1 - t) * p]];

// ---- マイクのヒゲ 1本を切る形（正面のベゼルに開ける）----
// ✅ 2026-08-17 ユーザー:「ヒゲが太すぎる。そして直穴すぎる。もう少し角を取りたい」
//   ① 穴そのものを 1.6 → 1.0 に細くした。間に残る肉は 2.0 → 2.6 に増える
//   ② 正面の口を 45度で開いた。まっすぐ抜いた穴は縁が直角に立っていて、
//      光が当たっても影しか出ない。斜めの口があると縁が光を拾って、
//      穴ではなく**彫った線**に見える
// 原点はベゼル厚みの中心。長さ +X・幅 +Z・正面（外）は -Y。
// 🔒 呼び出し側は Y 軸まわりに傾けるだけなので、面取りの面は正面と平行のまま保たれる
WSK_L  = 6.0;   // ヒゲの長さ
WSK_W  = 1.0;   // ヒゲの幅（＝正面から見える黒い線の太さ）
WSK_CH = 0.5;   // 口の面取り。BEZ_T 2.0 のうち 1.5 は素通しで残る
WSK_R  = 0.4;   // 口の丸み（bev_pts の k）。窓のベベルと同じ流儀で角を落とす
module whisker_plate(l, w, y) {
    translate([-l / 2, y, -w / 2]) rotate([90, 0, 0]) spk_obround(l, w, 0.01);
}
module whisker_cut(l, w, ch) {
    fy = -BEZ_T / 2;                            // 正面の外の面
    hull() {                                    // 口: 外へ開く（面より 0.5 外まで伸ばす）
        whisker_plate(l + ch * 2, w + ch * 2, fy - 0.5);
        for (p = bev_pts(ch, WSK_R))
            whisker_plate(l + p[1] * 2, w + p[1] * 2, fy + p[0]);
    }
    hull() {                                    // 奥は素通し
        whisker_plate(l, w, fy + ch);
        whisker_plate(l, w, fy + BEZ_T + 1);
    }
}

// ============================================================
// 4. 下（底面 ＋ 背面 ＋ 正面の下枠 ＋ スピーカー室の前板）
//    印刷: 床を下にして置く。立ち物は全部**垂直**なのでサポート不要
// ============================================================
module lower_raw() {
    difference() {
        union() {
            translate([-WALL, -BEZ_T, -WALL]) cube([OUT_X, OUT_Y, WALL]);   // 底板
            translate([0, IN_Y, -WALL]) cube([IN_X, WALL, IN_Z + WALL]);    // 背板
            // 正面の下枠（窓の下のふち）。⚠ X は窓の幅だけ。左右は上側の枠のもの
            // 四隅の R のぶん、板を WIN_CR だけ高くしてから窓を引く。両端に角が残る
            difference() {
                translate([WIN_X0, -BEZ_T, 0])
                    cube([WIN_X1 - WIN_X0, BEZ_T, WIN_Z0 + WIN_CR]);
                win_prism();
            }
            // 位置決めのリップ。上側の壁がこの外側に落ちる
            translate([0, 0, 0])          cube([1.5, IN_Y, 1.5]);
            translate([IN_X - 1.5, 0, 0]) cube([1.5, IN_Y, 1.5]);

            for (b = BOSSES) screw_boss(b[0], b[1]);


            // ---- OLED が乗る棚 ----
            translate([OLED_X0, 0, 0]) cube([OLED_L, OLED_Y1, OLED_Z0]);

            // ---- ReSpeaker: 位置を決める溝 ----
            translate([RSP_X, RSP_BD_Y0 - 2, 0])
                cube([respeaker_L(), respeaker_T() + 4 + FIT * 2, RSP_Z]);
            translate([RSP_X, RSP_BD_Y0 - 2 - FIT, 0])
                cube([respeaker_L(), 2, RSP_Z + 3]);
            // 後ろの土手は3つに切れている。⚠ 当たり検査 chk_lower が見つけた実当たりを
            //   避けた結果:  基板の左端側は 3.5mm ジャックの胴、真ん中は背面の部品
            for (seg = [[RSP_X + 14, RSP_X + 28], [RSP_X + 35, RSP_X + respeaker_L()]])
                translate([seg[0], RSP_BD_Y1 + FIT, 0])
                    cube([seg[1] - seg[0], 2, RSP_Z + 3]);

            // ---- ReSpeaker: ねじで留める柱 ----
            //  低いほう … 床から立てる。⚠ 板に触れるのは穴のまわりの φ6 だけ。
            //  柱の本体は 1.9mm 引いてある（板の背面に低い部品が出ている・検査で発覚）
            translate([RSP_H_LO[0] - 4, RSP_BD_Y1 + 1.9, 0])
                cube([8, M2_POST - 0.9, RSP_H_LO[1] + 4]);
            translate([RSP_H_LO[0], RSP_BD_Y1, RSP_H_LO[1]]) rotate([-90, 0, 0])
                cylinder(d = 6, h = 2);
            //  高いほう … 🔒 **ヘッダの外を通す。**
            //  ヘッダ 2列は X 64.0〜82.0 / Y 14.1〜24.1 / Z 9〜11・27〜29 を占めていて、
            //  穴（X 81.5 / Z 33.6）の真下は塞がっている。柱をその**右外**（X 82.5〜85.7）
            //  に立て、ヘッダの上（Z 30.6〜）で腕を左へ伸ばして穴を拾う。
            //  🔴 2026-08-17 まで柱と腕が **X 109.5＝箱詰めスタディの座標のまま**で、
            //     今の箱（内寸 X 86）の外に立っていた。エンベロープとの intersection は
            //     外に出た肉を**黙って捨てる**ので、chk_lower には出ず、**印刷物から
            //     柱ごと消える**状態だった（スタディ→v1 の移植で −27 の取り残し）。
            //     🔒 以後この柱は数字直書きをやめ、**穴 RSP_H_HI からの相対**で書く。
            //  ⚠ 一度これを「後ろへ逃がして 45度 で戻す」形にしたが、45度の支えが
            //     ヘッダの帯を横切って 67mm3 めり込んだ（chk_lower）。**下から支える道は無い。**
            //  ⚠ 腕の裏の X 78.5〜82.5 × Y 14.1〜20 だけはサポートが付かない。
            //     4 × 6mm の小さな面で、内側の見えない面なので垂れても構わない
            translate([RSP_H_HI[0] + 1.0, 18.0, 0])                            // 柱
                cube([3.2, 6.5, RSP_H_HI[1] + 0.4]);
            translate([RSP_H_HI[0] + 1.0, RSP_BD_Y1, RSP_H_HI[1] - 3])         // 腕（柱の上）
                cube([3.2, 24.5 - RSP_BD_Y1, 5.4]);
            translate([RSP_H_HI[0] - 3.0, RSP_BD_Y1, RSP_H_HI[1] - 3])         // 腕（穴まで）
                cube([4.0, 5.9, 5.4]);

            // ---- ハブ基板: 位置を決める溝 ----
            translate([HUB_X0, HUB_PCB_Y0 - 2 - FIT, 0])
                cube([hub_size()[0], 2, HUB_Z0 + 2]);
            translate([HUB_X0, HUB_Y1 + FIT, 0])
                cube([hub_size()[0], 2, HUB_Z0 + 2]);
            translate([HUB_X0, HUB_PCB_Y0 - 2, 0])
                cube([hub_size()[0], HUB_Y1 + 2 + FIT - (HUB_PCB_Y0 - 2), HUB_Z0]);
            // ---- ハブ基板: ねじで留めるフィン2枚 ＋ 腕4本 ----
            //  フィンは半田面の外に立てる。腕だけが穴のところで板に触れる
            // ⚠ フィンには**線を通す窓**を開ける。PowerBoost の +5V/GND は基板の上端
            //    （Z 34〜37）から前へ出るので、無いとフィンが線の道を塞ぐ（検査で発覚）
            for (sx = [HUB_HOLES[0][0], HUB_HOLES[2][0]]) difference() {
                translate([sx - 6, HUB_Y1 + FIT, 0])
                    cube([12, 4, HUB_Z0 + hub_size()[1]]);
                translate([sx - 2.5, HUB_Y1 + FIT - 1, 30])
                    cube([6, 6, 12]);   // ⚠ +X 側へ寄せてある。+5V の口がそちらに来る
            }

            // ---- 電池のポケット ----
            translate([LIPO_AT[0] - 2, LIPO_AT[1] - 2, 0])
                cube([LIPO_L + 4, LIPO_TH + 2, LIPO_AT[2]]);
            for (sx = [LIPO_AT[0] - 2, LIPO_AT[0] + LIPO_L]) {
                translate([sx, LIPO_AT[1] - 2, 0])
                    cube([2, LIPO_TH + 2, LIPO_AT[2] + LIPO_W]);
                // 上端の爪。1.2mm かぶせる。⚠ **わざと重ねてある**ので chk_lower に残る。
                //   電池は柔らかい袋なので上から押し込めば越える。下は 45度 の支え
                sgn = (sx < LIPO_AT[0]) ? 1 : -1;
                translate([sx + (sgn > 0 ? 2 : 0), LIPO_AT[1] - 2,
                           LIPO_AT[2] + LIPO_W - 1.2]) {
                    translate([sgn > 0 ? 0 : -1.2, 0, 0]) cube([1.2, LIPO_TH + 2, 1.2]);
                    rotate([90, 0, 0]) translate([0, 0, -LIPO_TH - 2])
                        linear_extrude(LIPO_TH + 2)
                            polygon([[0, 0], [sgn * 1.2, 0], [0, -1.2]]);
                }
            }

            // ---- 付け根の受け座（TAIL_BELL のときだけ）----
            if (TAIL_BELL)
                translate([TGL_AT[0], IN_Y + WALL, TGL_AT[1]]) rotate([-90, 0, 0])
                    difference() {
                        cylinder(d1 = TAIL_SEAT_D, d2 = TAIL_SEAT_D - 12, h = 6);
                        sphere(d = TAIL_ROOT_D + 1.0);
                    }
            // ---- アンテナ線のチューブを挿す口（背板の外）----
            if (!TAIL_BELL)
            // ⚠ 壁から水平に出るので、床を下にして刷ると 2.5mm の庇になる。短いので許容
            translate([TGL_AT[0] + 9, IN_Y + WALL, TGL_AT[1]]) rotate([-90, 0, 0])
                cylinder(d = ANT_TUBE_D + 1.6, h = ANT_NOZ_L);

            // ---- PowerBoost: 背板から出す柱4本 ----
            // ⚠ 柱の端は背板の**中まで**伸ばす。壁の面とちょうど同じ高さで終わらせると、
            //    面が重なって CGAL が 2-manifold でない形を作る（実際それで警告が出た）
            for (h = PB_HOLES) translate([h[0], IN_Y - PB_POST, h[1]])
                rotate([-90, 0, 0]) cylinder(d = 5.0, h = PB_POST + 1);
            // ---- ハブ基板: フィンから板の裏まで出す腕4本 ----
            // ⚠ 同じ理由で、腕の端はフィンの中で止める（フィンの端と揃えない）
            for (h = HUB_HOLES) translate([h[0], HUB_PCB_Y1, h[1]])
                rotate([-90, 0, 0]) cylinder(d = M2_POST, h = HUB_Y1 + FIT + 3.5 - HUB_PCB_Y1);
        }

        // ---- ハブ基板の腕（フィンから前へ）の下穴は board_post で開くので、
        //      ここでは腕そのものを足す前に引くものだけ ----
        // 🔒 ねじの下穴は**全部ここで開ける**（柱を足し終わったあとに引く）。
        //    柱ごとに difference すると、あとから union した肉が下穴を埋め戻す。
        //    ⚠ 実際それで下側が manifold 警告を出した（2026-08-16）
        for (h = [RSP_H_LO, RSP_H_HI])       // ReSpeaker
            translate([h[0], RSP_BD_Y1 - 1, h[1]]) rotate([-90, 0, 0])
                cylinder(d = M2_PILOT, h = M2_POST + 3);
        // ハブ基板。⚠ 止まり穴にする。腕の端と下穴の端を**同じ面にしない**
        //    （面が重なると CGAL が 2-manifold でない形を作る）
        for (h = HUB_HOLES)
            translate([h[0], HUB_PCB_Y1 - 1, h[1]]) rotate([-90, 0, 0])
                cylinder(d = M2_PILOT, h = HUB_Y1 + FIT + 3 - HUB_PCB_Y1);
        // PowerBoost。⚠ 柱が 4mm しかないので**背板を貫かせる**。
        //    そうしないと M2×6 が入り切らない（外から見える小穴は許容）
        for (h = PB_HOLES)
            translate([h[0], IN_Y - PB_POST - 1, h[1]]) rotate([-90, 0, 0])
                cylinder(d = M2_PILOT, h = PB_POST + WALL + 2);

        // トグルのパネル穴（背板）。🔒 これが無いとブッシングが壁に埋まる。
        //    ⚠ 2026-08-16、側面から背面へ移したとき開け忘れて 56.46mm3 の当たりになった
        translate([TGL_AT[0], IN_Y + WALL + 1, TGL_AT[1]])
            rotate([90, 0, 0]) mts102_hole(WALL + 2);
        // 同軸を出すスリット（鍵穴の縦棒）。ブッシングの丸と繋げて1つの口にする
        translate([TGL_AT[0] - ANT_SLOT_W / 2, IN_Y - 1, TGL_AT[1]])
            cube([ANT_SLOT_W, WALL + 2, ANT_OFF + ANT_SLOT_W / 2]);
        // 窓の縁の 45度カット（下枠のぶん）
        win_chamfer_cut();
    }
}
module shell_lower() { intersection() { lower_raw(); outer_envelope(); } }

// ============================================================
// 5. 上（天面 ＋ 左右の側面 ＋ 窓の左右枠）
//    印刷: **天面を下にして置く**
// ============================================================
module upper_raw() {
    difference() {
        union() {
            translate([-WALL, -BEZ_T, IN_Z]) cube([OUT_X, OUT_Y, TOP_T]);   // 天面
            for (sx = [-WALL, IN_X])                                        // 左右の側面
                translate([sx, -BEZ_T, 0]) cube([WALL, OUT_Y, IN_Z]);
            // 窓の枠（ここにマイクの穴が開く）。正面いっぱいの板から窓を引いて作るので
            // 四隅に R が乗る。🔒 下枠と**下の角2つ**は下シェルの持ち物なので、
            //    その区画（窓の幅 × 高さ WIN_Z0 + WIN_CR）はここで引いておく
            difference() {
                translate([0, -BEZ_T, 0]) cube([IN_X, BEZ_T, IN_Z]);
                win_prism();
                translate([WIN_X0, -BEZ_T - 1, -1])
                    cube([WIN_X1 - WIN_X0, BEZ_T + 2, WIN_Z0 + WIN_CR + 1]);
            }

            // ---- OLED のねじボス4本（M2×8・裏から）----
            // ✅ 2026-08-17 爪をやめてねじにした（🔒「基板は立てるだけにしない」）。
            //    穴はほぼ角（縁から 1.55/2.55）なので、4本とも窓の外・**左右の枠
            //    （上シェル）の裏**に隠れる。OLED は上シェルに留めてから被せる。
            //    ⚠ ボスは PCB の角から 1mm はみ出すが、穴の周りの半リングで受かるので足りる
            for (h = OLED_HOLES)
                translate([h[0], 0, h[1]]) rotate([-90, 0, 0])
                    cylinder(d = 5.0, h = OLED_BOSS_L);

            // ---- スピーカーを貼る位置を出す縁（これだけ。受け皿は作らない）----
            // 🔒 ケーシング付きなので**両面テープで天面の裏に貼る**。縁は 0.8mm しか
            //    出ておらず、貼るとき位置がずれないようにするためだけのもの
            translate([SPK_X - SPK_RIM_M, SPK_Y - SPK_RIM_M, IN_Z - SPK_RIM])
            difference() {
                spk_obround(SPK_L + SPK_RIM_M * 2, SPK_W + SPK_RIM_M * 2, SPK_RIM);
                translate([SPK_RIM_M - FIT, SPK_RIM_M - FIT, -1])
                    spk_obround(SPK_L + FIT * 2, SPK_W + FIT * 2, SPK_RIM + 2);
            }

            // ---- つまみの座（knob_v4 の実物）----
            translate(KNOB_AT) knob_station_add();

            // ---- 会話ボタンの座（タクトスイッチの爪ポケット）----
            translate([BTN_AT[0], BTN_AT[1], 0]) btn_socket();
        }

        // ============ 引くもの ============
        translate(KNOB_AT) knob_station_cut();

        // ---- 会話ボタン ----
        // 皿（俵型）
        translate([BTN_AT[0] - BTN_DISH_L / 2, BTN_AT[1] - BTN_DISH_W / 2, Z_BTN_DISH])
            spk_obround(BTN_DISH_L, BTN_DISH_W, BTN_DISH_T + 1);
        // 皿の口を 0.3 広げる（見える角のバリ取り）
        translate([BTN_AT[0], BTN_AT[1], Z_TOP - CH]) hull() {
            translate([-BTN_DISH_L / 2, -BTN_DISH_W / 2, 0])
                spk_obround(BTN_DISH_L, BTN_DISH_W, 0.01);
            translate([-BTN_DISH_L / 2 - CH, -BTN_DISH_W / 2 - CH, CH])
                spk_obround(BTN_DISH_L + CH * 2, BTN_DISH_W + CH * 2, 0.01);
        }
        // キャップの押し棒が通る穴（皿の底 → 増し肉を貫通）
        translate([BTN_AT[0], BTN_AT[1], Z_BTN_PAD - 1])
            cylinder(d = BTN_HOLE_D, h = BTN_PAD_T + 2);

        // ---- 振動板の逃げ（貼ったとき振動板が天板に触れないように）----
        translate([SPK_X + (SPK_L - SPK_DIA[0]) / 2 - 0.5,
                   SPK_Y + (SPK_W - SPK_DIA[1]) / 2 - 0.5, IN_Z - 0.01])
            spk_obround(SPK_DIA[0] + 1, SPK_DIA[1] + 1, SPK_REL + 0.01);
        // ---- 天面のへこみ（壁は 45度）----
        translate([SPK_X + SPK_L / 2, SPK_Y + SPK_W / 2, 0]) hull() {
            translate([0, 0, Z_TOP - EMB_H]) linear_extrude(0.01)
                offset(r = 2) square([SPK_DIA[0] + EMB_M * 2 - 4,
                                      SPK_DIA[1] + EMB_M * 2 - 4], center = true);
            translate([0, 0, Z_TOP + 1]) linear_extrude(0.01)
                offset(r = 2) square([SPK_DIA[0] + EMB_M * 2 - 4 + (EMB_H + 1) * 2,
                                      SPK_DIA[1] + EMB_M * 2 - 4 + (EMB_H + 1) * 2],
                                     center = true);
        }
        // ---- 音の穴（🔒 振動板の上だけ。枠の上に開けても音は出ない）----
        // ⚠ 一度ここをヒゲにしたが、ヒゲは**マイク**の話だった（ユーザー）。丸穴に戻した
        grille_xy(SPK_X + SPK_L / 2, SPK_Y + SPK_W / 2,
                  SPK_DIA[0], SPK_DIA[1], IN_Z, TOP_T, 2.2, 3.4);
        // 窓の縁の 45度カット（左右と上の枠のぶん）
        win_chamfer_cut();

        // ---- マイクの穴＝ヒゲ（✅ 2026-08-17「ヒゲっぽく」はここ。顔の頬にあたる）----
        // 位置は PARTS_CAD から引く。基板を動かしても付いてくる。
        // 左右3本ずつのスリットが外へ向かって開く扇。🔒 真ん中の1本をマイクの
        // 真正面（bx, bz）に置く＝音の通り道はヒゲにしても保証される
        for (ref = ["U4", "U5"]) {
            m = cad_part(ref, -1);
            bx = RSP_X + respeaker_L() - (m[2] + m[3]) / 2;
            bz = RSP_Z + (m[4] + m[5]) / 2;
            out = (bx < IN_X / 2) ? 1 : -1;         // ヒゲの先が向く側（外）
            // ✅ 長さ 6・外へ 1.0 ずらし（2026-08-17 ユーザー: 「もっと短くていい」
            //    「画面から離さないとベベル加工に乗る」）。真ん中のスリットは
            //    マイクの真正面（bx）を 2mm 残して覆うので、音の通り道は変わらない
            for (i = [-1, 0, 1])
                translate([bx - out * 1.0, -BEZ_T / 2, bz + i * 3.6])
                    rotate([0, out * i * 12, 0])
                        whisker_cut(WSK_L, WSK_W, WSK_CH);
        }


        // ---- XIAO の USB-C（右の壁）----
        translate([IN_X - 1, RSP_BD_Y1 - 0.5, RSP_Z + 14 - 1.5])
            cube([WALL + 2, 10.5, 12]);
        // ---- 充電口（PowerBoost の microUSB・天面）----
        translate([USB_PB[0] - 7, USB_PB[1] - 5, IN_Z - 1]) cube([14, 10, TOP_T + 2]);
        // ---- OLED のねじの下穴（ボスを貫いてベゼルへ 1.4。正面まで 0.6 残す）----
        for (h = OLED_HOLES)
            translate([h[0], -BEZ_T + 0.6, h[1]]) rotate([-90, 0, 0])
                cylinder(d = M2_PILOT, h = BEZ_T - 0.6 + OLED_BOSS_L + 0.5);
        // ---- 合わせのねじ穴 ----
        for (b = BOSSES) screw_hole(b[0], b[1]);
    }
}
// ⚠ 上側だけ、スピーカーの盛り上げのぶん天面より上を許す。
//    面取り箱でそのまま切ると、盛り上げが**丸ごと消える**（実際に消していた）
module shell_upper() {
    intersection() {
        upper_raw();
        union() {
            outer_envelope();
            translate([SPK_X - 6, SPK_Y - 6, Z_TOP - 1])
                cube([SPK_L + 12, SPK_W + 12, EMB_H + 1]);
        }
    }
}

// ============================================================
// 6. 会話ボタンのキャップ・半月クリップ・ポケット（前2つは印刷部品）
//   組む順番（全部、上シェル単体のうちに済ませる）:
//     ① キャップを皿へ上から入れる（押し棒が穴を通って下へ出る）
//     ② 下から、押し棒の首に半月クリップを横滑りで嵌める → もう上へ抜けない
//     ③ スイッチに線をはんだ付けしてから、下からポケットへ押し込む（爪が掛かる）
//   外すときは逆順。クリップは抜くだけ、スイッチは爪を裏から開く
// ============================================================
// ポケット。原点は BTN_AT（Z は絶対値で書いてある）
module btn_socket() {
    B  = tsw_body();
    yi = B / 2 + FIT;              // 胴の面（遊び込み）
    // 増し肉（皿の底と押し棒の穴の受け）
    translate([-BTN_PAD_X / 2, -BTN_PAD_Y / 2, Z_BTN_PAD])
        cube([BTN_PAD_X, BTN_PAD_Y, IN_Z - Z_BTN_PAD]);
    // 天井板: 胴の上面が突き当たる面。
    // 🔒 穴は軸径ではなく**押し棒の先の太さ（φ5）**が押し代ぶん降りてくる前提で開ける
    // 🔒 増し肉との間はクリップの通り道（高さ 2.0 の横スリット）なので埋めない
    difference() {
        translate([-BTN_POST_I - BTN_PKT_T, -BTN_POST_I - BTN_PKT_T, Z_TSW_TOP])
            cube([(BTN_POST_I + BTN_PKT_T) * 2, (BTN_POST_I + BTN_PKT_T) * 2,
                  Z_NECK1 - Z_TSW_TOP]);
        translate([0, 0, Z_TSW_TOP - 1]) cylinder(d = BTN_HOLE_D,
                                                  h = Z_NECK1 - Z_TSW_TOP + 2);
    }
    // 四隅の柱（天井板を増し肉へ繋ぐ）。内面はクリップ(φ7)より外
    for (sx = [-1, 1], sy = [-1, 1])
        translate([sx * BTN_POST_I + (sx < 0 ? -BTN_PKT_T : 0),
                   sy * BTN_POST_I + (sy < 0 ? -BTN_PKT_T : 0), Z_NECK1])
            cube([BTN_PKT_T, BTN_PKT_T, Z_BTN_PAD - Z_NECK1]);
    // 爪の指2本（±Y）。返しが胴の底の縁に 0.5 掛かる。下面は 45度の誘い
    for (sy = [-1, 1]) mirror([0, sy < 0 ? 1 : 0, 0])
        translate([-BTN_CLAW_W / 2, yi, 0]) {
            translate([0, 0, Z_TSW_BOT - BTN_CLAW_G])
                cube([BTN_CLAW_W, BTN_PKT_T, Z_TSW_TOP - Z_TSW_BOT + BTN_CLAW_G + 0.01]);
            // 返し（断面は直角三角形。上面が水平で胴の底を受ける）
            translate([0, 0, Z_TSW_BOT]) rotate([90, 0, 90]) linear_extrude(BTN_CLAW_W)
                polygon([[0, 0], [-BTN_CLAW_G, 0], [0, -BTN_CLAW_G - 0.8]]);
        }
    // 胴の角の案内（爪と直交する向きのずれ止め。±X 側・足の上をまたぐ短い柱）
    for (sx = [-1, 1])
        translate([sx * yi + (sx < 0 ? -BTN_PKT_T : 0), -1.0, Z_TSW_TOP - 1.2])
            cube([BTN_PKT_T, 2.0, 1.2]);
}

// キャップ＝頭＋押し棒。原点は BTN_AT（Z は絶対値）
module button_cap() {
    z_head = Z_TOP - (BTN_H - BTN_OUT);        // 頭の下面（自由状態で天面 −2.5）
    z_top  = z_head + BTN_H;                   // 頭の上面
    // 頭（俵型・中空）。天面の角は 0.8 落とす（つまみの GRIP_CH と同じ）
    difference() {
        hull() {
            translate([-BTN_L / 2, -BTN_W / 2, z_head])
                spk_obround(BTN_L, BTN_W, BTN_H - 0.8);
            translate([-(BTN_L - 1.6) / 2, -(BTN_W - 1.6) / 2, z_top - 0.01])
                spk_obround(BTN_L - 1.6, BTN_W - 1.6, 0.01);
        }
        difference() {
            translate([-(BTN_L - BTN_WALL * 2) / 2, -(BTN_W - BTN_WALL * 2) / 2,
                       z_head - 0.01])
                spk_obround(BTN_L - BTN_WALL * 2, BTN_W - BTN_WALL * 2,
                            BTN_H - BTN_WALL);
            cylinder(d = BTN_PLG_D + 2.4, h = 100);   // 押し棒の根元の肉は残す
        }
    }
    // 押し棒: 穴の中は φ5 → クリップの首 φ3.2 → 下の壁 φ5。先の面が軸の頭を押す
    translate([0, 0, Z_NECK0]) cylinder(d = BTN_PLG_D, h = z_head - Z_NECK0 + 0.01);
    translate([0, 0, Z_NECK1]) cylinder(d = BTN_NECK_D, h = Z_NECK0 - Z_NECK1 + 0.01);
    translate([0, 0, Z_TIP])   cylinder(d = BTN_PLG_D, h = BTN_LIP_H + 0.01);
}

// 窓の四隅の R（✅ 2026-08-17 ユーザー指摘「ベベルの角取りはしてないのですか？」）。
// 🔴 原因は作り方のほうだった。それまで枠は**板を3枚並べた隙間**で窓にしていたので、
//    四隅は板の角どうしの突き合わせになり、どうやっても直角にしかならない。
//    そこで**正面いっぱいの板から窓の形を引く**ように変えた。角の R はここで効く。
// 大きさは外形の面取り（CHAM 2mm）と揃えてある。
// ⚠ 角が食い込むのは窓の隅の 0.17mm ぶんだけで、ガラスの角（発光部の外）に当たる
WIN_CR = 2.0;
// 窓の穴の断面。g だけ外へ膨らませられる（ベベルはこれを重ねて作る）
module win_rrect(g = 0) {
    hull() for (x = [WIN_X0 + WIN_CR, WIN_X1 - WIN_CR],
                z = [WIN_Z0 + WIN_CR, WIN_Z1 - WIN_CR])
        translate([x, z]) circle(r = WIN_CR + g, $fn = 40);
}
// 窓そのもの（ベゼルを貫く柱）。上下シェルが同じものを引くので合わせ目で段差にならない
module win_prism() {
    translate([0, 1, 0]) rotate([90, 0, 0]) linear_extrude(BEZ_T + 2) win_rrect();
}

// 窓の縁のカット（✅ 2026-08-17「Rではなく斜めにカット」ユーザー指定）。
//   正面から 1.2 のところまで広がる。上下シェル両方が同じ形で引くので段差なし
// ✅ 2026-08-17 追記「すこしだけ丸みが欲しい」。斜めは斜めのまま、bev_pts で両端の角だけ
//   落とした。WIN_R = 0 に戻せば以前の 45度そのものになる
WIN_CH = 1.2;
WIN_R  = 0.4;
module win_bev_slab(g, y) {
    translate([0, y + 0.01, 0]) rotate([90, 0, 0]) linear_extrude(0.01) win_rrect(g);
}
module win_chamfer_cut() {
    hull() {
        // 面より 0.5 外まで同じ口で伸ばす（面と重なる面を作らないため。肉は削らない）
        win_bev_slab(WIN_CH, -BEZ_T - 0.5);
        for (p = bev_pts(WIN_CH, WIN_R)) win_bev_slab(p[1], -BEZ_T + p[0]);
    }
}

// OLED のねじの裏に噛ませる印刷ワッシャ（×4・平らに刷る）
//   🔒 役目は M2×8 の**余り 1.4mm を食う**こと。これが無いとねじ先が正面へ抜ける
module oled_washer() {
    linear_extrude(OLED_WASH_T) difference() {
        circle(d = 6.0);
        circle(d = 2.3);
    }
}

// 半月クリップ（印刷部品・平らに刷る）。原点は首の中心・Z 0〜1.2
module button_clip() {
    linear_extrude(BTN_CLIP_T) difference() {
        circle(d = BTN_CLIP_D);
        circle(d = BTN_NECK_D + 0.15);                 // 首をつかむ穴
        // 口（-Y へ開く）。幅 2.9 は首 φ3.2 より少し狭く、乗り越えて掴む。
        // 腕は面内にしなるので、片持ちの爪より割れにくい
        polygon([[-1.45, -1.0], [1.45, -1.0],
                 [2.3, -BTN_CLIP_D], [-2.3, -BTN_CLIP_D]]);
    }
}

// ============================================================
// 6.5 尻尾（マスタースイッチのレバーに挿すカバー・印刷部品）
//   🔒 先を上にして立てて刷る。テーパーだけの形なのでサポートは要らない。
//   ⚠ 付け根は丸めてある。振ったときに背板の角を叩かないため
// ============================================================
module tail_cap() {
    if (TAIL_BELL) {
        // 付け根を球で膨らませた版。原点は**レバーの支点（背板の外面）**
        difference() {
            hull() {
                sphere(d = TAIL_ROOT_D);
                translate([0, 0, TAIL_L - TAIL_D1 / 2]) sphere(d = TAIL_D1);
            }
            translate([0, 0, -60]) cylinder(r = 60, h = 60 + TAIL_RIM);   // リムより後ろを切る
            translate([0, 0, TAIL_ROOT_D / 2 - 7])                        // レバーの穴
                cylinder(d = TAIL_BORE, h = 9.5);
            translate([0, 0, TAIL_ROOT_D / 2 - 7])                        // 線の通り道
                cylinder(d = ANT_CH_D, h = TAIL_L);
            translate([0, 0, TAIL_RIM]) cylinder(d1 = TAIL_ROOT_D - 4, d2 = 0,
                                                 h = (TAIL_ROOT_D - 4) / 2);  // 中を抜く
        }
    } else {
        // 細い版（現行）。原点は付け根
        difference() {
            hull() {
                translate([0, 0, TAIL_D0 / 2]) sphere(d = TAIL_D0);
                translate([0, 0, TAIL_L - TAIL_D1 / 2]) sphere(d = TAIL_D1);
            }
            translate([0, 0, -0.01]) cylinder(d = TAIL_BORE, h = 9.5);
            // 同軸が入る道。根元は軸を外して（レバーを避けて）、先は軸の真ん中へ寄せる
            translate([0, ANT_OFF, -0.01]) cylinder(d = ANT_CH_D, h = 11);
            translate([0, 0, 9]) cylinder(d = ANT_CH_D, h = TAIL_L - 9 - 1.2);
            hull() {
                translate([0, ANT_OFF, 10]) cylinder(d = ANT_CH_D, h = 0.01);
                translate([0, 0, 11]) cylinder(d = ANT_CH_D, h = 0.01);
            }
        }
    }
}

// ============================================================
// 7. 中身
// ============================================================
module parts_all() {
    translate([RSP_X + respeaker_L(), RSP_BD_Y1, RSP_Z]) rotate([0, 0, 180])
        respeaker_lite();
    translate([OLED_X0, OLED_Y1, OLED_Z0]) rotate([90, 0, 0]) oled_242();
    translate([HUB_X0, HUB_PCB_Y1, HUB_Z0]) rotate([90, 0, 0]) hub_board(true);
    translate([LIPO_AT[0], LIPO_AT[1] + LIPO_TH, LIPO_AT[2]]) rotate([90, 0, 0])
        lipo_1000mah();
    translate([PB_AT[0] + PB_W, PB_AT[1] + PB_TH, PB_AT[2]]) rotate([90, 0, 0])
        rotate([0, 0, 90]) powerboost_1000c();
    // ✅ 2026-08-17 現物写真で出口を確定: リードは**裏面（磁石側）のパッド**から出る。
    //    裏面は箱の中（下）を向くので、線は下へ垂れてから引き回す。
    //    ⭐ 外形が対称なので端子の端は**貼る向きで選べる**。ここは「端子を**後ろの縁・左端**
    //    （X 11.5〜13.5 / Y ≈ 23.3）に置く」選択。行き先はハブの PHOUT（リレーの出口・
    //    X 34.7〜39.2 / Z 38〜44）で箱の後ろ側なので、**出口も後ろ向きが最短**
    //    （2026-08-17 ユーザー指摘。一度「右端・前の縁」を選んで OLED 側へ出してしまい、
    //    その前は「-Y ＝ ハブ基板の側」という嘘のコメントで向きを決めていた。**2回誤った。**）
    //    ⬜ 経路（下へ垂らす → 後ろへ → 右へ寄せて PHOUT）はハーネスの当たり検査で確かめる
    translate([SPK_X, SPK_Y, SPK_Z]) speaker_112495();
    // ---- INA226（⚠ 置き場の**提案**・2026-08-17。見て判断する用でまだ決定ではない）----
    // 🔒 電池⇔PowerBoost の電池線に直列（POWER.md 6章）。床に平置き・ネジ端子が上。
    //    左寄りの床（X 14〜41 / Y 25〜45.1）。①ネジ端子へ真上からドライバが入る
    //    （真上はボタンの増し肉の底 Z 45 まで素通し。締めるのは被せる前）②ハブの INA
    //    ヘッダ（X 48〜56・板の上端）へ I2C が斜め一本 ③電池（左後ろ）と PB（右後ろ）へは、
    //    立てたハブの壁をフィンの間（X 15〜71・Y 59.4〜63.4 の床）で渡る。
    //    ⚠ 置き場は今日2回誤った（両方ユーザー指摘）:
    //      1回目「フィンの間の床 Y 44〜71」… 立てたハブ基板（Y 55.5〜59.1 の壁）を貫通
    //      2回目「X 45〜72 の床」… ReSpeaker のヘッダ（X 64〜82・後ろへ 25mm の口）を封鎖
    //    🔒 左端 X 14 は詰めない。X 0〜14 はスピーカーのリード（X 11.5〜13.5 で垂れる）と
    //    ハブ PHIN/PHOUT（X 7.7〜12.2）の線の通り道
    //    ⬜ ボス・下穴は着荷実測（穴の径と位置・8/21〜29）を待って作る
    translate([14, 25.0, 0]) ina226_module();
    // 🔒 トグルは**背板の内側の面**に座る。ブッシング φ6 が壁を貫いて外へ出る
    translate([TGL_AT[0], IN_Y, TGL_AT[1]]) rotate([-90, 0, 0]) mts102(TAIL_ANG);
    color("#9aa5b1") translate([TGL_AT[0], IN_Y + WALL, TGL_AT[1]])
        rotate([-90, 0, 0]) rotate([TAIL_ANG, 0, 0])
            translate([0, 0, TAIL_BELL ? 0 : TAIL_GAP]) tail_cap();
    translate(KNOB_AT) assembly(show_deck = false);
    translate([BTN_AT[0], BTN_AT[1], Z_TSW_BOT]) tactswitch();
}

// ============================================================
// 7.5 線の要る空間（🟪 コネクタ1個につき 25mm・DIMENSIONS.md 1.5）
// ============================================================
// 🔴 **hub_board.scad は最初から hub_corridors() を持っていたのに、筐体側が
//    一度も呼んでいなかった**（2026-08-17・ユーザー「ケーブル全量足りてるか調べた？」）。
//    口の**位置**（ヘッダの箱）は parts_all に出ていたので当たり検査を通っていたが、
//    **線が出て曲がる空間**は誰も置いていなかった。だから「空いている床」に見えた。
// 🔒 これは飾りではない。**chk_wire_out が空でなければ、その線は物理的に出られない。**
module wire_corridors() {
    translate([HUB_X0, HUB_PCB_Y1, HUB_Z0]) rotate([90, 0, 0]) hub_corridors();
}
module inner_volume() { cube([IN_X, IN_Y, IN_Z]); }

// ============================================================
// 8. 出力
// ============================================================
module assembly_view() {
    color("#9aa5b1", SHELL_A)        shell_lower();
    color("#b6c0cc", SHELL_A * 0.85) shell_upper();
    color("#d8dde3") translate([BTN_AT[0], BTN_AT[1], 0]) button_cap();
    color("#8892a0") translate([BTN_AT[0], BTN_AT[1], Z_NECK1]) button_clip();
    parts_all();
}

if      (part == "none")   ;   // 何も描かない（切り分け用に include したいとき）
else if (part == "lower")  shell_lower();
else if (part == "upper")  translate([0, 0, Z_TOP]) rotate([180, 0, 0]) shell_upper();
// キャップは頭の天面を下にして刷る（押し棒が空洞の中の塔になり、サポート不要）
else if (part == "button")
    translate([0, 0, Z_TOP + BTN_OUT]) rotate([180, 0, 0]) button_cap();
else if (part == "clip")   button_clip();
else if (part == "washer") oled_washer();
else if (part == "tail")   tail_cap();
else if (part == "explode") {
    shell_lower();
    translate([0, 0, 55]) shell_upper();
    translate([BTN_AT[0], BTN_AT[1], 78]) button_cap();
    translate([0, 0, 26]) parts_all();
}
// ---- 当たり検査の読み方 ----
// 交差を STL に落として、連結成分ごとに体積を測る。**体積 0 は「接している」だけで正常。**
// 🔒 chk_lower に**わざと残してある重なりが4つ**ある。これ以外が出たら当たっている:
//    ・約 104mm3（X33〜107 / Z1〜7）と 約52mm3 ×2（Z47〜53）
//        … ハブ基板を受ける腕4本。hub_board() は半田面を「一様な2mmの箱」で描くが、
//          実物は**取付穴のまわりに足は出ていない**。スタンドオフはそこに当てるもの
//    ・約 22mm3（電池）… ポケットの爪。押し込んで越えさせるための重なり
// 筐体を外して中身だけ見る
else if (part == "inside") parts_all();
// 断面。CUT_AT より右を切り落とす。透過より中が見やすいことが多い
else if (part == "cut")
    difference() {
        assembly_view();
        translate([CUT_AT, -50, -50]) cube([300, 400, 300]);
    }
// 🟪 線の空間つき。箱から飛び出している紫が「出られない線」
else if (part == "chk_wire") { assembly_view(); wire_corridors(); }
// 🔴 箱の内側からはみ出した線の空間だけを残す。**空でなければ設計が成立していない**
else if (part == "chk_wire_out") difference() { wire_corridors(); inner_volume(); }
// 線の空間 ↔ 中身の当たり（線の通り道に部品を置いていないか）
else if (part == "chk_wire_parts") intersection() { wire_corridors(); parts_all(); }
else if (part == "chk_lower")  intersection() { shell_lower(); parts_all(); }
else if (part == "chk_upper")  intersection() { shell_upper(); parts_all(); }
else if (part == "chk_shell")  intersection() { shell_lower(); shell_upper(); }
else if (part == "chk_button")
    intersection() { translate([BTN_AT[0], BTN_AT[1], 0]) button_cap(); shell_upper(); }
else assembly_view();

// ============================================================
