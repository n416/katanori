// 部品モックのライブラリ（筐体設計用）
//
// **筐体を設計するときは、ここから部品を呼んで CAD の中で当てる。**
// 刷ってから当たりを見つけるのをやめるために作った（2026-08-04）。
// 寸法の出どころと格付けは docs/DIMENSIONS.md、
// ReSpeaker Lite だけは docs/RESPEAKER-LITE.md が正。
//
//   use <parts.scad>
//   as5600();  powerboost_1000c();  mts102();  reed_switch();  magnet_reed();
//
// ReSpeaker Lite は大きいので別ファイル:
//   use <respeaker_lite.scad>
//   respeaker_lite();  respeaker_envelope();
//
// ---- 約束 ----
// 1. **測っていない部品はここに書かない。** 仮の箱を置くと、それが事実として
//    使われる。今日それで1日溶かしている（docs/PRINT.md の🔒）
// 2. 各モジュールの先頭に、寸法の出どころを ✅実測 / 📄カタログ で書く
// 3. 部品の「外形」だけでなく、**コネクタ・ピンヘッダー・線の曲がり**まで箱にする
//
// ---- ⬜ まだここに無い部品（測ったら足す）----
// 2026-08-15 に筐体の箱詰めスタディ用に洗い直した。
//
// 手元にある（いま測れば足せる）:
//   ハブ基板 PU52X74（実装込み）     … 板は 52×74×1.6・取付穴 4-φ3.2@68×46（relay_board.html が正）。
//                                       🔴 実装の最高点は**ピンヘッダー**（リレーではない・2026-08-15）。
//                                       ⚠ **ハウジングを挿した状態**で測る（コネクタは挿すと伸びる）
//   リポ 3.7V 1000mAh                … ✅外形は入った（下）。⬜ JSTコネクタ・線の出る向き・曲げ半径
//   XIAO の ReSpeaker 上面からの高さ … 積み厚に効く（DIMENSIONS.md 1.5 の⬜）
// 着荷待ち（数字だけ先に入った）:
//   OLED 2.42" I2C                   … 📄外形は入った（下）。⬜ 素のパネル厚・四隅穴の径・ピン並び
// 着荷待ち:
//   INA226 モジュール                … 外形・ネジ端子の張り出し（8/21〜29 着）
//   PH2.0 ポスト                     … トップ/サイドで積み厚が約10mm変わる（発注済み・向きは現物合わせ）
// 設計待ち:
//   つまみ新版                       … ねじ止め前提の小型化を再設計してから（knob_jig.scad は旧構成。
//                                       KNOB-ENCODER.md「筐体用の小型化再設計」）
//
// リストから消したもの: OLED 0.96"（2.42" に交換）／押しボタン PS21B-3（パネル取付をやめた・
// DIMENSIONS.md）／リレー Y14H 単体（ハブ基板の実装高さに含める）

$fn = 64;

// ============================================================
// AS5600 モジュール
//   ✅ 定規で実測（23mm角・M2・穴中心間17mm・チップは4穴の中心）
//   ⚠ チップ高さ1.1mm は SOIC 想定の推定
//   ⚠ Dupontハウジング 約14mm・幅10.2mm。**ピン位置は未取得**
//      （knob_jig では位置を当てにいかず、基板の下を丸ごと窓にして回避した）
// ============================================================
AS5600_PCB       = 23.0;
AS5600_T         = 1.6;
AS5600_PITCH     = 17.0;
AS5600_M2        = 2.0;
AS5600_CHIP_H    = 1.1;   // ⚠
AS5600_HDR_H     = 14.0;  // ⚠ ピンヘッダー＋Dupontハウジング
AS5600_HDR_W     = 10.2;  // ⚠

module as5600(show_connector = true) {
    color("#2b6b3f")
    difference() {
        translate([-AS5600_PCB / 2, -AS5600_PCB / 2, 0])
            cube([AS5600_PCB, AS5600_PCB, AS5600_T]);
        for (x = [-1, 1], y = [-1, 1])
            translate([x * AS5600_PITCH / 2, y * AS5600_PITCH / 2, -1])
                cylinder(d = AS5600_M2, h = AS5600_T + 2);
    }
    // チップ（4穴の中心）
    color("#333") translate([-2.5, -2, AS5600_T]) cube([5, 4, AS5600_CHIP_H]);
    // ⚠ コネクタは「基板の裏側のどこかに生える」としか分かっていない。
    //    位置を当てにせず、裏面を丸ごと占有する箱として置く（設計側は窓にする）
    if (show_connector)
        color("#c93", 0.35)
            translate([-AS5600_HDR_W / 2, -AS5600_PCB / 2, -AS5600_HDR_H])
                cube([AS5600_HDR_W, AS5600_PCB, AS5600_HDR_H]);
}

// ============================================================
// Adafruit PowerBoost 1000C
// ============================================================
// 📄 出典: github.com/adafruit/Adafruit-PowerBoost-1000C の .brd（Rev B）を解析
//    ⚠ 製品ページの「45 × 23mm」は **USB-Aジャック込み**の値で、
//       **この個体はジャックを付けていない**（ユーザー）ので当たらない。板は 9mm 短い。
//    ⬜ 現物との照合は写真待ち。**📄 どまりなので、この値の上に穴を置かない。**
//
// 🔴 **2026-08-19、このモックはまだ「箱2段」だった**（ユーザー指摘「曖昧な箱」「分厚すぎる」）。
//    平面 36.07 × 22.86 も穴4つも口の座標も、2026-08-15 に .brd から取れていたのに、
//    モックだけが **板の全面に 8.4mm の塊を載せた 10mm の直方体**のままだった。
//    ⇒ 口を実体にした。**板の一般高さは ⚠3.0mm で、10mm は JST を入れても出ない。**
//    🔴 この 10mm が case_v2 の `PB_TH` に写っていて、背面の壁の厚みとして箱詰めされていた。
//
// ✅ **高さは 2026-08-19 の側面写真で埋めた**（下）。**全高 📄6.8mm**（✅板1.6 ＋ 📄JST 5.2）。
PB_L = 36.068;   // 📄 .brd Dimension レイヤー
PB_W = 22.86;    // 📄 同上
PB_PCB_T = 1.6;  // ✅ 2026-08-19 ユーザー実測（board_gauge.scad の櫛。1.5 に入らず 1.6 に入る）

// ---- 実装の高さ ----
// 📄 **2026-08-19、真横からの写真で読み直した**（ユーザー提示）。
//    倍率は板の長さ 36.068mm（📄 .brd）で合わせた。その倍率で板厚が 1.6 と読め、
//    ✅ **同じ 1.6 が櫛ゲージ（board_gauge.scad）でも出た**（同日・ユーザー）。
//    🔒 **写真とゲージは独立した観測で、両端（長さと厚み）で一致している。**
//       ⇒ 倍率の誤差は消えたので、下に残るのは読み取り誤差 **±0.3mm** だけ。
//    🔴 直前まで置いていた標準品の値（JST 6.0・インダクタ 3.0）より **全高で 0.8 低い。**
PB_SMD_H  = 3.3;                    // 📄 部品面の一般高さ＝**インダクタ**（黒い円柱・写真で最高のSMD）
PB_USB_H  = 3.0;                    // 📄 micro-B レセプタクル
PB_USB_SZ = [5.0, 7.5];             // ⚠ 同・X奥行 × Y幅（Y幅は写真では測れない）
PB_USB_OUT = 0.5;                   // 📄 板の端からわずかに出ている（写真で確認）
PB_JST_H  = 5.2;                    // 📄 JST-PH ボードコネクタ（**この板の最高点**）
PB_JST_SZ = [7.9, 4.5];             // ⚠ 同・X × Y
// 🔒 **外形の高さはここから出す。** 直接 10 と書かない
PB_H = PB_PCB_T + PB_JST_H;         // 📄 6.8（JST が最高点・±0.5）

// 📄 **取付穴は4つ。** 四隅に近い位置なので、ここで留めれば向きを選ばない。
//    ⭐ (33.91, *) の2つは **USB-Aのシールド固定タブ穴**で、ジャックを付けないので空いている。
//    ⚠ AI は一度「Rev B は2つ。現物の4つと合わない＝revision が違う」と断定した。誤り。
//       **`MOUNTINGHOLE` という名前の element だけを探していた**（2026-08-15）。
//       🔒 穴は名前ではなくドリル径で数える。
PB_MOUNT   = [[2.54, 2.54], [2.54, 20.32], [33.91, 5.18], [33.91, 18.32]];
PB_MOUNT_D = 2.4;   // 📄 φ2.5 ×2 と φ2.3 ×2。小さいほうに合わせておく

// 🔴 **この部品は4面すべてに出入口がある**（2026-08-15・ユーザーの指摘）。
//    どの面も壁に付けられない。**四方に逃げが要る。**
//
//      左端 (-X)  micro USB … **充電。箱の外に出す必要がある**
//      上辺 (+Y)  JST-PH    … 電池（工具なしで交換する）
//      下辺 (-Y)  JP2 8列   … **EN はここ**（左から4番目）
//      右端 (+X)  出力       … +5V / GND
//
//    ⚠ AI は「PowerBoost はどこにでも置ける形」と書いた。誤り。口を数えただけで、
//       **それが四方に散っているという形を見ていなかった。**
// 📄 電池の JST-PH2（B1）。⬜ 向きと突き出し量は未取得
PB_JST = [10.668, 19.304];

// 📄 JP2（下辺の8ピン列・2.54ピッチ・y=1.27）
//    左から VBUS / VLIPO / VBAT / **EN** / GND / LBO / GND / 5V
PB_JP2_Y  = 1.27;
PB_JP2_X0 = 12.83;          // 1番ピン
PB_EN     = [20.45, 1.27];  // 📄 JP2.4 = ENABLE
// 📄 充電の micro USB（CN4）。左端
PB_USB    = [3.8, 11.75];   // ⚠ SPRTパッドの中央（外形は未取得）。✅ 口の台形は部品面側（上）が広く板側（下）が狭い（2026-08-23 ユーザー実物）

// ✅ **この個体が実際に使っている端子は2つだけ**（2026-08-15・ユーザー）。
//    ブレイクアウトのスルーホール27個は**一切使っていない。**
//    使うのは USB-A の位置で、結線は U$25(+)=+5V と U$26(-)=GND の2本。
//    🔒 **線は基板の +X 端から2本だけ出る。**
PB_V5  = [31.115,  6.223];   // 📄 U$25 (+)
PB_GND = [31.115, 17.399];   // 📄 U$26 (−)
PB_OUT = [33.909, 11.7475];  // 📄 USB-A/端子台の中心（参考）

// ✅ **サイドエントリである**（2026-08-19 ユーザー「電池のコネクタはトップエントリじゃない」）。
//    ⇒ **抜け代は板厚方向（局所 +Z）へ出ない。板と平行に、板の端の外へ出る。**
//    🔒 したがって **PB_H = 6.8 が、電池を挿した状態でも板厚方向の全高**である。
// 🔴 AI はここに「トップエントリで板の上へ抜ける」と書き、板厚を 6.8+6.0=12.8 として
//    筐体の隙間の判定に使っていた（2026-08-19・ユーザー指摘で訂正）。
//    ✅ **出る端も確定した**（2026-08-19 ユーザー提示の実写）。**+Y の長辺**から出る。
//       写真で micro-USB が -X の短辺の中央に見え、JST はその右＝+Y 側で、線は板と平行に（✅ 2026-08-23 ユーザー実物確認「横」）
//       +Y へ出ている。座標 (10.668, 19.304)・板幅 22.86 からの推定と一致した。
//       ⚠ ハウジングは板の +Y 端より外へ出る（実写で確認・突き出し量は未測）。
PB_JST_MATE = 6.0;   // ⚠ ハウジングの抜け代。**板と平行**に出る（✅ 向きは実物確認 2026-08-23）。線の曲げ半径はさらに外側

// ---- 筐体側から読む値（🔒 case_*.scad はここを呼ぶ。数字を書き写さない）----
function pb_size()   = [PB_L, PB_W, PB_H];
function pb_pcb_t()  = PB_PCB_T;
function pb_mount()  = PB_MOUNT;
function pb_mount_d()= PB_MOUNT_D;
function pb_usb()    = PB_USB;        // 充電口の中心（板の -X 端）
function pb_usb_sz() = [PB_USB_SZ[0] + PB_USB_OUT, PB_USB_SZ[1], PB_USB_H];
function pb_jst()    = PB_JST;        // 電池コネクタの中心（板の +Y 端）
function pb_jst_sz() = PB_JST_SZ;    // 同・外形 [X, Y]
function pb_en()     = PB_EN;         // EN パッド（板の -Y 端）
function pb_out()    = [PB_V5, PB_GND];   // 出る線2本（板の +X 端）
function pb_jst_mate() = PB_JST_MATE;     // 電池を挿すと**板と平行に +Y へ**伸びる分
// ✅ サイドエントリなので、ハウジングは板の +Y 端より外へ出る。その突き出し量。
//    🔒 手で書かない。コネクタの +Y 面と板の端から計算する（21.554 → 22.86 で 4.694）
function pb_jst_out() = PB_JST[1] + PB_JST_SZ[1] / 2 + PB_JST_MATE - PB_W;

module powerboost_1000c() {
    // 板（穴4つ）
    color("#1a3f6b") difference() {
        cube([PB_L, PB_W, PB_PCB_T]);
        for (p = PB_MOUNT) translate([p[0], p[1], -1])
            cylinder(d = PB_MOUNT_D, h = PB_PCB_T + 2, $fn = 24);
    }
    // 部品面の一般高さ（⚠3.0）。**ここが 8.4 の塊だった**
    // 🔒 USB の居る左端（-X）は避ける。塊で塗ると充電口が中に消える
    // 📄 2026-08-22: +Y の端（JST 側）の x 16.5〜23.5 / y 21.0〜 は空けた。筐体の
    //    床の柱の唇（case_v2 §4.3b）がこの帯に被さる。**.brd（Rev B）でそこにあるのは
    //    ロゴ U$45（x 16.53〜20.30 / y 〜21.45）だけ**。JST B1 は x 5.57〜15.77
    // 📄 2026-08-23: +X の端（出力側）の x 33.0〜36.07 / y 12.0〜20.0 も空けた。case_v3 の
    //    ブリッジの柱の唇（後ろの L）がこの帯に被さる。**.brd（Rev B）でそこにあるのは
    //    FID1（基準マーク）と、未実装の端子台 X1・USB-A CN1 の足跡だけ**。R12（0805）は y 20.46〜
    color("#5a6472") difference() {
        translate([PB_USB_SZ[0] + 1, 0.5, PB_PCB_T])
            cube([PB_L - PB_USB_SZ[0] - 1.5, PB_W - 1, PB_SMD_H]);
        translate([16.5, 21.0, PB_PCB_T - 1]) cube([7.0, PB_W, PB_SMD_H + 2]);
        translate([33.0, 12.0, PB_PCB_T - 1]) cube([PB_L, 8.0, PB_SMD_H + 2]);
        // 取付穴の周り φ5 は部品が無い（取付穴のキープアウト）。ダボのピンの頭が出る分
        for (q = PB_MOUNT) translate([q[0], q[1], PB_PCB_T - 1]) cylinder(d = 5.0, h = PB_SMD_H + 2, $fn = 24);
        // 📄 2026-08-23: -Y の縁（EN 側）の y 0.5〜2.6 は、.brd では JP2（未実装のブレイクアウトのピンヘッダの pad）と
        //    LED（0805・高さ約 0.5）だけ。塊の高さ 3.3 で塗ると case_v3 のつまみの座の板と嘘の当たりが出る。
        //    C6（1210・高さ約 2.5）は y 2.61〜 なので塊に残る
        translate([-1, 0.5 - 0.01, PB_PCB_T + 0.6]) cube([PB_L + 2, 2.61 - 0.5, PB_SMD_H + 2]);
        // 📄 同じく y 2.61〜7.55 の帯で高さがある部品は C6（1210・約 2.5）と R14（0805・約 0.6）だけ。
        //    塊から抜いて、その 2 つを下で実体として置く
        translate([-1, 2.5, PB_PCB_T + 0.6]) cube([PB_L + 2, 7.55 - 2.5, PB_SMD_H + 2]);   // 2.61 から始めると 0.5〜2.6 の切り欠きとの境に 0.1 の膜が残る
    }
    // 📄 .brd（Rev B）: C6 = x 24.68〜27.64 / y 2.61〜7.55、R14 = x 4.84〜6.34 / y 2.72〜5.92
    color("#5a6472") translate([24.68, 2.61, PB_PCB_T]) cube([27.64 - 24.68, 7.55 - 2.61, 2.5]);
    color("#5a6472") translate([4.84, 2.72, PB_PCB_T]) cube([6.34 - 4.84, 5.92 - 2.72, 0.6]);

    // 充電の micro USB（-X 端・板から張り出す）
    color("#c8ccd0")
        translate([-PB_USB_OUT, PB_USB[1] - PB_USB_SZ[1] / 2, PB_PCB_T])
            cube([PB_USB_SZ[0] + PB_USB_OUT, PB_USB_SZ[1], PB_USB_H]);
    // 電池の JST-PH（+Y 端・**この板の最高点**）
    // ✅ サイドエントリ。開口は +Y を向く（2026-08-19 実写）
    color("#e8e8e8")
        translate([PB_JST[0] - PB_JST_SZ[0] / 2, PB_JST[1] - PB_JST_SZ[1] / 2, PB_PCB_T])
            cube([PB_JST_SZ[0], PB_JST_SZ[1], PB_JST_H]);
    // 出る線2本（+X 端）の付け根
    for (q = [PB_V5, PB_GND])
        color("#c93") translate([q[0] - 1.5, q[1] - 1.5, PB_PCB_T])
            cube([3, 3, 2.5]);
    // EN のパッド（-Y 端・ここにも線が1本付く）
    color("#c93") translate([PB_EN[0] - 1.27, PB_EN[1] - 1.27, PB_PCB_T])
        cube([2.54, 2.54, 2.5]);
}

// 電池を挿した状態の逃げ（⚠）。**筐体の当たり検査はこれを含めて見る**
// 🔴 2026-08-19 まで、ここは **+Z（板の上）へ 6mm 伸ばしていた。** 誤り。
//    JST-PH はサイドエントリで、ハウジングは **+Y へ、板と平行に**抜ける（ユーザー実写）。
//    この誤りのせいで板厚方向を 6.8 ではなく 12.8 として筐体の隙間を判定していた。
// ⚠ 6.0 という抜け代そのものは未測のまま。向きだけが直っている。
module pb_jst_plug() {
    color("#e8e8e8", 0.4)
        translate([PB_JST[0] - PB_JST_SZ[0] / 2, PB_JST[1] + PB_JST_SZ[1] / 2, PB_PCB_T])
            cube([PB_JST_SZ[0], PB_JST_MATE, PB_JST_H]);
}

// ============================================================
// トグルスイッチ MTS-102（マスタースイッチ）
//   ✅ **全長 33mm ／ 胴 13 × 8mm**（2026-08-16 ユーザー提示の寸法図つき写真）
//      🔴 **胴は角い。** それまで φ13 の円柱で描いていて、CAD で見ると**モーターに見えて**
//         いた（ユーザー指摘）。丸で描くと断面が 133mm2、実際は 104mm2。
//   📄 取付は φ6mm の穴（M6ブッシング）
//   ⚠ 内訳（レバー / ブッシング / 胴 / 端子）は写真からの読み取り。合計だけが ✅ 33mm
//   原点はパネル面。+Z がパネルの外（レバー側）
// ============================================================
MTS_LEN    = 33.0;      // ✅ 全長
MTS_BODY_W = 13.0;      // ✅ 胴の幅
MTS_BODY_D =  8.0;      // ✅ 胴の奥行き
MTS_BODY_H = 12.0;      // ⚠ 写真読み
MTS_BUSH_D =  6.0;      // 📄 M6
MTS_BUSH_H =  5.0;      // ⚠
MTS_LEVER  =  9.0;      // ⚠ パネルより外へ出るレバー（φ3）
MTS_PIN_H  =  6.0;      // ⚠ 端子（3本・1列）
MTS_MOUNT  = MTS_BUSH_D;

// パネルより内側に要る深さ（胴＋端子）。🔒 配線の逃げは呼ぶ側で足すこと
function mts102_deep()  = MTS_BODY_H + MTS_PIN_H;   // 18
function mts102_lever() = MTS_LEVER;

// ang: レバーの倒れ（度）。🔒 ON-ON なので**実物は必ずどちらかに倒れている**。
//      0 で描くと、当たりも見た目も嘘になる
module mts102(ang = 0) {
    // 胴（パネルの内側）。**角い**
    color("#2f6fd0") translate([-MTS_BODY_W / 2, -MTS_BODY_D / 2, -MTS_BODY_H])
        cube([MTS_BODY_W, MTS_BODY_D, MTS_BODY_H]);
    // 端子3本（1列・2.54ピッチ相当で並ぶ）
    color("#c9a227") for (i = [-1, 0, 1])
        translate([i * 4.7 - 0.6, -0.4, -MTS_BODY_H - MTS_PIN_H])
            cube([1.2, 0.8, MTS_PIN_H]);
    color("#ccc") cylinder(d = MTS_BUSH_D, h = MTS_BUSH_H);          // ブッシング
    color("#888") rotate([ang, 0, 0]) translate([0, 0, MTS_BUSH_H])  // レバー
        cylinder(d1 = 3.0, d2 = 2.4, h = MTS_LEVER);
}
module mts102_hole(t = 10) { cylinder(d = MTS_MOUNT + 0.4, h = t); }

// ============================================================
// マイクロスイッチ DAOKAI（会話ボタン・ヒンジレバー 3PIN）
//   ✅ 胴 **12（横）× 5（縦）× 6（高）**（2026-08-07 ユーザー実測）
//   ✅ **レバーの頂点 11 / 押し切り 6 / 動作 8.5**（2026-08-17 ユーザー実測・胴の底から）
//      → 頂点から **2.5mm 押すとクリック**、そこから更に 2.5mm 押し切れる（全 5mm）
//      🔴 これを知る前は「頂点＝6」と仮置きしていて、押し代 1.2mm の設計になっていた。
//         **クリックまで届かない筐体を作りかけた。** 高さ方向は仮置きで進めない。
//   ✅ 端子3本が1穴飛ばし＝ピッチ 5.08（2.54mm グリッドに乗る）／ 動作力 約30gf
//   ⬜ 端子の長さ・レバーのヒンジがどちらの端か・レバーの幅
//   原点は**胴の底面の中心**。+Z が上（レバー側）
// ============================================================
MSW_W = 12.0; MSW_D = 5.0; MSW_H = 6.0;
MSW_LEVER_TOP = 11.0;      // ✅ 自由状態のレバーの頂点
MSW_LEVER_BOT =  6.0;      // ✅ 押し切った高さ（＝胴の上面）
MSW_CLICK     =  2.5;      // ✅ 頂点から押し下げてクリックするまで
MSW_PIN_PITCH =  5.08;
MSW_PIN_H     =  3.5;      // ⚠ 未実測

function msw_size()    = [MSW_W, MSW_D, MSW_H];
function msw_act_h()   = MSW_LEVER_TOP;
function msw_click()   = MSW_CLICK;
function msw_travel()  = MSW_LEVER_TOP - MSW_LEVER_BOT;   // 5.0

// press: 頂点を何mm押し下げた状態で描くか（0〜5）
module microswitch_daokai(press = 0) {
    top = max(MSW_LEVER_BOT, MSW_LEVER_TOP - press);
    color("#2b2b2b") translate([-MSW_W / 2, -MSW_D / 2, 0])   // 胴
        cube([MSW_W, MSW_D, MSW_H]);
    // レバー（片端が胴の上面に留まり、反対の端が持ち上がる腕）
    // ⬜ どちらの端がヒンジかは未確認。ここでは -X 側をヒンジにしている
    color("#9a9a9a") translate([-MSW_W / 2 + 1, -MSW_D / 2 + 0.6, 0]) rotate([90, 0, 0])
        rotate([0, 0, 0]) translate([0, 0, -(MSW_D - 1.2)])
            linear_extrude(MSW_D - 1.2)
                polygon([[0, MSW_H], [MSW_W - 2, top],
                         [MSW_W - 2, top - 0.8], [0, MSW_H - 0.8]]);
    color("#c9a227") for (i = [-1, 0, 1])                     // 端子3本
        translate([i * MSW_PIN_PITCH - 0.6, -0.4, -MSW_PIN_H])
            cube([1.2, 0.8, MSW_PIN_H]);
}

// ============================================================
// タクトスイッチ 6×6×4.3・4足（LUYING 10種180個アソートの中の1種）
//   📄 2026-08-17 ユーザー発注・当日着。B0GV7PJTSG。定格 0.2A 12V（GPIO信号用）
//   ⚠ 同日に一度 1sw-221（2足・全高10mm）を選んだが、当日届くこちらへ差し替え
//   ⚠ ページに図面が無い。✅ 胴の高さ・軸径・ストローク・動作力は 2026-08-21 に実測。⬜ 残るは足
//   原点は**胴の底面の中心**。+Z が上（軸側）。足は ±X へ張り出して下へ曲がる
// ============================================================
TSW_BODY   = 6.0;    // ✅ 胴 6×6
TSW_BODY_H = 3.0;    // ✅ 2026-08-21 ユーザー実測（黒い胴だけ。軸と足を含まない）
TSW_H      = 4.3;    // ✅ 全高（軸の頭まで）
TSW_STEM_D = 3.5;    // ✅ 2026-08-21 ユーザー実測（銀色の軸の根元）
TSW_TRAVEL = 0.5;    // ✅ 2026-08-21 ユーザー実測（4.3 → カチッで 3.8）
// 🔴 動作力 255gf（2026-08-21 ユーザー実測）。**合格ライン 100gf を超えている**
//    → docs/SHOPPING.md 4.5 の 🔒 条件に不適合。判断待ち
TSW_LEG_SPAN = 6.5;  // ⚠ 未実測。±X の足の張り（曲げの根元の間隔）
TSW_LEG_P  = 4.5;    // ⚠ 未実測。同じ側の2本の間隔（Y）
TSW_LEG_H  = 3.5;    // ⚠ 未実測。足の下への出

function tsw_body()   = TSW_BODY;
function tsw_body_h() = TSW_BODY_H;
function tsw_h()      = TSW_H;
function tsw_stem_d() = TSW_STEM_D;
function tsw_travel() = TSW_TRAVEL;

module tactswitch(press = 0) {
    color("#2b2b2b") translate([-TSW_BODY / 2, -TSW_BODY / 2, 0])   // 胴
        cube([TSW_BODY, TSW_BODY, TSW_BODY_H]);
    color("#d8d8d8") cylinder(d = TSW_STEM_D,                        // 軸
                              h = max(TSW_BODY_H + 0.2, TSW_H - press));
    color("#c9a227") for (sx = [-1, 1], sy = [-1, 1]) {              // 足4本
        translate([sx * TSW_BODY / 2 - (sx < 0 ? 0.9 : 0),
                   sy * TSW_LEG_P / 2 - 0.35, 1.2])
            cube([0.9, 0.7, 0.6]);                                   // 横へ出る根元
        translate([sx * TSW_LEG_SPAN / 2 - 0.35,
                   sy * TSW_LEG_P / 2 - 0.35, 1.2 - TSW_LEG_H])
            cube([0.7, 0.7, TSW_LEG_H]);                             // 下へ曲がる先
    }
}

// ============================================================
// リードスイッチ（KILIGEN 樹脂モールド N/O）
//   ✅ 本体 14 × 3.2mm、足は**両端に 14mm ずつ**（全長 42mm）
//      📄 2026-08-16 ユーザー提示の寸法図。⚠ 8/15 に一度 2.5角×15 と書いたのは誤り
//      ⬜ 断面は 3.2 角と仮定（図に出ているのは幅の 3.2 だけ）
//   ✅ 閉じるのは 5mm（2026-08-15 実測）。ただし**接点は真ん中の一点**で、端へ行くほど
//      鈍る。磁石は平らな面を接点へ向けること
// ============================================================
REED_BODY = 14.0;
REED_SEC  = 3.2;
REED_LEAD = 14.0;          // 足の長さ。🔒 **切らない。曲げて使う**（天板の縁まで届く）
REED_GAP  = 5.0;           // 閉じる距離（接点まで）
// 🔒 寸法は関数で外へ出す。use <parts.scad> では変数は渡らないので、
//    呼ぶ側が数字を手で書き写すと、こちらを直しても向こうが古いままになる。
function reed_body_l()   = REED_BODY;
function reed_body_sec() = REED_SEC;
function reed_lead_l()   = REED_LEAD;
function magnet_reed_d() = 6.0;
// ⚠ 2026-08-17、この 2.15 は**嵌合と矛盾している。** 同じ磁石が幅 2.02 の圧入溝
//    （fit_gauge の3列目・点1）に入ることをユーザーが実物で確認した。2.15 なら入らない。
//    🔒 knob_v4.scad の MAG2_SLOT_W = 2.02 が実物で通っている側なので、そちらを信じる。
//    ここは測り直すまで**設計に使わない**（絵の厚みとしてだけ残す）
function magnet_reed_t() = 2.15;   // ⚠ 実測とされているが上の理由で疑わしい

module reed_switch(lead = REED_LEAD) {
    color("#d9d0b0") translate([-REED_BODY / 2, -REED_SEC / 2, -REED_SEC / 2])
        cube([REED_BODY, REED_SEC, REED_SEC]);
    color("#999") for (s = [-1, 1])
        translate([s * REED_BODY / 2, 0, 0]) rotate([0, 90 * s, 0])
            cylinder(d = 0.5, h = lead);
}

// ============================================================
// 磁石
//   リードスイッチ付属: 📄 φ6 × 厚2mm（軸方向着磁）
//   AS5600用          : ⚠ φ4.0（未実測・径方向着磁）
//                       ✅ ポケット内径 4.10mm で嵌合確定
// ============================================================
// ✅ 厚みは実測 2.15mm（2026-08-16・基板厚ゲージ）。径は φ6 でゲージ確定 6.10
module magnet_reed()   { color("#bbb") cylinder(d = 6.0, h = 2.15); }
module magnet_as5600() { color("#bbb") cylinder(d = 4.0, h = 2.0); }

// ============================================================
// リポ 3.7V 1000mAh
//   ✅ **50 × 35 × 6mm**・約20g。実物は **DTP603450(PHR) 3.7V 1000mAh**
//      （2026-08-19 ユーザー提示の実写でセルの刻印を確認）
//   🔴 **この寸法は同じ日に2回直っている。**
//      ① 54 × 34 × 5 … 長辺に「タブ側の封止 4mm」を足していた。⇒ 足さない（長辺 50）
//      ② 厚 5 → **6** … 旧記述は型番を「503450」と書いていた。**実物の刻印は 603450**で、
//         **先頭の 6 を 5 と読み違えていた**。603450 = 厚6.0 × 幅34 × 長50。
//      🔒 型番は寸法そのものなので、**刻印を読む前に厚みを決めない。**
//   ⚠ 短辺は型番の公称 34 に対し ✅ユーザー実測 35。封止の耳のぶん。**広いほうを採る。**
//   ✅ **線は短辺（保護基板のある側）から、板の面と平行に出る**（同・実写）。
//      🔒 **左右どちらの向きで入れてもよい**（2026-08-19 ユーザー「右でも左でも良い」）。
//         ⇒ 小部屋は左右どちらの端にも線の逃げを持たせる
//   ⭐ 主要部品でいちばん薄い（docs/POWER.md 4章の順位表）
//
//   ⬜ JSTコネクタと線の出る向き・曲げ半径は未取得。
//   🔴 電池は**工具なしで交換する**（docs/TODO.md B-1）。
//      この箱を置いただけでは設計できない —— 抜き挿しの経路と、
//      コネクタに指が届く空間を別に確保すること。
//      ⚠ 引き出す方向を決めたら lipo_swap_path() で通り道も差し引く
// ============================================================
LIPO_L = 50.0;
LIPO_W = 35.0;   // ⚠ 型番の公称は 34。封止の耳込みの実測 35 を採る
LIPO_T = 6.0;    // ✅ 型番 603450 の先頭2桁
// 🔒 筐体側はここを読む。数字を書き写さない（case_v2 が 54 を写して持っていた）
function lipo_size() = [LIPO_L, LIPO_W, LIPO_T];

module lipo_1000mah() {
    color("#8a8f98") cube([LIPO_L, LIPO_W, LIPO_T]);
}

// 交換のために空けておく通り道。dir は引き出す向き（+X）、travel は抜き切る距離。
// ⚠ 既定の travel = 全長 は「真っ直ぐ抜く」場合の最小値。傾けて出すなら足りない。
module lipo_swap_path(travel = LIPO_L, clear = 0.5) {
    color("#c33", 0.20)
        translate([-clear, -clear, -clear])
            cube([LIPO_L + travel + clear * 2, LIPO_W + clear * 2, LIPO_T + clear * 2]);
}

// ============================================================
// スピーカー 秋月 [112495] マイクロスピーカー 青/白リード付 8Ω
//   ✅ **23 × 15mm・両端が半円のオブラウンド（小判形）**
//      （2026-08-16 ユーザー実測＋定規つき写真）。⚠ 16 ではなく **15**
//   ✅ **ケーシング（樹脂の枠）が最初から付いている。筐体へは貼るだけ。**
//      🔴 受け皿・壁・爪を作らないこと。2026-08-16、これを知らずに枠と棚と爪を
//         作り込み、そのぶん筐体が太った（ユーザー指摘）。**留め方は両面テープ。**
//   ✅ **厚み 4.0mm**（2026-08-16 ユーザー実測）。📄商品ページの 4.6 は誤り
//   ⚠ リード線の直出しで PH2.0 ではない。2P(E) を継ぐ（docs/SHOPPING.md 2章）
//   ⚠ 振動板は枠の中央のオブラウンド 約14 × 8（写真読み）。
//      🔒 **穴を開けるのはここだけでよい。** 枠の上に穴を開けても音は出ない
//   ✅ リードの出口（2026-08-17 ユーザー写真・現物）: **側面ではなく裏面（磁石側）から出る。**
//      裏面の縁に小さな基板パッドがあり、青/白の線はそこから縁を越えて外へ流れる。
//      位置は長辺の縁ぞい・中央より片端寄り（⚠ 端からの正確な距離は写真ブレで±3mm）。
//      ⭐ 外形が対称の小判形なので、**どちらの端に端子が来るかは貼る向きで選べる。**
//      経路の都合は筐体側（case_v1）が決めてよい ／ ⬜ 定格(W)
//
//   🔴 **この箱だけで設計しない。** 小型スピーカーは裏に容積が要る
//      （キャビティ・docs/TODO.md B-1）。効いてくるのは厚みではなく背後の空間。
// ============================================================
SPK_L = 23.0;      // 長辺
SPK_W = 15.0;      // 短辺（＝両端の半円の直径）
SPK_T = 4.0;       // ✅ 実測
SPK_DIA_L = 14.0;  // ⚠ 振動板（写真読み）
SPK_DIA_W = 8.0;

function spk_l()  = SPK_L;
function spk_w()  = SPK_W;
function spk_th() = SPK_T;
function spk_dia() = [SPK_DIA_L, SPK_DIA_W];

// 原点は外形の角（左手前・下）。+Z が音の出る側
module spk_obround(l, w, h) {
    hull() for (s = [w / 2, l - w / 2])
        translate([s, w / 2, 0]) cylinder(d = w, h = h);
}
module speaker_112495() {
    color("#d9d9d9") spk_obround(SPK_L, SPK_W, SPK_T);          // ケーシング
    color("#c9b083") translate([(SPK_L - SPK_DIA_L) / 2, (SPK_W - SPK_DIA_W) / 2, SPK_T - 0.2])
        spk_obround(SPK_DIA_L, SPK_DIA_W, 0.4);                 // 振動板
    // リード2本（✅ 2026-08-17 現物写真: **裏面のパッドから**。局所 Z=0 の面・
    //    長辺の縁ぞい・片端寄り。振動板が +Z＝天面向きで貼るので、パッドは箱の中へ垂れる側）
    // 🔒 **出口を示すだけの 1.5mm の切り株にしてある。** 引き回しは自由（曲げられる線なので、
    //    長く描くと当たり検査に嘘の当たりが出る）。実際は出てすぐ下へ落とす
    for (c = [["#3355cc", 3.0], ["#eeeeee", 5.0]])
        color(c[0]) translate([c[1], SPK_W - 1.2, 0])
            rotate([180, 0, 0]) cylinder(d = 0.9, h = 1.5);
}

// ============================================================
// INA226 電流・電圧モニタ モジュール（Amazon B0GDX2P81Y・ネジ端子・10mΩ）
//   📄 **27.0 × 20.1 mm**（商品画像の寸法矢印・2026-08-17 ユーザー提供）
//   📄 **ネジ端子4口が片方の長辺**（INPUT 2口＋OUT 2口。電池⇔PowerBoost の
//      電池線をここに直列で通す・docs/POWER.md 6章）
//   📄 **反対の長辺に5ピンヘッダ**（VCC/GND/SDA/SCL/ALER。ハブへ行くのは4本）
//   ⚠ ネジ端子の高さ 10・奥行き 7.8・板厚 1.6 は推定（写真比・5.0mmピッチの標準想定）
//   ⬜ 取付穴2つ（対角・φ3 に見える）の位置と径 → 着荷実測（8/21〜29）してから足す。
//      🔒 それまで筐体側にボス・下穴を作らない（測っていない部品はモックに書かない）
//   🔴 シャントの値は現物の刻印を読んでからファームに書く（docs/POWER.md 6章）
// ✅ **ネジ端子（緑・青）は使わない**（2026-08-20 ユーザー「別にその緑と青のやつ
//    使う必要ないと思うよ」＋実写でどちらも**未実装で付属**していることを確認）。
//    ⇒ INPUT/OUT の大きなスルーホールへ線を直付けする。**10mm の端子は板に載らない。**
//    🔴 これで全高が **11.6 → 3.1mm** になる。筐体の当たりの前提が変わるので、
//       これを読んだら電流計まわりの逃げを取り直すこと。
INA_L = 27.0; INA_W = 20.1; INA_T = 1.6;
INA_TRM = false;    // ✅ ネジ端子を付けるか。false ＝ 直付け
INA_TRM_H = 10.0;   // ⚠ 写真比の推定（付ける場合のみ）
INA_TRM_D = 7.8;    // ⚠ 標準想定
INA_SMD_H = 1.1;    // ⚠ 板の上でいちばん高いSMD（IC）。**全面ではない**
// ---- 5ピンヘッダ（VCC/GND/SDA/SCL/ALER）----
// ⚠ **L字（横出し）を前提に置いた**（2026-08-20 ユーザー「ピンヘッダーもL字があるよ」）。
//    🔴 これは**指摘であって発注済みという意味ではない**。現物は未入手（着荷 8/21〜29）。
//    🔒 高さは**ハウジングを挿した状態**で数える。裸のヘッダ 2.5mm で数えない
//       —— hub_board.scad で同じ間違いを2回している。
//       ⇒ ハブ基板の横出しと同じ ⚠6.0mm（HUB_RA_HOUSING）を採る
//    ⚠ 横出しは高さを下げる代わりに**横へ出る**。線の逃げは板の面内に要る
INA_HDR    = true;    // ヘッダを付けるか
INA_HDR_RA = true;    // ⚠ true = L字（横出し）
INA_HDR_H  = INA_HDR_RA ? 6.0 : 8.5;
function ina_size() = [INA_L, INA_W, INA_T];
// 🔒 5ピンヘッダの並び（板の局所）。**筐体側が数字を書き写さないため**
//    [左端X, 幅, 手前Y, Y方向の長さ, 高さ]。L字なら板の +Y 端より外へ出る
function ina_hdr() = INA_HDR_RA
    ? [(INA_L - 12.7) / 2, 12.7, INA_W - 1.0, INA_HDR_H + 1.0, INA_HDR_H]
    : [(INA_L - 12.7) / 2, 12.7, INA_W - 2.54, 2.54, INA_HDR_H];
function ina_h()    = INA_T + max(INA_SMD_H,
                                  INA_TRM ? INA_TRM_H : 0,
                                  INA_HDR ? INA_HDR_H : 0);
// 原点は板の角（ネジ端子側の長辺・左）。板は XY 平面・部品は +Z に生える
module ina226_module() {
    color("#c0392b") cube([INA_L, INA_W, INA_T]);
    // 🔴 **板の全面に塊を載せない。** 2026-08-20 ユーザー指摘「めちゃくちゃ小さいパーツ
    //    なのにでかく描きすぎ」。PowerBoost で一度やった間違い（板の全面に 8.4mm の
    //    塊）と同じ形。⇒ 実写のとおり、載っているのはシャントとICだけ
    color("#3a3a3a") translate([INA_L * 0.33, INA_W * 0.42, INA_T])
        cube([6.5, 3.2, 1.0]);      // ⚠ シャント R010（2512）
    color("#222222") translate([INA_L * 0.55, INA_W * 0.40, INA_T])
        cube([3.2, 3.0, 1.1]);      // ⚠ INA226 本体（MSOP-10）
    if (INA_TRM) {
        color("#27ae60") translate([3.5, 0, INA_T]) cube([10, INA_TRM_D, INA_TRM_H]);  // INPUT
        color("#2980b9") translate([13.5, 0, INA_T]) cube([10, INA_TRM_D, INA_TRM_H]); // OUT
    }
    // 5ピンヘッダ。🔒 L字なら**板の外へ出る**。板の中に納めて描くと横の逃げが消える
    if (INA_HDR) {
        if (INA_HDR_RA)
            color("#222222") translate([(INA_L - 12.7) / 2, INA_W - 1.0, INA_T])
                cube([12.7, INA_HDR_H + 1.0, INA_HDR_H]);   // ⚠ ハウジング込みの外形
        else
            color("#222222") translate([(INA_L - 12.7) / 2, INA_W - 2.54, INA_T])
                cube([12.7, 2.54, INA_HDR_H]);
    }
}

// ============================================================
// OLED 2.42インチ I2C（現行の表示。前面パネル扱い）
//   📄 70.1 × 48.1mm（2026-08-15・図面）。**現物は未着**
//   ⚠ OLED_T = 20 は「厚み」として渡された値だが、この class のモジュールとしては厚く、
//      **背面のピンヘッダーを含んだ総厚の可能性が高い。**
//      🔴 パネルの窓をこの値で切らないこと。窓に要るのは表示面までの厚みで、
//         それは未取得（docs/DIMENSIONS.md 1章）。着荷したら素のパネル厚と分けて取り直す。
//   ⬜ 四隅穴の径・位置、⬜ ピン並び（docs/POWER.md 4章）
//
//   原点は基板の角。+Z が背面側（筐体の内側へ伸びる向き）。
// ============================================================
OLED_L = 70.1;   // ✅ 板幅（2026-08-19 ユーザー「板幅は70.1」）
// ⬜ 左4.5 + 黒枠61.0 + 右3.5 = 69.0 で、70.1 と 1.1 合わない。窓は左マージン 4.5 から
//    引いているので**左端は合う**。差の 1.1 は右側に出る。急ぎではない（点灯時に見る）
// ✅ **板の縦 48.1 は実測（2026-08-21 ユーザー確認）。**図面由来の値ではない。
//    🔒 筐体v2の `IN_Z = BOARD_Z + oled_w()` なので、**この数字がそのまま箱の高さ**
OLED_W = 48.1;
// ✅ **8.5mm（2026-08-15 ユーザー実測・現物着荷）。**
//    🔴 図面の「20mm」は誤りだった。⚠ AI が「総厚の疑い」と書いたのは当たっていたが、
//       実測はその推定(8mm)よりさらに薄い側だった。
//    ✅ **表示面の裏（背面）には何も無い**（ユーザー）。ヘッダを生やせる。
//    ✅ インターフェイスは**上辺と左辺**にある。
// ✅ **2026-08-19、横方向はユーザーの実測で確定した:**
//    **黒枠の左マージン 4.5 ／ 右マージン 3.5**（黒枠 61.0 は 2026-08-17 の✅）。
//    ⇒ **板幅 = 4.5 + 61.0 + 3.5 = 69.0mm**
// 🔴 **こちらが写真から読んだ 75.7 / 穴間 70.0 は誤りだった。破棄した。**
//    ユーザー:「レンズは曲面だからね」＝ **写真の端は曲がるので、定規を写し込んでも
//    端の位置は読めない。** 比を使っても、比の元になる端が曲がっていれば同じこと。
//    🔒 **外形の端の寸法は写真から読まない。実測を聞く。** ルーラー付きの正面写真で、
//    ✅記録済みの黒枠 61 × 38.5 と鋼尺の目盛りが**同じ倍率（12.8px/mm）で一致**した。
//    🔒 **倍率も視差も要らない読み方（比）で確かめた:**
//       写真の中で 板幅 : 黒枠幅 = 1.240。✅黒枠 61.0 を掛けると **板幅 75.7mm**。
//       同じく 穴間X : 黒枠幅 = 1.148 → **穴間 70.0mm**。
//       定規に直接当てた読みでも 板の左端 11.0cm / 右端 18.68cm ＝ **76.8mm** で一致する。
//    ⇒ **記録の「板幅 70.1」は、たぶん穴間の値を板幅として写している。**
//       縦（板 48.1 / 黒枠 38.5）は比でも一致するので、**狂っているのは横だけ。**
//    ⬜ **確定するまで、この2つの上に穴を置かないこと。**（⚠ 筐体の窓と柱4本が乗っている）
OLED_T = 8.5;
// ✅ 四隅穴: **穴間 横67 × 縦43・φ2.8・穴はほぼ角**（2026-08-17 確定）。
//    🔴 最初の申告は「62×38」だったが、それだと**穴が黒い枠に1.9mm食い込む**計算になり、
//       写真（穴は黒の外・角ぎわ）と矛盾した。写真を定規で校正して読み直し 67×43 →
//       ユーザーが承認。**「あり得ない値は作る前に照合」の実例がまた1つ。**
//    縁からの寄りは 横 (70.1−67)/2 = 1.55 / 縦 (48.1−43)/2 = 2.55
// ✅ 穴の面の深さ（2026-08-17 ユーザー実測）: **正面（ガラス面）から 3.0mm** に
//    基板の面がある（基板 1.6 なら裏面は 4.6）。
// ⬜ ねじ化の残りは**表示面（光る領域）の寸法と縁からの寄り**。いまの窓 66×43.1 は
//    パネル外形基準で大きすぎ、穴が窓の中に見えてしまう。窓を表示面に合わせて
//    狭めてからでないと、ボスを立てる肉が無い（case_v1.scad）
// ⬜ 板幅 69.0 に対し穴間 67.0 だと、穴の中心が板の端から 1.0mm。φ2.8 なら 0.4mm はみ出す。
//    穴は角の「耳」に載っているはずで、その耳の形が未取得。**急がない**（柱の位置は穴間で
//    決まり、耳の形は柱には効かない）。刷る前に一度だけ見ればよい
OLED_MOUNT_DX = 67.0;  // ✅ 2026-08-17 実測に戻した（写真読みの 70.0 は破棄）
OLED_MOUNT_DY = 43.0;
OLED_MOUNT_D  = 2.8;
OLED_PCB_Y    = 3.0;   // 正面 → 穴の開いている板の面（基板 1.6 なら裏面は 4.6）
// ✅ 表示部の黒い枠 **61 × 38.5**（2026-08-17 ユーザー実測）。
//    🔴 最初に AI が写真から 63.5×37.5 と読んで穴と矛盾させた。**外形の数字は測ってもらう。**
//    ⚠ 寄りは実測が横計だけなので、左右 (70.1−61)/2 = 4.55 ずつ（写真で対称）、
//      縦は写真の比で按分して 下 5.5 / 上 4.1（表示は上寄り）
//    ⬜ 発光する領域そのものは消灯写真では読めない。初点灯で窓との重なりを確認する
OLED_GLASS   = [61.0, 38.5];
OLED_GLASS_X = 4.5;    // ✅ 左マージン（2026-08-19 ユーザー実測。右は 3.5）
OLED_GLASS_Y = 5.5;    // 下の寄り（上は 4.1）
function oled_mount() = [for (sx = [-1, 1], sy = [-1, 1])
    [OLED_L / 2 + sx * OLED_MOUNT_DX / 2, OLED_W / 2 + sy * OLED_MOUNT_DY / 2]];
function oled_mount_d() = OLED_MOUNT_D;
function oled_l()       = OLED_L;
function oled_w()       = OLED_W;
function oled_pcb_y()   = OLED_PCB_Y;
// 正面から板の**裏面**までの距離（3.0 + 1.6 = 4.6）。🔒 口はこの面から生える
function oled_back()    = OLED_PCB_Y + 1.6;
function oled_glass()   = OLED_GLASS;
function oled_glass_x() = OLED_GLASS_X;
function oled_glass_y() = OLED_GLASS_Y;

module oled_242() {
    // 🔒 原点は**背面**の基板の角。+Z が正面向き
    //    （case_v1 が y = 8.5 − z で置くので、背面基準で描くと正面が y0 に来る）
    // 🔴 **2026-08-19、裏面を丸ごと予約していた箱（70.1 × 48.1 × 3.9）を削除した**
    //    （ユーザー指示「予約の箱削除」）。背面写真で中身が分かったため:
    //    ・裏はほぼ平ら。小さな SMD と、**中央の白い FPC コネクタ**、そこから下端を
    //      回り込んで正面へ抜ける**オレンジのフィルム**だけ
    //    ・~~I2C の口は2つ実在: 正面から見て左辺の4ピンと、上辺の中央寄りの4パッド~~
    //      🔴 **2026-08-20、この記述は古い**（ユーザー「それも古い」）。
    //      分かっているのは**ヘッダが直（ストレート）**であることだけ。
    //      ⬜ 辺・位置・突き出し量は未取得。**ここを事実として引かないこと**
    //    ・アドレスジャンパ 0x78 / 0x7A、「如需ACK应答，请短接D2」
    //    ⇒ **板の裏面は Y でいうと 3.9mm 手前へ戻る。** 口の逃げはそのぶん広がる。
    //    ⬜ FPC とフィルムはまだ形にしていない。**寸法が無いものを箱で置かない**
    //    ✅ **OLED_T = 8.5 の正体（2026-08-19 ユーザー）: 画面の面から、裏のフィルムが
    //       たわんで浮いた頂点までの距離。押さえつけると 8.0 になる。**
    //       ⇒ 板の裏面（正面から 4.6）から後ろへ、フィルムが最大 3.9mm 膨らむ。
    //         押さえれば 3.4mm。膨らむのは中央〜下端（フィルムが回り込む側）だけで、
    //         左右の端と上辺は 4.6 で終わる。**予約の箱が「全面 3.9」にしていたのが誤り**
    //    ✅ **フィルムは板の下面に接していない**（2026-08-21 ユーザー）。**切り欠きの中**を
    //       通って裏へ回っている。⇒ **板の下端は棚に直接載せてよい。**逃げは要らない。
    //       🔒 筐体側で `OLED_Z0` を床（0）まで下げてよい、という意味
    // 基板（四隅穴 ✅実測）
    color("#1a3f6b") translate([0, 0, OLED_T - OLED_PCB_Y - 1.6]) difference() {
        cube([OLED_L, OLED_W, 1.6]);
        for (p = oled_mount()) translate([p[0], p[1], -1])
            cylinder(d = OLED_MOUNT_D, h = 3.6, $fn = 24);
    }
    // 表示部の黒い枠（✅ 61×38.5）。正面の面はここ。穴（ほぼ角）は黒に触れない
    color("#101018") translate([OLED_GLASS_X, OLED_GLASS_Y, OLED_T - OLED_PCB_Y])
        cube([OLED_GLASS[0], OLED_GLASS[1], OLED_PCB_Y]);
}
