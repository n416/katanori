//      OLED_T 8.5（画面の面 → 裏の最高点）− 板の裏 4.6 ＝ 3.9 を全部フィルムの膨らみと読んだ誤り。最高点はコネクタの上のフィルム
//    ・FPC コネクタ: 中央・⚠ 写真から約 18 × 3.5、高さは 8.5 − 4.6 − 1.0 ＝ 2.9 と置く（写真に寸法が無い）
OLED_FILM_W = 12.5; OLED_NOTCH_W = 23.0; OLED_FILM_T = 1.0;
OLED_NOTCH_D = 7.0;   // ⚠ 切り欠きの深さ（2026-08-24 正面写真読み。上端は黒いモジュールに隠れて見えない・下端側 6.5 は見えた）
OLED_FPC = [18.0, 3.5, 2.0];   // ⚠ 幅 × 丈は写真から。✅ 高さ **約 2**（ユーザー 2026-08-24「出どころは 2mm くらい」＝このコネクタのこと）。切り欠きの所のフィルムの厚みはほぼ 0（同）
// ✅ フィルムの正体（2026-08-24 ユーザー「どう接続されていると思っている」への答えを形にした）:
//    **ガラスパネル自身の尻尾（恒久接着・外れない）**。ガラスの下端（正面側）から出て、
//    **下辺の切り欠き（幅 23）の中を通って**裏へ回り、裏面を上がって、裏の中央の FPC コネクタ（ZIF）に挿さる。
//    外せる接続点はコネクタ側の 1 箇所だけ。🔴 それまで「板の下端から生えた裏側だけの帯」で描いていて、どこにも繋がっていなかった
module oled_film() {
    zb = OLED_T - OLED_PCB_Y - 1.6;   // 板の裏の局所 z（3.9）
    zf = OLED_T - OLED_PCB_Y;         // 板の表の局所 z（5.5）＝ガラスの座る面
    color("#dd6b20", 0.7) {
        translate([OLED_L / 2 - OLED_FILM_W / 2, OLED_GLASS_Y - 2.0, zf]) cube([OLED_FILM_W, 2.0, OLED_FILM_T]);                      // ① ガラスの尻 → 切り欠きの上（正面側・板の表の上）
        translate([OLED_L / 2 - OLED_FILM_W / 2, 0, zb]) cube([OLED_FILM_W, OLED_GLASS_Y - 2.0 + 0.01, 1.6 + OLED_FILM_T]);           // ② 切り欠きの中を裏へ（板の厚みを横切る）
        translate([OLED_L / 2 - OLED_FILM_W / 2, 0, zb - OLED_FILM_T]) cube([OLED_FILM_W, OLED_W / 2, OLED_FILM_T]);                  // ③ 裏面を中央へ上がる
        translate([OLED_L / 2 - OLED_FILM_W / 2, OLED_W / 2 - OLED_FPC[1] / 2, zb - OLED_FPC[2] - OLED_FILM_T]) cube([OLED_FILM_W, OLED_FPC[1], OLED_FILM_T]);   // ④ コネクタへ入る（最高点 8.5）
    }
    color("#f5f5f5") translate([OLED_L / 2 - OLED_FPC[0] / 2, OLED_W / 2 - OLED_FPC[1] / 2, zb - OLED_FPC[2]]) cube([OLED_FPC[0], OLED_FPC[1], OLED_FPC[2]]);   // FPC コネクタ ⚠
