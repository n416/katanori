LIPO_L = 50.0;
LIPO_W = 35.0;   // ⚠ 型番の公称は 34。封止の耳込みの実測 35 を採る
LIPO_T = 6.0;    // ✅ 型番 603450 の先頭2桁
                 // ✅ 封止の端は約 5（2026-08-25 ユーザー実測・縁はテーパーで薄い）。縁に差し込む当たりはこちらで判断する
// 🔒 筐体側はここを読む。数字を書き写さない（case_v2 が 54 を写して持っていた）
function lipo_size() = [LIPO_L, LIPO_W, LIPO_T];

module lipo_1000mah() {
    color("#8a8f98") cube([LIPO_L, LIPO_W, LIPO_T]);
}

// 交換のために空けておく通り道。dir は引き出す向き（+X）、travel は抜き切る距離。
// ⚠ 既定の travel = 全長 は「真っ直ぐ抜く」場合の最小値。傾けて出すなら足りない。
module lipo_swap_path(travel = LIPO_L, clear = 0.5) {
    color("#c33", 0.20)
        translate([-clear, -clear, -clear])
            cube([LIPO_L + travel + clear * 2, LIPO_W + clear * 2, LIPO_T + clear * 2]);
}

// ============================================================
// スピーカー 秋月 [112495] マイクロスピーカー 青/白リード付 8Ω
//   ✅ **23 × 15mm・両端が半円のオブラウンド（小判形）**
//      （2026-08-16 ユーザー実測＋定規つき写真）。⚠ 16 ではなく **15**
//   ✅ **ケーシング（樹脂の枠）が最初から付いている。筐体へは貼るだけ。**
//      🔴 受け皿・壁・爪を作らないこと。2026-08-16、これを知らずに枠と棚と爪を
//         作り込み、そのぶん筐体が太った（ユーザー指摘）。**留め方は両面テープ。**
//   ✅ **厚み 4.0mm**（2026-08-16 ユーザー実測）。📄商品ページの 4.6 は誤り
//   ⚠ リード線の直出しで PH2.0 ではない。2P(E) を継ぐ（docs/SHOPPING.md 2章）
//   ⚠ 振動板は枠の中央のオブラウンド 約14 × 8（写真読み）。
//      🔒 **穴を開けるのはここだけでよい。** 枠の上に穴を開けても音は出ない
//   ✅ リードの出口（2026-08-17 ユーザー写真・現物）: **側面ではなく裏面（磁石側）から出る。**
//      裏面の縁に小さな基板パッドがあり、青/白の線はそこから縁を越えて外へ流れる。
//      位置は長辺の縁ぞい・中央より片端寄り（⚠ 端からの正確な距離は写真ブレで±3mm）。
//      ⭐ 外形が対称の小判形なので、**どちらの端に端子が来るかは貼る向きで選べる。**
//      経路の都合は筐体側（case_v1）が決めてよい ／ ⬜ 定格(W)
//
//   🔴 **この箱だけで設計しない。** 小型スピーカーは裏に容積が要る
//      （キャビティ・docs/TODO.md B-1）。効いてくるのは厚みではなく背後の空間。
// ============================================================
SPK_L = 23.0;      // 長辺
SPK_W = 15.0;      // 短辺（＝両端の半円の直径）
SPK_T = 4.0;       // ✅ 実測
SPK_DIA_L = 14.0;  // ⚠ 振動板（写真読み）
SPK_DIA_W = 8.0;

function spk_l()  = SPK_L;
function spk_w()  = SPK_W;
function spk_th() = SPK_T;
function spk_dia() = [SPK_DIA_L, SPK_DIA_W];

// 原点は外形の角（左手前・下）。+Z が音の出る側
module spk_obround(l, w, h) {
    hull() for (s = [w / 2, l - w / 2])
        translate([s, w / 2, 0]) cylinder(d = w, h = h);
}
module speaker_112495() {
    color("#d9d9d9") spk_obround(SPK_L, SPK_W, SPK_T);          // ケーシング
    color("#c9b083") translate([(SPK_L - SPK_DIA_L) / 2, (SPK_W - SPK_DIA_W) / 2, SPK_T - 0.2])
        spk_obround(SPK_DIA_L, SPK_DIA_W, 0.4);                 // 振動板
    // リード2本（✅ 2026-08-17 現物写真: **裏面のパッドから**。局所 Z=0 の面・
    //    長辺の縁ぞい・片端寄り。振動板が +Z＝天面向きで貼るので、パッドは箱の中へ垂れる側）
    // 🔒 **出口を示すだけの 1.5mm の切り株にしてある。** 引き回しは自由（曲げられる線なので、
    //    長く描くと当たり検査に嘘の当たりが出る）。実際は出てすぐ下へ落とす
    for (c = [["#3355cc", 3.0], ["#eeeeee", 5.0]])
        color(c[0]) translate([c[1], SPK_W - 1.2, 0])
            rotate([180, 0, 0]) cylinder(d = 0.9, h = 1.5);
}

// ============================================================
// INA226 電流・電圧モニタ モジュール（Amazon B0GDX2P81Y・ネジ端子・10mΩ）
//   📄 **27.0 × 20.1 mm**（商品画像の寸法矢印・2026-08-17 ユーザー提供）
//   📄 **ネジ端子4口が片方の長辺**（INPUT 2口＋OUT 2口。電池⇔PowerBoost の
//      電池線をここに直列で通す・docs/POWER.md 6章）
//   📄 **反対の長辺に5ピンヘッダ**（VCC/GND/SDA/SCL/ALER。ハブへ行くのは4本）
//   ⚠ ネジ端子の高さ 10・奥行き 7.8・板厚 1.6 は推定（写真比・5.0mmピッチの標準想定）
//   ✅ 着荷（2026-08-24・ユーザー実測＋写真）: **穴はφ3.0**。位置は下の INA_HOLES（531 の🔒は解除）。
//      🔴 **φ3 の大穴 2 つは OUT / INPUT の電流端子そのもの**（別の取付穴は無い）。
//         取付に使うなら電池の電流経路と同じ穴を共用することになる（事実。使い方はユーザー判断）
//   ✅ シャントの刻印は **R010 ＝ 10mΩ**（2026-08-24 ユーザー）。読むコードの待ちが外れた（docs/POWER.md 6章）
//   ✅ 5 ピンの並びのシルクは VCC・GND・SDA・SCL・ALER（写真）＝ 📄記録と一致。ネジ端子は未実装のまま ✓
// ✅ **ネジ端子（緑・青）は使わない**（2026-08-20 ユーザー「別にその緑と青のやつ
//    使う必要ないと思うよ」＋実写でどちらも**未実装で付属**していることを確認）。
//    ⇒ INPUT/OUT の大きなスルーホールへ線を直付けする。**10mm の端子は板に載らない。**
//    🔴 これで全高が **11.6 → 3.1mm** になる。筐体の当たりの前提が変わるので、
//       これを読んだら電流計まわりの逃げを取り直すこと。
INA_L = 27.0; INA_W = 20.1; INA_T = 1.6;
INA_PWR_HDR = true;   // 🔒 2026-08-25 電池線の口は直ピン 4 本（ユーザー）
INA_TRM = false;    // ✅ ネジ端子を付けるか。false ＝ 直付け
INA_TRM_H = 10.0;   // ⚠ 写真比の推定（付ける場合のみ）
INA_TRM_D = 7.8;    // ⚠ 標準想定
INA_SMD_H = 1.1;    // ⚠ 板の上でいちばん高いSMD（IC）。**全面ではない**
// ---- 5ピンヘッダ（VCC/GND/SDA/SCL/ALER）----
// 🔒 **ヘッダの形（L字/直/どちら向き）は決め事ではなく置き場の従属変数**（2026-08-24 ユーザー「置く場所によって変えればいい」）。
//    現物は未はんだ。置き場スタディが場所と一緒に形を出し、INA_HDR_RA / INA_HDR_BACK で切り替えて当てる。ユーザーに形を単独で聞かない。
// ⚠ **L字（横出し）を前提に置いた**（2026-08-20 ユーザー「ピンヘッダーもL字があるよ」）。
//    🔴 これは**指摘であって発注済みという意味ではない**。現物は未入手（着荷 8/21〜29）。
//    🔒 高さは**ハウジングを挿した状態**で数える。裸のヘッダ 2.5mm で数えない
//       —— hub_board.scad で同じ間違いを2回している。
//       ⇒ ハブ基板の横出しと同じ ⚠6.0mm（HUB_RA_HOUSING）を採る
//    ⚠ 横出しは高さを下げる代わりに**横へ出る**。線の逃げは板の面内に要る
INA_HDR    = true;    // ヘッダを付けるか
INA_HDR_RA = true;    // ⚠ true = L字（横出し）
INA_HDR_BACK = false; // （2026-08-24 に一度 true にしたが、あれは PowerBoost の話の聞き違いだった。INA は部品面側の L 字・ブリッジに密着のまま）
INA_HDR_H  = INA_HDR_RA ? 6.0 : 8.5;
INA_BACK_ENV = 3.8;   // 裏出しのとき、裏の面から出る厚み（ピン中心 2.5 ＋ ハウジング断面の半分 1.27）
function ina_size() = [INA_L, INA_W, INA_T];
// 🔒 5ピンヘッダの並び（板の局所）。**筐体側が数字を書き写さないため**
//    [左端X, 幅, 手前Y, Y方向の長さ, 高さ]。L字なら板の +Y 端より外へ出る
// ✅ 2026-08-24 商品画像（寸法矢印付き）を四隅で射影変換して読んだ（精度 ⚠ ±1）:
//    ・5 ピンヘッダは **短辺（20.1）側**: x ≈ 3.3、y 4.0〜14.7（VCC → ALER・2.54 ピッチ）
//    ・ネジ端子の 4 口は反対の短辺: x ≈ 26、y 3.6〜16.4
//    ・取付穴 2 つ（φ3 前後）は **対角ではなく端子側に並ぶ**: (20.1, 2.8) と (19.6, 16.9)
//    ・シャント R010 の中心 (21.0, 10.8)、INA226 (14.4, 10.9)
//    🔴 8/17 の「端子とヘッダは長辺」「穴は対角」は写真の読み違いだった。下の ina_hdr() と ina226_module() はこれで置き直した
INA_HDR_X = 3.3; INA_HDR_Y0 = 4.0 - 1.27; INA_HDR_LEN = 5 * 2.54;   // ヘッダ（短辺側・y 方向に 5 本）
// 🔒 2 モデル（2026-08-24 ユーザー「設置したらどっちかに当てはまるように 2 モデル作って置く」）:
//    直立て ina_hdr_straight() と L 字横出し ina_hdr_ra()。どちらもピン単位（樹脂 2.5・ピン 6・
//    線の DuPont 10・線の逃げ 3.6）。挿すのは **VCC/GND/SDA/SCL の 4 本**（POWER.md: ハブへ行くのは 4 本）・ALER は裸。
//    🔴 それまでの L 字の包絡（幅 8.5 の箱）は**ハウジングの長さ 10 を含んでいなかった**。横へ出る分が 10 以上不足していた
INA_PIN_Y = [for (k = [0 : 4]) 4.0 + k * 2.54];   // VCC → ALER
INA_USED_N = 4;                                    // 線を挿すのは先頭 4 本
module ina_hdr_straight(hous = true) {             // 直立て: 樹脂が板に座り、ピンは真上
    color("#222")    translate([INA_HDR_X - 1.27, INA_PIN_Y[0] - 1.27, INA_T]) cube([2.54, INA_HDR_LEN, 2.5]);
    color("#c8ccd0") for (y = INA_PIN_Y) translate([INA_HDR_X - 0.32, y - 0.32, INA_T]) cube([0.64, 0.64, 2.5 + 6.0]);
    if (hous) color("#63b3ed", 0.85) for (i = [0 : INA_USED_N - 1]) { y = INA_PIN_Y[i];
        translate([INA_HDR_X - 1.27, y - 1.27, INA_T + 2.5]) cube([2.54, 2.54, 10.0]);
        translate([INA_HDR_X - 1.8, y - 1.8, INA_T + 2.5 + 10.0]) cube([3.6, 3.6, 3.6]); }   // 線の逃げ（⚠既定 3.6）
}
module ina_hdr_ra(hous = true) {                   // L 字: 樹脂が板に座り、ピンは −x（板の外）へ水平
    color("#222")    translate([INA_HDR_X - 1.27, INA_PIN_Y[0] - 1.27, INA_T]) cube([2.54, INA_HDR_LEN, 2.5]);
    color("#c8ccd0") for (y = INA_PIN_Y) { translate([INA_HDR_X - 0.32, y - 0.32, INA_T]) cube([0.64, 0.64, 2.5 + 0.32]);
        translate([INA_HDR_X - 1.27 - 6.0, y - 0.32, INA_T + 2.5 - 0.32]) cube([6.0 + 0.95, 0.64, 0.64]); }
    if (hous) color("#63b3ed", 0.85) for (i = [0 : INA_USED_N - 1]) { y = INA_PIN_Y[i];
        translate([INA_HDR_X - 1.27 - 10.0, y - 1.27, INA_T + 2.5 - 1.27]) cube([10.0, 2.54, 2.54]);
        translate([INA_HDR_X - 1.27 - 10.0 - 3.6, y - 1.8, INA_T + 2.5 - 1.8]) cube([3.6, 3.6, 3.6]); }   // 線の逃げ
}
// ✅ 穴（2026-08-24 ユーザー実測）: 中心はヘッダ側の端から **16.6**。左右の端との隙間（穴の縁→板の端）は **0.5〜1**
//    ⇒ 中心は端から 2.0〜2.5（どちら側が 0.5 かは ⚠。中間 2.25 で置く・誤差 ±0.25）。🔴 射影読みの旧値 x≈20 は 3.4 ずれていた
INA_HOLES = [[16.6, 0.75 + 1.5], [16.6, INA_W - (0.75 + 1.5)]]; INA_HOLE_D = 3.0;   // ✅ φ3.0
function ina_holes() = INA_HOLES;
function ina_hole_d() = INA_HOLE_D;
// [x0, x の長さ, y0, y の長さ, 高さ]。L 型ならピンは −x（板の外）へ出る
function ina_hdr() = INA_HDR_RA
    ? [INA_HDR_X - 1.27 - INA_HDR_H, INA_HDR_H + 1.27 + 1.27, INA_HDR_Y0, INA_HDR_LEN, INA_HDR_H]
    : [INA_HDR_X - 1.27, 2.54, INA_HDR_Y0, INA_HDR_LEN, INA_HDR_H];
function ina_h()    = INA_T + max(INA_SMD_H,
                                  INA_TRM ? INA_TRM_H : 0,
                                  (INA_HDR && !INA_HDR_BACK) ? INA_HDR_H : 0);   // 部品面側の高さ
function ina_back_env() = (INA_HDR && INA_HDR_BACK) ? INA_BACK_ENV : 0;          // 裏の面から出る厚み
// 原点は板の角（ネジ端子側の長辺・左）。板は XY 平面・部品は +Z に生える
// ra: ヘッダの 2 モデルの切り替え（use<> 先から呼び分けるための引数。既定は INA_HDR_RA）
module ina226_module(ra = INA_HDR_RA, pwr_ra = true) {   // pwr_ra=false ＝ 電源の口（INPUT/OUT 4 本）を直立てに
    color("#c0392b") difference() {
        cube([INA_L, INA_W, INA_T]);
        for (h = INA_HOLES) translate([h[0], h[1], -1]) cylinder(d = INA_HOLE_D, h = INA_T + 2, $fn = 24);
    }
    // 🔴 **板の全面に塊を載せない。** 2026-08-20 ユーザー指摘「めちゃくちゃ小さいパーツ
    //    なのにでかく描きすぎ」。PowerBoost で一度やった間違い（板の全面に 8.4mm の
    //    塊）と同じ形。⇒ 実写のとおり、載っているのはシャントとICだけ
    color("#3a3a3a") translate([21.0 - 3.25, 10.8 - 1.6, INA_T]) cube([6.5, 3.2, 1.0]);   // シャント R010（2512）✅ 位置は写真から
    color("#222222") translate([14.4 - 1.6, 10.9 - 1.5, INA_T]) cube([3.2, 3.0, 1.1]);    // INA226（MSOP-10）✅ 同
    if (INA_TRM) {   // ネジ端子（使わない）。短辺 x ≈ 26 側
        color("#27ae60") translate([INA_L - INA_TRM_D, 0.5, INA_T]) cube([INA_TRM_D, 9.6, INA_TRM_H]);    // INPUT
        color("#2980b9") translate([INA_L - INA_TRM_D, 10.1, INA_T]) cube([INA_TRM_D, 9.6, INA_TRM_H]);   // OUT
    }
    // 🔒 2026-08-25 ユーザー: 電池線の口（INPUT ±・OUT ±）は端子の穴にピンヘッダ 4 本。
    //    形は L 字・外向き（端子側の縁 +x の外へ水平）——PB の L 字と同じ意匠・頭が上の混雑階に届かないため
    //    （当初のストレート案は頭 Z 49 が OLED の線・ボタンの傘の階に入り、板を横に逃がす羽目になった＝設計ミスに見える・ユーザー）。
    //    ✅ 穴位置は上の商品画像実測（x ≈ 26・4 口 y 3.6〜16.4・⚠±1）。挿すハウジング込み
    // 🔒 2026-08-26 ユーザー「左壁側のピンヘッダを垂直に」: pwr_ra=false で**直立て**（足はまっすぐ上・DuPont も縦）。
    //   L 字は板の縁の外へ 11.8mm 伸びていて、そこが左の壁の余裕を食っていた。直立てなら縁の外へは出ない。
    if (INA_PWR_HDR) for (y = [3.6, 7.87, 12.13, 16.4]) {
        color("#222")    translate([26.0 - 1.27, y - 1.27, INA_T]) cube([2.54, 2.54, 2.5]);                        // 樹脂
        if (pwr_ra) {
            color("#c8ccd0") translate([26.0 - 0.32, y - 0.32, -1.2]) cube([0.64, 0.64, 1.2 + INA_T + 2.5 + 1.59]);   // 足〜曲がり
            color("#c8ccd0") translate([26.0 - 0.32, y - 0.32, INA_T + 2.5 + 1.27 - 0.32]) cube([6.32, 0.64, 0.64]);  // 板に沿うピン（+x＝縁の外へ）
            color("#4a5568", 0.85) translate([26.0 + 0.5, y - 1.27, INA_T + 2.5]) cube([10, 2.54, 2.54]);             // DuPont（水平）
        } else {
            color("#c8ccd0") translate([26.0 - 0.32, y - 0.32, -1.2]) cube([0.64, 0.64, 1.2 + INA_T + 2.5 + 6.0]);    // 足（まっすぐ上・頭は樹脂の 6.0 上）
            color("#4a5568", 0.85) translate([26.0 - 1.27, y - 1.27, INA_T + 2.5]) cube([2.54, 2.54, 10]);            // DuPont（縦）
        }
    }
    // 5 ピンヘッダ（短辺 x ≈ 3.3・y 方向）。🔒 2 モデルをピン単位で持つ（INA_HDR_RA で選ぶ）
    if (INA_HDR && !INA_HDR_BACK) { if (ra) ina_hdr_ra(); else ina_hdr_straight(); }
    if (INA_HDR && INA_HDR_BACK)  { h = ina_hdr(); color("#222222") translate([h[0], h[2], -INA_BACK_ENV]) cube([h[1], h[3], INA_BACK_ENV]); }   // 裏出し（ハウジング込みの包絡）
}

// ============================================================
// OLED 2.42インチ I2C（現行の表示。前面パネル扱い）
//   📄 70.1 × 48.1mm（2026-08-15・図面）。**現物は未着**
//   ⚠ OLED_T = 20 は「厚み」として渡された値だが、この class のモジュールとしては厚く、
//      **背面のピンヘッダーを含んだ総厚の可能性が高い。**
//      🔴 パネルの窓をこの値で切らないこと。窓に要るのは表示面までの厚みで、
//         それは未取得（docs/DIMENSIONS.md 1章）。着荷したら素のパネル厚と分けて取り直す。
//   ⬜ 四隅穴の径・位置、⬜ ピン並び（docs/POWER.md 4章）
//
//   原点は基板の角。+Z が背面側（筐体の内側へ伸びる向き）。
// ============================================================
OLED_L = 70.1;   // ✅ 板幅（2026-08-19 ユーザー「板幅は70.1」。🔒 2026-08-24 ユーザー裁定「板幅は70.1だね。76.8は明らかに混乱してる。正直70に見える」で再確定）
// ⬜ 左4.5 + 黒枠61.0 + 右3.5 = 69.0 で、70.1 と 1.1 合わない。窓は左マージン 4.5 から
//    引いているので**左端は合う**。差の 1.1 は右側に出る。急ぎではない（点灯時に見る）
// ✅ **板の縦 48.1 は実測（2026-08-21 ユーザー確認）。**図面由来の値ではない。
