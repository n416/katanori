];
module pb_smd_parts() for (q = PB_SMD) color(q[5] >= 2.5 ? "#333" : "#5a6472") translate([q[1], q[3], PB_PCB_T]) cube([q[2] - q[1], q[4] - q[3], q[5]]);
// 🔴 廃止（2026-08-28）: USB も L 字に揃えたので powerboost_1000c からは呼ばれない。探針（_v4_wirepts.scad）が
//    旧姿勢との比較で使うので定義だけ残す。**新しく呼ばないこと**（理由は PB_USB_PIN の欄）
module pb_usb_pin_header() {   // （旧）8 ピン列の USB（8 番）に真っ直ぐな 1 ピン（部品面）。樹脂 2.5 ＋ ピン 6.0、裏の足 1.2
    x = PB_JP2_X0 + PB_USB_PIN * 2.54; y = PB_JP2_Y;
    color("#222")    translate([x - 1.27, y - 1.27, PB_PCB_T]) cube([2.54, 2.54, PB_RA_BODY]);
    color("#c8ccd0") translate([x - 0.32, y - 0.32, -PB_RA_TAIL]) cube([0.64, 0.64, PB_RA_TAIL + PB_PCB_T + PB_RA_BODY + PB_RA_PIN]);
}
module powerboost_1000c(hdr = "front", ra_dir = 1) {
    // 板（穴4つ）
    color("#1a3f6b") difference() {
        cube([PB_L, PB_W, PB_PCB_T]);
        for (p = PB_MOUNT) translate([p[0], p[1], -1])
            cylinder(d = PB_MOUNT_D, h = PB_PCB_T + 2, $fn = 24);
    }
    // ✅ 部品面は .brd（Adafruit Rev B・scratch/pb1000c.brd）の部品を一つずつ置く（2026-08-24 ユーザー「こんな形じゃない」）。
    //    それまでは「一般高さ 3.3 の中実から平らな帯を抜いた包絡」で、切り刻まれた見た目になり、当たりも粗かった。
    //    高さは部品の種類から: 0805 抵抗 0.6 / 0805 コンデンサ 1.3 / 1210 2.5 / QFN 1.0 / SC59 1.1 / LED 0.7 / インダクタ 3.3（📄 写真の最高点）
    pb_smd_parts();
    // 充電の micro USB（-X 端・板から張り出す）
    color("#c8ccd0")
        translate([-PB_USB_OUT, PB_USB[1] - PB_USB_SZ[1] / 2, PB_PCB_T])
            cube([PB_USB_SZ[0] + PB_USB_OUT, PB_USB_SZ[1], PB_USB_H]);
    // 電池の JST-PH（+Y 端・**この板の最高点**）
    // ✅ サイドエントリ。開口は +Y を向く（2026-08-19 実写）
    color("#e8e8e8")
        translate([PB_JST[0] - PB_JST_SZ[0] / 2, PB_JST[1] - PB_JST_SZ[1] / 2, PB_PCB_T])
            cube([PB_JST_SZ[0], PB_JST_SZ[1], PB_JST_H]);
    // ✅ USB-A の足跡に立てた 2.54 ピッチ 4 ピンのピンヘッダ（2026-08-14 ユーザー。2026-08-24 写真で位置を確認して模型に入れた）
    //    🔴 それまでは「線 2 本の付け根（3×3×2.5）」で描いていて、ヘッダ（樹脂 2.5＋ピン 6.0）も裏の足も無かった。当たらない方の絵だった
    //    列の中心は USB-A の中心（PB_OUT の y）。x は VBUS/GND のパッドの x（PB_V5[0]）⚠ 穴の x は .brd で未確認
    pb_usb_header();
    // 8 ピン列のヘッダ: "front" = 部品面の L 字 4 本（5Vo・GND・EN・USB） ／ "back" = 裏の L 字 3 本（壁ポーズでは壁に入るため 2026-08-24 に不成立と判明）
    if (hdr == "front") pb_jp2_ra_header(ra_dir);
    if (hdr == "back")  pb_jp2_back_ra();
    // （旧）EN のパッドの「線の付け根」は L 型ヘッダに置き換えた（2026-08-24）
}

// 電池を挿した状態の逃げ（⚠）。**筐体の当たり検査はこれを含めて見る**
// 🔴 2026-08-19 まで、ここは **+Z（板の上）へ 6mm 伸ばしていた。** 誤り。
//    JST-PH はサイドエントリで、ハウジングは **+Y へ、板と平行に**抜ける（ユーザー実写）。
//    この誤りのせいで板厚方向を 6.8 ではなく 12.8 として筐体の隙間を判定していた。
// ⚠ 6.0 という抜け代そのものは未測のまま。向きだけが直っている。
module pb_jst_plug() {
    color("#e8e8e8", 0.4)
        translate([PB_JST[0] - PB_JST_SZ[0] / 2, PB_JST[1] + PB_JST_SZ[1] / 2, PB_PCB_T])
            cube([PB_JST_SZ[0], PB_JST_MATE, PB_JST_H]);
}

// ============================================================
// トグルスイッチ MTS-102（マスタースイッチ）
//   ✅ **全長 33mm ／ 胴 13 × 8mm**（2026-08-16 ユーザー提示の寸法図つき写真）
//      🔴 **胴は角い。** それまで φ13 の円柱で描いていて、CAD で見ると**モーターに見えて**
//         いた（ユーザー指摘）。丸で描くと断面が 133mm2、実際は 104mm2。
//   📄 取付は φ6mm の穴（M6ブッシング）
//   ⚠ 内訳（レバー / ブッシング / 胴 / 端子）は写真からの読み取り。合計だけが ✅ 33mm
//   原点はパネル面。+Z がパネルの外（レバー側）
// ============================================================
MTS_LEN    = 33.0;      // ✅ 全長
MTS_BODY_W = 13.0;      // ✅ 胴の幅
MTS_BODY_D =  8.0;      // ✅ 胴の奥行き
MTS_BODY_H = 12.0;      // ⚠ 写真読み
MTS_BUSH_D =  6.0;      // 📄 M6
MTS_BUSH_H =  5.0;      // ⚠
MTS_LEVER  =  9.0;      // ⚠ パネルより外へ出るレバー（φ3）
MTS_PIN_H  =  6.0;      // ⚠ 端子（3本・1列）
MTS_MOUNT  = MTS_BUSH_D;

// パネルより内側に要る深さ（胴＋端子）。🔒 配線の逃げは呼ぶ側で足すこと
function mts102_w()     = MTS_BODY_W;   // 13 胴の幅。端子 3 本（ピッチ 4.7）が並ぶのはこの向き
function mts102_d()     = MTS_BODY_D;   //  8 胴の奥行き。`rotate([-90,0,0])` でハッチに付けると**こちらが縦**になる
function mts102_deep()  = MTS_BODY_H + MTS_PIN_H;   // 18
function mts102_lever() = MTS_LEVER;

// ang: レバーの倒れ（度）。🔒 ON-ON なので**実物は必ずどちらかに倒れている**。
//      0 で描くと、当たりも見た目も嘘になる
module mts102(ang = 0) {
    // 胴（パネルの内側）。**角い**
    color("#2f6fd0") translate([-MTS_BODY_W / 2, -MTS_BODY_D / 2, -MTS_BODY_H])
        cube([MTS_BODY_W, MTS_BODY_D, MTS_BODY_H]);
    // 端子3本（1列・2.54ピッチ相当で並ぶ）
    color("#c9a227") for (i = [-1, 0, 1])
        translate([i * 4.7 - 0.6, -0.4, -MTS_BODY_H - MTS_PIN_H])
            cube([1.2, 0.8, MTS_PIN_H]);
    color("#ccc") cylinder(d = MTS_BUSH_D, h = MTS_BUSH_H);          // ブッシング
    color("#888") rotate([ang, 0, 0]) translate([0, 0, MTS_BUSH_H])  // レバー
        cylinder(d1 = 3.0, d2 = 2.4, h = MTS_LEVER);
}
module mts102_hole(t = 10) { cylinder(d = MTS_MOUNT + 0.4, h = t); }

// ============================================================
// マイクロスイッチ DAOKAI（会話ボタン・ヒンジレバー 3PIN）
//   ✅ 胴 **12（横）× 5（縦）× 6（高）**（2026-08-07 ユーザー実測）
//   ✅ **レバーの頂点 11 / 押し切り 6 / 動作 8.5**（2026-08-17 ユーザー実測・胴の底から）
//      → 頂点から **2.5mm 押すとクリック**、そこから更に 2.5mm 押し切れる（全 5mm）
//      🔴 これを知る前は「頂点＝6」と仮置きしていて、押し代 1.2mm の設計になっていた。
//         **クリックまで届かない筐体を作りかけた。** 高さ方向は仮置きで進めない。
//   ✅ 端子3本が1穴飛ばし＝ピッチ 5.08（2.54mm グリッドに乗る）／ 動作力 約30gf
//   ✅ 2026-08-29 商品ページの図面（ユーザー提供・Unit mm・Error ±0.1）で ⬜ が埋まった:
//      胴 **12.8 × 5.8 × 6.5**（実測 12×5×6 は手の精度内）・レバー全長 13.5（胴 12.8 を先が越える）・
//      自由状態の頂点 10.5±0.5（実測 11 と整合）・レバーの**ヒンジは C（COM）端子の端**・
//      **取付穴 φ2.0 と φ2.2 が 2 つ・穴間 6.5**（胴を横に貫通）・端子 3.5 長・板厚 0.5・ボタン部 4.0 幅
//   原点は**胴の底面の中心**。+Z が上（レバー側）。ヒンジ側 = -X（図面どおりで確定）
// ============================================================
MSW_W = 12.8; MSW_D = 5.8; MSW_H = 6.5;   // ✅ 2026-08-29 図面の公称へ更新（旧 12/5/6 は実測・手の精度内）
MSW_LEVER_TOP = 10.5;      // ✅ 自由状態のレバーの頂点（図面 10.5±0.5。実測 11 はこの幅の中）
MSW_LEVER_BOT =  6.5;      // ✅ 押し切った高さ（＝胴の上面）
MSW_CLICK     =  2.5;      // ✅ 頂点から押し下げてクリックするまで（実測）
MSW_PIN_PITCH =  5.08;
MSW_PIN_H     =  3.5;      // ✅ 図面
MSW_HOLE_P    =  6.5;      // ✅ 取付穴 2 つの間隔（図面）。φ2.0 / φ2.2・胴を横に貫通
MSW_HOLE_D    =  2.0;
MSW_LEVER_L   = 13.5;      // ✅ レバー全長（図面）。ヒンジは -X（C 端子）側

function msw_size()    = [MSW_W, MSW_D, MSW_H];
function msw_act_h()   = MSW_LEVER_TOP;
function msw_bot_h()   = MSW_LEVER_BOT;
function msw_click()   = MSW_CLICK;
function msw_travel()  = MSW_LEVER_TOP - MSW_LEVER_BOT;
function msw_hole_p()  = MSW_HOLE_P;      // ✅ 取付穴 2 つの間隔（図面 6.5）
function msw_hole_d()  = MSW_HOLE_D;
function msw_pin_h()   = MSW_PIN_H;
function msw_lever_l() = MSW_LEVER_L;     // ✅ レバー全長（図面 13.5・ヒンジから先端）

// press: 頂点を何mm押し下げた状態で描くか（0〜5）
module microswitch_daokai(press = 0) {
    top = max(MSW_LEVER_BOT, MSW_LEVER_TOP - press);
    color("#2b2b2b") translate([-MSW_W / 2, -MSW_D / 2, 0])   // 胴
        cube([MSW_W, MSW_D, MSW_H]);
    // レバー（片端が胴の上面に留まり、反対の端が持ち上がる腕）
    // ⬜ どちらの端がヒンジかは未確認。ここでは -X 側をヒンジにしている
    // 🔴 2026-08-29 レバーは **胴の −X 端（C 端子側）が蝶番で、全長 13.5**（図面）。
    //   それまで「胴の 1mm 内から MSW_W−2 ＝ 10.8」で描いていて、先端が胴の中で終わっていた。
    //   実際は胴（12.8）を 0.7mm 越えて外へ出る。井戸との当たりがこれで見えていなかった。
    color("#9a9a9a") translate([-MSW_W / 2, -MSW_D / 2 + 0.6, 0]) rotate([90, 0, 0])
        translate([0, 0, -(MSW_D - 1.2)])
            linear_extrude(MSW_D - 1.2)
                polygon([[0, MSW_H], [MSW_LEVER_L, top],
                         [MSW_LEVER_L, top - 0.8], [0, MSW_H - 0.8]]);
    color("#c9a227") for (i = [-1, 0, 1])                     // 端子3本
        translate([i * MSW_PIN_PITCH - 0.6, -0.4, -MSW_PIN_H])
            cube([1.2, 0.8, MSW_PIN_H]);
}

