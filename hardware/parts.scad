OLED_MOUNT_DY = OLED_W - 2 * (OLED_HOLE_EDGE + OLED_MOUNT_D / 2);   // 44.1 ✅
OLED_PCB_Y    = 3.0;   // 正面 → 穴の開いている板の面（基板 1.6 なら裏面は 4.6）
