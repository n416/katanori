// 線を実体で描く道具
//
//   use <wires.scad>
//   wire([[0,0,0],[20,0,0],[20,30,0]], d = 1.4, r = 5);   // 1本
//   bundle([...], n = 7);                                  // 束（7本ぶんの太さ）
//   echo(wire_len([...], r = 5));                          // 実長 [mm]
//
// ============================================================
// 🔒 なぜ「逃げの箱」ではなく線そのものを描くのか
// ============================================================
// 2026-08-17、筐体 v1 が**配線できない**ことが分かった。口ごとに 25mm の直方体を
// 置く hub_corridors() は「どれだけ場所が要るか」は答えるが、
// **「その線が始点から終点まで実際に通れるか」には答えない。**
// 通り道は曲がるし、他の線と隙間を分け合うし、行き先は箱の反対側にある。
// ⇒ ユーザー指摘（「CAD上でケーブルみたいなものって作れるの？今回はちゃんと見ながら
//    作るべき」）を受けて、**点列を通る実寸のチューブ**として描けるようにした。
//
// 🔒 これで初めて次の3つが CAD で言える:
//   ① その線は通るか（chk と intersection すれば当たりが出る）
//   ② 何mm で作ればいいか（wire_len。⚠ ここに手の作業ぶんの余長を足す）
//   ③ 曲げがきつすぎないか（角は必ず r で丸めるので、r を下回る曲げは作れない）
//
// ============================================================
// ⚠ 使うときの約束
// ============================================================
// ・**線は「置く」ものではなく「通す」もの。** 始点と終点は必ず実物の口の座標から取る
//   （数字を手で書かない。hub_board_parts.scad / parts.scad の関数から引く）
// ・r（最小曲げ半径）は**コネクタの根元では効かない。** ハウジングから出て数mmは
//   まっすぐ出る前提で、最初の点を口から少し離して置くこと
// ・⬜ 実測値: 手持ちの DuPont 線（AWG26 相当）の外径と最小曲げ半径は未測定。
//   いまの既定 d=1.4 / r=5 は**一般値であって実測ではない**。現物を測ったら差し替える

// ---- 内部 ----
function _unit(v) = v / norm(v);
function _lerp(a, b, t) = a + (b - a) * t;
function _bez(a, b, c, n) =
    [for (i = [0 : n]) let (t = i / n) _lerp(_lerp(a, b, t), _lerp(b, c, t), t)];
// p から q の向きへ、r だけ（ただし区間の半分まで）戻った点
function _back(p, q, r) = p + _unit(q - p) * min(r, norm(q - p) / 2);

// 角を半径 r で丸めた点列にする。🔒 これがあるので「直角に折れた線」は作れない
function wire_round(pts, r = 5, n = 8) =
    (len(pts) < 3) ? pts :
    concat([pts[0]],
           [for (i = [1 : len(pts) - 2],
                 p = _bez(_back(pts[i], pts[i - 1], r), pts[i],
                          _back(pts[i], pts[i + 1], r), n)) p],
           [pts[len(pts) - 1]]);

function _plen(P, i = 0) =
    (i >= len(P) - 1) ? 0 : norm(P[i + 1] - P[i]) + _plen(P, i + 1);

// 🔒 終端を d だけ手前で止める。**当たり検査のために要る。**
//    線は行き先のコネクタに着くので、終点まで描くと必ず相手の部品と交差し、
//    それが「通り道の当たり」と見分けられなくなる（2026-08-17、実際に 37〜88mm3 が
//    そればかりで、本物の当たりが埋もれた）。
//    ⇒ 終端を止めておけば、**chk が 0 でなければ必ず本物**になる
function wire_trim_end(pts, d = 2.0) =
    let (n = len(pts))
    concat([for (i = [0 : n - 2]) pts[i]],
           [pts[n - 1] + _unit(pts[n - 2] - pts[n - 1]) * d]);

// ---- 外に出す ----
// 実長 [mm]。⚠ **これはコネクタ間の最短の実長。** 作るときは端末処理と
// 取り回しの余長（実務で 20〜30mm）を足すこと
function wire_len(pts, r = 5) = _plen(wire_round(pts, r));

// 束ねたときの太さ。n 本を丸く束ねると概ね √n 倍＋隙間
function bundle_d(n, d = 1.4) = d * sqrt(n) * 1.15;

// 線1本。pts を通る φd のチューブ
module wire(pts, d = 1.4, r = 5, seg = 8) {
    P = wire_round(pts, r, seg);
    for (i = [0 : len(P) - 2]) hull() {
        translate(P[i])     sphere(d = d, $fn = 10);
        translate(P[i + 1]) sphere(d = d, $fn = 10);
    }
}

// フラットケーブル（リボン）。丸束と同じ点列を、平たい断面で通す
// ⚠ 断面は**水平に寝ている前提**の近似。床の上を這う区間は正しいが、
//    立ち上がる区間では実物はねじれる。**見た目を比べる用**で、当たり検査には丸束を使う
// 🔒 リボンは薄い方向にはよく曲がるので、r は丸束より小さく取れる
module ribbon(pts, w, t = 1.3, r = 3, seg = 8) {
    P = wire_round(pts, r, seg);
    for (i = [0 : len(P) - 2]) hull() {
        translate(P[i])     translate([-w/2, -w/2, -t/2]) cube([w, w, t]);
        translate(P[i + 1]) translate([-w/2, -w/2, -t/2]) cube([w, w, t]);
    }
}
// n 芯のリボンの幅（1.27mm ピッチ ＋ 縁）
function ribbon_w(n) = n * 1.27 + 1.0;

// ============================================================
// ケーブルガイド（筐体側に生やす印刷部品）
// ============================================================
// 🔒 **開けて見せる機体なので、線が「決まった道を通っている」こと自体が見た目になる**
//    （2026-08-17・ユーザー「中身を開けて見せます」）。
//    詰め込んであるのか作り込んであるのかは、開けた瞬間の線の並びで決まる。
// 🔒 形は**上から押し込んで留まるクリップ**。ねじも結束バンドも要らない。
//    ⚠ サポート無しで刷れるようにしてある。張り出しは口の返し（lip）だけで、
//       そこは短いブリッジになるので垂れない。
// 🔒 基板配線の流儀（直角のみ・交差させない）を立体でやるための道具。
//    クリップは**曲がり角の手前と後ろ**に置く。角の真上に置くと線が逃げる。
//
//   原点は取り付け面の上・ケーブルの中心線。ケーブルは **+X 方向**へ通る
//   w … ケーブルの幅（フラットなら幅／丸束なら直径）
//   t … ケーブルの厚み（丸束なら直径と同じ）
module cable_clip(w, t, wall = 1.2, lip = 0.7, lip_h = 1.0, len = 4.0) {
    ow = w + wall * 2;
    oh = wall + t + lip_h;
    difference() {
        translate([-len / 2, -ow / 2, 0]) cube([len, ow, oh]);
        // 通り道
        translate([-len / 2 - 1, -w / 2, wall]) cube([len + 2, w, t]);
        // 押し込む口（返しのぶん狭い）
        translate([-len / 2 - 1, -(w / 2 - lip), wall + t])
            cube([len + 2, w - lip * 2, lip_h + 1]);
    }
}

// 束。n 本ぶんの太さで1本のチューブとして描く
// 🔒 個別に描かない。**束は1本の太い線として扱うほうが、当たり検査で嘘が出ない**
//    （個々の線は束の中で自由に入れ替わるので、位置を決めても意味が無い）
module bundle(pts, n, d = 1.4, r = 5, seg = 8) {
    wire(pts, d = bundle_d(n, d), r = max(r, bundle_d(n, d) * 2), seg = seg);
}
