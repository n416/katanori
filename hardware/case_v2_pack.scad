// 筐体 v2 の箱詰めスタディ ── **線を実体で置いて比べる**
//
//   openscad -D 'part="asm"'      hardware/case_v2_pack.scad   // 全体
//   openscad -D 'part="chk"'      hardware/case_v2_pack.scad   // 部品どうしの当たり
//   openscad -D 'part="chk_wire"' hardware/case_v2_pack.scad   // 線 ↔ 部品の当たり
//   openscad -D 'part="chk_out"'  hardware/case_v2_pack.scad   // 箱からはみ出した線
//
// ============================================================
// 🔒 v1 と何を変えるのか
// ============================================================
// v1 は**立てたハブ基板が箱を前後に分断する壁**になっていた（X 6〜80 / Z 1〜53）。
// 板の縁から出る口は上下左右とも壁まで 1mm しかなく、**10口すべてが逃げの 25mm を
// 箱の外に要求した**（case_v1.scad の 🔴・17,844mm3）。
//
// ⇒ v2 の仮説: **ハブ基板を床に寝かせる。** 口は真上を向き、逃げは箱の高さで取る。
//    壁が無くなるので「板の向こう側」も消える。電池と PowerBoost は板の上の棚へ移す。
//
// 🔒 これは仮説であって決定ではない。**この文書の役目は、寝かせた案が本当に
//    成立するかを線ごと確かめること。** 成立しなければ奥行きを伸ばす案に戻る。
//
// ---- ✅ 一次判定（2026-08-17・箱は v1 と同じ 86 × 80 × 54.7）----
//   ・**箱からはみ出した線 0mm3**（v1 は 17,844mm3）。`part="chk_out"` が空
//   ・口を立てても頭は Z 29.1 で、つまみの座の下端 Z 35.0 まで **5.9mm 空く**
//   ・背面の帯 Y 68〜80（12mm）に 電池5・PowerBoost10・INA226 11.6 が立つ
//   ・線 ↔ 部品の当たり **0.1mm3**（`part="chk_wire"`）。✅ 終端を相手の 4mm 手前で
//     止めるようにしたので、**残るのはハウジングの頭に接している面だけ**（体積ゼロ）。
//     🔒 これで「0 でなければ本物の当たり」と読めるようになった
// 🔴 **奥行きを伸ばさずに済んだ。** v1 で足りなかった 25mm は、板を寝かせて
//    「箱の高さ」から取ったことで解決している。壁が無くなったので回り込みも消えた。
//
// ---- 🔴 OLED の口は**2か所とも、まっすぐ後ろへは生やせない**（2026-08-17）----
// ✅ ユーザーが図で2か所を確定: **中央最上部（横向き）** と **左辺の中ほど（縦向き）**。
// 両方を `part="chk_oled"` に掛けたところ、**どちらもぶつかった**:
//   ・中央最上部（Z 51.4）… ReSpeaker は越えるが**つまみの座を貫く 61.8mm3**
//   ・左辺（Z 27 付近）  … つまみは避けるが**ReSpeaker を貫く 78.4mm3**
//     （高さを振ると Z22→133.5 / Z27→78.4 / Z32→60.9 / Z40→5.1 mm3）
//
// 🔴 **原因は同じ1つ。OLED の裏（Y 8.5）と ReSpeaker の前面（Y 12.275）のすき間が
//    3.775mm しかなく、その上は つまみの座が引き取っている。**
//    まっすぐ後ろへ 25mm 取れる場所は、このパネルの裏には**どこにも無い**。
//
// ⇒ 🔒 **口はライトアングルにして、線をこの 3.775mm の前スラブの中で引き回す。**
//    スラブ（X 0〜86 / Y 8.5〜12.275 / Z 3〜51）は板の前面いっぱいに空いている。
//    そこから後ろへ抜けられる窓は **X 0〜40 / Z 36〜50**（ReSpeaker の頭より上、
//    つまみの座 X 40〜 より左、スピーカー Z 50.5〜 より下）。
//    ⭐ **左辺の口が有利。** X 8 にあるので、スラブを 13mm 上がるだけで窓に届く。
//    ⬜ ライトアングルのヘッダ（または FPC）を現物に付けられるかは要確認。
//
// ---- ⚠ この案で新しく制約になったこと ----
// **ReSpeaker が壁になる。** 立てた板（Y 12.3〜14.1・Z 2〜36・X 2〜84）がハブと OLED の
// 間を塞ぐので、**OLED の4本だけは板の頭（Z 36以上）を越えるしかない。**
// しかも つまみの座（X 40〜84・Z 35〜）があるので、越えられるのは **X 40 より左**だけ。
// ⇒ 🔒 筐体側に「OLED の線が越える道」を X 32〜40 / Z 36〜50 に確保すること。
//
// ============================================================
// ⚠ この文書は当て板である。刷る物ではない
// ============================================================
// 肉も逃げもねじも無い。**部品と線が入るかどうかだけ**を見る。
// 数字は parts.scad / respeaker_lite.scad / hub_board.scad / knob_v4.scad から呼ぶ。

part = "asm";
$fn  = 32;

use <parts.scad>
use <respeaker_lite.scad>
HUB_EMBEDDED = true;
use <hub_board.scad>
use <knob_v4.scad>
use <wires.scad>
include <hub_board_parts.scad>

// ============================================================
// 1. 箱（内寸）
// ============================================================
// 🔒 X と Z は v1 から動かせない。X は ReSpeaker(82.024)＋左右2mm、
//    Z は OLED(48.1) と つまみの深さ で決まっている
IN_X = 86.0;
IN_Y = 80.0;    // ⬜ ここが動くかどうかがこのスタディの答え
IN_Z = 54.707;

// ============================================================
// 2. 動かせないもの（v1 から引き継ぐ）
// ============================================================
OLED_Y1   = 8.5;                       // OLED の裏面
RSP_Y     = OLED_Y1 + 2.5;             // マイクの先端
RSP_BD_Y0 = RSP_Y + 1.275;             // 12.275 基板の前面
RSP_BD_Y1 = RSP_BD_Y0 + respeaker_T(); // 14.125 基板の背面
RSP_X = 2.0;  RSP_Z = 2.0;
RSP_TOP = RSP_Z + respeaker_H();       // 36.007

OLED_L = 70.1; OLED_W = 48.1;
OLED_X0 = RSP_X + (respeaker_L() - OLED_L) / 2;
OLED_Z0 = (IN_Z - OLED_W) / 2;

// つまみ: 🔒 前へは動かせない。OLED が正面いっぱいを占めていて、その裏に
//    AS5600 のコネクタの逃げ 1.4mm が要るため、Y0 はこれが最小
KNOB_Y0 = RSP_BD_Y1 + 1.4;             // 15.525
KNOB_Y1 = KNOB_Y0 + knob_bay_y();      // 43.525
KNOB_AT = [IN_X - knob_bay_x() / 2 - 2, KNOB_Y0 + knob_bay_y() / 2, IN_Z];

// ============================================================
// 3. 仮説: ハブ基板を床に寝かせる
// ============================================================
// 半田面を下にして、スタンドオフで浮かせる
HUB_STANDOFF = 2.5;
// ⚠ Y16 が前の限界。ReSpeaker の基板の背面が Y 14.125 にあり、その足の逃げに 2mm 要る
HUB_AT = [6, 16, HUB_STANDOFF];        // 板の下面。74 × 52 が X 6〜80 / Y 16〜68
HUB_TOP = HUB_AT[2] + HUB_T + hub_top(false);   // 部品の頭（口は立てる＝25mm）

// 🔒 電源系は棚に載せない。**背面の壁に立てたまま**にする（v1 と同じ）。
//    一度これを板の上の棚（Z 42）へ移したが、PowerBoost の頭が天井を 3mm 突き抜けた。
//    ⇒ ハブを床に寝かせても、背面の Y 68〜80 の帯は空いたままなので、そこへ戻す。
//    ⭐ これで「板の向こう側」という概念自体が消える。板は床なので回り込む必要が無い
BACK_Y = 68.0;

// ---- OLED のインターフェイス（✅ 2026-08-17 ユーザー:「中央最上部にある」）----
// 📄 parts.scad にも「インターフェイスは**上辺と左辺**にある」と記録がある。
// 🔒 背面には何も無いので、ヘッダは上辺に立てて**後ろ（+Y）へ寝かせる**か上へ出す。
//    ここでは後ろ向きに寝かせた場合を置く（上へ出すと天井まで 3.3mm しかない）
// ✅ 2026-08-17「左辺にも口ありますね」（ユーザー）→ 左辺を使う
OLED_CONN = "left";                   // "top"（中央最上部）/ "left"（左辺）
OLED_CW   = 4 * 2.54;                 // 10.16 4ピン
// 🔴 **後ろ向きに生える口が使える帯は、思ったより狭い。**
//    OLED の裏 Y 8.5 と ReSpeaker の前面 Y 12.275 のすき間は **3.775mm しかない。**
//    ⇒ 口は **ReSpeaker の頭（Z 36）より上**でなければ、生えた瞬間に板に当たる。
//    上は スピーカー（X 8.5〜31.5 / Y 9.5〜24.5 / Z 50.5〜）で塞がる。
//    ⇒ 🔒 **左辺で後ろ向きに使える帯は Z 36〜50.5 の 14.5mm だけ。**
//    ⬜ 現物の左辺の口が**この帯に入っているか**を確認すること。
//       入っていなければ、①ライトアングルで左（-X）へ出して X 0〜8 の
//       すき間（幅8 × 奥行3.8mm）へ落とす ②OLED を前へ出して隙間を作る、のどちらか
// ✅ 2026-08-17 ユーザーの図で2か所を確定:
//    top  … パネルの**中央最上部**・**横向き**（ピンが横に並ぶ）
//    left … パネルの**左辺・上下の中ほど**・**縦向き**（ピンが縦に並ぶ）
OLED_CONN_Z = 27.0;                   // ⬜ 左の口の高さ（図から読んだ中ほど・±5）
OLED_CX  = (OLED_CONN == "top") ? OLED_X0 + OLED_L / 2 : OLED_X0 + 1.5;
OLED_CZ  = (OLED_CONN == "top") ? OLED_Z0 + OLED_W     : OLED_CONN_Z;
// 口の footprint。top は横に 10.16、left は縦に 10.16
module oled_conn(mating = false) {
    d  = mating ? 25 : 8.5;   // 🔒 mating は「ハウジング＋線が曲がり切るまで」
    wx = (OLED_CONN == "top") ? OLED_CW : 2.54;
    wz = (OLED_CONN == "top") ? 2.54    : OLED_CW;
    translate([OLED_CX - wx / 2, OLED_Y1, OLED_CZ - wz / 2]) cube([wx, d, wz]);
}

// ============================================================
// 4. 置く
// ============================================================
module parts_v2() {
    // --- 正面: ReSpeaker（立てる・マイクが -Y）---
    translate([RSP_X + respeaker_L(), RSP_BD_Y1, RSP_Z]) rotate([0, 0, 180])
        respeaker_lite();
    // --- 正面: OLED ---
    translate([OLED_X0, OLED_Y1, OLED_Z0]) rotate([90, 0, 0]) oled_242();
    color("#c93") oled_conn();
    // --- 床: ハブ基板（寝かせる。部品面が上・口は立てる）---
    translate(HUB_AT) hub_board(false);
    // --- 天面: つまみ ---
    translate(KNOB_AT) assembly(show_deck = false);
    // --- 天面: スピーカー（前寄り左・上向き）---
    // ⚠ 振動板がケーシングより 0.2mm 高いので、そのぶん下げて天井と面一にする
    translate([8.5, 9.5, IN_Z - spk_th() - 0.2]) speaker_112495();
    // --- 背面の壁（✅ 2026-08-17 ユーザー:「バッテリーチャージャーとバッテリーの位置を
    //     入れ替えた方が配線しやすそう」→ そのとおりだったので入れ替えた）---
    // 🔒 決め手は口の位置。ハブの `PWR` の口は板の**左後ろ**（箱の X 18.9）にある。
    //    PowerBoost を右に置くと、**いちばん電流の大きい 5V/GND が箱を横断する。**
    //    入れ替えると PowerBoost が口の真後ろに来て、渡りが 60mm → 10mm 台になる。
    //    ⚠ 電池は 54mm 幅で場所を選べないが、電池線は INA226 との間で完結するので、
    //       電池の位置は「INA226 の近く」でだけ決めればよい
    // PowerBoost（立てる・縦長）… 左へ
    translate([3 + 22.86, IN_Y - 1.6, 4]) rotate([90, 0, 0]) rotate([0, 0, 90])
        powerboost_1000c();
    // 電池 … 右へ
    translate([29, IN_Y, 2]) rotate([90, 0, 0]) lipo_1000mah();
    // INA226 … 🔴 **背面の壁には立たない**（2026-08-17・chk_fit が捕まえた）。
    //    電池の頭 Z 36 から天井 54.7 まで 18.7mm しかないのに、板は 20.1mm ある。
    //    ⇒ **天板の裏へ寝かせる。** つまみの座は Y 43.5 で終わるので、その後ろの
    //    X 0〜86 / Y 44〜68 / Z 29〜54.7 は丸ごと空いている（ハブの口の逃げの上）。
    //    ⚠ X 48 より右に置くこと。左はトグルの胴（X 33.5〜46.5・Z 41〜53）が入ってくる。
    //    ⭐ ネジ端子が上を向くので、被せる前に真上からドライバが入る
    // 🔴 **留める先は天板ではなく下シェル**（2026-08-17・「中身を開けて見せます」を受けて）。
    //    天板に付けると、電池→INA→PowerBoost の**太い電池線4本が上下の分割をまたぐ**。
    //    開けるたびにいちばん電流の大きい線が引っ張られる。
    //    ⇒ 位置はこのままで、**床かハブ基板から柱を立てて受ける。**
    //    これで電源系は全部下側にまとまり、またぐのは細い信号線だけになる
    //    （スピーカー・会話ボタン・つまみの AS5600 とリード）。
    // ⬜ またぐ線には**余長（サービスループ）が要る。** 開いた状態で届く長さで作ること
    translate([48, 46, 40]) ina226_module();
    // --- 背面: トグル（尻尾）---
    translate([40, IN_Y, 47]) rotate([-90, 0, 0]) mts102(25);
}

// ============================================================
// 5. 線（実体）
// ============================================================
// 🔒 口の座標は hub_board_parts.scad の HUB_HEADERS から引く。数字を書かない
function port_at(id) =
    [for (h = HUB_HEADERS) if (h[0] == id)
        [HUB_AT[0] + (h[4] + h[6]) / 2,
         HUB_AT[1] + (h[5] + h[7]) / 2,
         HUB_AT[2] + HUB_T]][0];
function port_n(id) = [for (h = HUB_HEADERS) if (h[0] == id) h[3]][0];

// 🔒 線は**ハウジングの頭から**描く。ヘッダの根元から描くとハウジングを突き抜けて、
//    当たり検査に嘘の当たりが出る（2026-08-17、実際に 400mm3 ぶん出た）
HOUS_H = 10.0;   // ⚠ DuPont ハウジングの高さ（未実測）
function port_out(id) = port_at(id) + [0, 0, HOUS_H];

// 🔒 終端は相手のコネクタの 2mm 手前で止める（wires.scad の wire_trim_end）。
//    そうしないと chk_wire が「着いているぶん」で埋まって、本物の当たりが見えない
// 見た目の比較用。"round"（DuPontの丸束）/ "flat"（フラットケーブル）
WIRE_STYLE = "round";
module harness(id, dest, mid = [], n = undef) {
    p = concat([port_out(id)], mid, [dest]);
    nn = is_undef(n) ? port_n(id) : n;
    if (WIRE_STYLE == "flat") ribbon(wire_trim_end(p, 4.0), ribbon_w(nn));
    else
    // ⚠ 止める量は**束の半径ぶん要る**。2mm だと束の太さ（φ3.2〜4.3）が相手に触れて、
    //    まだ 12mm3 残った。4mm でほぼ消える
    bundle(wire_trim_end(p, 4.0), nn);
}

// ✅ XIAO のパッド列（respeaker_lite.scad の HDR_X0/X1/HDR_Z から。数字を書かない）
//   案の座標: X 64.024〜82.024 ／ Y 14.125〜24.125 ／ Z 9〜11 と 27〜29
XIAO_HDR_X  = (84.024 - 2.0 + 84.024 - 20.0) / 2;      // 73.024 列の中央
XIAO_HDR_Y  = RSP_BD_Y1 + 10.0;                        // 24.125 ソケットの頭
XIAO_HDR_ZL =  2.0 +  8.0;                             // 10  下段
XIAO_HDR_ZH =  2.0 + 34.007 - 8.0;                     // 28  上段

module wires_v2() {
    color("#8e44ad", 0.9) {
        // 🔴 XIAO の7本は**1か所に落ちない**（2026-08-17 ユーザー指摘・図で2か所を明示）。
        //    XIAO はパッドが**両側2列**で、ソケットも2列（respeaker_lite.scad の HDR_Z）。
        //    信号で割ると `D2 / D3 / SDA(D4) / SCL(D5)` が片側、`3V3 / GND / 5V` が反対側なので、
        //    **4本 ＋ 3本 に分かれて、Z 10 と Z 28 の別々の列へ着く。**
        //    ⚠ 一度これを 7本の束1組として1点へ落としていた。**束の本数だけ合っていて、
        //       行き先の数が合っていなかった。**
        //    ⬜ どちらの列が上でどちらが下かは XIAO の挿す向きで決まる。実物で確認する
        harness("XIAO", [XIAO_HDR_X, XIAO_HDR_Y, XIAO_HDR_ZH],
                [[52, 30, 22], [XIAO_HDR_X + 3, 31, XIAO_HDR_ZH]], n = 4);
        harness("XIAO", [XIAO_HDR_X, XIAO_HDR_Y, XIAO_HDR_ZL],
                [[54, 26, 15], [XIAO_HDR_X + 3, 29, XIAO_HDR_ZL]], n = 3);
        // OLED 4本 → OLED の裏
        // 🔴 **ReSpeaker を越えるのはこの束だけ。** 板（Y 12.3〜14.1・Z 2〜36・X 2〜84）が
        //    ハブと OLED の間を塞いでいるので、**頭の上（Z 36以上）を通すしかない。**
        //    ⚠ つまみの座（X 40〜84・Z 35〜）を避けるため、越える場所は X 40 より左に限られる
        harness("OLED", [OLED_CX, OLED_Y1 + 12, OLED_CZ], [[36, 30, 20], [22, 26, 42]]);
        // AS5600 4本 → つまみの座の中
        harness("AS5600", [62, 30, IN_Z - 20], [[76, 30, 30]]);
        // INA226 4本 → 天板の裏。口（X 51.9 / Y 64.9）のほぼ真上なので、立ち上げるだけ
        harness("INA", [55, 60, 41], [[52, 63, 32]]);
        // リード 2本 → つまみの脇
        harness("REED", [58, 30, IN_Z - 18], [[58, 34, 26]]);
        // PowerBoost 4本 → 背面の壁。⭐ 入れ替えで口の真後ろになった
        harness("PWR", [16, 70, 20], [[19, 61, 22]]);
        // トグル 2本 → 背面
        harness("TOGGLE", [40, IN_Y - 6, 44]);
        // 会話ボタン 2本 → 天面
        // 🔴 **口が板の右端（列27・箱の X 76）にあるのに、ボタンは天面の左（X 20）。**
        //    箱を横断する 56mm の渡りになり、しかも途中につまみの座（X 40〜84・Z 35〜）が
        //    あるので、**座の下（Z 25）をくぐってから左で立ち上がる**しかない。
        //    ⚠ 一度これを素直に斜めへ引いて、座を 21.9mm3 貫いた（chk_wire が捕まえた）。
        //    ⬜ 口を板の**左側**へ移せばこの横断は消える。列27 に置いたのは、既に来ている
        //       GND とボタンの信号から素直に引けるからで、行き先は見ていなかった
        harness("BTN2", [20, 36.5, IN_Z - 8], [[74, 42, 25], [34, 42, 25], [22, 39, 44]]);
        // 音声 IN 2本 → ReSpeaker のスピーカー口
        harness("PHIN", [20, 16, 24], [[10, 30, 26]]);
        // 音声 OUT 2本 → スピーカー（天面の裏）
        harness("PHOUT", [16, 17, IN_Z - 6], [[8, 30, 34]]);
    }
}

// ============================================================
// 5.5 ケーブルガイド
// ============================================================
// 🔒 開けて見せる機体なので、**線が決まった道を通っていること自体が見た目になる**。
//    ⚠ ここに置いてあるのは**位置の提案**で、実際は下シェル／天板の裏から生やす。
//    クリップは曲がり角の**手前と後ろ**に置く（角の真上に置くと線が逃げる）。
// ⬜ 幅と厚みは、フラットケーブルにするかDuPontの束のままかで変わる。
//    いまは 4本束（φ3.2）を丸のまま通す想定で置いてある。**現物の実測で入れ替える。**
GUIDE_W = 4.0;   // ⬜ ケーブルの幅
GUIDE_T = 3.4;   // ⬜ ケーブルの厚み
module guides() {
    color("#7f8c8d")
    // [x, y, z, 通る向き(度・Z軸まわり)]
    for (g = [[30, 61, HUB_TOP - 15, 0],     // 電源系が板の後ろを横へ走る帯
              [44, 61, HUB_TOP - 15, 0],
              [36, 30, 20, 90],              // OLED/ボタンが前へ抜ける角の手前
              [34, 20, 30, 90],              // 同・角の後ろ（立ち上がり）
              [60, 30, 22, 0]])              // AS5600・リードがつまみへ上がる手前
        translate([g[0], g[1], g[2]]) rotate([0, 0, g[3]])
            cable_clip(GUIDE_W, GUIDE_T);
}

// ============================================================
// 6. 出力
// ============================================================
module inner() { cube([IN_X, IN_Y, IN_Z]); }

if      (part == "asm")      { parts_v2(); wires_v2(); guides(); }
else if (part == "guides")     guides();
// ガイドが部品に当たっていないか
else if (part == "chk_guide")  intersection() { guides(); parts_v2(); }
else if (part == "parts")      parts_v2();
else if (part == "wires")      wires_v2();
// 🔴 部品が箱からはみ出していないか。2026-08-17 に追加。線の検査（chk_out）は
//    線しか見ないので、**INA226 が天井を 3.4mm 突き抜けていたのを誰も捕まえられなかった。**
//    🔒 線を検査するなら、部品も同じ検査に掛けること。
// ---- 🔒 ここに出るのが正常なもの（外へ出るのが役目の部品）----
//    ・約 2,879mm3（X 49〜75 / Y 17〜42 / Z 54.7〜60.7）… つまみの握り。天面から 6mm 出る
//    ・約   191mm3（X 37〜43 / Y 80〜93 / Z 44〜54）  … 尻尾（トグルのレバー）。背面から出る
//    ・約    30mm3（X 86〜87 / Y 14〜17 / Z 16〜25）  … XIAO の USB-C。右の壁に口が要る
//    **これ以外が出たら、その部品は箱に入っていない。**
else if (part == "chk_fit")    difference()   { parts_v2(); inner(); }
// 🔴 OLED の口（＋線が曲がる 25mm）が他の部品に刺さっていないか。
//    ⚠ つまみの座だけでなく **ReSpeaker とスピーカー**も見る（左辺はそちらが効く）
else if (part == "chk_oled") intersection() {
    oled_conn(mating = true);
    union() {
        translate(KNOB_AT) assembly(show_deck = false);
        translate([RSP_X + respeaker_L(), RSP_BD_Y1, RSP_Z]) rotate([0, 0, 180])
            respeaker_lite();
        translate([8.5, 9.5, IN_Z - spk_th() - 0.2]) speaker_112495();
    }
}
// 線 ↔ 部品。🔒 **これが空でなければ、その線は通らない**
else if (part == "chk_wire")   intersection() { wires_v2(); parts_v2(); }
// 箱からはみ出した線
else if (part == "chk_out")    difference()   { wires_v2(); inner(); }
else                         { parts_v2(); wires_v2(); }

echo(str("箱 ", IN_X, " x ", IN_Y, " x ", IN_Z, " = ", IN_X * IN_Y * IN_Z / 1000, " cm3"));
echo(str("ハブ: 床から ", HUB_AT[2], " / 板の上の部品の頭 ",
         HUB_AT[2] + HUB_T + hub_top(true),
         " / 口を立てたときの頭 ", HUB_TOP, "（天井 ", IN_Z, "）"));
echo(str("つまみの座 Y ", KNOB_Y0, "〜", KNOB_Y1,
         " / 座の下端 Z ", IN_Z - knob_deep()));
echo(str("ハブ Y ", HUB_AT[1], "〜", HUB_AT[1] + HUB_W,
         " ／ 背面の帯 Y ", HUB_AT[1] + HUB_W, "〜", IN_Y,
         " = ", IN_Y - (HUB_AT[1] + HUB_W), "mm（電池5・PB10・INA11.6 が立つ）"));
echo(str("口の逃げの頭 Z ", HUB_TOP, " ↔ つまみの座の下端 Z ", IN_Z - knob_deep(),
         " → すき間 ", IN_Z - knob_deep() - HUB_TOP, "mm"));
