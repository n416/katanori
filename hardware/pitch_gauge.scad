// ピッチゲージ ── AS5600 の取付穴の対角に、φ3.5 の棒 2 本が入る番号を 1 つ見つける
// ============================================================
// 🔒 これは「測る」道具ではない。**入る番号を 1 つ見つける**道具。
//   入る条件は 1 本の式だけ:  |基板の対角 − 棒の間隔| ≤ 穴の径 − 棒の径
//   ゲージの棒も、つまみの柱も φ3.5 なので**右辺が同じ**。
//   ⇒ **入った番号を knob_v5.scad の HOLE_PITCH にそのまま書き写す。** 真の値は要らない。
//
// 🔒 柱 φ3.5 は動かせない。E リング 呼び3 の溝径が φ3.0（ERING3_GRV_D）で、φ3.5 の棒に
//   片側 0.25mm 彫って成立している。棒を φ3.3 にすれば 0.15、φ3.2 なら 0.10 しか残らず、
//   リングが掴めない。**「柱を細くすれば測定精度が要らなくなる」は成り立たない**
//   （2026-08-28、私はこれを knob_v5.scad を開かずに提案した。🔴 決まっている物を数えない）。
//
// 🔴 ここまでの回り道（同じ穴に落ちないための記録）:
//   ① 棒を φ3.0 にした。「φ3.5 は遊びが 0 で入らないかも」という**道具が失敗する恐れ**から。
//      だが上の式のとおり、右辺 ＝ 穴 − 棒 が**そのまま読みの幅**になる。φ3.0 では ±0.5。
//      刻み 0.2 と突き合わせずに刷らせた（ユーザー実測: 9 本中 7 本が入り、上の境界が出なかった）。
//   ② 4 本立ての駒を作った。ユーザーが決めた「対角だけでいい」を断りなく戻したうえ、
//      樹脂が倍（あの 7 枚で 15.6cm³）。
//   ③ 「±0.05 で合っていないと挿さらない」と、結果が出る前に書いた。あれは 4 本とも φ3.5 に
//      した私の作図の帰結で、物理の制約ではない。
//
// ✅ ここまでに出ている値:
//   ・φ3.0 版の実測（ユーザー 2026-08-28）: 152/154 入らず・156〜168 入る・160 が一番ゆるい
//     ⇒ ピッチ 16.0 / 対角 22.63（⚠ ±0.1）
//   ・写真（_as5600_pitch.py）: 穴の径 3.55 を物差しに 15.81 ／ 外形 23.0 を物差しに 16.18
//   ⇒ この棒は 15.90 〜 16.20 を 0.05 刻みで刻む（16.0 の両側に 0.1）。
//
// ------------------------------------------------------------
// 使い方
// ------------------------------------------------------------
//   ① 基板の **チップ（黒い四角）のある面を下**にして、**対角の 2 つの穴**を棒に載せる。
//      下へ出るのはピンの先だけで、基板は座（高さ 4mm）に乗るから、ピンの先は棒に当たらない。
//   ② 入る番号を探す。番号 1600 ＝ ピッチ 16.00mm（棒の間隔はその 1.414 倍）。
//      棒 φ3.5 ／ 穴 φ3.5〜3.6 なので隙間は 0〜0.1 ＝ 読みの幅も 0〜0.1。
//      ✅ 2026-08-28 ユーザー実物「柱 1 本を挿したらかなり緩い。穴は実際は 3.6 くらい」
//      ⇒ 隙間は上限側（0.1）に近い ⇒ **入るのは 3 〜 5 本**。まん中が答え。
//   ③ 入った番号（複数なら全部）を教えてほしい。まん中を HOLE_PITCH に書き写して終わり。
//   ④ **1 本も入らなかったら報告してほしい。**その時は穴の並びが正方形でないか、
//      φ3.5 が 4 本では成立しない側の話になる（この棒は 2 本なので、そこまでは分からない）。
//
// ------------------------------------------------------------
// 刷り方
// ------------------------------------------------------------
//   7 本を伏せて **プレートに直置き**（棒が上）。サポートも傾けも要らない。外形と樹脂の量は下の echo。
//   実行: openscad --backend=manifold -o stl/pitch_gauge.stl hardware/pitch_gauge.scad
// ============================================================
$fn = 96;

P0    = 15.90;  // いちばん狭い棒（番号 1590）
PN    = 7;      // 本数（15.90 → 16.20）
PSTEP = 0.05;
GAP   = 3.0;

POST_D    = 3.5;    // 🔒 つまみの柱と同寸（knob_v5.scad の POST_D）。E リングの溝がこの径で成立している
POST_H    = 4.0;
TIP_H     = 0.5;    // 先の面取り（入れ始めが分かる。⚠ 判定に使わないので短い）
TIP_D     = 2.6;
NECK_H    = 0.4;    // 座と棒のあいだの逃げ（隅にたまる樹脂を判定に効かせない）
NECK_D    = 3.0;

SEAT_D    = 4.5;    // 基板を受ける座（ヘッダのピンに当たらない径・当たり検査済み）
SEAT_H    = 4.0;    // 下へ出るピンの先（⚠ 標準値 2.5）の逃げ

BAR_T     = 3.0;
RIM       = 3.0;    // 座の中心から板の縁まで（幅 6.0）
HANDLE    = 11.0;   // 取っ手（番号。基板の角 16.26mm より外へ出す）
CORNER    = 2.0;
TXT_SIZE  = 3.2;
TXT_H     = 0.6;

module post() {
    cylinder(d = SEAT_D, h = SEAT_H);
    translate([0, 0, SEAT_H])                 cylinder(d = NECK_D, h = NECK_H + 0.01);
    translate([0, 0, SEAT_H + NECK_H])        cylinder(d = POST_D, h = POST_H - TIP_H);
    translate([0, 0, SEAT_H + NECK_H + POST_H - TIP_H])
                                              cylinder(d1 = POST_D, d2 = TIP_D, h = TIP_H);
}

module bar(p) {
    d  = p * sqrt(2);
    x0 = -(d / 2 + RIM);
    x1 =   d / 2 + RIM + HANDLE;
    linear_extrude(BAR_T)
        offset(r = CORNER) offset(delta = -CORNER)
            translate([x0, -RIM]) square([x1 - x0, RIM * 2]);
    for (s = [-1, 1]) translate([s * d / 2, 0, BAR_T]) post();
    translate([x1 - HANDLE / 2 - 0.5, 0, BAR_T]) linear_extrude(TXT_H)
        text(str(round(p * 100)), size = TXT_SIZE, halign = "center", valign = "center");
}

PMAX = P0 + PSTEP * (PN - 1);
for (i = [0 : PN - 1]) translate([0, -(RIM * 2 + GAP) * i, 0]) bar(P0 + PSTEP * i);

echo(str("ピッチ ", P0, " 〜 ", PMAX, "mm を ", PSTEP, " 刻みで ", PN, " 本（棒の間隔 ",
         P0 * sqrt(2), " 〜 ", PMAX * sqrt(2), "）"));
echo(str("棒 φ", POST_D, " ＝ つまみの柱と同寸。穴 φ3.5〜3.6 ⇒ 隙間 ", 3.5 - POST_D, "〜",
         3.6 - POST_D, "mm ＝ 読みの幅（刻み ", PSTEP, " とほぼ同じ）"));
echo(str("外形 ", PMAX * sqrt(2) + RIM * 2 + HANDLE, " × ",
         (RIM * 2 + GAP) * (PN - 1) + RIM * 2, " × ", BAR_T + SEAT_H + NECK_H + POST_H, "mm"));
echo(str("1 本の接地 約 ", (PMAX * sqrt(2) + RIM * 2 + HANDLE) * RIM * 2,
         "mm2  ⇔ bridge.stl 513mm2"));
