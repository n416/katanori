TGL_FRONT   = HB_Y + HB_L;                 // 胴のレバー側の面 ＝ 板の上端 84.2。レバーはここから 3.0 張り出す
TGL_Z       = HB_Z + HB_T;                                            // 板の表面
TGL_TOP     = TGL_Z + TGL_LIFT + TGL_BODY[2];                         // 胴の上面（板の面から 4.0）
TGL_LEVER_Z = TGL_TOP - TGL_DROP - TGL_LEVER[2] / 2;                  // 📄 板の面から 3.05
TGL_PAD_C   = HB_Y + 76.2;                                            // 📄 パッドの列の中心（銅は ± 1.05）
TGL_SLOT    = [TGL_LEVER[0] + TGL_STROKE + 0.5, TGL_LEVER[2] + 0.5];   // レバーが動くスリット（X × Z）

