//     🔴 **前の殻と背面の蓋を同じプレートに載せると 57.3% ＝ +0.8〜1.2 で組めない。**
//   🔴 0.45 は帯の在庫。鍔を厚くする・歯幅を戻す・壁を厚くする話は全部ここから引く

// 🔒 2026-09-13 ユーザー決定: AS5600 は既製モジュールをやめ、**チップを中継基板に直接載せる**
//    （AS5600-ASOM・LCSC `C79815`・SOIC-8・Extended・$0.77）。モジュール・ソケット・線が全部消える
//    ⚠ I2C の引き上げは載せない（ReSpeaker Lite に 4.7kΩ・docs/KNOB-ENCODER.md 188 行）
// 🔴 2026-09-13: ここを [4.9, 3.9] と置いていて **X と Y が 90 度回っていた**（機構・回路が発見）。
//   📄 実物で数え直した: `gen_pcb.py` の U4 は (36.2, 7.0, **ang 0**)、足形は
//   `Package_SO:SOIC-8_3.9x4.9mm_P1.27mm`。KiCad の .kicad_mod のパッドを直接読むと
//   **X ±3.450（6.90・リードの張り出し）／ Y ±2.205（4.41・パッドの列）**。胴は X 3.9 × Y 4.9。
//   ⇒ 板の X がリード側・Y が胴の長さ。回路側の 7.40 × 5.40 は外形 6.90 × 4.90 に逃げ 0.25/片側
CHIP     = [3.90, 4.90, 1.75];       // 📄 胴（板の X が幅・Y が長さ）
CHIP_PAD = [7.40, 5.40];             // 📄 足跡（パッドと胴の外側 ＋ 逃げ 0.25/片側）。機構のブラケットの逃げはここから
CHIP_Z  = HB_Z + HB_T;               // 中継基板の表面
MAG_GAP = 1.0;                       // ⚠ AS5600 が許すのは 0.5〜3。1.0 に置いた
MAG_Z   = CHIP_Z + CHIP[2] + MAG_GAP;   // 磁石の下面

// ⚠ **ここは仮の図**（歯車は歯の無い円盤・ロータは棒と円柱）。実体は hardware/_v6_gear.scad が持つ。
//   ⚠ 円盤とロータの寸法はここでしか使っていないが、**機構が形を変えたらここは古くなる。**
//   置き場所（KN_C / IDLER / SENS / GZ / GEAR_W）と殻の物（idler_pin）は親が持つので、そちらは追従する
module gear_disc(c, pd) color("#9aa5b1")
    translate([c[0], c[1], GZ]) cylinder(d = pd + 2 * GEAR_M, h = GEAR_W);
module gear_train() {
    gear_disc(KN_C, GEAR_PD); gear_disc(IDLER, GEAR_PDI); gear_disc(SENS, GEAR_PD);
    idler_pin();   // 🔴 2026-09-13: ここに GZ − 0.1・φ3.0 直書きの軸を**もう 1 本**持っていた
                   //   （idler_pin() は 19.15・ID_PIN_D）。同じ物が 2 か所 ＝ 今日 5 回目。消して呼ぶだけにした
    color("#888") translate([SENS[0], SENS[1], MAG_Z + 2.0])         // 読み取りの軸
        cylinder(d = 4.0, h = GZ - MAG_Z - 2.0);
    color("#bbb") translate([SENS[0], SENS[1], MAG_Z]) cylinder(d = 4.0, h = 2.0);
    color("#2c2c2a") translate([SENS[0] - CHIP[0] / 2, SENS[1] - CHIP[1] / 2, CHIP_Z]) cube(CHIP);
}

// 🔒 2026-09-13: 中身は**1 つずつ名前を付ける**。機構スレッドが組み立てを写していて、
