HB_L = 81.2;   // 丈。上の縁 84.2 から充電の USB-C が 3.0 出て、天面の外側 88 の 0.8 奥で止まる
HB_X = (BODY_X - HB_W) / 2;
HB_Y = 3.0;    // 下の縁（内寸 2 に逃げ 1）
HB_T = 1.6;
