// 🔒 柱の表は 1 か所。柱・貫通穴・背面のザグリは全部ここから出す
//   🔴 2026-09-13: `posts()` を殻の union に入れていなかったので、**貫通穴が床に開いていなかった**。
//   柱だけが浮いた別の物として描かれていて、背面には穴が 1 つも無かった
POSTS = [
    // 🔴 2026-09-13: φ6.0 → φ5.0。**この 4 本だけ他より太かった**（他は全部 φ5.0）。
    //   左の 2 本の右面 8.30 が、電池の左の壁を作っていた。J10 の左端 38.55 との
    //   空きが **30.25**、電池は **30.00** ＝ 逃げが**合計 0.25**（片側 0.125）だった。
    //   φ5.0 にして右面 7.80 ⇒ 空き **30.75**（片側 0.375）。ザグリ φ4.0 に対して肉 0.5 は
    //   中継基板・ReSpeaker の柱と同じ（既にある取り決めに合わせただけで、新しい発案ではない）。
    [BODY_X / 2 - 18.70, OL_Y +  2.50, OL_Z, 5.0, 2.6],   // OLED（📄 穴 φ3.0・中心間 37.40 × 33.00）
    [BODY_X / 2 + 18.70, OL_Y +  2.50, OL_Z, 5.0, 2.6],
    [BODY_X / 2 - 18.70, OL_Y + 35.50, OL_Z, 5.0, 2.6],
    [BODY_X / 2 + 18.70, OL_Y + 35.50, OL_Z, 5.0, 2.6],
    [RS_X + 31.577, RS_Y +  2.492, RS_Z, 5.0, 2.2],       // ReSpeaker（📄 穴 φ2.20・対角 2 つ）
    [RS_X +  2.657, RS_Y + 60.202, RS_Z, 5.0, 2.2],
    // 🔴 2026-09-13: この 2 本は φ1.8（M2 のタッピング下穴）のままだった。
    //   貫通＋ナットに直した時点で通し穴 2.2 でなければ M2 が入らない
    [HB_X +  3.5, HB_Y +  3.5, HB_Z, 5.0, 2.2],           // 中継基板（🔒 37 × 66・M2）
    [HB_X + 40.5, HB_Y +  3.5, HB_Z, 5.0, 2.2],
    // 🔴 2026-09-13: 上の 2 本は Y 69.5 だった。OLED の柱まで芯間 **2.309** で、
    //   **通し穴どうしが 0.09 重なり、ザグリも頭もナットも並ばなかった**（ユーザーが発見）。
    //   🔒 回路が板の穴を Y 65.25 へ動かした（ca69416）⇒ 芯間 **6.55**（要る 6.31・余り 0.24）
    [HB_X +  3.5, HB_Y + 65.25, HB_Z, 5.0, 2.2],
    [HB_X + 40.5, HB_Y + 65.25, HB_Z, 5.0, 2.2],
];
module post_hole(q)  translate([q[0], q[1], -1]) cylinder(d = q[4], h = q[2] + 2);
module post_cb(q)    translate([q[0], q[1], -0.01]) cylinder(d = CB_D, h = CB_H + 0.01);
// 🔒 2026-09-13 機構の要求: `POSTS[4]`（ReSpeaker の右下の柱）は読み取りの芯 (38.2, 10) まで
//   **6.48** しかなく、φ5.0 のままだとロータの鍔（φ8.10）が座れない（掛かり 0.08）。
//   🔴 全高を細くすると 15mm の柱の肉が 0.9 になるので、**当たる帯だけ細くする**。
//   帯は Z 8.0〜16.0（ブラケットの筒 8.80〜15.10 とロータの鍔 15.10〜15.44 を含む）。
//   腰 φ4.2 ⇒ 肉 1.0・鍔まで 6.48 − 2.1 − 4.05 = **0.33**（要る 0.30）
// 腰は [柱の番号, 径, Z 下, Z 上]。🔒 2026-09-13:
//   ① POSTS[4] Z 8.0〜16.0 φ4.2 … ロータの鍔（機構）
//   ② POSTS[4] / POSTS[5] Z 3.0〜4.6 φ3.5 … **中継基板を通る帯**（回路: U4 のパッドを 0.14 削り、
//      板の下の縁を 0.29 欠いていた。φ3.5 なら +0.612 / +0.460。φ3.0 だと柱の肉が 0.4 になるので 3.5）
WAISTS = [[4, 4.2, 8.0, 16.0], [4, 3.5, 3.0, 4.6], [5, 3.5, 3.0, 4.6]];
module post_solid(q) translate([q[0], q[1], WALL]) cylinder(d = q[3], h = q[2] - WALL);
module post_waist() for (w = WAISTS)
    translate([POSTS[w[0]][0], POSTS[w[0]][1], w[2]]) difference() {
        cylinder(d = POSTS[w[0]][3] + 1, h = w[3] - w[2]);
        translate([0, 0, -1]) cylinder(d = w[1], h = w[3] - w[2] + 2);
    }
module post_solids() for (q = POSTS) post_solid(q);
module post_cuts()   { for (q = POSTS) { post_hole(q); post_cb(q); } post_waist(); }

// 🔒 2026-09-13: **背面のはんだの逃げ。**中継基板の足付き 30 点のはんだが裏へ出る
//   （足を切り詰めてもフィレットで 0.3〜0.5・ふつうに切ると **0.8〜1.5**。回路担当）。
//   いまの逃げは 1.0（背面の壁の内面 2.0 〜 中継基板 3.0）しかない。⇒ **群の真下だけ深さ 0.8 彫る。**
//   🔴 全面を薄くしない（背面は 4,224mm² の平らな面で、ザグリ φ4 が 10 か所ある。
//     壁 1.5 にするとザグリの下が 0.4 で実績の下限 0.42 を割る）。⇒ **当たる所だけ彫る**（今日 4 回目の形）
//   逃げの合計 ＝ 1.0（空気）＋ 0.8（彫り）＝ **1.8** ／ 残り肉 **1.2**
//   🔴 2026-09-13 訂正: 「ふつうに切った 1.5」は**私の仮定**だった。📄 の足は板の裏へ **1.8**
//     （全長 3.4 − 板厚 1.6）。⇒ **切らないなら 1.8 ちょうどで、余裕は 0.00。**
//   ⚠ はんだの盛りは足の先に**積み上がらない**（ランドの上の円錐 0.5〜0.8 で、足の先 1.8 のほうが高い）。
//     ⇒ 足し算しない。裏へ出る量は**足の先と盛りの頂点の大きいほう**。出どころ: 回路担当の見積り（📄 ではない）
//   ⇒ 裏 1.0 に切るなら R ＝ 1.0 前後（上振れを見て 1.2）。**切るのは、はんだ付けの前**
//     （付けた後に切るとニッパがランド φ1.7 を剥がす ── 回路担当）
//   ✅ ザグリ φ4 の 10 か所と平面で重なる群は **0 件**（数えた）
//   群は板の座標（箱は ＋2 / ＋3）。ランドの外へ 0.5 の余白
SLD_DEP = 0.8;
// 🔴 2026-09-13: 表を**板の座標の手写し**で持っていて、**9 行のうち 8 行が古かった**。
//   しかも J1・J14 は **1 行の中で X が板・Y が箱**という混ざり方をしていた（合っていたのは J5 だけ）。
//   ⇒ 🔒 **箱の座標に統一し、+2/+3 の足し算をやめる。**出どころは回路担当が板から機械で出した値
//     （コミット 95e7c06）。**手で写す運用そのものを畳んだ。**
SLD = [   // [x0, y0, x1, y1]（🔒 **箱の座標**・ランドの外接矩形）
    [10.55,  5.05, 12.25, 21.99],   // J1  XIAO の口（左の列）φ1.0 × 7
    [25.78,  5.05, 27.48, 21.99],   // J14 XIAO の口（右の列）φ1.0 × 7
    [15.40,  5.23, 22.60,  6.98],   // J6  リード＋会話ボタン
    [ 4.40, 15.62,  7.60, 17.38],   // J5  スピーカー OUT
    [40.40, 27.78, 43.60, 29.53],   // J10 電池
    [42.88, 45.70, 44.62, 52.90],   // J2  OLED
    [33.90, 75.03, 37.10, 76.78],   // J4  スピーカー IN
    [34.68, 79.37, 35.68, 81.47],   // J13 充電 USB-C のシェル（左）
    [43.32, 79.37, 44.32, 81.47],   // J13 同（右）
];
// ⚠ J13 には無メッキの位置決め穴が 2 つある（箱 [36.28, 80.62, 42.72, 81.28]）。
//   **銅ではないので彫らない**が、板を貫くので当たり検査では覚えておく。
module solder_relief() for (g = SLD)
    translate([g[0] - 0.5, g[1] - 0.5, WALL - SLD_DEP])
        cube([g[2] - g[0] + 1.0, g[3] - g[1] + 1.0, SLD_DEP + 0.01]);

module posts() color("#6e7276") difference() { post_solids(); post_cuts(); }

// 🔴 2026-09-13（私の当たり・2 段構え）: 柱と中継の軸を `cavity()` を引く**前**の union に入れていた。
//   cavity は箱の中身そのものなので、**柱も軸も丸ごと消えていた**（背面の穴だけが残って、絵では
//   「開いている」ように見えた）。⇒ **彫った後で足す**。機構担当の shell_mech が先にそうしていた
module shell_shell() difference() {
    union() { body(); spk_pod(); at_spk() spk_station_add(); }
    cavity(); scr_pocket(); glass_relief(); aa_window(); knob_bore_front(); knob_stop_groove();
    reed_seat(); side_cuts(); jack_hole(); top_mics(); bottom_ports(); at_spk() spk_station_cut();
    rsp_btn_relief(); post_cuts(); solder_relief();
}
module shell_stand() difference() { union() { post_solids(); idler_pin(); bat_fence(); } post_cuts(); }
module shell_solid() { shell_shell(); shell_stand(); }
module front_shell() color("#55585c") intersection() {
    shell_solid();
    translate([-5, -5, SPLIT_Z]) cube([BODY_X + 10, BODY_Y + 10, BODY_Z]);
}
module back_cover() color("#404347") intersection() {
    shell_solid();
    translate([-5, -5, -5]) cube([BODY_X + 10, BODY_Y + 10, SPLIT_Z + 5]);
}

if (part == "inside")  { posts(); guts(); }   // 🔒 ユーザー 2026-09-13「inside は皮不要」
if (part == "cut")     intersection() {
    union() { front_shell(); back_cover(); posts(); guts(); }
    translate([-5, -5, -5]) cube([BODY_X / 2 + 5, BODY_Y + 10, BODY_Z + 10]);
}
if (part == "explode") {
    translate([0, 0, 30]) front_shell();
    translate([0, 0, -30]) back_cover();
    posts(); guts();
}
