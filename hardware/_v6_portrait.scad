    translate([0, 0, KN_OUT - KN_SINK])
        cylinder(d1 = KN_OD - 6.0, d2 = KN_OD - 1.5, h = KN_SINK + 0.01);
    translate([0, 0, -1]) cylinder(d = KN_ID, h = KN_OUT + 3);
}

module side_parts() {
    color("#e2622a") translate([BTN_OUT, BTN_Y, BODY_Z / 2]) rotate([0, -90, 0])
        linear_extrude(BTN_OUT + 1.2) rr(BTN_W, BTN_H, 2.2);
}

