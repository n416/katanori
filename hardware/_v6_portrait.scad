// 🔒 2026-09-13: 電池の押さえ。**位置だけ決めて、厚み方向は遊ばせる。**
//   🔴 リポは充放電で膨らむので、上から押さえると膨らむ先が無くなる。
//   ⇒ 柵は電池と同じ高さ（Z 8.6〜13.6）までしか立てない。天井は作らない。
//   ⚠ 柵は殻の持ち物（背面の壁と柱から生やす）。中継基板には触らない（板は Z 3.0〜4.6・
//     部品の天面 8.6 なので、Z 8.6 から上は空いている）。
//   ⚠ 電池が動ける量: いま −Y に 0.09（XIAO のソケット）・+Y に 7.07（J1 の胴）・
//     +X に 1.20（柱）・−X に 0.20（柱）。**止めたいのは +Y の 7.07。**
BAT_CL   = 0.3;    // 電池との隙間（片側）
BAT_FW   = 0.8;    // 柵の肉
BAT_FTOP = BAT_Z + BT[2];          // 13.6 柵の天面 ＝ 電池の天面（それ以上は立てない）
module bat_fence() color("#6e7276") {
    x0 = BAT_X - BAT_CL; x1 = BAT_X + BT[0] + BAT_CL;
    y0 = BAT_Y - BAT_CL; y1 = BAT_Y + BT[1] + BAT_CL;
    // ① +Y の壁（いちばん効く）。左の壁から ReSpeaker の柱を通って X 38.8 まで
    // ⚠ 左の壁からではなく**電池の左端から**。壁まで伸ばすとハブの柱 (5.5, 68.25) に当たる
    translate([x0 - BAT_FW, y1, BAT_Z]) cube([x1 - x0 + BAT_FW, BAT_FW, BAT_FTOP - BAT_Z]);
    // ② −X の壁を 2 か所、左の壁と繋いで支える
    for (y = [BAT_Y + 4, BAT_Y + BT[1] - 10])
        translate([WALL, y, BAT_Z]) cube([x0 - WALL, 6.0, BAT_FTOP - BAT_Z]);
    translate([x0 - BAT_FW, y0, BAT_Z]) cube([BAT_FW, y1 - y0, BAT_FTOP - BAT_Z]);
    // ③ +X は OLED の柱（42.7, 41.8）から短い腕で受ける
    //   ⚠ **この柱は 2026-09-13 に「4 本残る」と確定した物**（前の殻から支える案・共締め案が
    //     どちらも没になった）。🔴 **次に柱を減らす話が出たら、この柵も一緒に倒れる。**
    //   ⚠ 柱の**芯**まで伸ばす。外周（39.7）で止めると 1 本の線でしか触れず、腕が浮く
    translate([x1, BAT_Y + BT[1] / 2 - 4, BAT_Z]) cube([POSTS[1][0] - x1, 8.0, BAT_FTOP - BAT_Z]);
}
