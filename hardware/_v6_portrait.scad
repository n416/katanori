    [36.55, 23.80, 43.45, 32.40, 4.80, "J10 電池 PH 📄"],
    [35.00, 40.85, 43.60, 51.75, J2_H, "J2 OLED PH4 📄"],
    [30.05, 66.15, 36.95, 74.75, 4.80, "J4 スピーカー IN 📄"],
    [ 0.55,  6.75,  7.45, 15.35, 4.80, "J5 スピーカー OUT 📄"],
    [11.55,  1.25, 22.45,  9.85, 4.80, "J6 リード＋会話ボタン 📄"],   // 🔒 ce7d865: 口は ＋Y
    [21.45, 74.90, 31.55, 84.45, 4.00, "SW1 スライドスイッチ 📄"],
    [32.18, 75.28, 42.82, 84.70, 3.16, "J13 充電 USB-C ⚠"],
    [ 4.50, 50.92,  9.00, 55.52, 1.80, "L1 インダクタ"],
    [32.50,  4.30, 39.90,  9.70, 1.75, "U4 AS5600 ⚠"],
];
HB_REST = 1.6;   // 🔒 残り 42 部品は全部 1.6 以下（回路担当）。板全面に敷く
module hub_parts() {
    color("#9a4a2a", 0.9) translate([HB_X, HB_Y, HB_Z + HB_T]) cube([HB_W, HB_L, HB_REST]);
    for (q = HUB_PARTS)
        color("#7a3a20") translate([HB_X + q[0], HB_Y + q[1], HB_Z + HB_T])
            cube([q[2] - q[0], q[3] - q[1], q[4]]);
}

// 🔴 2026-09-13（私の当たり・851.75mm³）: 柱 6 本が**板を貫いたまま**描かれていた。
//   🔒 回路担当の実物の板には抜きが入っている（OLED × 4 φ6.5・ReSpeaker × 2 φ4.0）。
//   模型だけ古かった。⇒ **柱の表から導いて開ける**（柱を動かせば穴も動く）
HB_CLR = [6.5, 6.5, 6.5, 6.5, 4.0, 4.0];   // POSTS[0..5] に対する板の逃げ穴
module hub_board() difference() {
    union() {
        color("#d85a30") translate([HB_X, HB_Y, HB_Z]) cube([HB_W, HB_L, HB_T]);
        hub_parts();
    }
    for (i = [0 : len(HB_CLR) - 1]) {
        // 板そのもの（Z 3.0〜4.6）は 🔒 回路と合意した径。ReSpeaker の柱はここで φ3.5 に細っている
        translate([POSTS[i][0], POSTS[i][1], HB_Z - 1]) cylinder(d = HB_CLR[i], h = HB_T + 2);
        // 口の層（Z 4.6〜8.6）は**部品の場所取りの塊**なので、柱の実径 ＋ 0.5 で抜く
        //   ⚠ ReSpeaker の柱は板の上で φ5.0 に戻るので、板の穴 φ4.0 のままだと塊を貫く
        translate([POSTS[i][0], POSTS[i][1], HB_Z + HB_T - 0.01])
            cylinder(d = POSTS[i][3] + 0.5, h = HB_PLUG + 0.02);
    }
}
