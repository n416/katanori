//     ④ 背面の床の育ち **+0.4**（初層 4,099mm² ＝ LCD 比 31.8%・`PRINT.md` の表を内挿）
//        ⇒ **床すれすれに這わせない。**
//   線は 5 本・14 芯。前の殻をまたぐのは J2・J6・J5 の 10 芯
WIR_Z   = HB_Z + HB_T + 2.4;   // 芯の高さ（板の上）
WIR_H   = 3.0;                 // 束の高さ（📄 適合電線 φ1.5 ＋ 曲げの逃げ）
WIR_FLR = WALL + 0.4;          // 🔴 床の育ちの分。ここより下へ道を置かない
// [幅, [通る点…]]  ⚠ 点は箱の座標。相手側の端は ⚠ 概略（口の座標は 📄・相手の端子は未取得）
WIRES = [
    [6.0, [[38.75, 49.00], [36.00, 52.00], [30.00, 70.00], [24.00, 77.00]]],  // J2 → OLED の端子 ⚠
    [6.0, [[16.00, 11.00], [12.00, 20.00], [10.95, 30.04]]],                  // J6 → リードの座
    [3.0, [[16.00, 11.00], [ 8.00, 30.00], [ 4.00, 66.00]]],                  // J6 の分岐 → 会話ボタン ⚠
    [3.0, [[36.48, 71.00], [30.00, 78.00], [20.00, 80.00]]],                  // J4 → ReSpeaker の J2 ⚠
    [3.0, [[ 5.00, 16.50], [ 3.00, 20.00]]],                                  // J5 → スピーカー ⚠
    [3.0, [[41.00, 33.55], [39.00, 30.00]]],                                  // J10 → 電池のタブ ⚠
