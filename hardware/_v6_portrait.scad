//     板 **1.00**（📄 側面図の下のスラブ）／ ガラスの積み **1.65**（⚠ 2.65 − 1.00。
//     図面の「板の上面からガラスの上まで 1.40」より 0.25 厚い側を採る。厚い方が当たるので）
//   ⇒ 21.0 を超えるのは**ガラス 40.04 × 27.22 だけ**で、板 42.40 × 38.00 は 20.15 で止まる
OL_T     = 2.65;
OL_PCB_T = 1.00;
OL_X = (BODY_X - 42.40) / 2;
OL_Y = SCR_Y - 5.39;                    // ガラスは板の中央にあるので、回しても板の位置は変わらない
OL_Z = BODY_Z - SCR_IN - OL_T;

RS_X = 2.0;   // 🔒 2026-09-13 ユーザー「つまみをギアで動かして稼働部と読み取り部を遠ざける」: 左へ寄せて右に 22 の空き列を作る
RS_Y = 2.965;   // 上下の口が同じだけ奥に来る位置（1.435 ＋ XIAO の USB-C 1.53）
// 🔴 2026-09-13: この 0.3 が **OLED の板と ReSpeaker のマイク面の隙間**で、
//   マイク面から 1.185 出ている **D1** を数えていなかった（LED1 は 0.65）。⇒ 0.89 食い込んでいた。
