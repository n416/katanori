if (part == "face") { shell(); screen(); knob(); side_parts(); }

echo(str("外形 ", BODY_X, " x ", BODY_Y, " x ", BODY_Z, " = ", BODY_X * BODY_Y * BODY_Z / 1000, "cm3"));
echo(str("画面のガラス ", GLASS[0], " x ", GLASS[1], " / 光る所 ", AA[0], " x ", AA[1],
