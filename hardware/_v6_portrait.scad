HUB_PARTS = [   // [x0, y0, x1, y1, 背, ref]
    [26.95, 12.95, 42.25, 23.65, 9.33, "K31 リレー 📄"],
    [ 7.63,  1.13, 11.17, 19.91, 8.50, "J1 XIAO D0〜D6"],
