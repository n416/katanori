SPK_PLATE_X = -8.2;
module spk_pod() hull() { at_spk() spk_rim_full(); at_spk() spk_tub(); }
SPK_CY = 20.0; SPK_CZ = BODY_Z / 2;
// 🔒 2026-09-13 ユーザー「X 軸を中心に 20 度 反時計回り」
SPK_RX = -20;
module at_spk() translate([SPK_PLATE_X, SPK_CY, SPK_CZ])
    rotate([SPK_RX, 0, 0]) rotate([0, -90, 0]) rotate([0, 0, 90]) children();

// 🔒 2026-09-13 裁定 #1（A3）: 中継の歯車を載せる止まり軸。前の壁の内面から下ろす
ID_PIN_D = 3.00;
// 🔒 軸の先の Z。**機構（_v6_gear.scad）が include の後で上書きする所。**
//   既定値は鍔 0.15 ＋ 逃げ 0.10 ＝ 19.15 で、親を単独で描いてもこの値で成立する。
//   🔴 **変数ではなく関数にしてある。**機構担当が最小の実験で確かめた OpenSCAD の性質:
//     同じ変数に 2 回代入すると、最後の代入の右辺が**最初の代入があった位置**で評価される。
//     ⇒ 子からの変数の上書きは、親の代入より後で定義された物を 1 つも参照できず undef になる。
//     関数とモジュールの上書きは呼ぶときに評価されるので効く。
//   ⚠ 機構側は `idler_pin()` を**モジュールごと**上書きしていたが、それはやめて
//     `function id_pin_bot() = ID_BOT - 0.10;` の 1 行だけにしてもらう。
//     モジュールを複製すると、親がモジュールに足した物（溝の抜き穴で実際に起きた）が子に伝わらない
function id_pin_bot() = GZ - 0.25;
module idler_pin() color("#6e7276")
    translate([IDLER[0], IDLER[1], id_pin_bot()])
        cylinder(d = ID_PIN_D, h = WALL_IN - id_pin_bot());

// ⚠ 皮だけの見せ物（cavity を引かない）。機構担当の shell_mech がここを呼んで自分で cavity を引くので、
//   **柱と中継の軸も入れておく**（入れないと向こうの検査が柱に対して盲になる）
module shell_a(a = 1.0) color("#55585c", a) {
    difference() {
        union() { body(); spk_pod(); at_spk() spk_station_add(); }
        scr_pocket(); glass_relief(); knob_bore_front(); knob_stop_groove(); reed_seat();
        side_cuts(); jack_hole(); top_mics(); bottom_ports(); at_spk() spk_station_cut(); post_cuts();
    }
    shell_stand();
}
module shell() shell_a(1.0);

module screen() {
