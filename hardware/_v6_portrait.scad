// ============================================================
// v6 縦置きの顔（ユーザー 2026-09-13 の参考画像）
//   🔒 ユーザー「つまみは小さくして薄くしていい」「一旦衝突判定は無くていい」
//      「ReSpeaker のマイクがつぶれるとしても良い」
//   ⚠ これは**形だけ**の当て板。中身・柱・締結・線は入っていない。当たりも見ていない。
//   ⚠ 外形は部品の実寸から出した下限に丸めた値で、詰めていない。
//
//   座標: X = 幅（0〜BODY_X）／ Y = 高さ（0 が下）／ Z = 厚み（**正面が z = BODY_Z**）
//   実行: "C:/Program Files/OpenSCAD (Nightly)/openscad.exe" --backend=manifold -o x.png -D "part=\"face\"" hardware/_v6_portrait.scad
//   part の値: face（顔）／ shellonly（殻だけ）／ guts（中身）／ inside（皮を外した中身と座）／ cut（半分の断面）／ explode（分解）
// ============================================================
part = "guts";
$fn = 64;

include <parts/fit.scad>   // FIT_SLIP / fit_burn()。🔒 嵌め合いの数字はこの 1 か所が持つ
use <parts/respeaker_lite.scad>
use <parts/spk_v5.scad>   // 🔒 スピーカーまわりは v5 の形をそのまま呼ぶ（ユーザー 2026-09-13）
use <parts/parts.scad>

BODY_X =  48.0;   // 幅。🔒 2026-09-13 ユーザー「幅を狭めないとポータブル端末に見えない」で 58 → 48。
                  //   下限は OLED の 42.40。48 ならガラス 40.04 の左右の余白が 4.0 ずつ・縦横比 1:1.83
                  //   ⚠ 中継基板は 52 幅では入らない。44 幅への作り直しが要る
BODY_Y =  88.0;   // 高さ。🔒 2026-09-13 ユーザー「イヤホンジャックが外に出るサイズに」:
                  //   XIAO の USB-C 1.53 ＋ 板 82.024 ＋ ジャックの筒 1.576 ＝ 85.13 が両端の口の実寸。
                  //   88 なら余り 2.87 を上下に分けて、どちらの口も外面から 1.435 奥で止まる
BODY_Z =  23.0;   // 厚み。🔴 2026-09-13 背面にスピーカーを入れて 31 にしたら「一気に箱感が出た」（ユーザー）。
                  //   胴は 23 に戻し、スピーカーは左の外へ出す
                  //   ⚠ ReSpeaker の XIAO 面が平らなのは記録では Y 35〜68 だけ（はみ出し 1.69）
WALL    =  2.0;   // 殻の肉（背面と側面）
// 🔒 2026-09-13: **顔の壁だけ分ける。**理由は 2 つ。
//   ① 歯車の帯 = SCR_IN + OL_T + OL_RS_GAP − **WALL_F** ⇒ 顔を薄くすると帯が 1:1 で増える
//   ② BODY_Z = 背面側の積み ＋ D ＋ **WALL_F** ⇒ 顔を薄くすると厚みが 1:1 で減る
//   🔴 背面は薄くできない（`WALL` 1.5 にするとザグリ φ4.0 × 1.1 の下が 0.40 で下限 0.42 を割る）。
//   ⚠ 既定は WALL と同じ。**この行を変えるまで、形は 1 か所も変わらない**
WALL_F  = WALL;   // 顔（前）の壁
SPLIT_Z = 10.0;   // 背面の蓋の合わせ面
WALL_IN = BODY_Z - WALL_F;   // 21.00 前の壁の内面。🔒 歯車の帯もつまみの皿もここから導く
GTOP    = WALL_IN - 0.20;  // 20.80 歯車の天面（＝つまみの抜け止めの面）
GEAR_W  = 1.4;             // 歯幅。🔒 裁定 #1（A5）。理由は下の歯車の節
GZ      = GTOP - GEAR_W;   // 19.40 歯車の底
// 🔴 GTOP / GEAR_W / GZ をここに置くのは、下で使う変数（ID_PIN_BOT・KN_DISHZ）が
//    先に評価されて undef になる事故を 3 回やったため。**壁から出る数は壁の隣に置く**
BODY_R =   0.0;   // 角と稜の丸み。🔒 2026-09-13 ユーザー「筐体の丸みを無くしましょう」で 7.0 → 0

// ---- 画面（📄 HS154L03W2C01: ガラス 27.22 × 40.04・AA 17.52 × 35.05）----
//   42.40 を横・38.00 を縦に置く。🔒 2026-09-13 ユーザー「OLED を Z 軸中心に 180 度回転」:
//   端子は**上の縁**。AA はガラスの中で上へ寄る（ガラスの縁からの余りが 2.76 ↔ 6.94 で入れ替わる）
GLASS  = [40.04, 27.22];
AA     = [35.05, 17.52];
OLED_FLIP = true;              // 180 度回した状態
AA_UP  = OLED_FLIP ? 6.94 : 2.76;   // ガラスの下の縁から AA の下端まで
SCR_Y  = 44.69;   // ガラスの下端の高さ。板の下端が Y 39.3 に来る値（マイクの帯 68.35 の中）
SCR_IN = 0.2;     // 🔒 2026-09-13: 1.2 → 0.2。**ガラスを 1.0 前へ出して D1 の逃げを作る**。
                  //   ⚠ これと `OL_RS_GAP` は対。0.2 にしないと中継基板が背面の床（Z 2.0）を割る。
                  //   ⚠ 顔の見え方が変わる（ガラスが面から 1.2 奥 → 0.2 奥 ＝ ほぼ面一）。ユーザーの判断待ち
SCR_R  =  3.0;
// 🔒 2026-09-13: 窓は**ガラスではなく光る所**に合わせる。ガラス 27.22 のうち光るのは 17.52 で、
//   残り 9.70（上 2.76・下 6.94）は部品の余白。そこまで開けると黒い帯が顔に出るので、殻の裏へ入れる
WIN_BEZEL = 1.5;
WIN    = [AA[0] + 2 * WIN_BEZEL, AA[1] + 2 * WIN_BEZEL];
WIN_YC = SCR_Y + AA_UP + AA[1] / 2;   // 光る所の中心

// ---- つまみ ----
// 🔴 2026-09-13 訂正: 「皿」は殻の窪みではなく**つまみそのものの形**（ユーザー）。
//   殻を彫るのをやめ、軸が通る穴だけにした。皿は面の上に載って回る
// 🔒 2026-09-13 ユーザー「マイク穴と OLED のガラス部分と真ん中に」:
//   下のグリルの上端 9.95（RS_Y 2.965 ＋ 5.485 ＋ スリットの半分 1.5）から
//   窓の下端 50.13（WIN_YC 60.39 − WIN の半分 10.26）までの中央
KN_Y    = 30.04;
KN_OD   = 28.5;   // 皿の外径
KN_ID   = 11.0;   // 真ん中の抜き
KN_OUT  =  2.5;   // 皿の厚み
KN_SINK =  0.8;   // 皿の上面のへこみ（皿らしさ）
// 🔒 2026-09-13 調停役の裁定 #1（A1）: 9.0 → **12.85**。皿と歯車を繋ぐ筒（スカート φ12.60）が通る。
//   皿の縁 r14.25 ↔ 穴の縁 r6.425 で半径 7.825 隠れるので顔には出ない。窓の下端まで 13.67 空く。
//   ⚠ この数は**親が持つ**。_v6_gear.scad は KN_SKIRT = KN_BORE − RUN で導くこと
KN_BORE = 12.85;   // 殻に開ける軸の穴

// 🔒 2026-09-13 裁定 #1（A2）: つまみの**回り止めの溝**を正面の面に彫る。
//   無いと 360 度回って 0%↔100% が飛ぶ（ファームは壁がある前提・KNOB_SPAN_DEG=310）。
//   🔴 私（デザイン）は「残り肉 1.0・沈みが顔に出る」で反対したが**向きが逆だった**:
//     育つのは内面（docs/PRINT.md）なので残り肉は 1.0 のまま。薄くなる向きには動かない。
//     「大きい平面が厚く出る」も接地の話で、溝は平面を 111mm² **減らす**。
//   ⚠ 溝の口はプレート側（顔を下にして刷る）なので **fit_burn() を通す**。手で広げない。
//   ⚠ 口がプレート側の彫り込みには**抜き穴が要る**（無いと吸盤。2026-09-10 の小帯 C・fit.scad）
STP_R   = 8.85;   // 🔒 2026-09-13 裁定: 9.45 → 8.85。**溝を内へ引いてリードの座を皿の下へ入れる**。3 人とも「溝を縮める」を試していなかった
STP_D   = 2.60;   // 🔒 2026-09-13 裁定: 2.00 → 2.60。溝の芯 8.85 と**対で 1 つの裁定**（片方だけだと腕が短くなって v5 比 1.82 になる）
STP_W   = STP_D + 0.2 + fit_burn();   // 溝の幅。設計 2.2・印刷モデルだけ +0.4
STP_DEP = 1.00;   // 溝の深さ（前の壁 2.0 のうち 1.0 を残す）
STP_ISL = 20;     // 🔒 2026-09-13 機構の要求で 28 → 20。島は橋ではなく床の上の出っ張りなので殻の強さは減らない。芯は 0 度 ＝ +X 側
STP_VENT   = 1.5; // 抜き穴
STP_VENT_A = -90; // 抜き穴の角度。中継の鍔 φ10（芯は −43.9 度）と OLED（Y 39.3 以上）を避ける

// ---- 側面の縁（模型の −X 側 ＝ 正面から見て左）----
BTN_Y = 66.0; BTN_H = 13.0; BTN_W = 5.0; BTN_OUT = 1.5;
// 🔒 2026-09-13 ユーザー「トグルじゃなくてスライドスイッチにした方が良い」＋「位置を変えましょう」:
//   MTS-102 は内側に 18 要って上の縁を独占していた。スライドなら 4 前後で済む。
//   位置はジャック（X 5〜12）と充電の USB-C（X 28.28〜37.72）のあいだへ。
//   🔴 2026-09-13 回路側の訂正: ALPS SSSS811101（案 A）の「つまみ」は φ0.8 のピンで、胴から 0.9 出るだけ。
//     スリットにレバーが出る形にはならず、ピンを掴む滑り子が要る。⇒ **案 B を採る**:
//     SHOU HAN MST-12D18G3（LCSC `C49023766`）・SMD の横出し・本物のレバー・SPDT・100mA 12V・$0.079
//   🔴 2026-09-13 回路側がデータシートを取った（📄 hardware/ref/slide_switch_mst12d18g3/）:
//     **背は 6.5 ではなく 4.0**。JLCPCB の属性欄の 6.5 はレバー 3.0 ＋ 胴 3.5 の、
//     **板の面と平行に測った奥行き**だった。板の面からの高さは 4.0。
//     ⇒ 電池の影（天井 4.4）にも入る。でも**上の縁のままにする**（携帯機の電源は上の縁が逓当）
//     🔴 レバーの先を板の上端に合わせると**外面から 3.8 奥**になって指が届かない。
//     ⇒ **胴のレバー側の面を板の上端に揃え、レバーは板から張り出す**（充電の USB-C と同じやり方）
//   🔴 J2（ReSpeaker のスピーカーソケット）のプラグ柱が板の X 12〜21（箱 14〜23）を貫く。
//     上の縁の並びは 左から ジャック 5〜12 ／ J2 の柱 14〜23（穴なし）／ スイッチ 24〜33 ／ 充電 35〜44
TGL_X = 28.5;
TGL_BODY  = [9.1, 3.5, 3.5];   // 📄 長さ × 奥行き × 胴そのものの高さ
TGL_LIFT  = 2;               // 📄 板の面から胴の下面までの浮き ⇒ 胴の上面は板の面から 4.0
TGL_DROP  = 0.2;               // 📄 胴の上面からレバーの上面までの下がり
TGL_PAD   = [1.2, 2.1];        // 📄 パッド。中心は板の Y 76.2（2.5 ピッチで 3 つ）
TGL_LEVER = [1.5, 3.0, 1.5];   // 📄 レバー。断面 1.5 × 1.5・胴から 3.0 出る
// 🔴 2026-09-13 回路側の訂正（側面図の 0.2）: レバーの Z の芯は胴の真ん中ではなく、
//   板の面から **3.05**（4.0 − 0.2 − 1.5/2）。私の仮定 2.0 より **1.05 上**だった
TGL_STROKE = 2.3;              // ⚠ データシートに寸法としては無い。回路側が PDF のベクタを測って 2.3
//   （縮尺は外形 9.1 とレバー 1.5 の 2 つで一致している。ただし「描かれているのが端の位置」は保証なし）
//   ⇒ スリットは広い方に外す。1 つ買って測るのはこのためだけには不要
// 🔒 3.5mm ジャックは板の「左から 82.024」の端にあるので、**上の縁**に出る（側面ではない）。
//   筒の芯は「下から 6.502」＝ 箱の X 8.502、「XIAO 面から 2.485」＝ 箱の Z = RS_Z − 2.485。
//   🔴 2026-09-13 ここを BODY_Z/2 と直書きしていて、実物より 3.0 ずれていた
JACK_X = 8.502; JACK_D = 7.0;   // JACK_Z は RS_Z の後で定義する（前だと未定義になる）

module rr(w, h, r) hull() for (sx = [-1, 1], sy = [-1, 1])
    translate([sx * (w / 2 - r), sy * (h / 2 - r)]) circle(r = r);

module body()
    if (BODY_R < 0.05) cube([BODY_X, BODY_Y, BODY_Z]);
    else hull()
        for (x = [BODY_R, BODY_X - BODY_R], y = [BODY_R, BODY_Y - BODY_R], z = [BODY_R, BODY_Z - BODY_R])
            translate([x, y, z]) sphere(r = BODY_R);

module scr_pocket() translate([BODY_X / 2, WIN_YC, BODY_Z - SCR_IN])
    linear_extrude(SCR_IN + 1) rr(WIN[0], WIN[1], SCR_R);
// 🔒 ガラスの逃げ。**内側だけの座ぐり**で、顔に見えるのは光る所の掘り込みのままにする
//   （🔒「窓はガラスではなく光る所に合わせる。そこまで開けると黒い帯が顔に出る」）
GL_CL = 0.5;   // 逃げ（片側 0.25）
// 🔒 内側の座ぐりは 2 段。**ガラス**はポケットの底まで、**板**は板の天面まで。
//   ⚠ SCR_IN を浅くすると OLED 全体が前へ出るので、板の天面も内面 21.0 を超える。
//   2 段にしておけば `SCR_IN` を動かしても追従する（1 段だと板の縁が壁に埋まる）
module glass_relief() {
    translate([BODY_X / 2, SCR_Y + GLASS[1] / 2, BODY_Z - WALL_F - 0.01])
        linear_extrude(WALL_F - SCR_IN + 0.02) rr(GLASS[0] + GL_CL, GLASS[1] + GL_CL, 0.5);
    // ⚠ 角 R 1.0 だとガラスの角が 0.06 はみ出して 0.01mm³ 残っていた
    if (OL_Z + OL_PCB_T > BODY_Z - WALL_F)
        translate([BODY_X / 2, OL_Y + 38.00 / 2, BODY_Z - WALL_F - 0.01])
            linear_extrude(OL_Z + OL_PCB_T - (BODY_Z - WALL_F) + 0.02)
                rr(42.40 + GL_CL, 38.00 + GL_CL, 0.5);
}

module knob_bore_front() translate([BODY_X / 2, KN_Y, BODY_Z - 4]) cylinder(d = KN_BORE, h = 6);
module knob_stop_groove() {
    translate([BODY_X / 2, KN_Y, BODY_Z - STP_DEP]) linear_extrude(STP_DEP + 0.01) difference() {
        circle(r = STP_R + STP_W / 2);
        circle(r = STP_R - STP_W / 2);
        polygon([[0, 0], [20 * cos(-STP_ISL / 2), 20 * sin(-STP_ISL / 2)],
                 [24, 0], [20 * cos(STP_ISL / 2), 20 * sin(STP_ISL / 2)]]);
    }
    translate([BODY_X / 2 + STP_R * cos(STP_VENT_A), KN_Y + STP_R * sin(STP_VENT_A), BODY_Z - WALL_F - 1])
        cylinder(d = STP_VENT, h = WALL_F + 2);
}

// 🔒 2026-09-13 ユーザー「スピーカーとスイッチは両方左に」: 会話ボタンとトグルも左（−X）の縁へ
module side_cuts() {
    translate([-1, BTN_Y, BODY_Z / 2]) rotate([0, 90, 0])
        linear_extrude(4) rr(BTN_W + 0.6, BTN_H + 0.6, 2.5);
}
module jack_hole() {
    translate([JACK_X, BODY_Y - 4, JACK_Z]) rotate([-90, 0, 0]) cylinder(d = JACK_D, h = 6);
    translate([TGL_X, TGL_FRONT, TGL_LEVER_Z]) rotate([-90, 0, 0])
        linear_extrude(BODY_Y - TGL_FRONT + 1) rr(TGL_SLOT[0], TGL_SLOT[1], 0.5);
        // 🔴 角 R を TGL_SLOT[1]/2（小判型）にしていて、レバーを振り切ったとき角が 0.09 当たっていた
    translate([CHG_X, BODY_Y - 4, HB_Z + HB_T + CHG_T / 2]) rotate([-90, 0, 0])
        linear_extrude(6) rr(CHG_W + 0.5, CHG_T + 0.5, 1.6);   // 充電の USB-C（上の縁）
}

// ============================================================
// リードスイッチの座（🔒 2026-09-13 機構担当の決定）
//   役: つまみを OFF まで回し切ると `EN` を GND に落として完全停止（`POWER.md` 2 章）。
//   🔒 磁石は皿の裏・**止めピンの反対側**（MAG2_ANG 10 度・r 11.95・φ4 × 1）。
//     OFF（ピンが島の縁 −10 度）のとき磁石は world 180 度 ＝ 箱 X 12.05・Y 30.04 に来る。
//   🔴 深さは機構の言う 1.70 ではなく **1.58**。天井は「平たい肉」なので下限は 0.30 ではなく
//     **0.42**（`hardware/tools/_stl_preflight.py:386`「実績の下限 0.42 を割る」）。
//     0.30 は立った壁の値で、同じ取り違えを調停役も 1 度している。⇒ 2.0 − 0.42 = 1.58
//   ⚠ 座は片側が開いた（内側へ開く）ポケット。v5 の 3.30 は四方を囲んだ深穴で「途中で止まって入らない」
//     という実測がある。こちらは開いているので入るはずだが、⬜ 実物で確かめていない
// 🔒 座の芯。🔴 11.00 → **10.95**: 座の天井 22.20 は**止めの溝の底 22.00 より上**なので
//   Z で 0.20 重なる。⇒ 平面で離れていないと**溝がポケットへ開く**（ピンの走る溝に穴が空く）。
//   溝の外縁は**印刷モデルで** X 13.05（設計モデルで見ると 0.20 余裕が多く見えるので注意）。
//   壁は 10.95 で **0.45** ＝ 立った壁の 0.30 と平たい肉の 0.42 の**両方を超える**（3 スレッド共通の運用）
REED_C   = [11.50, 30.04];
REED_W   = 3.30;             // 📄 部品 3.2 角（parts.scad 607 行 ✅）＋ 逃げ
REED_L   =  9.0;             // 🔒 裁定: 全長 **9.0**（顔に出るのは 1.49mm² ＝ 顔の 0.035%）。
                             //   🔒 角の r ＝ √(外縁² ＋ (長さ/2)²)。半径だけで見ると必ず外す（3 回やった）
// 🔒 2026-09-13 裁定: 彫り代は 1.58 ではなく **1.20**（顔に **0.80** 残す）。
//   🔴 決め手は**レジンが透明**なこと（🔒 常用は ELEGOO 透明／クリアブルー）。
//   0.42 まで彫ると、まわりの 2.0 に対して**そこだけ明るく透ける**。0.42 は強さの下限であって
//   見た目の下限ではない。⚠ 顔の残り 0.80 は、同じ顔にある止めの溝の残り 1.0 と同じ桁
REED_DEP = 1.20;             // 内面 21.0 から彫る深さ（天井 22.20・顔に 0.80）
module reed_seat() translate([REED_C[0], REED_C[1], BODY_Z - WALL_F - 0.01])
    linear_extrude(REED_DEP + 0.01) square([REED_W, REED_L], center = true);

// 🔒 マイク 2 個の穴（正面）。📄 公式 CAD の U4/U5 を、平置きにした ReSpeaker の座標へ起こした値。
//   マイクの芯は X 19 で面の中心 24 から 5 左。🔒 2026-09-13 ユーザー「同じスリットを何本か並べてグリルに」:
//   面の中心に**縦のスリット 7 本**（1.6 × 3.0・ピッチ 3.4）を並べる。芯は X 13.8〜34.2 で左右対称。
//   マイクの X 17.25〜20.75 の上には 17.2 と 20.6 の 2 本が乗る
MIC_SLIT = [1.6, 3.0];
MIC_N = 7; MIC_PITCH = 3.4;
