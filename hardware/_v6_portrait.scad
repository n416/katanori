OL_RS_GAP = 1.30;
RS_Z = OL_Z - OL_RS_GAP - 1.85;         // OLED のすぐ後ろ。マイク面が前
JACK_Z = RS_Z - 2.485;                  // 3.5mm ジャックの筒の芯（XIAO 面から 2.485）

