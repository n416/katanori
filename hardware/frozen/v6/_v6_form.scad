// ============================================================
// v6 外形の案 ── 顔だけの当て板（2026-09-13・**マイクの穴を板に固定して作り直し**）
//   🔴 2026-09-13 ユーザー「ロックしなければならないマイク穴を無碍にしてます」:
//      初版は画面・つまみからの相対でグリルを置いていた。**マイクは ReSpeaker の U4/U5 に固定**で、
//      🔒 芯間 **71.0**（📄 左から 5.485 と 76.485）。板が動けば穴も動く。位置は選べない。
//   🔒 動かせない: ReSpeaker 82.024 × 34.007（45 度 傾けても外接 82.0）／ マイク 2 個の芯間 71.0 ／
//      OLED の光る所 35.05 × 17.52（ガラス 40.04 × 27.22）／ つまみ φ28.5 ／ 厚み 23
//   ⚠ 傾き: 全案とも **0 度**
// ============================================================
v = 0;
$fn = 72;
GLASS=[40.04,27.22]; AA=[35.05,17.52]; KN=28.5; TH=23; RS_L=82.024; MIC=[5.485,76.485];
// [幅, 丈, 板の下端 Y, 画面の芯, つまみの芯, スピーカーの芯（0=側面のコブ）, 名前]
V = [
 [48, 88, 2.965, 60.4, 30.0,  0, "A いま（コブ 8.2・総幅 56.2）"],
 [48,104, 20.0,  77.4, 47.0, 11, "E スピーカーを下へ内蔵（板を上へ寄せる）"],
 [48,104,  3.0,  60.4, 30.0, 94, "G スピーカーを上へ内蔵（板を下へ寄せる）"],
 [56, 92,  5.0,  62.4, 32.0,  0, "H 幅を広げて丈を詰める（コブは残る）"],
];
W=V[v][0]; L=V[v][1]; RY=V[v][2]; SY=V[v][3]; KY=V[v][4]; PY=V[v][5];
M0=RY+MIC[0]; M1=RY+MIC[1];      // 🔒 マイクの芯（板に固定）
module rr(w,h,r) hull() for(sx=[-1,1],sy=[-1,1]) translate([sx*(w/2-r),sy*(h/2-r)]) circle(r=r);
module grille(cy) for(i=[0:6]) translate([W/2+(i-3)*3.4, cy]) rr(1.6,3.0,0.8);
difference() {
    union() {
        color("#55585c") cube([W,L,TH]);
        if (PY==0) color("#55585c") translate([-8.2, 12, TH/2-11]) cube([8.2,30,22]);
    }
    translate([W/2,SY,TH-3]) linear_extrude(6) rr(AA[0]+3,AA[1]+3,3);
    translate([W/2,KY,TH-3]) cylinder(d=12.85,h=6);
    translate([0,0,TH-3]) linear_extrude(6) { grille(M0); grille(M1); }   // 🔒 板に固定
    if (PY>0) translate([W/2,PY,TH-3]) linear_extrude(6) circle(d=30);
}
color("#3c3f43") translate([W/2,KY,TH]) difference() {
    cylinder(d=KN,h=2.5);
    translate([0,0,1.7]) cylinder(d1=KN-6,d2=KN-1.5,h=0.81);
    translate([0,0,-1]) cylinder(d=11,h=5);
}
color("#cfd8dd") translate([W/2,SY,TH-0.4]) linear_extrude(0.35) rr(AA[0],AA[1],0.8);
echo(str(V[v][6], " : ", W," x ",L," x ",TH,
         " ／ マイクの穴 Y ",M0," と ",M1," （下の縁から ",M0," ・上の縁から ",L-M1,"）"));
