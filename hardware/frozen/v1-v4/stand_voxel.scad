// カタノリ 卓上スタンド ― 立方体の格子（2026-08-08・ユーザー案）
//
// 参照した絵: エッシャー風のペンローズの三角（同じ立方体を積んで、直交する3本の腕で組む）。
// ユーザー「ピンヘッダに干渉しちゃうし、全然幾何学図形に見えないよ。
//           これはエッシャーだけど、こういう風に見えたらいいよねって感じ」
//
// 前の細い斜め梁のトラスは廃止。**同じ大きさの立方体を格子に並べる**言語にする。
// 格子なら XIAO まわりは「マスを置かない」で正確に避けられるので、干渉も同時に片付く。
//
// ⚠ **干渉の確認をモックだけで済ませない。** 前回「チェックは空」と報告したが、
//    モックのピンヘッダーは箱1つの簡略形で、u.FLアンテナの同軸は⬜で入っていない。
//    実物を見ているユーザーの指摘のほうが正しかった（失敗ログ11と同じ読み替え）。
//
// 座標: 世界。机が z=0、基板は下辺で机に乗り、後傾15°で -Y 側へ倒れる。
//   基板の XIAO面 は world y = -tan15 * z  の平面
//   📄 穴A = 世界(  2.49, -8.17, 30.50)   ／ 穴B = 世界( 60.20, -0.69,  2.57)
//
//   openscad -o vox.png --render -D 'SHOW="assembly"' stand_voxel.scad

use <respeaker_lite.scad>

SHOW = "assembly";   // "assembly" | "part" | "check"
$fn  = 32;

TILT = 15;
G    = 8.0;      // 立方体の一辺
GAP  = 0.35;     // 立方体どうしの目地（絵の「積んだ感じ」を出す）
X0   = -8.0;     // 格子の原点（世界）
Y0   = -2.0;     // j が増えると後ろ(-Y)へ
Z0   =  0.0;

HOLE_A_B = [ 2.492, 31.577];   // 基板系（左から / 下から）
HOLE_B_B = [60.202,  2.657];

// 立方体の格子。[i, j, k]
// 腕1（Z方向・柱）… 基板の左端より外側に立てる
// 腕2（X方向・桁）… 机沿いに右へ走って穴Bへ
// 腕3（Y方向・尾）… 後ろへ伸ばして倒れ止め
CELLS = [
    // 柱（左・外側）
    [0,1,0],[0,1,1],[0,1,2],[0,1,3],
    // 柱の頭。穴Aの高さまで来る
    [1,1,3],
    // 桁（机沿い・右へ）
    [1,1,0],[2,1,0],[3,1,0],[4,1,0],[5,1,0],[6,1,0],[7,1,0],[8,1,0],
    // 尾（後ろへ）
    [0,2,0],[0,3,0],
];

module cell(c) {
    translate([X0 + c[0] * G, Y0 - (c[1] + 1) * G, Z0 + c[2] * G])
        cube(G - GAP);
}

module frame_raw() { for (c = CELLS) cell(c); }

module board() { rotate([TILT, 0, 0]) respeaker_lite(); }

module frame() {
    difference() {
        frame_raw();
        translate([-200, -200, -100]) cube([400, 400, 100]);   // 机で切る
    }
}

if (SHOW == "assembly") { board(); color("#c94") frame(); }
else if (SHOW == "part") frame();
else if (SHOW == "check") intersection() { frame(); board(); }
