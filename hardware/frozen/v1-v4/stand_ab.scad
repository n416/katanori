// カタノリ 卓上スタンド ― A梁・B梁・四面体（ユーザー設計）
//
// ============================================================
// 🔒 確定した骨格の原理（2026-08-09・ユーザー確認済み）
// ============================================================
//   ・**B梁には角度という属性が無い。** 基板に垂直な棒。それだけ。
//     上から見て90°もその言い換え。B梁の傾きは基板の傾きの**結果**であり、
//     入力として弄ってはいけない（45°・鉛直・フック…と弄り続けたのが今までの誤り）
//   ・**角度を持つのはA梁だけ。** A梁は机と水平。穴Bへの取り付けに
//     「付けたい角度」A_ANGLE が仕込まれ、基板がその角度に引きずられて傾く
//   ・四面体: 底面＝赤の三角（水平・A梁が右辺）。上部頂点＝**B梁上の点**。
//     緑の3本が底面の頂点から頂点へ登る。B梁は頂点より先へ余らせておき、後で切る
//   ・🟣 紫は梁ではない。「ヘッダー（面から10mm）と配線より前へ入るな」の境界線
//
// 🔒 **下部三角の内側は配線の通り道である（2026-08-10・ユーザー）。**
//    ここを配線が通ることで、**引っ張りをピンヘッダーではなく骨格が受ける。**
//    スタンドは支えるだけの部品ではなく、配線のストレインリリーフを兼ねている。
//    ⚠ だから三角の内側を塞ぐ・埋める・筋交いで割るような「補強」をしてはいけない。
//    強度が足りないときは棒を太くするか外側へ足す。**開口は仕様である。**
//
// 🔒 **裏返すと基板を水平近くで見せられる（2026-08-10・ユーザー）。**
//    四面体なので置く面を変えれば姿勢が変わる。**立てれば A_ANGLE の後傾、
//    裏返せば水平近く**という2通りの見せ方が、1つの形に入っている。
//    ⚠ 部品を足すときは「立てたとき」だけで判断しないこと。出っ張りを付けると
//    裏返しの置き方を殺す。⬜ どの面で接地するかはまだモデルに入れていない
//    （SHOW に裏返しの姿勢を足して、当たりを見られるようにする）
//
// 座標: 世界。机z=0。基板は下辺で机に乗り、A_ANGLEだけ後傾（-Y側へ）
//   openscad -o ab.png --render -D 'SHOW="assembly"' stand_ab.scad

use <respeaker_lite.scad>

SHOW = "assembly";   // "assembly" | "part" | "colors" | "check"
$fn  = 48;
T_IN = 5;   // "checkin" 用: カバーを差し込みの何mm手前に置くか（-D で渡す）

// ---- 入力（調整はここだけ）----
A_ANGLE = 15;      // 「付けたい角度」。A梁の取り付けが持つ角度＝基板の後傾
ROD     = 4.0;     // 梁の直径
A_LEN   = 45.0;    // A梁の長さ（絵の比率。刷るときは長めにして後で切ってもよい）
PURPLE_Y = -16.0;  // 🟣 紫の線。ヘッダー後端（世界y≈-12）＋配線の逃げ4mm。
                   // **下部トラス（三角）はこの線から後ろだけ。** 紫より前へ出てよいのは
                   // 穴へ向かう取り付けの継ぎだけ（B梁が横切るのと同じ扱い）
LEFT_OUT = 23.0;   // 左の頂点のせり出し（基板の左端から。上限23）
// 🔒 足を下へ伸ばして刷る（2026-08-10・ユーザー案）。下部三角は棒の下端が机から
//    0.57mm しか浮いておらず、そのまま刷ると足の付け根がグズグズになる。
//    **伸ばした分は組む前にニッパーで詰める。** 切る位置には溝を1周入れてある
LEG_EXT   = 0.0;   // 🔴 4.0 で刷ったら前より悪化した（2026-08-10）。
                   // プレートに着くのは足の底だけなので、伸ばすと三角が
                   // 4.6mm の空中に上がり、浮き島が高い位置で始まる。0 に戻した
LEG_NOTCH = 0.0;   // 🔴 溝も消した。造形中いちばん力のかかる区間を細くするだけで、
                   // 切りしろが無ければ切る位置も要らない
ROOT_Y   = PURPLE_Y;   // A梁の根元＝三角の開始は紫の線上
APEX_T   = 24.0;   // 四面体の上部頂点＝B梁の根元からの距離。
      // 🔒 2026-08-09 ユーザーの作図で 30 → 24 へ。**左の頂点の深さはもう入力ではない。**
      // 頂点と左の頂点は同じ奥行きに揃える（絵の横線）ので LEFT_Y は頂点から決まる。
      // 24 の出どころ: 絵の3本の横線を、既知の A梁の根元(-16)と先(-61)で割り付けて
      // 真ん中の線を読むと奥行き -35.2。B梁の根元(-12.04)からそこまでが 24.0
B_LEN    = APEX_T; // B梁は頂点で終わる（余りは切った・2026-08-09ユーザー指示）
// ============================================================
// 取り付け ― ビスをやめて「挿すだけ＋角カバーでロック」（2026-08-09・ユーザー案）
// ============================================================
// 取付穴には φ2.0 のペグを立てるだけで、基板は挿すだけで位置が出る。抜け止めは
// 左上の角に被せるカバーが受け持つ。**カバーを留めるビスは基板の穴を1本も通らない。**
// 基板の輪郭の外（角の対角）にフレームの耳を出し、そこへ留めるため。
//   普段        … カバー無しで挿すだけ
//   ちょっと止める … カバーを押し込むだけ（スカートが基板の縁を 0.15 で軽く掴む）
//   しっかり止める … M2ビスを締める（ナットは耳の六角ポケットに入れっぱなし）
//
// 🔒 φ2.2の丸穴では位置決めと引っ掛けを同じ穴で両立できない（丸穴は回しても
//    形が変わらないのでバヨネットが作れず、首＋爪の影が穴の円に収まらない）。
//    この案は**穴を位置決めだけに使い、抜け止めを角へ逃がす**のでその制約に触れない
BOSS_D  = 6.2;  BOSS_T = 4.0;
// BOSS_D はφ8から縮めた（2026-08-09・checkで発覚）: φ8だと穴Aの皿が R14・C59
// （左から5.83〜・📄）を、穴Bの皿が C16（下から6.07〜・📄）を踏む。
// φ6.2で余裕: A側 0.24 / B側 0.31
PEG_D   = 2.00;   // 📄穴φ2.20 に対してガタ0.20
PEG_OUT = 1.50;   // 穴Bのペグが基板の前面から出る量（2026-08-09 0.8→1.5・短すぎた）
PEG_OUT_A = 0.70; // 穴Aだけは短い。**カバーが上から下りてくるので、出しすぎると
                  // カバーの前板を貫いてしまう。** 逃げ溝を掘ったぶんの残り肉から逆算した
                  // 上限がこれ（前板1.8のうち0.95が残る）
SCREW_D  = 2.6;   // フレーム側のM2通し穴（2026-08-09 2.4→2.6・刷ると細る）
CV_SCR_D = 2.7;   // カバー側のM2通し穴
CV_CB_D  = 4.2;   // 🔴 頭のザグリ。**これが本命の対策。**（2026-08-09・実機で発覚）
CV_CB_H  = 0.8;   //    カバーはこの面をプレートに伏せて刷るので、初層が潰れて穴が
                  //    塞がりネジが入らなかった。φ2.7の穴を直接プレートに置かず、
                  //    φ4.2のザグリを置く。潰れるのはザグリの縁だけで、穴には掛からない。
                  //    ついでに頭（φ3.8）がザグリの底に座るので、締めたときの当たりも良い
NUT_AF  = 4.3;  NUT_T  = 1.9;   // M2ナット（二面幅4.0＋遊び／厚み1.6＋遊び）
// ✅ 2026-08-09 実機で確認: このポケットに **M2ナットがピッタリ入った**。
//    呼び+0.3 が正解。他の部品でも六角ポケットはこの値を使う
// 樹脂にネジは切らない（レジン①は経時で脆い・docs方針）。ナットは耳の背面の
// 六角ポケットに入れっぱなしにして、指でビスを2〜3山かけるだけでも効くようにする
BT      = respeaker_T();   // ✅板厚1.85（2026-08-10・板厚ゲージv2で実測。経緯は
                           //   respeaker_lite.scad の BOARD_T。公式CADの1.510は実物と違った）
// 🔴 旧 BT_MIN=1.25（「ユーザー実測」）は削除（2026-08-10）。ゲージ実測1.85で誤測定と確定。
//    そもそも宣言だけでどこにも使われておらず、「当たりは薄いほうで見る」は実装されていなかった

TILT = A_ANGLE;    // 基板の傾きはA梁の角度の結果

function bf(x, zb) = [x, -zb * sin(TILT), zb * cos(TILT)];
HA2    = [ 2.492, 31.577];   // 📄 取付穴（基板座標・左から/下から）
HB2    = [60.202,  2.657];
HOLE_A = bf(HA2[0], HA2[1]);
HOLE_B = bf(HB2[0], HB2[1]);
NRM    = [0, -cos(TILT), -sin(TILT)];   // 基板の法線＝B梁の向き（結果として傾く）

// ---- 骨格 ----
// 頂点をB梁の上で先に決めてから、左の頂点をその奥行きに合わせる。
// 順番が逆だった（左の頂点が入力だった）のを 2026-08-09 に入れ替えた
H_TRI = HOLE_B[2];                          // 下部三角の高さ（水平）
B_S   = HOLE_A + NRM * BOSS_T;              // B梁の根元
APEX  = B_S + NRM * APEX_T;                 // 四面体の上部頂点（B梁上）
B_E   = B_S + NRM * B_LEN;                  // B梁の先＝頂点で切る
LEFT_Y = APEX[1];                           // 🔒 左の頂点は頂点と同じ奥行き（絵の横線）
V1 = [HOLE_B[0], ROOT_Y, H_TRI];            // A梁の根元
V2 = [HOLE_B[0], ROOT_Y - A_LEN, H_TRI];    // A梁の先
V3 = [-LEFT_OUT, LEFT_Y, H_TRI];            // 左の頂点

// 穴Bのボスから出る棒の付け根。**ボスの軸の上ではなく、ボスの面の上で
// A梁と同じ高さになる点**から出す。軸の上（=HOLE_B+NRM*BOSS_T）から出すと、
// ボスが基板の法線方向へ4mm下がるぶん sin15°×4＝1.035mm 低い所から始まるので、
// A梁との継ぎ目が5.17°折れて見えた（2026-08-09・ユーザー指摘）。
// UPB は基板の面内の「上」向き。これに沿ってずらすので、基板との隙間は変わらない
UPB     = [0, -sin(TILT), cos(TILT)];
B_MOUNT = let (p = HOLE_B + NRM * BOSS_T) p + UPB * ((H_TRI - p[2]) / UPB[2]);

// 🟣 検算: 三角の前の斜辺（V1→V3）がヘッダー帯(x2〜20)を通るときのy（-12より後ろが合格）
HDR_Y20 = V1[1] + (V3[1]-V1[1]) * (V1[0]-20) / (V1[0]-V3[0]);
echo("足: 机の面から下へ", LEG_EXT, "mm 伸ばして刷る。三角の棒の下端は机から",
     H_TRI - ROD / 2, "mm ／ 溝は z=0 に深さ", LEG_NOTCH);
echo("斜辺のy @x=20:", HDR_Y20, "（-12より小さければヘッダーの後ろ）");
echo("頂点", APEX, " 左の頂点", V3, " ← 奥行きが揃っているか（V3[1]とAPEX[1]）");

module rod(p, q, d = ROD) { hull() { translate(p) sphere(d = d); translate(q) sphere(d = d); } }

// ============================================================
// 取り付け部（基板座標で作る。世界へは in_board() で回す）
// ============================================================
module in_board() { rotate([TILT, 0, 0]) children(); }

BOARD_R2 = 1.27;   // 📄 四隅のR

// 🔒 ビスは**上から真下へ落とす**（2026-08-09・ユーザー訂正）。基板の面に垂直ではない。
//    カバーの上壁を貫き、基板の裏にあるフレームの塊（PAD）を上下に貫通する。
//    重力の向きに挿さるので、**締めなくても抜けない**。ナットは効きを足すためだけ
PAD_TOP = respeaker_H() + 0.20;   // 塊の上面。基板の上辺より0.2高い（カバーの上壁は
                                  // 基板の縁ではなくこの面に着地する。基板を踏まない）
PAD_Z0  = 27.5;   // 塊の下端。⚠ ピンヘッダー上列の**上端は27.007**（34.007−8−1に厚み2を
                  // 足した値。「上から8」は列の下端であって上端ではない）。0.49だけ空ける。
                  // 27.0にしたら0.007mm食い込んだ（2026-08-09・checkで発覚）
PAD_X   = [-0.6, 5.55];           // 塊の左右。⚠ R14・C59（左5.83から）に0.28空ける
PAD_Y   = [0, -6.4];              // 基板の裏面から6.4奥まで。x を5.55で止めてあるので
                                  // 裏面まで詰めてよい（部品は左5.83より右にしか無い）
SCR     = [2.492, -3.6];          // 落とすビスの軸（x, y）。穴Aの真上、板から3.6奥

// 穴Bの取り付けも四角にする（2026-08-09・ユーザー指摘「円柱である必要が無い」）。
// 基板の面が広い四角、奥がすぼまる**台形の四角柱**。奥の面の真ん中からA梁の棒が出る。
// 上のブロックが基板の上辺に面一なのと対で、こちらは**下辺に面一**にしてある。
// 逃げ（📄公式CADで実測）: 上は C16（下から6.07・出1.69）に 0.27 ／
// 右は FB3（左66.02）に 0.82 ／ 左は R25（左54.36）に 0.84
// 🔒 左は**すぼめない（垂直）**。R25（左53.86〜54.36）が近いので、左へ広がる面を
//    作らない。すぼめるのは右と下だけ（右はFB2/FB3まで広く空いている）
PB_F = [56.4, 65.2, 0.0, 5.80];   // 基板に当たる面 [x0, x1, z0, z1]
PB_B = [56.4, 62.8, 1.3, 5.80];   // 奥の面。ここから棒が出る（棒はφ4で z 1.73〜5.73）

// 基板の輪郭（xz平面の2D）。sh>0 で内側へ縮み、sh<0 で外へ膨らむ
module board_2d(sh = 0) {
    translate([BOARD_R2, BOARD_R2]) offset(r = BOARD_R2 - sh)
        square([respeaker_L() - 2 * BOARD_R2, respeaker_H() - 2 * BOARD_R2]);
}
// 輪郭を y 方向へ押し出した角柱。y は ystart から len だけ -Y 側へ伸びる
module board_prism(sh, ystart, len) {
    translate([0, ystart, 0]) rotate([90, 0, 0]) linear_extrude(len) board_2d(sh);
}
// 基板の面に垂直な丸棒。p は基板座標の[x,z]、y0 から -Y へ len
module y_rod(p, d, y0, len) {
    translate([p[0], y0, p[1]]) rotate([90, 0, 0]) cylinder(d = d, h = len);
}

// 穴に挿すペグ。先を細らせて入りやすくする。
// out<0 は穴の中で終わる長さ。**穴Aは前へ出さない**（カバーが上から下りてくるので、
// 出ているとカバーの前板に当たり、逃げ溝を上まで抜かないと組めなくなる）
module peg(p, out = PEG_OUT) {
    L = BT + out;
    translate([p[0], -0.01, p[1]]) rotate([-90, 0, 0]) {
        cylinder(d = PEG_D, h = L - 0.4 + 0.01);
        translate([0, 0, L - 0.4 + 0.01]) cylinder(d1 = PEG_D, d2 = PEG_D - 0.7, h = 0.4);
    }
}

// 基板と平行な薄い板。r = [x0, x1, z0, z1]、面の位置は y
module slab(r, y) { translate([r[0], y - 0.01, r[2]]) cube([r[1]-r[0], 0.01, r[3]-r[2]]); }

// 基板の裏を受ける塊。**円柱はやめて全部四角にした**（2026-08-09）。
// 穴A側は素の四角柱、穴B側は奥がすぼまる台形の四角柱
module mount() {
    difference() {
        union() {
            translate([PAD_X[0], PAD_Y[1], PAD_Z0])          // 穴A側
                cube([PAD_X[1] - PAD_X[0], PAD_Y[0] - PAD_Y[1], PAD_TOP - PAD_Z0]);
            hull() { slab(PB_F, 0); slab(PB_B, -BOSS_T); }   // 穴B側
        }
        translate([-300, -300, PAD_TOP]) cube([600, 600, 600]);   // 上面を PAD_TOP で揃える
        pin_hole();
    }
}

// 🔒 横向きのビスを受ける、台座側のナットポケットとビス先の逃げ。**貫通させない。**
// 右（+X）へ抜くと R14・C59（左5.83）へ 0.28mm しか無い側へ出てしまう。
module pin_hole() {
    // 🔒 **塊を左右に貫通する。** 右へ抜けた先は基板から 3.2mm 奥なので、
    //    R14・C59（基板の面に載る背の低いチップ）より奥で、空いている
    translate([PAD_X[0] - 1, PIN_Y, PIN_Z]) rotate([0, 90, 0])
        cylinder(d = SCREW_D, h = PAD_X[1] - PAD_X[0] + 2);
    // 🔴 **ナットは「角を下」にして落とす**（2026-08-10・ユーザー指摘で作り直し）。
    //
    // 🔴 作り直した理由。旧版は六角ポケットを**平を下**に向けて切ってあった。
    //    平を下にした六角を上から覗くと、開口は**上の平の幅しかない＝2.483mm**である。
    //    ナットは二面幅4.0・対角4.619なので、どう向けても2.483は通らない。
    //    上のラッパは口を広げているだけで、その下は塞がっていた。**落ちるわけがない形。**
    //    ⚠ そもそも「平を下に向けた六角ポケット」には上から入れられない。
    //      ポケットが一番細くなるのが真上だからで、寸法をいじっても直らない
    //
    // **いまの形**: 二面幅ぴったりの**真っ直ぐな溝**の底を、ナットの角と同じ
    //   **120°のV**で閉じる。上から落とすと、Vが最後に姿勢と位置を決める。
    //   ・落ちる … 角を下にしたナットの幅は二面幅 4.0。溝は 4.3 なので通る
    //   ・回らない … 回るには対角 4.619 が要る。溝は 4.3 しかないので回れない。
    //     🔒 回り止めは六角の形ではなく**溝の幅**が持つ。だから溝は絶対に広げない
    //   ・座る … 🔴 底は平ではなく**V**（2026-08-10・ユーザー指摘）。平の床だと
    //     ナットは底の角1点で立つので、溝の遊び 0.15 のぶんどちらかへ倒れる。
    //     Vなら下の2面が受けるので、左右も高さも V が決める（自分で真ん中に座る）
    //   ・高さが出る … Vの谷を「角下で立てたナットの中心がビスの軸に乗る」高さに置く
    //   ⚠ 溝は上面まで開けっぱなしで、蓋はしない。ナットを押さえるのはVとビスである
    //
    // Vの谷から一番広い所（＋NUT_R）までがV。そこから上は真っ直ぐな溝
    translate([PAD_X[1] - NUT_T, PIN_Y, NUT_FLOOR + NUT_R]) rotate([0, 90, 0])
        cylinder(d = NUT_AF / cos(30), h = NUT_T + 0.01, $fn = 6);   // 角が下（回さない）
    translate([PAD_X[1] - NUT_T, PIN_Y - NUT_AF / 2, NUT_FLOOR + NUT_R])
        cube([NUT_T + 0.01, NUT_AF, PAD_TOP - NUT_FLOOR - NUT_R]);
    // 口だけラッパに開いて、ナットを拾いやすくする（上面から 0.5 の深さだけ）
    hull() {
        translate([PAD_X[1] - NUT_T, PIN_Y - NUT_AF / 2, PAD_TOP - 0.5])
            cube([NUT_T + 0.01, NUT_AF, 0.01]);
        translate([PAD_X[1] - NUT_T - 0.30, PIN_Y - NUT_AF / 2 - 0.30, PAD_TOP - 0.01])
            cube([NUT_T + 0.61, NUT_AF + 0.60, 0.01]);
    }
}

// 🟣 **ナットが本当に上から落ちるかの検査**（SHOW="checkdrop"・2026-08-10）。
// 実物寸法の M2ナット（二面幅4.0・対角4.6188・厚み1.6）を、座る位置から上面より
// 上まで真っ直ぐ持ち上げた通り道を作る。これがフレームやカバーと**当たらなければ
// 落ちる**。ラッパの口の広さや溝の幅を目で見て納得するのではなく、
// 「ナットそのものを通してみる」ので、形の読み違いに引っかからない
NUT_AC0 = 4.0 / cos(30);          // 実物ナットの対角 4.6188（回り止めの根拠）
module nut_drop_path() {
    hull() for (dz = [0, PAD_TOP + 3 - PIN_Z])
        translate([PAD_X[1] - 1.6, PIN_Y, PIN_Z + dz]) rotate([0, 90, 0])
            cylinder(d = NUT_AC0, h = 1.6, $fn = 6);   // 角が下（回転させない）
}

// ビスとナットが基板に当たらないかを見るための当たり（SHOW="checkpin"）。
// ⚠ 形は M2 の外形そのままで、ゆるみは見ていない
module pin_probe() {
    translate([LOCK_WX[0], PIN_Y, PIN_Z]) rotate([0, 90, 0]) {
        cylinder(d = 2.0, h = PAD_X[1] - LOCK_WX[0] + 1.0);   // ねじ部
        cylinder(d = 3.8, h = CV_CB_H);                        // 頭
    }
    translate([PAD_X[1] - NUT_T, PIN_Y, PIN_Z]) rotate([0, 90, 0])
        cylinder(d = NUT_AC0, h = 1.6, $fn = 6);               // ナット（**角が下**）
}

// 抜け止めの庇。塊の背面から後ろへ出て立ち上がり、上で前へ折り返して
// カバーの上壁の後ろの縁に被さる。**全部 y<0（基板の裏側）にあるので正面に出ない。**
// ⚠ B梁（x 0.492〜4.492・z 29.577〜33.577）と重なるが、どちらもフレームなので
//    溶け合うだけ。むしろ庇の付け根が太くなる
module members() {
    rod(V1, V2);                            // A梁（水平）
    rod(V2, V3); rod(V3, V1);               // 三角の残り
    rod(V1, APEX); rod(V2, APEX); rod(V3, APEX);   // 頂点へ登る3本
    rod(B_S, B_E);                          // B梁（基板に垂直・余り付き）
    rod(B_MOUNT, V1);                       // 穴Bのボス→A梁の根元（A梁と一直線）
    // 足。**机の面より LEG_EXT だけ下へ伸ばして刷る**（切って詰める）
    for (v = [V1, V2, V3])
        translate([v[0], v[1], -LEG_EXT]) cylinder(d = ROD + 1.5, h = H_TRI + LEG_EXT);
}

// 足に入れる、切る位置の溝。外側から LEG_NOTCH だけ削るリング
module leg_notch() {
    difference() {
        cylinder(d = ROD + 1.5 + 4, h = 0.6, center = true);
        cylinder(d = ROD + 1.5 - LEG_NOTCH * 2, h = 2, center = true);
    }
}


// 打ち合わせ用: 接地しうる点に番号を振る（SHOW="pts"）。
// 裏返しの姿勢で机に着く3点を、写真ではなく番号で指してもらうため
PTS = [
    [V1, "1"], [V2, "2"], [V3, "3"],
    [APEX, "4"], [B_S, "5"], [B_MOUNT, "6"],
    [[V1[0], V1[1], -LEG_EXT], "7"], [[V2[0], V2[1], -LEG_EXT], "8"],
    [[V3[0], V3[1], -LEG_EXT], "9"],
    [(V1 + V2) / 2, "10"], [(V2 + V3) / 2, "11"], [(V3 + V1) / 2, "12"],
    [(V1 + APEX) / 2, "13"], [(V2 + APEX) / 2, "14"], [(V3 + APEX) / 2, "15"],
    [(B_S + APEX) / 2, "16"],
];
module pts_labels() {
    for (p = PTS) {
        color("#e00") translate(p[0]) sphere(d = 3.4);
        color("#000") translate(p[0] + [0, 0, 4.6]) rotate([90, 0, 0])
            linear_extrude(0.8) text(p[1], size = 6, halign = "center");
    }
}

module frame() {
    difference() {
        union() { in_board() { mount(); peg(HA2, PEG_OUT_A); peg(HB2); } members(); }
        // 穴は mount() の中で開けている。ここでも同じ穴をもう一度通しておく
        // （B梁の根元が塊に飲み込まれるので、梁が穴を塞いでしまう）
        in_board() pin_hole();
        // 足の切りしろの下端で切る（机の面ではない。LEG_EXT だけ下）
        translate([-300, -300, -100 - LEG_EXT]) cube([600, 600, 100]);
        // 🔒 切る位置を示す溝。**机の面（z=0）に1周**。ニッパーの刃が逃げない
        for (v = [V1, V2, V3]) translate([v[0], v[1], 0]) leg_notch();
    }
}

// ============================================================
// 角カバー（別部品・基板座標）― 額縁の角当てのL字
// ============================================================
// 上から落として被せる。前板が基板の抜けを止め、上壁が塊の上面に着地し、
// そこへ**上からビスを落とす**。ビスは重力の向きに挿さるので、締めなくても抜けない
CV_T    = 1.8;    // 板の厚み（前板・スカート）
// 🔴 天井だけ厚くする（2026-08-10・ユーザー指示）。プレートに立てて刷ると、
//    額縁の板が終わる高さから上は**天井の板1枚しか無い**。そこが 1.8mm だと
//    14mm ぶんヒレのように立つことになるので、折れるならそこである。
//    ⚠ 厚くした分だけカバーの一番上（CV_ZT）が上がる。正面から見える
//      上のレールが太くなるので、増やしすぎないこと
CV_TT   = 2.6;    // 天井の厚み
CV_CLR  = 0.15;   // 基板との隙間
CV_OUT  = 2.8;    // 基板の左端より外へ出る量
CV_ARM  = 7.6;    // 前板の腕の幅。ペグの逃げ溝の脇に壁1.0を残す量で決まる
CV_LX   = 14.0;   // 上辺に沿った腕の長さ
CV_Z0   = 24.5;   // 左辺に沿った腕の下端。⚠ XIAOのUSB-C（下から14〜23）を避ける
// ⚠ 上壁の後ろ端 CV_BACK は、後ろの壁の位置 LOCK_BY から決まるので、
//    LOCK_BY を定義したあと（下の「抜け止めは庇が受ける」の節）で代入している
CV_TX1  =  7.4;   // 後ろの壁の右端。塊の右端(6.6)より0.8外。
                  // ⚠ ここは伸ばさない。後ろの壁は基板の裏側 z27.5〜34.207 に立つ板なので、
                  //    右へ伸ばすと XIAO やヘッダーの側へ入っていく
// 🔴 **上壁だけは大きく伸ばす**（2026-08-10・ユーザー指示）。理由は下のナットの窓。
//    窓を開けるぶん上壁が弱るので、窓のまわりに桁が残る長さまで伸ばして受ける。
//    長さは「額縁の横幅の倍くらい」＝ 左端(-CV_OUT)から CV_LX の2枚ぶん
CV_TOPX = -CV_OUT + CV_LX * 2;   // 上壁の右端（25.2）
CV_FR   = BT + CV_CLR;          // 前板の内面 y=BT+0.15（板厚1.85で2.00）
CV_ZT   = PAD_TOP + CV_TT;      // カバーの一番上（天井の厚みで決まる）

// ============================================================
// 🔒 抜け止めは庇（ひさし）が受ける ― 上から落とすのをやめ、左右に差し込む
//    （2026-08-10・ユーザー指摘で作り直し）
// ============================================================
// 🔴 **作り直した理由。** 旧版はビスの頭とナットが**どちらもカバーの上壁の側**にあり、
//    頭とナットで挟んでいるのが**カバーの上壁1枚だけ**だった。フレームの塊は挟み込みの
//    経路に入っておらず、ナットのポケットは上が開いている。**上へ引くとナットごと
//    抜けた**（実機で発生）。寸法ではなく積み方の間違い。
//
// **いまの受け方**: フレームから庇を出し、カバーの上壁の後ろの縁に**上から 1.0mm 被せる。**
//   ・上へ引く力 … 庇が受ける（フレームの一部なのでそこで止まる）
//   ・左へ戻る力 … ビスが受ける。**せん断**であって引っ張りではない
//   ・ナットとビスは旧版のまま触らない。カバーが持ち上がらない以上ナットも上がれない。
//     ✅ 実機で「M2ナットがピッタリ入った」と確認済みの寸法を壊さずに済む
//
// **差し込む向き**: 🔒 基板の左端の外から、基板の側へ押し込む（**+X**）。
//   見ている向きでは右から左。スカートの内面が基板の左端に当たって止まり、
//   それがそのまま位置決めの止まりになる。行程のあいだスカートは基板と重ならない
//
// **正面の見え方は変えない**（ユーザーの唯一の条件）。庇はカバーの上壁に掘った座ぐりへ
//   収まるので、**カバーの一番上は CV_ZT のまま**。庇も背板も基板の裏側にしか無い
// 🔒 **ビスは横向き**（2026-08-10・ユーザーの断面図）。ここが全部の要である。
//   縦に立てたビスは、ナットが台座の下面を掴めない限り抜け止めにならない。
//   台座の真下は 0.49mm でピンヘッダーなので、そこにナットは置けない。
//   横向きなら、上へ引く力は**ビスの軸を横切る＝せん断**で受ける。
//   ナットが引っ張られる経路がそもそも生まれないので、この問題は消える
LOCK_WX  = [-2.80, -0.80];       // ロックの端の壁。外面は -CV_OUT と面一なので
                                 // **正面の額縁の出寸法は変わらない**。厚み 2.0
LOCK_CLR = 0.25;                 // 台座とトンネルのすき間（差し込みの遊び）
LOCK_BW  = 1.50;                 // 後ろの壁の厚み
LOCK_BY  = PAD_Y[1] - LOCK_CLR - LOCK_BW;   // 後ろの壁の外面（-8.15）
// 🔴 上壁の後ろ端は**後ろの壁の外面と面一**にする（2026-08-10・ユーザー指摘）。
//    以前は -7.0 で止めてあった。あれは庇（ひさし）をこの縁に被せるつもりだった
//    ときの寸法で、庇は却下されて外れたのに、この値だけが残っていた。後ろの壁は
//    -8.15 まで出ているので、差の 1.15mm が、深さ 1.8mm（上壁の厚み）の溝として
//    後ろ端に沿って残っていた。何も受けていない段差なので、面一にして埋める
CV_BACK  = LOCK_BY;              // 上壁の後ろ端＝後ろの壁の外面
PIN_Y    = -3.20;                // ビスの軸 y（塊の奥行き 0〜-6.4 の中央）
PIN_Z    = 31.00;                // ビスの軸 z（塊の 27.5〜34.207 の中）
// 🔒 **Vの谷**。角を下にして立てたナットの中心が、ちょうどビスの軸に乗る高さに置く。
//    実物ナットは対角 4.6188 なので、谷から中心までが半分の 2.3094。
//    ⚠ Vもナットの角も同じ120°なので、ナットの下の2面は V の面にそのまま乗る。
//      逃げが要らないのではなく、**Vは逃げを持てない**（同じ角度の谷は必ず面で合う）。
//      刷って谷がわずかに狭ければナットが少し高く座るだけで、食い込みはしない
NUT_FLOOR = PIN_Z - NUT_AC0 / 2;          // 28.691（谷の下に残る肉は下の echo）
NUT_R     = NUT_AF / cos(30) / 2;         // 溝の外接半径 2.4826（Vの高さでもある）
// ナットの溝は**塊の右の面（x=5.55・基板の裏の空きへ向く）で開いている**。
// 締めるとビスはナットを頭の側（-X）へ引くので、溝が右で開いていても抜けない。
// ⚠ 壁の検算は下の echo（y側 1.05 が最小）
//
// 🔴 **ナットの窓**（2026-08-10・ユーザー指摘）。フレーム側の落とし込み溝の
//    真上をカバーの上壁が丸ごと塞いでいて、上から落とせなかった。上壁を抜いて通す。
//    ・カバーを差してからナットを落とせる／落ちたかを目で見て確かめられる
//    ・ビスを抜いてもナットを上から取り出せる
NUT_WIN_MX = 0.95;   // 窓を溝（x 3.65〜5.55）より広げる量・片側
NUT_WIN_MY = 0.90;   // 窓を溝（y ±NUT_AF/2）より広げる量・片側
NUT_WIN_R  = 0.80;   // 窓の角の丸み
NUT_WIN_X  = [PAD_X[1] - NUT_T - NUT_WIN_MX, PAD_X[1] + NUT_WIN_MX];        // 2.70〜6.50
NUT_WIN_Y  = [PIN_Y - NUT_AF / 2 - NUT_WIN_MY, PIN_Y + NUT_AF / 2 + NUT_WIN_MY]; // -6.25〜-0.15

// 🟣 検算（このロックが成り立つかはこの4つで決まる）
echo("塊: x", PAD_X, " y", PAD_Y, " z", PAD_Z0, "〜", PAD_TOP, " ビス軸", SCR);
// ⚠ 旧「ナットの壁」の echo は六角ポケット（平が下）を前提にした式だったので消した。
//    いまの溝の検算は下の「ナットの溝」「ナットまわりの壁」を見ること
echo("穴Bの台形: 手前", PB_F, " 奥", PB_B,
     " 棒はz", 3.7288 - ROD/2, "〜", 3.7288 + ROD/2, "（奥の面の中）");
echo("左のR25(左54.36まで)への逃げ:", PB_F[0] - 54.36, "mm");
echo("ペグ: 穴A 全長", BT + PEG_OUT_A, "（前へ", PEG_OUT_A, "）／ 穴B 全長", BT + PEG_OUT,
     "（前へ", PEG_OUT, "）／ カバーの前板の残り肉", CV_T - (BT + PEG_OUT_A + 0.3 - CV_FR));
echo("穴A側の塊 → R14・C59(左5.83)への逃げ:", 5.83 - PAD_X[1],
     "mm（左右で逃がしている。奥行きでは逃げていないので裏面まで詰めてよい）");
echo("上壁と基板の上辺の隙間:", PAD_TOP - respeaker_H());
echo("横ビス: 頭の座 x=", LOCK_WX[0] + CV_CB_H, " ナットの向こう端 x=", PAD_X[1],
     " → 最低", PAD_X[1] - (LOCK_WX[0] + CV_CB_H), "mm（**M2×8**）");
echo("ナットの溝: 幅", NUT_AF, "（角下ナットの幅 4.0 は通り、回るのに要る対角",
     NUT_AC0, " は通らない → 回り止め成立: ", NUT_AF < NUT_AC0, "）",
     " ／ Vの谷 z=", NUT_FLOOR, "（ナットの中心 z=", NUT_FLOOR + NUT_AC0 / 2,
     " ＝ビスの軸か: ", abs(NUT_FLOOR + NUT_AC0 / 2 - PIN_Z) < 1e-9, "）",
     " 溝の高さ", PAD_TOP - NUT_FLOOR, " ／ 谷の下の肉", NUT_FLOOR - PAD_Z0);
echo("ナットまわりの壁: y側", (PAD_Y[0] - PAD_Y[1]) / 2 - NUT_AF / 2,
     " ／ 溝の x", [PAD_X[1] - NUT_T, PAD_X[1]], "（右の面で開いている）");
echo("端の壁: x", LOCK_WX, " 厚み", LOCK_WX[1] - LOCK_WX[0],
     " 塊の左面(-0.6)とのすき間", PAD_X[0] - LOCK_WX[1],
     " ／ 外面は -CV_OUT(", -CV_OUT, ") と面一か: ", LOCK_WX[0] == -CV_OUT);
// ⚠ ザグリが入るのは**端の壁**（厚み LOCK_WX の 2.0）であって、上壁ではない。
//    旧版は上壁の厚みで残り肉を計算していたが、ビスが横向きになった時点で場所が変わっている
echo("カバー: 前板の厚み", CV_T, " 天井の厚み", CV_TT,
     " → 一番上 z=", CV_ZT, "（基板の上辺より", CV_ZT - respeaker_H(), "高い）");
echo("ザグリ: 入る壁の厚み", LOCK_WX[1] - LOCK_WX[0], " ザグリ", CV_CB_D, "×", CV_CB_H,
     " → 残り肉", (LOCK_WX[1] - LOCK_WX[0]) - CV_CB_H);
echo("上壁の右端 x=", CV_TOPX, "（額縁", CV_LX, "の", (CV_TOPX + CV_OUT) / CV_LX, "倍）",
     " ／ 後ろの壁の右端 x=", CV_TX1);
echo("ナットの窓: x", NUT_WIN_X, " y", NUT_WIN_Y,
     " → ", NUT_WIN_X[1] - NUT_WIN_X[0], "×", NUT_WIN_Y[1] - NUT_WIN_Y[0],
     " ／ ナットの対角", NUT_AF / cos(30), "・厚み", NUT_T, " が通るか: ",
     (NUT_WIN_X[1] - NUT_WIN_X[0] > NUT_T) && (NUT_WIN_Y[1] - NUT_WIN_Y[0] > NUT_AF / cos(30)));
echo("窓のまわりに残る上壁: 前", CV_FR + CV_T - NUT_WIN_Y[1], " 後ろ", NUT_WIN_Y[0] - CV_BACK,
     " 左", NUT_WIN_X[0] - (-CV_OUT), " 右", CV_TOPX - NUT_WIN_X[1]);

module cover_2d() {   // 前板のL字（xz平面）
    offset(r = -1.2) offset(r = 1.2)
    union() {
        translate([-CV_OUT, CV_Z0])          square([CV_ARM, CV_ZT - CV_Z0]);
        translate([-CV_OUT, CV_ZT - CV_ARM]) square([CV_LX,  CV_ARM]);
    }
}

// 内側の当たり玉。カバーは重力では留まらないので、ビスを落とす前に手を離しても
// 落ちないようにする。球にしてあるのは、下ろすときの当たりを自然に逃がすため
CV_NIP = 0.12;   // 基板へ食い込ませる量（片側）
module cover_nips() {
    translate([CV_NIP - 0.45, 0.90, 28.0]) sphere(d = 0.9);   // 基板の左の縁を押す
    translate([8.0, BT - CV_NIP + 0.45, 32.5]) sphere(d = 0.9);   // マイク面を押す
}

// nip=false は当たり検査用（玉は**わざと**基板へ0.12食い込ませてある）
module cover(nip = true) {
    if (nip) cover_nips();
    difference() {
        union() {
            // 前板（額縁のL字）
            translate([0, CV_FR + CV_T, 0]) rotate([90, 0, 0]) linear_extrude(CV_T) cover_2d();
            // 上壁。基板の上辺をまたいで後ろへ伸び、塊の上面に着地する。
            // 🔴 右へは CV_TOPX まで（額縁の横幅の2倍）。ナットの窓の右に桁を残すため
            translate([0, 0, PAD_TOP]) linear_extrude(CV_TT)
                offset(r = -1.0) offset(r = 1.0)
                translate([-CV_OUT, CV_BACK]) square([CV_TOPX + CV_OUT, CV_FR + CV_T - CV_BACK]);
            // 左のスカート（基板の左の縁を挟む。基板の裏面までで止める）
            translate([-CV_OUT, 0.10, CV_Z0])
                cube([CV_OUT - CV_CLR, CV_FR + CV_T - 0.10, PAD_TOP - CV_Z0]);
            // 🔒 端の壁。**ここに横向きのビスが通る。** 基板の左端より外にあるので
            //    基板にも部品にも当たらない。前板・スカートと繋がって端の面になる
            translate([LOCK_WX[0], LOCK_BY, CV_Z0])
                cube([LOCK_WX[1] - LOCK_WX[0], CV_FR + CV_T - LOCK_BY, PAD_TOP - CV_Z0]);
            // 🔒 **後ろの壁。台座が入る筒（トンネル）を閉じる面**
            //    （2026-08-10・ユーザー指摘「これが無い」）。
            //    前＝基板と前板／上＝上壁／後ろ＝ここ／端＝端の壁 でコの字になり、
            //    台座を横から差し入れて受ける。**下は開けたまま**
            //    （台座の下 0.49mm がピンヘッダーで、壁を置く隙間が無い）
            translate([LOCK_WX[0], LOCK_BY, PAD_Z0])
                cube([CV_TX1 - LOCK_WX[0], LOCK_BW, PAD_TOP - PAD_Z0]);
        }
        // 台座の通り道。**差し込む向き（+X）へ抜く**
        translate([LOCK_WX[1], PAD_Y[1] - LOCK_CLR, PAD_Z0 - 1])
            cube([40, (PAD_Y[0] - PAD_Y[1]) + LOCK_CLR * 2, PAD_TOP - PAD_Z0 + 1 + LOCK_CLR]);
        // B梁の通り道。台座の背面から後ろへ出る棒。**同じく +X へ抜く**
        hull() for (dx = [0, 40])
            translate([HA2[0] + dx, PAD_Y[1], HA2[1]]) rotate([90, 0, 0])
                cylinder(d = ROD + LOCK_CLR * 2, h = 20);
        // 穴Aのペグの逃げ溝。🔴 **抜く向きを +X へ直した**（2026-08-10・v6が入らなかった原因）。
        //    カバーは +X へ押し込むので、**カバーから見るとペグは右（+X）から入ってくる。**
        //    台座のトンネルもB梁の通り道も +X へ抜いてあるのに、この溝だけ -X へ
        //    抜けていて、前板の右側（x 3.79〜11.2）がペグの通り道を塞いでいた。
        //    実機では座る 9.7mm 手前で止まる（掃引検査 checkin: t=1〜8 で当たり・t=0 は空）。
        //    溝はペグの左 0.3 から前板の右端の外まで通す。前板の残り肉 0.95 は変わらない
        translate([HA2[0] - 1.3, CV_FR - 0.06, HA2[1] - 1.3])
            cube([30, BT + PEG_OUT_A + 0.3 - (CV_FR - 0.06), 2.6]);
        // ⚠ 庇の座ぐりも却下に伴い外した（2026-08-10）
        // 🔴 ナットの窓。フレームのラッパの口の真上を上壁ごと抜いて、
        //    組んだ後でもナットを落とし込めるようにする
        translate([0, 0, PAD_TOP - 1]) linear_extrude(CV_TT + 2)
            offset(r = NUT_WIN_R) offset(r = -NUT_WIN_R)   // 角を丸める（開き）
            translate([NUT_WIN_X[0], NUT_WIN_Y[0]])
                square([NUT_WIN_X[1] - NUT_WIN_X[0], NUT_WIN_Y[1] - NUT_WIN_Y[0]]);
        // 🔒 横向きのビスの通し穴と、頭のザグリ（端の壁の外の面）
        translate([LOCK_WX[0] - 1, PIN_Y, PIN_Z]) rotate([0, 90, 0])
            cylinder(d = CV_SCR_D, h = LOCK_WX[1] - LOCK_WX[0] + 2);
        translate([LOCK_WX[0] - 0.01, PIN_Y, PIN_Z]) rotate([0, 90, 0])
            cylinder(d = CV_CB_D, h = CV_CB_H + 0.01);
    }
}

module board() { rotate([TILT, 0, 0]) respeaker_lite(); }

// ============================================================
// 🔒 裏返しの姿勢（2026-08-10・ユーザー）— **XIAO面を上にして、基板を水平近くで見せる**
// ============================================================
// 机に着くのは **A梁の先(V2) / 左の頂点(V3) / 四面体の頂点(APEX)** の3点。
// 四面体のもう一つの面で立つということ。立てた姿勢が三角(V1V2V3)で立つのと対になる。
// 🔴 **ここから下の flip / checkflip / flipfoot は「本物の裏返し」ではない**
//    （2026-08-10・ユーザー指摘）。立てた状態の組み立てを、そのまま回しているだけである。
//    実際の裏返しは**別の取り付け方**で、次の2つが違う:
//      ・**ロックは使えない**（額縁のカバーはこの置き方では効かない）
//      ・**基板を挿す穴の位置が変わる**（＝ペグを別に立てる必要がある）
//    ⬜ 裏返し側のペグ位置と抜け止めは未設計。決まるまで、この姿勢での当たり検査は
//    「回しただけの姿」を見ているにすぎないので、合否の根拠に使ってはいけない。
//    ⚠ 足も元の設計には無い（印刷対策で 2026-08-10 に足したもの）。
//    元の四面体は 2・3・4 の3点で立つ形である
function rodr(v, k, a) = v * cos(a) + cross(k, v) * sin(a) + k * ((k * v) * (1 - cos(a)));
FN    = cross(V3 - V2, APEX - V2);
FNS   = (FN * (V1 - V2) > 0) ? FN : -FN;        // 残る頂点(V1)の側を正にする
NF    = FNS / norm(FNS);
FAX   = cross(NF, [0, 0, 1]);
FAXN  = norm(FAX) < 1e-9 ? [1, 0, 0] : FAX / norm(FAX);
FANG  = acos(NF * [0, 0, 1]);
FZ0   = rodr(V2, FAXN, FANG)[2];
// ⚠ 2・3・4 は**棒の中心線が通る点**であって、机に着くのは棒と足の**表面**である。
//    中心線の面で机に置くと 2.58mm 食い込む（2026-08-10・checkflip で発覚）。
//    その分だけ持ち上げる。この値はモデルから実測した:
//      openscad -o f.stl -D 'SHOW="checkflip"' stand_ab.scad → STL の z の最小値
//    🔴 トラスの棒径・足径・頂点の位置を変えたら**取り直すこと**
FDROP = 2.58;
module flip() { translate([0, 0, -FZ0 + FDROP]) rotate(FANG, FAXN) children(); }

// 足の切りしろを落とした本番の姿（裏返しの検査はこれで見る）
module frame_cut() {
    difference() { frame(); translate([-300, -300, -100]) cube([600, 600, 100]); }
}

FNB = rodr(NRM, FAXN, FANG);                     // 裏返した後の基板の法線
echo("裏返し: 回転", FANG, "度 ／ 基板の法線", FNB,
     " ／ 基板の面が水平から", acos(abs(FNB[2])), "度（0なら真水平）");

module above_desk() { intersection() { children(); translate([-300, -300, 0]) cube([600, 600, 200]); } }

if (SHOW == "assembly") { board(); color("#c94") frame(); color("#e83") in_board() cover(); }
else if (SHOW == "colors") {
    board();
    color("red")   above_desk() { rod(V1, V2); rod(V2, V3); rod(V3, V1); }
    color("green") above_desk() { rod(V1, APEX); rod(V2, APEX); rod(V3, APEX); }
    color("blue")  above_desk() rod(B_S, B_E);
    color("#c94")  { in_board() mount(); above_desk() rod(B_MOUNT, V1); }
    color("#e83")  in_board() cover();
}
else if (SHOW == "nocover") { board(); color("#c94") frame(); }   // 塊とナットの穴を見る
// B梁の上に目盛りを打つ（頂点の位置を数字で決めるための打ち合わせ用）
else if (SHOW == "ruler") {
    board(); color("#c94") frame();
    for (i = [0 : 7]) {
        t = 5 + i * 5;
        p = B_S + NRM * t;
        color("#e00") translate(p) sphere(d = 3.2);
        color("#e00") translate(p + [3.5, 0, 0]) linear_extrude(0.6) text(str(t), size = 4.5);
    }
}
// 部材を色分けして名前を確認するための表示（打ち合わせ用）
else if (SHOW == "named") {
    board();
    color("#e0e")   above_desk() rod(V1, V2);                  // A梁
    color("#0cc")   above_desk() { rod(V2, V3); rod(V3, V1); } // 三角の残り2本
    color("#2a2")   above_desk() { rod(V1, APEX); rod(V2, APEX); rod(V3, APEX); }
    color("#00f")   above_desk() rod(B_S, B_E);                // B梁
    color("#fa0")   above_desk() rod(B_MOUNT, V1);
    color("#888")   in_board() mount();
    for (v = [V1, V2, V3]) color("#ccc")
        translate([v[0], v[1], 0]) cylinder(d = ROD + 1.5, h = H_TRI);
}
else if (SHOW == "flip") flip() { board(); color("#c94") frame_cut(); color("#e83") in_board() cover(); }
// 裏返したときに机へ食い込むものが無いか（3点以外が z<0 へ出ていないか）
else if (SHOW == "checkflip") intersection() {
    flip() { board(); frame_cut(); in_board() cover(); }
    translate([-300, -300, -100]) cube([600, 600, 100 - 0.05]); }
// 裏返しで**実際にどこが接地しているか**。0.05mm 押し込んだときに残る塊を見る。
// 塊が3つなら3点で立っている。2つならその2箇所で当たっていて、残り1点は浮いている
else if (SHOW == "flipfoot") intersection() {
    flip() { board(); frame_cut(); in_board() cover(); }
    translate([-300, -300, -100]) cube([600, 600, 100 + 0.05]); }
// ユーザーの断面図と見比べる用: 基板を消して、ロックと台座とビスだけ
else if (SHOW == "lockonly") { color("#333") in_board() mount();
                               color("#e83", 0.30) in_board() cover(false);
                               color("#d00") in_board() pin_probe(); }
else if (SHOW == "pts") { color("#cc9") frame(); pts_labels(); }
else if (SHOW == "part")  frame();
// 🔴 カバーは**端の壁の外面（ザグリのある面・x=-CV_OUT）をプレートに伏せて**出す
//    （2026-08-10・ユーザー指示で向きを変えた）。旧版は上壁の外面を下にしていたが、
//    それだとザグリが初層に来ないので、ザグリを入れた意味が無くなっていた。
//    この向きなら、初層で潰れるのはザグリの縁だけで、φ2.7の穴には掛からない
//    （2026-08-09 に実機で穴が塞がってビスが入らなかった件の対策がそのまま効く）。
//    伏せる面は 11.6 × 11.5mm の平面で、そこから +X 方向へ 28mm 立ち上がる
else if (SHOW == "cover") translate([CV_ZT, 0, CV_OUT]) rotate([0, -90, 0]) cover();
// 当たり検査。3つとも「Volume: 0」でなければどこかが食い込んでいる
else if (SHOW == "check")  { intersection() { frame(); board(); }
                             intersection() { in_board() cover(); board(); }
                             intersection() { in_board() cover(); frame(); } }
else if (SHOW == "check1") intersection() { frame(); board(); }
// ビスとナットを入れた状態（打ち合わせ用の表示）
else if (SHOW == "pin") { board(); color("#c94") frame(); color("#e83") in_board() cover();
                          color("#c00") in_board() pin_probe(); }
// ビス・ナットが基板の部品に当たらないか
else if (SHOW == "checkpin") intersection() { in_board() pin_probe(); board(); }
// 3つを別々に見る（checkが空でないとき、どれが当たっているかを1回で切り分ける）
// ⚠ check2 は**必ず nip=false で見る**。当たり玉は基板へわざと 0.12 食い込ませて
//    あるので、cover() のまま見ると毎回「当たっている」ことになって検査にならない
//    （2026-08-10: 下に同名の分岐が死んだまま残っていたのを、こちらへ統合した）
else if (SHOW == "check2") intersection() { in_board() cover(false); board(); }
else if (SHOW == "check3") intersection() { in_board() cover(false); frame(); }
else if (SHOW == "check4") intersection() { frame(); in_board() board_only(); }
else if (SHOW == "check5") intersection() { in_board() mount(); board(); }
else if (SHOW == "check6") intersection() { in_board() { peg(HA2, -0.1); peg(HB2); } board(); }
else if (SHOW == "check7") intersection() { members(); board(); }
// 🟣 ナットが上から落ちるか。**空でなければ落ちない**（当たっている所が出る）
else if (SHOW == "checkdrop")
    in_board() intersection() { union() { mount(); cover(false); } nut_drop_path(); }
// 🟣 **差し込み行程の当たり検査**（2026-08-10・v6が入らなかったのを受けて追加）。
// check系は座った位置しか見ておらず、途中で当たるものを見逃す。カバーを
// T_IN mm 手前（-X）に置いて交差を出す。**空でなければその位置で引っかかる。**
//   openscad -o s.stl --render -D 'SHOW="checkin"' -D T_IN=5 stand_ab.scad
// 数箇所（1・3・5・8 あたり）を見ること。⚠ nip=false で見る（当たり玉は仕様の食い込み）
else if (SHOW == "checkin") intersection() {
    in_board() translate([-T_IN, 0, 0]) cover(false);
    union() { frame(); board(); } }
