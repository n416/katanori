// CHITUBOX に座標をそのまま使わせるための「四隅のアンカー」試験片 ── 2026-08-31
// ============================================================
// 🔴 何のための物か
//   フィルムの同じ所ばかり使わないために、刷る物をプレート上で毎回ずらしたい。
//   ところが CHITUBOX は読み込んだ物の bbox の中心をプレート中央へ置くので、
//   位置を直接は指定できない（chitubox_coord_test.scad で確認済み）。
//
//   🔒 ユーザー案（2026-08-31）:
//     ・**アンカーを一緒に書き出して bbox を決めてしまう**
//     ・**アンカーはプレートの外に置く。**ビルドエリアの外は露光されないので刷られない。
//       ⇒ 読み込んだ後に消す工程すら要らない
//     ・**四隅に 4 個**置いて対称にすると、合わせた bbox の中心がプレート中央と一致する。
//       ⇒ 中央へ寄せられても**何も動かない**＝書き出した座標がそのまま生きる
//
//   ⚠ アンカー 1 個だと、動く量は「アンカーまでの距離の半分」になり、位置ごとに
//     距離を計算し直すことになる。4 個で囲めばその計算自体が要らない。
//   ⚠ 「印刷されないほど小さい点」で bbox をずらす手は採らない。小さい点は硬化しないとは
//     限らず、固まればフィルムに貼り付いた小片になる。守るための細工が傷める側に回る。
//
// ------------------------------------------------------------
// この試験片が潰す問い（本番はこれ）
// ------------------------------------------------------------
//   ① ビルドエリアの**外**にある物を、CHITUBOX は黙って無視するか
//   ② それとも警告を出すか／スライスを拒むか
//   ③ それとも**勝手に縮小して収めるか**   ← これをやられると案は全部おしまい
//   ④ 中の部品は、書き出した座標（下の表）のまま出るか
//
// ------------------------------------------------------------
// 使い方（2 分）
// ------------------------------------------------------------
//   1. stl/test/anchor_test.stl を CHITUBOX に **1 つだけ**読み込む
//   2. 読み込んだ直後に、次の 3 つを見る
//        ・**矢印の板**が右上に出ているか（下の表の位置）
//        ・**穴あきの板**が左下に出ているか
//        ・四隅のアンカー（小さい四角）が**プレートの枠の外**に居るか
//   3. 寸法表示があれば、モデルの大きさが 161.0 x 107.0 のままかを見る
//      （縮小されていたら ③ で不成立）
//   4. スライスしてみて、警告が出るか・通るかを見る
//
// ------------------------------------------------------------
// ✅ 2026-08-31 結果（ユーザーが CHITUBOX Basic V2.3 / ELEGOO Mars 3 で実施）
// ------------------------------------------------------------
//   ✅ **成立した。**
//   ・座標はそのまま生きた（矢印の板が右上、穴あきの板が左下。書き出したとおり）
//   ・アンカー 4 個はプレートの枠の外に赤く出た（＝範囲外の表示）
//   ・縮小されなかった
//   ・スライス時に「モデルは印刷プラットフォームを超えていますが、続行するかどうか?」の
//     警告が出るが、**「はい」で普通にスライスできる**
//   ・⭐ **アンカーは露光されない。**体積がスライス前 3.06ml → スライス後 2.91994ml。
//     差 0.14ml ＝ 140mm³ で、アンカー 4 個（6×6×1 × 4 ＝ 144mm³）とほぼ一致する。
//     層の絵にも部品 2 つしか出ない
//   ⇒ **書き出す STL に四隅のアンカーを入れれば、座標をそのまま渡せる。**
//     移動量を人が CHITUBOX の数値欄に打つ方式は要らなくなる
//
//   読める結果:
//     ✅ 部品が表の位置に出て、アンカーは枠の外、スライスも通る
//        → 案は成立。座標がそのまま渡るので、移動量を打つ工程が消える
//     ❌ 全体が縮小される／スライスを拒まれる → 不成立。移動量を人が数値欄に打つ方式のまま
//     ⚠ 警告は出るが通る → 成立。ただし毎回警告が出ることを覚えておく
//
// ------------------------------------------------------------
// 期待される位置（Mars 3 のプレート 143 x 89・中心を原点とみなす）
// ------------------------------------------------------------
//   矢印の板     … 中心 ( 40,  20)   +X 側へ矢印が出ている
//   穴あきの板   … 中心 (-35, -18)   真ん中に穴
//   アンカー 4 個 … 中心 (±80.5, ±53.5)  ＝ プレートの縁から外へ 6mm ／ 各 6 x 6 x 1
//                    外端は ±80.5 / ±53.5 なので、全体は 161.0 x 107.0
//   ⇒ 4 個は原点対称なので、合わせた bbox の中心は (0, 0) ＝ プレート中央。
//     だから中央へ寄せられても、部品は動かない。
//
// ------------------------------------------------------------
// 焼き方
// ------------------------------------------------------------
//   openscad --backend=manifold -o stl/test/anchor_test.stl hardware/chitubox_anchor_test.scad
//
// ⚠ これは刷る物ではない。読み込んで位置を見るだけの物である。
// ============================================================
$fn = 64;

PLATE = [143.0, 89.0];   // Mars 3
OUT   = 6.0;             // プレートの縁からどれだけ外へ出すか
ANC   = 6.0;             // アンカーの一辺
ANC_T = 1.0;             // アンカーの厚み（見えれば足りる）
T     = 3.0;             // 部品の厚み

PART_A_AT = [ 40,  20];  // 矢印の板
PART_B_AT = [-35, -18];  // 穴あきの板

module part_arrow() {
    translate(PART_A_AT) {
        translate([-15, -10, 0]) cube([30, 20, T]);
        translate([15, 0, 0]) cylinder(d1 = 10, d2 = 0, h = T + 0.01, $fn = 3);
    }
}

module part_hole() {
    translate(PART_B_AT) difference() {
        translate([-12, -9, 0]) cube([24, 18, T]);
        translate([0, 0, -1]) cylinder(d = 9, h = T + 2);
    }
}

// 四隅のアンカー。🔒 **原点対称に 4 個**。1 個でも欠けると bbox の中心がずれる
module anchors() {
    ax = PLATE[0] / 2 + OUT;
    ay = PLATE[1] / 2 + OUT;
    for (sx = [-1, 1], sy = [-1, 1])
        translate([sx * ax - ANC / 2, sy * ay - ANC / 2, 0]) cube([ANC, ANC, ANC_T]);
}

part_arrow();
part_hole();
anchors();

AX = PLATE[0] / 2 + OUT + ANC / 2;
AY = PLATE[1] / 2 + OUT + ANC / 2;
echo(str("アンカーの外端 ±", AX, " / ±", AY, " → 全体の大きさ ", 2 * AX, " x ", 2 * AY));
echo(str("bbox の中心 (0, 0) ＝ プレート中央。だから中央合わせで部品は動かない"));
echo(str("矢印の板 ", PART_A_AT, " ／ 穴あきの板 ", PART_B_AT));
