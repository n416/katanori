//
// ---- v7（2026-08-04・失敗ログ10。支持の設計転換）⚠ **無効。刷らない（失敗ログ11）** ----
//   - datum（基準）は「床＋背もたれの当て面＋突き当て」の3つだけ。溝は基準を降りる
//   - **背もたれ＝当て面**: 面を「座った基板の背面」（素板 y=-0.625）と**同一平面**に置く。
//     触れて支えるのが正・隙間ゼロが設計値。印刷の凸太り+0.1は基板が0.1前へ
//     出るだけで、案内幅が吸収する
//   - **溝は幅11の素通しの案内**（じょうご廃止・口=溝と同幅）。役目は前倒れと
//     横ズレを止めることだけ。面振り分け⚠がどちらへ振れても擦らない
//   - 挿し方: 基板を後傾させて当て面に寝かせ、面に沿って滑り落とす。床に着いたら終わり
//   - 検証: show="contact"。押し込み交差の**形**が10×20の面なら合格（上の使い方欄）

// ---- 部位の呼び名（ユーザーと共有する用語。勝手な別名を作らない）----
//   クレードル … 中央領域を挟んで支える塊（旧称「台」「橋」。X33〜64）。
//               **厚い後ろ壁が主たる支え**、前壁は低い返し
//   背もたれ  … **v8で全廃**（v4で保険として追加→実物では主接触→v7で当て面に昇格→
//               当て先が実物のハンダ・ジャンパの上と判明。経緯は失敗ログ8・10・11）
//   突き当て  … v10で一度廃止 → **v11で復活**（ユーザー指示・デザイン統合）。
//               レール左端を閉じる舳先。当て面X=-0.15・上端zb9。基板を左へ寄せて当てる
//   抜き文字  … ベース後方の「Katanori」貫通ステンシル（v9。旧・肉抜き窓は全廃）。
//               役目は銘と吸着面積の削減。a・oの中島は横桟2本で保持
//   レール    … **溝の縁を延ばした低い縁**（v10・ユーザーの絵）。高さz2.5で
//               基板下辺の素の縁を挟む。v12から**舳先で終端し右端まで**（切れ端なし）
//   スロープ床 … 溝の底の全長斜面（v14）。基板系z0の1平面が舳先から右端まで通る。
//               クレードルの床と同一平面＝基板の下辺全長がここに座る
//   傾斜板    … **v10で廃止**（v9で私が「傾斜=背面の板」と誤読して立てた壁。
//               ユーザーの意図は「溝を端から端まで」＝レールだった）
//   着地パッド … **v10で廃止**（赤×。レールが同じ役目を全長で持つ）
//   ヘラ受け  … **v10で廃止**（赤×）。剥がしは左短辺の底の面取りにヘラ・
//               ハンマーで右(+X)へ、の手順のまま

use <respeaker_lite.scad>

show = "stand";   // "stand" | "assembly" | "check"

$fn = 64;

// ---- 印刷の補正（docs/PRINT.md・レジン①/0.05/2.5s/35s×5層/収縮補償OFF）----
SHRINK = 0.1;

// ---- クレードルが挟む相手: 中央領域（旧称「中央領域」・2026-08-04改称）----
REGION_T = 4.8;   // ✅ 領域の実測（約・2026-08-04訂正。モックCENTER_Tと同値・片方だけ直さない）
SLOT_W   = 6.0;   // ユーザー指定「6mmで十分幅。それ以上足さない」（2026-08-04）。
                  // 遊び約1.2（印刷太り0.2を引いて約1.0）は自重で前側に集まる
GRIP_X0 = 33.0;                      // 領域(32〜65)の1mm内側
GRIP_X1 = 64.0;

TILT = 15;   // 後傾の角度
// ⚠ 符号: rotate([+TILT,0,0]) は上端が -Y 側へ倒れる。鏡像修正後は
//    **-Y = XIAO面 = 後ろ** なので +TILT が後傾。（修正前は逆だった。
//    交差チェックは向きの間違いを検出しない。**絵を見て、面ラベルで確かめること**）

FLOOR_T  = 3.5;     // 座の下の肉。後傾した領域の下角がベースに触れない高さを含む

// ---- v18: クレードルを外す（2026-08-08・ユーザー「クレードル無しでこれで立つならこれでも」）----
// 前倒れを止める仕事を4面体の枠（stand_tetra.scad）へ全部渡す。
//   前壁 … 遊び0.38〜0.80 ÷ 高さ12.5 → 1.8〜3.7°
//   枠   … 遊び0.2（φ2.20の穴にφ2.0のネジ）÷ 高さ31.577 → 0.4°
// 同じ仕事なら枠のほうが1桁強いので、両方置く意味がない。
// CRADLE = false で、クレードルの塊・後ろ壁・前壁・入口の斜面・D1の逃げ・
// 貫通ネジの座が全部消える。土台・全長レール・スロープ床・舳先・水抜き・抜き文字は残る。
// **v17へ戻すときは CRADLE = true に戻すだけ。**
CRADLE = false;
// v18b: 全長レールと舳先も外す（ユーザー「レールが無いといけないの？」）。
// 基板の位置も姿勢もネジ2本が決めるので、レールの遊び約4.5mmは仕事をしていない。
// 残すのは**下辺が乗る床**だけ＝平らな板に溝が1本入っているだけの形になる
RAILS = false;

// ---- クレードルの寸法（v8）----
CR_Y0 = -11.0;  CR_Y1 = 6.5;  // 塊のY範囲。後ろ（-Y）が厚い＝主たる支え
CR_H  = 20.0;                 // 塊の高さ（世界座標）
BACK_TOP = 16.0;              // 後ろ壁の当たり上端（基板系）。この上は入口の斜面
FRONT_H  = 13.5;              // 前壁（返し）の高さ（基板系）。上面フラット
                              // （初版v8はz8+全面面取りで「内向きの刃」になっていた。
                              //  ユーザー指摘「折りたいわけ？」で修正）
                              // v16: 5.0 → 13.5。前倒れは「隙間÷支える高さ」で決まるので、
                              // 高さを稼がないと止まらない。13.5は D1（マイク面・下から
                              // 14.27・📄公式CAD）の下端の手前。5.0に戻せばv14の形になる
// 休止姿勢の寄せ。v16から**モックに聞く**: 中央領域のXIAO面側の外形
// （respeaker_center_back() = 1.69📄 + 0.42⚠）が後ろ壁(-SLOT_W/2)にちょうど触る位置へ置く。
// 旧 REST = SLOT_W/2 - REGION_T/2 = 0.6 は「領域は厚さ4.8の対称な板」という
// 誤ったモックに合わせた値だった（v16の訂正・respeaker_lite.scad 冒頭）
BOARD_Y = -SLOT_W / 2 + respeaker_center_back();   // = -0.89（基板のXIAO面の位置）

// ---- v16: 前壁（前倒れ対策）----
// 基板の面の位置（基板系y）。休止姿勢＝背面外形が後ろ壁(-SLOT_W/2)に付いた状態。
//   後ろ外形 -3.00 … XIAO面の一番高い部品（📄C85 +1.69）＋この機体のジャンパ/はんだ ⚠+0.42
//   XIAO面   -0.89 … 基板の裏の面そのもの
//   マイク面 +0.62 … 基板の表の面そのもの（下から14.27より下は📄何も載っていない）
//   マイク面の外形 +1.81 … D1（下から14.27〜15.07・左から40.26〜41.86）が一番出ている
// ⚠ -0.89/+0.62 は「実測4.8とCADの4.38の差0.42は全部XIAO面側」という仮定に依存する。
//    仮定が外れても最大0.42しかずれず、前壁の高さ12.5mmに対しては角度で1.9°ぶん
BOARD_FRONT = 0.62;   // ⚠ マイク面（素の基板）の位置
FRONT_FACE  = 1.00;   // 前壁の内面。BOARD_FRONT との差 0.38 が前倒れの遊びになる
FRONT_LEADIN = 1.0;   // 前壁の内縁の呼び込み（挿しやすさ。当たる面の上端はこのぶん下がる）
// D1・LED1（マイク面から最大1.19出ている）は挿すとき前壁の中を通り抜ける必要があるので、
// その帯だけ内面を逃がす。📄 D1 左から40.26〜41.86／LED1 39.90〜42.00
RELIEF_X0 = 39.4;  RELIEF_X1 = 42.5;  RELIEF_FACE = 2.5;

// ---- v17: 穴Bの貫通ネジ（クレードルごと基板を留める）----
// 📄 取付穴B は 左から60.202 / 下から2.657 / φ2.20。基板を溝に落とすとクレードルの
// 中（左から33〜64）の、床から2.657mmの高さに来る。前は前壁・後ろは後ろ壁で
// **外からは届かない**ので、届くのは座そのものだけ。そこで前後に貫通させる。
// 📄 穴Bのまわり（左から55〜66・下から0〜9）は両面とも無地（一番近いのはC16の下から6.07）
//
// ⚠ **穴は基板の面に垂直に通すこと。** 世界座標で水平に通すと基板に対して15°斜めに
//    なり、板厚1.51×tan15＝0.40mm ぶん実効の隙間が食われて、φ2.2の穴をφ2.0の
//    ネジが通れなくなる（0.2−0.40＜0）。だから穴は基板系で切る
// 位置合わせは運任せではない: **Xは舳先**（基板を左へ突き当てる）、**高さは床**。
//    どちらも硬い基準面で、そこから 60.202 と 2.657
// PIN_B = false にすれば v16 と同じ形（穴を開けても、ネジを挿さなければ落として使える）
PIN_B = true;
PIN_B_X = 60.202;   PIN_B_Z = 2.657;
PIN_B_D = 2.6;                        // 通し穴（M2の呼び）
PIN_B_HEAD_D = 4.4; PIN_B_HEAD_Y =  5.6;   // 前: ネジ頭の座面（ドライバは正面から入る）
PIN_B_NUT_AF = 4.3; PIN_B_NUT_Y  = -8.0;   // 後ろ: ナットの六角チャネルの底
// ⚠ 座面もナット座も**基板系の平面**で作る。クレードルの外面は世界座標で垂直なので、
//    そのままだと座が15°傾いてネジ頭もナットも片当たりする。掘り込んで平面を作っている

// ---- 全長レール（v10）----
RAIL_H = 2.5;   // レールの当たり上端（基板系）。下辺で一番低い障害物
                // （ジャック下端z3✅・スイッチ下端z3.5✅）より下に収める

BASE_T = 3.0;       // v6: 割れ対策で2.0→3.0。基礎上面は基板下端(z=3.34〜3.66)の
                    // 0.34mm下になり、そのまま着地面を兼ねる（着地パッドは面一に埋まる）
BASE_L = 102.0;     // X -8 〜 94
// 後ろ(-Y)へ広く取る
BASE_Y0 = -26.0;  BASE_Y1 = 18.0;

// ---- 座標: 基板のXをそのまま使う。溝の床の線が (y=0, z=FLOOR_T) ----
module in_board_frame() {
    translate([0, 0, FLOOR_T]) rotate([TILT, 0, 0]) children();
}

module cuts() {
    in_board_frame() {
        // 溝の切り欠き（v14で全長化）: 床＝基板系z0から上へ貫通。
        // Xは舳先の当て面(-0.15)から右端まで。突き当ての基準面は削らない
        // v16: **クレードルの区間だけ前側を FRONT_FACE で止める。**
        //   前壁の肉を difference の外で足す作りにしていたら、水抜き（左から40〜57）が
        //   その肉を貫通できず、穴の手前に塞ぎが残った（ユーザーがプレビューで発見）。
        //   足すのをやめて「溝を狭く切る」に変えたので、水抜きも文字も普通に通る
        translate([-0.15, -SLOT_W / 2, 0]) cube([GRIP_X0 + 0.15, SLOT_W, 40]);
        translate([GRIP_X1, -SLOT_W / 2, 0]) cube([94.85 - GRIP_X1, SLOT_W, 40]);
        translate([GRIP_X0, -SLOT_W / 2, 0])
            cube([GRIP_X1 - GRIP_X0, CRADLE ? SLOT_W / 2 + FRONT_FACE : SLOT_W, 40]);
        // v18: 穴Bのナットの逃げ。クレードルを外すとナットが基板のXIAO面に直付けに
        // なり、その背面(y-2.91)と後ろレールの内面(y-3.00)の隙間が0.09mmしか無い
        if (!CRADLE)
            translate([PIN_B_X - 3.5, -SLOT_W / 2 - 3.2, PIN_B_Z - 3.5])
                cube([7.0, 3.4, 7.0]);
        if (CRADLE) {
        // 入口の斜面: 後ろ壁の当たり上端(z16)から口を後ろへ開く。
        // 塊の天面(CR_H)より上まで突き抜けさせ、口の縁に庇を残さない
        hull() {
            translate([GRIP_X0 - 1, -SLOT_W / 2, BACK_TOP])
                cube([GRIP_X1 - GRIP_X0 + 2, 0.01, 0.01]);
            translate([GRIP_X0 - 1, -9, BACK_TOP + 12])
                cube([GRIP_X1 - GRIP_X0 + 2, 9 - SLOT_W / 2, 0.01]);
        }
        // 前壁の上を落とす（FRONT_Hより上の前側を全部。上面はフラット）
        translate([GRIP_X0 - 1, FRONT_FACE, FRONT_H])
            cube([GRIP_X1 - GRIP_X0 + 2, 30, 40]);
        // 呼び込み: **内側の縁だけ**（口が上へ開く向き。
        // 基板側へ下る斜面＝刃 にはしない）
        hull() {
            translate([GRIP_X0 - 1, FRONT_FACE, FRONT_H - FRONT_LEADIN])
                cube([GRIP_X1 - GRIP_X0 + 2, 0.01, 0.01]);
            translate([GRIP_X0 - 1, FRONT_FACE, FRONT_H])
                cube([GRIP_X1 - GRIP_X0 + 2, FRONT_LEADIN, 0.01]);
        }
        // D1・LED1（📄マイク面から最大1.19出る）の通り道。挿すときこの2部品が
        // 前壁の中を降りてくるので、その帯だけ内面を RELIEF_FACE まで逃がす
        translate([RELIEF_X0, FRONT_FACE, -1])
            cube([RELIEF_X1 - RELIEF_X0, RELIEF_FACE - FRONT_FACE, FRONT_H + 2]);
        }   // ← if (CRADLE)
        // v17: 穴Bの貫通ネジ（クレードルが有るときだけ意味がある）
        if (PIN_B && CRADLE) {
            translate([PIN_B_X, -16, PIN_B_Z]) rotate([-90, 0, 0])
                cylinder(d = PIN_B_D, h = 28);                          // 通し穴
            translate([PIN_B_X, PIN_B_HEAD_Y, PIN_B_Z]) rotate([-90, 0, 0])
                cylinder(d = PIN_B_HEAD_D, h = 8);                      // 前: 頭の座ぐり
            translate([PIN_B_X, -14, PIN_B_Z]) rotate([-90, 0, 0])
                cylinder(d = PIN_B_NUT_AF / cos(30), h = 14 + PIN_B_NUT_Y, $fn = 6);  // 後ろ: ナット
            // 当たり面に開く穴の縁を落とす（基板の素の面に角が食い込まないように）
            translate([PIN_B_X, FRONT_FACE, PIN_B_Z]) rotate([-90, 0, 0])
                cylinder(d1 = PIN_B_D + 0.6, d2 = PIN_B_D, h = 0.3);
            translate([PIN_B_X, -SLOT_W / 2 - 0.3, PIN_B_Z]) rotate([-90, 0, 0])
                cylinder(d1 = PIN_B_D, d2 = PIN_B_D + 0.6, h = 0.3);
        }
        // 水抜き（床とベースを貫通。両端に約7mmずつ床が残る）
        translate([40, -SLOT_W / 2, -FLOOR_T - BASE_T - 2])
            cube([17, SLOT_W, FLOOR_T + BASE_T + 4]);
        // 全長レールの内縁の呼び込み（1.2mm）。クレードルの範囲(X33〜64)は
        // 後ろ壁の当たり面を削らないため除外し、左右の区間だけに入れる
        // v16: 区間の端をクレードルの境界(33/64)にきっちり合わせる。
        // 旧値は0.2だけ食い込んでいて、高くなった前壁に小さな欠けを作っていた
        for (seg = [[-0.5, 33.5], [64.0, 30.0]])
            for (sgn = [-1, 1]) hull() {
                translate([seg[0], sgn * SLOT_W / 2, RAIL_H - 1.2])
                    cube([seg[1], 0.01, 0.01]);
                translate([seg[0], sgn * SLOT_W / 2 - (sgn < 0 ? 1.2 : 0), RAIL_H])
                    cube([seg[1], 1.2, 0.01]);
            }
    }
}

module stand() {
    difference() {
        union() {
            // v12: 基礎の四隅R5（ユーザー指示）
            translate([-8 + 5, BASE_Y0 + 5, 0]) linear_extrude(BASE_T)
                offset(r = 5) square([BASE_L - 10, BASE_Y1 - BASE_Y0 - 10]);
            // クレードル（v8）: 中央領域を挟んで支える塊。後ろ壁が主たる支え
            // v18: CRADLE=false で丸ごと消える（前倒れは4面体の枠が持つ）
            if (CRADLE) translate([GRIP_X0, CR_Y0, 0])
                cube([GRIP_X1 - GRIP_X0, CR_Y1 - CR_Y0, CR_H]);
            // 全長レール（v10・ユーザーの絵「傾斜（溝）は端から端まで」）:
            // 溝の縁をベース全長に延長し、基板下辺の素の縁を左端から右端まで挟む。
            // 高さ RAIL_H=2.5 は下辺の障害物（ジャックz3・スイッチz3.5）より下
            // v12: レールは舳先で終端（X-2〜94。左へ切れ端を出さない）
            // v13実機ジャスト（合格）。v14でも当たり（上端z2.5）は不変
            // v14b: 胴体を下へ延長（z-2→-3.5）。15°傾いた底面の外側の縁が
            // 前レールで基礎上面(3.0)より約0.12mm浮き、外縁全長にヘアラインの
            // 切れ込みが走っていた（ユーザー指摘・v10以来）。底縁を基礎に沈めて解消
            in_board_frame() {
                if (RAILS) translate([-2, -SLOT_W / 2 - 3, -3.5]) cube([96, 3, 3.5 + RAIL_H]);
                if (RAILS) translate([-2,  SLOT_W / 2,     -3.5]) cube([96, 3, 3.5 + RAIL_H]);
                // スロープ床（v14）: 溝の底の全長斜面。上面＝基板系z0＝クレードルの
                // 床と同一平面。後縁側で基礎上面(3.0)より低くなるぶんは、
                // 全長化した溝の切り欠きが基礎ごと削って通す
                translate([-2, -SLOT_W / 2, -2]) cube([96, SLOT_W, 2]);
            }
            // v10で廃止（ユーザーの絵の赤×）: 傾斜板・ジャックパッド・突き当て・
            // 着地パッド・ヘラ受け。剥がし用の左短辺の底の面取りだけ残す
            // 突き当て（v11で復活・ユーザー指示「左端ストッパーはデザイン良く」）:
            // 孤立した角柱ではなく、レール2本の左端を閉じる「舳先」。
            // レール高さから当て面（X=-0.15・v4合意の実質接触位置）へ斜めに立ち上がる。
            // 上端zb9はXIAOのUSB-C張り出し(z14〜)の5mm下
            // v11b: 舳先は直立（ユーザー「エンドキャップまで傾けなくていい」）。
            // 当て面X=-0.15は垂直面なので突き当ての機能は同じ
            if (RAILS) hull() {
                translate([-8, -6, 0]) cube([2, 12, 5]);
                translate([-2.35, -6, 0]) cube([2.2, 12, 9]);
            }
        }
        cuts();
        // 底面より下を切り落とす（傾いた切り欠きの食み出しぶん）
        translate([-60, -60, -50]) cube([300, 200, 50]);
        // 抜き文字（v9・ユーザー指示「文字部分が穴」）: 肉抜き窓は不格好なので全廃し、
        // 銘の貫通ステンシルに置き換え。吸着面積の削減も兼ねる。
        // a・o の中島が抜け落ちないよう、横桟2本（1.2mm）を残して繋ぐ
        // v13: 実機で「anor」上部の細い隙間が潰れた（ユーザー報告 2026-08-04）
        //   → ①フォントを Arial Black に（画線=穴が太くなる）
        //     ②プレート側の入口を +0.6 広げる（docs/DIMENSIONS.md のボトム層過硬化補正。
        //       文字穴に適用し忘れていた）
        // v13d: フォントを **Stencil** に（ユーザー「フォントを変えたら？」）。
        // 型抜き専用フォントで桟が字形に最初から入っている → 後付けの桟を全廃。
        // 「aが変なとこで切れる」問題は起きようがない。
        // スリット最小2mmルール（v13c）とプレート側入口+0.6の過硬化補正は継続
        // v13e: 180°回転（ユーザー「上下反転」）＝正面（マイク面側）から読める向き。
        // フォントは **Stencil Gothic**（ユーザーが StencilGothic.ttf をインストール。
        // 型抜き用の橋が字形に最初から入っているので後付けの桟は不要）。
        // フォント遍歴: Arial Black（aの切れ方が不自然）→ Stencil（Nの橋が髪の毛）→
        // Century Gothic+桟（比較中にユーザーが本物を導入）→ Stencil Gothic
        // v13h: **ロゴはベクタ化した3D切削体**（ユーザー発案のベクタ化を3Dで実装）。
        // katanori_logo_cutter.stl に「文字＋入口逃げ+0.6・位置・180°回転」まで
        // 焼き込み済み。フォントの有無・環境変数に関係なく、どこで開いても文字が出る。
        // ⚠ v13gでDXF経由にしたら **importがF5では切れて見えるのにF6/STL出力では
        //   黙って落ちる** 事故（ユーザーがスライサーで発見。私はプレビュー確認で
        //   「入った」と誤報告）。2Dインポートは使わない。検証は必ず
        //   「書き出したSTLファイル自体をimportしてF6で見る」で行うこと。
        // 再生成: Stencil Gothic を入れた環境で scratchの logo_cutter.scad を -o で書き出す
        import("katanori_logo_cutter.stl");
        // ヘラ入口の面取り（v6）: 左短辺の底の縁を全幅45°で削ぎ、刃が入る口を作る
        translate([0, 19, 0]) rotate([90, 0, 0]) linear_extrude(46)
            polygon([[-8.1, -0.1], [-6.4, -0.1], [-8.1, 1.6]]);
        // 中央領域の下角の逃げ（v6）は v14 で廃止: スロープ床が全長z0になり、
        // 台の外でも下角(z≈2.72)は床の面にちょうど乗る。彫り下げは床に切れ目を
        // 入れるだけで役目がない
    }
}

// 基板の休止姿勢（v8）: 中央領域の背面を、自重で後ろ壁に預けた状態。
// 溝の中心合わせから REST(0.6) だけ後ろに寄る＝背面外形が壁の面に触れている
module board_placed() {
    in_board_frame()
        translate([0, BOARD_Y, 0])
            respeaker_lite();
}

// ============================================================
// 左のロック（v16b・別部品）— 「二又のフィン」
// ============================================================
// 役目は **浮き上がり止めと位置決め**。前倒れは前壁（高さで効く）が持つ。
// 基板の左上の取付穴 📄左から2.492 / 下から31.577 / φ2.20（✅2mmネジが通ることを実機確認）
// で基板に留め、足はベースの上に乗る。**座には何も追加しない**（v16のSTLのまま使える）。
//
// 形: 基板の左脇（X<0）に2本の柱を立て、上で合流して基板の**XIAO面側**へ回り込む。
//   - 正面（マイク面）から見えるのはネジの頭だけ。フィン本体は基板の左と裏
//   - 真ん中を大きく開ける。⚠ XIAOのUSB-Cの張り出し（下から14〜23・量は未実測）と
//     そこに挿すケーブルが通る道。**⚠に寸法を当てにいかず、開けて避ける**
//   - 下の穴（左60.202/下2.657）は使えない。溝に沈むうえ v16 の前壁の裏に隠れる
//
// パッドが触る相手はマイク面ではなく **XIAO面の 左から0〜5.4 / 下から27〜34**。
// 📄公式CADでこの区画は無地（一番近い部品は R14・C59 で 左から5.83から）。
// XIAO本体の上端は下から約25.7なので、下から27より上なら当たらない
LOCK_X0 = -7.4;   LOCK_X1 = -3.6;    // フィンの板厚（Xがそのまま厚み）
LOCK_R  = 2.1;                       // 柱の半径（丸めた見え方をこれで作る）
LOCK_PAD_X1 = 5.4;                   // パッドの右端。R14/C59（5.83〜）の手前で止める
LOCK_PAD_T  = 3.2;                   // パッドの肉厚（M2ナット1.6を埋める）
LOCK_HOLE   = [2.492, 31.577];       // 📄 取付穴（左から / 下から）
LOCK_SCREW_D = 2.4;                  // M2の通し穴（樹脂にネジは切らない）
LOCK_NUT_AF  = 4.2;                  // M2ナットの二面幅4.0＋遊び
LOCK_NUT_T   = 1.9;                  // M2ナットの厚み1.6＋遊び

module lock_bar(y0, z0, y1, z1, r = LOCK_R) {
    hull() for (p = [[y0, z0], [y1, z1]])
        translate([LOCK_X0, p[0], p[1]]) rotate([0, 90, 0])
            cylinder(r = r, h = LOCK_X1 - LOCK_X0);
}

module left_lock() {
    PY = BOARD_Y - LOCK_PAD_T;        // パッドの背面（基板のXIAO面から後ろへ）
    difference() {
        union() {
            in_board_frame() {
                // 前の柱・後ろの柱。上で1点に合流する（二又）
                // ⚠ 足の位置は**舳先を避けて決めてある**。舳先は世界座標で
                //    X-8〜-0.15・y-6〜+6・z9まであり、フィンはXが丸かぶりなので、
                //    足も柱も世界y<-6（舳先の後ろ）に置くしかない
                lock_bar( -9.0, -4.0, BOARD_Y - LOCK_PAD_T / 2, LOCK_HOLE[1]);
                lock_bar(-21.0,  2.0, BOARD_Y - LOCK_PAD_T / 2, LOCK_HOLE[1]);
                // 足: 接地を広げる（ベースの上に乗るだけ。座には何も足さない）
                lock_bar( -9.0, -4.0, -21.0, 2.0, r = LOCK_R + 0.4);
                // 上のパッド: 基板のXIAO面に面で当たる。角は丸める
                // ⚠ 下端は**下から27.8**。ピンヘッダーの上列（下から25〜27・高さ10）を踏まない
                hull() for (x = [LOCK_X0 + LOCK_R, LOCK_PAD_X1 - LOCK_R])
                    for (z = [29.9, 32.9])
                        translate([x, PY, z]) rotate([-90, 0, 0])
                            cylinder(r = LOCK_R, h = LOCK_PAD_T);
            }
        }
        // ネジの通し穴（マイク面側から挿す）とナットのポケット
        in_board_frame() {
            translate([LOCK_HOLE[0], PY - 1, LOCK_HOLE[1]])
                rotate([-90, 0, 0]) cylinder(d = LOCK_SCREW_D, h = LOCK_PAD_T + 2);
            translate([LOCK_HOLE[0], PY - 0.01, LOCK_HOLE[1]])
                rotate([-90, 0, 0]) cylinder(d = LOCK_NUT_AF / cos(30), h = LOCK_NUT_T, $fn = 6);
        }
        // 足はベースの上面(世界z=BASE_T)で切る。ここが接地面になる
        translate([-60, -60, -50]) cube([300, 200, 50 + BASE_T]);
    }
}

LIFT = 0;   // contact用: 基板を溝に沿って持ち上げた姿勢の検査（-D LIFT=3 など）

if (show == "stand") {
    stand();
} else if (show == "assembly") {
    stand();
    board_placed();
    color("#c94") left_lock();
} else if (show == "lock") {
    // 左のロック単体（印刷用）
    left_lock();
} else if (show == "pintest") {
    // 穴Bのネジ（φ2.0）が基板の穴（φ2.20）を触らずに通るか。**空が合格**
    intersection() {
        in_board_frame() translate([PIN_B_X, -16, PIN_B_Z])
            rotate([-90, 0, 0]) cylinder(d = 2.0, h = 28);
        board_placed();
    }
} else if (show == "lockcheck") {
    // ロックが基板・座に食い込んでいないか。**空が合格**
    intersection() {
        left_lock();
        union() { stand(); board_placed(); }
    }
} else if (show == "check") {
    // **破壊検出のみ。** 何も出なければ食い込みなし。出た形がそのまま当たっている場所。
    // 空でも「支えている」証明にはならない（失敗ログ10）→ 支持の合否は "contact"
    intersection() {
        stand();
        board_placed();
    }
} else if (show == "contact") {
    // **支え方の合否判定。** 休止姿勢からさらに0.05mm押し込んだ交差の形。
    // 面で支えていれば後ろ壁の面（約31×16）が出る。点・線・空は不合格。F6で見る
    intersection() {
        stand();
        in_board_frame()
            translate([0, BOARD_Y - 0.05, LIFT]) respeaker_lite();
    }
}
