// M2 ナットの六角ポケットの二面幅を決め直す試験板 ── 2026-09-02
//
//   openscad --backend=manifold --render -o hardware/stl/test/hex_gauge.stl hardware/hex_gauge.scad
//
// 何のために作るか
//   いまの 4.30 は「呼び 4.0 ＋ 0.3」で、**SK本舗のレジンで焼くと 0.3 縮んで 4.0 になる**という
//   実績の値である（docs/PRINT.md §2）。レジンが ELEGOO に替わり、縮みがほとんど無いことが
//   分かった（✅ 2026-08-31 つまみの溝 2.02 → 焼き ≒2.02）。それでも底板の六角は機能している
//   （✅ 2026-09-02 ユーザー）ので、**4.30 が緩いとは言い切れない。** 前後を実物で決める。
//
// 🔒 ゲージの答えは「どの入れ方で測ったか」とセットでしか使えない（docs/PRINT.md）。
//   φ6 磁石で一度これを外している（丸穴で測った 6.10 を、滑り込ませる溝へ持ち込んで入らなかった）。
//   ⇒ **本物の 2 つの入れ方を両方作る。**
//     A 落とし込み … 袋の六角穴・上が開く・深さ 1.8（ナット 1.6 ＋ 0.2）
//                    写した先: case_base.scad の bottom_boss（底板・天面のボス）
//     B 横差し     … 六角を +X へ 6mm 掃いた溝・**上は蓋**・+X の側面だけが開く・高さ 1.6
//                    写した先: btn_v3.scad の btn3_block_cut（天板の腕）
//   🔒 A と B は**同じ箱に入れる**（ユーザー「横入れと上入れの箱はくっつけていいでしょ」）。
//     幅ごとに 1 個になるので、切り離しても A と B の対応が崩れない。
//
// 見かた
//   ナットを入れて、**板を逆さにする**。
//     落ちる → 緩い ／ 入らない → きつい ／ 入って落ちない → これが答え
//   ⚠ 「ちょうど」に感じたら**一段ゆるい方**を採る（fit_gauge.scad の流儀）。
//   ⚠ A と B で答えが違ってよい。違ったら、それぞれの場所に別の値を使う。
//
// 刷る向き
//   この板のまま。**穴の口は上を向く**（本物と同じ）。B の溝が開いているのは +X の側面。

$fn = 96;

// ---- ナット（実物）----
NUT_AF_NOM = 4.0;    // 📄 M2 ナットの二面幅（呼び）
NUT_T_NOM  = 1.6;    // 📄 同 厚み

// ---- 試す二面幅 ----
W_SET = [4.30, 4.25, 4.20, 4.15, 4.10, 4.05, 4.00];
// 印は「丸い穴の数」。1 個 = 4.30、2 個 = 4.25 … 7 個 = 4.00

// ---- 本物から写した寸法 ----
A_DEPTH = 1.8;       // 落とし込み: 袋穴の深さ（case_base の NUT_T = 1.6 + 0.2）
B_H     = 1.6;       // 横差し: 溝の高さ（btn_v3 の B3_NUT_T。ナットと同じ）
B_SWEEP = 6.0;       // 横差し: 掃く長さ（btn_v3 と同じ）
// 🔴 2026-09-02 最初は溝の上も開けていた。それだと**上から落とせてしまい、A 列と同じ試験**に
//   なる（ユーザー「横から入れるやつは蓋もしておこうよ・・・でないと別に上から入れる奴と
//   変わらない」）。本物の腕は溝の上にブロックの肉がある（btn_v3 の btn3_block）。⇒ 蓋を付ける。
B_ROOF  = 1.2;       // 横差し: 溝の上に残す肉

// ---- 板 ----
BLK   = 14.0;        // 1 マスの一辺（穴 4.5〜9.5・印の帯はその外）
T     = 4.0;         // 箱の厚み。A は床 2.2 ＋ 穴 1.8／B は床 1.2 ＋ 溝 1.6 ＋ 蓋 1.2
CELL_Y = BLK * 2;    // 28  A と B を縦に並べて 1 個の箱にする
PITCH = 16.0;
// 印は上面の丸い穴。丸なら稜が出ない（彫った数字は画の合流点で 0.02〜0.08mm の稜が出た）
DOT_D = 1.2; DOT_P = 2.0; DOT_DEEP = 1.0;

module hexz(af, h) rotate([0, 0, 30]) cylinder(d = af / cos(30), h = h, $fn = 6);

// 幅 w の箱 1 個。手前が A（落とし込み）、奥が B（横差し）、真ん中の帯に印
module cell(w, n) difference() {
    cube([BLK, CELL_Y, T]);
    translate([BLK / 2, BLK / 2, T - A_DEPTH]) hexz(w, A_DEPTH + 1);        // A: 上が開く袋穴
    // B: 上は蓋。口は **+Y（板の外の縁）** へ抜く
    // 🔴 2026-09-02 実機。最初は +X へ抜いていたが、**連結棒を同じ +X の面から出していた**ので
    //   口が棒で塞がり、横からは 1 個も入らなかった（ユーザー「つなげている箇所に６角の入口を
    //   置くとか正気ですか」）。⇒ 前に何も無い外の縁へ向ける。
    hull() for (dy = [0, B_SWEEP])
        translate([BLK / 2, BLK + BLK / 2 + dy, 1.2]) hexz(w, B_H);
    for (k = [0 : n - 1])                                                   // 印（真ん中の帯）
        translate([BLK / 2 - (n - 1) * DOT_P / 2 + k * DOT_P, BLK, T - DOT_DEEP])
            cylinder(d = DOT_D, h = DOT_DEEP + 0.01, $fn = 24);
}

// 🔴 2026-09-02 **連結棒は外した。** つなげる意味は「小さすぎる部品が単独だとプレートに
//   点で立って倒れる」ときだけで（検算の実績: 接地 5mm² で軸がズレた）、この 1 マスは
//   14 x 28 = 392mm² 接地する。桁が違う。順番は上面の丸い印が持っているので棒は要らない。
//   そして実機では、その棒が横差しの口を塞いで 1 個も入らなかった
//   （ユーザー「つなげる意味って剥がしやすい以外意味あるんですか？」）。
//   ⚠ 1 枚の STL への結合は刷るぞーがやるので、離れていても読み込みは 1 ファイルのまま。
for (i = [0 : len(W_SET) - 1]) translate([i * PITCH, 0, 0]) cell(W_SET[i], i + 1);

echo(str("六角ゲージ: 二面幅 ", W_SET, "  A 袋穴 深さ ", A_DEPTH,
         " / B 横差し 高さ ", B_H, " × 掃き ", B_SWEEP, " × 蓋 ", B_ROOF,
         "  1 箱 ", BLK, " x ", CELL_Y, " x ", T,
         "  外形 ", (len(W_SET) - 1) * PITCH + BLK, " x ", CELL_Y));
