// ReSpeaker Lite の板厚ゲージ v2 ― 櫛（コーム）＋ペグ出しろポケット
//
// 🔴 v2 を作った理由（2026-08-10）: **板厚の言い値が割れた。**
//   ・実測 1.25（stand_ab.scad の BT_MIN・2026-08-09）
//   ・公式CAD 1.510（respeaker_lite.scad の BOARD_T）
//   ・ユーザー「最低でも 1.7 はある。**角のペグがほぼ出ていないから 1.8 でも控えめ**」
//   穴Aのペグはフレーム側の絶対長 2.21（基板裏の当て面から）。板厚1.51なら頭が
//   0.7 出るはずで、「ほぼ出ていない」なら実効板厚は 2.0 前後まであり得る。
//   カバーの前板は BT 基準（内面 y = BT+0.15）なので、ここが決まらないと作れない。
//   ⚠ 実効板厚が 1.66 を超えているなら、v6/v7 のカバーは前板が基板の面に乗り上げて
//   **溝の向き以前に入らない。**
//
// 🔴 v1 の失敗:
//   ・溝が両端とも壁のトレンチで、86mm の長辺は角を斜めに突っ込むことしかできない
//   ・刻み 0.2 では 1.5 / 1.7 / 1.8 を切り分けられない
//
// ============================================================
// 使い方 ①縁の櫛 ― **素の板厚**（レジスト込み・部品なし）
// ============================================================
//   基板は机に置いたまま、櫛の溝を長辺の縁へ横から押し当てる（縁を 7mm 呑む）。
//   手前の縁: 1.5 / 1.6 / 1.7 / 1.75 / 1.8 / 1.85
//   奥の縁:   1.9 / 1.95 / 2 / 2.1 / 2.2   （数字は溝の脇に彫ってある）
//   「無理なく入るいちばんきつい溝」＝板厚。1.8 が入らず 1.85 が入るなら 1.80〜1.85。
//   場所を変えて数点。**カバーが触る穴Aまわり（左上）の縁を必ず含めること。**
//   ⚠ XIAO面のヘッダー列は縁から 8mm なので当たらないが、ワイヤーの根元は避ける
//
// ============================================================
// 使い方 ②ペグ出しろポケット ― **実効板厚**（台座に当てた状態での面の位置）
// ============================================================
//   右端の裏面（彫った数字の無い面）に、深さ 0.2/0.4/0.6/0.8 のポケットが開いている
//   （点の数 1〜4 ＝ 0.2mm × 点）。基板をフレームに挿した状態で、ゲージを**裏返して**
//   （ポケット面を基板へ向けて）面に密着させ、穴Aのペグの上を横切らせる:
//     引っかかる最深のポケット < 出しろ < 通る最浅のポケット
//   実効板厚 ＝ 2.21 −（ペグの出しろ）。
//   🟣 ①と②がズレたら板厚ではなく**浮き**である（基板がXIAO面の何か—ジャンパ線など—を
//     踏んで台座から離れている）。その場合の直し先は BT ではなく台座の逃げ
//
// ⚠ 絶対値の精度は SHRINK（PRINT.md の実測 0.1）とペグの印刷長に乗っている。
//   ±0.05 は疑い、隣どうしで判定が割れたら「間」と読む。いまの争いには十分
//
// 印刷: プレート直置き・サポート不要・平置き（溝幅がXY面に乗る向き）。
//   設定は本番と同じ（レジン①・0.05mm・2.5s・初期層5層/35s）。
//   初期層の太りが溝を狭めないよう、下面 0.5 だけ溝を片側 0.3 広げてある。
//   数字と溝の目盛りは全部彫り込み（浮き彫りにすると②で面に密着できない）
//
//   openscad -o board_gauge_v2.stl --render board_gauge.scad

$fn = 48;

SHRINK = 0.1;    // docs/PRINT.md の実測。穴・溝は設計値から約0.1mm縮む。設計値に足す

ROW_A = [1.50, 1.60, 1.70, 1.75, 1.80, 1.85];   // 手前の縁（y=0 側）
ROW_B = [1.90, 1.95, 2.00, 2.10, 2.20];          // 奥の縁

PITCH     = 8.0;    // 溝の間隔
X0        = 7.0;    // 最初の溝の中心
SLOT_D    = 7.0;    // 溝の深さ＝縁を呑む量。ヘッダー列（縁から8）より浅いこと
MOUTH_D   = 1.5;    // 口のラッパの深さ。合否はこの奥の平行部（5.5mm）で見る
MOUTH_ADD = 0.7;    // 口の広がり（片側）。縁を拾いやすくするだけ
T         = 3.0;    // 櫛の厚み
RELIEF_ADD = 0.3;   // 初期層の逃げ（片側）
RELIEF_H   = 0.5;
W = 34.0;
L = X0 * 2 + PITCH * (len(ROW_A) - 1);   // 54

// ペグ出しろポケット（右端 x=49〜54。櫛の溝の先端は x≤48.9 なので重ならない）
PROT  = [0.2, 0.4, 0.6, 0.8];
PKT_Y = [5, 13, 21, 29];
PKT_W = 4.5;    // ペグφ2が余裕で入る幅
PKT_L = 5.0;

// 奥の縁（y=W）に開く溝。合否を決める平行部の幅は 実寸+SHRINK
module slot_top(cx, v, extra = 0) {
    h0 = (v + SHRINK) / 2 + extra;
    hm = h0 + MOUTH_ADD;
    polygon([[cx - h0, W - SLOT_D], [cx + h0, W - SLOT_D],
             [cx + h0, W - MOUTH_D], [cx + hm, W + 0.1],
             [cx - hm, W + 0.1], [cx - h0, W - MOUTH_D]]);
}

module slots2d(extra = 0) {
    for (i = [0 : len(ROW_B) - 1]) slot_top(X0 + i * PITCH, ROW_B[i], extra);
    translate([0, W / 2]) mirror([0, 1]) translate([0, -W / 2])   // 手前の縁へ折り返す
        for (i = [0 : len(ROW_A) - 1]) slot_top(X0 + i * PITCH, ROW_A[i], extra);
}

// 数字は彫り込み（深さ0.5）。②で面に密着させるので上面に凸を作らない
module labels() {
    for (i = [0 : len(ROW_A) - 1])
        translate([X0 + i * PITCH, SLOT_D + 3.6, T - 0.5]) linear_extrude(0.6)
            text(str(ROW_A[i]), size = 3, halign = "center", valign = "center");
    for (i = [0 : len(ROW_B) - 1])
        translate([X0 + i * PITCH, W - SLOT_D - 3.6, T - 0.5]) linear_extrude(0.6)
            text(str(ROW_B[i]), size = 3, halign = "center", valign = "center");
}

// ポケットは**数字の面（上面）から**掘る。⚠ 下面に掘ってはいけない — プレート直置きの
// 初期層は過硬化するので、深さ0.2のポケットは埋まって消える。
// 使うときは数字の面を基板へ向けて裏返す（当て面から深さ d になる）。
// 点（1〜4個 ＝ 0.2mm×点）は各ポケットの底に彫る。裏返す前に数えること
module prot_pockets() {
    for (i = [0 : len(PROT) - 1]) {
        d = PROT[i];
        translate([L - PKT_L, PKT_Y[i] - PKT_W / 2, T - d])
            cube([PKT_L + 0.1, PKT_W, d + 0.1]);
        // 点は2×2の格子（1=1点 / 2=対角 / 3=L / 4=四角）。一列に並べると繋がって読めない
        for (j = [0 : i])
            translate([L - PKT_L + 1.6 + (j % 2) * 1.9,
                       PKT_Y[i] - 0.95 + floor(j / 2) * 1.9, T - d - 0.3])
                cylinder(d = 1.0, h = 0.31);
    }
}

difference() {
    linear_extrude(T) difference() { square([L, W]); slots2d(0); }
    // 初期層の逃げ: 下面 RELIEF_H だけ溝を広げる。合否は上の 2.5mm が見る
    translate([0, 0, -0.01]) linear_extrude(RELIEF_H) slots2d(RELIEF_ADD);
    labels();
    prot_pockets();
}
