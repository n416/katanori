// 電池の蓋 ── ツメと溝の噛み合いを見る試験片（2026-08-20 / rev.C）
//
// 🔴 **打ち切り（2026-08-20）。刷らないこと。**
//    この試験片は「上シェルは開口上・蓋は寝かせる」という印刷の向きを**形に焼き込んで**
//    ある。ところが向きも割り方もまだ決まっていない。しかも溝の天井は下を向く面で、
//    露光が下へ滲むぶん必ず垂れ気味に焼ける（docs/PRINT.md:309「厚みを Z に取るな」）。
//    ⇒ 刷り上がっても、出るのは「この形・この肉厚での垂れ量」でしかない。
//    ⇒ COV_CL は、噛み合う面を Z から外す割り方が決まってから出す。
//    以下は経緯の記録として残す。復活させるなら前提から作り直すこと。
//
//   openscad --backend=manifold -o hardware/stl/cover_tab_gauge.stl hardware/cover_tab_gauge.scad
//
// 🔒 **レジンで刷る。** 爪（曲げて使う部品）は使わない設計なので、ここで見るのは
//    「溝にツメが滑り込むか・ガタつかないか」だけ。弾性は当てにしない。
//
// 何を見るか:
//   case_v2.scad の COV_CL（蓋まわりの隙間）を 0.2 / 0.3 / 0.4 / 0.5 で並べてある。
//   4組すべて刷って、**Y方向へ滑らせて入り、抜くのに少し力が要る組**を選ぶ。
//   決まった値を case_v2.scad の COV_CL に書き戻す。
//
// ============================================================
// 🔒 **2つの部品は、わざと別々の向きで刷る。** ここが rev.C の要点である。
// ============================================================
// 実機では、噛み合う 1.2mm が受け側と蓋側で**別の軸に出る**。
//
//   受け側（筐体シェル）… そのまま刷るので、溝の高さ COV_TAB+COV_CL は **Z（レイヤー）**
//   蓋側（battery_cover）… 板を寝かせて刷るので（case_v2.scad:1375）、
//                          ツメの厚み COV_TAB は **XY（ピクセルと露光の滲み）**
//
// COV_CL が飲み込むのは、この**別々の軸で出た2つの誤差の和**である。
// だから試験片も同じように分ける。プレートには次の向きで置く（回さないこと）:
//
//   受け側 … そのまま寝かせる。溝の高さが Z に出る。
//   ツメ側 … そのまま寝かせる。**リブは板から立ち上がり、厚み 1.2 は水平（XY）に出る。**
//            板の厚み 2.0 がリブをボトム層から浮かせるので、初層の焼き込みも乗らない。
//
// 試すときは、ツメ側を 90° 倒してリブを溝へ入れ、Y方向へ滑らせる。
//
// ⚠ rev.A / rev.B の失敗:
//   ・rev.A … 受け側に「横から覗く窓」を開け、溝の天井 12×18mm が 2×3mm の柱2本に
//     ぶら下がる片持ちになっていた。レジンで無サポート＝垂れてミルフィーユ。⇒ 窓を廃止。
//   ・rev.A … 番号を独立した部品として置き、洗浄でバラバラになった。⇒ 部品に彫る。
//   ・rev.B … ツメの厚み 1.2 を Z に取ってプレート直置きにしていた。docs/PRINT.md:309
//     （板バネのゲージ「厚みを Z に取るとボトム層が支配する」）に反していた。
//   ・rev.B … -X からまっすぐ差すだけで、実機の Y スライドを再現していなかった。
//     docs/PRINT.md:301「通る必要があるなら、通す向きに動かして測った値を使う」に反していた。
//     2026-08-17 の MAG2_D の事故と同じ形。
//
// ⬜ case_v2 側の宿題: 実機の溝の深さは COV_SEAT+0.02 で、ツメの深さ COV_SEAT に対して
//    X方向の逃げが実質ゼロ。この試験片は溝を 0.3 深く掘って「深さでは当たらない」ように
//    してあるので、深さの可否はここでは分からない。case_v2 側に逃げを入れるか要判断。
//
// 🔒 Z=0 は毎回取り直す（docs/PRINT.md）。

$fn = 32;

COV_TAB  = 1.2;    // ツメの厚み（case_v2.scad と同じ）
COV_SEAT = 2.0;    // ツメが潜る奥行き（同上）
CLS      = [0.2, 0.3, 0.4, 0.5];

SLIDE_L  = 14.0;   // Y方向。溝の長さ＝リブの長さ（滑らせて擦る距離）
BASE_T   = 3.0;    // 受け側・溝の床までの厚み
ROOF_T   = 2.0;    // 受け側・溝の天井の厚み
BASE_L   = 8.0;    // 受け側の X 方向の長さ
SEAT_EXT = 0.3;    // 溝を掘り増す量（深さで当たらせないため）

PLATE_T  = 2.0;    // ツメ側の板の厚み（実機の WALL と同じ）
PLATE_X  = 12.0;   // ツメ側の板の幅（掴む所）

MARK_D   = 0.6;    // 番号を彫る深さ
MARK_SZ  = 4.5;

function seat_h(cl) = BASE_T + COV_TAB + cl + ROOF_T;

// ---- 受け側（溝）----
// 溝は Y に貫通。天井の張り出しは 2.3mm だけなので無サポートで刷れる
module seat(cl) {
    h = seat_h(cl);
    difference() {
        cube([BASE_L, SLIDE_L, h]);
        translate([-1, -1, BASE_T])
            cube([COV_SEAT + SEAT_EXT + 1, SLIDE_L + 2, COV_TAB + cl]);
        // 番号（天面に彫る。彫りなので出っ張らず、洗っても離れない）
        translate([BASE_L / 2, SLIDE_L / 2, h - MARK_D])
            linear_extrude(MARK_D + 1)
                rotate([0, 0, 90])
                    text(str(cl), size = MARK_SZ, halign = "center", valign = "center");
    }
}

// ---- 蓋側（ツメ）----
// 実機の蓋と同じ姿勢: 板が寝て、リブが立つ。よって厚み 1.2 は水平（XY）に出る
module tab(cl) {
    difference() {
        union() {
            cube([PLATE_X, SLIDE_L, PLATE_T]);                  // 板（掴む所）
            cube([COV_TAB, SLIDE_L, PLATE_T + COV_SEAT]);       // リブ＝ツメ本体
        }
        // 番号（板の天面に彫る。受け側と同じ数字が対）
        translate([(COV_TAB + PLATE_X) / 2, SLIDE_L / 2, PLATE_T - MARK_D])
            linear_extrude(MARK_D + 1)
                rotate([0, 0, 90])
                    text(str(cl), size = MARK_SZ, halign = "center", valign = "center");
    }
}

PITCH = 20.0;

// part = "plate" … 刷る配置（この向きのまま置くこと）
// part = "demo"  … 噛み合わせの絵。ツメ側を 90° 倒して溝へ滑り込ませた図
part = "plate";

if (part == "plate")
    for (i = [0 : len(CLS) - 1]) {
        translate([i * PITCH, 0, 0])              seat(CLS[i]);
        translate([i * PITCH, SLIDE_L + 6, 0])    tab(CLS[i]);
    }
else if (part == "demo")
    for (i = [0 : len(CLS) - 1])
        translate([i * PITCH, 0, 0]) {
            seat(CLS[i]);
            translate([-PLATE_T, SLIDE_L + 6, BASE_T + CLS[i] / 2])
                rotate([0, 90, 0]) rotate([0, 0, 180]) tab(CLS[i]);
        }
