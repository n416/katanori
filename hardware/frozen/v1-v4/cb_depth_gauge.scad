// ザグリの深さを読む治具 ── 2026-09-01
// ============================================================
// 🔒 何のために作るか（ユーザー案 2026-08-31）
//   刷った板は設計より厚く出る（天板 2.5 → 3.4）。厚みが**外側に付いたぶん**だけ
//   ザグリが深くなり、ねじの頭がそのぶん深く沈む。どれだけ深くなったかを読む物が無かった。
//   ⚠ 外面からザグリの底までの深さは、手持ちの道具では測れない（ユーザー「そんなもん測れるかよ」）。
//
// 読み方
//   ピンをザグリへ落とす。
//     ・板が**表面に着く** … ピンが底に届いていない ＝ ザグリはピンより深い
//     ・板が**浮く**       … ピンが底に当たっている ＝ ザグリはピンより浅い
//   ⇒ **着く中でいちばん長いピン**が、そのザグリの深さ（0.2 刻み）。
//
// なぜ φ3.0 のピンか
//   ねじの通し穴が 2.5 なので、それより太くないと穴へ落ちて底に当たらない。
//   ザグリは 3.4（古い板）と 4.4（直した後）の 2 種類があり、3.0 なら両方に入る。
//
// ⚠ このゲージは小さい（接地は LCD の 1% 未満）ので、板が厚く出る現象の影響を受けない。
//   だから板の厚みではなく**ゲージの方を基準にしてよい**。
//
//   openscad --backend=manifold -o stl/test/cb_depth_gauge.stl hardware/cb_depth_gauge.scad
// ============================================================
$fn = 64;

PIN_D   = 3.0;                                   // 通し穴 2.5 より太く、ザグリ 3.4 より細い
LENS    = [1.4, 1.6, 1.8, 2.0, 2.2, 2.4, 2.6];   // 試す深さ
LBL     = ["14", "16", "18", "20", "22", "24", "26"];

// 🔴 2026-09-01 PAD_Y 9 → 12。9 のままだと連結棒（y 2.5〜4.5）が上の列の穴（y 3.2）を
//    埋めてしまい、絵に 1・2・3 個しか出なかった（下の列だけが生き残っていた）。
//    棒は y 4.0〜6.0 へ寄り、穴と重ならない
PAD_X   = 10.0;  PAD_Y = 12.0;  PAD_T = 1.5;     // つまむ板。表面に着いたかどうかを見る面
PITCH   = 13.0;
// 🔒 桟は **2.0 × 1.5**。リポジトリの作法（fit_gauge.scad 冒頭「輪と枠を桟（2.0×1.5・
//    ニッパーで切る）で 1 枚につなぐ」／ peg_bore_gauge と同じ）。
//    🔴 2026-09-01、私は理由なく 1.2 にしていた（ユーザー「その基準が無いなら、どうやって
//    切り離しの設計をしたわけ？適当？」）。作法の値に戻した
BAR_W   = 2.0;   BAR_H = 1.5;                    // 連結棒（ニッパーで切る）
LBL_H   = 3.2;   LBL_DEEP = 0.4;

// 🔴 刷る向きと使う向きは**逆**。ピンを上に向けて刷る（下向きに作ると、短いピンほど
//    宙に浮いて全部が浮いた欠片になる。最初そう作って検査に 7 か所出た）。
//    使うときはひっくり返して、板の面を天板に当て、ピンをザグリへ入れる。
//
// 🔒 番号は**貫通穴の数**で表す（ユーザー指摘 2026-09-01「割れたらどれがどれか分からなくなる」）。
//    ⚠ 彫った数字は透明レジンではほとんど読めない。fit_gauge.scad:67 に「白いレジンでは
//      点の印が実物でも写真でも見分けがつかない」という実績があり、透明なら余計に読めない。
//    ⇒ 穴なら透明でも見えて、指でも数えられる。1 穴＝いちばん短い 1.4、7 穴＝いちばん長い 2.6。
//    数字も彫ってあるが、それは読めたときの補助でしかない
HOLE_D  = 1.2;
HOLE_PX = 2.4;   // 穴の間隔
HOLE_PY = 3.2;   // 2 列（上下）の位置

module marks(n) {
    for (k = [0 : n - 1]) {
        row = (k < 4) ? 1 : -1;             // 4 個までは上の列、残りは下の列
        j   = (k < 4) ? k : k - 4;
        cnt = (k < 4) ? min(n, 4) : n - 4;
        translate([(j - (cnt - 1) / 2) * HOLE_PX, row * HOLE_PY, -1])
            cylinder(d = HOLE_D, h = PAD_T + 2, $fn = 24);
    }
}

module one(i) {
    difference() {
        union() {
            translate([-PAD_X / 2, -PAD_Y / 2, 0]) cube([PAD_X, PAD_Y, PAD_T]);
            translate([0, 0, PAD_T - 0.01]) cylinder(d = PIN_D, h = LENS[i] + 0.01);
        }
        marks(i + 1);
        translate([0, 0, -0.01]) linear_extrude(LBL_DEEP + 0.01)
            mirror([1, 0, 0]) text(LBL[i], size = LBL_H, halign = "center", valign = "center");
    }
}

for (i = [0 : len(LENS) - 1]) translate([i * PITCH, 0, 0]) one(i);
translate([-PAD_X / 2, PAD_Y / 2 - BAR_W, 0])
    cube([(len(LENS) - 1) * PITCH + PAD_X, BAR_W, BAR_H]);

echo(str("ピン φ", PIN_D, " ／ 長さ ", LENS, " ／ 穴の数 1〜", len(LENS), " が番号"));
echo(str("読み方: ザグリへ落として、板が表面に着く中でいちばん長いピンが深さ（0.2 刻み）"));
