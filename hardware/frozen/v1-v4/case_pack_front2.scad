// 筐体の箱詰めスタディ ── 正面版2（case_pack_study.scad のコピーから）
// 2026-08-15。**OLED を ReSpeaker の前に出しただけ。他は動かしていない。**
//
// **これは筐体の設計ではない。「全部入れたら何mmの箱になるか」を見るためだけの当て板。**
// 部品の寸法は parts.scad / respeaker_lite.scad から呼ぶ。ここでは位置しか決めない。
//
//   openscad -o out.png -D 'CFG="rec"' hardware/case_pack_study.scad
//
// ---- 🎨 色の意味（docs/DIMENSIONS.md の格付けと同じ）----
//   緑の基板・灰色の部品 … ✅実測 か 📄公式CAD。**形も位置も信じてよい**
//   🟥 赤   #d9534f … ⬜ **数字そのものが無い。** 箱の大きさは仮（いまはハブ基板の層 18mm）
//   🟨 黄土 #c93    … ⚠ **数字はあるが疑いがある** ／ 中身が未取得の占有ボックス
//                      （いまは OLED の基板より上の 18.4mm と、AS5600 のコネクタ）
//   🟩 緑の柱       … マイクの音の通り道。**ここを塞いだら音が死ぬ**
//   🟧 橙           … ケーブル・プラグが挿さるのに要る空間
//   🩷 桃           … 電池を抜くための通り道
//
//   🔒 **赤と黄土は「体積だけが意味を持つ」。形は正しくない。**
//      この2つが図の中で目立つのは偶然ではなく、**箱の高さを決めているのがこの2つだから**。
//
// ---- 🔴 この図の読み方（先に読む）----
// 1. つまみは **knob_v4.scad の実物**が入っている（2026-08-16 に v3 から差し替え）。
// 🔴 **この当て板の役目は終わった。実物の筐体は hardware/case_v1.scad。**
//    こちらは「入るか」しか見ていないので、部品の固定・穴・組む順番は何も無い。
//    寸法も向こうが正（Y と、つまみの埋め方が違う）。**新しい判断は向こうでやること。**
// 2. 配置は「候補B: ReSpeaker を立てる」の1案だけ。最適化はしていない
// 3. ハーネスは 行A と 行S の2方向だけ。**列1（スピーカー）と列27（AS5600）は未計上**
//
// ---- 🔴 この当て板が一度こけた原因（同じことをしないために残す）----
// **AI が hardware/relay_board.html を開かず、途中で切れた grep の結果で設計した。**
// 見えていたのは XIAO・OLED・AS5600・スピーカー・リレー・ボタンまでで、
// **PowerBoost・トグル・リード・INA226 の4つが一度も目に入っていなかった。**
// その状態で「口はほとんど縁にある」「例外は OLED だけ」と3回断定し、
// **行S に口が4つ集中していることを見落としたまま「横出しで確定」と結論した**
// （2026-08-15・ユーザー指摘）。
// 🔒 **穴割りの話をするときは relay_board.html の initialLayout() を開く。**
//    grep の結果は「開いた」ことにならない（docs/DIMENSIONS.md「表だけ読むのは流し読み」）。
//
// ---- 🔴 候補A（全部平置き）は捨てた。マイクが箱の底を向いていた ----
// 最初の版は ReSpeaker を寝かせてヘッダを上に向けた。**そうするとマイク面が下を向く。**
// マイクは U4/U5 の2個で、**塞いだら音が死ぬ**（docs/RESPEAKER-LITE.md 「マイク面」）。
// 同文書は最初から「**基板は立てる。マイク面＝前／XIAO面＝後ろ**」と結論していたのに、
// 箱詰めのときにそれを参照しなかった。**マイクは上か正面のどちらかを向く**（ユーザー・2026-08-15）。
// → この版では ReSpeaker を立て、mic_path() で**音の通り道を可視化して**同じ失敗を防ぐ。
//
// ---- 何を確かめるために作ったか ----
// 体積の内訳を出すと、OLED とハブ基板の2つで**全部品の体積の約7割**になる。
// そしてこの2つは、**どちらも数字が確定していない**（OLEDの20mmは総厚の疑い、
// ハブ基板の高さは未取得）。**つまり箱の大きさは、この2つを測ると決まる。**
// CFG を切り替えると、その振れ幅がそのまま箱の寸法に出る。

use <parts.scad>
use <respeaker_lite.scad>
HUB_EMBEDDED = true;
use <hub_board.scad>
// 🔒 つまみは v4（軸の溝を半月2枚で挟む版）。v3 の knob_top.scad は
//    「上向きの止めが無い」「フランジが AS5600 の柱へ食い込む」の2点で捨てた
//    （knob_v4.scad の冒頭）。この当て板もそちらへ差し替えた（2026-08-16・ユーザー指示）。
use <knob_v4.scad>

$fn = 48;

// ============================================================
// 切り替え: 不確かな2つの数字をどう置くか
// ============================================================
CFG = "rec";   // "rec" = いま記録されている値 / "opt" = 疑いが晴れた場合

// OLED 2.42" の厚み
//   rec 20.0 … 📄 図面の値。⚠ 背面ヘッダ込みの総厚の疑い（docs/DIMENSIONS.md 1章）
//   opt  8.0 … ⚠ **仮定**。素のパネル ＋ 寝かせたヘッダならこの辺、という当て
// ✅ 2026-08-15、現物が着荷して **8.5mm** で確定（ユーザー実測）。CFG は用済み。
OLED_TH = 8.5;

// 🔒 コネクタ1個が要する空間 ✅**約25mm**（2026-08-15・ユーザー）
//    ハウジング ＋ 線が出て断線しない曲げで向きを変え切るまで。
//    🔴 **同じハウジングに同じ線が挿さるのだから、向きを変えても数字は同じ。**
//    ⚠ AI はこれを「向きに関係なく要る」と書いた直後に、ヘッダ高さを別の未知数として
//       測定を要求した。**同じ物を2回数えていた**（2026-08-15・ユーザー指摘で訂正）。
CONN = 25.0;

// ヘッダの向き。**これが唯一の設計変数**で、25mm をどの軸で払うかを決める
//   "ra"   = 横出し（ライトアングル）… 高さは小さく、基板面に25mm要る
//   "vert" = 立てる                  … 基板面は要らず、高さに25mm要る
HDR = "ra";

// 🔒 **推定をやめた。** hub_board.scad が relay_board.html の穴割りから実際に組み、
//    いちばん高い部品を見て返す（2026-08-15）。
//    ⚠ AI はここに横出し 8.0 / 立て 27.0 と置いていたが、**横出しは 13.6 が正しい。**
//       板の上でいちばん高いのは**ヘッダではなくリレー(10mm)**で、
//       ヘッダを寝かせてもリレーは寝ないから頭打ちになる。
HUB_TH  = hub_stack_h(HDR == "ra");
// 🔒 ライザー: XIAO の 2×7 ヘッダ（＝スロット）に挿さるカードで、下端がハブ基板に降りる。
//    ⭐ 行A の7本がケーブルでなくなるので、**25mm の通り道が丸ごと消える。**
//    ⚠ 代わりにカードの厚み＋ソケットのぶん 4mm だけ要る。
RISER = true;
// ✅ **ピンソケットは XIAO のヘッダに奥まで刺さることを現物で確認**（2026-08-15・ユーザー）。
//    ソケットの高さ **8.5mm**。ヘッダは 10mm 出ているので、
//    ソケットの底＝基板面はピンの根元から 8.5mm、**ピン先端(10mm)より内側に来る。**
//    ⭐ **つまりライザーの板は、いまの奥行きの中にほぼ収まり、Yへの張り出しはほぼゼロ。**
RISER_SOCKET_H = 8.5;   // ✅ ユーザー実測
HARNESS = RISER ? 2.0 : ((HDR == "ra") ? CONN : 2.0);   // 行A側（ReSpeaker行きの7本）

// 🔴 行S には口が4つ集中している（PowerBoost/トグル/リード/INA226）。
//    ⚠ **AI は穴割りを開かずに「縁はA・列1・列27」と書き、行Sを丸ごと見落としていた**
//       （2026-08-15・ユーザー指摘）。ここは行き先で要る空間が違う:
//         箱の下段へ降りる線（PowerBoost・INA226） … 縦に落ちるので横の通り道は要らない
//         パネルへ出る線（トグル・リード・会話ボタン）… 横の通り道が要る
//    ⬜ 分け方が未決なので、**両端を出して幅で示す**。
// ✅ 2026-08-16、gap 版を取り込んだので 0（下へ降ろす）を既定にした。
//    ⚠ ただし STAND_ALL のときは IN_Y が後ろの層で決まるので、**この値は寸法に効かない。**
//       効くのは寝かせる版（STAND_ALL=false）の絵と Y だけ
S_CORRIDOR = 0;   // 0 = 全部下へ降りる（下限） / 1 = 全部パネルへ出る（上限）
HARNESS_S = (HDR == "ra" && S_CORRIDOR == 1) ? CONN : 2.0;

UNSURE  = "#d9534f";   // ⚠/⬜ の部品はこの色
GAP     = 2.0;         // 層のあいだ
WALL    = 2.0;

// 分解図。0 = 実際の詰まった状態 / 40 くらいで層が離れて中が見える
EXPLODE = 0;
function ex(layer) = [0, 0, layer * EXPLODE];

// ============================================================
// 配置（候補B: ReSpeaker を立てる ＋ 天面OLED）
//   X = 肩に沿う長辺 / Y = 短辺（-Y が正面＝人の側） / Z = 高さ
//
//   🔒 **正面（Y=0 の壁）はマイクのもの。** ここに部品を置かない。
//      天面（+Z）は OLED が使うので、マイクは正面しか残っていない。
// ============================================================

// -------- 正面: ReSpeaker を立てる --------
// rotate([0,0,180]) は**回転であって鏡像ではない**（respeaker_lite.scad の 🚫 鏡像事故）。
// これでマイク面が -Y（正面）、XIAO面とヘッダが +Y（背面）を向く。
// 🔒 OLED を正面へ動かすだけの版（2026-08-15）。**他は一切動かさない。**
//    ⚠ AI は最初これをやらず、ハブ基板を立てて電池も PowerBoost も動かした
//       「別の箱」を作って比較した。比較になっていない（ユーザー指摘）。
OLED_FRONT = true;    // ← 手順2: OLED を ReSpeaker の前へ
FRONT_SHIFT = OLED_FRONT ? 8.5 : 0;   // ← 手順3: OLED の背後の隙間 8.5mm

RSP_X   = 2;                 // 左端
RSP_Y   = 2 + FRONT_SHIFT;   // マイクの先端が来る Y（＝正面の壁の内側）
RSP_Z   = 2;                 // 下端
RSP_MIC_OUT  = 1.275;        // 📄 マイクの出っ張り
RSP_DEPTH    = RSP_MIC_OUT + respeaker_T() + 10.0;   // マイク先〜ヘッダ先＝約13.1
RSP_TOP      = RSP_Z + 34.007;                       // 📄 立てたときの高さ

// 🔒 つまみユニット（hardware/knob_v4.scad）。天板の面から下へ 19.7mm、外へ 6.0mm。
//    座は 44 × 28mm。⚠ **座は正方形ではない。** X が長いのは半月を留める M2.5 が
//    へこみ（半径13.7）の外へ逃げたため。Y に効くのは 28 のほう。
// 🔒 knob_v4.scad の**実物**を呼ぶ。⚠ 以前ここは円柱と箱の置き換えだった（2026-08-15）
KNOB        = true;
KNOB_BAY_X  = knob_bay_x();   // 44.0
KNOB_BAY_Y  = knob_bay_y();   // 28.0 ← 箱の Y に効くのはこちら
KNOB_DEEP   = knob_deep();    // 17.2（v3 の 13.8 から深くなった）

// 🔒 つまみをどこに置くか（2026-08-15・ユーザー案）
//   true  … 立てたハブ基板の**真上**。Y は増えないが、高さがつまみの深さぶん伸びる
//   false … **ReSpeaker とハブ基板のあいだの帯**。高さは増えないが、
//            座がその帯に収まるまで **ハブ基板との隙間を広げる**必要がある
// ✅ 2026-08-16、**帯に逃がす版（false）を正式に採用**（ユーザー指示）。
//    高さ 71 → 58mm ／ Y 57 → 70mm で、体積はほぼ同じまま背が低くなる。
//    それまで別ファイル case_pack_front2_gap.scad で切り替えていたのをここへ取り込んだ。
KNOB_ON_HUB = false;
// ReSpeaker とハブ基板のあいだ。KNOB_ON_HUB=false のときは座が入るまで広げる
//   ReSpeaker の上に空いている Y は 13.1mm（基板の奥行き）。座 KNOB_BAY との差を足す
RSP_HUB_GAP = KNOB_ON_HUB ? HARNESS : max(HARNESS, KNOB_BAY_Y - 13.125);

// -------- 背面: 3段に積む --------
// 🔒 ハブ基板(74×52) と OLED(70×48) はほぼ同じ footprint なので、**必ず重ねる。**
//    横に並べると Y が一気に 30mm 伸びる（最初の版がそれで 99mm になった）
//
// 🔴 ハブ基板の 行A（A14〜A20 の7本）は **ReSpeaker 行きのハーネス**なので、
//    立てた基板と向き合う側に来る。ここに HARNESS を挟む。
//    ⚠ 前の版はここを GAP=2mm しか空けていなかった（2026-08-15 に発覚）
BACK_Y  = RSP_Y + RSP_DEPTH + RSP_HUB_GAP;  // 立てた基板の後ろから始まる帯
Z_BOT   = 0;                            // 下段: 電池と PowerBoost
// 🔒 ライザーは XIAO の2列（箱座標で Z 9〜11 と 27〜29）に跨がるので、下端は Z 9 まで降りる。
//    ハブ基板の**部品面**をそこに合わせると、塔が丸ごと低い位置から始まる。
//    ⚠ その代わり板の下は 5.4mm しか残らず、**PowerBoost(10mm) は入らない**（電池5mmは入る）。
// 🔒 ハブ基板の**部品面**の高さ。ライザーを使うと、ここは設計変数になる。
//    上限 Z 9 … カードの下端は「いちばん下のソケット（XIAOの下列 Z9〜11）」より
//                上に来られないので、板の面をそれより上へは持ち上げられない
//    下限 約3.6 … 板1.6 ＋ 半田面2 が箱の底に着く
HUB_TOP_Z = 9.0;   // 🔒 採用（2026-08-15）。ここだけ板の下に電池5mmが収まる
Z_HUB   = RISER ? (HUB_TOP_Z - hub_size()[2] - hub_solder()) : 12;

// 🔒 全部立てる（2026-08-15・ユーザー指示）。箱が OLED の48.1で背が高くなったので、
//    寝かせると高さが余って Y だけ食う。立てて Y 方向に並べる。
//    ライザーはそのまま（ReSpeaker のヘッダ ⇔ ハブ基板）。
STAND_ALL = true;


HUB_D   = hub_stack_h(true);            // 立てたときの厚み 13.6
LIPO_TH = 5.0;    // ⚠ parts.scad の LIPO_T は use で渡らないので数値で持つ
PB_TH   = 10.0;   // ⚠ 同じく PB_H

// 🔒 **ハブ基板の後ろは1層にまとめる**（2026-08-15・ユーザー指示）。
//    Y方向に積むと 電池5＋PB10＋スピーカー4.6＋隙間 で 25mm 伸びる。
//    3つとも立ててあるので、**同じ Y の面の中で X と Z に並べれば、
//    層の厚みはいちばん厚い PowerBoost の 10mm だけで済む。**
BACK2_Y = BACK_Y + HUB_D + GAP;   // 後ろの層が始まる Y
BACK2_D = PB_TH;                  // 層の厚み＝いちばん厚い部品

//   後ろの面（X 86 × Z 54）の割り付け:
//     電池        X  2〜56 / Z  2〜36   （54 × 34・厚5）
//     PowerBoost  X 58〜81 / Z  2〜38   （23 × 36・厚10。90度回して縦長に）
//     スピーカー  X  2〜25 / Z 38〜54   （23 × 16・厚4.6。電池の上）

LIPO_AT = [ 2, BACK_Y,      Z_BOT];     // （寝かせる版の位置。STAND_ALL では使わない）
PB_AT   = [81, BACK_Y,      Z_BOT];
SPK_AT  = [ 2, BACK_Y + 36, Z_BOT];
// 立てる版でスピーカーが座る帯（ReSpeaker の上）。⚠ つまみと取り合うので変数で持つ。
// rotate([90,0,0]) を掛けるので、実際に埋まるのは X 20〜43 / Y ここ−4.6〜ここ / Z 38〜54
// ✅ 2026-08-16、つまみの座（X 40〜）との重なりを消すため X 20 → 10 へ寄せた。
//    ⚠ X 1〜9 は ReSpeaker の USB-C ケーブルが上へ抜ける帯なので、そこまでは寄せない
SPK_BAND_AT = [10, RSP_Y + 4.6, 38];
HUB_AT  = [ 2, BACK_Y,      Z_HUB];

// -------- 天面: OLED（ハブ基板の真上）--------
Z3      = Z_HUB + HUB_TH + GAP;
OLED_AT = [ 8, BACK_Y + 2, Z3];         // OLED 70.1 × 48.1

// -------- 内寸 --------
// 高さは「立てた基板」と「ハブ＋OLEDの塔」の高いほうで決まる
IN_X = 86;
IN_Y = STAND_ALL ? (BACK2_Y + BACK2_D + GAP) : (BACK_Y + 52 + HARNESS_S);
// つまみは天面から19.8mm下へ食い込む。立てたハブ基板(52)と場所を取り合うので、
// STAND_ALL のときは「ハブの上端 + つまみの深さ」が高さの下限になる
// つまみをハブの上に置くときだけ、ハブの上端 + つまみの深さ が高さの下限になる。
// 帯に逃がせば、高さは立てたハブ基板(52)止まりで済む。
IN_Z = OLED_FRONT
     ? max(RSP_TOP, 1.5 + 48.1 + 1.5,
           // ✅ 2026-08-16、54 → 56。つまみの下端が立てた ReSpeaker の頭に
           //    1.7mm めり込んでいたぶんを足した（当て板は天板を内側に置くため）。
           //    55.7 でちょうど 0 になるので、逃げ 0.3 を見て 56。case_v1 と同じ高さ
           STAND_ALL ? ((KNOB && KNOB_ON_HUB) ? 53 + KNOB_DEEP : 56)
                     : (KNOB ? Z_HUB + HUB_TH + KNOB_DEEP : 0))
     : max(RSP_TOP, Z3 + OLED_TH);

// ============================================================
// 描画
// ============================================================

module ghost_box(at, size, name) {
    translate(at) color(UNSURE, 0.55) cube(size);
}

// --- 層1 ---
// ReSpeaker: モデルはローカルで X=長辺 / Z=34の高さ / Y=板厚 なので、
// rotate([-90,0,0]) で寝かせるとヘッダが +Z（上）を向く（respeaker_lite.scad の座標系）
// 🔒 マイクの音の通り道。**正面の壁は、ここだけは必ず開ける。**
// 位置は PARTS_CAD から引くので、基板を動かしても勝手に付いてくる（手で転記しない）
module mic_path(len = 25) {
    for (ref = ["U4", "U5"]) {
        m = cad_part(ref, -1);
        color("#2ecc71", 0.45) face_box(m[2], m[3], m[4], m[5], len, -1);
    }
}

// --- 正面: 立てた ReSpeaker ---
translate(ex(0))
translate([RSP_X + respeaker_L(), RSP_Y + RSP_MIC_OUT + respeaker_T(), RSP_Z])
    rotate([0, 0, 180]) {
        respeaker_lite();
        color("#f80", 0.20) respeaker_mating_space();   // ケーブルが要る空間
        mic_path();                                     // 🟢 塞いだら音が死ぬ
    }

// --- ハーネスの帯（立てた基板 ⇔ ハブ基板の行A）---
// 🩶 ここは「線が曲がるためだけ」に要る空間。部品は置けない
translate(ex(0)) color("#8e44ad", 0.18)
    translate([2, RSP_Y + RSP_DEPTH, 0])
        cube([74, HARNESS, 20]);

// --- 背面: 電池（立てる）---
if (STAND_ALL)
    translate([2, BACK2_Y + LIPO_TH, 2]) rotate([90, 0, 0]) {
        lipo_1000mah();
        color("#c33", 0.12) translate([-54, 0, 0]) cube([54, 34, 5]);   // 抜く通り道
    }
else translate(ex(0)) {
    translate(LIPO_AT) lipo_1000mah();
    translate(LIPO_AT) color("#c33", 0.12) translate([-54, 0, 0]) cube([54, 34, 5]);
}

// --- 背面の中段: ハブ基板・PowerBoost・スピーカー ---
if (STAND_ALL)
    translate([2, BACK_Y + HUB_D, 1]) rotate([90, 0, 0]) {
        hub_board(true);
        hub_corridors(true, "down");
    }
else translate(ex(1)) {
    // 🔒 実物のモック。穴割りから生成した部品が実位置に載っている
    translate(HUB_AT + [0, 0, hub_solder()]) {
        hub_board(HDR == "ra");
        // ⚠ S_CORRIDOR=0 は「行S の線は横へ出ず、下段へ降りる」という想定なので、
        //    そのときは横の通り道を描かない。**絵と寸法計算を食い違わせない。**
        hub_corridors(HDR == "ra", S_CORRIDOR == 0 ? "down" : undef);
    }
}

// --- 背面: PowerBoost とスピーカー（立てる）---
if (STAND_ALL) {
    // PowerBoost は 90度回して縦長（23幅 × 36高）にしてから立てる
    translate([58 + 22.86, BACK2_Y + PB_TH, 2])
        rotate([90, 0, 0]) rotate([0, 0, 90]) powerboost_1000c();
    // 🔒 スピーカーは **ReSpeaker の上の帯**へ（2026-08-15・ユーザー指示）。
    //    ここは 86 × 18 × 13.1 の隙間で、**動かせる部品のうち入るのはスピーカーだけ**
    //    （PowerBoost は最小辺 22.86 で 18mm に入らない）。
    //    ⭐ 機能的にも: 後ろの層に埋めると音が全部の基板の裏から出る。
    //    ⚠ X は 20〜43。**X 1〜9 は ReSpeaker の USB-C ケーブルが上へ抜ける帯**なので避ける。
    translate(SPK_BAND_AT) rotate([90, 0, 0]) speaker_112495();
} else translate(ex(0)) {
    translate(PB_AT) rotate([0, 0, 90]) powerboost_1000c();
    translate(SPK_AT) speaker_112495();
}

// --- 天面: OLED ---
// ⚠ OLED は厚みが総厚の疑い。oled_242() が既に「基板＋占有ボックス」で描いてくれる
if (OLED_FRONT)
    translate([(IN_X - 70.1) / 2, OLED_TH, 1.5]) rotate([90, 0, 0]) oled_242();
else
    translate(ex(2)) translate(OLED_AT) oled_242();

// --- つまみユニット（天面）---
// 🔒 knob_v4.scad の**実物**を呼ぶ。円柱と箱の置き換えにしない（2026-08-15）
//    assembly() は既定で天板（deck_test）ごと描く。この当て板では天板＝箱の天面なので、
//    へこみ・落とし込み穴・リードの溝が入った実物の板がそのまま Z=IN_Z に乗る。
// 帯に置く場合: X は右寄せ、Y は帯（ReSpeaker の奥行き ＋ 広げた隙間）の中心に置く。
// ⚠ RSP_HUB_GAP はこの帯が KNOB_BAY_Y に届くよう決めた値なので、中心はここから導く。
//    手で足し引きした補正値を入れない
KNOB_AT = KNOB_ON_HUB ? [IN_X / 2, BACK_Y + 8, IN_Z]
                      : [IN_X - KNOB_BAY_X / 2 - 2,
                         RSP_Y + (RSP_DEPTH + RSP_HUB_GAP) / 2, IN_Z];
if (KNOB) translate(KNOB_AT) assembly();

// --- 内寸の枠（分解時は消す）---
if (EXPLODE == 0) color("#39c", 0.10) cube([IN_X, IN_Y, IN_Z]);

// ============================================================
// 数字を出す
// ============================================================
OUT_X = IN_X + WALL * 2;
OUT_Y = IN_Y + WALL * 2;
OUT_Z = IN_Z + WALL * 2;

echo(str("=== HDR=", HDR, "  CFG=", CFG,
         "   OLED=", OLED_TH, " / ハブ層=", HUB_TH, " / 通り道=", HARNESS, " ==="));
echo(str("内寸  ", IN_X, " x ", IN_Y, " x ", IN_Z));
echo(str("外寸  ", OUT_X, " x ", OUT_Y, " x ", OUT_Z,
         "   = ", OUT_X * OUT_Y * OUT_Z / 1000, " cm3"));
// ⚠ study から引き継いだ診断文は front2 では当たらないので書き直した（2026-08-15）
H_RSP  = RSP_TOP;                                  // 立てた ReSpeaker
H_OLED = OLED_FRONT ? (1.5 + 48.1 + 1.5) : 0;      // 正面に立てた OLED
H_HUB  = (STAND_ALL && OLED_FRONT) ? 54 : 0;       // 立てたハブ基板 52 + 余白
echo(str("高さの内訳: 立てたReSpeaker ", H_RSP,
         " / 正面のOLED ", H_OLED, " / 立てたハブ基板 ", H_HUB,
         "   → 効いているのは ",
         (H_HUB >= H_OLED && H_HUB >= H_RSP) ? "立てたハブ基板" :
         (H_OLED >= H_RSP) ? "正面のOLED" : "立てたReSpeaker"));
echo(str("StackChan 234cm3 との比 ", OUT_X * OUT_Y * OUT_Z / 1000 / 234));

// ---- つまみ(v4) の取り合い ----
// 🔒 座は 44×28 の**べた**なので、他の部品と AABB が重なったらそのまま当たっている。
//    ⚠ 数字を手で書き写して比べない。全部この上で使っている変数から取る
K_X0 = KNOB_AT[0] - KNOB_BAY_X / 2;  K_X1 = KNOB_AT[0] + KNOB_BAY_X / 2;
K_Y0 = KNOB_AT[1] - KNOB_BAY_Y / 2;  K_Y1 = KNOB_AT[1] + KNOB_BAY_Y / 2;
K_Z0 = IN_Z - knob_pad_h();          // 座の下面。ここより下は柱と AS5600 だけ
echo(str("つまみ v4: 座 X ", K_X0, "〜", K_X1, " / Y ", K_Y0, "〜", K_Y1,
         " / 座の下面 Z ", K_Z0, " / 全体の下端 Z ", IN_Z - KNOB_DEEP));
echo(str("  立てた ReSpeaker の頭(", RSP_TOP, ") との間 ",
         IN_Z - KNOB_DEEP - RSP_TOP, "mm"));
echo(str("  ハブ基板の面(Y ", BACK_Y, ") との間 ", BACK_Y - K_Y1, "mm"));
// スピーカー（X 20〜43 / Y SPK-4.6〜SPK / Z 38〜54）と座の重なり
S_OX = min(K_X1, SPK_BAND_AT[0] + 23) - max(K_X0, SPK_BAND_AT[0]);
S_OY = min(K_Y1, SPK_BAND_AT[1]) - max(K_Y0, SPK_BAND_AT[1] - 4.6);
S_OZ = min(IN_Z, SPK_BAND_AT[2] + 16) - max(K_Z0, SPK_BAND_AT[2]);
echo(str("  スピーカーとの重なり X ", S_OX, " / Y ", S_OY, " / Z ", S_OZ,
         "  → ", (S_OX > 0 && S_OY > 0 && S_OZ > 0) ? "🔴 当たっている" : "当たっていない"));
