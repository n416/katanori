// 🔒 **可動域が裏返っていないかの検査。** リード磁石が接点の真上に来る姿勢（回転0）で、
//    そこから右（時計回り）と左へ何度回せるかを出す。
//    ⚠ OFF は時計回り側の端。右 315 / 左 0 が正しい。逆なら可動域が裏返っている
//    （2026-08-17 まで逆だった。実物を組むまで誰も気づけなかったので、ここで見る）
// ---- 可動域とリードの反応帯の突き合わせ ----
// 🔒 数字は**ツメと壁の位置から引く**。パラメータをそのまま印字しても検査にならない
//    （両方動かして相対角度が変わっていない、という間違いを見逃す）。
//    つまみの回転角 θ: 0 = 磁石がリードの真上 / + が反時計回り
LUG_A0  = STOP_ANG - LUG_ARC;                     // ツメの時計回り側の端
TH_CCW  = STOP_ANG - (LUG_A0 + LUG_ARC);          // 反時計側の端（＝スタート位置）
TH_CW   = (STOP_ANG + POST_ARC - 360) - LUG_A0;   // 時計側の端（＝回し切り）
echo(str("可動域 θ ", TH_CW, " 〜 ", TH_CCW, "（", TH_CCW - TH_CW,
         "度）/ スタート位置は反時計側の端 → そこから右へ ", TH_CCW - TH_CW,
         "度 ⚠ 315 でなければ裏返りか壁の作り間違い"));
// 🔒 スタート位置は帯の**内側**に居ること。縁に乗せるとスタート位置で電源が切れない
REED_BAND = 15;   // ✅ 2026-08-17 実測（磁石の真上から片側）
DIFF_START = 90 - (MAG2_ANG + TH_CCW);            // スタート位置での磁石とリードの角度差
echo(str("スタート位置での磁石とリードの角度差 ", DIFF_START,
