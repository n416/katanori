// つまみユニット v4 ── 軸の溝を半月2枚で挟む版（2026-08-15）
//
//   openscad -o knob.stl -D 'part="knob"' hardware/knob_v4.scad   // つまみ（1個）
//   openscad -o half.stl -D 'part="half"' hardware/knob_v4.scad   // 半月（2個刷る）
//   openscad -o deck.stl -D 'part="deck"' hardware/knob_v4.scad   // 卓上テスト用の天板
//   openscad -o wall.stl -D 'part="wall"' hardware/knob_v4.scad   // 壁（1個）
//   （part 未指定なら組み立てビュー。part="explode" で分解図）
//
// ============================================================
// なぜ v3 を捨てたか
// ============================================================
// v3（knob_top.scad）には2つ穴があった。どちらも実物を刷る前に潰した。
//   ① 上向きの止めが1つも無い。持ち手 φ25 は天板の**上**に乗っているので、
//      引き上げると天板から離れるだけ。フランジ φ21 は穴 φ21.7 を素通りする。
//      v3 のヘッダーの「持ち手が穴に当たって抜けない」は誤り。
//   ② フランジ φ21（半径 10.5）が AS5600 の柱4本（内縁 半径 8.34）へ
//      2.16mm 食い込む。OpenSCAD で交差を取って実体が残ることを確認済み。
//      そもそも組めない。
// 🔒 knob_top_knob.stl / knob_top_ring.stl / knob_top_deck.stl は刷らないこと。
//    ✅ 2026-08-29 **3 つとも削除した**（knob_v4_deck / knob_v4_half / knob_v4_knob も同時）。
//    どれもピッチ 17.0 で焼いてあり、実測で 16.10 に決着した今は柱の位置が違う。
//    いま刷ってよいつまみ側の STL は knob_v5_deck.stl（卓上テスト用）だけ。
//
// ============================================================
// v4 の構造
// ============================================================
//   つまみは1部品。軸の途中に**段を2つ**作り、そのあいだの首（3.2mm）へ
//   半月（3.0mm）を左右から差し込んで、天板の裏へねじ止めする。
//     ・下向き … 段Aの下面が半月の上面に乗る。**つまみは半月からぶら下がる**
//     ・上向き … 段Bの上面が半月の下面に当たる
//     ・中心   … 半月の内穴 φ6.35 が軸を掴む（掛かりは半月の厚み 3mm）
//   持ち手は天板に触れない（0.5mm の逃げ）。擦れるのは半月の中だけ。
//
//   上下の遊び 0.2mm は「段Aと段Bの間隔」＝**つまみ1部品の中の寸法**なので
//   印刷で出せる。天板とつまみを足し引きした値ではない。
//
//   段はどちらも φ15 で、天板の穴 φ16 を上から通る。半月は丸いままだと
//   軸に通せないので2枚に割る。組む順は「つまみを落とす → 半月を寄せる → 締める」。
//
// ---- 🔒 治具から引き継ぐ実績値（作り直さない）----
//   SHRINK 0.1 / MAG_D 4.10 / BORE_CLEAR 0.25 / CHIP_GAP 1.1
//   HOLE_PITCH 17.0 / SLOT_LEN 2.0 / STANDOFF_D 6.0 / 六角ポケットは呼び+0.3
//
// ---- ✅ ユーザーの手持ち（2026-08-15 に本人が確認）----
//   M2.5 ナイロンねじ 長さ6mm・頭厚 2mm ／ M2.5 ナイロンナット 対辺5mm・厚み3mm
//   ナイロンなので磁石に影響しない。半月の軸受け面にはシリコングリスを塗る。
//
// ---- ⬜ まだ入っていないもの ----
//   ・回転の壁（315度で止める仕組み）
//   ・リードスイッチ一式 … 🔴 先に閉じる距離を測る（TODO A-3）
//       置き場所の見込み: 磁石(φ6×2)は持ち手の外周へ埋める。持ち手はへこみの中に
//       沈むので、外周はへこみの壁（半径 13.7）のすぐ内側に来る。リードスイッチ
//       (2.5×14) は壁の外＝天板の肉の中に寝かせれば、磁石との距離を数mmまで詰められる。
//       ⚠ ただし ±X はナットのポケット（半径 13.94〜20.06）が占めている。リードは
//       ±Y 側になるが、いまの座は Y が ±14 しかない。**距離が出るまで座の Y を
//       決められない**。測ってから、Y を広げるかどうかを決めること。
//   ・刷り直したらゼロ点を取り直す（knobzero）

// ============================================================
// 🔒 v5: 壁を1枚だけ別部品にする（2026-08-19・ユーザー案）
// ============================================================
// 直すのは2つ。**同時にやる**（別々だと同じ所を二度設計することになる）。
//   ① 上に引っ張ると限界止めを越えられる … ツメの掛かり 0.50 < つまみの浮き 0.975
//   ② へこみの底が荒れる … 掘り込みの底は刷ると必ず天井になる
//
// 🔒 **面はツルツルにならない。荒れる場所を、見えず触らない所へ移す。**
// 天板と床は一体のまま。別部品にするのは「壁」1枚だけ。
// 🔴 **「留め具は要らない（落ちようがない）」は取り消し**（2026-08-19）。これは 🔒 が付いていたが、
//    ユーザーの決定ではなく AI が書いたものだった。ユーザーはこの輪のねじ止めを再三勧めていて、
//    そのたびに却下されていた。理由に書いてあった「落ちようがない」は**落下の話**で、
//    この部品に要るのは**位置と平面が動かないこと**。答える相手を間違えている。
//    ⚠ 実際、圧入で歪み・島が反り・痕に乗り上げ、つまみが回らなくなった。
//    → 輪はねじで留める。回転止めもねじが持つ（ユーザー・2026-08-19）。
//
// ---- 面の一覧（🔴 CAD を触る前にこれを埋める。飛ばすと天井が復活する）----
//
//   【壁】刷る向き: **へこみの底になる面（上面）をプレートに直置き**
//     上面（へこみの底・見える・持ち手の下）… プレートに接する    ✅ 平ら
//     下面（床に乗る）                      … 上を向く            ✅ 平ら
//     円弧のスリットの壁（ツメが当たる）    … 垂直・貫通          ○ 層の縞
//     回り止めのピン（下面から生える）      … 刷ると**上へ伸びる** ✅ 支え不要
//     🔒 **下を向く水平面: 0**
//
//   【天板＋床】刷る向き: 見える面をプレートへ（いままで通り・上シェルごと）
//     見える面                       … プレートに接する            ✅
//     へこみ／壁の座の壁（φ26.2）    … 垂直・貫通                  ○
//     壁を受ける輪（半径 12.0〜13.1）… **天井**・幅 1.1・外周全周で付く 🔶「青」と同じ
//     掘り下げた床（5.5〜12.0）      … **天井**・幅 6.5 の片持ち     🔴 荒れる
//     回り止めの穴・落とし込み穴     … 貫通                        ✅
//     裏（リードの溝・M2.5・樋・柱） … 上を向く                    ✅
//     ✅ **荒れる面はどちらも持ち手（φ25）の下に隠れ、ツメとも 1.0mm 空く。**
//        だから**支柱の痕が残ってよい**。ここが分割の効き目
//     🔴 支柱は**モデルに入れる**（deck_props）。スライサーのサポートは効かなかった（実測）
//
// ---- 何が消えたか ----
//   ・支柱（deck_props）… 天井が機能面でなくなったので、モデルに埋め込む必要が無い
//   ・へこみの底に彫っていた円弧の溝 … 壁のスリットに置き換わった
//
part = "explode";
// 🔒 サポートの足元に敷く床（ラフト）。**刷るときだけ要る。画面では邪魔なので既定で切る。**
//    ⚠ -D raft=true / false で上書きできる
raft = (part == "deck");
// 🔒 壁の犠牲ブリッジ。**刷るときだけ架ける。組む前に切る。**
//    ⚠ -D bridges=true / false で上書きできる
bridges = (part == "wall");
$fn  = 96;

use <parts.scad>   // reed_switch() / magnet_reed() / magnet_as5600()

// ---- 治具から引き継ぐ ----
SHRINK     = 0.1;
MAG_D      = 4.10;
MAG_DEPTH  = 2.2;
SHAFT_D    = 6.0;
BORE_CLEAR = 0.25;         // 🔒 軸受けの遊び（直径）。入口逃がしとセットで成立する値
PCB        = 23.0;
PCB_T      = 1.6;
CHIP_H     = 1.1;
CHIP_GAP   = 1.1;
HOLE_PITCH = 17.0;
SLOT_LEN   = 2.0;
STANDOFF_D = 6.0;
M2_D       = 2.0 + SHRINK + 0.3;   // 基板を留める M2 の通し穴
M2_NUT_AF  = 4.0 + 0.3;
M2_NUT_T   = 1.6;
M2_SHELF   = 1.2;              // 柱の下端に残す棚。ここで基板を締め付ける
STANDOFF_D_LO = 8.0;           // 柱の下端。ナットの横挿し口のぶん太らせる

// ---- 手持ちの M2.5 ナイロン（半月の固定）----
M25_D      = 2.5 + SHRINK + 0.4;   // 通し穴 φ3.0
M25_NUT_AF = 5.0 + 0.3;            // 対辺 5.0（実測）＋ 六角ポケットの実績 0.3
M25_NUT_T  = 3.0;                  // 厚み 3.0（実測）
M25_LEN    = 6.0;
M25_HEAD_D = 5.0;
M25_HEAD_T = 2.0;

// ---- つまみ ----
GRIP_D   = 25.0;
// ✅ 2026-08-15「高さが無駄に高い。半月が滑らかなので指だけで回せる。突起も要らないかも」
//    12.0 → 8.0（外へ出るのは 10.0 → 6.0mm）。ローレットは無しにした。
//    ⚠ 下限は 2.7mm（磁石ポケット 2.2 ＋ 天面の肉 0.5）。8.0 はまだ十分余裕がある。
//    戻すときは RIB_N = 24 / RIB_D = 1.2。へこみの径は自動で追従する
GRIP_H   = 8.0;
RIB_N    = 0;
RIB_D    = 0;
// 🔒 持ち手の裏と、へこみの底（＝壁の上面）の逃げ。
//    ⚠ **ここはツメの掛かりを直接削る。**掛かり ＝ STOP_T − GRIP_GAP。2026-08-19、0.5 → 0.35
GRIP_GAP = 0.35;
// ✅ 2026-08-16、φ15 から φ10 へ。実物で2つ壊れたので細くした。
//   ① φ15 だとリード用磁石（半径 5.35〜11.45 に立つ）の**下からの通り道を段Aが塞ぐ**。
//      磁石が物理的に入らなかった。つまみ側の挿入経路を検査していなかった。
//   ② φ6 の軸から片側 4.5mm 張り出す下向きの円板になり、**段Bが半分しか刷れなかった。**
//      崩れた段Bが上の軸を道連れにして、軸の先も折れた。φ10 なら張り出しは 2.0mm。
//   半月が掴むのは内穴 φ6.35 なので、段は φ10 でも掛かりは 1.8mm ある。つまみは4g
STEP_D   = 10.0;           // 段A・段B。天板の穴より細いこと
STEP_T   = 2.0;
PLAY     = 0.2;            // 軸方向の遊び。段Aと段Bの間隔で決まる
TIP_LEN  = 3.0;            // 段Bより下の軸（磁石ポケットが入る）
// 🔒 軸の先だけ太らせる。⚠ φ6 のままだと磁石ポケットの壁が (6.0−4.10)/2 = **0.95mm** で、
//    2026-08-16 の印刷で折れた。この 0.95 は誰も決めていない値で、
//    「軸 φ6（半月との嵌合）」と「ポケット φ4.10（ゲージ）」の**引き算の余り**だった。
//    φ8 にすれば壁は 1.95mm。AS5600 の柱の内縁は下端でも 7.34mm なので当たらない
TIP_D    = 8.0;

// ---- 半月（2枚）----
RING_T    = 3.0;
RING_BORE = SHAFT_D + SHRINK + BORE_CLEAR;   // 6.35
RING_R    = 7.6;           // 円盤部の半径。⚠ 柱の内縁 8.34 より内側
ARM_W     = 7.0;           // 腕の幅（Y）。⚠ 柱の角度帯 28〜64度に触れない幅
ARM_W2    = 9.0;           // 柱より外（x>15）では広げてよい。腕のたわみ止め
BOSS_X    = 17.0;          // ねじの位置（±X）。⚠ へこみ（半径13.7）の外に出すこと
SPLIT_GAP = 0.15;          // 割り面の逃げ（片側）。合わせて 0.3
// 入口逃がしの深さ。プレート側の過硬化を逃がす。
// 🔴 **下側の逃がしは、そのままつまみが浮く量になる。**段Bの円錐（45度）とこの逃がし
//    （同じ45度）は入れ子になるので、抜け止めが効くのは逃がしを抜けた奥の稜線。
// 🔒 0.6 → 0.3。過硬化はボトム5層＝0.25mm（docs/PRINT.md）。⚠ これ以上は減らせない
BORE_RELIEF = 0.3;
// 頭のザグリ。手持ちのねじ 6mm を「半月の残り 1.5 ＋ 棚 1.5 ＋ ナット 3.0」で
// 成立させるために要る。頭の出っ張りも 2.0 → 0.5mm に収まる
HEAD_CB_D = M25_HEAD_D + 0.2;
HEAD_CB_T = 1.5;

// ---- 天板 ----
DECK_T = 2.5;              // 見える面の厚み
// 裏の増し肉。棚 1.5 ＋ ナットのポケット 3.2 ＝ 4.7 が要る。
// ⚠ ポケットは増し肉の中で閉じること。天板の見える層まで食い込むと、縁での
//    差し込み口が 3.2mm 取れず、ナットが入らない
PAD_T  = 5.2;
HOLE_D = STEP_D + SHRINK + 0.9;   // 11.0 落とし込みの穴（⚠ 段を φ15→φ10 にしたので 16 ではない）
PAD_X  = 44.0;
PAD_Y  = 28.0;
// ✅ 2026-08-15 決定「いっそこれでいい」。持ち手はへこみに沈める方式で確定。
//    ⚠ ユーザーが最初に言っていたのは**エンボス（周りを盛り上げる）**で、掘るのは
//    取り違えだった。実物を見て沈める方を採った、という経緯。勝手に戻さないこと。
//    代償は座が 36→44 に広がったこと（ねじがへこみの縁の外へ逃げたため）。
// 持ち手はこのへこみの中に沈む。外へ出るのは 12.0 − 2.5 + 0.5 = 10.0mm
DISH_D = GRIP_D + RIB_D + 1.2;   // 26.2 ⚠ 持ち手の外径（ローレット込み）を通すこと
DISH_T = 2.5;
// 🔒 ナットの受けは「ねじ側から見て丸穴、その奥が六角」。奥に**棚**を残すこと。
//    ⚠ 2026-08-15、一度これを「下向きの止まり穴（底は裏面と面一）」にして間違えた。
//    面一でもナットの下は何も塞いでいないので、締めるとナットが下へ押し出され、
//    天板が力の通り道から外れて締まらない。ユーザーが図で見つけて差し戻した。
//    ナットは天板の +Y の縁から横に差し込み、棚の上に座る。
NUT_SHELF = 1.5;           // ナットの下に残す肉。締め付けを受けるのはここ

// ---- リードスイッチ ----
// ✅ 2026-08-15 ユーザー実測: 閉じるのは 5mm。ただし**接点は真ん中の一点**で、
//    端へ行くほど反応が鈍る。磁石は平らな面を接点へ向けること。
// 🔒 磁石は持ち手の**裏面**に、面を真下へ向けて埋める。側面に埋めると磁石が天板の
//    面より上・リードが下になり、上下に 3mm ずれて合計 4.6mm（残り 0.4mm）になる。
//    裏面なら 2.9mm（残り 2.1mm）で、外から磁石も見えない。
MAG2_PART_D = 6.0;         // 実物の直径（📄 リードスイッチ付属 φ6×2）
// 🔴 2026-08-17、**磁石が入らなかった**。原因はゲージの答えの取り違え。
//    ゲージの丸穴の答え 6.10 は「軸方向に押し込んで**落ちない**いちばんきつい穴」＝
//    圧入の答えで、それを**横から滑り込ませる通り道の幅**に使っていた。
//    刷ると 0.1 縮んで 6.0 ＝ 磁石と同寸になり、道が無くなる。ゲージは正しく、
//    **6.1 という滑らせ方は一度も試していない。**
// 🔒 ゲージで磁石が実際に**滑って入った**のは3列目の溝で、進行方向の幅は 6.3 だった
//    （[fit_gauge.scad](fit_gauge.scad) の EDGE_LEN）。こちらを採る。
//    ⚠ ポケットは**逃げであって圧入ではない**。掴むのは MAG2_SLOT_W の2面だけ。
//    代償は持ち手の外壁 1.05 → 0.95mm。半径方向へ押し広げる力はもう掛からないので許容
MAG2_D  = MAG2_PART_D + 0.3;   // 6.3 ポケットの径＝通り道の幅
MAG2_T  = 2.2;
// 🔒 逃がしが要るのは「**プレートに接している面**の穴」だけ。ボトム層（35秒×5層＝
//    0.25mm）が過硬化して縮む（docs/PRINT.md）。ゲージの「一番奥が通らない」もこれ。
//    ⚠ 2026-08-17、この理屈を**プレートに接していない口にも当てて**しまい、
//    つまみの磁石ポケットとリードの溝に不要な逃がしが残っていた。前者は幅0.5mmの
//    薄い輪を立て、後者は圧入の噛み代を0.6mm削っていた。どちらもユーザーが発見。
//    いま逃がしが入っているのは**半月の軸受け穴だけ**（あれは実際にプレートに接する）。
// ⚠ 8.8 にしていたとき、持ち手の外周までの壁が 0.65mm しか無かった（2026-08-16 指摘）。
//    0.4 内側へ寄せて 1.05mm にした。代償はリードとの距離 4.51 → 4.69mm。
//    圧入は厚み方向（MAG2_SLOT_W）だけなので、この壁を外へ押す力はかからない
// ✅ 2026-08-17 ユーザー発案「リードスイッチを左に10〜15度ずらせばいい」。
//    スタート位置で磁石をリードの真上に置くと、リードはそこから 15度 のあいだ閉じたままで、
//    その区間は電源が入らない。ファームの閾値をその外へ逃がすと、こんどは鳴らない区間が
//    そのぶん広がる。**スタート位置を反応帯の縁へ寄せれば両方短くできる。**
// 🔒 量は 10度。⚠ 15度 は反応帯の縁そのもので、**スタート位置で電源が切れない**側に倒れる。
//    反応帯 15度 自体が写真からの読みなので、縁には置かない。10度 なら帯の内側に 5度 残る。
STOP_OFF_ANG = 10;         // スタート位置で、磁石がリードの真上から何度ずれているか
MAG2_R  = 8.4;             // 持ち手の裏。この半径に円板の中心
// 磁石の角度（つまみ座標）。90 = +Y ＝ スタート位置でリードの真上。
// 🔒 ここを時計回りへ STOP_OFF_ANG ずらすことで、スタート位置を反応帯の縁へ寄せる。
//    ⚠ ずらすのは**磁石か、リードの溝か、ツメの、どれか1つだけ**。2つ動かすと打ち消す。
//    ツメでやるとスタート位置そのものが傾く（2026-08-17 差し戻し）
MAG2_ANG = 90 - STOP_OFF_ANG;   // 80度
// 立てた円板の座の中心。
// 🔒 ポケットを広げても**磁石の座る高さは動かさない**。ここが動くとリードとの距離が
//    そのまま変わる（4.69mm ／ 閉じるのは 5mm）。磁石は天井に当たるまで押し込むので、
//    天井を「持ち手の裏 ＋ 磁石の直径 ＋ 0.05」に置き、そこから半径ぶん下げた点が中心。
