// つまみユニット v4 ── 軸の溝を半月2枚で挟む版（2026-08-15）
//
//   openscad -o knob.stl -D 'part="knob"' hardware/knob_v4.scad   // つまみ（1個）
//   openscad -o half.stl -D 'part="half"' hardware/knob_v4.scad   // 半月（2個刷る）
//   openscad -o deck.stl -D 'part="deck"' hardware/knob_v4.scad   // 卓上テスト用の天板
//   （part 未指定なら組み立てビュー。part="explode" で分解図）
//
// ============================================================
// なぜ v3 を捨てたか
// ============================================================
// v3（knob_top.scad）には2つ穴があった。どちらも実物を刷る前に潰した。
//   ① 上向きの止めが1つも無い。持ち手 φ25 は天板の**上**に乗っているので、
//      引き上げると天板から離れるだけ。フランジ φ21 は穴 φ21.7 を素通りする。
//      v3 のヘッダーの「持ち手が穴に当たって抜けない」は誤り。
//   ② フランジ φ21（半径 10.5）が AS5600 の柱4本（内縁 半径 8.34）へ
//      2.16mm 食い込む。OpenSCAD で交差を取って実体が残ることを確認済み。
//      そもそも組めない。
// 🔒 knob_top_knob.stl / knob_top_ring.stl / knob_top_deck.stl は刷らないこと。
//
// ============================================================
// v4 の構造
// ============================================================
//   つまみは1部品。軸の途中に**段を2つ**作り、そのあいだの首（3.2mm）へ
//   半月（3.0mm）を左右から差し込んで、天板の裏へねじ止めする。
//     ・下向き … 段Aの下面が半月の上面に乗る。**つまみは半月からぶら下がる**
//     ・上向き … 段Bの上面が半月の下面に当たる
//     ・中心   … 半月の内穴 φ6.35 が軸を掴む（掛かりは半月の厚み 3mm）
//   持ち手は天板に触れない（0.5mm の逃げ）。擦れるのは半月の中だけ。
//
//   上下の遊び 0.2mm は「段Aと段Bの間隔」＝**つまみ1部品の中の寸法**なので
//   印刷で出せる。天板とつまみを足し引きした値ではない。
//
//   段はどちらも φ15 で、天板の穴 φ16 を上から通る。半月は丸いままだと
//   軸に通せないので2枚に割る。組む順は「つまみを落とす → 半月を寄せる → 締める」。
//
// ---- 🔒 治具から引き継ぐ実績値（作り直さない）----
//   SHRINK 0.1 / MAG_D 4.10 / BORE_CLEAR 0.25 / CHIP_GAP 1.1
//   HOLE_PITCH 17.0 / SLOT_LEN 2.0 / STANDOFF_D 6.0 / 六角ポケットは呼び+0.3
//
// ---- ✅ ユーザーの手持ち（2026-08-15 に本人が確認）----
//   M2.5 ナイロンねじ 長さ6mm・頭厚 2mm ／ M2.5 ナイロンナット 対辺5mm・厚み3mm
//   ナイロンなので磁石に影響しない。半月の軸受け面にはシリコングリスを塗る。
//
// ---- ⬜ まだ入っていないもの ----
//   ・回転の壁（315度で止める仕組み）
//   ・リードスイッチ一式 … 🔴 先に閉じる距離を測る（TODO A-3）
//       置き場所の見込み: 磁石(φ6×2)は持ち手の外周へ埋める。持ち手はへこみの中に
//       沈むので、外周はへこみの壁（半径 13.7）のすぐ内側に来る。リードスイッチ
//       (2.5×14) は壁の外＝天板の肉の中に寝かせれば、磁石との距離を数mmまで詰められる。
//       ⚠ ただし ±X はナットのポケット（半径 13.94〜20.06）が占めている。リードは
//       ±Y 側になるが、いまの座は Y が ±14 しかない。**距離が出るまで座の Y を
//       決められない**。測ってから、Y を広げるかどうかを決めること。
//   ・刷り直したらゼロ点を取り直す（knobzero）

part = "inside";
$fn  = 96;

use <parts.scad>   // reed_switch() / magnet_reed() / magnet_as5600()

// ---- 治具から引き継ぐ ----
SHRINK     = 0.1;
MAG_D      = 4.10;
MAG_DEPTH  = 2.2;
SHAFT_D    = 6.0;
BORE_CLEAR = 0.25;         // 🔒 軸受けの遊び（直径）。入口逃がしとセットで成立する値
PCB        = 23.0;
PCB_T      = 1.6;
CHIP_H     = 1.1;
CHIP_GAP   = 1.1;
HOLE_PITCH = 17.0;
SLOT_LEN   = 2.0;
STANDOFF_D = 6.0;
M2_D       = 2.0 + SHRINK + 0.3;   // 基板を留める M2 の通し穴
M2_NUT_AF  = 4.0 + 0.3;
M2_NUT_T   = 1.6;
M2_SHELF   = 1.2;              // 柱の下端に残す棚。ここで基板を締め付ける
STANDOFF_D_LO = 8.0;           // 柱の下端。ナットの横挿し口のぶん太らせる

// ---- 手持ちの M2.5 ナイロン（半月の固定）----
M25_D      = 2.5 + SHRINK + 0.4;   // 通し穴 φ3.0
M25_NUT_AF = 5.0 + 0.3;            // 対辺 5.0（実測）＋ 六角ポケットの実績 0.3
M25_NUT_T  = 3.0;                  // 厚み 3.0（実測）
M25_LEN    = 6.0;
M25_HEAD_D = 5.0;
M25_HEAD_T = 2.0;

// ---- つまみ ----
GRIP_D   = 25.0;
// ✅ 2026-08-15「高さが無駄に高い。半月が滑らかなので指だけで回せる。突起も要らないかも」
//    12.0 → 8.0（外へ出るのは 10.0 → 6.0mm）。ローレットは無しにした。
//    ⚠ 下限は 2.7mm（磁石ポケット 2.2 ＋ 天面の肉 0.5）。8.0 はまだ十分余裕がある。
//    戻すときは RIB_N = 24 / RIB_D = 1.2。へこみの径は自動で追従する
GRIP_H   = 8.0;
RIB_N    = 0;
RIB_D    = 0;
GRIP_GAP = 0.5;            // 持ち手の裏とへこみの底の逃げ。当てない。精度は要らない
// ✅ 2026-08-16、φ15 から φ10 へ。実物で2つ壊れたので細くした。
//   ① φ15 だとリード用磁石（半径 5.35〜11.45 に立つ）の**下からの通り道を段Aが塞ぐ**。
//      磁石が物理的に入らなかった。つまみ側の挿入経路を検査していなかった。
//   ② φ6 の軸から片側 4.5mm 張り出す下向きの円板になり、**段Bが半分しか刷れなかった。**
//      崩れた段Bが上の軸を道連れにして、軸の先も折れた。φ10 なら張り出しは 2.0mm。
//   半月が掴むのは内穴 φ6.35 なので、段は φ10 でも掛かりは 1.8mm ある。つまみは4g
STEP_D   = 10.0;           // 段A・段B。天板の穴より細いこと
STEP_T   = 2.0;
PLAY     = 0.2;            // 軸方向の遊び。段Aと段Bの間隔で決まる
TIP_LEN  = 3.0;            // 段Bより下の軸（磁石ポケットが入る）
// 🔒 軸の先だけ太らせる。⚠ φ6 のままだと磁石ポケットの壁が (6.0−4.10)/2 = **0.95mm** で、
//    2026-08-16 の印刷で折れた。この 0.95 は誰も決めていない値で、
//    「軸 φ6（半月との嵌合）」と「ポケット φ4.10（ゲージ）」の**引き算の余り**だった。
//    φ8 にすれば壁は 1.95mm。AS5600 の柱の内縁は下端でも 7.34mm なので当たらない
TIP_D    = 8.0;

// ---- 半月（2枚）----
RING_T    = 3.0;
RING_BORE = SHAFT_D + SHRINK + BORE_CLEAR;   // 6.35
RING_R    = 7.6;           // 円盤部の半径。⚠ 柱の内縁 8.34 より内側
ARM_W     = 7.0;           // 腕の幅（Y）。⚠ 柱の角度帯 28〜64度に触れない幅
ARM_W2    = 9.0;           // 柱より外（x>15）では広げてよい。腕のたわみ止め
BOSS_X    = 17.0;          // ねじの位置（±X）。⚠ へこみ（半径13.7）の外に出すこと
SPLIT_GAP = 0.15;          // 割り面の逃げ（片側）。合わせて 0.3
BORE_RELIEF = 0.6;         // 入口逃がしの深さ。プレート側の過硬化を逃がす
// 頭のザグリ。手持ちのねじ 6mm を「半月の残り 1.5 ＋ 棚 1.5 ＋ ナット 3.0」で
// 成立させるために要る。頭の出っ張りも 2.0 → 0.5mm に収まる
HEAD_CB_D = M25_HEAD_D + 0.2;
HEAD_CB_T = 1.5;

// ---- 天板 ----
DECK_T = 2.5;              // 見える面の厚み
// 裏の増し肉。棚 1.5 ＋ ナットのポケット 3.2 ＝ 4.7 が要る。
// ⚠ ポケットは増し肉の中で閉じること。天板の見える層まで食い込むと、縁での
//    差し込み口が 3.2mm 取れず、ナットが入らない
PAD_T  = 5.2;
HOLE_D = STEP_D + SHRINK + 0.9;   // 11.0 落とし込みの穴（⚠ 段を φ15→φ10 にしたので 16 ではない）
PAD_X  = 44.0;
PAD_Y  = 28.0;
// ✅ 2026-08-15 決定「いっそこれでいい」。持ち手はへこみに沈める方式で確定。
//    ⚠ ユーザーが最初に言っていたのは**エンボス（周りを盛り上げる）**で、掘るのは
//    取り違えだった。実物を見て沈める方を採った、という経緯。勝手に戻さないこと。
//    代償は座が 36→44 に広がったこと（ねじがへこみの縁の外へ逃げたため）。
// 持ち手はこのへこみの中に沈む。外へ出るのは 12.0 − 2.5 + 0.5 = 10.0mm
DISH_D = GRIP_D + RIB_D + 1.2;   // 26.2 ⚠ 持ち手の外径（ローレット込み）を通すこと
DISH_T = 2.5;
// 🔒 ナットの受けは「ねじ側から見て丸穴、その奥が六角」。奥に**棚**を残すこと。
//    ⚠ 2026-08-15、一度これを「下向きの止まり穴（底は裏面と面一）」にして間違えた。
//    面一でもナットの下は何も塞いでいないので、締めるとナットが下へ押し出され、
//    天板が力の通り道から外れて締まらない。ユーザーが図で見つけて差し戻した。
//    ナットは天板の +Y の縁から横に差し込み、棚の上に座る。
NUT_SHELF = 1.5;           // ナットの下に残す肉。締め付けを受けるのはここ

// ---- リードスイッチ ----
// ✅ 2026-08-15 ユーザー実測: 閉じるのは 5mm。ただし**接点は真ん中の一点**で、
//    端へ行くほど反応が鈍る。磁石は平らな面を接点へ向けること。
// 🔒 磁石は持ち手の**裏面**に、面を真下へ向けて埋める。側面に埋めると磁石が天板の
//    面より上・リードが下になり、上下に 3mm ずれて合計 4.6mm（残り 0.4mm）になる。
//    裏面なら 2.9mm（残り 2.1mm）で、外から磁石も見えない。
MAG2_PART_D = 6.0;         // 実物の直径（📄 リードスイッチ付属 φ6×2）
// 🔴 2026-08-17、**磁石が入らなかった**。原因はゲージの答えの取り違え。
//    ゲージの丸穴の答え 6.10 は「軸方向に押し込んで**落ちない**いちばんきつい穴」＝
//    圧入の答えで、それを**横から滑り込ませる通り道の幅**に使っていた。
//    刷ると 0.1 縮んで 6.0 ＝ 磁石と同寸になり、道が無くなる。ゲージは正しく、
//    **6.1 という滑らせ方は一度も試していない。**
// 🔒 ゲージで磁石が実際に**滑って入った**のは3列目の溝で、進行方向の幅は 6.3 だった
//    （[fit_gauge.scad](fit_gauge.scad) の EDGE_LEN）。こちらを採る。
//    ⚠ ポケットは**逃げであって圧入ではない**。掴むのは MAG2_SLOT_W の2面だけ。
//    代償は持ち手の外壁 1.05 → 0.95mm。半径方向へ押し広げる力はもう掛からないので許容
MAG2_D  = MAG2_PART_D + 0.3;   // 6.3 ポケットの径＝通り道の幅
MAG2_T  = 2.2;
// 🔒 逃がしが要るのは「**プレートに接している面**の穴」だけ。ボトム層（35秒×5層＝
//    0.25mm）が過硬化して縮む（docs/PRINT.md）。ゲージの「一番奥が通らない」もこれ。
//    ⚠ 2026-08-17、この理屈を**プレートに接していない口にも当てて**しまい、
//    つまみの磁石ポケットとリードの溝に不要な逃がしが残っていた。前者は幅0.5mmの
//    薄い輪を立て、後者は圧入の噛み代を0.6mm削っていた。どちらもユーザーが発見。
//    いま逃がしが入っているのは**半月の軸受け穴だけ**（あれは実際にプレートに接する）。
// ⚠ 8.8 にしていたとき、持ち手の外周までの壁が 0.65mm しか無かった（2026-08-16 指摘）。
//    0.4 内側へ寄せて 1.05mm にした。代償はリードとの距離 4.51 → 4.69mm。
//    圧入は厚み方向（MAG2_SLOT_W）だけなので、この壁を外へ押す力はかからない
// ✅ 2026-08-17 ユーザー発案「リードスイッチを左に10〜15度ずらせばいい」。
//    スタート位置で磁石をリードの真上に置くと、リードはそこから 15度 のあいだ閉じたままで、
//    その区間は電源が入らない。ファームの閾値をその外へ逃がすと、こんどは鳴らない区間が
//    そのぶん広がる。**スタート位置を反応帯の縁へ寄せれば両方短くできる。**
// 🔒 量は 10度。⚠ 15度 は反応帯の縁そのもので、**スタート位置で電源が切れない**側に倒れる。
//    反応帯 15度 自体が写真からの読みなので、縁には置かない。10度 なら帯の内側に 5度 残る。
STOP_OFF_ANG = 10;         // スタート位置で、磁石がリードの真上から何度ずれているか
MAG2_R  = 8.4;             // 持ち手の裏。この半径に円板の中心
// 磁石の角度（つまみ座標）。90 = +Y ＝ スタート位置でリードの真上。
// 🔒 ここを時計回りへ STOP_OFF_ANG ずらすことで、スタート位置を反応帯の縁へ寄せる。
//    ⚠ ずらすのは**磁石か、リードの溝か、ツメの、どれか1つだけ**。2つ動かすと打ち消す。
//    ツメでやるとスタート位置そのものが傾く（2026-08-17 差し戻し）
MAG2_ANG = 90 - STOP_OFF_ANG;   // 80度
// 立てた円板の座の中心。
// 🔒 ポケットを広げても**磁石の座る高さは動かさない**。ここが動くとリードとの距離が
//    そのまま変わる（4.69mm ／ 閉じるのは 5mm）。磁石は天井に当たるまで押し込むので、
//    天井を「持ち手の裏 ＋ 磁石の直径 ＋ 0.05」に置き、そこから半径ぶん下げた点が中心。
MAG2_SEAT_Z  = MAG2_PART_D + 0.05 - MAG2_D / 2;   // 2.90
// ✅ 2026-08-16 ゲージで確定（[fit_gauge.scad](fit_gauge.scad) の3列目・点1）。
//    磁石の厚みは 2.02mm（board_gauge_v2 の櫛で実測）。
// 🔒 **この溝は SHRINK を足さない。** 設計 2.02 がそのまま嵌合になった。
//    設計 2.07（＝丸穴の理屈なら実寸1.97で圧入のはず）は**スカスカ**だった。
//    つまり幅2mm級の細いスリットには、丸穴で効く 0.1mm の縮みが同じようには乗らない。
//    ⚠ 丸穴（6.10）と角穴（3.25）はそれぞれ実測で決めた値なので、こちらは触らない。
// ✅ 2026-08-17 ユーザー再試験で確定: **ゲージの点1（＝2.02）に入る。**
//    つまみ側も、強く押し込んだら半分で止まり、さらに押したら全部入った。
//    半分で止まったのは通り道（当時 6.1＝刷ると磁石と同寸）の噛み込みで説明がつく。
//    🔒 この値はもう動かさない。
// ⚠ parts.scad の magnet_reed_t() は 2.15（✅実測）で、この 2.02 と食い違っている。
//    **物理の嵌合（点1に入る）が優先。** 2.15 の方を疑うこと。
// ⚠ 目標の手応えは「指で押して入る・逆さでも落ちない」。**グイグイは締めすぎ。**
//    次の版で通り道が 0.3 広がるので、そこで手応えを見直す。まだ硬ければ 2.07 に振る
//    （0.95mm の外壁か焼結磁石のどちらかが割れる前に）
MAG2_SLOT_W  = 2.02;
// 🔒 溝は**圧入**。爪で挟む形（網棚）は作れない。爪を付けると口が部品より狭くなり、
//    横から差し込むしかなくなるが、溝の両端はどちらも柱の根元に当たって道が無い
//    （2026-08-15 ユーザーの指摘で検討）。テープも接着剤も要らない。
//    ⚠ 2.55 は「設計値 − 実寸の縮み 0.1 ＝ 2.45」で、部品 2.5 に対して 0.05 の締め代。
//    初回の印刷で緩ければ 2.50、入らなければ 2.60 に振る
REED_W  = 3.25;            // 溝の断面。部品は 3.2 角（📄 2026-08-16 の寸法図）
REED_BODY_L = 14.0;        // 🔒 本体そのものの長さ。足はこの端から生える
REED_L  = REED_BODY_L + 0.3;   // 14.3 溝の長さ（本体＋逃げ）。⚠ 足の付け根はここではない
// 溝の内側の面の半径。⚠ 落とし込み穴（半径 8.0）との壁がここで決まる。
// 2026-08-16、8.3 にしていて壁が 0.3mm しか無かった。印刷で残らない厚み。
REED_IN = 9.0;             // → 壁 1.0mm
// 端子を通す樋の径。⚠ 出口は x がほぼ 0（柱の根元は x 6.5 から始まる）
LEAD_CH_D = 1.6;
// 🔒 曲げ始めの位置。本体の端から出てすぐ曲げると、**本体の角を斜めに横切る**
//    （本体は幅 3.2 で、足はその中心線から出るため）。計算では 9.7 より外が必要。
//    余裕を見て 10.5。ここまでは軸方向に真っ直ぐ出す
LEAD_TURN_X = 10.5;
// 縁での出口。⚠ 2.0 にすると2本目の樋が本体の角を 0.05mm かすめる（角までの距離
//    0.25 に対して線の半径 0.3）。3.5 なら 0.575 空く。柱の根元は x 6.5 から
// 🔒 溝の端（REED_L/2 = 7.15）より**外**に置くこと。内側に置くと、樋の凸包の稜線が
//    溝の外壁を斜めに横切り、境目に薄い楔が残る（2026-08-16 に 2回作った）
LEAD_EXIT_X = 8.0;

// ---- 回転の壁（KNOB-ENCODER.md「SPANと折返し」）----
// 🔒 可動域は 315度（音量の SPAN 270 ＋ 上の吸着帯 45）。これを超えると
//    ファームが「ゼロ点を通り越した」と見て 0%＝無音に倒れる。SPAN を広げても
//    戻し側の余裕が同じだけ削れるので直らない。機械で止めるしかない。
// 置き場所: 段Bの**リングより下**の帯（z -9.4〜-10.4）にツメ、天板から下ろした柱に当てる。
//    リングの腕（±X）と AS5600 の柱（斜め45度）を避けて、柱は -Y に置く。
// 🔒 壁は天板の**上**（へこみの中）に置く。2026-08-16、段Bの下にツメを出す形を
//    作ったが、**つまみが穴を通らなかった**（ツメ 半径11 / 穴 半径8）。
//    穴は厚み7.7mmの筒なので、傾けても通らない。ユーザーが刷る直前に発見。
//    上に置けば、天板より下のつまみの最大径は段の φ15 だけになり、穴 φ16 を通る。
//    持ち手の裏にピン、へこみの底に円弧の溝。溝の端が壁になる。
STOP_ANG   = 270;          // 溝を塞ぐ（＝壁になる）角度
LUG_ARC    = 25;           // 持ち手側のピンの角度幅
POST_ARC   = 20;           // 塞ぐ側の角度幅 → 可動域 360-25-20 = 315度
// ✅ 2026-08-17、10.5 から内側へ広げた。ピンの幅が 0.9 → 1.6mm になる。
//    外側（12.0）は動かさない。へこみの壁 13.1 との 1.1mm を削らないため
// 🔒 スタート位置と反応帯の関係は MAG2_ANG（リード用磁石の節）で作る。ここでは触らない
STOP_R0    = 9.8;          // ピンと溝の内側の半径
// ⚠ 12.5 にしていたとき、溝の外側とへこみの壁（13.1）のあいだが **0.6mm** しか
//    残らず、高さ1.2mmの薄いヒレが1周立っていた。2026-08-16 の印刷で崩れて
//    「レールがガタガタ」になった（ユーザー）。摩擦ではなく最初から立たない形。
STOP_R1    = 12.0;         // 外側の半径 → 壁は 1.1mm
STOP_T     = 1.0;          // ピンの高さ
STOP_GROOVE_T = STOP_T + 0.2;   // 溝の深さ
STOP_CL    = 0.3;          // ピンの側面の逃げ（片側）。溝と同径だと擦れて回らない
// 🔒 AS5600 の柱は**上だけ外へ広げる**。柱が要るのは基板の穴の位置（17mm角）だけで、
//    その上は自由。広げないと柱の内縁が 8.34mm に居座り、ツメの掛かりが 0.4mm しか
//    取れずに折れる。広げると内縁 11.85mm になり、掛かりは 3.3mm 取れる。
POST_XY_LO = HOLE_PITCH / 2;   // 8.5 基板の穴の位置（ここは動かせない）
// ✅ 2026-08-16「柱をもっと開いてしまえばいい。この位置でなければいけない理由が無い」
//    (10.5, 10.5) では柱の根元がリードの溝と樋の真上に来て、下から入れられなかった。
//    外へ開いた結果、逃げはこうなる:
//      リードの帯（|x| ≤ 10.5）から 1.5mm ／ 半月の腕（y ±4.5）から 2.5mm
//      ツメ（半径 11.0）からは 4.0mm ／ 座（±22 × ±14）の内側に収まる
POST_HI_X  = 16.0;
POST_HI_Y  = 10.0;
// ✅ 2026-08-17、-12.4 から座のすぐ下まで引き上げた。回転止めが天板の上へ移って
//    ツメの帯が無くなったので、**柱を早く倒し始められる**ようになった。
//    ⚠ 以前は 2.2mm の高さで 7.6mm 横へ倒していて、印刷では**ほぼ水平の張り出し**
//    だった。6.9mm かけて倒せば 48度 になり、支えがほとんど要らない
POST_Z_HI  = -8.2;
// 🔒 下端は**まっすぐ立てる**。ここに M2 ナットの座を彫るので、傾き始めると
//    六角の座が斜面から食み出して、ナットが捕まらなくなる
//    （2026-08-16、柱を外へ倒したときに実際に壊した）。
//    棚 1.2 ＋ ナット 1.8 ＋ 逃げ 0.5 が収まる高さを取る
POST_STRAIGHT = 3.5;

// ---- 面取り ----
GRIP_CH = 0.8;             // 持ち手の天面。ローレットの先から落とすので段差にならない
CH_S    = 0.3;             // その他の角（当たり止め・バリ取り）

NECK_T = RING_T + PLAY;    // 3.2 首の長さ

// ---- Z（天板の見える面 = 0、+Z が外）----
// ⚠ 2026-08-16 訂正。ここの数字は PAD_T が 2.7 だった頃のもので、5.2 に増やしたときに
//    書き換え忘れていた。Z_PAD_BOT から下が全部 2.5mm ずつ深い側へずれる。
//    そのせいで knob_deep() の注記が 17.2 のままになり、**箱詰めの当て板が
//    2.5mm 浅く見積もっていた**（実際は 19.7mm 要る）。
Z_DISH     = -DISH_T;                    // -2.5 へこみの底
Z_GRIP_B   = Z_DISH + GRIP_GAP;          // -2.0 持ち手の裏
Z_DECK_BOT = -DECK_T;                    // -2.5 見える面の裏
Z_PAD_BOT  = -(DECK_T + PAD_T);          // -7.7 増し肉の裏＝半月の上面
Z_STEPA_T  = Z_PAD_BOT + STEP_T;         // -5.7
Z_RING_T   = Z_PAD_BOT;                  // -7.7
Z_RING_B   = Z_RING_T - RING_T;          // -10.7
Z_STEPB_T  = Z_PAD_BOT - NECK_T;         // -10.9
Z_STEPB_B  = Z_STEPB_T - STEP_T;         // -12.9
Z_LUG_T    = Z_RING_B - 0.2;             // -10.9 ツメの上面。リングの下へ潜らせる
Z_LUG_B    = Z_LUG_T - STOP_T;           // -11.9 ツメの下面
Z_MAG_BOT  = Z_STEPB_B - TIP_LEN;        // -15.9 磁石の下面＝軸の下端
// リード用磁石。⚠ ポケットは磁石より 0.3 大きいので、**磁石が居るのは天井側**。
//    ポケットの下端（Z_GRIP_B - 0.25）を磁石の下端と取り違えないこと
Z_MAG2_TOP = Z_GRIP_B + MAG2_SEAT_Z + MAG2_D / 2;   // -2.0 +6.05 = 4.05 天井
Z_MAG2_BOT = Z_MAG2_TOP - MAG2_PART_D;              // -1.95 押し込んだ磁石の下端
Z_CHIP_TOP = Z_MAG_BOT - CHIP_GAP;       // -17.0
Z_PCB_TOP  = Z_CHIP_TOP - CHIP_H;        // -18.1
Z_PCB_BOT  = Z_PCB_TOP - PCB_T;          // -19.7

// 外へ出す値（🔒 use は変数を渡さない。必ず関数で）
function knob_deep()   = -Z_PCB_BOT;             // 天板の下に要る深さ 19.7
function knob_grip_h() = Z_GRIP_B + GRIP_H;      // 天板の面から外へ出る高さ 6.0
function knob_bay_x()  = PAD_X;
function knob_bay_y()  = PAD_Y;
// 座（44×28）が丸ごと詰まっている厚み 7.7mm。これより下は柱と基板だけになって細くなる。
// 🔒 箱詰めの当て板が「座と他の部品が当たっていないか」を測るのに要る
function knob_pad_h()  = DECK_T + PAD_T;

// 柱の内縁の半径（角の丸みまで含めた最短距離）
function post_inner_r() =
    sqrt(pow(HOLE_PITCH / 2 - SLOT_LEN / 2, 2) + pow(HOLE_PITCH / 2, 2)) - STANDOFF_D / 2;

// ---- 角の面取り（2026-08-15 ユーザー指示「すこしだけ角は削っておこう」）----
//   引く solid を返す。difference() の中に置いて使う。
//   45度なので、印刷でサポートの要らない角度に収まる。
module ch_top(r, z, c) {            // 外周の上の角
    translate([0, 0, z - c]) difference() {
        cylinder(r = r + 3, h = c + 0.01);
        cylinder(r1 = r, r2 = r - c, h = c);
    }
}
module ch_bot(r, z, c) {            // 外周の下の角
    translate([0, 0, z - 0.01]) difference() {
        cylinder(r = r + 3, h = c + 0.02);
        translate([0, 0, 0.01]) cylinder(r1 = r - c, r2 = r, h = c);
    }
}
module ch_hole_top(r, z, c) {       // 穴の口を上へ広げる
    translate([0, 0, z - c]) cylinder(r1 = r, r2 = r + c, h = c + 0.01);
}

// 扇形の柱（回転の壁に使う）
module arc_block(r0, r1, a, z0, z1) {
    translate([0, 0, z0]) rotate_extrude(angle = a)
        translate([r0, 0]) square([r1 - r0, z1 - z0]);
}

// ============================================================
// つまみ（1部品）
// ============================================================
module knob_part() {
    difference() {
        union() {
            // 持ち手（へこみの中に沈む）
            translate([0, 0, Z_GRIP_B]) {
                cylinder(d = GRIP_D, h = GRIP_H);
                // ⚠ RIB_N=0 のとき [0:-1] は OpenSCAD が [-1:0] に直して2回回る。要ガード
                if (RIB_N > 0) for (i = [0 : RIB_N - 1]) rotate([0, 0, i * 360 / RIB_N])
                    translate([GRIP_D / 2, 0, 0]) cylinder(d = RIB_D, h = GRIP_H);
            }
            // 軸（持ち手の裏 〜 段Aの上面）。天板の穴の中を通る
            translate([0, 0, Z_STEPA_T])
                cylinder(d = SHAFT_D, h = Z_GRIP_B - Z_STEPA_T + 0.01);
            // 段A … 下面が半月に乗る。つまみの重さはここ。
            // 🔒 上面は 45度 の円錐にする。刷る向きではここが下を向くので、平らだと
            //    サポートが要る。下面（＝軸受け面）は平らなまま残るので機能は変わらない
            translate([0, 0, Z_PAD_BOT])
                cylinder(d1 = STEP_D, d2 = STEP_D - 2 * STEP_T, h = STEP_T);
            // 首 … 半月が嵌まる溝
            translate([0, 0, Z_STEPB_T]) cylinder(d = SHAFT_D, h = NECK_T);
            // 段B … 引き抜きを止める。
            // 🔒 段Aと同じ 45度 の円錐にする。これで**つまみのサポートがゼロになる**。
            //    2026-08-16、ここだけ 1.2mm 幅の平らな輪を残していて、サポートが
            //    全部そこへ行っていた。手で立てるのは形が悪いことの尻拭い。
            //    止めは平らな段ではなくテーパになり、半月の内穴（半径3.175）の縁に
            //    食い込んで止まる。上下の遊びは 0.2 → 0.375mm に増えるが、
            //    増えるのは引っ張ったときだけで、ぶら下がっている側（段A）は平らなまま
            translate([0, 0, Z_STEPB_B])
                cylinder(d1 = STEP_D, d2 = STEP_D - 2 * STEP_T, h = STEP_T);
            // 軸の先（磁石が入る）。φ8 に太らせて壁を 1.95mm にする。
            // 段Bの下から円錐で広げるので、下向きの張り出しが生まれない
            translate([0, 0, Z_MAG_BOT]) cylinder(d = TIP_D, h = TIP_LEN);
            translate([0, 0, Z_MAG_BOT + TIP_LEN - 0.01])
                cylinder(d1 = TIP_D, d2 = SHAFT_D, h = (TIP_D - SHAFT_D) / 2 + 0.01);
            // 回転の壁のピン。持ち手の裏から、へこみの底の溝へ下ろす。
            // ⚠ 溝と同じ半径で作ると側面が一致して回らない。片側 STOP_CL 細くする
            // 🔴 2026-08-17、ここを STOP_ANG + POST_ARC（＝壁の反時計側）に置いていて、
            //    **可動域が丸ごと裏返しだった**。リード磁石が接点の真上に来る位置
            //    （＝OFF）で、右へ 0度・左へ 315度。ユーザーが実物で発見。
            // 🔒 OFF は可動域の**時計回り側の端**でなければならない。
            //    ・AS5600 は DIR を GND に落としてあり「時計回りで値が増える」
            //    ・音量つまみは右へ回して上がる
            //    壁の時計回り側にツメを置くと、OFF から右へ 315度 取れる。
            //    ⚠ 直したら下の echo（右/左へ回せる角度）で必ず見ること
            // 🔒 ツメは動かさない。⚠ 2026-08-17、ここに STOP_OFF_ANG を入れて
            //    ユーザーに差し戻された。**ツメを回すとスタート位置が 10度 傾く。**
            //    ずらすのは磁石の側（MAG2_ANG）。あちらは中に埋まっていて見えない
            rotate([0, 0, STOP_ANG - LUG_ARC])
                arc_block(STOP_R0 + STOP_CL, STOP_R1 - STOP_CL, LUG_ARC,
                          Z_GRIP_B - STOP_T, Z_GRIP_B);
        }
        // 磁石ポケット（AS5600用 φ4.10 ×2.2）。壁は軸の先を φ8 にしたので 1.95mm
        translate([0, 0, Z_MAG_BOT - 0.01]) cylinder(d = MAG_D, h = MAG_DEPTH + 0.01);
        // 🔒 ここに押し出し穴は開けない。押し出す穴は軸と一直線でないと役に立たず、
        //    軸の延長線上の出口は**持ち手の天面のど真ん中**しかない。
        //    2026-08-16 に一度開けて、ユーザーに止められた。
        //    ✅ 抜くときは別の磁石で吸い出す。2026-08-16、旧ノブから実際に取り出せた。
        //    （磁石どうしがくっついたら、引き剥がさず横にスライドして外す）
        //    刷る向きはこのポケットが上を向くので、レジンも溜まらない
        // ⚠ ここに入口逃がし（φ5.1 × 0.3）を入れてはいけない。
        //    軸を下にして刷っていた頃の名残で、2026-08-17 まで残っていた。
        //    いまは天面をプレート側にするので、この口は**一番上**に来る。縮まない。
        //    逃がすと、ポケットとのあいだに幅0.5mm・高さ0.3mm の輪が立つだけになる
        // リード用磁石。🔒 **円板を立てて、軸をリードの長手方向（接線）へ向ける。**
        //   ⚠ 面をリードに正対させる（軸を縦にする）と、リードの真正面が不感帯になり、
        //     左右2箇所で鳴る。1回転に2回 電源が落ちる角度ができてしまう。
        //     2026-08-16 にユーザーが実物で確認: 平行なら中央の1箇所だけで鳴る。
        //   上半分は円筒の座、下半分は差し込みの通路。持ち手の裏から立てて押し込む
        rotate([0, 0, MAG2_ANG - 90]) {
        translate([0, MAG2_R, Z_GRIP_B + MAG2_SEAT_Z]) rotate([0, 90, 0])
            // ⚠ $fn=48 だと多角形の対辺が 6.287 になり、逃げ 0.3 を 0.013 食う。
            //    ここは逃げが命なので 96 で切る
            cylinder(d = MAG2_D, h = MAG2_SLOT_W, center = true, $fn = 96);
        translate([-MAG2_SLOT_W / 2, MAG2_R - MAG2_D / 2, Z_GRIP_B - 0.01])
            cube([MAG2_SLOT_W, MAG2_D, MAG2_SEAT_Z + 0.01]);
        // 口の面取り。⚠ **Y（進行方向）だけ**広げる。厚み方向を広げると噛み代が減る。
        //    2026-08-17、磁石が斜めに噛んで止まっていたので、入口で真っ直ぐに揃える
        hull() {
            translate([-MAG2_SLOT_W / 2, MAG2_R - MAG2_D / 2 - 0.3, Z_GRIP_B - 0.01])
                cube([MAG2_SLOT_W, MAG2_D + 0.6, 0.01]);
            translate([-MAG2_SLOT_W / 2, MAG2_R - MAG2_D / 2, Z_GRIP_B + 0.4])
                cube([MAG2_SLOT_W, MAG2_D, 0.01]);
        }
        }
        // 🔒 空気穴は開けない（2026-08-16、ユーザーが天面の見え方を嫌って取り下げ）。
        //    この溝は持ち手の裏に**下向きに開いている**ので、抜くときは別の磁石を
        //    下から当てて引き出せる。刷る向きではこの溝が上を向くので、レジンも溜まらない
        // 向きの印。🔒 **+Y のまま動かさない。** スタート位置で真上を向く印であって、
        //    磁石の位置ではない（磁石は STOP_OFF_ANG ぶん中で傾いていて、外からは見えない）
        translate([-1, GRIP_D / 4, Z_GRIP_B + GRIP_H - 0.8]) cube([2, GRIP_D / 4, 1]);

        // ---- 角を落とす ----
        // 持ち手。上はローレットの先端から斜めに落として、指に角が当たらないようにする
        ch_top(GRIP_D / 2 + RIB_D / 2, Z_GRIP_B + GRIP_H, GRIP_CH);
        ch_bot(GRIP_D / 2 + RIB_D / 2, Z_GRIP_B, CH_S);
        // 段。下の角は落とし込むときの当たり止め、上の角はバリ取り
        ch_bot(STEP_D / 2, Z_PAD_BOT,  CH_S);
        ch_top(STEP_D / 2, Z_STEPA_T,  CH_S);
        ch_bot(STEP_D / 2, Z_STEPB_B,  CH_S);
        ch_top(STEP_D / 2, Z_STEPB_T,  CH_S);
        // 軸の先。プレートに接する角
        ch_bot(SHAFT_D / 2, Z_MAG_BOT, CH_S);
    }
}

// ============================================================
// リード用磁石の**通り道**の検査
//   openscad -o _magpath.stl -D 'part="magpath"' hardware/knob_v4.scad
//   🔒 **空（Current top level object is empty）なら通れる。**
//   何か出たら、そこが磁石を止めている肉。
//   ⚠ 「座に収まるか」だけを見ていると、収まる位置まで**行けない**形が通る
//     （2026-08-17、実物で磁石が半分で止まった）。
//   ⚠ この検査は必ずモデル本体に置く。別ファイルへ数字を写すと、角度や座の高さを
//     動かしたときに古い数字のまま「合格」する（2026-08-17 に実際にやった）
// ⚠ 厚みは溝と**同じ値にしない**。溝の壁と磁石の面がぴったり重なると、CGAL が
//    厚みゼロの膜を交わりとして返し、通れているのに不合格に見える（2026-08-17）。
//    見たいのは進行方向の通り道なので、厚みは 0.04 落として当てる
module mag2_solid(zc) {
    rotate([0, 0, MAG2_ANG - 90]) translate([0, MAG2_R, zc]) rotate([0, 90, 0])
        cylinder(d = MAG2_PART_D, h = MAG2_SLOT_W - 0.04, center = true, $fn = 96);
}
module magnet_path_check() {
    intersection() {
        knob_part();
        hull() {
            // 完全に外（持ち手の裏より下）→ 座に入った位置。
            // ⚠ 天井へぴったり当てると多角形どうしの誤差が出るので 0.05 手前で止める
            mag2_solid(Z_GRIP_B - MAG2_PART_D / 2 - 1);
            mag2_solid(Z_MAG2_BOT + MAG2_PART_D / 2 - 0.05);
        }
    }
}

// ============================================================
// 半月（1枚。2枚刷って左右から寄せる）
// ============================================================
module half_part() {
    intersection() {
        difference() {
            union() {
                // 円盤部（軸を掴む）
                translate([0, 0, Z_RING_B]) cylinder(r = RING_R, h = RING_T);
                // ねじへ届く腕。柱の脇（x<15）は細く、その外は広げる
                translate([0, -ARM_W / 2, Z_RING_B]) cube([15, ARM_W, RING_T]);
                hull() {
                    translate([14.9, -ARM_W / 2, Z_RING_B]) cube([0.1, ARM_W, RING_T]);
                    translate([BOSS_X, 0, Z_RING_B]) cylinder(d = ARM_W2, h = RING_T);
                }
            }
            // 軸受けの穴
            translate([0, 0, Z_RING_B - 1]) cylinder(d = RING_BORE, h = RING_T + 2);
            // 入口逃がし（上下とも）。角が当たって軸をかじるのを避ける
            translate([0, 0, Z_RING_T - BORE_RELIEF])
                cylinder(d1 = RING_BORE, d2 = RING_BORE + 1.2, h = BORE_RELIEF + 0.01);
            translate([0, 0, Z_RING_B - 0.01])
                cylinder(d1 = RING_BORE + 1.2, d2 = RING_BORE, h = BORE_RELIEF + 0.01);
            // ねじの通し穴と、頭のザグリ
            translate([BOSS_X, 0, Z_RING_B - 1]) cylinder(d = M25_D, h = RING_T + 2);
            translate([BOSS_X, 0, Z_RING_B - 0.01])
                cylinder(d = HEAD_CB_D, h = HEAD_CB_T + 0.01);
        }
        // 割り面（+X 側だけ残す）
        translate([SPLIT_GAP, -50, -50]) cube([100, 100, 100]);
    }
}

// ============================================================
// 天板側 ── 筐体の天板に union / difference で組み込む
//   knob_station_add() … 増し肉のパッドと AS5600 の柱
//   knob_station_cut() … 落とし込みの穴と M2.5 ナットのポケット
// ============================================================
module knob_station_add() {
    // 裏の増し肉
    translate([-PAD_X / 2, -PAD_Y / 2, Z_PAD_BOT]) cube([PAD_X, PAD_Y, PAD_T]);
    // AS5600 の柱4本（小判形。丸柱は長穴の向きの肉厚 0.3mm で折れた実績）
    // 下端は基板の穴の位置、上へ行くほど外へ逃がす（ツメの通り道を空けるため）
    for (x = [-1, 1], y = [-1, 1]) difference() {
        post_solid(x, y);
        // 基板側の M2 も同じ理屈。丸穴 → 棚 → 六角。ナットは柱の横から差し込む
        translate([x * POST_XY_LO, y * POST_XY_LO, 0]) {
            // 長穴（チップを軸の真下へ寄せる調整代）。棚を貫く
            translate([0, 0, Z_PCB_TOP - 1]) hull() for (s = [-1, 1])
                translate([s * SLOT_LEN / 2, 0, 0])
                    cylinder(d = M2_D, h = M2_SHELF + 1.01);
            translate([0, 0, Z_PCB_TOP + M2_SHELF]) {
                // 六角のポケット（長穴と同じく小判形。どこでも止まれる）
                hull() for (s = [-1, 1]) translate([s * SLOT_LEN / 2, 0, 0])
                    cylinder(d = M2_NUT_AF / cos(30), h = M2_NUT_T + 0.2, $fn = 6);
                // 差し込む通路（柱の外側へ抜く）
                scale([x, 1, 1]) translate([0, -M2_NUT_AF / 2, 0])
                    cube([9, M2_NUT_AF, M2_NUT_T + 0.2]);
                // ねじ先の逃げ
                hull() for (s = [-1, 1]) translate([s * SLOT_LEN / 2, 0, 0])
                    cylinder(d = M2_D, h = M2_NUT_T + 2);
            }
        }
    }
}

module post_oval(h, d) {
    hull() for (s = [-1, 1]) translate([s * SLOT_LEN / 2, 0, 0])
        cylinder(d = d, h = h);
}

// 柱の**掘る前の形**。ナットの座がこの中に収まっているかを外から検査できるように、
// 独立したモジュールにしてある（掘ったあとの形と比べても意味が無い）
module post_solid(x, y) {
    // 下端はまっすぐ（ナットの座を彫る区間）
    translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_TOP])
        post_oval(POST_STRAIGHT, STANDOFF_D_LO);
    // そこから上で外へ倒す
    hull() {
        translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_TOP + POST_STRAIGHT])
            post_oval(0.01, STANDOFF_D_LO);
        translate([x * POST_HI_X, y * POST_HI_Y, POST_Z_HI])
            post_oval(0.01, STANDOFF_D);
    }
    translate([x * POST_HI_X, y * POST_HI_Y, POST_Z_HI])
        post_oval(Z_PAD_BOT - POST_Z_HI, STANDOFF_D);
}

module knob_station_cut() {
    // 落とし込みの穴（段 φ15 が通る）
    translate([0, 0, Z_PAD_BOT - 1]) cylinder(d = HOLE_D, h = DECK_T + PAD_T + 2);
    // 見える面のへこみ（持ち手はこの中に沈む）
    translate([0, 0, Z_DISH]) cylinder(d = DISH_D, h = DISH_T + 1);
    // 角を落とす。へこみの縁（見える角）と、落とし込み穴の口
    ch_hole_top(DISH_D / 2, 0,      CH_S);
    ch_hole_top(HOLE_D / 2, Z_DISH, CH_S);
    // 回転の壁。へこみの底に円弧の溝を彫り、STOP_ANG の 20度ぶんだけ残す。
    // 残した肉の両端がそのまま壁になる（可動域 315度）
    difference() {
        arc_block(STOP_R0, STOP_R1, 360, Z_DISH - STOP_GROOVE_T, Z_DISH + 0.01);
        rotate([0, 0, STOP_ANG])
            arc_block(STOP_R0 - 1, STOP_R1 + 1, POST_ARC,
                      Z_DISH - STOP_GROOVE_T - 0.1, Z_DISH + 0.1);
    }
    // M2.5 ナットの受け。ねじ側は丸穴、その奥が六角。棚 1.5mm が締め付けを受ける
    for (s = [-1, 1]) translate([s * BOSS_X, 0, Z_PAD_BOT]) {
        // 棚を貫く丸穴（ねじだけ通る。ナットは通らない）
        translate([0, 0, -0.01]) cylinder(d = M25_D, h = NUT_SHELF + 0.02);
        // 六角のポケット（棚の上。回り止め）
        translate([0, 0, NUT_SHELF])
            cylinder(d = M25_NUT_AF / cos(30), h = M25_NUT_T + 0.2, $fn = 6);
        // +Y の縁から差し込む通路（対辺と同じ幅）
        translate([-M25_NUT_AF / 2, 0, NUT_SHELF])
            cube([M25_NUT_AF, PAD_Y / 2 + 1, M25_NUT_T + 0.2]);
    }
    // リードスイッチの溝。天板の裏から差し込む。接線方向（長さは円周に沿う）
    translate([-REED_L / 2, REED_IN, Z_PAD_BOT - 0.01])
        cube([REED_L, REED_W, REED_W + 0.01]);
    // ⚠ ここに逃がしを入れてはいけない（2026-08-17 に削除）。
    //    穴が縮むのは**プレートに接している最初の5層（0.25mm）だけ**（docs/PRINT.md）。
    //    この溝の口は見える面から 4.45mm 入った所にあり、ボトム層ではない。
    //    逃がすと圧入の噛み代を 0.6mm 削るだけになる
    // ⚠ 足を ±X へ伸ばす溝は**作らない**。柱は斜め45度にあり、±X へ 6mm 伸ばすと
    //    柱の根元を横切る（2026-08-15、ユーザーが組み立てビューで発見）。
    //    足はリードの溝の中で内側へ曲げて、下の一本道から出す。
    // 端子の通り道。🔒 **端子はリードの両端から出る。**溝は圧入なので中を通せない。
    //    端から斜めの穴で +Y の縁まで引き、そこで箱の中へ落とす。
    //    その一点しか無い理由:
    //      ・AS5600 の柱は x 6.5〜14.5 に居るので、|x| が小さい所でしか下へ行けない
    //      ・基板は ±11.5 角なので、y が 14 まで出ないと線が基板の上に乗る
    //    ⚠ 穴は柱の根元の**上**を通る（z で 0.6mm 逃げている）。柱は削っていない
    // ⚠ 塞がったトンネルにしない。リードに付いた足は通せない（2026-08-16 ユーザー指摘）。
    //    **下から開いた樋**にして、リードを押し込んだあと線を落とし込む
    for (s = [-1, 1]) {
        // 🔒 樋は**1つの凸包**にする。3点（溝の端面・曲げ点・縁の出口）をまとめて包む。
        //    ⚠ 分けて掘ると、境目に薄い三角柱が残る。2026-08-16 に 0.4mm の
        //    三角柱が立っていて、ユーザーが拡大して見つけた。刷れば折れて溝に詰まる。
        //    凸包なら、へこんだ隅そのものが存在しないので残りようがない。
        hull() {
            // 種は溝の**端面**。⚠ 溝そのものを種にすると外壁まで削れて圧入が片側になる。
            // 楔が出ないのは、出口 LEAD_EXIT_X を溝の端 REED_L/2 より外に置いてあるから。
            // 稜線が |x| < REED_L/2 へ戻ってこないので、へこんだ隅が生じない
            translate([s * REED_L / 2 - (s > 0 ? 0.02 : 0), REED_IN, Z_PAD_BOT - 0.01])
                cube([0.02, REED_W, REED_W + 0.01]);
            translate([s * LEAD_TURN_X, REED_IN + REED_W / 2, Z_PAD_BOT - 0.01])
                cylinder(d = LEAD_CH_D, h = REED_W + 0.01, $fn = 24);
            translate([s * LEAD_EXIT_X, PAD_Y / 2 + 0.5, Z_PAD_BOT - 0.01])
                cylinder(d = LEAD_CH_D, h = REED_W + 0.01, $fn = 24);
        }
    }
}

// へこみの天井を支える柱（モデルに組み込む）
// 🔒 天板は「見える面をプレート側」で刷る。そのときへこみ（φ26.2 × 2.5）は
//    **天井のある空洞**になり、へこみの底の裏側が宙に浮く。ここだけは形で消せない
//    （袋状の凹みだから、どちら向きに刷っても浮く面が残る）。
//    ⚠ スライサーで手で立てるのではなく、モデルに入れておく。刷ったらニッパーで折る。
//    痕はへこみの底に残るが、組めば持ち手の下に隠れる。
DECK_PROP_D  = 1.4;        // 柱の太さ
DECK_PROP_TIP = 0.8;       // 先端。細くして折りやすくする
// 🔴 2026-08-17、外側の 12.6 が**溝を削っていた**。溝は 9.8〜12.0 で、φ1.4 の柱は
//    11.9〜13.3 を占める。溝の外壁に 0.1 食い込み、へこみの壁（13.1）とも融合する。
//    折った痕が**溝の中に残る**。実物で「レールがガタガタ」になった一因。
// 🔒 そもそも支えが要るのは **5.5〜9.8 の輪**だけ。ここは z=-2.5 で
//    「どこにも繋がっていない幅 4.3mm の輪」として突然生まれる（島）。
//    外側の輪（12.0〜13.1）はへこみの壁に繋がって生まれるので支柱は要らない。
//    ⚠ 半径は穴と溝から計算する。数字で書くと HOLE_D を動かしたときに追従しない
//    （[7.8, 12.6] は穴が 5.5 で溝が 10.5 だった頃の手書きの値だった）
DECK_PROP_R  = [(HOLE_D / 2 + STOP_R0) / 2];   // 7.65
// ⚠ 8本だと隣の支柱まで 6.0mm。天井は支点の間でカールするので、4mm まで詰める。
//    痕は12個に増えるが、全部持ち手の下（半径12.5より内）に隠れる
DECK_PROP_N  = 12;

module deck_props() {
    for (r = DECK_PROP_R, i = [0 : DECK_PROP_N - 1])
        rotate([0, 0, i * 360 / DECK_PROP_N])
            translate([r, 0, Z_DISH]) {
                cylinder(d1 = DECK_PROP_TIP, d2 = DECK_PROP_D, h = 0.4);
                translate([0, 0, 0.4])
                    cylinder(d = DECK_PROP_D, h = DISH_T - 0.4);
            }
}

// 卓上テスト用の天板（本番はこの板が筐体の天板になる）
module deck_test(props = true) {
    difference() {
        union() {
            translate([-PAD_X / 2, -PAD_Y / 2, Z_DECK_BOT])
                cube([PAD_X, PAD_Y, DECK_T]);
            knob_station_add();
        }
        knob_station_cut();
    }
    if (props) deck_props();
}

// ============================================================
// リードスイッチと、その足の通り道
//   足はリードの端から出て、溝の中で内側へ曲がり、+Y の一本道から箱の中へ落ちる。
//   🔒 ±X へは伸ばせない（柱の根元を横切る）。
// ============================================================
Z_REED_C = Z_PAD_BOT + REED_W / 2;      // リードの中心の高さ
Y_REED_C = REED_IN + REED_W / 2;        // リードの中心の半径

module wire(pts, d = 0.6) {
    for (i = [0 : len(pts) - 2]) hull() {
        translate(pts[i])     sphere(d = d, $fn = 16);
        translate(pts[i + 1]) sphere(d = d, $fn = 16);
    }
}

module reed_assembly(drop = 14) {
    translate([0, Y_REED_C, Z_REED_C]) reed_switch(lead = 0);
    color("#b87333") for (s = [-1, 1]) wire([
        // 本体の端面から出る。⚠ 線の半径 0.3 を足さないと端面に食い込む
        [s * (REED_BODY_L / 2 + 0.3), Y_REED_C, Z_REED_C],
        [s * LEAD_TURN_X, Y_REED_C, Z_REED_C],          // ここまで真っ直ぐ出す
        [s * LEAD_EXIT_X, PAD_Y / 2 + 0.5, Z_REED_C],   // 樋で +Y の縁へ
        [s * LEAD_EXIT_X, PAD_Y / 2 + 0.5, Z_PAD_BOT - drop]   // 箱の中へ落とす
    ]);
}

module assembly(show_deck = true) {
    color("#d8dde3") knob_part();
    color("#c8763f", 0.95) { half_part(); mirror([1, 0, 0]) half_part(); }
    if (show_deck) color("#9aa5b1", 0.75) deck_test();
    // M2.5 ナイロンねじ
    // ⚠ 2026-08-16 訂正。ねじもナットも **1.5mm 低く描いていた**（ザグリ HEAD_CB_T と
    //    棚 NUT_SHELF を勘定に入れていなかった）。そのせいで組み立てビューでは
    //    ナットが棚に 25.9mm3 めり込んで見え、当たり検査で偽の当たりが2つ出ていた。
    //    🔒 実物の寸法は正しい（下の echo の検算が通っている）。**絵だけの誤り。**
    color("#e8e8e8") for (s = [-1, 1]) translate([s * BOSS_X, 0, Z_RING_B + HEAD_CB_T]) {
        translate([0, 0, -M25_HEAD_T]) cylinder(d = M25_HEAD_D, h = M25_HEAD_T);
        cylinder(d = 2.5, h = M25_LEN);
    }
    color("#888") for (s = [-1, 1]) translate([s * BOSS_X, 0, Z_PAD_BOT + NUT_SHELF])
        cylinder(d = M25_NUT_AF / cos(30), h = M25_NUT_T, $fn = 6);
    // AS5600（穴もチップもコネクタも入った実物のモデル）
    translate([0, 0, Z_PCB_BOT]) as5600(show_connector = false);
    // 基板を留める M2×5。下から入れて、棚を貫いてナットへ
    color("#e8e8e8") for (x = [-1, 1], y = [-1, 1])
        translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_BOT]) {
            translate([0, 0, -1.3]) cylinder(d = 3.8, h = 1.3);
            cylinder(d = 2.0, h = PCB_T + M2_SHELF + M2_NUT_T);
        }
    color("#888") for (x = [-1, 1], y = [-1, 1])
        translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_TOP + M2_SHELF])
            cylinder(d = M2_NUT_AF / cos(30), h = M2_NUT_T, $fn = 6);
    color("#bbb")    translate([0, 0, Z_MAG_BOT]) cylinder(d = 4.0, h = 2.0);
    // リード用磁石（持ち手の裏・面が真下）とリードスイッチ一式
    // ⚠ 2026-08-17 訂正。ここは磁石を**立てずに**描いていた（軸が縦のまま）。
    //    実物は円板を立てて軸を +X へ向ける。絵だけの誤りだが、当たり検査が効かない
    color("#c0392b")
        translate([-magnet_reed_t() / 2, MAG2_R, Z_MAG2_BOT + MAG2_PART_D / 2])
            rotate([0, 90, 0]) magnet_reed();
    reed_assembly();
}

module exploded() {
    translate([0, 0, 30]) color("#d8dde3") knob_part();
    translate([26, 0, 10])  color("#c8763f") half_part();
    translate([-26, 0, 10]) color("#c8763f") mirror([1, 0, 0]) half_part();
    color("#9aa5b1", 0.8) deck_test();
    translate([0, 0, -12]) {
        color("#2b6b3f") translate([-PCB / 2, -PCB / 2, Z_PCB_BOT]) cube([PCB, PCB, PCB_T]);
        color("#333") translate([-2.5, -2, Z_PCB_TOP]) cube([5, 4, CHIP_H]);
    }
    translate([0, 0, 24]) color("#bbb") translate([0, 0, Z_MAG_BOT]) cylinder(d = 4.0, h = 2.0);
}

// ---- 印刷の向き ----
//   つまみ: 🔒 **持ち手の天面をプレートに直置き**（軸が上を向く）。
//     ⚠ 2026-08-16、逆向き（軸を下）で刷って失敗した。持ち手の裏が下を向くため、
//     **磁石ポケットの口にサポートが入って潰れ**、段Aの下面にも痕が残った。
//     天面を下にすれば、裏側の大事な2面（段Aの下面・磁石ポケットの口）が
//     どちらも上を向き、サポートが付かない。
//     ・サポートが付くのは段Bの上面 … 引き上げたときしか当たらない面。実害なし
//     ・天面はプレートに接して象足が出る … Z=0を取り直せば 0.1mm 程度。
//       天面には 0.8mm の面取りが入っているので、剥がすときの角も立たない
//     ・軸の先の磁石ポケットが上を向く … 洗浄でレジンが溜まる。抜くこと
//     ✅ **やすりは要らない。** 擦れ合う2面（段Aの下面・半月の上面）は、どちらも
//        それぞれの印刷向きで**上を向く面**になるので、最初から平らに出る。
//        ⚠ 2026-08-16 まで「800番で平らに当てること」と書いていたが、
//        ① 軸を下に刷っていた頃の名残で、いまの向きでは不要
//        ② そもそも段Bが同じ φ15 で 5.2mm 下に出ているので、平らなやすりは
//           段Aの下面に**物理的に届かない**（ユーザー指摘）
//        シリコングリスを塗るのはこの2面。
//   半月: そのまま平置き。押さえ面も軸受けの穴も向きを選ばない。
//   天板: 🔒 **見える面をプレートに直置き。傾けない・浮かせない・ラフトを敷かない。**
//     ⚠ 2026-08-17、ここに「平らな面が広いので 15〜20度 傾けると吸着が減る」と書いてあり、
//     支柱（deck_props）の前提と**矛盾していた**。支柱はプレートから生えてへこみの天井を
//     掴む形なので、傾けたり浮かせたりすると足がプレートに届かず、**宙に浮いた φ1.4 の島**
//     になって刷れない。実際ほとんど脱落し、へこみの底（＝回転の溝が乗る面）が荒れた。
//     ・支柱が消えると、8.0〜9.8 の輪がどこにも繋がらないまま生まれてカールする
//     ・オートサポートで代わりをさせると、今度は溝の中にサポート痕が残る
//     刷ったら支柱 8本をニッパーで折る。痕はへこみの底に残るが、組めば持ち手の下に隠れる
// つまみは**持ち手の天面をプレートへ**。上下をひっくり返して置く
if      (part == "knob")    rotate([180, 0, 0])
                                translate([0, 0, -(Z_GRIP_B + GRIP_H)]) knob_part();
else if (part == "half")    translate([0, 0, -Z_RING_B]) half_part();
else if (part == "deck")    rotate([180, 0, 0]) deck_test();
else if (part == "magpath") magnet_path_check();
else if (part == "explode") exploded();
else                        assembly();

echo(str("段 φ", STEP_D, "（半径 ", STEP_D / 2, "） / 柱の内縁 半径 ", post_inner_r(),
         " → すき間 ", post_inner_r() - STEP_D / 2, "mm"));
echo(str("半月の円盤 半径 ", RING_R, " → 柱まで ", post_inner_r() - RING_R, "mm"));
echo(str("柱の高さ ", Z_PAD_BOT - Z_PCB_TOP, "mm / 磁石とチップ ", CHIP_GAP, "mm"));
echo(str("ねじの検算: 半月の残り ", RING_T - HEAD_CB_T, " ＋ 棚 ", NUT_SHELF,
         " ＋ ナット ", M25_NUT_T, " = ", RING_T - HEAD_CB_T + NUT_SHELF + M25_NUT_T,
         " / 手持ちのねじ ", M25_LEN, "mm"));
echo(str("M2.5 ナットの上に残る肉 ",
         -(Z_PAD_BOT + NUT_SHELF + M25_NUT_T + 0.2), "mm / 棚 ", NUT_SHELF, "mm"));
echo(str("基板側 M2: 棚 ", M2_SHELF, "mm / 柱の下端 φ", STANDOFF_D_LO,
         "（ナットの横挿し口の壁 ", (STANDOFF_D_LO - M2_NUT_AF) / 2, "mm）"));
echo(str("へこみ φ", DISH_D, " × ", DISH_T, " / ローレット外径 ", GRIP_D + RIB_D,
         " / ねじは半径 ", BOSS_X, "（へこみの縁 ", DISH_D / 2, " の外）"));
echo(str("軸方向の遊び ", NECK_T - RING_T, "mm / 持ち手の逃げ ", GRIP_GAP, "mm"));
echo(str("リード: 磁石の下端 → 接点 ",
         sqrt(pow(REED_IN + REED_W / 2 - MAG2_R, 2) +
              pow(Z_MAG2_BOT - (Z_PAD_BOT + REED_W / 2), 2)),
         "mm ／ 磁石の中心 → 接点 ",
         sqrt(pow(REED_IN + REED_W / 2 - MAG2_R, 2) +
              pow(Z_MAG2_BOT + MAG2_PART_D / 2 - (Z_PAD_BOT + REED_W / 2), 2)), "mm"));
// 磁石はポケットの中で Y に ±0.15 動ける（掴んでいるのは厚み方向だけ）。
// ⚠ 動いても閉じる距離 5mm を割らないことをここで見る
echo(str("磁石のポケット φ", MAG2_D, "（磁石 φ", MAG2_PART_D, " → 遊び ",
         MAG2_D - MAG2_PART_D, "）/ 厚みの噛み代は溝 ", MAG2_SLOT_W, " のみ / 距離のぶれ ±",
         (MAG2_D - MAG2_PART_D) / 2, "mm"));
// ---- リード本体と溝を、実際に描かれる寸法（parts.scad の関数）で突き合わせる ----
// ⚠ 数字を手で書き写して比べると、片方だけ直して気づけない。必ず関数から取る。
RB_L = reed_body_l();      // 14.0
RB_S = reed_body_sec();    // 3.2
echo(str("本体 x ", -RB_L / 2, " 〜 ", RB_L / 2,
         " / 溝 x ", -REED_L / 2, " 〜 ", REED_L / 2,
         " → 逃げ ", (REED_L - RB_L) / 2, "mm"));
echo(str("本体 y ", Y_REED_C - RB_S / 2, " 〜 ", Y_REED_C + RB_S / 2,
         " / 溝 y ", REED_IN, " 〜 ", REED_IN + REED_W,
         " → 内 ", Y_REED_C - RB_S / 2 - REED_IN,
         " / 外 ", REED_IN + REED_W - (Y_REED_C + RB_S / 2), "mm"));
echo(str("本体 z ", Z_REED_C - RB_S / 2, " 〜 ", Z_REED_C + RB_S / 2,
         " / 溝 z ", Z_PAD_BOT, " 〜 ", Z_PAD_BOT + REED_W,
         " → 下 ", Z_REED_C - RB_S / 2 - Z_PAD_BOT,
         " / 上 ", Z_PAD_BOT + REED_W - (Z_REED_C + RB_S / 2), "mm"));
echo(str("リードの溝と落とし込み穴の壁 ", REED_IN - HOLE_D / 2, "mm"));
echo(str("リードの溝の上に残る肉 ", -(Z_PAD_BOT + REED_W) - DECK_T,
         "mm / 磁石まわりの持ち手の外壁 ", GRIP_D / 2 - (MAG2_R + MAG2_D / 2), "mm"));
echo(str("回転の壁 ", 360 - LUG_ARC - POST_ARC, "度（SPAN270＋吸着帯45）/ 掛かり ",
         STOP_R1 - STOP_R0, "mm × 厚み ", STOP_T, "mm"));
// 🔒 **可動域が裏返っていないかの検査。** リード磁石が接点の真上に来る姿勢（回転0）で、
//    そこから右（時計回り）と左へ何度回せるかを出す。
//    ⚠ OFF は時計回り側の端。右 315 / 左 0 が正しい。逆なら可動域が裏返っている
//    （2026-08-17 まで逆だった。実物を組むまで誰も気づけなかったので、ここで見る）
// ---- 可動域とリードの反応帯の突き合わせ ----
// 🔒 数字は**ツメと壁の位置から引く**。パラメータをそのまま印字しても検査にならない
//    （両方動かして相対角度が変わっていない、という間違いを見逃す）。
//    つまみの回転角 θ: 0 = 磁石がリードの真上 / + が反時計回り
LUG_A0  = STOP_ANG - LUG_ARC;                     // ツメの時計回り側の端
TH_CCW  = STOP_ANG - (LUG_A0 + LUG_ARC);          // 反時計側の端（＝スタート位置）
TH_CW   = (STOP_ANG + POST_ARC - 360) - LUG_A0;   // 時計側の端（＝回し切り）
echo(str("可動域 θ ", TH_CW, " 〜 ", TH_CCW, "（", TH_CCW - TH_CW,
         "度）/ スタート位置は反時計側の端 → そこから右へ ", TH_CCW - TH_CW,
         "度 ⚠ 315 でなければ裏返りか壁の作り間違い"));
// 🔒 スタート位置は帯の**内側**に居ること。縁に乗せるとスタート位置で電源が切れない
REED_BAND = 15;   // ✅ 2026-08-17 実測（磁石の真上から片側）
DIFF_START = 90 - (MAG2_ANG + TH_CCW);            // スタート位置での磁石とリードの角度差
echo(str("スタート位置での磁石とリードの角度差 ", DIFF_START,
         "度 → 帯（", REED_BAND, "度）の内側に ", REED_BAND - DIFF_START,
         "度 ⚠ 0以下ならスタート位置で電源が切れない"));
echo(str("リードが開くのはスタート位置から ", REED_BAND - DIFF_START,
         "度 → ファームのミュート閾値はこれより外（KATANORI_KNOB_OFF_DEG）"));
// 🔒 上端（回し切り）でも磁石はリードの**反対側から**近づいてくる。
//    ⚠ ここで閉じると最大音量のまま電源が落ちる。STOP_OFF_ANG を増やすと必ずここが削れる
TOP_GAP = (MAG2_ANG + TH_CW) - 90 + 360;              // 35 上端での磁石とリードの角度差
echo(str("上端での磁石とリードの角度差 ", TOP_GAP, "度 → 帯（", REED_BAND, "度）まで ",
         TOP_GAP - REED_BAND, "度 ⚠ 負なら回し切りで電源が落ちる"));
echo(str("広げた柱の内縁 半径 ",
         sqrt(pow(POST_HI_X, 2) + pow(POST_HI_Y, 2)) - STANDOFF_D / 2,
         " → ツメ ", STOP_R1, " との差 ",
         sqrt(pow(POST_HI_X, 2) + pow(POST_HI_Y, 2)) - STANDOFF_D / 2 - STOP_R1, "mm"));
echo(str("柱の x の内側 ", POST_HI_X - STANDOFF_D / 2 - SLOT_LEN / 2,
         " → 樋の外端 ", LEAD_TURN_X, " との差 ",
         POST_HI_X - STANDOFF_D / 2 - SLOT_LEN / 2 - LEAD_TURN_X, "mm"));
// ---- 支柱が穴・溝・壁のどれにも触っていないか（古い数字が残らないように毎回見る）----
// ⚠ 支柱が溝の内側に居るか外側に居るかで、見るべき相手が変わる。両方を並べると
//    片方が必ず負になり、警告として読めなくなる（2026-08-17 に一度やった）
for (r = DECK_PROP_R) echo(
    r < STOP_R0
    ? str("支柱 半径 ", r, "（φ", DECK_PROP_D, "・溝の内側）→ 落とし込み穴まで ",
          r - DECK_PROP_D / 2 - HOLE_D / 2, " / 溝の内壁まで ",
          STOP_R0 - (r + DECK_PROP_D / 2), "mm ⚠ 負なら食い込んでいる")
    : str("支柱 半径 ", r, "（φ", DECK_PROP_D, "・溝の外側）→ 溝の外壁まで ",
          r - DECK_PROP_D / 2 - STOP_R1, " / へこみの壁まで ",
          DISH_D / 2 - (r + DECK_PROP_D / 2), "mm ⚠ 負なら食い込んでいる"));
echo(str("天板の下に要る深さ ", knob_deep(), "mm / 外へ ", knob_grip_h(),
         "mm / 座 ", PAD_X, "×", PAD_Y));
