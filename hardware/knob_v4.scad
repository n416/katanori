// 柱の内縁の半径（角の丸みまで含めた最短距離）
function post_inner_r() =
    sqrt(pow(HOLE_PITCH / 2 - SLOT_LEN / 2, 2) + pow(HOLE_PITCH / 2, 2)) - STANDOFF_D / 2;

// ---- 角の面取り（2026-08-15 ユーザー指示「すこしだけ角は削っておこう」）----
//   引く solid を返す。difference() の中に置いて使う。
//   45度なので、印刷でサポートの要らない角度に収まる。
module ch_top(r, z, c) {            // 外周の上の角
    translate([0, 0, z - c]) difference() {
        cylinder(r = r + 3, h = c + 0.01);
        cylinder(r1 = r, r2 = r - c, h = c);
    }
}
module ch_bot(r, z, c) {            // 外周の下の角
    translate([0, 0, z - 0.01]) difference() {
        cylinder(r = r + 3, h = c + 0.02);
        translate([0, 0, 0.01]) cylinder(r1 = r - c, r2 = r, h = c);
    }
}
module ch_hole_top(r, z, c) {       // 穴の口を上へ広げる
    translate([0, 0, z - c]) cylinder(r1 = r, r2 = r + c, h = c + 0.01);
}

// 扇形の柱（回転の壁に使う）
module arc_block(r0, r1, a, z0, z1) {
    translate([0, 0, z0]) rotate_extrude(angle = a)
        translate([r0, 0]) square([r1 - r0, z1 - z0]);
}

// ============================================================
// つまみ（1部品）
// ============================================================
module knob_part() {
    difference() {
        union() {
            // 持ち手（へこみの中に沈む）
            translate([0, 0, Z_GRIP_B]) {
                cylinder(d = GRIP_D, h = GRIP_H);
                // ⚠ RIB_N=0 のとき [0:-1] は OpenSCAD が [-1:0] に直して2回回る。要ガード
                if (RIB_N > 0) for (i = [0 : RIB_N - 1]) rotate([0, 0, i * 360 / RIB_N])
                    translate([GRIP_D / 2, 0, 0]) cylinder(d = RIB_D, h = GRIP_H);
            }
            // 軸（持ち手の裏 〜 段Aの上面）。天板の穴の中を通る
            translate([0, 0, Z_STEPA_T])
                cylinder(d = SHAFT_D, h = Z_GRIP_B - Z_STEPA_T + 0.01);
            // 段A … 下面が半月に乗る。つまみの重さはここ。
            // 🔒 上面は 45度 の円錐にする。刷る向きではここが下を向くので、平らだと
            //    サポートが要る。下面（＝軸受け面）は平らなまま残るので機能は変わらない
            translate([0, 0, Z_PAD_BOT])
                cylinder(d1 = STEP_D, d2 = STEP_D - 2 * STEP_T, h = STEP_T);
            // 首 … 半月が嵌まる溝
            translate([0, 0, Z_STEPB_T]) cylinder(d = SHAFT_D, h = NECK_T);
            // 段B … 引き抜きを止める。
            // 🔒 段Aと同じ 45度 の円錐にする。これで**つまみのサポートがゼロになる**。
            //    2026-08-16、ここだけ 1.2mm 幅の平らな輪を残していて、サポートが
            //    全部そこへ行っていた。手で立てるのは形が悪いことの尻拭い。
            //    止めは平らな段ではなくテーパになり、半月の内穴（半径3.175）の縁に
            //    食い込んで止まる。上下の遊びは 0.2 → 0.375mm に増えるが、
            //    増えるのは引っ張ったときだけで、ぶら下がっている側（段A）は平らなまま
            translate([0, 0, Z_STEPB_B])
                cylinder(d1 = STEP_D, d2 = STEP_D - 2 * STEP_T, h = STEP_T);
            // 軸の先（磁石が入る）。φ8 に太らせて壁を 1.95mm にする。
            // 段Bの下から円錐で広げるので、下向きの張り出しが生まれない
            translate([0, 0, Z_MAG_BOT]) cylinder(d = TIP_D, h = TIP_LEN);
            translate([0, 0, Z_MAG_BOT + TIP_LEN - 0.01])
                cylinder(d1 = TIP_D, d2 = SHAFT_D, h = (TIP_D - SHAFT_D) / 2 + 0.01);
            // 回転の壁のピン。持ち手の裏から、へこみの底の溝へ下ろす。
            // ⚠ 溝と同じ半径で作ると側面が一致して回らない。片側 STOP_CL 細くする
            // 🔴 2026-08-17、ここを STOP_ANG + POST_ARC（＝壁の反時計側）に置いていて、
            //    **可動域が丸ごと裏返しだった**。リード磁石が接点の真上に来る位置
            //    （＝OFF）で、右へ 0度・左へ 315度。ユーザーが実物で発見。
            // 🔒 OFF は可動域の**時計回り側の端**でなければならない。
            //    ・AS5600 は DIR を GND に落としてあり「時計回りで値が増える」
            //    ・音量つまみは右へ回して上がる
            //    壁の時計回り側にツメを置くと、OFF から右へ 315度 取れる。
            //    ⚠ 直したら下の echo（右/左へ回せる角度）で必ず見ること
            // 🔒 ツメは動かさない。⚠ 2026-08-17、ここに STOP_OFF_ANG を入れて
            //    ユーザーに差し戻された。**ツメを回すとスタート位置が 10度 傾く。**
            //    ずらすのは磁石の側（MAG2_ANG）。あちらは中に埋まっていて見えない
            rotate([0, 0, STOP_ANG - LUG_ARC])
                arc_block(STOP_R0 + STOP_CL, STOP_R1 - STOP_CL, LUG_ARC,
                          Z_GRIP_B - STOP_T, Z_GRIP_B);
        }
        // 磁石ポケット（AS5600用 φ4.10 ×2.2）。壁は軸の先を φ8 にしたので 1.95mm
        translate([0, 0, Z_MAG_BOT - 0.01]) cylinder(d = MAG_D, h = MAG_DEPTH + 0.01);
        // 🔒 ここに押し出し穴は開けない。押し出す穴は軸と一直線でないと役に立たず、
        //    軸の延長線上の出口は**持ち手の天面のど真ん中**しかない。
        //    2026-08-16 に一度開けて、ユーザーに止められた。
        //    ✅ 抜くときは別の磁石で吸い出す。2026-08-16、旧ノブから実際に取り出せた。
        //    （磁石どうしがくっついたら、引き剥がさず横にスライドして外す）
        //    刷る向きはこのポケットが上を向くので、レジンも溜まらない
        // ⚠ ここに入口逃がし（φ5.1 × 0.3）を入れてはいけない。
        //    軸を下にして刷っていた頃の名残で、2026-08-17 まで残っていた。
        //    いまは天面をプレート側にするので、この口は**一番上**に来る。縮まない。
        //    逃がすと、ポケットとのあいだに幅0.5mm・高さ0.3mm の輪が立つだけになる
        // リード用磁石。🔒 **円板を立てて、軸をリードの長手方向（接線）へ向ける。**
        //   ⚠ 面をリードに正対させる（軸を縦にする）と、リードの真正面が不感帯になり、
        //     左右2箇所で鳴る。1回転に2回 電源が落ちる角度ができてしまう。
        //     2026-08-16 にユーザーが実物で確認: 平行なら中央の1箇所だけで鳴る。
        //   上半分は円筒の座、下半分は差し込みの通路。持ち手の裏から立てて押し込む
        rotate([0, 0, MAG2_ANG - 90]) {
        translate([0, MAG2_R, Z_GRIP_B + MAG2_SEAT_Z]) rotate([0, 90, 0])
            // ⚠ $fn=48 だと多角形の対辺が 6.287 になり、逃げ 0.3 を 0.013 食う。
            //    ここは逃げが命なので 96 で切る
            cylinder(d = MAG2_D, h = MAG2_SLOT_W, center = true, $fn = 96);
        translate([-MAG2_SLOT_W / 2, MAG2_R - MAG2_D / 2, Z_GRIP_B - 0.01])
            cube([MAG2_SLOT_W, MAG2_D, MAG2_SEAT_Z + 0.01]);
        // 口の面取り。⚠ **Y（進行方向）だけ**広げる。厚み方向を広げると噛み代が減る。
        //    2026-08-17、磁石が斜めに噛んで止まっていたので、入口で真っ直ぐに揃える
        hull() {
            translate([-MAG2_SLOT_W / 2, MAG2_R - MAG2_D / 2 - 0.3, Z_GRIP_B - 0.01])
                cube([MAG2_SLOT_W, MAG2_D + 0.6, 0.01]);
            translate([-MAG2_SLOT_W / 2, MAG2_R - MAG2_D / 2, Z_GRIP_B + 0.4])
                cube([MAG2_SLOT_W, MAG2_D, 0.01]);
        }
        }
        // 🔒 空気穴は開けない（2026-08-16、ユーザーが天面の見え方を嫌って取り下げ）。
        //    この溝は持ち手の裏に**下向きに開いている**ので、抜くときは別の磁石を
        //    下から当てて引き出せる。刷る向きではこの溝が上を向くので、レジンも溜まらない
        // 向きの印。🔒 **+Y のまま動かさない。** スタート位置で真上を向く印であって、
        //    磁石の位置ではない（磁石は STOP_OFF_ANG ぶん中で傾いていて、外からは見えない）
        translate([-1, GRIP_D / 4, Z_GRIP_B + GRIP_H - 0.8]) cube([2, GRIP_D / 4, 1]);

        // ---- 角を落とす ----
        // 持ち手。上はローレットの先端から斜めに落として、指に角が当たらないようにする
        ch_top(GRIP_D / 2 + RIB_D / 2, Z_GRIP_B + GRIP_H, GRIP_CH);
        ch_bot(GRIP_D / 2 + RIB_D / 2, Z_GRIP_B, CH_S);
        // 段。下の角は落とし込むときの当たり止め、上の角はバリ取り
        ch_bot(STEP_D / 2, Z_PAD_BOT,  CH_S);
        ch_top(STEP_D / 2, Z_STEPA_T,  CH_S);
        ch_bot(STEP_D / 2, Z_STEPB_B,  CH_S);
        ch_top(STEP_D / 2, Z_STEPB_T,  CH_S);
        // 軸の先。プレートに接する角
        ch_bot(SHAFT_D / 2, Z_MAG_BOT, CH_S);
    }
}

// ============================================================
// リード用磁石の**通り道**の検査
//   openscad -o _magpath.stl -D 'part="magpath"' hardware/knob_v4.scad
//   🔒 **空（Current top level object is empty）なら通れる。**
//   何か出たら、そこが磁石を止めている肉。
//   ⚠ 「座に収まるか」だけを見ていると、収まる位置まで**行けない**形が通る
//     （2026-08-17、実物で磁石が半分で止まった）。
//   ⚠ この検査は必ずモデル本体に置く。別ファイルへ数字を写すと、角度や座の高さを
//     動かしたときに古い数字のまま「合格」する（2026-08-17 に実際にやった）
// ⚠ 厚みは溝と**同じ値にしない**。溝の壁と磁石の面がぴったり重なると、CGAL が
//    厚みゼロの膜を交わりとして返し、通れているのに不合格に見える（2026-08-17）。
//    見たいのは進行方向の通り道なので、厚みは 0.04 落として当てる
module mag2_solid(zc) {
    rotate([0, 0, MAG2_ANG - 90]) translate([0, MAG2_R, zc]) rotate([0, 90, 0])
        cylinder(d = MAG2_PART_D, h = MAG2_SLOT_W - 0.04, center = true, $fn = 96);
}
module magnet_path_check() {
    intersection() {
        knob_part();
        hull() {
            // 完全に外（持ち手の裏より下）→ 座に入った位置。
            // ⚠ 天井へぴったり当てると多角形どうしの誤差が出るので 0.05 手前で止める
            mag2_solid(Z_GRIP_B - MAG2_PART_D / 2 - 1);
            mag2_solid(Z_MAG2_BOT + MAG2_PART_D / 2 - 0.05);
        }
    }
}

// ============================================================
// 半月（1枚。2枚刷って左右から寄せる）
// ============================================================
module half_part() {
    intersection() {
        difference() {
            union() {
                // 円盤部（軸を掴む）
                translate([0, 0, Z_RING_B]) cylinder(r = RING_R, h = RING_T);
                // ねじへ届く腕。柱の脇（x<15）は細く、その外は広げる
                translate([0, -ARM_W / 2, Z_RING_B]) cube([15, ARM_W, RING_T]);
                hull() {
                    translate([14.9, -ARM_W / 2, Z_RING_B]) cube([0.1, ARM_W, RING_T]);
                    translate([BOSS_X, 0, Z_RING_B]) cylinder(d = ARM_W2, h = RING_T);
                }
            }
            // 軸受けの穴
            translate([0, 0, Z_RING_B - 1]) cylinder(d = RING_BORE, h = RING_T + 2);
            // 入口逃がし（上下とも）。角が当たって軸をかじるのを避ける
            translate([0, 0, Z_RING_T - BORE_RELIEF])
                cylinder(d1 = RING_BORE, d2 = RING_BORE + 1.2, h = BORE_RELIEF + 0.01);
            translate([0, 0, Z_RING_B - 0.01])
                cylinder(d1 = RING_BORE + 1.2, d2 = RING_BORE, h = BORE_RELIEF + 0.01);
            // ねじの通し穴と、頭のザグリ
            translate([BOSS_X, 0, Z_RING_B - 1]) cylinder(d = M25_D, h = RING_T + 2);
            translate([BOSS_X, 0, Z_RING_B - 0.01])
                cylinder(d = HEAD_CB_D, h = HEAD_CB_T + 0.01);
        }
        // 割り面（+X 側だけ残す）
        translate([SPLIT_GAP, -50, -50]) cube([100, 100, 100]);
    }
}

// ============================================================
// 壁（別部品・part="wall"）── 2026-08-19
//   溝の壁と、回転限界止めの 20度 を持つ。上面がへこみの底になる。
//   🔴 「乗るだけ・留め具は要らない」は取り消し（2026-08-19）。**ねじで留める。**
//      回転止めもねじが持つので、回り止めのピンは要らなくなる（ユーザー・2026-08-19）。
//   🔒 刷る向き: **上面（へこみの底）をプレートに直置き。** ピンは上を向いて生える。
// ============================================================
module wall_part() {
    difference() {
        translate([0, 0, Z_WALL_B]) cylinder(d = DISH_D - WALL_CL, h = WALL_T);
        translate([0, 0, Z_WALL_B - 1]) cylinder(d = HOLE_D, h = WALL_T + 2);
        // 円弧のスリット（**貫通**）。STOP_ANG の 20度 だけ残す＝限界止めの壁
        // 🔒 彫らずに貫くので、この部品には下を向く水平面ができない
        difference() {
            translate([0, 0, Z_WALL_B - 1]) rotate_extrude()
                translate([STOP_R0, 0]) square([STOP_R1 - STOP_R0, WALL_T + 2]);
            rotate([0, 0, STOP_ANG]) translate([0, 0, Z_WALL_B - 2])
                rotate_extrude(angle = POST_ARC)
                    translate([STOP_R0 - 1, 0]) square([STOP_R1 - STOP_R0 + 2, WALL_T + 4]);
        }
        ch_hole_top(HOLE_D / 2, Z_WALL_T, CH_S);
        // ねじ … 上からザグリ、下まで通し穴。⚠ どちらも逃げ。位置決めはさせない
        for (a = SCR_ANG) rotate([0, 0, a]) translate([SCR_R, 0, 0]) {
            translate([0, 0, Z_WALL_T - SCR_CB_T])
                cylinder(d = SCR_CB_D, h = SCR_CB_T + 0.01);
            translate([0, 0, Z_WALL_B - 0.01]) cylinder(d = SCR_D, h = WALL_T + 0.02);
        }
    }
    // 🔴 犠牲ブリッジ。スリットを切ったあとに架けるので、difference の外に置く
    if (bridges) for (a = BRIDGE_A) rotate([0, 0, a])
        translate([STOP_R0 - 0.3, -BRIDGE_W / 2, Z_WALL_B])
            cube([STOP_R1 - STOP_R0 + 0.6, BRIDGE_W, BRIDGE_T]);
}

// ============================================================
// 天板側 ── 筐体の天板に union / difference で組み込む
//   knob_station_add() … 増し肉のパッドと AS5600 の柱
//   knob_station_cut() … 落とし込みの穴と M2.5 ナットのポケット
// ============================================================
module knob_station_add() {
    // 裏の増し肉
    translate([-PAD_X / 2, -PAD_Y / 2, Z_PAD_BOT]) cube([PAD_X, PAD_Y, PAD_T]);
    // AS5600 の柱4本（小判形。丸柱は長穴の向きの肉厚 0.3mm で折れた実績）
    // 下端は基板の穴の位置、上へ行くほど外へ逃がす（ツメの通り道を空けるため）
    for (x = [-1, 1], y = [-1, 1]) difference() {
        post_solid(x, y);
        // 基板側の M2 も同じ理屈。丸穴 → 棚 → 六角。ナットは柱の横から差し込む
        translate([x * POST_XY_LO, y * POST_XY_LO, 0]) {
            // 長穴（チップを軸の真下へ寄せる調整代）。棚を貫く
            translate([0, 0, Z_PCB_TOP - 1]) hull() for (s = [-1, 1])
                translate([s * SLOT_LEN / 2, 0, 0])
                    cylinder(d = M2_D, h = M2_SHELF + 1.01);
            translate([0, 0, Z_PCB_TOP + M2_SHELF]) {
                // 六角のポケット（長穴と同じく小判形。どこでも止まれる）
                hull() for (s = [-1, 1]) translate([s * SLOT_LEN / 2, 0, 0])
                    cylinder(d = M2_NUT_AF / cos(30), h = M2_NUT_T + 0.2, $fn = 6);
                // 差し込む通路（柱の外側へ抜く）
                scale([x, 1, 1]) translate([0, -M2_NUT_AF / 2, 0])
                    cube([9, M2_NUT_AF, M2_NUT_T + 0.2]);
                // ねじ先の逃げ
                hull() for (s = [-1, 1]) translate([s * SLOT_LEN / 2, 0, 0])
                    cylinder(d = M2_D, h = M2_NUT_T + 2);
            }
        }
    }
}

module post_oval(h, d) {
    hull() for (s = [-1, 1]) translate([s * SLOT_LEN / 2, 0, 0])
        cylinder(d = d, h = h);
}

// 柱の**掘る前の形**。ナットの座がこの中に収まっているかを外から検査できるように、
// 独立したモジュールにしてある（掘ったあとの形と比べても意味が無い）
module post_solid(x, y) {
    // 下端はまっすぐ（ナットの座を彫る区間）
    translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_TOP])
        post_oval(POST_STRAIGHT, STANDOFF_D_LO);
    // そこから上で外へ倒す
    hull() {
        translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_TOP + POST_STRAIGHT])
            post_oval(0.01, STANDOFF_D_LO);
        translate([x * POST_HI_X, y * POST_HI_Y, POST_Z_HI])
            post_oval(0.01, STANDOFF_D);
    }
    translate([x * POST_HI_X, y * POST_HI_Y, POST_Z_HI])
        post_oval(Z_PAD_BOT - POST_Z_HI, STANDOFF_D);
}

module knob_station_cut() {
    // 落とし込みの穴（段 φ10 が通る）
    translate([0, 0, Z_PAD_BOT - 1]) cylinder(d = HOLE_D, h = DECK_T + PAD_T + 2);
    // 見える面のへこみ ＋ 壁の座。🔒 同じ φ26.2 で壁の下面まで一気に落とす
    translate([0, 0, Z_WALL_B]) cylinder(d = DISH_D, h = -Z_WALL_B + 1);
    ch_hole_top(DISH_D / 2, 0,        CH_S);   // 見える角
    ch_hole_top(HOLE_D / 2, Z_RELIEF, CH_S);
    // 🔒 2026-08-19、受け方を変えた。**輪はねじの所の3つの座だけで当てる。**
    //    ほかは全部 0.3mm 掘り下げる。2ヶ所で受けると必ずどちらかが勝って輪が反る。
    //    支柱の痕・床のデコボコも、座の外に落ちるので効かなくなる。
    difference() {
        translate([0, 0, Z_RELIEF]) cylinder(r = DISH_D / 2 + 0.01, h = RELIEF_D + 0.01);
        for (a = SCR_ANG) rotate([0, 0, a]) translate([SCR_R, 0, Z_RELIEF - 0.01])
            cylinder(d = SCR_PAD_D, h = RELIEF_D + 0.03);
    }
    // ねじの下穴（ナイロン M2.5 をねじ込む）
    for (a = SCR_ANG) rotate([0, 0, a]) translate([SCR_R, 0, Z_WALL_B - SCR_INTO])
        cylinder(d = SCR_TAP, h = SCR_INTO + 0.01);
    // M2.5 ナットの受け。ねじ側は丸穴、その奥が六角。棚 1.5mm が締め付けを受ける
    for (s = [-1, 1]) translate([s * BOSS_X, 0, Z_PAD_BOT]) {
        // 棚を貫く丸穴（ねじだけ通る。ナットは通らない）
        translate([0, 0, -0.01]) cylinder(d = M25_D, h = NUT_SHELF + 0.02);
        // 六角のポケット（棚の上。回り止め）
        translate([0, 0, NUT_SHELF])
            cylinder(d = M25_NUT_AF / cos(30), h = M25_NUT_T + 0.2, $fn = 6);
        // +Y の縁から差し込む通路（対辺と同じ幅）
        translate([-M25_NUT_AF / 2, 0, NUT_SHELF])
            cube([M25_NUT_AF, PAD_Y / 2 + 1, M25_NUT_T + 0.2]);
    }
    // リードスイッチの溝。天板の裏から差し込む。接線方向（長さは円周に沿う）
    translate([-REED_L / 2, REED_IN, Z_PAD_BOT - 0.01])
        cube([REED_L, REED_W, REED_W + 0.01]);
    // ⚠ ここに逃がしを入れてはいけない（2026-08-17 に削除）。
    //    穴が縮むのは**プレートに接している最初の5層（0.25mm）だけ**（docs/PRINT.md）。
    //    この溝の口は見える面から 4.45mm 入った所にあり、ボトム層ではない。
    //    逃がすと圧入の噛み代を 0.6mm 削るだけになる
    // ⚠ 足を ±X へ伸ばす溝は**作らない**。柱は斜め45度にあり、±X へ 6mm 伸ばすと
    //    柱の根元を横切る（2026-08-15、ユーザーが組み立てビューで発見）。
    //    足はリードの溝の中で内側へ曲げて、下の一本道から出す。
    // 端子の通り道。🔒 **端子はリードの両端から出る。**溝は圧入なので中を通せない。
    //    端から斜めの穴で +Y の縁まで引き、そこで箱の中へ落とす。
    //    その一点しか無い理由:
    //      ・AS5600 の柱は x 6.5〜14.5 に居るので、|x| が小さい所でしか下へ行けない
    //      ・基板は ±11.5 角なので、y が 14 まで出ないと線が基板の上に乗る
    //    ⚠ 穴は柱の根元の**上**を通る（z で 0.6mm 逃げている）。柱は削っていない
    // ⚠ 塞がったトンネルにしない。リードに付いた足は通せない（2026-08-16 ユーザー指摘）。
    //    **下から開いた樋**にして、リードを押し込んだあと線を落とし込む
    for (s = [-1, 1]) {
        // 🔒 樋は**1つの凸包**にする。3点（溝の端面・曲げ点・縁の出口）をまとめて包む。
        //    ⚠ 分けて掘ると、境目に薄い三角柱が残る。2026-08-16 に 0.4mm の
        //    三角柱が立っていて、ユーザーが拡大して見つけた。刷れば折れて溝に詰まる。
        //    凸包なら、へこんだ隅そのものが存在しないので残りようがない。
        hull() {
            // 種は溝の**端面**。⚠ 溝そのものを種にすると外壁まで削れて圧入が片側になる。
            // 楔が出ないのは、出口 LEAD_EXIT_X を溝の端 REED_L/2 より外に置いてあるから。
            // 稜線が |x| < REED_L/2 へ戻ってこないので、へこんだ隅が生じない
            translate([s * REED_L / 2 - (s > 0 ? 0.02 : 0), REED_IN, Z_PAD_BOT - 0.01])
                cube([0.02, REED_W, REED_W + 0.01]);
            translate([s * LEAD_TURN_X, REED_IN + REED_W / 2, Z_PAD_BOT - 0.01])
                cylinder(d = LEAD_CH_D, h = REED_W + 0.01, $fn = 24);
            translate([s * LEAD_EXIT_X, PAD_Y / 2 + 0.5, Z_PAD_BOT - 0.01])
                cylinder(d = LEAD_CH_D, h = REED_W + 0.01, $fn = 24);
        }
    }
}

// へこみの天井を支える柱（モデルに組み込む）
// 🔒 天板は「見える面をプレート側」で刷る。そのときへこみ（φ26.2 × 2.5）は
//    **天井のある空洞**になり、へこみの底の裏側が宙に浮く。ここだけは形で消せない
//    （袋状の凹みだから、どちら向きに刷っても浮く面が残る）。
//    ⚠ スライサーで手で立てるのではなく、モデルに入れておく。刷ったらニッパーで折る。
//    痕はへこみの底に残るが、組めば持ち手の下に隠れる。
// ============================================================
// へこみの天井を支える柱（モデルに組み込む）
// 🔴 **スライサーのサポートが効かなかったので、モデルに入れてある**（ユーザー実測）。
//    ⚠ 「痕が実害にならないからスライサーに任せればいい」は成立しない。
//    2026-08-19、AI が一度この理由で削除して差し戻された。**消さないこと。**
// 🔒 支えるのは**掘り下げた床（半径 5.5〜12.0）**。天井の中でいちばん幅が広く、
//    外周の輪の内縁だけでぶら下がる。受ける輪（12.0〜13.1）は幅 1.1mm で
//    へこみの壁に全周で付くので支柱は要らない。⚠ **受ける輪に痕を残さない**（壁の座）
// 🔒 刷る向きは「見える面をプレートへ」。柱はプレートから生えて天井を掴む。
//    ⚠ 傾けたり浮かせたりすると足がプレートに届かず、宙に浮いた島になる
DECK_PROP_D   = 1.4;
DECK_PROP_TIP = 0.8;       // 天井側の先端。細くして折りやすくする
// 🔴 **足元に薄い床を敷く**（2026-08-19・ユーザーの実績）。
//    敷かないと、プレートに接するのが **φ1.4 の点が24個**になる。
//    ⚠ **実績: そこは印刷が失敗しやすく、FEP に張り付いたことがある。**
//    床で1枚に繋ぐと、1層目が連続した面になって食いつく。刷ったら支柱ごと外す。
// 🔒 床は部品に触れさせない（へこみの壁 13.1 から離す）。触れると本体と融着する
DECK_RAFT_T = 0.3;         // 床の厚み（6層）
DECK_RAFT_R = 12.0;        // 床の半径。⚠ へこみの壁 13.1 まで 1.1mm 空ける
// 🔒 **並べ方は円周の等分ではなく、格子（千鳥）にする**（2026-08-19・ユーザー指摘）。
//    等分だと、ピンの穴やリードの溝で1本抜いた所がそのまま穴になり、スカスカになる。
//    格子なら、避けた場所の隣が自動で埋まる。
// ⚠ 隣まで 4mm を超えないこと（天井は支点の間でカールする・2026-08-17 の実績値）
DECK_PROP_P   = 3.0;
// 🔒 格子だけだと**内側の縁**（落とし込み穴のふち）が空く。あそこは自由端なので、
//    格子とは別に**内周へ1列**並べる。⚠ 外側の縁は受ける輪に繋がっているので不要
DECK_RING_N   = 14;
DECK_RING_R   = HOLE_D / 2 + DECK_PROP_D / 2 + 0.25;
function ring_pt(k) = [DECK_RING_R * cos(k * 360 / DECK_RING_N + 7),
                       DECK_RING_R * sin(k * 360 / DECK_RING_N + 7)];
function far_from_ring(x, y) =
    min([for (k = [0 : DECK_RING_N - 1]) norm([x, y] - ring_pt(k))])
        > DECK_PROP_D + 0.4;        // 隣まで約 4mm（2026-08-17 の実績値）

// 立ててはいけない場所はピンの穴だけ。
// 🔴 **リードの溝は避けなくてよい**（2026-08-19・ユーザーが絵で発見）。
//    支柱は床（z -4.0）まで届いて止まり、リードの溝は z -4.45 から下なので**届かない**。
//    ⚠ 一度これを避けていて、幅 15mm × 4mm の帯が丸ごと空いた。支えの無い張り出しが
//    最大 6.9mm になっていた（避けなければ 3.7mm）
function prop_ok(x, y) =
    min([for (a = SCR_ANG)
         sqrt(pow(x - SCR_R * cos(a), 2) + pow(y - SCR_R * sin(a), 2))])
        > SCR_PAD_D / 2 + DECK_PROP_D / 2 + 0.25;

// 支柱を立ててよい場所か。立てられない所（穴・溝）と、立ててはいけない所（壁の座）を弾く
function prop_zone(x, y) =
    let (r = sqrt(x * x + y * y))
    r >= DECK_RING_R                            // 落とし込み穴の外
    // 🔴 2026-08-19、外の縁を LAND_R0（12.0）にしていて、**ツメの通り道（9.8〜12.0）に
    //    支柱が立っていた**。折った痕の上をツメが擦る。ユーザーが実物で「地面の荒れに
    //    爪がひっかかる」と発見。ツメの先から床までは 0.55mm しかない。
    //    ⚠ 外へ空く帯は 8.9〜12.0（3.1mm）に増えるが、その外の受ける輪（12.0〜13.1）は
    //    へこみの壁に全周で付いているので、自由端の張り出しとしては 4mm を超えない。
    && r < STOP_R0 - DECK_PROP_D / 2 - 0.2      // 壁の座とツメの通り道に痕を残さない
    && prop_ok(x, y);

module one_prop(x, y) {
    translate([x, y, Z_RELIEF]) {
        cylinder(d1 = DECK_PROP_TIP, d2 = DECK_PROP_D, h = 0.4);
        translate([0, 0, 0.4]) cylinder(d = DECK_PROP_D,
            h = -Z_RELIEF - (raft ? DECK_RAFT_T : 0) - 0.4 + 0.01);
    }
}

module deck_props() {
    // 足元の床。刷る向きではこれが1層目になる。⚠ 画面で見るときは切る（raft = false）
    if (raft) translate([0, 0, -DECK_RAFT_T]) cylinder(r = DECK_RAFT_R, h = DECK_RAFT_T);
    // 内周の1列（自由端を支える）
    for (k = [0 : DECK_RING_N - 1]) {
        pt = ring_pt(k);
        if (prop_zone(pt[0], pt[1])) one_prop(pt[0], pt[1]);
    }
    // 残りを格子（千鳥）で埋める。内周の柱と重なるものは出さない
    n = ceil(LAND_R0 / DECK_PROP_P) + 1;
    for (j = [-n : n], i = [-n : n]) {
        x = i * DECK_PROP_P + (j % 2 == 0 ? 0 : DECK_PROP_P / 2);
        y = j * DECK_PROP_P * 0.866;
        if (prop_zone(x, y) && far_from_ring(x, y)) one_prop(x, y);
    }
}

module deck_test(props = true) {
    difference() {
        union() {
            translate([-PAD_X / 2, -PAD_Y / 2, Z_DECK_BOT])
                cube([PAD_X, PAD_Y, DECK_T]);
            knob_station_add();
        }
        knob_station_cut();
    }
    if (props) deck_props();
}

// ============================================================
// リードスイッチと、その足の通り道
//   足はリードの端から出て、溝の中で内側へ曲がり、+Y の一本道から箱の中へ落ちる。
//   🔒 ±X へは伸ばせない（柱の根元を横切る）。
// ============================================================
Z_REED_C = Z_PAD_BOT + REED_W / 2;      // リードの中心の高さ
Y_REED_C = REED_IN + REED_W / 2;        // リードの中心の半径

module wire(pts, d = 0.6) {
    for (i = [0 : len(pts) - 2]) hull() {
        translate(pts[i])     sphere(d = d, $fn = 16);
        translate(pts[i + 1]) sphere(d = d, $fn = 16);
    }
}

module reed_assembly(drop = 14) {
    translate([0, Y_REED_C, Z_REED_C]) reed_switch(lead = 0);
    color("#b87333") for (s = [-1, 1]) wire([
        // 本体の端面から出る。⚠ 線の半径 0.3 を足さないと端面に食い込む
        [s * (REED_BODY_L / 2 + 0.3), Y_REED_C, Z_REED_C],
        [s * LEAD_TURN_X, Y_REED_C, Z_REED_C],          // ここまで真っ直ぐ出す
        [s * LEAD_EXIT_X, PAD_Y / 2 + 0.5, Z_REED_C],   // 樋で +Y の縁へ
        [s * LEAD_EXIT_X, PAD_Y / 2 + 0.5, Z_PAD_BOT - drop]   // 箱の中へ落とす
    ]);
}

module assembly(show_deck = true) {
    color("#d8dde3") knob_part();
    color("#c8763f", 0.95) { half_part(); mirror([1, 0, 0]) half_part(); }
    color("#e03131") wall_part();          // 壁（別部品・床に乗るだけ）
    // ⚠ 支柱は刷ったら折るものなので、組み立てビューには出さない
    if (show_deck) color("#9aa5b1", 0.75) deck_test(props = false);
    // M2.5 ナイロンねじ
    // ⚠ 2026-08-16 訂正。ねじもナットも **1.5mm 低く描いていた**（ザグリ HEAD_CB_T と
    //    棚 NUT_SHELF を勘定に入れていなかった）。そのせいで組み立てビューでは
    //    ナットが棚に 25.9mm3 めり込んで見え、当たり検査で偽の当たりが2つ出ていた。
    //    🔒 実物の寸法は正しい（下の echo の検算が通っている）。**絵だけの誤り。**
    color("#e8e8e8") for (s = [-1, 1]) translate([s * BOSS_X, 0, Z_RING_B + HEAD_CB_T]) {
        translate([0, 0, -M25_HEAD_T]) cylinder(d = M25_HEAD_D, h = M25_HEAD_T);
        cylinder(d = 2.5, h = M25_LEN);
    }
    color("#888") for (s = [-1, 1]) translate([s * BOSS_X, 0, Z_PAD_BOT + NUT_SHELF])
        cylinder(d = M25_NUT_AF / cos(30), h = M25_NUT_T, $fn = 6);
    // AS5600（穴もチップもコネクタも入った実物のモデル）
    translate([0, 0, Z_PCB_BOT]) as5600(show_connector = false);
    // 基板を留める M2×5。下から入れて、棚を貫いてナットへ
    color("#e8e8e8") for (x = [-1, 1], y = [-1, 1])
        translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_BOT]) {
            translate([0, 0, -1.3]) cylinder(d = 3.8, h = 1.3);
            cylinder(d = 2.0, h = PCB_T + M2_SHELF + M2_NUT_T);
        }
    color("#888") for (x = [-1, 1], y = [-1, 1])
        translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_TOP + M2_SHELF])
            cylinder(d = M2_NUT_AF / cos(30), h = M2_NUT_T, $fn = 6);
    color("#bbb")    translate([0, 0, Z_MAG_BOT]) cylinder(d = 4.0, h = 2.0);
    // リード用磁石（持ち手の裏・面が真下）とリードスイッチ一式
    // ⚠ 2026-08-17 訂正。ここは磁石を**立てずに**描いていた（軸が縦のまま）。
    //    実物は円板を立てて軸を +X へ向ける。絵だけの誤りだが、当たり検査が効かない
    color("#c0392b")
        translate([-magnet_reed_t() / 2, MAG2_R, Z_MAG2_BOT + MAG2_PART_D / 2])
            rotate([0, 90, 0]) magnet_reed();
    reed_assembly();
}

module exploded() {
    translate([0, 0, 30]) color("#d8dde3") knob_part();
    translate([0, 0, 14])   color("#e03131") wall_part();
    translate([26, 0, 10])  color("#c8763f") half_part();
    translate([-26, 0, 10]) color("#c8763f") mirror([1, 0, 0]) half_part();
    color("#9aa5b1", 0.8) deck_test();
    translate([0, 0, -12]) {
        color("#2b6b3f") translate([-PCB / 2, -PCB / 2, Z_PCB_BOT]) cube([PCB, PCB, PCB_T]);
        color("#333") translate([-2.5, -2, Z_PCB_TOP]) cube([5, 4, CHIP_H]);
    }
    translate([0, 0, 24]) color("#bbb") translate([0, 0, Z_MAG_BOT]) cylinder(d = 4.0, h = 2.0);
}

// ---- 印刷の向き ----
//   つまみ: 🔒 **持ち手の天面をプレートに直置き**（軸が上を向く）。
//     ⚠ 2026-08-16、逆向き（軸を下）で刷って失敗した。持ち手の裏が下を向くため、
//     **磁石ポケットの口にサポートが入って潰れ**、段Aの下面にも痕が残った。
//     天面を下にすれば、裏側の大事な2面（段Aの下面・磁石ポケットの口）が
//     どちらも上を向き、サポートが付かない。
//     ・サポートが付くのは段Bの上面 … 引き上げたときしか当たらない面。実害なし
//     ・天面はプレートに接して象足が出る … Z=0を取り直せば 0.1mm 程度。
//       天面には 0.8mm の面取りが入っているので、剥がすときの角も立たない
//     ・軸の先の磁石ポケットが上を向く … 洗浄でレジンが溜まる。抜くこと
//     ✅ **やすりは要らない。** 擦れ合う2面（段Aの下面・半月の上面）は、どちらも
//        それぞれの印刷向きで**上を向く面**になるので、最初から平らに出る。
//        ⚠ 2026-08-16 まで「800番で平らに当てること」と書いていたが、
//        ① 軸を下に刷っていた頃の名残で、いまの向きでは不要
//        ② そもそも段Bが同じ φ15 で 5.2mm 下に出ているので、平らなやすりは
//           段Aの下面に**物理的に届かない**（ユーザー指摘）
//        シリコングリスを塗るのはこの2面。
//   半月: そのまま平置き。押さえ面も軸受けの穴も向きを選ばない。
//   天板: 🔒 **見える面をプレートに直置き。傾けない・浮かせない・ラフトを敷かない。**
//     ⚠ 2026-08-17、ここに「平らな面が広いので 15〜20度 傾けると吸着が減る」と書いてあり、
//     支柱（deck_props）の前提と**矛盾していた**。支柱はプレートから生えてへこみの天井を
//     掴む形なので、傾けたり浮かせたりすると足がプレートに届かず、**宙に浮いた φ1.4 の島**
//     になって刷れない。実際ほとんど脱落し、へこみの底（＝回転の溝が乗る面）が荒れた。
//     ・支柱が消えると、8.0〜9.8 の輪がどこにも繋がらないまま生まれてカールする
//     ・オートサポートで代わりをさせると、今度は溝の中にサポート痕が残る
//     刷ったら支柱 8本をニッパーで折る。痕はへこみの底に残るが、組めば持ち手の下に隠れる
// つまみは**持ち手の天面をプレートへ**。上下をひっくり返して置く
if      (part == "knob")    rotate([180, 0, 0])
                                translate([0, 0, -(Z_GRIP_B + GRIP_H)]) knob_part();
else if (part == "half")    translate([0, 0, -Z_RING_B]) half_part();
else if (part == "deck")    rotate([180, 0, 0]) deck_test();
// 壁は**上面（へこみの底）をプレートへ**。上下をひっくり返して置く
else if (part == "wall")    translate([0, 0, Z_WALL_T]) rotate([180, 0, 0]) wall_part();
else if (part == "magpath") magnet_path_check();
else if (part == "explode") exploded();
else                        assembly();

echo(str("段 φ", STEP_D, "（半径 ", STEP_D / 2, "） / 柱の内縁 半径 ", post_inner_r(),
         " → すき間 ", post_inner_r() - STEP_D / 2, "mm"));
echo(str("半月の円盤 半径 ", RING_R, " → 柱まで ", post_inner_r() - RING_R, "mm"));
echo(str("柱の高さ ", Z_PAD_BOT - Z_PCB_TOP, "mm / 磁石とチップ ", CHIP_GAP, "mm"));
echo(str("ねじの検算: 半月の残り ", RING_T - HEAD_CB_T, " ＋ 棚 ", NUT_SHELF,
         " ＋ ナット ", M25_NUT_T, " = ", RING_T - HEAD_CB_T + NUT_SHELF + M25_NUT_T,
         " / 手持ちのねじ ", M25_LEN, "mm"));
echo(str("M2.5 ナットの上に残る肉 ",
         -(Z_PAD_BOT + NUT_SHELF + M25_NUT_T + 0.2), "mm / 棚 ", NUT_SHELF, "mm"));
echo(str("基板側 M2: 棚 ", M2_SHELF, "mm / 柱の下端 φ", STANDOFF_D_LO,
         "（ナットの横挿し口の壁 ", (STANDOFF_D_LO - M2_NUT_AF) / 2, "mm）"));
echo(str("へこみ φ", DISH_D, " × ", DISH_T, " / ローレット外径 ", GRIP_D + RIB_D,
         " / ねじは半径 ", BOSS_X, "（へこみの縁 ", DISH_D / 2, " の外）"));
echo(str("軸方向の遊び ", NECK_T - RING_T, "mm / 持ち手の逃げ ", GRIP_GAP, "mm"));
echo(str("リード: 磁石の下端 → 接点 ",
         sqrt(pow(REED_IN + REED_W / 2 - MAG2_R, 2) +
              pow(Z_MAG2_BOT - (Z_PAD_BOT + REED_W / 2), 2)),
         "mm ／ 磁石の中心 → 接点 ",
         sqrt(pow(REED_IN + REED_W / 2 - MAG2_R, 2) +
              pow(Z_MAG2_BOT + MAG2_PART_D / 2 - (Z_PAD_BOT + REED_W / 2), 2)), "mm"));
// 磁石はポケットの中で Y に ±0.15 動ける（掴んでいるのは厚み方向だけ）。
