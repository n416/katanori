// CHITUBOX が STL の座標をそのまま使うかどうかの試験片 ── 2026-08-31
// ============================================================
// 🔴 何のための物か
//   「刷るぞー」（印刷ターム単位で並べて、配置済みの STL を書き出すローカルアプリ）の
//   設計が、前提を 1 つ抱えている。**CHITUBOX が読み込んだ STL の座標を尊重するか、
//   勝手にプレート中央へ寄せるか。**
//   寄せられるなら「配置済み STL を出す」という出力形式そのものが成立しないので、
//   何かを書き始める前にここを潰す。
//
//   ⚠ これは刷る物ではない。**読み込んで位置を見るだけ**の物である。
//
// ------------------------------------------------------------
// 使い方（2 分）
// ------------------------------------------------------------
//   1. CHITUBOX に **A と B の 2 つを読み込む**（1 つずつでよい）
//   2. 下の「期待される位置」どおりに離れて出るかを見る
//   3. どうなったかだけ教えてもらえれば足りる
//
//   ⚠ 読み込み時に自動配置する設定があれば、**切った状態でも試すこと。**
//     既定で寄る場合でも、切れるなら設計は成立する。
//
// ------------------------------------------------------------
// 期待される位置（Mars 3 のプレートは 143 x 89mm・中心を原点とみなす）
// ------------------------------------------------------------
//   A … 中心が (-40, -25)。**+X 側に爪が 1 つ出ている**（向きの確認用）
//   B … 中心が (+40, +25)。**真ん中に穴が開いている**
//
//   ⇒ 2 つの中心の距離は X で 80.0、Y で 50.0。
//   ⇒ どちらも **Z=0 に接地**している（高さ 3.0）。
//
//   読める結果は 3 通り:
//     ✅ 離れたまま出る          → 座標は尊重される。設計はこのまま進む
//     ❌ 2 つが重なる／中央に来る → 1 つずつ中央へ寄せられている。**出力形式を変える**
//                                  （1 つの STL に結合して出すしかない）
//     ⚠ 離れているが位置が違う   → 原点の取り方が違う。オフセットを測って合わせる
//
// ------------------------------------------------------------
// 焼き方
// ------------------------------------------------------------
//   openscad --backend=manifold -D 'part="a"' -o stl/test/coord_test_a.stl hardware/chitubox_coord_test.scad
//   openscad --backend=manifold -D 'part="b"' -o stl/test/coord_test_b.stl hardware/chitubox_coord_test.scad
// ============================================================
$fn = 48;

// part の値: "a" / "b" / "both"（both は目で見て確かめる用。書き出さない）
part = "both";

BOX   = 10.0;   // 一辺
T     =  3.0;   // 高さ
AX    = -40.0;  // A の中心
AY    = -25.0;
BX    =  40.0;  // B の中心
BY    =  25.0;

// A ── +X 側に爪。向きが変わったら爪の向きで分かる
module piece_a() {
    translate([AX, AY, 0]) {
        translate([-BOX/2, -BOX/2, 0]) cube([BOX, BOX, T]);
        translate([BOX/2, -1.5, 0]) cube([4.0, 3.0, T]);   // 爪
    }
}

// B ── 真ん中に穴。A と取り違えないように形を変えてある
module piece_b() {
    translate([BX, BY, 0])
        difference() {
            translate([-BOX/2, -BOX/2, 0]) cube([BOX, BOX, T]);
            translate([0, 0, -1]) cylinder(d = 5.0, h = T + 2);
        }
}

if (part == "a")         piece_a();
else if (part == "b")    piece_b();
else                   { piece_a(); piece_b(); }
