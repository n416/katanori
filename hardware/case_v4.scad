//   （板の前面 Y 8.185・下端 Z 2.5。ReSpeaker は 🔒 動かせない 3 点の 1 つ）。⇒ 柱の footprint と同じ 7.5 で止める。
//   ビス（Y 4.75）も柱（Y 2〜7.5）も内側に入るので、締める働きは変わらない。
FEAR_Y1 = 2 + BOSS_B_DY_F;       // 7.5 柱の後ろの縁まで
module front_ears_low() {
    y0 = min(EAR_Y0, FY_IN);
    for (i = [0, 1]) {
        ex = EAR_X[i]; c = V4_FLOOR_SCREWS[i];
        difference() {
            translate([ex[0], y0, 0]) cube([ex[1] - ex[0], FEAR_Y1 - y0, FEAR_T]);
            translate([c[0], c[1], -1]) cylinder(d = SCR_D, h = FEAR_T + 2, $fn = 24);   // 🔒 ナットは持たない（柱の頭にある。上の耳と同じ）
        }
    }
}
module front_v4() { front_plate_raw(); color("#c9d0d8") front_ears_low(); }
module skin1(k) {
    if (k == "floor") floor_v4();
    if (k == "lwall") lwall_v4();
    if (k == "rwall") rwall_v4();
    if (k == "top")   top_v4();
    if (k == "front") front_v4();
    if (k == "hatch") hatch_v4();
