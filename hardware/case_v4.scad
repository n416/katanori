module keepout_seat() { for (h = HUB_HOLES4) translate([h[0], h[1], -1]) cylinder(d = HUB_POST_D + 0.6, h = BOARD_Z + 1, $fn = 32); }   // ハブの柱が入る
// 🔴 2026-08-29 ここは空だった。コメントの「留め帯は穴もねじも持たない」は古く、いまの帯は
