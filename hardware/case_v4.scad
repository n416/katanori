    translate([4.4, 69.5, BOSS_B_H - NUT_T]) rotate([0, 0, 30]) hex_pocket(NUT_T + 1);
    translate([4.4, 69.5, -1]) cylinder(d = SCR_D, h = BOSS_B_H + 2, $fn = 24);
}
