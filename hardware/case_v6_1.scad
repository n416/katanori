echo(str("hatch feet: X ", HSCR_X, " Y ", IN_Y - HFOOT_D, "-", IN_Y, " H ", HFOOT_H, " / nut Z ", HFOOT_FLOOR, "-", HFOOT_FLOOR + NUT_T, " / M2x", HSCR_LEN, " head at Z ", -FLOOR_T + SCR_CBT, " tip at Z ", -FLOOR_T + SCR_CBT + HSCR_LEN, " (foot top ", HFOOT_H, ")"));
