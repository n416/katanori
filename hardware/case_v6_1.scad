//   OLED のリブ: 板の裏の 0.2 後ろ・厚み 1.2・高さ 5・中央 25 はフィルムの切り欠き
RSP_SLOT_CL = 0.2; RSP_RIB_X0 = 8.0; RSP_RIB_X1 = IN_X - 8.0;
