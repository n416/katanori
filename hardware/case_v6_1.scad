// 🔒 ユーザー 2026-09-19「キャップだけレジンで刷りましょう」: キャップは筐体の材料（MAT）によらず**自分の光造形**で刷る。
//   彫り 0.4・線 0.5 は MJF の目安（0.8 × 0.8）を満たさない。顔の厚みが 0.9 しかなく 0.8 彫ると押し子の穴まで 0.1 になるので、レジンに逃がした。
//   刷る向きは顔を下（part="print_pwrcap"）。⚠ 押し子の先を受ける穴の遊び 0.1 は仮。刷って押し子に差して合わせる
//   ⚠ **形は付ける箱の材料で決まる**（顔の出を揃えるので、壁の厚みのぶん長さが違う: ナイロン 1.6 の箱なら 3.6・レジン 2.8 の箱なら 4.8）。
//     ナイロンの箱に付けるキャップは `-D MAT="nylon" -D part="print_pwrcap"` で書き出して、光造形で刷る
function pwr_full_y() = PCB_Y1 + 0.3 + 2.0;                            // 顔の丸の後ろの端（切れている姿勢）。押し切って 2.0 下がっても板の縁 ＋ 0.3
function pwr_blk() = [PWR_SOCK[0] / 2 + PWR_BLK_WALL, HUB_AT[2] + 1.6 + 0.3, pwr_key_z() + PWR_SOCK[1] / 2 + PWR_BLK_WALL];   // [X の半幅, Z の下, Z の上]
function pwr_fl_y() = IN_Y - PWR_FL_GAP;                               // 鍔の前の面（切れている姿勢）
module pwr_icon2d() {
    difference() { circle(r = PWR_ICON_R + PWR_ICON_W / 2, $fn = 48); circle(r = PWR_ICON_R - PWR_ICON_W / 2, $fn = 48);
                   polygon([[0, 0], [5 * sin(PWR_ICON_GAP), 5 * cos(PWR_ICON_GAP)], [-5 * sin(PWR_ICON_GAP), 5 * cos(PWR_ICON_GAP)]]); }
    hull() { translate([0, 0.1]) circle(d = PWR_ICON_W, $fn = 16); translate([0, PWR_ICON_R + PWR_ICON_W / 2 + 0.2]) circle(d = PWR_ICON_W, $fn = 16); }
}
module pwr_cap(press = 0) translate([0, -press, 0]) difference() {   // 色は呼ぶ側で付ける（模型の断面で塗り分けるため）
    r0 = pwr_tip_y() - PWR_SOCK_D; f = pwr_cap_face(); y1 = pwr_full_y(); b = pwr_blk(); fy = pwr_fl_y();
    union() {
        translate([pwr_x(), 0, pwr_cap_z()]) rotate([-90, 0, 0]) {
            translate([0, 0, y1]) cylinder(d = PWR_CAP_D, h = f - y1 - PWR_CAP_CH, $fn = 64);
            translate([0, 0, f - PWR_CAP_CH]) cylinder(d1 = PWR_CAP_D, d2 = PWR_CAP_D - 2 * PWR_CAP_CH, h = PWR_CAP_CH, $fn = 64);
        }
        translate([pwr_x() - b[0], r0, b[1]]) cube([2 * b[0], y1 - r0 + 0.01, b[2] - b[1]]);
        intersection() {   // 鍔（下は受けの下の縁で切る）
            translate([pwr_x(), 0, pwr_cap_z()]) rotate([-90, 0, 0]) translate([0, 0, fy - PWR_FL_T]) cylinder(d = PWR_CAP_D + 2 * PWR_FL_W, h = PWR_FL_T, $fn = 64);
            translate([pwr_x() - 10, fy - PWR_FL_T - 1, b[1]]) cube([20, PWR_FL_T + 2, 20]);
        }
    }
    translate([pwr_x() - PWR_SOCK[0] / 2, r0 - 1, pwr_key_z() - PWR_SOCK[1] / 2]) cube([PWR_SOCK[0], PWR_SOCK_D + 1, PWR_SOCK[1]]);
    translate([pwr_x(), f - PWR_ICON_D, pwr_cap_z()]) rotate([-90, 0, 0]) linear_extrude(PWR_ICON_D + 1) mirror([0, 1]) pwr_icon2d();   // 顔の記号（切れ目と縦棒が上）
}
// 押しボタンの模型。KiCad に 3D モデルが無いので PCB3D のメッシュには出ない ⇒ 胴は部品表の箱（PCB3D のときだけ。そうでなければ pcb_parts61 が描く）・押し子は図面の寸法
module pwr_btn61(press = 0, body = true) let (q = pwr_q(), y0 = pwr_front_y() - press, z = pwr_key_z()) {   // 色は呼ぶ側。body = false で押し子だけ   // press: 押し子を押し込んだ量（絵のため。胴は動かない）
    if (PCB3D && body) translate([HUB_AT[0] + q[1], PCB_Y0 + q[3], HUB_AT[2] + 1.6]) cube([q[2] - q[1], q[4] - q[3], q[5]]);   // 胴（押し子が胴へ入る分は描き分けない）
    translate([pwr_x() - PWR_KEY_BASE[0] / 2, y0 - 0.01, z - PWR_KEY_BASE[2] / 2]) cube([PWR_KEY_BASE[0], PWR_KEY_BASE[1] + 0.01, PWR_KEY_BASE[2]]);
    translate([pwr_x() - PWR_KEY_TIP[0] / 2, y0 + PWR_KEY_BASE[1] - 0.01, z - PWR_KEY_TIP[2] / 2]) cube([PWR_KEY_TIP[0], PWR_KEY_TIP[1] + 0.01, PWR_KEY_TIP[2]]);
}
module p_hatch() difference() {
    union() { slab_hatch(); if (!nylon()) { hatch_ears_top(); hatch_feet(); } }   // v6.1: 蓋の縁・Type-C の羊羹は無い   // 縁（溝の床〜内面・つば）・上の耳 2 つ・下の足 2 つはハッチと一体。下の爪 2 つは 2026-09-07 に廃止（床の裏からのねじ 2 本に）。右下の耳も同日廃止（🔒 ユーザー「羽根はいらないね」）
    usbc61_port_cut();   // 充電の USB-C の口（⭐ 2026-09-17 右の壁から移した）
    if (!nylon()) usbc61_counterbore();   // レジンだけ口のまわりを掘る（⭐ 2026-09-17）
    hatch_foot_cuts();   // 足のナットの横穴とねじの通し（羊羹に埋められないよう、ハッチ全体から引く）
    pwr_port_cut();      // 電源の押しボタンのキャップの丸穴（⭐ 2026-09-19 トグルの M6 の穴から替えた）
}
// ハブ基板の留め（v4 §5: M3×8 ×4・頭は床の裏のザグリ・ナットは基板の上）: 床から柱 φ7.0（高さ = 板の下面 2.5）、通し φ3.2、裏の座ぐり φ6.0 × 2.0
// 🔒 ユーザー 2026-09-14「PCB 基板の穴位置は自由」: 電池（X 33.85〜83.85・Y 9.9〜44.9）の上には柱を立てられないので、
//   空いている L 字（左の帯 X ≤ 30.3 と 後ろの帯 Y ≥ 48.4）に 4 本。柱は φ5・M2（v5 の M3 φ8 はやめる）
//   条件は 2 つだけ: ① 柱は床から立つので電池（X 18.05〜68.05・Y 9.9〜44.9）の上に置けない
//                     ② 箱の隅の柱（X 1.69〜7.69 と 78.35〜84.35 × Y 1〜5.5 と 44.9〜50.9）と重ねられない
//   ①で空くのは 左の帯（X 〜18.05）・右の帯（X 68.05〜）・後ろの帯（Y 44.9〜）の 3 つ。②で後ろの帯の両端が落ちる。
//   ⇒ 板の 4 隅に一番近い 4 点は次のとおり（φ5 の柱の外周で 0.35 以上空く）
HUB_HOLES_W = [[HUB_AT[0] + 4.0, PCB_Y0 + 3.5], [81.354, PCB_Y0 + 3.5], [4.834, 47.4942], [81.354, 48.4]];   // 🔒 ユーザー 2026-09-16 夕「いっそ切り欠きなくして柱と同じ位置にすれば？」「レジンでのハッチ止めと、ナイロンでの左フラップ止めの穴の位置は合わせる必要がある」:
//   後ろ 2 点を**箱の柱の芯**へ。右後ろはレジンの柱の芯 (81.354, 48.4)。
//   左後ろは **ナイロンの蓋の足のねじに合わせる**（🔒 ユーザー 2026-09-16 夕「ナイロンの大きいほうに合わせるしかないだろうが」）。
//   足のねじは後ろのレール 50.6 とナットの対角 5.43 で位置が決まっていて動かせないので、こちらが基準。
//   🔴 FOOT_SCR を式で参照できない（NUT_AF などがこの行より下で代入される）ので実数で持ち、下の assert で一致を強制する。
//   ⚠ レジンの左後ろの柱（下・上とも芯 4.694, 48.4）はこの位置へ追従させる必要がある。未対応
//   旧: [12.0, 46.9] / [74.5, 46.9] ── 柱の芯より 7.3 / 6.9 内側で、そのせいで専用の φ7 の柱が要り、その柱が板の欠きに 1.09 食い込んでいた
//   ⭐ 2026-09-16 夜: 前右を 74.5 → **81.354**（後ろ右と同じ X）。🔒 ユーザー「組む順で問題にならないのなら外側に出せるでしょ？」
//   旧 74.5 の理由は「φ7 の柱の外周 78.0 が箱の隅の柱 78.354 まで 0.35」。
//   🔴 私は「外へ出すと PH2（J4 SPK IN・J10 BAT）に当たる」と言ったが**間違い**。平面の重なりしか見ていなかった。
//     柱は床から板の裏（Z 0〜12.0）、PH2 は板の**上**。ReSpeaker も組む順で後から入る。Z では当たらない。
//   前左はそのまま（🔒 ユーザー「前は今のままでいい」。レジンの前の柱は Y 3.25 で板の前縁 13.5 より外）
module hub_posts() {   // 床から板の裏（レジン Z 8.0・ナイロン 12.0）まで
    // 2026-09-18: レジンは**前の 2 本だけ**を床から立てる。後ろの 2 本は左右の壁の下の柱（post_b）が座を兼ねるので、
    //   床からも立てると同じ柱を 2 枚の板が持つことになり、板が組めない（左 318.33mm3・右 314.99mm3 の重なり）。
    //   前の 2 本は φ7 の丸棒ではなく φ5.0 の管にする（ねじは板の上から通して床の裏のナットへ抜ける）
    if (!nylon()) for (i = [0, 1]) translate([HUB_HOLES_W[i][0], HUB_HOLES_W[i][1], -0.01])
        rotate_extrude($fn = 48) translate([HUB_SCR_D / 2, 0]) square([(HUB_POST_D_R - HUB_SCR_D) / 2, HUB_AT[2] + 0.01]);
    else { bat_case(); rear_post(); }   // ⭐ 2026-09-16 夕の 4 手順（🔒 ユーザー）: スペーサー（床からの柱 2 本と corner_boss）を取り払い、電池のケーシング（台）に置き換える
}
// 左後ろの柱（底パーツ・ナイロンだけ）。🔒 ユーザー 2026-09-16 夕「柱を底パーツ側に立てると思ってましたよ」
//   上から降りてくる足（旧 lid_foot）をやめ、**床から立つ柱**にする。降りてくる物が無くなるので PCB を一切削らずに済む。
//   板はこの頭（Z 12.0）に載り、**4 本目のねじ**で留まる。フラップはこの柱へ横ねじ 1 本（🔒 ユーザー「１」）。
//   🔴 下半分は電池の後ろ 0.3（Y 45.2）から。電池（Y 9.9〜44.9）はここを −X へ抜けるので、その下に肉を置けない。上半分は前へ Y 43.9 まで張り出し、下は 45°
//   🔴 rp_x() / rp_yu() を関数にする: NUT_AF や RAIL_W_R はこの行より下で代入されるので、変数だと undef になる
function rp_w()  = NUT_AF + 0.1 + 2 * 0.85;                                   // 柱の幅 6.4（ナットの二面幅 4.7 の両脇に肉 0.85）
function rp_x()  = [LW_X, LW_X + rp_w()];                                     // X 1.694〜8.094
function rp_yu() = IN_Y - RAIL_W_R - FIT_SLIP / 2 - rp_w();                   // 上半分の前 43.9
function rp_scr() = [48.3, 3.5];                                              // 横ねじの芯 [Y, Z]（下半分の真中）
RP_ZL = 6.7;                                                                  // 下半分の高さ（電池の天面 6.0 の 0.7 上）
module rear_post() let (X = rp_x(), yl = bat_box()[3] + 0.3, yu = rp_yu()) {
    translate([X[0], yl, -0.01]) cube([X[1] - X[0], IN_Y + 0.01 - yl, RP_ZL + 0.01]);                                       // 下半分
    hull() {                                                                                                                // 上半分（前へ張り出し・下は 45°）
        translate([X[0], yu, RP_ZL + (yl - yu)]) cube([X[1] - X[0], IN_Y + 0.01 - yu, HUB_AT[2] - RP_ZL - (yl - yu)]);
        translate([X[0], yl, RP_ZL - 0.01]) cube([X[1] - X[0], IN_Y + 0.01 - yl, HUB_AT[2] - RP_ZL + 0.01]);
    }
}
// ---- 電池のケーシング（台）・ナイロンだけ ----
// 🔒 ユーザー 2026-09-16 夕の 4 手順:
//   ① スペーサーを取り払う
//   ② 電池のケーシングを作る。**サイズはハブ基盤と全く同じ形**。中にガイドが立っていてそれで固定される。厚みは電池の厚み＋
//   ③ ケーシングの上にナットのポケットを持った柱を 4 つ、ハブ基盤のネジ穴位置に合うように立てる
//   ④ 筐体の底に置き、ケーシングの底を抜いて台の形にしてから UNION
BCS_T   = 1.0;                  // 周りの壁。⚠ 板の奥行き 37.4 に電池 35.0 なので、前後の壁に使えるのは合計 2.4 だけ。1.2 ずつだと電池が入らない（内寸 35.0 ちょうど）
BCS_H   = 7.0;                  // 内側の天井（電池の天面 6.0 の 1.0 上）──「厚みは電池の厚み＋」
BCS_DT  = 1.2;                  // 天板の厚み。天面 8.2 ＝ 柱の根（ナットの溝 9.2〜11.0 の 1.0 下）
BCS_TOP = BCS_H + BCS_DT;
function bcs_fy() = RSP_BD_Y0;   // 🔴 変数だと RSP_BD_Y0（この行より下で代入）が undef になり、延長が黙って消える   // 🔒 ユーザー 2026-09-16 夕「ケーシングの天板を手前に広げ、ReSpeaker を貫通して、当該位置まで広げてください。当然衝突判定は無視です」→ 前の端は **ReSpeaker の板の前面 8.185**。天板だけ前へ出す（壁は伸ばさない）
// 🔴 関数にする: POST_W_TL も FOOT_Y0 もこの行より下で代入されるので、変数だと undef になる
function pcb_nt_x1() = LW_X - PCB_NOTCH + POST_W_TL + 2 * PCB_NOTCH;   // 板の左後ろの欠きの右端 9.594
function pcb_nt_y0() = FOOT_Y0 - PCB_NOTCH;                            // 同じく前端 43.4
// ハブ基盤と同じ輪郭（左後ろの欠き込み）
function bat_case_poly() = [[HUB_AT[0], PCB_Y0], [HUB_AT[0] + PCB_L, PCB_Y0], [HUB_AT[0] + PCB_L, PCB_Y1],
                            [pcb_nt_x1(), PCB_Y1], [pcb_nt_x1(), pcb_nt_y0()], [HUB_AT[0], pcb_nt_y0()]];
// 🔒 ユーザー 2026-09-16 夕「ブーリアンで削るな」: 箱を一度塗りつぶしてから中と壁を引くのをやめ、実在する壁だけを組む。
//   壁（Z 0〜BCS_H）は 右・後ろ・欠きの縦の縁 の 3 枚だけ。
//     手前（Y 13.5）  … 🔒 ユーザー「ケーシングの手前の壁を削除」なので無し
//     左（X 2.0）     … 電池の出入り口なので無し
//     欠きの横の縁（Y 43.4・X 2.0〜9.594）… 全部が電池の抜け道の中なので無し
//     欠きの縦の縁（X 9.594） … 電池の後ろ 0.3（Y 45.2）から後ろだけ
//   天板（Z BCS_H〜BCS_TOP）は J10 の窓を避けて 5 枚に分けて置く（窓も引かない）
module bat_case() {
    x0 = HUB_AT[0]; x1 = HUB_AT[0] + PCB_L; nx = pcb_nt_x1(); ny = pcb_nt_y0();
    w  = bat_case_j10_win();
    // ---- 壁 ----
    translate([x1 - BCS_T, PCB_Y0, 0])            cube([BCS_T, PCB_W, BCS_H]);                                   // 右
    translate([nx, PCB_Y1 - BCS_T, 0])            cube([x1 - nx, BCS_T, BCS_H]);                                 // 後ろ
    translate([nx, bat_box()[3] + 0.3, 0])        cube([BCS_T, PCB_Y1 - BCS_T - (bat_box()[3] + 0.3), BCS_H]);   // 欠きの縦の縁
    // ---- 天板（前は bcs_fy() 8.185 まで。ReSpeaker を貫くのは承知） ----
    translate([x0, bcs_fy(), BCS_H])              cube([nx - x0, ny - bcs_fy(), BCS_DT]);                        // 左（欠きの手前まで）
    translate([nx, bcs_fy(), BCS_H])              cube([w[0] - nx, PCB_Y1 - bcs_fy(), BCS_DT]);                  // 窓の左
    translate([w[1], bcs_fy(), BCS_H])            cube([x1 - w[1], PCB_Y1 - bcs_fy(), BCS_DT]);                  // 窓の右
    translate([w[0], bcs_fy(), BCS_H])            cube([w[1] - w[0], w[2] - bcs_fy(), BCS_DT]);                  // 窓の前
    translate([w[0], w[3], BCS_H])                cube([w[1] - w[0], PCB_Y1 - w[3], BCS_DT]);                    // 窓の後ろ
    // ---- 柱 4 本とガイド ----
    for (i = [0, 1, 3]) let (h = HUB_HOLES_W[i]) translate([h[0], h[1], BCS_TOP - 0.01]) cylinder(d = HUB_POST_D, h = HUB_AT[2] - BCS_TOP + 0.01, $fn = 32);   // 🔒 ユーザー「他 3 点は止まってるんだよね？だったら留めなくてもいい」: 左後ろ（i=2）は柱を立てない。そこは蓋の足が降りてくる場所
    bat_case_guides();
}
// J10（板の裏・下向き）と、そこへ挿さるプラグは天板（7.0〜8.2）を突き抜けるので、そこだけ天板を置かない。[x0, x1, y0, y1]
// ⭐ 2026-09-16 夕に**縦の口**になった。抜く向きが −Z なので窓は横へ広げない ⇒ 胴 ＋ 逃げ 0.5 だけ。
//   旧（サイド型）は 胴 8.6 ＋ 横向きの通り道 3.1 ＋ 逃げ 1.0 = 12.7 × 7.9（100.3mm²）。
//   いまは 胴 6.31 × 4.91 ＋ 逃げ 1.0 ＝ 7.31 × 5.91 で、これに板を右へ滑らせる 0.8 を X へ足して
//   **8.11 × 5.91（47.9mm²）**。面積で 52% 減。
