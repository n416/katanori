function pcb_part(nm) = [for (r = PCB_PARTS) if (r[0] == nm) r][0];
function pcb_mouth(nm) = let (q = pcb_part(nm), o = pcb_w(q), w = q[2] - q[1], d = q[4] - q[3], z = pcb_z0(q), n = pcb_path(q))
      (q[6] ==  3) ? [o[0] + w + n - 0.8, o[1] + d / 2, z + q[5] / 2]
    : (q[6] == -3) ? [o[0] - n + 0.8, o[1] + d / 2, z + q[5] / 2]
    : (q[6] ==  1) ? [o[0] + w / 2, o[1] + d + n - 0.8, z + q[5] / 2]
    : (q[6] == -1) ? [o[0] + w / 2, o[1] - n + 0.8, z + q[5] / 2]
    : (q[6] == -2) ? [o[0] + w / 2, o[1] + d / 2, z - n]              // 裏の縦の口は**下**へ（嵌合した先 ＝ 板の裏から 8.0）
    :                [o[0] + w / 2, o[1] + d / 2, z + q[5] + n];      // 表の縦の口は上へ
// スピーカー IN: ReSpeaker の J2 ソケット（PH・世界 79.44, 19.87, 24.50）→ J4（⭐ 2026-09-16 夕から**縦の口**・上から降ろす）
module w_spkin61() { j = j2_mouth(); m = pcb_mouth("J4  SPK IN");
    // ⭐ 2026-09-16 夕: J4 が縦になったので、横から寄せて**上から降ろす**形に引き直した。
    //   走る高さは「嵌合したプラグの頭（pcb_mouth が返す Z）の 2.0 上」。
    //   旧 zl = HUB_AT[2] + 1.6 + PCB_PLUG_H + 1.6 は横出しの背（4.8）を足していた数で、
    //   縦の胴（6.0）＋ 嵌合（＋2.0）より低く、プラグの頭を貫く
    zl = m[2] + 2.0;
    bnd([j + [0, 0.8, 0], j + [0, 3.0, 0], [80.5, 24.5, 24.495], [80.5, 24.5, zl], [80.5, m[1], zl],
         [m[0], m[1], zl], [m[0], m[1], m[2]]], 2, "spkin"); }
