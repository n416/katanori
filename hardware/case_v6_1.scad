RIB_LMIN = 4.0;   // 🔒 ユーザー 2026-09-05「v4 と同じ 8mm 未満ではなく 4mm 未満にしましょう」
include <parts/ribs_v61_gen.scad>   // RIB_SEGS（自動生成: python hardware/tools/ribs_gen61.py）
