    if (k == "rwall") translate([IN_X - b, -200, -200]) cube([b, 400, 400]);
    if (k == "hatch") translate([-200, IN_Y - b, -200]) cube([400, b, 400]);
    if (k == "front") translate([-200, FY_IN, -200]) cube([400, b, 400]);
