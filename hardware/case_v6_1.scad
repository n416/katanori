module hub_explode() {
    hub_body();
    translate([0, 0, EXP_KG[0]]) kguide();
    translate([0, 0, EXP_KG[1]]) kguide_screws(nut = false);
    translate([0, 0, EXP_KG[2]]) kguide_screws(screw = false);
