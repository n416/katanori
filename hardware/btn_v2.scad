use <parts.scad>   // 🔒 2026-08-29 `include <case_base.scad>` をやめた。`use` は**モジュールと関数しか
                   //   入れない**ので、筐体の変数（Z_TOP / IN_Z / BTN4 / RSP_*）が 1 つも入って来ない。
                   //   ここから借りるのは spk_obround() と msw_*()（DAOKAI の実測寸法）だけ。
// ============================================================
// 📦 btn_v2.scad — 会話ボタン v2（レバー式マイクロスイッチ・2026-08-29）
// ============================================================
// 🔒 これはユーザーの案である。「てこのついてるマイクロスイッチを外に出してカバーを作る方が
//    よっぽどキモチイイ」（2026-08-29）。v1（タクト）は 3 つの要求を全部外していた:
//    「押しても抜けなくて、押し心地の良い、抜けないボタン」。
//
// v1 が死んだ理由（記録・繰り返さないため）:
//   ・キャップが軸の上に浮いて乗るだけ ⇒ 抜ける／落ちる
//   ・傘の先と軸の頭が寸法上 0 で接する設計 ⇒ 遊びが作れない。しかもレジンはバネにならないので
//     隙間を空けてもガタになるだけだった（ユーザー指摘で撤回）
//   ・タクトのストロークが 0.5 しかない ⇒ 押し心地は原理的に作れない
//   ・受けの圧入・下から留める板・C 型クリップは、どれも上の問題の**対症**でしかなかった
//
// v2 が 3 つを満たす理屈:
//   ・**抜けない**: 押し子のツバが皿の床の裏に掛かる。表からは物理的に出られない
//   ・**落ちない**: 浮いている部品が 1 つも無い。レバー（30gf）が押し子をツバの座へ押し付け続ける
//   ・**押し心地**: クリックまで実測 2.5mm のスイングを、てこ比で押し子の 1.7mm に落として使う。
//     バネはレジンではなく**スイッチのレバー自身**。ここが v1 と決定的に違う
//
// 🔒 ユーザーの絶対条件 2 つ:
//   ①「絶対にネジを表面に出さないでください」⇒ 天面に出るのは皿と押し子の頭だけ。ねじは箱の中
//   ②「押し子の頭が AS5600 のつまみよりも高くなってはいけない」⇒ 頭は +3.0（つまみは +5.5）
//
// 刷る物は **押し子 1 点**だけ。井戸と皿は天板の一部。買い物 0（M2 とナットは手持ち）。
// ============================================================

// ---- 置き場所（BTN4 / ROW_Y）は**このファイルには無い** ----
//   🔒 2026-08-29 ユーザー「なんでボタンは独立させないんですか」。置き場所は筐体の都合なので
//   _v4_core.scad が持つ。ここが持つのは**ボタンそのものの形だけ**（原点＝ボタンの芯・z0＝天面）。

// ---- 端子の詰め（🔒 組み立ての手順。CAD もこの長さで持つ）----
// ✅ 2026-08-29 測定: 端子を図面どおり 3.5 のまま入れると、先が world Z 31.72 まで下りて
//    INA226 の板（天面 34.00）に 4.44mm³、留め帯（32.40）に 1.12mm³ 食い込む。
//    ⇒ **端子を胴の底から 1.0mm に詰める**（2.5 詰める）。先は 34.22 で、INA の板まで 0.22 空く。
//    ニッパーで詰めてから線を直はんだ。会話ボタンの 2 本は既に直はんだで確定している（B-8）。
B2_PIN_LEN = 1.0;

// ---- スイッチ（DAOKAI ヒンジストレートレバー 3PIN・寸法は parts.scad の MSW_*）----
//   ✅ 2026-08-29 商品ページの図面で確定: 胴 12.8 × 5.8 × 6.5 ／ レバー全長 13.5 ／
//      自由頂点 10.5±0.5 ／ ヒンジは C(COM) 端子の端 ／ 取付穴 φ2.0・φ2.2 が胴を横に貫通・穴間 6.5
//   🔴 取付穴の**高さ**（胴底からの Z）だけは図面から読み切れていない。ここでは 2.0 と置き、
//      井戸側の穴を縦 3.2 の長穴にして ±0.6 を吸収する。**Z を決めるのは穴ではなく下の棚**なので、
//      読みが外れても組める（ねじは横ずれ止めと落下止めであって、高さは持たない）。
//   🔴 case_base.scad は parts.scad を `use` で読むので **変数は来ない・関数だけ来る**。
//      だから寸法は msw_*() 関数で受ける（MSW_W などと書くと undef になる。1 度やった）
B2_SW  = msw_size();       // [12.8, 5.8, 6.5]
B2_SW_HOLE_Z   = 2.0;      // ⬜ 図面の読み。長穴で吸収する
B2_SW_HINGE_X  = -B2_SW[0] / 2;                  // ヒンジ（COM 端）= −X 側
function b2_lever_z(x) =                      // 自由状態のレバーの高さ（胴底から）。x は芯からの距離
    msw_bot_h() + (msw_act_h() - msw_bot_h()) * (x - B2_SW_HINGE_X) / msw_lever_l();

// ---- 押し子の押す点（てこ比を決める唯一のつまみ）----
// 🔴 ここを +X（先端）へ寄せるほどストロークは伸びるが、井戸が深くなる。逆は浅いが硬く短い。
//    ＋3.0 で「クリックまで押し子 1.74mm」＝ タクト（0.5）の 3.5 倍。深さは電池の天井の内側に収まる。
B2_PUSH_X = 3.0;
B2_PUSH_D = 4.0;                              // 押す柱の径
// 🔴 2026-08-29 最初これを高さ 0（＝ツバの下面がそのまま当たる）で書いた。**レバーは先端が一番高い**ので、
//   ツバは押す点ではなく先端に当たり、てこ比が効かない。柱を実体で下ろし、ツバは先端を跨いで逃げる。
//   ⇒ 井戸の深さを決めているのは押す点ではなく**レバーの先端**（どこを押しても −16 付近になる）。
B2_PAD_H  = 1.6;                              // 柱の出（先端 10.5 と押す点 9.28 の差 1.22 ＋ 逃げ 0.58）
B2_LEVER_RATIO = (B2_PUSH_X - B2_SW_HINGE_X) / msw_lever_l();
BTN2_CLICK  = msw_click() * B2_LEVER_RATIO;     // 押し子がクリックまで下がる量
BTN2_FULL   = msw_travel() * B2_LEVER_RATIO;  // 押し切りまで

// ---- 顔（v1 の皿と同じ。天面の見た目は変えない）----
B2_DISH_L = 19.2; B2_DISH_W = 13.2; B2_DISH_T = 2.25;      // 皿（v1 と同一）
B2_HEAD_L = 18.0; B2_HEAD_W = 12.0; B2_HEAD_OUT = 3.0;     // 押し子の頭（v1 のキャップと同一）
B2_PLATE_T = 3.0;   // 天板の厚み（外面から内面まで）。井戸の上端はここで止まる
B2_FLOOR_T = 1.6;                                     // 皿の床（＝ツバの座）
B2_TRAVEL  = 1.95;                                    // 頭が皿の床に着くまで＝ハードストップ
//   🔴 クリック 1.74 < ストップ 1.95。押し切りはレバーではなく**皿の床**が受ける（レバーを守る）
// 🔴 2026-08-29 首は**頭と同じ大きさである必要が無い**。口・ツバ・井戸は全部この首の寸法で決まり、
//   井戸が太ると ReSpeaker の押さえ（羊羹）に当たる（Y 16.4 のとき 65.24mm³ 食い込んだ）。
//   ⇒ 顔（頭 18 × 12）はそのままに、**首だけ Y を 7.2 に絞る**。井戸の外形が Y 12.0 になり羊羹を外れる。
//   🔴 2026-08-29 X も同じ理由で絞る。井戸が 22.4 だと、どの X に置いても INA の I2C ヘッダ
//     （world X 33〜36 付近・Z 34〜37）に 9〜15mm³ 残った。スイッチの胴 12.8 が入る最小まで詰める。
B2_OPN_L = 12.0; B2_OPN_W = 6.4;                     // 皿の床の口（首が通る）。頭 18 x 12 は変えない
B2_NECK_GAP = 0.2;
// 🔴 2026-08-29 ツバは「口より広ければよい」。大きくすると**ツバの部屋**が広がり、その部屋が
//   井戸の壁の上端を切って「支えの無い天井」を作る（刷る向きで 55mm² 出た）。
//   ⇒ 口 17.6 × 11.6 に対して片側 0.7 / 0.5 だけ張り出す最小寸法にする。
B2_FLG_L = B2_OPN_L + 1.0; B2_FLG_W = B2_OPN_W + 1.0; B2_FLG_T = 1.0;          // ツバ（口より広い＝上へ抜けない）

// ---- Z（原点 = 天板の外面）----
B2_Z_DISH_F = -B2_DISH_T;                    // -2.25 皿の床（上面）
B2_Z_FLOOR_B = B2_Z_DISH_F - B2_FLOOR_T;        // -3.85 皿の床の裏＝ツバの座
B2_Z_FLG_B  = B2_Z_FLOOR_B - B2_FLG_T;          // -5.05 ツバの下面
B2_Z_HEAD_B = B2_Z_DISH_F + B2_TRAVEL;          // -0.30 頭の下面（浮いている量がストロークそのもの）
B2_Z_SW_BOT = B2_Z_FLG_B - B2_PAD_H - b2_lever_z(B2_PUSH_X);   // 胴の底
B2_Z_SW_TOP = B2_Z_SW_BOT + B2_SW[2];

// ---- 井戸（天板の裏に立つ・4 枚の壁＋端の棚。床は張らない）----
B2_WELL_CL   = 0.1;                                   // 滑り嵌め（圧入しない。位置は棚とねじが出す）
// 中のりは**ツバが通る大きさ**（ツバの部屋を兼ねる）。スイッチの位置は棚ではなくねじが出す
// 🔴 X の中のりは**ツバではなくレバー**が決める。レバーは蝶番（胴の −X 端 −6.4）から 13.5 伸びて
//   先端が +7.1 に来る。胴 12.8 より外へ出るので、井戸は ±7.5 要る。
B2_WELL_IX = 15.0; B2_WELL_IY = B2_FLG_W + 0.6;
// 🔴 2026-08-29 ±Y の壁も厚くする。1.6 だと壁の上端がツバの部屋（幅 14.6）の**中**で終わり、
//   刷る向きで 52mm² の「支えの無い天井」になった。支柱は立てられない（ツバの通り道であり、
//   しかも井戸の中は狭くて切り取れない＝ v1 で天板を割った罠と同じ）。
//   ⇒ 壁を 4.5 にして井戸の外形を Y 15.0（±7.5）にする。部屋の外（±7.3）へ出るので床に直に届く。
B2_WELL_WALL = 1.6;     // ±Y の壁（M2 が通る側）
// 🔴 2026-08-29 ±X の端の壁は厚くする。理由は強度ではなく**繋ぎ**:
//   ツバの部屋（20.6 × 14.6）は井戸より広いので、井戸が細いと皿の床へ繋がる道が全部切り取られ、
//   床の縁が宙に浮く（刷る前の検査に 0.2mm の壁と島として出た）。端の壁を 4.7 にして
//   井戸の外形を X 22.4（±11.2）にすると、ツバの部屋の外（±10.3 より外）で床に直に届く。
B2_WELL_WALL_X = 1.6;
B2_SKIRT = 0.8;   // 胴の底より下へ伸ばす裾（端子と線の逃げ）
B2_WELL_OX = B2_WELL_IX + B2_WELL_WALL_X * 2;   // 22.4 井戸の外形 X（部屋 19.6 の外へ 1.4）
B2_WELL_OY = B2_WELL_IY + B2_WELL_WALL * 2;     // 15.0 同 Y（部屋 13.2 の外へ 0.9）
// 🔴 2026-08-29 棚は ±X の端に置いていたが、端子は芯から ±5.08 に立っていて**棚の真上**だった。
//   ⇒ 棚は**±Y の長辺**に付け替える。端子は Y ±0.4 しか使わないので、中央 2.2 を開ければ通る。
B2_LEDGE_Y   = 2.2;   // 中央に開ける帯（端子の道）。両脇 1.85 ずつが胴を受ける棚になる
B2_LEDGE_X   = 2.2;   // （旧・未使用）
B2_LEDGE_T   = 0.8;   // 🔴 2026-08-29 1.2 だと井戸の底が INA226 の板（世界 Z 34.00）に 0.38 沈んだ                                   // 端の棚（胴の底を受ける）。中央は端子のため開ける
B2_BTN2_SCR_D = 2.3;                                  // M2 の通し（長穴の幅）
B2_BTN2_SLOT_H = 3.2;                                 // 長穴の高さ（穴の Z の読みの ±0.6 を吸収）

module b2_ob(l, w, h) translate([-l / 2, -w / 2, 0]) spk_obround(l, w, h);

// ---- 天板に足す肉（皿の床とツバの座の増し肉＋井戸）----
module btn2_station_add() {
    translate([0, 0, B2_Z_FLOOR_B]) b2_ob(B2_WELL_OX + 1.4, B2_DISH_W, B2_FLOOR_T + 0.01);   // 皿の床の増し肉
    // 🔴 Y は**皿と同じ 13.2 が要る**。狭いと皿の床の縁の下が空になり、刷る向きで
    //   「支えの無い天井 16mm²」と「0.25mm の壁」になる（天板の残り 0.25 しか無い所ができる）。
    //   ⇒ 羊羹（ReSpeaker の押さえ・Y 〜10.535）に 0.335 だけ掛かる。🔒 ユーザー既決「羊羹を移動させる必要あり」
    btn2_well();                                                                  // 井戸（下で定義）
}
// 🔴 2026-08-29 井戸の中に「棚」や「底板」を作ってはいけない。刷る向き（天面が下）では、
//   世界の上を向く面はすべて印刷中の**天井**になる。棚は宙に浮き（島）、底板は 13mm の
//   ブリッジになる。しかも井戸の中は狭くて支柱を切り取れない ── v1 で天板を割った罠と同じ。
//   ⇒ **中は上から下まで同じ断面**にする。スイッチは自分の取付穴に通した M2 2 本だけで吊る。
//     （この穴は元々そのためにメーカーが開けている。図面 φ2.0/φ2.2・穴間 6.5）
//   ⬜ 残る 1 つの未確認: 取付穴の**高さ**（胴の底から）。図面から読み切れない。B2_SW_HOLE_Z に
//     2.0 と置き、井戸側を縦 3.2 の長穴にしてある。実物を 1 個測れば確定する。
module btn2_well() difference() {
    translate([-B2_WELL_OX / 2, -B2_WELL_OY / 2, B2_Z_SW_BOT - B2_SKIRT])
        cube([B2_WELL_OX, B2_WELL_OY, B2_Z_FLOOR_B - (B2_Z_SW_BOT - B2_SKIRT)]);
    translate([-B2_WELL_IX / 2, -B2_WELL_IY / 2, B2_Z_SW_BOT - B2_SKIRT - 1])
        cube([B2_WELL_IX, B2_WELL_IY, 30]);                                   // 中は同じ断面のまま下まで抜ける
    for (sx = [-1, 1]) translate([sx * msw_hole_p() / 2, 0, B2_Z_SW_BOT + B2_SW_HOLE_Z]) rotate([90, 0, 0]) hull()
        for (dz = [-1, 1]) translate([0, dz * (B2_BTN2_SLOT_H - B2_BTN2_SCR_D) / 2, -20]) cylinder(d = B2_BTN2_SCR_D, h = 40, $fn = 24);
}
// ---- 外の物のための逃げ: **無し**（2026-08-29）----
//   v1 は INA の線の溝と OLED の L の角落としを彫っていた。v2 は BTN4 を X 25 へ動かして
//   相手を丸ごと外したので、彫る物が 1 つも無い。**削って避けない。位置で避ける。**
// ---- 天板から抜く物（皿・縁の面取り・床の口・ツバの逃げ）----
module btn2_station_cut() {
    translate([0, 0, B2_Z_DISH_F]) b2_ob(B2_DISH_L, B2_DISH_W, B2_DISH_T + 1);                  // 皿
    translate([0, 0, -0.3]) hull() {                                              // 縁のベベル
        translate([0, 0, 0]) b2_ob(B2_DISH_L, B2_DISH_W, 0.01);
        translate([0, 0, 0.3]) b2_ob(B2_DISH_L + 0.6, B2_DISH_W + 0.6, 0.01);
    }
    translate([0, 0, B2_Z_FLOOR_B - 0.01]) b2_ob(B2_OPN_L, B2_OPN_W, B2_FLOOR_T + 0.02);         // 床の口（首の道）
    translate([-B2_WELL_IX / 2, -B2_WELL_IY / 2, B2_Z_FLG_B - B2_TRAVEL]) cube([B2_WELL_IX, B2_WELL_IY, B2_TRAVEL + B2_FLG_T + 0.01]);   // ツバの部屋（＝井戸の中と同じ断面）
}
// ---- 刷る部品: 押し子 ----
//   🔴 2026-08-29 ツバ（20 × 14）も INA226 の直立ての口に 4.79mm³ 乗っていた。天板だけ逃がしても
//     動く側が残っていては意味がない。**同じ逃げをツバにも掛ける**（相手は同じ world の物）。
module btn2_piston() difference() {
    color("#8fb4d9") {
        translate([0, 0, B2_Z_HEAD_B]) b2_ob(B2_HEAD_L, B2_HEAD_W, B2_HEAD_OUT - B2_Z_HEAD_B);      // 頭
        translate([0, 0, B2_Z_FLOOR_B]) b2_ob(B2_OPN_L - B2_NECK_GAP * 2, B2_OPN_W - B2_NECK_GAP * 2, B2_Z_HEAD_B - B2_Z_FLOOR_B + 0.02);   // +0.02 は頭と重ねるため（面で接すると manifold が 2 個に割る）  // 首
        translate([0, 0, B2_Z_FLG_B]) b2_ob(B2_FLG_L, B2_FLG_W, B2_FLG_T);                       // ツバ
        translate([B2_PUSH_X, 0, B2_Z_FLG_B - B2_PAD_H])                          // レバーを押す柱
            cylinder(d = B2_PUSH_D, h = B2_PAD_H + 0.01, $fn = 32);
    }
}
module btn2_switch(press = 0) translate([0, 0, B2_Z_SW_BOT]) difference() {
    microswitch_daokai(press);
    translate([-20, -20, -msw_pin_h() - 1]) cube([40, 40, msw_pin_h() - B2_PIN_LEN + 1]);   // 詰めた端子
}
// ---- ねじ（M2・頭は +Y・ナットは −Y の外＝羊羹の中）----
// 🔒 2026-08-29 ユーザー「なんでボタンは独立させないんですか？なんでボタンで explode したら case が
//   出てくるんだ」。**このファイルは world を 1 つも読まない。**BTN4 も IN_Z も RSP_* も出てこない。
//   外の物（羊羹）との接続は、下の 3 つの**関数で寸法を渡すだけ**にして、合わせるのは case_v4.scad の仕事。
// ✅ 測定で分かったこと: ドライバが入るのは **+Y 側だけ**（0.05mm³）。−Y は OLED 106・ReSpeaker 基板 12.2 で
//   完全に塞がっている（132.6）。⇒ **頭は +Y、ナットは −Y の外**。
// 🔒 ユーザー「ネジの長さは色々あるので」＝長さで設計を縛らない。要る掴みは下の echo が出す。
B2_HEAD_D = 3.8; B2_HEAD_T = 1.2;
module btn2_screws(nut_y = -10.0) for (sx = [-1, 1]) translate([sx * msw_hole_p() / 2, 0, B2_Z_SW_BOT + B2_SW_HOLE_Z]) {
    color("#b0b0b0") {
        translate([0, B2_WELL_OY / 2 + B2_HEAD_T, 0]) rotate([90, 0, 0]) cylinder(d = B2_HEAD_D, h = B2_HEAD_T, $fn = 24);   // 頭（+Y）
        translate([0, B2_WELL_OY / 2, 0]) rotate([90, 0, 0]) cylinder(d = 2.0, h = B2_WELL_OY / 2 - nut_y, $fn = 20);        // 軸
    }
}
module btn2_screw_cut() for (sx = [-1, 1]) translate([sx * msw_hole_p() / 2, 0, B2_Z_SW_BOT + B2_SW_HOLE_Z])
    translate([0, -20, 0]) rotate([-90, 0, 0]) cylinder(d = B2_BTN2_SCR_D, h = 40, $fn = 24);   // 通し（±Y 貫通）

// ---- 支柱の禁止区域（外から手が入らない所だけ。皿は入れない＝外から支柱を切れるので）----
module btn2_well_keepout() translate([-B2_WELL_IX / 2, -B2_WELL_IY / 2, B2_Z_SW_BOT - B2_SKIRT - 1])
    cube([B2_WELL_IX, B2_WELL_IY, B2_Z_FLOOR_B - (B2_Z_SW_BOT - B2_SKIRT) + 1]);

// ---- 刷る向き（押し子・頭を下にして皿の面をベッドへ）----
module btn2_piston_print() translate([0, 0, B2_HEAD_OUT]) rotate([180, 0, 0]) btn2_piston();

// ---- 外へ渡す寸法（case_v4.scad が羊羹を合わせるために読む。**逆向きの参照はしない**）----
function btn2_well_ox()  = B2_WELL_OX;                       // 18.2 バスタブの外形 X（＝羊羹の幅にする）
function btn2_well_oy()  = B2_WELL_OY;                       // 11.2 同 Y
function btn2_scr_x()    = msw_hole_p() / 2;                 // ±3.25 ねじの芯（ボタンの芯から）
function btn2_scr_z()    = B2_Z_SW_BOT + B2_SW_HOLE_Z;       // ねじの芯の Z（ボタンのローカル）
function btn2_well_z0()  = B2_Z_SW_BOT - B2_SKIRT;           // 井戸の底（同）
function btn2_floor_z()  = B2_Z_FLOOR_B;                     // 皿の床の裏（同）＝井戸の上端

// ---- 数字の申告（開くたびに出る）----
echo(str("btn_v2: クリックまで押し子 ", BTN2_CLICK, "mm（タクトは 0.5）／押し切り ", BTN2_FULL,
         "／ハードストップ ", B2_TRAVEL, " は皿の床／胴の底 Z ", B2_Z_SW_BOT, "（天面から）／端子の先 ",
         B2_Z_SW_BOT - msw_pin_h(), "／井戸の外形 ", B2_WELL_IX + B2_WELL_WALL * 2, " x ", B2_WELL_IY + B2_WELL_WALL * 2));
assert(BTN2_CLICK < B2_TRAVEL, "クリックより先に皿の床へ着いてしまう（押しても入らない）");
// ツバの +X の端（B2_FLG_L/2）でレバーとの隙間を見る（ツバは先端まで伸びていないので先端では見ない）
assert(B2_Z_FLG_B - (B2_Z_SW_BOT + b2_lever_z(B2_FLG_L / 2)) > 0.35, "ツバがレバーに当たる（柱の出 B2_PAD_H が足りない）");
assert(B2_HEAD_OUT < 5.5, "🔒 押し子の頭が AS5600 のつまみ（5.5）より高い");

// ---- 単体で開いたときの絵 ----
// 🔒 単体で開くと**ボタンだけ**が出る。筐体は 1 つも出ない（ユーザー「ボタンで explode したら
//   case が出てくるんだ」）。天板は、ボタンが乗る板の切れ端だけを絵として描く。
BTN2_SOLO = true;
B2_EX = 0;   // 0 = 組んだ姿 / 1 = 分解（-D B2_EX=1）
module btn2_solo() {
    color("#c9d0d8") difference() {   // 天板の切れ端（絵のためだけ・部品ではない）
        union() { translate([0, 0, -B2_PLATE_T]) b2_ob(B2_WELL_OX + 8, B2_DISH_W + 6, B2_PLATE_T); btn2_station_add(); }
        btn2_station_cut(); btn2_screw_cut();
    }
    translate([0, 0, -B2_EX * 7]) btn2_piston();
    translate([0, 0, -B2_EX * 17]) btn2_switch();
    translate([0, B2_EX * 12, 0]) btn2_screws();
}
if (BTN2_SOLO) btn2_solo();
