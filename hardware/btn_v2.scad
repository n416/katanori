use <parts.scad>   // 🔒 2026-08-29 `include <case_base.scad>` をやめた。`use` は**モジュールと関数しか
                   //   入れない**ので、筐体の変数（Z_TOP / IN_Z / BTN4 / RSP_*）が 1 つも入って来ない。
                   //   ここから借りるのは spk_obround() と msw_*()（DAOKAI の実測寸法）だけ。
// ============================================================
// 📦 btn_v2.scad — 会話ボタン v2（レバー式マイクロスイッチ・2026-08-29）
// ============================================================
// 🔒 これはユーザーの案である。「てこのついてるマイクロスイッチを外に出してカバーを作る方が
//    よっぽどキモチイイ」（2026-08-29）。v1（タクト）は 3 つの要求を全部外していた:
//    「押しても抜けなくて、押し心地の良い、抜けないボタン」。
//
// v1 が死んだ理由（記録・繰り返さないため）:
//   ・キャップが軸の上に浮いて乗るだけ ⇒ 抜ける／落ちる
//   ・傘の先と軸の頭が寸法上 0 で接する設計 ⇒ 遊びが作れない。しかもレジンはバネにならないので
//     隙間を空けてもガタになるだけだった（ユーザー指摘で撤回）
//   ・タクトのストロークが 0.5 しかない ⇒ 押し心地は原理的に作れない
//   ・受けの圧入・下から留める板・C 型クリップは、どれも上の問題の**対症**でしかなかった
//
// v2 が 3 つを満たす理屈:
//   ・**抜けない**: 押し子のツバが皿の床の裏に掛かる。表からは物理的に出られない
//   ・**落ちない**: 浮いている部品が 1 つも無い。レバー（30gf）が押し子をツバの座へ押し付け続ける
//   ・**押し心地**: クリックまで実測 2.5mm のスイングを、てこ比で押し子の 1.7mm に落として使う。
//     バネはレジンではなく**スイッチのレバー自身**。ここが v1 と決定的に違う
//
// 🔒 ユーザーの絶対条件 2 つ:
//   ①「絶対にネジを表面に出さないでください」⇒ 天面に出るのは皿と押し子の頭だけ。ねじは箱の中
//   ②「押し子の頭が AS5600 のつまみよりも高くなってはいけない」⇒ 頭は +3.0（つまみは +5.5）
//
// 刷る物は **押し子 1 点**だけ。バスタブと皿は天板の一部。買い物 0（M2 とナットは手持ち）。
// ============================================================

// ---- 置き場所（BTN4 / ROW_Y）は**このファイルには無い** ----
//   🔒 2026-08-29 ユーザー「なんでボタンは独立させないんですか」。置き場所は筐体の都合なので
//   _v4_core.scad が持つ。ここが持つのは**ボタンそのものの形だけ**（原点＝ボタンの芯・z0＝天面）。

// ---- 端子の長さ（🔒 CAD はこの長さで持つ）----
// ⚠ 2026-08-29（午前）: 端子を図面どおり 3.5 のまま入れると先が world Z 31.72 まで下り、
//    INA226 の板（天面 34.00）に 4.44mm³、留め帯（32.40）に 1.12mm³ 食い込むので **1.0 に詰める**
//    という手順を置いていた。
// ✅ 2026-08-29（同日・ユーザー「B2_PIN_LEN を戻しましょう」）**詰めるのをやめた。**
//    INA226 を PowerBoost の下へ +3.0 潜らせた（_v4_core.scad の INA_DY）ので、端子の真下から
//    板も帯も退いた。3.5 のままで INA・帯・電池・ブリッジすべてに当たり 0。
//    ⇒ **ニッパーで詰める工程は無し。**そのまま線を直はんだする（B-8）。
B2_PIN_LEN = 3.5;

// ---- スイッチ（DAOKAI ヒンジストレートレバー 3PIN・寸法は parts.scad の MSW_*）----
//   ✅ 2026-08-29 商品ページの図面で確定: 胴 12.8 × 5.8 × 6.5 ／ レバー全長 13.5 ／
//      自由頂点 10.5±0.5 ／ ヒンジは C(COM) 端子の端 ／ 取付穴 φ2.0・φ2.2 が胴を横に貫通・穴間 6.5
//   🔴 取付穴の**高さ**（胴底からの Z）だけは図面から読み切れていない。ここでは 2.0 と置き、
//      バスタブ側の穴を縦 3.2 の長穴にして ±0.6 を吸収する。**Z を決めるのは穴ではなく下の棚**なので、
//      読みが外れても組める（ねじは横ずれ止めと落下止めであって、高さは持たない）。
//   🔴 case_base.scad は parts.scad を `use` で読むので **変数は来ない・関数だけ来る**。
//      だから寸法は msw_*() 関数で受ける（MSW_W などと書くと undef になる。1 度やった）
B2_SW  = msw_size();       // [12.8, 5.8, 6.5]
B2_SW_HOLE_Z   = 2.0;      // ✅ **確定**（胴の底から取付穴の芯）。2026-08-29 ユーザー実測「2mm ですよ」
//   🔴 2026-08-29 AI はここで一度 4.5 に書き換えた。「ナットが収まるには 3.59 以上」と**計算した直後に**
//     図面の読み方を変えている。順序が逆で、自分の設計が通る方へ読み替えた（ユーザー「希望的なデータの
//     出し方をしていませんか？」で発覚）。図の C / NC の穴は胴の**下寄り**（端子のすぐ上）に描かれていて、
//     全高 6.5 の中では底から 2.0 に見える。⇒ **読みは 2.0 に戻す。実物をノギスで測るまで確定しない。**
//   ⇒ M2 ナット（半分 2.3）は Z 34.92〜39.52 に来る。羊羹の底は 36.207 なので**羊羹には入らない**。
//     🔒 ユーザー「羊羹と分離しましょう」⇒ ナットは**ボタン自身の −Y の壁**が持つ。壁はバスタブの底
//     （Z 34.4）から立っているので、ナットの下にも肉がある。羊羹に頼らない＝ボタンは独立のまま。
B2_SW_HINGE_X  = -B2_SW[0] / 2;                  // ヒンジ（COM 端）= −X 側
function b2_lever_z(x) =                      // 自由状態のレバーの高さ（胴底から）。x は芯からの距離
    msw_bot_h() + (msw_act_h() - msw_bot_h()) * (x - B2_SW_HINGE_X) / msw_lever_l();

// ---- 押し子の押す点（てこ比を決める唯一のつまみ）----
// 🔴 ここを +X（先端）へ寄せるほどストロークは伸びるが、バスタブが深くなる。逆は浅いが硬く短い。
//    ＋3.0 で「クリックまで押し子 1.74mm」＝ タクト（0.5）の 3.5 倍。深さは電池の天井の内側に収まる。
B2_PUSH_X = 3.0;
B2_PUSH_D = 4.0;                              // 押す柱の径
// 🔴 2026-08-29 最初これを高さ 0（＝ツバの下面がそのまま当たる）で書いた。**レバーは先端が一番高い**ので、
//   ツバは押す点ではなく先端に当たり、てこ比が効かない。柱を実体で下ろし、ツバは先端を跨いで逃げる。
//   ⇒ バスタブの深さを決めているのは押す点ではなく**レバーの先端**（どこを押しても −16 付近になる）。
B2_PAD_H  = 1.6;                              // 柱の出（先端 10.5 と押す点 9.28 の差 1.22 ＋ 逃げ 0.58）
B2_LEVER_RATIO = (B2_PUSH_X - B2_SW_HINGE_X) / msw_lever_l();
BTN2_CLICK  = msw_click() * B2_LEVER_RATIO;     // 押し子がクリックまで下がる量
BTN2_FULL   = msw_travel() * B2_LEVER_RATIO;  // 押し切りまで

// ---- 顔（v1 の皿と同じ。天面の見た目は変えない）----
B2_DISH_L = 19.2; B2_DISH_W = 13.2; B2_DISH_T = 2.25;      // 皿（v1 と同一）
B2_HEAD_L = 18.0; B2_HEAD_W = 12.0; B2_HEAD_OUT = 3.0;     // 押し子の頭（v1 のキャップと同一）
B2_PLATE_T = 2.5;   // 天板の厚み（外面から内面まで）。バスタブの上端はここで止まる
//   🔴 2026-08-29 ここは長らく 3.0 だったが、実際の天板は case_base.scad の TOP_T = **2.5**。
//     付け根の丸み（btn2_root）をこの値で天井に合わせたので、丸みが天井の 0.5mm 下で終わり、
//     刷る前の検算に **34.19mm² の 0.021〜0.220mm の膜**として出た。
B2_FLOOR_T = 1.6;                                     // 皿の床（＝ツバの座）
B2_TRAVEL  = 1.95;                                    // 頭が皿の床に着くまで＝ハードストップ
//   🔴 クリック 1.74 < ストップ 1.95。押し切りはレバーではなく**皿の床**が受ける（レバーを守る）
// 🔴 2026-08-29 首は**頭と同じ大きさである必要が無い**。口・ツバ・バスタブは全部この首の寸法で決まり、
//   バスタブが太ると ReSpeaker の押さえ（羊羹）に当たる（Y 16.4 のとき 65.24mm³ 食い込んだ）。
//   ⇒ 顔（頭 18 × 12）はそのままに、**首だけ Y を 7.2 に絞る**。バスタブの外形が Y 12.0 になり羊羹を外れる。
//   🔴 2026-08-29 X も同じ理由で絞る。バスタブが 22.4 だと、どの X に置いても INA の I2C ヘッダ
//     （world X 33〜36 付近・Z 34〜37）に 9〜15mm³ 残った。スイッチの胴 12.8 が入る最小まで詰める。
B2_OPN_L = 12.0; B2_OPN_W = 6.4;                     // 皿の床の口（首が通る）。頭 18 x 12 は変えない
B2_NECK_GAP = 0.2;
// 🔴 2026-08-29 ツバは「口より広ければよい」。大きくすると**ツバの部屋**が広がり、その部屋が
//   バスタブの壁の上端を切って「支えの無い天井」を作る（刷る向きで 55mm² 出た）。
//   ⇒ 口 17.6 × 11.6 に対して片側 0.7 / 0.5 だけ張り出す最小寸法にする。
B2_FLG_L = B2_OPN_L + 1.0; B2_FLG_W = B2_OPN_W + 1.0; B2_FLG_T = 1.0;          // ツバ（口より広い＝上へ抜けない）

// ---- Z（原点 = 天板の外面）----
B2_Z_DISH_F = -B2_DISH_T;                    // -2.25 皿の床（上面）
B2_Z_FLOOR_B = B2_Z_DISH_F - B2_FLOOR_T;        // -3.85 皿の床の裏＝ツバの座
B2_Z_FLG_B  = B2_Z_FLOOR_B - B2_FLG_T;          // -5.05 ツバの下面
B2_Z_HEAD_B = B2_Z_DISH_F + B2_TRAVEL;          // -0.30 頭の下面（浮いている量がストロークそのもの）
B2_Z_SW_BOT = B2_Z_FLG_B - B2_PAD_H - b2_lever_z(B2_PUSH_X);   // 胴の底
B2_Z_SW_TOP = B2_Z_SW_BOT + B2_SW[2];

// ---- バスタブ（天板の裏に立つ・4 枚の壁＋端の棚。床は張らない）----
B2_TUB_CL   = 0.1;                                   // 滑り嵌め（圧入しない。位置は棚とねじが出す）
// 中のりは**ツバが通る大きさ**（ツバの部屋を兼ねる）。スイッチの位置は棚ではなくねじが出す
// 🔴 X の中のりは**ツバではなくレバー**が決める。レバーは蝶番（胴の −X 端 −6.4）から 13.5 伸びて
//   先端が +7.1 に来る。胴 12.8 より外へ出るので、バスタブは ±7.5 要る。
B2_TUB_IX = 15.0; B2_TUB_IY = B2_FLG_W + 0.6;
// 🔴 2026-08-29 ±Y の壁も厚くする。1.6 だと壁の上端がツバの部屋（幅 14.6）の**中**で終わり、
//   刷る向きで 52mm² の「支えの無い天井」になった。支柱は立てられない（ツバの通り道であり、
//   しかもバスタブの中は狭くて切り取れない＝ v1 で天板を割った罠と同じ）。
//   ⇒ 壁を 4.5 にしてバスタブの外形を Y 15.0（±7.5）にする。部屋の外（±7.3）へ出るので床に直に届く。
B2_TUB_WALL = 1.6;     // +Y と ±X の壁
// 🔒 2026-08-29 ユーザー「ネジ、OLED 側から背面に向けてネジを入れる方が良いと思いますけど」。
//   ⇒ **頭は −Y（OLED 側）、ナットは +Y（背面）**。+Y は何も無いので、ナットを差す道も空いている。
//   （一度 −Y にナットを置いたが、羊羹が前に立っていてナットを入れる道が塞がっていた。
//     ユーザー「そんなところに置いたらナット入れられない」で気付いた。）
//   +Y の壁だけ厚くして座にする: ナット 1.6 ＋ 床 0.6 ＝ 2.2。締めるとナットは −Y（頭の方）へ
//   引かれるので、床は −Y 側＝バスタブの中側に要る。座は +Y の外から差す。
B2_TUB_WALL_YP = 2.2;  // +Y の壁（ナット 1.6 ＋ 床 0.6）
B2_NUT_T   = 1.6;       // M2 ナットの厚み（座の深さ）
B2_NUT_AF  = 4.0;       // 同 二面幅
// 🔴 2026-08-29 ±X の端の壁は厚くする。理由は強度ではなく**繋ぎ**:
//   ツバの部屋（20.6 × 14.6）はバスタブより広いので、バスタブが細いと皿の床へ繋がる道が全部切り取られ、
//   床の縁が宙に浮く（刷る前の検査に 0.2mm の壁と島として出た）。端の壁を 4.7 にして
//   バスタブの外形を X 22.4（±11.2）にすると、ツバの部屋の外（±10.3 より外）で床に直に届く。
B2_TUB_WALL_X = 1.6;
B2_SKIRT = 0.8;   // 胴の底より下へ伸ばす裾（端子と線の逃げ）
B2_TUB_OX = B2_TUB_IX + B2_TUB_WALL_X * 2;   // 22.4 バスタブの外形 X（部屋 19.6 の外へ 1.4）
B2_TUB_Y0 = -(B2_TUB_IY / 2 + B2_TUB_WALL);      // −Y の外面（local・頭の側）
B2_TUB_Y1 =   B2_TUB_IY / 2 + B2_TUB_WALL_YP;    // +Y の外面（local・ナットの側）
B2_TUB_OY = B2_TUB_Y1 - B2_TUB_Y0;               // 外形 Y
// 🔴 2026-08-29 棚は ±X の端に置いていたが、端子は芯から ±5.08 に立っていて**棚の真上**だった。
//   ⇒ 棚は**±Y の長辺**に付け替える。端子は Y ±0.4 しか使わないので、中央 2.2 を開ければ通る。
B2_LEDGE_Y   = 2.2;   // 中央に開ける帯（端子の道）。両脇 1.85 ずつが胴を受ける棚になる
B2_LEDGE_X   = 2.2;   // （旧・未使用）
B2_LEDGE_T   = 0.8;   // 🔴 2026-08-29 1.2 だとバスタブの底が INA226 の板（世界 Z 34.00）に 0.38 沈んだ                                   // 端の棚（胴の底を受ける）。中央は端子のため開ける
B2_BTN2_SCR_D = 2.3;                                  // M2 の通し（長穴の幅）
B2_BTN2_SLOT_H = 3.2;                                 // 長穴の高さ（穴の Z の読みの ±0.6 を吸収）

module b2_ob(l, w, h) translate([-l / 2, -w / 2, 0]) spk_obround(l, w, h);

// ---- 天板に足す肉（皿の床＋バスタブを **1 つの塊**として作る）----
// 🔒 2026-08-29 ユーザー「3D プリンタなのにこんな接着みたいな作りにしないといけない理由はなんですか？」
//   ⇒ 理由は無い。**私が積み木で作っていた**だけ。皿の床の板を置き、その下にバスタブの箱を置いて、
//     たまたま触っている形だったので、バスタブの四隅が板の外に出て「点留め」になっていた。
//   ⇒ 皿の床とバスタブを **1 つの union の塊**にして、そこから穴を彫る。皿の床は角丸の四角にして
//     バスタブの四隅を全部覆う（小判形だと端が細って隅が外に出る＝点留めになる）。
//   🔴 2026-08-29 前のセッションはここの hull（末広がり）を「理由が無かった」として段に戻した。
//     根拠にした「斜めにカットされてネジ入らなそう」は、実際は**天板とフロントの継ぎ目 45°**が
//     この塊を斜めに削っていたもので、テーパーのせいではなかった（継ぎ目は case_v4.scad 側で直した）。
//     段に戻したのはデグレ。ユーザー「前はこんな感じでした」で末広がりに戻す。
B2_PAD_R = 2.5;   // 皿の床の角丸
// ---- 皿の床 → バスタブ（全高でひと続きの末広がり）----
// 🔒 2026-08-29 ユーザー「滑らかな形状にしてください」「前はこんな感じでした」（＝天板の裏から
//   全高で末広がりに広がる塊・角は丸・付け根に丸み）。段で積むのも、上端だけくびれさせるのも違う。
//   ⇒ 皿の床の断面（角丸 19.6 × 13.2）から、バスタブの底の断面（角丸 18.2 × 11.8）まで
//     **1 つの hull** で繋ぐ。刷る向きでは天板が下・バスタブが上なので、上へ行くほど細る＝庇は出ない。
//   ⚠ 壁が傾くぶん、ねじの頭が座る面が平らでなくなる。頭の側（−Y）だけざぐりで平らな座を出す
//     （ナットの側は座そのものが彫った面なので元から平ら）。B2_SEAT_HN を参照。
B2_TUB_R = 1.6;   // バスタブの外側の角の丸み。壁の厚み 1.6 と同じにすると中の角から等厚になる
B2_ROOT_R = 0.8;  // 天板の裏との付け根の丸み（皿の床が天板から出ている 0.85 に収まる大きさ）
function b2_pad_l() = B2_TUB_OX + 1.4;
function b2_tub_cy() = (B2_TUB_Y0 + B2_TUB_Y1) / 2;   // バスタブは +Y の壁が厚いぶん芯がずれている
module b2_rr(l, w, r, cy) translate([0, cy]) offset(r = r, $fn = 48) square([l - 2 * r, w - 2 * r], center = true);
module btn2_pad_2d() b2_rr(b2_pad_l(), B2_DISH_W, B2_PAD_R, 0);
module btn2_tub_2d() b2_rr(B2_TUB_OX, B2_TUB_OY, B2_TUB_R, b2_tub_cy());
// 付け根の丸み: 天板の裏（Z = −B2_PLATE_T）に接し、その B2_ROOT_R 下で塊の側面に接する 1/4 円
B2_ROOT_N = 8;
module btn2_root() for (i = [0 : B2_ROOT_N - 1]) hull() for (j = [i, i + 1])
    let (d = j / B2_ROOT_N * B2_ROOT_R)
        translate([0, 0, -B2_PLATE_T - B2_ROOT_R + d]) linear_extrude(0.02)
            offset(r = B2_ROOT_R - sqrt(B2_ROOT_R * B2_ROOT_R - d * d), $fn = 32) btn2_pad_2d();
module btn2_station_add() difference() {
    union() {
        translate([0, 0, B2_Z_FLOOR_B]) linear_extrude(B2_FLOOR_T + 0.01) btn2_pad_2d();   // 皿の床
        btn2_root();                                                                        // 付け根の丸み
        hull() {                                                                            // 末広がりの塊
            translate([0, 0, B2_Z_FLOOR_B])                  linear_extrude(0.02) btn2_pad_2d();
            translate([0, 0, B2_Z_SW_BOT - B2_SKIRT])        linear_extrude(0.02) btn2_tub_2d();
        }
    }
    // 🔴 中の空洞は**皿の床の裏（B2_Z_FLOOR_B）で止める**。塊ごと突き抜けさせるとツバの座を食い、
    //   天板の残り 0.25mm だけになる（刷る前の検査に 45.56mm² の 0.25 板として出た）。
    translate([-B2_TUB_IX / 2, -B2_TUB_IY / 2, B2_Z_SW_BOT - B2_SKIRT - 1])
        cube([B2_TUB_IX, B2_TUB_IY, B2_Z_FLOOR_B - (B2_Z_SW_BOT - B2_SKIRT) + 1]);           // 上から下まで同じ断面
    btn2_nut_seat();   // ナットの座と M2 の通し
}
// ---- ナットの座（−Y の壁の中・前から差す）と M2 の通し ----
// 🔴 2026-08-29 ユーザー「explode 見たときに斜めにカットされてネジ入らなそうになってるのは何故ですか」。
//   塊を hull で作った副作用で ±Y の壁が 4.5° 傾いており、**頭とナットが座る平らな面が無かった**。
//   ⇒ ねじの軸に直角なざぐりを掘って、平らな座を出す（肉を足さないので刷る向きの庇も増えない）。
B2_SEAT_D  = 4.6;   // 座の径（頭 3.8・ナットの対角 4.62 が収まる）
B2_SEAT_HN = 0.6;   // 頭の側（−Y）。壁が 4.5° 傾くので座の径 4.6 で 0.36 の段差が出る。それを飲む深さ
B2_SEAT_HP = 0;     // ナットの側（+Y）は六角のポケットの底そのものが平らな面なので不要
module btn2_nut_seat() for (sx = [-1, 1]) translate([sx * msw_hole_p() / 2, 0, B2_Z_SW_BOT + B2_SW_HOLE_Z]) {
    translate([0, -20, 0]) rotate([-90, 0, 0]) cylinder(d = B2_BTN2_SCR_D, h = 40, $fn = 24);                 // 通し（±Y 貫通）
    // 頭が座る平らな面（−Y）。壁が末広がりで傾いているので、ねじの軸に直角なざぐりで平面を出す
    if (B2_SEAT_HN > 0) translate([0, B2_TUB_Y0 + B2_SEAT_HN, 0]) rotate([90, 0, 0])
        cylinder(d = B2_SEAT_D, h = 4, $fn = 32);

    translate([0, B2_TUB_Y1 - B2_SEAT_HP - B2_NUT_T, 0]) rotate([-90, 0, 0])
        cylinder(d = B2_NUT_AF / cos(30) + 0.3, h = B2_NUT_T + 1.0, $fn = 6);                                // 六角の座（+Y の壁）
    //   🔴 2026-08-29 抜ける量は 0.15 では足りなかった。壁を末広がりにしたので、ねじの高さでの
    //     外面が Y 23.656（world）まで来て、ポケットの終わり 23.65 が **0.006mm 手前**で止まり、
    //     0.005mm の膜が 2 つ残った（刷る前の検算で発見）。壁の外は空なので深くしても害は無い。
    // 🔴 2026-08-29 ここに「差し込む道」の角柱（4.3 × 4.3 × 4.75）を足していた。**要らない。**
    //   六角のポケットそのものが +Y に開いた口なので、ナットはそのまま押し込める。角柱があると
    //   壁（2.2）を突き抜けて 4.3 角の窓が 2 つ開き、**壁がほとんど無くなり、ナットの床も 0.45 しか
    //   残らなかった**（ユーザー「ここがブーリアンで削り取られてるよね？」）。削除。
}
// ⚠ btn2_tub() は廃止（塊の中に溶けた）。単体の絵は btn2_station_add() を呼ぶ

// ---- 外の物のための逃げ: **無し**（2026-08-29）----
//   v1 は INA の線の溝と OLED の L の角落としを彫っていた。v2 は BTN4 を X 25 へ動かして
//   相手を丸ごと外したので、彫る物が 1 つも無い。**削って避けない。位置で避ける。**
// ---- 天板から抜く物（皿・縁の面取り・床の口・ツバの逃げ）----
module btn2_station_cut() {
    translate([0, 0, B2_Z_DISH_F]) b2_ob(B2_DISH_L, B2_DISH_W, B2_DISH_T + 1);                  // 皿
    translate([0, 0, -0.3]) hull() {                                              // 縁のベベル
        translate([0, 0, 0]) b2_ob(B2_DISH_L, B2_DISH_W, 0.01);
        translate([0, 0, 0.3]) b2_ob(B2_DISH_L + 0.6, B2_DISH_W + 0.6, 0.01);
    }
    translate([0, 0, B2_Z_FLOOR_B - 0.01]) b2_ob(B2_OPN_L, B2_OPN_W, B2_FLOOR_T + 0.02);         // 床の口（首の道）
    translate([-B2_TUB_IX / 2, -B2_TUB_IY / 2, B2_Z_FLG_B - B2_TRAVEL]) cube([B2_TUB_IX, B2_TUB_IY, B2_TRAVEL + B2_FLG_T + 0.01]);   // ツバの部屋（＝バスタブの中と同じ断面）
}
// ---- 刷る部品: 押し子 ----
//   🔴 2026-08-29 ツバ（20 × 14）も INA226 の直立ての口に 4.79mm³ 乗っていた。天板だけ逃がしても
//     動く側が残っていては意味がない。**同じ逃げをツバにも掛ける**（相手は同じ world の物）。
module btn2_piston() difference() {
    color("#8fb4d9") {
        translate([0, 0, B2_Z_HEAD_B]) b2_ob(B2_HEAD_L, B2_HEAD_W, B2_HEAD_OUT - B2_Z_HEAD_B);      // 頭
        translate([0, 0, B2_Z_FLOOR_B]) b2_ob(B2_OPN_L - B2_NECK_GAP * 2, B2_OPN_W - B2_NECK_GAP * 2, B2_Z_HEAD_B - B2_Z_FLOOR_B + 0.02);   // +0.02 は頭と重ねるため（面で接すると manifold が 2 個に割る）  // 首
        translate([0, 0, B2_Z_FLG_B]) b2_ob(B2_FLG_L, B2_FLG_W, B2_FLG_T);                       // ツバ
        translate([B2_PUSH_X, 0, B2_Z_FLG_B - B2_PAD_H])                          // レバーを押す柱
            cylinder(d = B2_PUSH_D, h = B2_PAD_H + 0.01, $fn = 32);
    }
}
module btn2_switch(press = 0) translate([0, 0, B2_Z_SW_BOT]) difference() {
    microswitch_daokai(press);
    translate([-20, -20, -msw_pin_h() - 1]) cube([40, 40, msw_pin_h() - B2_PIN_LEN + 1]);   // 詰めた端子
}
// ---- ねじ（M2・頭は +Y・ナットは −Y の外＝羊羹の中）----
// 🔒 2026-08-29 ユーザー「なんでボタンは独立させないんですか？なんでボタンで explode したら case が
//   出てくるんだ」。**このファイルは world を 1 つも読まない。**BTN4 も IN_Z も RSP_* も出てこない。
//   外の物（羊羹）との接続は、下の 3 つの**関数で寸法を渡すだけ**にして、合わせるのは case_v4.scad の仕事。
// ✅ 測定で分かったこと: ドライバが入るのは **+Y 側だけ**（0.05mm³）。−Y は OLED 106・ReSpeaker 基板 12.2 で
//   完全に塞がっている（132.6）。⇒ **頭は +Y、ナットは −Y の外**。
// 🔒 ユーザー「ネジの長さは色々あるので」＝長さで設計を縛らない。要る掴みは下の echo が出す。
B2_HEAD_D = 3.8; B2_HEAD_T = 1.2;
module btn2_screws(nut_y = 0) for (sx = [-1, 1]) translate([sx * msw_hole_p() / 2, 0, B2_Z_SW_BOT + B2_SW_HOLE_Z]) {
    color("#b0b0b0") {
        translate([0, B2_TUB_Y0 + B2_SEAT_HN - B2_HEAD_T, 0]) rotate([-90, 0, 0]) cylinder(d = B2_HEAD_D, h = B2_HEAD_T, $fn = 24);   // 頭（−Y・OLED 側・ざぐりの底に座る）
        translate([0, B2_TUB_Y0 + B2_SEAT_HN, 0]) rotate([-90, 0, 0]) cylinder(d = 2.0, h = (B2_TUB_Y1 - B2_SEAT_HP) - (B2_TUB_Y0 + B2_SEAT_HN), $fn = 20);   // 軸
    }
    color("#8a8a8a") translate([0, B2_TUB_Y1 - B2_SEAT_HP - B2_NUT_T, 0]) rotate([-90, 0, 0])
        cylinder(d = B2_NUT_AF / cos(30), h = B2_NUT_T, $fn = 6);                                                      // ナット（+Y の壁の中）
}
module btn2_screw_cut() { }   // ⚠ 通しとナットの座は塊から btn2_nut_seat() が直接彫る。case 側の仕事は無い

// ---- 支柱の禁止区域（外から手が入らない所だけ。皿は入れない＝外から支柱を切れるので）----
module btn2_tub_keepout() translate([-B2_TUB_IX / 2, -B2_TUB_IY / 2, B2_Z_SW_BOT - B2_SKIRT - 1])
    cube([B2_TUB_IX, B2_TUB_IY, B2_Z_FLOOR_B - (B2_Z_SW_BOT - B2_SKIRT) + 1]);

// ---- 刷る向き（押し子・頭を下にして皿の面をベッドへ）----
module btn2_piston_print() translate([0, 0, B2_HEAD_OUT]) rotate([180, 0, 0]) btn2_piston();

// ---- 外へ渡す寸法（case_v4.scad が羊羹を合わせるために読む。**逆向きの参照はしない**）----
function btn2_tub_ox()  = B2_TUB_OX;                       // 18.2 バスタブの外形 X（＝羊羹の幅にする）
function btn2_tub_oy()  = B2_TUB_OY;
function btn2_tub_y0()  = B2_TUB_Y0;                       // −Y の外面（local）                       // 11.2 同 Y
function btn2_scr_x()    = msw_hole_p() / 2;                 // ±3.25 ねじの芯（ボタンの芯から）
function btn2_scr_z()    = B2_Z_SW_BOT + B2_SW_HOLE_Z;       // ねじの芯の Z（ボタンのローカル）
function btn2_tub_z0()  = B2_Z_SW_BOT - B2_SKIRT;           // バスタブの底（同）
function btn2_floor_z()  = B2_Z_FLOOR_B;                     // 皿の床の裏（同）＝バスタブの上端

// ---- 数字の申告（開くたびに出る）----
echo(str("btn_v2: クリックまで押し子 ", BTN2_CLICK, "mm（タクトは 0.5）／押し切り ", BTN2_FULL,
         "／ハードストップ ", B2_TRAVEL, " は皿の床／胴の底 Z ", B2_Z_SW_BOT, "（天面から）／端子の先 ",
         B2_Z_SW_BOT - msw_pin_h(), "／バスタブの外形 ", B2_TUB_OX, " x ", B2_TUB_OY))   // 🔴 2026-08-29 ここは IY + WALL*2 = 11.2 と出していたが、+Y の壁だけ 2.2 なので実際は 11.8。OX/OY を使う;
assert(BTN2_CLICK < B2_TRAVEL, "クリックより先に皿の床へ着いてしまう（押しても入らない）");
// ツバの +X の端（B2_FLG_L/2）でレバーとの隙間を見る（ツバは先端まで伸びていないので先端では見ない）
assert(B2_Z_FLG_B - (B2_Z_SW_BOT + b2_lever_z(B2_FLG_L / 2)) > 0.35, "ツバがレバーに当たる（柱の出 B2_PAD_H が足りない）");
assert(B2_HEAD_OUT < 5.5, "🔒 押し子の頭が AS5600 のつまみ（5.5）より高い");

// ---- 単体で開いたときの絵 ----
// 🔒 単体で開くと**ボタンだけ**が出る。筐体は 1 つも出ない（ユーザー「ボタンで explode したら
//   case が出てくるんだ」）。天板は、ボタンが乗る板の切れ端だけを絵として描く。
BTN2_SOLO = true;
B2_EX = 0;   // 0 = 組んだ姿 / 1 = 分解（-D B2_EX=1）
module btn2_solo() {
    color("#c9d0d8") difference() {   // 天板の切れ端（絵のためだけ・部品ではない）
        union() { translate([0, 0, -B2_PLATE_T]) b2_ob(B2_TUB_OX + 8, B2_DISH_W + 6, B2_PLATE_T); btn2_station_add(); }
        btn2_station_cut(); btn2_screw_cut();
    }
    translate([0, 0, -B2_EX * 7]) btn2_piston();
    translate([0, 0, -B2_EX * 17]) btn2_switch();
    translate([0, B2_EX * 12, 0]) btn2_screws();
}
if (BTN2_SOLO) btn2_solo();
