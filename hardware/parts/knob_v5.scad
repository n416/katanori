DIFF_START = 90 - (MAG2_ANG + TH_CCW);
echo(str("   スタート位置での磁石とリードの角度差 ", DIFF_START, "度 → 帯（", REED_BAND,
         "度）の内側に ", REED_BAND - DIFF_START, "度 ⚠ 0以下なら電源が切れない"));
TOP_GAP = (MAG2_ANG + TH_CW) - 90 + 360;
echo(str("   上端での磁石とリードの角度差 ", TOP_GAP, "度 → 帯まで ", TOP_GAP - REED_BAND,
         "度 ⚠ 負なら回し切りで電源が落ちる"));
REED_ZC = REED_TOP - REED_W / 2;   // -2.125 接点の z
echo(str("   リード(横・水平): 接点 (0, ", REED_IN + REED_W / 2, ", ", REED_ZC,
         ") ↔ 磁石の外縁 r ", MAG2_FACE_R, "（z ", Z_MAG2_BOT, "〜", Z_MAG2_TOP,
         "）→ 真横に ", REED_IN + REED_W / 2 - MAG2_FACE_R,
         "mm ⚠ 「閉じるのは5mm」は正対で測った値。B向き（軸=接線）の値は未測定"));
echo(str("   ⚠ 接点の z ", REED_ZC, " は磁石の帯（", Z_MAG2_BOT, "〜", Z_MAG2_TOP,
         "）の中にあること → ", (REED_ZC > Z_MAG2_BOT && REED_ZC < Z_MAG2_TOP)
         ? "入っている" : "**外れている**"));
echo(str("   圧入の座 ", REED_W, " 角 × 高さ ", REED_TIGHT_H, "（z ", REED_TOP - REED_TIGHT_H,
         "〜", REED_TOP, "）／ 呼び込み ", REED_W + 2 * REED_LOOSE, " 角 ／ 天井の肉 ",
         -REED_TOP, "mm ／ へこみの壁との肉 ", REED_IN - DISH_D / 2, "mm（x=0・座の区間だけ）"));
// 🔴 2026-08-21 追加。上の「肉 0.4」は**圧入の座の区間しか見ていなかった**。
//    呼び込みは hull() なので -Y 側（へこみ側）にも 0.35 広がっていて、
//    へこみの床（z -6.7）では肉が 0.2mm まで落ちる。実機で刷ったらここが消えて
//    へこみとリードの穴が1つの大穴になった。
//    ⚠ 判定の基準は docs/PRINT.md の実績（ELEGOO Mars 3・光造形）: **薄壁は 0.3mm が
//      形になる**／φ1.0 のピンは**剥離に負けて欠けた**。ここは両側が空洞の板なので、
//      形になる厚みと、剥がすまで生き残る厚みは別。0.21mm は実績の下限を割っている
function reed_in_at(z) = REED_IN;   // 🔒 へこみ側の面は全深さで REED_IN（呼び込みを -Y へ広げない）
REED_W_IN_MIN  = reed_in_at(Z_RELIEF) - DISH_D / 2;                  // へこみ側の最薄
REED_W_OUT_MIN = PAD_Y / 2 - (REED_IN + REED_W + REED_LOOSE);        // 外周側の最薄
echo(str("   ⚠ リードの穴の壁（x=0 の最薄）: へこみ側 ", REED_W_IN_MIN,
         "mm（z ", Z_RELIEF, "）／ 外周側 ", REED_W_OUT_MIN, "mm（z ", Z_PAD_BOT,
         "）→ ", (min(REED_W_IN_MIN, REED_W_OUT_MIN) < 0.3)
         ? "**実績の薄壁下限 0.3mm を割っている**"
         : "0.3mm は超えた ⚠ 両側が空洞なので剥離に耐えるかは別"));
echo(str("   磁石のポケットの外壁: 角 (±", MAG2_SLOT_W / 2, ", ", MAG2_R + MAG2_D / 2,
         ") → 持ち手の外周 ", GRIP_D / 2, " まで ",
         GRIP_D / 2 - norm([MAG2_SLOT_W / 2, MAG2_R + MAG2_D / 2]),
         "mm ⚠ 圧入の押しは接線方向なので、この壁は押されない（v4 と同じ）"));
echo(str("⑦ 支柱の痕に許される高さ ", RELIEF_D, "mm ／ へこみの床の全面に立てる。",
         "避けるのはねじの下穴2つだけ（①で座は無くなった。リードの穴はへこみの外）"));
// ---- ⑦b ラフトと支柱（2026-08-21・ユーザーの実機報告「天面がガタガタになる」から）----
// 🔒 ラフトはへこみの口＝**天面と同じ平面**に居る。壁との隙間はニッパーの入る幅であること。
//    ⚠ 支柱の位置は prop_zone() から取る（数字を二重に持たない）
PROP_PTS = concat(
    [for (k = [0 : DECK_RING_N - 1]) if (prop_zone(ring_pt(k)[0], ring_pt(k)[1])) ring_pt(k)],
    grid_pts(), oring_pts());
PROP_R_MAX  = max([for (p = PROP_PTS) norm(p)]);
PROP_EDGE   = PROP_R_MAX + DECK_PROP_D / 2;          // 一番外の支柱の外縁
PROP_OFF    = len([for (p = PROP_PTS) if (norm(p) + DECK_PROP_D / 2 > DECK_RAFT_R) 1]);
RAFT_GAP    = DISH_D / 2 - DECK_RAFT_R;
echo(str("⑦b ラフト r", DECK_RAFT_R, " ↔ へこみの壁 r", DISH_D / 2, " → 隙間 ",
         RAFT_GAP, "mm ", RAFT_GAP >= 2.5 ? "✅ ニッパーが入る"
                                          : "🔴 **狭い。刃が天面に乗る**"));
echo(str("   支柱 ", len(PROP_PTS), " 本 ／ 一番外は r", PROP_R_MAX, "（外縁 ", PROP_EDGE,
         "）→ ラフトからはみ出す本数 ", PROP_OFF,
         PROP_OFF > 0 ? " ⚠ 円の一部が縁から庇のように出る（中心が載っていれば浮きではない）"
                      : " ✅"));
echo(str("   一番外の支柱 → へこみの壁 までの無支持 ", DISH_D / 2 - PROP_EDGE,
         "mm ", DISH_D / 2 - PROP_EDGE <= 4.0
                ? "✅ 4mm 以内（天井はカールしない実績）"
                : "🔴 **4mm 超。天井がカールする**",
         " ／ 外周の剥離の掴みはピンの仕事（⑦c）"));
// ---- ⑦c 床の掴み（2026-08-21・薄皮剥離の後に追加）----
// 床は z6.7 の1レイヤーで +540mm²（STL実測 589→1129）現れる。剥離に抗するのは
// 支柱・ピンの**先の断面の合計**だけ。17.6mm²（φ0.8×35本）では全面剥離した（実機）
PIN_PTS  = pin_pts();
BOND_MM2 = (len(PROP_PTS) + len(PIN_PTS)) * PI * pow(DECK_PROP_TIP / 2, 2);
echo(str("⑦c 床の掴み: ラフト上 ", len(PROP_PTS), " ＋ プレート直立ちのピン ", len(PIN_PTS),
         " 本 × 先 φ", DECK_PROP_TIP, " → 合計 ", BOND_MM2, "mm² ",
         BOND_MM2 <= 17.6 ? "🔴 **剥がれた実績値（17.6mm²）以下**"
                          : str("（剥がれた実績 17.6mm² の ",
                                round(BOND_MM2 / 17.6 * 10) / 10, "倍）")));
echo(str("   ピンの帯 r", DECK_PIN_R, ": 内縁 ", DECK_PIN_R - DECK_PROP_D / 2, " ↔ ラフト ",
         DECK_RAFT_R, " ／ 外縁 ", DECK_PIN_R + DECK_PROP_D / 2, " ↔ 壁 ", DISH_D / 2,
         " ⚠ 取り外しはピンが先・ラフトが後"));
echo(str("天板の下に要る深さ ", knob_deep(), "mm（v4 と同じ）/ 外へ ", knob_grip_h(),
         "mm / 座 ", PAD_X, "×", PAD_Y));
