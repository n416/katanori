//    ⚠ +Y の 19.5 も動かない（リードの穴 17.8 ＋ 壁 1.7 ＝ この板の最薄）。
PAD_R  = 9.0;              // 隅の丸め。r10 にすると最薄が 1.70 → 1.62 に落ちる（＝今より薄くなる）ので 9 が上限
PAD_Y0 = -PAD_X / 2;       // −Y の端 −16.0。ここは皿しか無いので ±X と同じ壁 1.9 で足りる
                           //   （旧 −19.5 は、リードで伸ばした +Y に四角を合わせただけの余り）
