//    MAG2_SLOT_W の2面だけ」）。⇒ ✅ を外し、部品 ＋0.3 の逃げとして書き直した
MAG2_D  = MAG2_PART_D + 0.3;   // 6.3 磁石が通る道の幅（逃げ）。掴むのは MAG2_SLOT_W の側
MAG2_T  = 2.2;
STOP_OFF_ANG = 10;
// 中心の半径。⚠ AI が決めた値。B向きでは円板の**直径 6.3 が半径方向に立つ**ので、
