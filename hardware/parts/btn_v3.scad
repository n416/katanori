// 🔒 2026-09-05 v5 用の写し（元: frozen/v1-v4/btn_v3.scad）。寸法は実機で確かめた v3 のまま。羊羹の下側の内面 B3_BLK_XI2（隙間埋め）だけ足してある
use <parts.scad>   // 借りるのは DAOKAI マイクロスイッチの実測値（msw_*）と絵（microswitch_daokai）だけ。
                   //   `use` なので変数は入って来ない。世界の座標（BTN4 / Z_TOP）もここには一切無い。
// ============================================================
// 📦 btn_v3.scad — 会話ボタン v3（レバー式マイクロスイッチ・2026-08-30）
//    原点 = ボタンの芯 ／ z = 0 は天板の外面 ／ +Z が外（空の方）
//    刷る物 2 点（押し子・バスタブ）。買い物 0（M2 x 4 とナット x 4 は手持ち）。
// ============================================================
//
// ============================================================
// ✅ 実機で確かめた（2026-08-31・btntest 初刷り・レジン①）
//   ・押し心地 … ユーザー「最高。これは凄い」。指の動く量 1.44mm でクリック、
//     残り 0.51mm はツバの部屋の底が受ける（レバーは押し切られない）
//   ・抜けない … ✅ 引いても抜けない（ツバの掛かり 片側 0.5 → 焼いて 0.8）
//   ・落ちない … ✅ 押しても中へ落ちない（ツバ 19.8 ＞ バスタブの内のり 15.0）
//   ・ツバの下面 … ✅ **支え無しで荒れない**（片側 0.9mm の庇・7.56mm2 は垂れなかった）。
//     押し子には柱もラフトも付けない（顔を下にして刷るので跡が縁に残るため）
//   ・傾き … ✅ 約 12° 傾くが引っかからない。ユーザー「傾いても押せてきもちいい」
//   ⇒ **この 4 つはもう検討し直さなくてよい。**
// ============================================================
//
// ■ v2 が死んだ理由
//   天板の **1 つの穴が、ツバを「通す」役と「引っ掛ける」役を兼ねていた。**
//   通れば抜け、抜けなければ通らない。実機 2026-08-30「押し子が落ちない」→「落とせるように
//   したら抜け放題」は、この 1 点から出た症状で、隙間の詰め方の問題ではなかった。
//
// ■ v3 の作り —— 🔒 ユーザー案（2026-08-30・スケッチあり）
//   **押し子を下から通す。** 頭は天板の口を下から抜けて外に出る。ツバは口より広いので
//   **天板の肉そのものの裏に掛かる**。抜け止めに追加部品は要らない。
//   筒は天板から切り離して**バスタブ**（別部品）にし、天板の裏から下ろした**ブロック 2 個**
//   （＝羊羹 2）へ、**下から縦ねじ 2 本**で引き上げて留める。
//
//   組む姿勢: **天板を裏返して机に置く**（箱の中で見えないままやる作業をゼロにする）
//   ① 裏返した天板の口へ押し子を落とす（重力で座る）
//   ② バスタブにマイクロスイッチをねじ止め（M2 x 2）… **机の上・単体でできる**
//   ③ ブロックのナットを横から差す（2 個）
//   ④ バスタブを載せ、下（＝机の上では上）から M2 x 2 を耳に通してナットへ締める
//
//   落ちない … ツバ 19.8 はバスタブの内のりより広い。**中へ入る道が無い**
//   抜けない … ツバ 19.8 は天板の口 18.8 より広い。**外へ出る道も無い**
//   押し心地 … バネはレジンではなく**スイッチのレバー自身**。てこ比 0.696
//   🔒 たわむ部品ゼロ・圧入ゼロ・接着ゼロ。docs/PRINT.md「レジン①で板バネは作れない」に触れない
//
// ■ 🔴 ここまでに潰した 3 つの間違い（同じ穴に落ちないため）
//   ① カバーを皿へ圧入 … 公差に頼る留め方。v2 で 4 回外したのと同じ性質。取り下げ
//   ② カバーに脚を生やして横ねじ … 2.4mm の板に脚と M2。薄すぎる。取り下げ
//   ③ 横ねじ 2 本を同じ軸に並べる … ユーザー指摘「ねじを支点にしたブランコになる」。その通り。
//      横ねじはバスタブを天板へ**押し付けない**ので、止まるのは摩擦だけだった
//   ⇒ 縦ねじだけが「バスタブを天板の裏へ**引き上げる**」向き。面 1 つ＋離れたねじ 2 本で決まる
//   🔴 ナットは「ねじの軸方向に掘ったポケット」に入れるものではない。**床の上に載せて、
//      締める力で床へ押し付ける**（横から差し込む溝）。ここを取り違えて一度縦ねじを取り下げた
//
// ■ 🔒 守っている条件
//   ① ネジを表面に出さない ⇒ 天面に出るのは押し子の頭だけ
//   ② 頭が AS5600 のつまみ（+5.5）より高くならない ⇒ 頭の天面は +3.0
//   ③ 🔒 **バスタブの上は全開**。スイッチはレバーごと上から落とすので天井側に張り出しを作らない
//   ④ 🔒 **留めは 2 か所**。1 か所で持たせない
//   ⑤ 🔒 **棚（本当の L 字）を作らない**（ユーザー「印刷的には棚の形状にしない方が良い」
//      「羊羹みたいな直方体が一番」）。ブロックは天板の裏に付く**薄い直方体**
//   ⑥ ねじの頭は耳の下面にザグって沈める。バスタブの底より下へは何も出ない（深さが増えない）
//      🔴 2026-08-30 ここに「🔒 耳はバスタブの一番上（ユーザーの絵）」と書いていたが、**指示ではない**。
//        ユーザー「耳はバスタブの一番上なんて指示はしてません。なんとなくその方が線の通りが
//        良いだろうと思ったから」。⇒ 🔒 を外す。耳の高さはブロックの厚みで決まる従属値
// ============================================================


// ============================================================
// 1. 印刷の見込み（🔒 docs/PRINT.md 実績値。ここを触ると全部の嵌め合いが動く）
// ============================================================
//   ✅ **2026-09-02 実機で確定**（ELEGOO・回 0540 の六角ゲージ）。
//     ユーザー「正直全部入るのでもういいです。５あたりで良いと思います」。印 5 = 二面幅 4.10。
//     ⚠ 測れたのは **A（上から落とす袋穴）だけ**。B（横差し）は口を連結棒で塞いでいて 1 個も
//       入らなかった（ゲージの設計ミス）。横差しの値は未測定のまま、同じ 4.10 を使っている。
B3_SHRINK   = 0.10;  // 六角ポケットの見込み（旧 0.30 は SK本舗の実績）
B3_FIT_MOVE = 0.40;  // 動く所の片側の隙間（見込み 0.30 ＋ 実際に滑る 0.10）
B3_FIT_POCK = 0.15;  // 金属を入れて動かさない所（見込みだけ）


// ============================================================
// 2. スイッチ（DAOKAI ヒンジストレートレバー 3PIN）
// ============================================================
B3_SW    = msw_size();          // [12.8, 5.8, 6.5] 胴
B3_HINGE = -B3_SW[0] / 2;       // -6.40 ヒンジ（COM 端子側 = -X）
B3_PIN_LEN   = 3.5;             // ✅ 端子は図面のまま。ニッパーで詰める工程は無い
B3_SW_HOLE_Z = 2.0;             // ✅ 胴の底から取付穴の芯（ユーザー実測）

function b3_lever_z(x) = msw_bot_h() + (msw_act_h() - msw_bot_h()) * (x - B3_HINGE) / msw_lever_l();

B3_SW_DX = -(B3_HINGE * 2 + msw_lever_l()) / 2;      // -0.35 レバーの振る範囲を筒の芯に置く
B3_TIP_X = B3_HINGE + msw_lever_l() + B3_SW_DX;      // +6.75 レバー先端（ボタンの芯から）

B3_PUSH_X = 3.0;                                     // てこ比を決める唯一のつまみ
B3_RATIO  = (B3_PUSH_X - B3_HINGE) / msw_lever_l();  // 0.696
B3_CLICK  = msw_click()  * B3_RATIO;                 // 1.74
B3_FULL   = msw_travel() * B3_RATIO;                 // 2.78


// ============================================================
// 3. 顔（天板の口・押し子）
// ============================================================
B3_PLATE_T = 2.5;    // 天板の厚み（case_base.scad の TOP_T と同じ値。ここは形だけを持つ）
// 🔒 2026-08-30 **皿（口の手前の浅い凹み）は廃止**。ユーザー「外のベベルを埋めるのが難しいと？」
//   つまみの顔は「口が板を真っ直ぐ貫いて、縁に 0.3 の面取り」だけ。私はその手前にもう 1 段
//   皿（深さ 0.8）を入れていたので段が 3 つになり、つまみと顔が違って見えていた。
//   ⇒ 皿を埋める。ツバが掛かる肉は 1.70 → **2.50**（板の全厚）に増える。
B3_LIP_T   = B3_PLATE_T;   // 2.50 ツバが掛かる肉の厚み（板の全厚）

// 🔒 2026-08-30 顔を 18.0 → 15.0 に縮めた。ユーザー「ボタンサイズを小さくすれば当たらないんじゃないの？」
//   実測: 顔 15.0 で INA226 の板への当たりが 0 になる（18.0 では 2.22）。買った物（INA226・
//   ReSpeaker 基板・OLED）が全部 0 になるのはこの位置・この寸法だけ。
//   ⚠ 下限は 14.0。ツバ（顔 +1.8）がバスタブの内のり 15.0 より広くないと押し子が中へ落ちる。
//   ⚠ Y へ逃がす案は成立しない: -1 から OLED に当たり始め、-3 で ReSpeaker の基板に 17mm 食い込む。
//   🔄 2026-08-30 **v2 と同じ 18.0 x 12.0 に戻した。**
//   🔴 それまで「顔は 15.0 が限界」と言っていたが、止めていたのは INA226 ではなく
//     **私が決めた 2 つの数字**だった（ユーザー「なんか引っかかるな」で判明）:
//       ① バスタブの ±X の壁 1.6 → 外形 18.2。ツバの部屋（顔 +2.6）がこれより広くなると
//          バスタブの天面が座に載れず、部屋の中に落ちる。だから顔が 15.6 で頭打ちに見えていた
//       ② 座の枠 3.6。座が外へ張り出して INA226 の板に届いていた
//     ⇒ 壁を 3.0（外形 21.0 ＞ 部屋 20.6）、枠を 1.2 にすれば **18 x 12 で全部 0**。実測済み。
B3_HEAD_L = 18.0; B3_HEAD_W = 12.0; B3_HEAD_OUT = 3.0;   // 頭（天面から +3.0 出る）
B3_OPN_L  = B3_HEAD_L + B3_FIT_MOVE * 2;                // 18.80 天板の口（頭が下から抜けて上下に滑る）
B3_OPN_W  = B3_HEAD_W + B3_FIT_MOVE * 2;                // 10.40
// 🔒 2026-08-30 ユーザー「ボタンのベベルがつまみの顔と異なるので**つまみを正として**揃えて」。
//   つまみは knob_v5.scad の ch_hole_top(DISH_D/2, 0, CH_S) ＝ **45°・0.3mm**（CH_S = 0.3）。
//   ここは 0.4 で描いていたので 0.3 に合わせる。⚠ 数字の出どころは knob_v5.scad の CH_S。
//   btn_v3 は筐体を読まない約束なので値は写しで持つ。あちらを変えたらここも直す。
B3_BEVEL  = 0.3;                                        // 皿の縁の面取り（つまみと同じ 45°・0.3）
// 🔒 つまみの顔は **2 段**だった（ユーザー「どう見ても 2 段ベベルです」）。
//   ① 天板の口の縁 … ch_hole_top(..., CH_S=0.3)
//   ② **つまみ自身の頭の角** … ch_top(..., GRIP_CH=0.8) ／ 裾の角は ch_bot(..., CH_S=0.3)
//   ボタンは①しか無く、頭の角が立っていた。つまみを正として②を入れる。
// 🔒 2026-08-30 ユーザー「斜めに押されてしまうのでレールが必要。多少の遊びは必要なのでゆるめに」。
//   🔴 リブで隙間を詰める案は**取り下げ**。滑る嵌め合いの製図値は片側 0.40（見込み 0.30 ＋ 滑り 0.10）が
//     下限で、リブでそれ以下にすると焼いた時点で噛む。**レールでは遊びを減らせない。**
//   ⇒ 減らせるのは遊びではなく**傾き**。効くのは「案内する長さ」なので、頭の断面を
//     ツバの部屋の底まで下ろして、案内の長さを 2.5 → 5.65mm にする（＝下の裾）。
B3_HEAD_CH = 0.8;   // 頭の天面の角（＝つまみの GRIP_CH）
B3_HEAD_CB = 0.3;   // 頭の裾の角（＝つまみの CH_S）

// ツバ = 「抜けない」を持つ唯一の面。口より **X だけ** 広くする（Y へ広げない）
B3_CATCH = 0.5;                          // 掛かり（片側・呼び）。焼くと 0.8 になる
B3_FLG_L = B3_OPN_L + B3_CATCH * 2;      // 19.80
// 🔴 2026-08-30 ここを 9.0 の直書きにしていたため、顔を Y に縮めると口より広くなって
//   assert に当たり、「縮められない」ように見えていた。口から引く形にして顔に追従させる。
B3_FLG_W = B3_OPN_W - 1.4;               // Y は掛からない（口より片側 0.7 狭い）
B3_FLG_T = 1.2;

B3_TRAVEL   = 1.95;   // ハードストップ（レバーではなくツバの部屋の底が受ける）
B3_PILLAR_D = 3.4;    // レバーを押す柱の径
B3_PILLAR_H = 1.6;    // 柱の出


// ============================================================
// 4. Z の積み上げ
// ============================================================
B3_Z_LIP_B = -B3_PLATE_T;                      // -2.50 天板の裏 ＝ ツバの座
B3_Z_FLG_B = B3_Z_LIP_B - B3_FLG_T;            // -3.70 ツバの下面（自由状態）
B3_Z_WIN_B = B3_Z_FLG_B - B3_TRAVEL - 0.10;    // -5.75 ツバの部屋の底 ＝ バスタブの上端
// 🔒 予圧: レバーが常にツバを天板の裏へ押し付けている状態にする（0 だとカタつく）
B3_PRELOAD  = 0.3;
B3_Z_SW_BOT = B3_Z_FLG_B - B3_PILLAR_H - b3_lever_z(B3_PUSH_X) + B3_PRELOAD;   // -14.285
B3_Z_SW_TOP = B3_Z_SW_BOT + B3_SW[2];          // -7.785
B3_SKIRT    = 0.8;                             // 端子と線の逃げ
B3_Z_TUB_B  = B3_Z_SW_BOT - B3_SKIRT;          // -15.085 バスタブの底（world の下限に効く）
B3_FINGER_CLICK = B3_CLICK - B3_PRELOAD;       // 指が動く量（予圧のぶんは既に食われている）
// レバーの先の高さ（予圧のぶん柱が押す点を下げているので、先端は 予圧/てこ比 だけ下がる）
B3_TIP_Z = B3_Z_SW_BOT + b3_lever_z(B3_TIP_X - B3_SW_DX) - B3_PRELOAD / B3_RATIO;
// 裾（レール）の下端。押し切っても部屋の中に留まる高さ。
//   🔴 2026-08-30 これを「3. 顔」の節（Z の積み上げより**前**）に置いたら、参照先がまだ無くて
//     押し出しの高さが負になり、押し子が高さ 100mm の柱になった（ユーザー「立派に育ちましたね」）。
//     ⇒ 定義はここ（Z が出そろった後）。下の assert で高さが正であることを縛る。
B3_SKIRT_Z = B3_Z_WIN_B + 0.10 + B3_TRAVEL;


// ============================================================
// 5. 天板側（口・ツバの部屋・ブロック 2 個）
// ============================================================
// 🔴 2026-08-30 ここをツバだけで決めていた。**押し切ると頭も 1.95mm この部屋へ入る**ので、
//   頭も見なければならない。実際 頭 12.0 ↔ 部屋 12.2 で**片側 0.1**しか無く、印刷の見込み
//   （片側 0.30）に完全に負けていた＝焼いた時点で固着する。ブーリアンの当たりは 0 を返すので
//   検査では見えなかった。⇒ ツバと頭の**大きい方**から取る。
B3_WIN_L = max(B3_FLG_L, B3_HEAD_L) + B3_FIT_MOVE * 2;   // ツバの部屋
B3_WIN_W = max(B3_FLG_W, B3_HEAD_W) + B3_FIT_MOVE * 2;
// 🔴 2026-08-30 ここを一度 30.80（座とブロックを 1 枚に繋いだ「1 枚羊羹」）にした。
//   **それは私の勝手な解釈で、ユーザーは言っていない。**実測で当たりが 2 か所 → 4 か所に増えた
//   （+X 側で羊羹と OLED に新たに当たった）ので、ユーザーの絵どおり 24.20 に差し戻した。
// 🔒 枠は 3.6 → **1.2**。3.6 は根拠のない太さで、これが INA226 の板に届いていた。
//   座の役目は「ツバの部屋を囲むこと」と「バスタブの天面を受けること」だけで、
//   荷重はブロックとねじが持つ（座は 2.5mm の天板にぶら下がっているだけ）。
// 🔒 2026-08-30 枠は**一律にできない**。実測した相手の位置:
//     -X … INA226 の板が world X 13.07 まで。枠 0.6 で余裕 0.03mm。1mm も足せない
//     +Y … 電源線が world Y 26.0 を東西に走る。枠は片側 1.05 まで（付け根の丸み 0.8 込み）
//     +X … 空き（羊羹だけで、あれは同じ天板なので union）
//   ⇒ **-X の一辺だけ薄いまま、ほかを厚く**する。枠が 0.6 の薄いリングだったのを直す。
B3_PAD_L = B3_WIN_L + 3.6;               // +X 側の枠（片側 1.8）
B3_PAD_W = B3_WIN_W + 1.5;               // ±Y の枠（片側 0.75。部屋が広がったぶん枠を詰めた）
B3_PAD_XN = B3_WIN_L / 2 + 0.6;          // -X 側だけ 0.6（INA226 が居る）
B3_PAD_R = 2.0; B3_ROOT_R = 0.8;


// ============================================================
// 6. バスタブ（別部品。上は全開・スイッチはレバーごと上から落とす）
// ============================================================
B3_TUB_IX = 15.0;                        // 内のり X。レバー先端 6.75 が振れる幅（±7.5）
B3_TUB_IY = B3_SW[1] + B3_FIT_POCK * 2;  //  6.10 内のり Y（胴に合わせる）
B3_POCK_X = B3_SW[0] + B3_FIT_POCK * 2;  // 13.10 胴のポケット
B3_LEDGE_W = 1.0;                        // 胴の底を受ける棚（±Y の長辺。端子は Y ±0.4 しか使わない）

// 🔒 ±X の壁は 1.6 → **3.0**。バスタブの外形をツバの部屋より広くして、天面が座に載るようにする。
//   （1.6 のままだと外形 18.2 < 部屋 20.6 でバスタブが部屋に落ちる ＝ 顔を大きくできない原因だった）
// 🔄 2026-08-30 3.0 → **1.6 へ戻した**。3.0 にした理由は「バスタブの天面が座に載るように
//   外形を部屋より広くする」だったが、**耳を下げた時点でその前提は消えている**
//   （締め付けは耳の上面 ↔ ブロックの下面に移った。天面は載っていなくてよい）。
//   細くするとブロックを内側へ寄せられ、ナットの肉と信号線の隙間が両立する。
B3_WALL_X  = 1.6;                        // ±X の壁
B3_WALL_YN = 1.6;                        // -Y の壁（スイッチのねじの頭の側）
// 🔴 2026-08-30 刷る前の検算で **0.30mm の壁**が出た（ナットの座の床・11.62mm2 x 2）。
//   原因: バスタブの芯 B3_TUB_CY が (WALL_YP - WALL_YN)/2 だけ +Y へずれているので、
//   床の実寸は WALL_YP - NUT_T ではなく **(WALL_YP + WALL_YN)/2 - NUT_T**。
//   2.2 では 0.30 にしかならない。0.6 を確保するには 2.8 が要る。
B3_WALL_YP = 2.8;                        // +Y の壁
B3_TUB_OX  = B3_TUB_IX + B3_WALL_X * 2;              // 18.20
B3_TUB_Y0  = -(B3_TUB_IY / 2 + B3_WALL_YN);          // -4.65
B3_TUB_Y1  =   B3_TUB_IY / 2 + B3_WALL_YP;           // +5.25
B3_TUB_OY  = B3_TUB_Y1 - B3_TUB_Y0;                  //  9.90
B3_TUB_CY  = (B3_TUB_Y0 + B3_TUB_Y1) / 2;            // +0.30
B3_TUB_TOP = B3_Z_WIN_B;                             // -5.75 天板の裏に当たる面
B3_TUB_R   = 1.6;

// ---- 縦ねじ（🔒 ユーザーのスケッチ）----
//   下（＝組む姿勢では上）から耳を通し、ブロックの中のナットへ締める。
//   締める力はバスタブを**天板の裏へ引き上げる**向きに働く。
B3_V_SCR_D = 2.3;                    // M2 の通し
// 🔴 2026-08-30 刷る前の検算で **0.370mm の肉**（ブロックの内面 ↔ ナットの溝）が出た。
//   六角は二面幅を X に向けているので X の半幅は (AF/cos30 + 見込み)*cos30/2 = 2.13。
//   13.2 - 2.13 = 11.07 に対しブロックの内面が 10.70 → 0.37。⇒ ねじを 13.5 へ、外面を 15.8 へ。
B3_V_SCR_X = 13.1;                   // ねじの芯（ボタンの芯から ±）。2026-09-05 に幅を縮める案で 11.85 まで寄せられると出したが（外面 14.4・OLED の口に 0.43 残る）、Z を上げる決定で戻した
B3_NUT_T   = 1.6;  B3_NUT_AF = 4.0;  // M2 ナット
// 🔴 2026-09-02 **見込みを対角（外接円）に足していた。** 正しくは二面幅に足す。
//   旧: B3_NUT_AF/cos(30) + B3_SHRINK = 4.965 + 0.30 = 5.265 ⇒ 二面幅 **4.56**（呼び +0.56）
//   新: (B3_NUT_AF + B3_SHRINK)/cos(30)                      ⇒ 二面幅 **4.30**（呼び +0.30）
//   他は全部 4.30（case_base の NUT_AF / case_v3_shutter の SHUT_LOCK_NAF）。ここだけ 0.26 大きかった。
//   ✅ ユーザー実測が裏付け: 「底板の 6 角はうまく機能している。上面の裏のバスタブを付ける腕と
//     バスタブも逆さまにすると落ちる」。**落ちる方が 0.26 大きい方**だった。
//   ⚠ 下の assert は最初から (B3_NUT_AF + B3_SHRINK) の形で書いてある。検算の側は正しく、
//     彫っている側だけが違っていた。
//   🔒 天板は刷り済み（旧 4.56 のまま）。ユーザー「もう印刷したものをやり直すのは嫌」
//     「気が向いたらやり直すくらいですね。割れたり壊れたら」⇒ **刷り直さない。**
// 🔴 2026-08-31 ザグリの**深さ**を 1.2 → **1.6** に（ユーザー指示・刷り直しの理由）。
//   1.2 は実測の頭の高さ 1.3 より低く、頭が沈みきらない形だった。1.3 ＋ 沈み 0.3 ＝ 1.6。
//   耳の厚み [4.5, 5.585] に対し assert（耳 − ザグリ ≥ 1.5）も通る。
//   ⚠ 径は **4.2 のまま**。他（case_base の SCR_CB・つまみの島）は 4.4 だが、ここだけ
//     外面（B3_BLK_XO 15.35）までの肉が 0.052 まで落ちるので広げない（8d79f07）。
B3_CB_D    = 4.2;  B3_CB_H   = 1.6;  // 頭のザグリ（バスタブの底に沈める）
// 🔒 2026-08-30 ユーザー「耳が浮いてるからその部分で印刷失敗する」。**左右で別々に取る。**
//   耳の下に空間が残ると庇になって刷れないので、当たらない範囲で底まで下ろす。
//   INA226 は -X 側にしか居ないので、+X は底までいける。[+X 側, -X 側]。
//   ✅ 実測: **-X は 5.585（バスタブの底とツライチ・庇ゼロ）／+X は 4.5 が限界**。
//     +X の真下には電池／INA の塊が world Z 35.87〜36.82 の帯で来ていて、4.7 で当たる。
//     ⇒ +X 側だけ 1.085mm の隙間が残る。これは埋められない（支えを付けて刷る）。
B3_EAR_T   = [4.5, 5.585];           // 耳の厚み（Z）。[+X 側, -X 側]
// 🔄 2026-09-02 上の「+X 側は埋められない」は**耳の厚みを一様に掃引した**結果で、部分的には埋まる。
//   実測（hardware/_tub_ear_probe.scad・相手は innards4 の全部）: 耳の足あと 7.25 x 7.0 = 50.75mm² のうち
//   **39.18mm²（77%）は 1.085mm ぜんぶプレートまで空いている**。塞いでいるのは INA226 の板の縁 1 枚だけで、
//   局所 y 6.54 以上・厚み 0.29mm（当たり 2.007mm³）。電池・PowerBoost・橋・帯・柱・線・OLED・ハブ・
//   ReSpeaker・蓋は全部 0。⇒ +X の耳にも**底まで届く足**を付け、+Y 側だけ INA の手前で止める。
//   これで浮いた庇（斜めに出た所）が消え、支柱もラフトも要らなくなる。
B3_EAR_FOOT_Y1 = 6.04;               // 足の +Y の端（局所 y）。INA の縁 6.54 − 逃げ 0.5
// 足の下面。+X だけ底まで下ろす（-X は元から底とツライチ）
function b3_ear_foot_z0(i) = (i == 0) ? B3_Z_TUB_B : b3_ear_z0(i);
function b3_ear_foot_y0()  = B3_TUB_CY - B3_BLK_W / 2 + B3_BLK_DY[0];
// 2026-08-30 耳を一度バスタブの一番上へ上げた（ユーザーの絵に合わせて）。
//   ⚠ それは**指示ではなかった**（「なんとなく線の通りが良いだろうと思ったから」）。
//   ⇒ 今はブロックの厚み（印刷の安全）を優先して下げてある。耳の高さは従属値。
// 🔒 2026-08-30 ユーザー「羊羹 2 の Z 長さをすこし増やした方がいい。薄すぎて印刷が危険」。
//   ブロックの高さ = 天板の裏（-2.5）から下へ B3_BLK_H。**上は天板なので伸ばせるのは下だけ**で、
//   下げた分だけ**耳も一緒に下がる**（耳の上面 ＝ ブロックの下面）。
B3_BLK_H   = 7.0;                        // ブロックの高さ（旧 3.25）
B3_EAR_Z1  = B3_Z_LIP_B - B3_BLK_H;      //  -9.500 耳の上面 ＝ ブロックの下面
// 🔒 2026-08-30 耳はできるだけ下まで伸ばす（下に庇を残さないため）。底まで下ろすと INA226 に
//   当たるので、当たらない範囲で最大に取る。B3_EAR_T がその厚み。
function b3_ear_z0(i) = max(B3_EAR_Z1 - B3_EAR_T[i], B3_Z_TUB_B);   // 耳の下面（i=0 が +X）

// ---- ブロック（＝羊羹 2。天板の裏から下りてナットを持つ）----
//   🔴 2026-08-30 ユーザー「押し子にあたってんじゃん」。内面を 9.30 に置いていた。
//     ツバは ±9.9 まで張り出して**上下に動く**ので、そこはブロックの居場所ではない。
//     ⇒ 内面はツバの部屋（±10.3）の外に置く。下の assert で二度と入れない。
//   🔒 ブロックは**直方体**（ユーザー「印刷を考慮したら羊羹みたいな直方体が一番」）。
//   🔒 耳を上げたので、ブロックは天板の裏から耳の上面までの**薄い板**（高さ 3.25）で足りる。
// 🔴 2026-08-30 ここもツバの部屋だけを見ていた。ブロックが避けるべきなのは
//   **ツバの部屋とバスタブの両方**。顔を縮めるとバスタブ（18.2・レバーの振りで決まる）の方が
//   広くなるので、大きい方を見る。これを直すまで「顔を縮められない」ように見えていた。
B3_BLK_XI  = max(B3_WIN_L, B3_TUB_OX) / 2 + 0.2;   // 内面（ツバの部屋とバスタブの外）
B3_BLK_XO  = 15.35;                  // 外面（ナット 4.0 が横から入る）。2026-09-05 の幅縮め案（14.4）は Z を上げる決定で戻した
B3_BLK_XI2 = B3_TUB_OX / 2 + 0.2;    // v5: ツバの部屋より下の内面（バスタブの外壁から 0.2）。隙間を埋めてナットの内側の壁にする
B3_BLK_W   = 7.0;                    // 幅（Y）
// ブロックの Y の送り。🔒 ユーザー指針「X が置けなければ Y 方向に太らせればいい。
//   それでもダメなら斜め 2 点」。[-X 側, +X 側] で別々に送れる（＝斜め 2 点が書ける）。
// ✅ 2026-08-30 実測で決定: **-X 側だけ -2.5**。電源線（INA の GND が口から +Y へ走る線）が
//   -X のブロックの中を通っていた（当たり 1.50 x 1.98 x 1.50）。線は引き直せない——線の始点
//   [11.8, 19.87, 47.3] そのものがブロックの内側で、口の頭（Z 46.0）もブロックの高さの中にあり、
//   下へも横へも抜け道が無いため。⇒ 動かすのはブロックの方。
//   掃引: -1 で 1.50 / **-2 で 0** / -3..-5 も 0。他の相手（INA226・ReSpeaker 基板・OLED）は全部 0 のまま。
// 🔄 2026-08-30 **+X 側も振って斜め 2 点に**。ユーザー「これだと OLED のピンヘッダにも刺さる」。
//   +X のブロックが OLED の I2C コネクタに 1.43 x 3.00 x 2.54 食い込んでいた
//   （world X 37.97〜39.40 / Y 14.10〜17.10 / Z 45.23〜47.77）。
//   掃引: +1 で 2.00 / +2 で 1.43 / **+3 で 0**。余裕 0.5 を見て +3.5。
//   🔴 このときまで検査の相手に**コネクタ類（oled_hous / xiao_hous / housing）が入っていなかった**。
//     「全部 0」と言いながら相手が抜けていた。_btn_v3_fit.scad に oledh / xiaoh / hous を追加済み。
//   ✅ 窓を測って真ん中へ置いた（ユーザー「うんギリギリ」）:
//     +X 側 … 窓は **3.0〜4.1 の 1.1mm しかない**（下は OLED のコネクタ・上は電源線）。
//             真ん中の 3.5 が最善で、余裕は 0.5 / 0.6。**ここは物理的にギリギリ**
//     -X 側 … 窓は -2.0 から -5.5 以上まで開いている。-2.5 は端に寄りすぎだったので
//             **-3.0** へ。電源線からの余裕が 0.5 → 1.0 に増える
B3_BLK_DY  = [3.5, -3.0];
B3_BLK_FLR = 0.8;                    // ナットを載せる床の厚み
B3_NUT_Z0  = B3_EAR_Z1 + B3_BLK_FLR; // -11.285 ナットの下面（床の上）
B3_NUT_Z1  = B3_NUT_Z0 + B3_NUT_T;   //  -9.685 同 上面
B3_EAR_XO  = B3_BLK_XO;              // 耳の外面（ブロックと同じ）

// ---- スイッチのねじ（机の上で締める。🔒 頭は -Y・ナットは +Y の壁の中）----
B3_SCR_D  = 2.3;
B3_SEAT_D = 4.6;  B3_SEAT_H = 0.6;
B3_HEAD_D = 3.8;  B3_HEAD_T = 1.2;
B3_Z_SCR  = B3_Z_SW_BOT + B3_SW_HOLE_Z;   // -12.285 ねじの芯の Z
B3_SCR_X  = msw_hole_p() / 2;             // ±3.25（スイッチの芯から）


// ============================================================
// 7. 形（2D の下地）
// ============================================================
// 🔒 2026-08-30 ユーザー「小判状にはできないんですかね。デザイン的に相当浮いてます」。
//   **顔と天板の口だけ**を小判（両端が半円）にする。つまみもスピーカーの穴も丸なので顔が揃う。
//   ⚠ ツバは角のある形のまま。ツバまで小判にすると、掛かりが X の端の一点付近だけになって
//     抜け止めが弱くなる（口が小判・ツバが角なら、口の細る所でむしろ掛かりが増える）。
module b3_ob2d(l, w) hull() for (sx = [-1, 1]) translate([sx * (l - w) / 2, 0]) circle(d = w, $fn = 48);
module b3_ob(l, w, h) linear_extrude(h) b3_ob2d(l, w);

module b3_rr(l, w, r, cy = 0) translate([0, cy])
    offset(r = r, $fn = 48) square([l - 2 * r, w - 2 * r], center = true);
module b3_box(l, w, r, h, cy = 0) linear_extrude(h) b3_rr(l, w, r, cy);


// ============================================================
// 8. 刷る物 ① 押し子（頭 ＋ ツバ ＋ 柱。**下から**天板の口へ通す）
// ============================================================
// 頭。つまみと同じ 2 段の面取り（天面の角 0.8・裾の角 0.3）
module btn3_head() hull() {
    for (d = [[B3_Z_LIP_B, B3_HEAD_CB], [B3_Z_LIP_B + B3_HEAD_CB, 0],
              [B3_HEAD_OUT - B3_HEAD_CH, 0], [B3_HEAD_OUT - 0.01, B3_HEAD_CH]])
        // 🔴 最上段は HEAD_OUT **-0.01**。0.01 の板を HEAD_OUT に置くと天面が 3.01 になり、
        //   刷る向きにしたとき底が Z -0.01 に浮く（刷る前の検算で出た）
        translate([0, 0, d[0]]) linear_extrude(0.01)
            offset(r = -d[1], $fn = 24) b3_ob2d(B3_HEAD_L, B3_HEAD_W);   // 小判
}
module btn3_piston(dn = 0) color("#8fb4d9") translate([0, 0, -dn]) {
    btn3_head();                                                                                 // 頭（2 段の面取り）
    // 裾（レール）。頭と同じ断面を部屋の底まで下ろして、案内の長さを稼ぐ
    translate([0, 0, B3_SKIRT_Z]) b3_ob(B3_HEAD_L, B3_HEAD_W, B3_Z_LIP_B - B3_SKIRT_Z);
    translate([0, 0, B3_Z_FLG_B]) b3_box(B3_FLG_L,  B3_FLG_W,  1.0, B3_FLG_T);                   // ツバ
    translate([B3_PUSH_X + B3_SW_DX, 0, B3_Z_FLG_B - B3_PILLAR_H + 0.01])                        // 柱
        cylinder(d = B3_PILLAR_D, h = B3_PILLAR_H, $fn = 32);
}


// ============================================================
// 9. 刷る物 ② バスタブ（上は全開。耳の下面は底とツライチ）
// ============================================================
module btn3_tub() color("#a8b6a0") difference() {
    union() {
        translate([0, 0, B3_Z_TUB_B])                                                    // 器
            b3_box(B3_TUB_OX, B3_TUB_OY, B3_TUB_R, B3_TUB_TOP - B3_Z_TUB_B, B3_TUB_CY);
        for (i = [0, 1]) mirror([i, 0, 0]) translate([0, B3_BLK_DY[i], 0])                // 耳 2 か所
            translate([B3_TUB_OX / 2 - 1, B3_TUB_CY - B3_BLK_W / 2, b3_ear_z0(i)])
                cube([B3_EAR_XO - B3_TUB_OX / 2 + 1, B3_BLK_W, B3_EAR_Z1 - b3_ear_z0(i)]);
        // +X の耳の足（🔒 B3_EAR_FOOT_Y1 の節）。X は耳と同じ・+Y だけ INA の手前で止める
        translate([B3_TUB_OX / 2 - 1, b3_ear_foot_y0(), B3_Z_TUB_B])
            cube([B3_EAR_XO - B3_TUB_OX / 2 + 1,
                  B3_EAR_FOOT_Y1 - b3_ear_foot_y0(),
                  b3_ear_z0(0) - B3_Z_TUB_B]);
    }
    // ---- 中を彫る。🔒 上は全開（天井側に張り出しを一切作らない）----
    translate([0, 0, B3_Z_SW_TOP])                                                        // レバーの部屋
        b3_box(B3_TUB_IX, B3_TUB_IY, 0.8, B3_TUB_TOP - B3_Z_SW_TOP + 0.01, B3_TUB_CY);
    translate([-B3_POCK_X / 2 + B3_SW_DX, B3_TUB_CY - B3_TUB_IY / 2, B3_Z_SW_BOT])        // 胴のポケット
        cube([B3_POCK_X, B3_TUB_IY, B3_SW[2] + 0.01]);
    translate([-B3_POCK_X / 2 + B3_SW_DX, B3_TUB_CY - (B3_TUB_IY / 2 - B3_LEDGE_W),       // 裾（端子の道）
               B3_Z_TUB_B - 1])
        cube([B3_POCK_X, B3_TUB_IY - B3_LEDGE_W * 2, B3_SKIRT + 1.01]);
    btn3_sw_screw_cut();
    btn3_v_screw_cut();
}

// ---- スイッチのねじ（頭は -Y・ナットは +Y の壁の中。締めるとナットは床へ押し付けられる）----
module btn3_sw_screw_cut() for (sx = [-1, 1]) translate([sx * B3_SCR_X + B3_SW_DX, 0, B3_Z_SCR]) {
    translate([0, -20, 0]) rotate([-90, 0, 0]) cylinder(d = B3_SCR_D, h = 40, $fn = 24);
    translate([0, B3_TUB_Y0 + B3_SEAT_H, 0]) rotate([90, 0, 0])                            // 頭の平らな座
        cylinder(d = B3_SEAT_D, h = 4, $fn = 32);
    translate([0, B3_TUB_Y1 - B3_NUT_T, 0]) rotate([-90, 0, 0])                            // 六角の座
        cylinder(d = (B3_NUT_AF + B3_SHRINK) / cos(30), h = B3_NUT_T + 1.0, $fn = 6);
}

// ---- 縦ねじ（耳の通しと、底に沈める頭のザグリ）----
//   ⚠ 足を付けた側は下面が 1.085 下がるので、ザグリも同じだけ深くする。**頭の座の Z は動かさない**
//     （動かすと M2 を 1.085 長い物へ買い替えることになる）。深さ 1.6 → 2.685、残る肉 2.9（assert 1.5）
module btn3_v_screw_cut() for (i = [0, 1]) mirror([i, 0, 0]) translate([0, B3_BLK_DY[i], 0]) {
    translate([B3_V_SCR_X, 0, b3_ear_foot_z0(i) - 1])
        cylinder(d = B3_V_SCR_D, h = B3_EAR_Z1 - b3_ear_foot_z0(i) + 2, $fn = 24);
    translate([B3_V_SCR_X, 0, b3_ear_foot_z0(i) - 0.01])                                   // 頭のザグリ
        cylinder(d = B3_CB_D, h = B3_CB_H + (b3_ear_z0(i) - b3_ear_foot_z0(i)) + 0.01, $fn = 32);
}


// ============================================================
// 10. 天板側（足す肉 = ツバの部屋の囲い ＋ ブロック 2 個 ／ 抜く物 = 皿と口）
// ============================================================
module b3_pad_2d() intersection() {
    b3_rr(B3_PAD_L, B3_PAD_W, B3_PAD_R);
    translate([-B3_PAD_XN, -50]) square([100, 100]);   // -X 側を切り落とす（INA226 の逃げ）
}

B3_ROOT_N = 8;
module btn3_root() for (i = [0 : B3_ROOT_N - 1]) hull() for (j = [i, i + 1])
    let (d = j / B3_ROOT_N * B3_ROOT_R)
        translate([0, 0, -B3_PLATE_T - B3_ROOT_R + d]) linear_extrude(0.02)
            offset(r = B3_ROOT_R - sqrt(B3_ROOT_R * B3_ROOT_R - d * d), $fn = 32) b3_pad_2d();

// ブロック 1 個ぶん（+X 側）。上側は 45° で座へ繋ぐので、刷る向きで庇にならない
module btn3_block() {
    translate([B3_BLK_XI, B3_TUB_CY - B3_BLK_W / 2, B3_EAR_Z1])
        cube([B3_BLK_XO - B3_BLK_XI, B3_BLK_W, B3_Z_LIP_B - B3_EAR_Z1]);   // 直方体・天板の裏まで
    translate([B3_BLK_XI2, B3_TUB_CY - B3_BLK_W / 2, B3_EAR_Z1])           // v5: ツバの部屋（Z_WIN_B より上）を避けて、その下だけ内へ出す
        cube([B3_BLK_XI - B3_BLK_XI2 + 0.01, B3_BLK_W, B3_Z_WIN_B - B3_EAR_Z1]);
}
// ブロックから抜く物: ナットを横から差す溝（床の上に載る）＋ ねじの通し
module btn3_block_cut() {
    translate([B3_V_SCR_X, 0, B3_EAR_Z1 - 0.01])                                           // ねじの通し
        cylinder(d = B3_V_SCR_D, h = B3_NUT_Z1 - B3_EAR_Z1 + 2.0, $fn = 24);
    hull() for (dx = [0, 6])                                                               // ナットの溝（+X から差す）
        translate([B3_V_SCR_X + dx, 0, B3_NUT_Z0]) rotate([0, 0, 30])                      // 二面幅を X に向ける
            cylinder(d = (B3_NUT_AF + B3_SHRINK) / cos(30), h = B3_NUT_T, $fn = 6);
}

module btn3_station_add() difference() {
    union() {
        btn3_root();
        // 🔴 ここは b3_box(...) で直に描いていて、b3_pad_2d() の -X の切り落としが効いていなかった
        translate([0, 0, B3_Z_WIN_B]) linear_extrude(B3_Z_LIP_B - B3_Z_WIN_B + 0.01) b3_pad_2d();   // ツバの部屋の囲い
        for (i = [0, 1]) mirror([i, 0, 0]) translate([0, B3_BLK_DY[i], 0]) btn3_block();    // 🔒 ブロック 2 個
    }
    translate([0, 0, B3_Z_WIN_B - 0.01]) b3_box(B3_WIN_L, B3_WIN_W, 1.4,                   // ツバの部屋
                                                B3_Z_LIP_B - B3_Z_WIN_B + 0.02);
    for (i = [0, 1]) mirror([i, 0, 0]) translate([0, B3_BLK_DY[i], 0]) btn3_block_cut();
}

// ---- 天板の板そのものを抜く（皿・縁のベベル・口）----
module btn3_station_cut() {
    // 🔒 つまみと同じ顔: 口が板を真っ直ぐ貫き、縁に 45°・0.3 の面取り 1 つだけ（皿は無い）
    translate([0, 0, B3_Z_LIP_B - 0.01]) b3_ob(B3_OPN_L, B3_OPN_W, B3_PLATE_T + 0.02);           // 口（小判）
    translate([0, 0, -B3_BEVEL]) hull() {                                                        // 口の縁の面取り
        b3_ob(B3_OPN_L, B3_OPN_W, 0.01);
        translate([0, 0, B3_BEVEL]) b3_ob(B3_OPN_L + B3_BEVEL * 2, B3_OPN_W + B3_BEVEL * 2, 0.01);
    }
}


// ============================================================
// 11. 買う物の絵（部品ではない）
// ============================================================
module btn3_switch(press = 0) translate([B3_SW_DX, 0, B3_Z_SW_BOT]) difference() {
    microswitch_daokai(press);
    translate([-20, -20, -msw_pin_h() - 1]) cube([40, 40, msw_pin_h() - B3_PIN_LEN + 1]);
}
module btn3_sw_screws() for (sx = [-1, 1]) translate([sx * B3_SCR_X + B3_SW_DX, 0, B3_Z_SCR]) {
    color("#b0b0b0") {
        translate([0, B3_TUB_Y0 + B3_SEAT_H - B3_HEAD_T, 0]) rotate([-90, 0, 0])
            cylinder(d = B3_HEAD_D, h = B3_HEAD_T, $fn = 24);
        translate([0, B3_TUB_Y0 + B3_SEAT_H, 0]) rotate([-90, 0, 0])
            cylinder(d = 2.0, h = B3_TUB_Y1 - B3_TUB_Y0 - B3_SEAT_H, $fn = 20);
    }
    color("#8a8a8a") translate([0, B3_TUB_Y1 - B3_NUT_T, 0]) rotate([-90, 0, 0])
        cylinder(d = B3_NUT_AF / cos(30), h = B3_NUT_T, $fn = 6);
}
// 縦ねじ（頭はバスタブの底のザグリの中・ナットはブロックの床の上）
module btn3_v_screws(ex = 0) for (i = [0, 1]) mirror([i, 0, 0]) translate([0, B3_BLK_DY[i], -ex]) {
    color("#b0b0b0") {
        translate([B3_V_SCR_X, 0, b3_ear_z0(i)]) cylinder(d = B3_CB_D - 0.2, h = B3_CB_H, $fn = 24);
        translate([B3_V_SCR_X, 0, b3_ear_z0(i)]) cylinder(d = 2.0, h = B3_NUT_Z1 - b3_ear_z0(i), $fn = 20);
    }
    color("#8a8a8a") translate([B3_V_SCR_X, 0, B3_NUT_Z0]) cylinder(d = B3_NUT_AF / cos(30), h = B3_NUT_T, $fn = 6);
}


