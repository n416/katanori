echo(str("btn_v3 組む順: 天板を裏返して机に置く ①押し子を口へ落とす ②バスタブにスイッチをねじ止め ",
         "③ブロックのナットを横から差す ④バスタブを載せて縦ねじ 2 本"));

assert(B3_FINGER_CLICK > 0.8, "予圧が大きすぎて指の動く量が残らない");
assert(B3_FINGER_CLICK < B3_TRAVEL, "クリックより先にハードストップに着く（押しても入らない）");
assert(B3_TRAVEL < B3_FULL, "ハードストップより先にレバーを押し切る（レバーを壊す）");
assert(B3_FLG_L > B3_OPN_L, "ツバが天板の口より狭い ⇒ 上に抜ける");
assert(B3_FLG_W < B3_OPN_W, "ツバが Y でも掛かっている ⇒ Y を広げる圧力が戻る（v2 の道）");
assert(B3_HEAD_L < B3_OPN_L && B3_HEAD_W < B3_OPN_W, "頭が天板の口を下から通らない（組めない）");
assert(B3_FLG_L > B3_TUB_IX, "ツバがバスタブの内のりより狭い ⇒ 中へ落ちる");
assert(B3_WIN_L > B3_FLG_L && B3_WIN_W > B3_FLG_W, "ツバの部屋がツバより狭い（上下に動けない）");
assert(B3_TUB_IX / 2 - B3_TIP_X > 0.5, "レバーの先が壁に当たる（実機 2026-08-30）");
assert((B3_POCK_X - B3_SW[0]) / 2 <= 0.2 && (B3_TUB_IY - B3_SW[1]) / 2 <= 0.2,
       "胴がポケットの中で動く（実機 2026-08-30 ブレブレ）");
assert(B3_Z_FLG_B - B3_TIP_Z > 0.30, "レバーの先がツバに当たっている（柱の出 B3_PILLAR_H が足りない）");
assert(B3_HEAD_OUT < 5.5, "🔒 頭が AS5600 のつまみ（5.5）より高い");
// 🔴 芯のずれを入れた正しい式。前は WALL_YP - NUT_T で 0.6 と出ていたが実寸は 0.30 だった
assert((B3_WALL_YP + B3_WALL_YN) / 2 - B3_NUT_T >= 0.55,
       "ナットの床が薄い（実寸 = (WALL_YP + WALL_YN)/2 - NUT_T）");
assert(min(B3_EAR_T) - B3_CB_H >= 1.5, "耳がザグリに食われて薄い（頭が抜ける）");
// 足の +Y の縁 ↔ ザグリ（φ4.2・芯は B3_BLK_DY[0]）の間に残る肉。ここが足の最薄部
assert(B3_EAR_FOOT_Y1 - (B3_BLK_DY[0] + B3_CB_D / 2) >= 0.42,
       "足の +Y の壁が 0.42 を切る（PRINT.md の最薄肉）");
assert(B3_BLK_XI > B3_TUB_OX / 2, "ブロックがバスタブに食い込んでいる（入らない）");
// 🔴 2026-08-30 ユーザー「押し子にあたってんじゃん」。ツバは ±FLG_L/2 で上下に動く
assert(B3_BLK_XI >= B3_WIN_L / 2, "ブロックがツバの部屋に入っている ⇒ 押し子に当たる");
assert(B3_FLG_L > B3_OPN_L, "ツバが天板の口より狭い（再掲・掛かりが消える）");
assert(B3_V_SCR_X - B3_NUT_AF / 2 > B3_WIN_L / 2, "ナットの溝がツバの部屋を食っている");
assert(B3_NUT_Z1 < B3_Z_LIP_B - 0.5, "ナットの溝が天板の裏を突き抜けている");
assert(b3_ear_z0(0) >= B3_Z_TUB_B && b3_ear_z0(1) >= B3_Z_TUB_B, "耳がバスタブの底より下に出ている");
assert(B3_BLK_FLR >= 0.6, "ナットを載せる床が薄い");
// 🔴 ブロックの内面 ↔ ナットの溝 の肉（刷る前の検算で 0.370 が出た所）
// 六角は二面幅を X に向けているので、X の半幅は (二面幅 + 見込み)/2
assert(B3_V_SCR_X - (B3_NUT_AF + B3_SHRINK) / 2 - B3_BLK_XI >= 0.42,
       "ブロックの内面とナットの溝の間の肉が薄い（0.42 未満）");
assert(B3_BLK_XO - B3_V_SCR_X >= (B3_NUT_AF + B3_SHRINK) / 2,
       "ナットが溝からはみ出す");
assert(B3_Z_LIP_B - B3_SKIRT_Z > 0.2, "裾の高さが 0 以下（Z の定義順を間違えている）");
assert(B3_SKIRT_Z >= B3_Z_WIN_B + B3_TRAVEL, "押し切ると裾がツバの部屋から出る");
