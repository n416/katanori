// ReSpeaker Lite のモック（筐体設計用の当て板）
//
// **筐体・スタンドを設計するときは、必ずこれを呼んで CAD の中で当てること。**
// 刷ってから当たりを見つけるのをやめるために作った（2026-08-04）。
// 数字の一覧は docs/RESPEAKER-LITE.md（このファイルと同時に更新する）。
//
//   use <respeaker_lite.scad>
//   respeaker_lite();          // 基板＋部品
//   関数 respeaker_L() / respeaker_H() / respeaker_T() / respeaker_center_back()
//
// ============================================================
// 🔴 2026-08-08 の全面作り直し（**この版の最重要事項**）
// ============================================================
// ユーザーが Seeed の公式3Dファイル ReSpeakerLitev1.1.step（KiCad出力のv1.1
// アセンブリ）を見つけた。部品ごとのリファレンス指定子と配置行列が入っているので、
// **位置は読み取りではなく数字で出せる。** 部品は respeaker_lite_parts.scad に
// 自動生成してある（212ボックス・手で転記していない）。
//
// これで直った一番大きな間違い:
//   **中央領域を「厚さ4.8の板」として描いていたこと。**
//   4.8は一番高い部品どうしを結んだ**外形**であって、面ではない。実際は
//   クレードルの範囲（左から33〜64）のマイク面には**下から14.27より下に何も無い**。
//   この誤りのせいで「前壁との隙間0.6」と計算したが、本当は1.78あり、
//   v15の対策はほぼ何も効いていなかった（stand_seat_test.scad のv15/v16の記述）。
//   → **外形寸法を面の位置として使わない。**
//
// 残っている ⚠: 無し（2026-09-06 に棚卸し。確かめ済みか注意書きの印は外した）
//   確かめ済み: シールド缶 10.6 × 12.6 × 2.0（📄 XIAO 公式 STEP・2026-09-06）／ XIAO 本体＋ピンヘッダ（先端 10 ✅実測）／ XIAO の USB-C の張り出し 1.53（📄 公式 STEP・外形 86 ✅実測と一致・右の壁は v4 実機合わせ）／
//   中央領域の背面の厚み 4.8 ✅実測（板 1.85・部品 1.19・残り 1.76 の内訳は帳簿上の割り振りで、寸法は合計で持っている）
//   - u.FLアンテナの同軸 … ⬜ 未取得
//
// ---- 座標系（docs/RESPEAKER-LITE.md の基準の向き）----
//   X : 0 〜 82.024 … 「左から」。X=0 が左端（XIAOのUSB-Cが張り出す側）
//   Z : 0 〜 34.007 … 「下から」。Z=0 が下辺
//   Y : 0 〜 1.510  … 板厚。**XIAO面は Y=0 の面（部品は -Y へ出る）／
//       マイク面は Y=1.510 の面（部品は +Y へ出る）**
//
//   🚫 2026-08-04 鏡像事故（**二度と起こさない。絶対**）: 当初「XIAO面=Y+側」で
//     組んでいたが、これは「XIAO面を手前にしてX=0が左」と**両立しない**
//     （モデル全体が鏡像になる）。面のYの割り当てと「左」の定義は、組で利き手を決める。
//     鏡像が特に危険な理由（ユーザー明言）: **一瞬正しく見えるため、ユーザーが
//     その画面を基準に座標を伝え返し、入力データ自体が汚染される。**
//     ルール: この座標系・面割り当てを変更したら、**XIAO面ビューを実物写真と並べて
//     照合するまで、このファイルを使う設計を書かない。**
//     照合済み: 2026-08-04（写真）／2026-08-08（公式CADと独立に一致）。
//     2026-08-08の検算は3つとも合った:
//       取付穴 左2.492/上2.430 と 左60.202/下2.657 … ✅ユーザー実測の「2.5・2.5」「60・2.5」
//       スイッチ K1 左1.23〜5.83 ／ K2 左8.92〜13.52 … ✅実測の「1.5〜6.5」「9〜14」
//       XIAOのパッド 左2.932〜18.172 … ✅実測の「ピンヘッダー 2〜20」
//     面ラベル「XIAO」と上矢印は消さないこと（鏡文字に見えたら裏を見ている）。
//
// ---- 格付け ----
//   📄 公式CAD / ✅ ユーザー実測 / ⚠ 推測（画像読み含む） / ⬜ 未取得
//   **⚠ の上に位置の決まった穴・締め代を作らない。窓・長穴・開放で逃がす。**

include <respeaker_lite_parts.scad>

$fn = 64;

// ============================================================
// 📄 基板そのもの（公式CADの外形）
// ============================================================
BOARD_L = 82.024;   // 📄 公式CAD。docs 1章の「86」は**張り出し込みの外形**
                    //    （82.024 ＋ ジャックの筒1.578 ＋ XIAOのUSB-C約3 ≒ 86.6）
BOARD_H = 34.007;   // 📄 公式CAD。✅ユーザー再実測の34と一致
BOARD_T =  1.85;    // ✅ ユーザー実測（2026-08-10・板厚ゲージv2の櫛・0.05刻み）
                    // 🔴 それまで公式CADの1.510を採っていたが、実物と0.34違った。
                    //    「板厚は基板の仕様値側が固い」という判断は誤り。旧実測1.25も誤測定。
                    //    傍証2つ: 穴Aペグ（当て面から2.21）の出しろが「ほぼ無い」＝2.21−1.85=0.36 ／
                    //    中央領域の実測4.8 ≒ 1.69+1.85+1.19=4.73（謎だった差0.42がほぼ消える）
BOARD_R =  1.27;    // 📄 四隅のR

function respeaker_L() = BOARD_L;
function respeaker_H() = BOARD_H;
function respeaker_T() = BOARD_T;
// 🔒 ピンヘッダー上段の頭（板の下端からの高さ）。**この板でいちばん高い実装。**
//    筐体はここを見て天井を決める（板の上端 BOARD_H ではない）
function respeaker_hdr_top() = HDR_Z[1] + HDR_T;

// 📄 取付穴 φ2.20（M2）。✅ 実物に2mmネジが通ることをユーザーが確認（2026-08-08）
HOLE_D = 2.20;
HOLE_A = [ 2.492, 31.577];   // 隅の穴（左2.492 / 上から2.430）
HOLE_B = [60.202,  2.657];   // もう一方（左60.202 / 下2.657）

// ============================================================
// 中央領域（左から32〜65）の総厚 — **休止姿勢を決める数字**
//    クレードルの後ろ壁はこの帯のXIAO面側の外形に面で当たる。そこが基準面なので、
//    基板が溝の中のどこに座るかはこの値だけで決まる。
//
//    📄 公式CAD  : XIAO面へ 1.69（C85）＋ 板1.51 ＋ マイク面へ 1.19（D1）= 4.38
//    ✅ ユーザー実測: 約4.8（ノギスのジョー・2026-08-04）
//
//    🔴 2026-08-08: 差0.42を「XIAO面のジャンパ線」として**厚さ2.11の板をこの帯に
//    描いていたが削除した**（ユーザー指摘）。理由が成り立たないため:
//    ジャンパは docs で「XIAO面の⑬から通してある」とされ、⑬のパッド列は公式CADで
//    **左から4.482〜30.222** ＝ **この帯(32〜65)の外**。⚠の上に⚠を積んだ板だった。
//    マイク面側にこの帯で載っているのは D1(1.19) と LED1(0.65) だけで、
//    ユーザーのはんだ箇所も無い。
//    ✅ 差0.42の正体はほぼ板厚だった（2026-08-10・板厚1.85の確定で決着）:
//    1.69 + 1.85 + 1.19 = 4.73 で、実測4.8との残差は0.07。測り方の差で足りる
//
//    ただし**設計は薄いほうに合わせない**。厚いほうが後ろ壁に当たるので、
//    基板は最大 0.07 だけ前に出うる（下の MEASURED）。前壁の位置はそれを見込む
// ============================================================
CENTER_X0 = 32.0;   CENTER_X1 = 65.0;    // 📄/✅ 一致
CENTER_BACK_CAD      = 1.69;             // 📄 素の基板。既定の姿勢はこちら
CENTER_BACK_MEASURED = 1.76;             // ✅ 実測 4.8 から逆算（4.8 − 板1.85 − 1.19）。
                                         //   板厚確定でCADの1.69とほぼ同じになった（旧2.10は板1.51前提）
CENTER_BACK = CENTER_BACK_CAD;           // -D CENTER_BACK=2.10 で厚い側の姿勢も試せる
function respeaker_center_back() = CENTER_BACK;
// 🔒 スピーカーソケット J2 の口（板の局所座標）。**筐体側が数字を書き写さないため**
//    返すのは [左, 右, 下, 上, 面からの出っ張り]。f=+1 なので XIAO 面側（-Y）へ出る
function respeaker_spk_j2() = let (p = cad_part("J2")) [p[2], p[3], p[4], p[5], p[6]];

// ============================================================
// ✅ XIAO本体＋ピンヘッダー（公式CADには入っていない・この機体で最も高い）
//    ソケットを挿した状態で X 2〜20、1列の厚み(Z)2mm、下から8mm の列と上から8mm の列。
//    📄 パッドの実際は 左2.932〜18.172・下から9.397と24.627（2.54ピッチ・φ0.89）だが、
//    ソケットの外形はそれより広いので ✅実測の 2〜20 を残す（広いほうが安全側）
// ============================================================
HDR_H  = 10.0;
HDR_X0 = 2.0;    HDR_X1 = 20.0;
HDR_T  = 2.0;
HDR_Z  = [8.0 - HDR_T / 2, BOARD_H - 8.0 - HDR_T / 2];
// XIAOのUSB-C（左端から張り出す）。ReSpeaker の公式CADには無く、XIAO の公式 STEP から（📄 1.53）
// 🔴 2026-08-22 まで「板の面に直に・下端 14」で描いていた。実際は**積み重ねの頭**
//    （XIAO 面から HDR_H ✅10.0）に載る。Z は XIAO がソケット2列の真ん中に載るので
//    板の高さの中央（USB-C は XIAO の幅の中央）。筐体の口はここから導く（case_v2 §4.3c）
// 📄 2026-08-22 Seeed 公式の XIAO ESP32S3 3D モデル（STEP）と寸法 DXF から:
//    ・レセプタクルは XIAO の板の端から **1.53** 出る（板の端 12.282 → 殻の先 13.809）
//    ・XIAO の板の端は ReSpeaker の左端とツライチ（ReSpeaker のパッド 2.932 − XIAO のピン〜端 2.921 = 0.01）
//    ・殻の幅の中心は板の幅の中心（中心 −6.119 ↔ 板 −6.111）⇒ Z はソケット2列の真ん中
//    ・積み重ねの頭は USB-C の殻（板の上 3.21）。シールド缶は 2.0 で、それより 1.2 高い
//    🔴 それまで 3.0 と書いていた（約 2 倍）
XIAO_USB_OUT = 1.53;  // 📄 板の左端からの張り出し（公式 STEP）
XIAO_USB_L   = 8.94;  // 📄 USB-C レセプタクルのシェル幅（規格）
XIAO_USB_H   = 3.26;  // 📄 同 厚み（規格）
XIAO_USB_Z   = (BOARD_H - XIAO_USB_L) / 2;   // 下端（板の高さの中央に置く）
// 🔴 2026-08-24 訂正: 殻は「積み重ねの頭」ではなく **XIAO の板の上**（XIAO は直付け）。面から 1.4〜4.66。
//    v2/v3 の右の壁の口はこの誤りで約 5.3 奥に開いていた。XIAO_TOP はこの下（XIAO_USB_H より後ろのブロック）で定義
XIAO_USB_Y0  = 0.2 + 1.2;                    // 面からの距離（＝XIAO_SOLDER + XIAO_BD_T。前方参照が効かないので同値を書く・出典は下のブロック）
// 筐体が読む: 面からの中心距離と、板の下端からの中心高さ [面から, Z]
function xiao_usb_yz() = [XIAO_USB_Y0 + XIAO_USB_H / 2, XIAO_USB_Z + XIAO_USB_L / 2];
function xiao_usb_sz() = [XIAO_USB_H, XIAO_USB_L];
function xiao_usb_out() = XIAO_USB_OUT;   // 筐体が ReSpeaker の X をこれで決める（case_v2 の RSP_X）

// 🔴 このブロックは XIAO_USB_H より後ろに置くこと（use<> 先では前方参照が効かず、XIAO_TOP が undef になって積み重ねが消えた・2026-08-24）
// ✅ 構成（2026-08-24 ユーザー写真＋説明。🔴 同日中に 2 回間違えた末の確定）:
//    **XIAO は ReSpeaker に直接はんだ付け（ソケット無し・浮き無し）。その XIAO の上にストレートのピンヘッダが立ち、線の DuPont はそこに挿さる。**
//    🔴 誤り①「塊 高さ10」: 挿す物が無かった。🔴 誤り②「ソケットで XIAO が 6.7 浮き、USB の殻が頭」: AI の作り話。
//    実物の鎖: はんだ 0.2（規格読み） ＋ XIAO の板 1.2（規格読み） ＝ 板の上面 1.4 → ヘッダ樹脂 2.5 → ピン 6.0 ＝ **先端 9.9 ≈ ✅実測 10**（標準部品で閉じる）。
//    線の DuPont（10 ✅）は樹脂の上に座る ⇒ 頭は面から 13.9・線の逃げ（曲がりの余白 3.6 既定）で 17.5。
//    🔴 これに伴い XIAO の USB-C は「積み重ねの頭」ではなく **XIAO の板の上（面から 1.4〜4.66）**。右の壁の口の Y はこれで決め直す（v2/v3 は約 5.3 奥に開けていた）
XIAO_SOLDER = 0.2;                           // 直付けのはんだの浮き（規格読み。積み上げの先端 9.9 が ✅実測 10 と合う）
XIAO_BD_T  = 1.2;                            // XIAO の板厚（規格読み。同上）
XIAO_TOP   = XIAO_SOLDER + XIAO_BD_T;        // 1.4 XIAO の板の上面（面から）
HDR_PL = 2.5; HDR_PIN_UP = 6.0;              // 2.54 ヘッダの樹脂・ピンの余り（規格。✅ ヘッダ単体の定規写真とも一致: 長い側 約 6〜7）
PAD_X = [for (k = [0 : 6]) 2.932 + k * 2.54];   // 📄 パッドの中心 7 つ
PAD_Z = [9.397, 24.627];                     // 📄 パッドの列（下から）
function respeaker_xiao_head() = XIAO_TOP + HDR_PL + 10.0;   // 13.9 線の DuPont の頭（面から。10 は ✅ ハウジングの高さ）
module respeaker_xiao_stack() {   // 恒久の積み重ね（XIAO 直付け・シールド缶・ヘッダ・ピン）。respeaker_lite() が呼ぶ
    color("#2f4f6f") translate([10.552 - 21.0 / 2, -XIAO_TOP, 17.012 - 17.5 / 2]) cube([21.0, XIAO_BD_T, 17.5]);             // XIAO の板 📄 21 × 17.5（パッドの中心に置く）
    color("#dcdcdc") translate([10.552 + 1.535 - 5.3, -XIAO_TOP - 2.0, 17.012 - 6.3]) cube([10.6, 2.0, 12.6]);              // シールド缶 📄 XIAO の公式 STEP（hardware/ref/cad/xiao_3d）: 10.6（長辺方向）× 12.6・高さ 2.0。板の中心から USB と反対側へ 1.535、幅方向は中央（2026-09-06 に読んだ。それまで 14 × 12 の仮）
    color("#222") for (z = PAD_Z) translate([PAD_X[0] - 1.27, -(XIAO_TOP + HDR_PL), z - 1.27]) cube([7 * 2.54, HDR_PL, 2.54]);   // ヘッダの樹脂（XIAO の上）
    color("#c8ccd0") for (x = PAD_X, z = PAD_Z) translate([x - 0.32, -(XIAO_TOP + HDR_PL + HDR_PIN_UP), z - 0.32])
        cube([0.64, XIAO_TOP + HDR_PL + HDR_PIN_UP, 0.64]);                                                                  // ピン（先端 9.9 ≈ ✅10）
}
// ✅ 挿すのは使う 7 本だけ（POWER.md 4章: 5V・D3・GND・3V3・SCL・SDA・D2）。
//    📄 XIAO の公式ピン配置: 電源側の列は USB 端から 5V・GND・3V3（スロット 0〜2）、
//    信号側の列は D0〜D6 で、使うのは D2・D3・D4(SDA)・D5(SCL)（スロット 2〜5）。残り 7 ピンは裸のまま。
//    🔒 2026-09-06 電源側は**上の列（24.627）**。公式の図（USB-C を上）で 5V・GND・3V3 は右の列。USB-C を左にして見ると右の列が上に来る。マニュアル手順 2 と一致。
//    🔴 それまでは「未確認。入れ替わっても当たりに効かない」と書いて下の列に置いていた（当てずっぽう）。効かないも誤りで、3 本と 4 本の X と曲がる向きが入れ替わる。
XIAO_USED = [[2, 3, 4, 5], [0, 1, 2]];   // [下の列（9.397）= 信号 D2・D3・SDA・SCL, 上の列（24.627）= 電源 5V・GND・3V3]（USB 端＝局所 x の小さい側から数える）
// 🔴 2026-09-05 ハウジングの長さは直書きの 10.0 だった（ヘッダの値をハウジングに書いた誤り。ユーザー「ハウジングは 14」）。
//   この file は parts.scad を読めない（parts.scad がこちらを読む）ので、呼ぶ側が HOUS_H（＝parts.scad の DUPONT_H）を渡す。既定値は置かない。
module respeaker_xiao_housings(bend = true, hous_h) color("#63b3ed", 0.85)
    for (r = [0, 1], k = XIAO_USED[r]) { x = PAD_X[k]; z = PAD_Z[r];
        translate([x - 1.27, -respeaker_xiao_head(), z - 1.27]) cube([2.54, hous_h, 2.54]);
        if (bend) translate([x - 1.8, -respeaker_xiao_head() - 3.6, z - 1.8]) cube([3.6, 3.6, 3.6]);   // 線の逃げ（曲がりの余白 既定 3.6）
    }

// ---------------- 自動生成データの参照 ----------------
// PARTS_CAD の1行 = [ ref, f, x0, x1, z0, z1, 出っ張り ]
function cad_part(ref, f = 1) =
    [for (p = PARTS_CAD) if (p[0] == ref && p[1] == f) p][0];

// ---------------- 描画 ----------------
// f: -1 = マイク面側へ出る（+Y） / +1 = XIAO面側へ出る（-Y）
module face_box(x0, x1, z0, z1, h, f) {
    y = (f > 0) ? -h : BOARD_T;
    translate([x0, y, z0]) cube([x1 - x0, h, z1 - z0]);
}

module cad_box(p) { face_box(p[2], p[3], p[4], p[5], p[6], p[1]); }

module board_only() {
    difference() {
        // 📄 四隅R1.27
        // 注: 向きに注意（2026-08-08にここで一度事故った）:
        //   rotate([-90,0,0]) だと押し出し方向は +Y で合うが、**2Dの縦が -Z に写る**ので
        //   基板が下向きに伸びる。rotate([90,0,0]) で 2Dの縦を +Z にし、
        //   -Y へ出る厚みぶんを translate で戻す。checkテストがこの誤りを検出した
        translate([BOARD_R, BOARD_T, BOARD_R]) rotate([90, 0, 0])
            linear_extrude(BOARD_T)
                offset(r = BOARD_R) square([BOARD_L - 2 * BOARD_R, BOARD_H - 2 * BOARD_R]);
        for (p = [HOLE_A, HOLE_B])
            translate([p[0], -1, p[1]])
                rotate([-90, 0, 0]) cylinder(d = HOLE_D, h = BOARD_T + 2);
    }
}

module respeaker_lite() {
    color("#2b6b3f") board_only();

    // 📄 公式CADの部品 212個（マイク面は6個しかない）
    // J1（3.5mmジャック）だけ除外して下で置き直す
    for (p = PARTS_CAD) if (p[0] != "J1")
        color(p[1] < 0 ? "#c33" : "#555") cad_box(p);

    // 📄 J1（3.5mmジャック）: バウンディングボックスだと丸い胴が角箱になり、
    // レール（上端2.5）と8.66mm³の偽の当たりが出た。STEPの頂点を下から0.2mm刻みで
    // 見たところ、**胴は下から3.40より上**で、それより下（2.18〜3.40）にあるのは
    // 出っ張り0.24mmのハンダ足だけだった。✅ユーザー実測の「ジャック下端3」とも合う。
    // レールに当たるには2.11mm以上出ている必要があるので、足は当たらない
    // 📄 2026-08-25 STEP の実体から取り直し（ユーザー「モデルが間違ってる。CAD が公開されてるのに」。
    //    旧: 胴＋筒をまとめた角箱 → 筒が角箱＝筐体の口が「大穴」になった）:
    //    ・胴 = x 66.60〜82.024・下から 3.51〜9.51・面から 5.19
    //    ・筒 = **丸**。外径 φ5.45（穴 φ3.6）・軸 [下から 6.502, 面から 2.485]・板の端から 1.576 出て x 83.60 まで
    //    ・+Y の金属カバー = x 82.25〜82.70（端から 0.68 出る）・下から 3.65〜8.90・面から 3.14〜7.52
    color("#555") {
        face_box(66.60, 82.024, 3.51, 9.51, 5.19, +1);                                   // 胴（📄 CAD bbox）
        translate([82.0, -2.485, 6.502]) rotate([0, 90, 0]) cylinder(d = 5.45, h = 83.60 - 82.0, $fn = 48);   // 筒（丸・📄）
        translate([82.25, -7.52, 3.65]) cube([82.70 - 82.25, 7.52 - 3.14, 8.90 - 3.65]); // 金属カバー（📄）
        face_box(72.65, 81.05, 2.18,  3.40, 0.24, +1);                                   // ハンダ足
    }

    // ✅ XIAO の積み重ね（公式CADに無い）。🔴 2026-08-24 まで「塊 2 列 × 高さ 10」だった。
    //    実物は直付け XIAO の板 → 貫通ヘッダ（ユーザー説明）。線の DuPont は respeaker_xiao_housings()（別モジュール・挿した状態で頭 13.9 ＝ respeaker_xiao_head()）
    respeaker_xiao_stack();

    // XIAOのUSB-C（左端から張り出す・XIAO面側）。🔴 2026-08-24: 頭ではなく XIAO の板の上に置き直した
    color("#9cf") translate([-XIAO_USB_OUT, -(XIAO_USB_Y0 + XIAO_USB_H), XIAO_USB_Z])
        cube([XIAO_USB_OUT, XIAO_USB_H, XIAO_USB_L]);
}

// 上方向の印（単体表示のときだけ。OpenSCADの視点で上下を取り違えないため）
module up_marker() {
    color("#d22") translate([BOARD_L / 2, BOARD_T / 2, BOARD_H + 4]) {
        cylinder(d = 1.5, h = 5);
        translate([0, 0, 5]) cylinder(d1 = 5, d2 = 0, h = 5);
    }
}

// 面のラベル（単体表示のときだけ）。XIAO面側から見ると「XIAO」と読める。
// **鏡文字に見えたら、いま見ているのはマイク面（裏）。**
module face_label() {
    color("#d22") translate([BOARD_L / 2 - 10, -0.5, BOARD_H + 3])
        rotate([90, 0, 0]) linear_extrude(1) text("XIAO", size = 6);
}

respeaker_lite();
up_marker();
face_label();
