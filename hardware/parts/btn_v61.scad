include <mat.scad>   // 材料のスイッチ（case と同じ 1 行を読む）
function btn_mat() = mat_name();
// ============================================================
// 会話ボタン v6.1n — parts/btn_v3.scad の写し（v6.1n・MJF ナイロン用）
//   🔒 ユーザー 2026-09-14: v5 と共用のファイルは触らない。ナイロン用の直しはこの写しだけに入れる。
//   MJF PA12（JLC3DP）: 公差 ±0.3・穴の公差 ±0.3・組む隙間 0.76 以上・最小肉 1.0
// ============================================================
// 🔒 2026-09-07 本番。btn_v3_trial.scad（試し刷り 0537・1632 で決めた形）をそのまま本番に戻した物（ユーザー「会話ボタンの再設計を行いました。バスタブはテストで印刷したものを使えるので押し子を追加」）。刷る押し子は print_piston2（根元寄りの線・P2_CUT 0.8・台形の足）。バスタブは 0537 の物
//   直した所（ユーザー 2026-09-07 実物）: ①レバーの曲がり始めは胴の端から 1.5（B3_BEND）。図面に寸法は無く、btn_v3 は端で描いていた
//   ⇒ 先が 6.75 → 8.25 に出るので、バスタブの内のりを先から 0.75 空ける形で出す（15.0 → 18.0・外形 21.2）
//   ⇒ 外形が広がるとブロックの内面（B3_BLK_XI）も外へ出て、v5 で足した下側の内面 B3_BLK_XI2 は同じ値になり、ツバ 19.8 の通り道が 18.6 → 21.6 に戻る
//   ⇒ ヒンジが内へ寄ったぶん柱の所のてこ比が 0.696 → 0.585 になり、柱の出 1.6 では先がツバに 0.15 まで寄るので 1.9 に
//   ⇒ ブロックが薄くなるので縦ねじの芯を 13.1 → 13.28 に（ナットの溝の内側の肉 0.42 を残す）
//   刷る物は print_piston / print_tub の 2 点。STL は hardware/stl/trial/ に出す（v5 の STL は上書きしない）
// 🔒 2026-09-07 試し刷り（刷り台 0537: ミニ天板・バスタブ・押し子 1・押し子 2）の実機の結果（ユーザー）:
//   ・押し子 1 を設計の向き（ポッチが先端側・接点 4.35）で付ける … 押せない
//   ・押し子 2（根元側の線・接点 1.0・予圧 0.8・足 0.77）      … 押せない
//   ・押し子 1 を逆（ポッチが根元側・接点 −0.95）で付ける      … 押せて感触が良い（跳ね返りが強い）
//   ⇒ 深く当てた物ほど押せない。実物のレバーはこのファイルの直線（曲がり始め 1.5 から先端 10.5 へ一直線）より
//     接点の辺りで 1.0〜1.5 高い（正しい向きが押せない下限 1.0・逆が鳴る上限 1.5）。写真では根元で急に立ち上がる形。測ってはいない
//   ⇒ その後（同日）ユーザー: バスタブのねじを 2 周緩める（0.8 下げる）と押し子 2 も押せる。足の Y の端を台形に削ると長辺の縁の渋さも消えた
//   ⇒ 🔒 **決定「これで行く」**（ユーザー「0.8mm 押し子のバーを削る・足を台形にする」）: 押し子 2 の線を 0.8 短く（P2_CUT）・足の端を台形。バスタブは 0537 の物のまま。
//     逆付けの押し子 1 は同じ深さで偶然合っていた物。模型（scratchpad/btn_sim*.py）はレバーを 0.8〜1.0 上げて合わせ直すこと
use <parts.scad>   // 借りるのは DAOKAI マイクロスイッチの実測値（msw_*）と絵（microswitch_daokai）だけ。
                   //   `use` なので変数は入って来ない。世界の座標（BTN4 / Z_TOP）もここには一切無い。
// ============================================================
// 📦 btn_v3.scad — 会話ボタン v3（レバー式マイクロスイッチ・2026-08-30）
//    原点 = ボタンの芯 ／ z = 0 は天板の外面 ／ +Z が外（空の方）
//    刷る物 2 点（押し子・バスタブ）。買い物 0（M2 x 4 とナット x 4 は手持ち）。
// ============================================================
//
// ============================================================
// ✅ 実機で確かめた（2026-08-31・btntest 初刷り・レジン①）
//   ・押し心地 … ユーザー「最高。これは凄い」。指の動く量 1.44mm でクリック、
//     残り 0.51mm はツバの部屋の底が受ける（レバーは押し切られない）
//   ・抜けない … ✅ 引いても抜けない（ツバの掛かり 片側 0.5 → 焼いて 0.8）
//   ・落ちない … ✅ 押しても中へ落ちない（ツバ 19.8 ＞ バスタブの内のり 15.0）
//   ・ツバの下面 … ✅ **支え無しで荒れない**（片側 0.9mm の庇・7.56mm2 は垂れなかった）。
//     押し子には柱もラフトも付けない（顔を下にして刷るので跡が縁に残るため）
//   ・傾き … ✅ 約 12° 傾くが引っかからない。ユーザー「傾いても押せてきもちいい」
//   ⇒ **この 4 つはもう検討し直さなくてよい。**
// ============================================================
//
// ■ v2 が死んだ理由
//   天板の **1 つの穴が、ツバを「通す」役と「引っ掛ける」役を兼ねていた。**
//   通れば抜け、抜けなければ通らない。実機 2026-08-30「押し子が落ちない」→「落とせるように
//   したら抜け放題」は、この 1 点から出た症状で、隙間の詰め方の問題ではなかった。
//
// ■ v3 の作り —— 🔒 ユーザー案（2026-08-30・スケッチあり）
//   **押し子を下から通す。** 頭は天板の口を下から抜けて外に出る。ツバは口より広いので
//   **天板の肉そのものの裏に掛かる**。抜け止めに追加部品は要らない。
//   筒は天板から切り離して**バスタブ**（別部品）にし、天板の裏から下ろした**ブロック 2 個**
//   （＝羊羹 2）へ、**下から縦ねじ 2 本**で引き上げて留める。
//
//   組む姿勢: **天板を裏返して机に置く**（箱の中で見えないままやる作業をゼロにする）
//   ① 裏返した天板の口へ押し子を落とす（重力で座る）
//   ② バスタブにマイクロスイッチをねじ止め（M2 x 2）… **机の上・単体でできる**
//   ③ ブロックのナットを横から差す（2 個）
//   ④ バスタブを載せ、下（＝机の上では上）から M2 x 2 を耳に通してナットへ締める
//
//   落ちない … ツバ 19.8 はバスタブの内のりより広い。**中へ入る道が無い**
//   抜けない … ツバ 19.8 は天板の口 18.8 より広い。**外へ出る道も無い**
//   押し心地 … バネはレジンではなく**スイッチのレバー自身**。てこ比 0.696
//   🔒 たわむ部品ゼロ・圧入ゼロ・接着ゼロ。docs/PRINT.md「レジン①で板バネは作れない」に触れない
//
// ■ 🔴 ここまでに潰した 3 つの間違い（同じ穴に落ちないため）
//   ① カバーを皿へ圧入 … 公差に頼る留め方。v2 で 4 回外したのと同じ性質。取り下げ
//   ② カバーに脚を生やして横ねじ … 2.4mm の板に脚と M2。薄すぎる。取り下げ
//   ③ 横ねじ 2 本を同じ軸に並べる … ユーザー指摘「ねじを支点にしたブランコになる」。その通り。
//      横ねじはバスタブを天板へ**押し付けない**ので、止まるのは摩擦だけだった
//   ⇒ 縦ねじだけが「バスタブを天板の裏へ**引き上げる**」向き。面 1 つ＋離れたねじ 2 本で決まる
//   🔴 ナットは「ねじの軸方向に掘ったポケット」に入れるものではない。**床の上に載せて、
//      締める力で床へ押し付ける**（横から差し込む溝）。ここを取り違えて一度縦ねじを取り下げた
//
// ■ 🔒 守っている条件
//   ① ネジを表面に出さない ⇒ 天面に出るのは押し子の頭だけ
//   ② 頭が AS5600 のつまみ（+5.5）より高くならない ⇒ 頭の天面は +3.0
//   ③ 🔒 **バスタブの上は全開**。スイッチはレバーごと上から落とすので天井側に張り出しを作らない
//   ④ 🔒 **留めは 2 か所**。1 か所で持たせない
//   ⑤ 🔒 **棚（本当の L 字）を作らない**（ユーザー「印刷的には棚の形状にしない方が良い」
//      「羊羹みたいな直方体が一番」）。ブロックは天板の裏に付く**薄い直方体**
//   ⑥ ねじの頭は耳の下面にザグって沈める。バスタブの底より下へは何も出ない（深さが増えない）
//      🔴 2026-08-30 ここに「🔒 耳はバスタブの一番上（ユーザーの絵）」と書いていたが、**指示ではない**。
//        ユーザー「耳はバスタブの一番上なんて指示はしてません。なんとなくその方が線の通りが
//        良いだろうと思ったから」。⇒ 🔒 を外す。耳の高さはブロックの厚みで決まる従属値
// ============================================================


// ============================================================
// 1. 印刷の見込み（🔒 docs/PRINT.md 実績値。ここを触ると全部の嵌め合いが動く）
// ============================================================
//   ✅ **2026-09-02 実機で確定**（ELEGOO・回 0540 の六角ゲージ）。
//     ユーザー「正直全部入るのでもういいです。５あたりで良いと思います」。印 5 = 二面幅 4.10。
//     ⚠ 測れたのは **A（上から落とす袋穴）だけ**。B（横差し）は口を連結棒で塞いでいて 1 個も
//       入らなかった（ゲージの設計ミス）。横差しの値は未測定のまま、同じ 4.10 を使っている。
B3_SHRINK   = nylon() ? 0.50 : 0.10;  // v6.1n: 0.10 → 0.50。レジンの実績 0.10 は自分の機械の話で、MJF は穴の公差が ±0.3。呼び 4.0 に対し二面幅 4.50 になる
B3_FIT_MOVE = 0.40;  // 動く所の片側の隙間。v6.1n でもこの値のまま（片側 0.40 ＝ 直径 0.80 で、JLC3DP の「組む隙間 0.76 以上」を満たす）
B3_FIT_POCK = 0.15;  // 金属を入れて動かさない所（見込みだけ）


// ============================================================
// 2. スイッチ（DAOKAI ヒンジストレートレバー 3PIN）
// ============================================================
B3_SW    = msw_size();          // [12.8, 5.8, 6.5] 胴
B3_BEND  = 1.5;                 // 🔒 ユーザー 2026-09-07 実物: レバーの曲がり始めは胴の端から 1.5（図面には無い寸法）
B3_HINGE = -B3_SW[0] / 2 + B3_BEND;   // -4.90 ヒンジ（COM 端子側 = -X の端から 1.5 内）
B3_PIN_LEN   = 3.5;             // ✅ 端子は図面のまま。ニッパーで詰める工程は無い
B3_SW_HOLE_Z = 2.0;             // ✅ 胴の底から取付穴の芯（ユーザー実測）

function b3_lever_z(x) = msw_bot_h() + (msw_act_h() - msw_bot_h()) * (x - B3_HINGE) / msw_lever_l();

B3_SW_DX = -0.35;   // 胴の位置は btn_v3 と同じに固定（ポケット・ねじ・端子・柱の位置を動かさない）。振りの中心を芯に置く式は捨てた
B3_TIP_X = B3_HINGE + msw_lever_l() + B3_SW_DX;      // +6.75 レバー先端（ボタンの芯から）

B3_PUSH_X = 3.0;                                     // てこ比を決める唯一のつまみ
B3_RATIO  = (B3_PUSH_X - B3_HINGE) / msw_lever_l();  // 0.696
B3_CLICK  = msw_click()  * B3_RATIO;                 // 1.74
B3_FULL   = msw_travel() * B3_RATIO;                 // 2.78


// ============================================================
// 3. 顔（天板の口・押し子）
// ============================================================
B3_PLATE_T = 2.5;    // 天板の厚み（case_base.scad の TOP_T と同じ値。ここは形だけを持つ）
// 🔒 2026-08-30 **皿（口の手前の浅い凹み）は廃止**。ユーザー「外のベベルを埋めるのが難しいと？」
//   つまみの顔は「口が板を真っ直ぐ貫いて、縁に 0.3 の面取り」だけ。私はその手前にもう 1 段
//   皿（深さ 0.8）を入れていたので段が 3 つになり、つまみと顔が違って見えていた。
//   ⇒ 皿を埋める。ツバが掛かる肉は 1.70 → **2.50**（板の全厚）に増える。
B3_LIP_T   = B3_PLATE_T;   // 2.50 ツバが掛かる肉の厚み（板の全厚）

// 🔒 2026-08-30 顔を 18.0 → 15.0 に縮めた。ユーザー「ボタンサイズを小さくすれば当たらないんじゃないの？」
//   実測: 顔 15.0 で INA226 の板への当たりが 0 になる（18.0 では 2.22）。買った物（INA226・
//   ReSpeaker 基板・OLED）が全部 0 になるのはこの位置・この寸法だけ。
//   ⚠ 下限は 14.0。ツバ（顔 +1.8）がバスタブの内のり 15.0 より広くないと押し子が中へ落ちる。
//   ⚠ Y へ逃がす案は成立しない: -1 から OLED に当たり始め、-3 で ReSpeaker の基板に 17mm 食い込む。
//   🔄 2026-08-30 **v2 と同じ 18.0 x 12.0 に戻した。**
//   🔴 それまで「顔は 15.0 が限界」と言っていたが、止めていたのは INA226 ではなく
//     **私が決めた 2 つの数字**だった（ユーザー「なんか引っかかるな」で判明）:
//       ① バスタブの ±X の壁 1.6 → 外形 18.2。ツバの部屋（顔 +2.6）がこれより広くなると
//          バスタブの天面が座に載れず、部屋の中に落ちる。だから顔が 15.6 で頭打ちに見えていた
//       ② 座の枠 3.6。座が外へ張り出して INA226 の板に届いていた
//     ⇒ 壁を 3.0（外形 21.0 ＞ 部屋 20.6）、枠を 1.2 にすれば **18 x 12 で全部 0**。実測済み。
B3_HEAD_L = 18.0; B3_HEAD_W = 12.0; B3_HEAD_OUT = 3.0;   // 頭（天面から +3.0 出る）
B3_OPN_L  = B3_HEAD_L + B3_FIT_MOVE * 2;                // 18.80 天板の口（頭が下から抜けて上下に滑る）
B3_OPN_W  = B3_HEAD_W + B3_FIT_MOVE * 2;                // 10.40
// 🔒 2026-08-30 ユーザー「ボタンのベベルがつまみの顔と異なるので**つまみを正として**揃えて」。
//   つまみは knob_v5.scad の ch_hole_top(DISH_D/2, 0, CH_S) ＝ **45°・0.3mm**（CH_S = 0.3）。
//   ここは 0.4 で描いていたので 0.3 に合わせる。⚠ 数字の出どころは knob_v5.scad の CH_S。
//   btn_v3 は筐体を読まない約束なので値は写しで持つ。あちらを変えたらここも直す。
B3_BEVEL  = 0.3;                                        // 皿の縁の面取り（つまみと同じ 45°・0.3）
// 🔒 つまみの顔は **2 段**だった（ユーザー「どう見ても 2 段ベベルです」）。
//   ① 天板の口の縁 … ch_hole_top(..., CH_S=0.3)
//   ② **つまみ自身の頭の角** … ch_top(..., GRIP_CH=0.8) ／ 裾の角は ch_bot(..., CH_S=0.3)
//   ボタンは①しか無く、頭の角が立っていた。つまみを正として②を入れる。
// 🔒 2026-08-30 ユーザー「斜めに押されてしまうのでレールが必要。多少の遊びは必要なのでゆるめに」。
//   🔴 リブで隙間を詰める案は**取り下げ**。滑る嵌め合いの製図値は片側 0.40（見込み 0.30 ＋ 滑り 0.10）が
//     下限で、リブでそれ以下にすると焼いた時点で噛む。**レールでは遊びを減らせない。**
//   ⇒ 減らせるのは遊びではなく**傾き**。効くのは「案内する長さ」なので、頭の断面を
//     ツバの部屋の底まで下ろして、案内の長さを 2.5 → 5.65mm にする（＝下の裾）。
B3_HEAD_CH = 1.2;   // 頭の天面の角（＝つまみの GRIP_CH）。🔒 ユーザー 2026-09-05「1.2 に」: 天面を下にして刷ると 0.8 の面取りが初期層のにじみと下向き面の Z ずれで埋まり、現物の角が立った
B3_HEAD_CB = 0.3;   // 頭の裾の角（＝つまみの CH_S）

// ツバ = 「抜けない」を持つ唯一の面。口より **X だけ** 広くする（Y へ広げない）
B3_CATCH = 0.5;                          // 掛かり（片側・呼び）。焼くと 0.8 になる
B3_FLG_L = B3_OPN_L + B3_CATCH * 2;      // 19.80
// 🔴 2026-08-30 ここを 9.0 の直書きにしていたため、顔を Y に縮めると口より広くなって
//   assert に当たり、「縮められない」ように見えていた。口から引く形にして顔に追従させる。
B3_FLG_W = B3_OPN_W - 1.4;               // Y は掛からない（口より片側 0.7 狭い）
B3_FLG_T = 1.2;

B3_TRAVEL   = 1.95;   // ハードストップ（レバーではなくツバの部屋の底が受ける）
B3_PILLAR_D = 3.4;    // レバーを押す柱の径
B3_PILLAR_H = 1.9;    // 柱の出。1.6 だとヒンジが内へ寄ったぶん先がツバに 0.15 まで寄る（assert 0.30）


// ============================================================
// 4. Z の積み上げ
// ============================================================
B3_Z_LIP_B = -B3_PLATE_T;                      // -2.50 天板の裏 ＝ ツバの座
B3_Z_FLG_B = B3_Z_LIP_B - B3_FLG_T;            // -3.70 ツバの下面（自由状態）
B3_Z_WIN_B = B3_Z_FLG_B - B3_TRAVEL - 0.10;    // -5.75 ツバの部屋の底 ＝ バスタブの上端
// 🔒 予圧: レバーが常にツバを天板の裏へ押し付けている状態にする（0 だとカタつく）
B3_PRELOAD  = 0.3;
B3_Z_SW_BOT = B3_Z_FLG_B - B3_PILLAR_H - b3_lever_z(B3_PUSH_X) + B3_PRELOAD;   // -14.14（バスタブは 0537 で刷った物のまま。レバーの較正は押し子の側 P2_CUT に入れる）
B3_Z_SW_TOP = B3_Z_SW_BOT + B3_SW[2];          // -7.785
B3_SKIRT    = nylon() ? 1.3 : 0.8;                             // 端子と線の逃げ ＝ バスタブの床の厚み。v6.1n 2026-09-15: 0.8 → 1.3（MJF の最薄 0.8・壁 1.2。0.8 の床は境界で、スイッチのねじのナットの座の下の床も 0.55 しか無かった → 1.05）。底が 0.5 下がる（筐体の逃げは元から底の 1.0 下まで・btn3_keepout）
B3_Z_TUB_B  = B3_Z_SW_BOT - B3_SKIRT;          // -15.085 バスタブの底（world の下限に効く）
B3_FINGER_CLICK = B3_CLICK - B3_PRELOAD;       // 指が動く量（予圧のぶんは既に食われている）
// レバーの先の高さ（予圧のぶん柱が押す点を下げているので、先端は 予圧/てこ比 だけ下がる）
B3_TIP_Z = B3_Z_SW_BOT + b3_lever_z(B3_TIP_X - B3_SW_DX) - B3_PRELOAD / B3_RATIO;
// 裾（レール）の下端。押し切っても部屋の中に留まる高さ。
//   🔴 2026-08-30 これを「3. 顔」の節（Z の積み上げより**前**）に置いたら、参照先がまだ無くて
//     押し出しの高さが負になり、押し子が高さ 100mm の柱になった（ユーザー「立派に育ちましたね」）。
