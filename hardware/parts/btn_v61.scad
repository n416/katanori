function btn3_tub_ox()  = B3_TUB_OX;
function btn3_tub_oy()  = B3_TUB_OY;
function btn3_tub_y0()  = B3_TUB_Y0;
function btn3_tub_y1()  = B3_TUB_Y1;
function btn3_pad_l()   = B3_PAD_L;
function btn3_pad_w()   = B3_PAD_W;
function btn3_blk_xo()  = B3_BLK_XO;       // 箱の中で一番外へ出る X（±）
function btn3_tub_z0()  = B3_Z_TUB_B;      // 下へはここまで
function btn3_v_scr_x() = B3_V_SCR_X;

module btn3_keepout() {                     // 支柱の禁止区域（外から手が入らない所）
    translate([0, 0, B3_Z_TUB_B - 1])
        b3_box(B3_BLK_XO * 2 + 1.0, B3_TUB_OY + 1.0, B3_TUB_R, B3_Z_LIP_B - B3_Z_TUB_B + 1, B3_TUB_CY);
}


// ============================================================
// 13. 刷る向き（どちらも平らな面をベッドへ・庇ゼロ）
// ============================================================
module btn3_piston_print() translate([0, 0, B3_HEAD_OUT]) rotate([180, 0, 0]) btn3_piston();

// ============================================================
// 8b. 押し子 2（🧪 2026-09-07・ユーザーが「いい」と言った逆付け＝根元寄りの接点を設計にした物）
//   剛体の押し子＋天板の裏・部屋の底・口の遊び・レバーの接触で解いた地図（scratchpad/btn_sim*.py）から:
//   ・接点は芯のすぐ根元側 P2_X = 1.0（先端側の縁）。どこを押しても鳴る深さが 0.84〜1.19 に揃う。力は 59〜200gf
//   ・ポッチは Y に 4.0 の線（幅 1.2）。長辺の縁を押しても真ん中と同じ動き
//   ・予圧 0.8（先端）。逆付けの押し子は接点が 0.77 浮いていてバスタブが座るとカタつくので埋める
//   ・ツバの裏の両端に足（高さ P2_FOOT）。ハードストップを浅くして、レバーが胴に着く前に止める。足はバスタブの壁の上（X 9.0〜9.9）に着く
//   バスタブは試しの物のまま。頭・ツバ・裾は押し子 1 と同じ
// ============================================================
P2_X    = 1.0;    // 接点（線の先端側の縁・ボタンの芯から）
P2_W    = 1.2;    // 線の X 幅
P2_LY   = 4.0;    // 線の Y 長さ（レバーの幅 4.6 の中）
P2_PRE  = 0.8;    // 予圧（レバーの先端で）
P2_R    = (P2_X - B3_SW_DX - B3_HINGE) / msw_lever_l();                       // 0.463 接点のてこ比
P2_CUT  = 0.8;    // 🔒 ユーザー 2026-09-07 実機: 実物のレバーはこのファイルの直線より高い。バスタブのねじを 2 周（M2 × 0.4 × 2 ＝ 0.8）緩めると押し子 2 が押せた ⇒ 線を 0.8 短く
P2_ZB   = B3_Z_SW_BOT + b3_lever_z(P2_X - B3_SW_DX) - P2_PRE * P2_R + P2_CUT;   // -5.36 線の底（直線のレバーより予圧ぶん下・そこから 0.8 上げる）
P2_H    = B3_Z_FLG_B - P2_ZB;                                                // 2.46 線の出
P2_FULL = (msw_travel() - P2_PRE) * P2_R;                                    // 1.48 接点でレバーが胴に着くまで
P2_TRAVEL = P2_FULL - 0.2;                                                   // 1.28 ハードストップ（0.2 手前）
P2_FOOT = (B3_Z_FLG_B - B3_Z_WIN_B) - P2_TRAVEL;                             // 0.77 足の高さ
P2_CLICK = (msw_click() - P2_PRE) * P2_R;                                    // 0.79 真っ直ぐ押したとき鳴るまでの指
P2_FOOT_X0 = B3_TUB_IX / 2; P2_FOOT_X1 = B3_FLG_L / 2;                       // 9.0〜9.9 足が載るバスタブの壁の上
P2_FOOT_Y0 = B3_TUB_Y0 + 0.3; P2_FOOT_Y1 = min(B3_TUB_Y1, B3_FLG_W / 2) - 0.3;   // 壁の上に収まる Y
module btn3_piston2() color("#8fb4d9") {
    btn3_head();
    translate([0, 0, B3_SKIRT_Z]) b3_ob(B3_HEAD_L, B3_HEAD_W, B3_Z_LIP_B - B3_SKIRT_Z);
    translate([0, 0, B3_Z_FLG_B]) b3_box(B3_FLG_L,  B3_FLG_W,  1.0, B3_FLG_T);
    translate([P2_X - P2_W, -P2_LY / 2, P2_ZB]) cube([P2_W, P2_LY, P2_H + 0.01]);              // 線
    // 足 2 本。🔒 ユーザー 2026-09-07「足の角を台形にするだけで渋さはなくなった」: Y の両端を 45° で削る（削った角度は未記録・45° で描く）。
    //   帯のままだと長辺の縁を押して傾いたとき帯の端が先に壁に着いて渋い。台形なら端が逃げて、鳴ってから着く
    for (sx = [-1, 1]) mirror([sx < 0 ? 1 : 0, 0, 0])
        translate([P2_FOOT_X0, 0, B3_Z_FLG_B]) rotate([90, 0, 90])
            linear_extrude(P2_FOOT_X1 - P2_FOOT_X0)
                polygon([[P2_FOOT_Y0, 0.01], [P2_FOOT_Y1, 0.01], [P2_FOOT_Y1 - P2_FOOT, -P2_FOOT], [P2_FOOT_Y0 + P2_FOOT, -P2_FOOT]]);
}
module btn3_piston2_print() translate([0, 0, B3_HEAD_OUT]) rotate([180, 0, 0]) btn3_piston2();
echo(str("btn_v3 押し子 2: 接点 ", P2_X, "（てこ比 ", P2_R, "）／線の出 ", P2_H, "／予圧 ", P2_PRE, "／鳴るまで ", P2_CLICK,
         "／ハードストップ ", P2_TRAVEL, "（足 ", P2_FOOT, "）／胴に着くまで ", P2_FULL));
assert(P2_CLICK < P2_TRAVEL, "押し子 2: クリックより先にハードストップ");
assert(P2_TRAVEL < P2_FULL, "押し子 2: ハードストップより先にレバーが胴に着く");
assert(P2_X + 0.0 < B3_TIP_X - 0.5 && P2_X - P2_W > B3_HINGE + B3_SW_DX + 0.5, "押し子 2: 線がレバーの外");
assert(P2_FOOT_Y1 - P2_FOOT_Y0 > 3, "押し子 2: 足の Y が短い");
module btn3_tub_print()    translate([0, 0, -B3_Z_TUB_B]) btn3_tub();
module btn3_station_print() rotate([180, 0, 0]) btn3_top_slice();   // 🧪 ミニ天板（口・部屋・腕・ナットの溝）。外面を下にして刷る。押し子とバスタブを机の上で組んで試すための物


// ============================================================
// 14. 単体で開いたときの絵（🔒 スイッチは part 一本）
// ============================================================
// ---- part の一覧（UI・消さない）----
//   絵   : look（組んだ姿）/ explode（分解）/ press（クリックまで押した姿）
//   断面 : secx（レバーの伸びる X-Z 面）/ secy（ねじの Y-Z 面）
//   部品 : p_piston / p_tub / p_station（天板側）/ p_sw
//   刷る : print_piston / print_tub     ← **刷る物は 2 点**（試し: print_piston2 / p_piston2 ＝ 根元寄りの線の押し子）
//   none : 何も出さない（他のファイルから include したとき）
part = "explode";
BTN3_SOLO = true;

module btn3_top_slice() color("#c9d0d8") difference() {   // 天板の切れ端（絵のため・部品ではない）
    union() {
        translate([0, 0, -B3_PLATE_T]) b3_box(B3_BLK_XO * 2 + 4, B3_PAD_W + 8, 2.0, B3_PLATE_T);
        btn3_station_add();
    }
    btn3_station_cut();
}
module btn3_scene(ex = 0, dn = 0) {
    btn3_top_slice();
    translate([0, 0, -ex * 8])  btn3_piston(dn);                    // ① 下から口へ
    translate([0, 0, -ex * 24]) { btn3_tub(); btn3_sw_screws(); }    // ④ バスタブを載せて縦ねじ
    translate([0, 0, -ex * 16]) btn3_switch(dn / B3_RATIO);          // ② スイッチは上からバスタブへ
    btn3_v_screws(ex * 34);                                          // 縦ねじ 2 本（下から）
}
module btn3_half(ax) difference() {
    children();
    if (ax == "x") translate([-60, -100, -60]) cube([120, 100, 120]);   // -Y を落とす ⇒ X-Z の断面
    else           translate([-100, -60, -60]) cube([100, 120, 120]);   // -X を落とす ⇒ Y-Z の断面
}
if (BTN3_SOLO) {
    if (part == "look")         btn3_scene();
    if (part == "explode")      btn3_scene(ex = 1);
    if (part == "press")        btn3_scene(dn = B3_CLICK);
    if (part == "secx")         btn3_half("x") btn3_scene();
    if (part == "secy")         btn3_half("y") btn3_scene();
    if (part == "p_piston")     btn3_piston();
    if (part == "p_tub")        btn3_tub();
    if (part == "p_station")    btn3_top_slice();
    if (part == "p_sw")         btn3_switch();
    if (part == "print_piston") btn3_piston_print();
    if (part == "p_piston2")    btn3_piston2();
    if (part == "print_piston2") btn3_piston2_print();
    if (part == "print_station") btn3_station_print();
    if (part == "print_tub")    btn3_tub_print();
}


// ============================================================
// 15. 数字の申告と歯止め
// ============================================================
echo(str("btn_v3 押し味: クリックまで指が ", B3_FINGER_CLICK, "mm（タクトは 0.5）／ハードストップ ",
         B3_TRAVEL, "／押し切り ", B3_FULL, "／てこ比 ", B3_RATIO, "／予圧 ", B3_PRELOAD));
echo(str("btn_v3 抜け止め: ツバ ", B3_FLG_L, " ↔ 天板の口 ", B3_OPN_L,
         " ⇒ 掛かり 片側 ", (B3_FLG_L - B3_OPN_L) / 2, "（焼くと ", (B3_FLG_L - B3_OPN_L) / 2 + B3_SHRINK,
         "）／受けるのは天板の肉 ", B3_LIP_T, "mm"));
echo(str("btn_v3 落下止め: ツバ ", B3_FLG_L, " ↔ バスタブの内のり ", B3_TUB_IX,
         " ⇒ 中へ入る道は無い（差 ", B3_FLG_L - B3_TUB_IX, "）"));
echo(str("btn_v3 ガタ: 胴 ", B3_SW[0], " x ", B3_SW[1], " ↔ ポケット ", B3_POCK_X, " x ", B3_TUB_IY,
         " ⇒ 片側 X ", (B3_POCK_X - B3_SW[0]) / 2, " / Y ", (B3_TUB_IY - B3_SW[1]) / 2,
         "／レバー先端 ", B3_TIP_X, " ↔ 壁 ±", B3_TUB_IX / 2, " ⇒ 隙間 ", B3_TUB_IX / 2 - B3_TIP_X));
echo(str("btn_v3 レバー先端の Z ", B3_TIP_Z, " ↔ ツバの下面 ", B3_Z_FLG_B, " ⇒ 隙間 ", B3_Z_FLG_B - B3_TIP_Z));
echo(str("btn_v3 深さ: 胴の底 ", B3_Z_SW_BOT, "／バスタブの底 ", B3_Z_TUB_B,
         "（v2 は -15.735 / -16.535）／端子の先 ", B3_Z_SW_BOT - B3_PIN_LEN,
         "／ねじの頭はザグリの中なので下へ出ない"));
echo(str("btn_v3 外形: 口 ", B3_OPN_L, " x ", B3_OPN_W, "（天板の表・皿は無い）／座 ", B3_PAD_L, " x ", B3_PAD_W,
         "／箱の中の最外 X ±", B3_BLK_XO, " = ", B3_BLK_XO * 2, "／バスタブ ", B3_TUB_OX, " x ", B3_TUB_OY,
         "／顔 ", B3_HEAD_L, " x ", B3_HEAD_W));
echo(str("btn_v3 ねじ: スイッチ M2 x2（机の上・頭 -Y）／縦 M2 x2（下から・芯 ±", B3_V_SCR_X,
         "・ナットは Z ", B3_NUT_Z0, "〜", B3_NUT_Z1, " の溝に横から差す）"));
echo(str("btn_v3 組む順: 天板を裏返して机に置く ①押し子を口へ落とす ②バスタブにスイッチをねじ止め ",
         "③ブロックのナットを横から差す ④バスタブを載せて縦ねじ 2 本"));

assert(B3_FINGER_CLICK > 0.8, "予圧が大きすぎて指の動く量が残らない");
assert(B3_FINGER_CLICK < B3_TRAVEL, "クリックより先にハードストップに着く（押しても入らない）");
assert(B3_TRAVEL < B3_FULL, "ハードストップより先にレバーを押し切る（レバーを壊す）");
assert(B3_FLG_L > B3_OPN_L, "ツバが天板の口より狭い ⇒ 上に抜ける");
assert(B3_FLG_W < B3_OPN_W, "ツバが Y でも掛かっている ⇒ Y を広げる圧力が戻る（v2 の道）");
assert(B3_HEAD_L < B3_OPN_L && B3_HEAD_W < B3_OPN_W, "頭が天板の口を下から通らない（組めない）");
assert(B3_FLG_L > B3_TUB_IX, "ツバがバスタブの内のりより狭い ⇒ 中へ落ちる");
assert(B3_WIN_L > B3_FLG_L && B3_WIN_W > B3_FLG_W, "ツバの部屋がツバより狭い（上下に動けない）");
assert(B3_TUB_IX / 2 - B3_TIP_X > 0.5, "レバーの先が壁に当たる（実機 2026-08-30）");
assert((B3_POCK_X - B3_SW[0]) / 2 <= 0.2 && (B3_TUB_IY - B3_SW[1]) / 2 <= 0.2,
       "胴がポケットの中で動く（実機 2026-08-30 ブレブレ）");
assert(B3_Z_FLG_B - B3_TIP_Z > 0.30, "レバーの先がツバに当たっている（柱の出 B3_PILLAR_H が足りない）");
assert(B3_HEAD_OUT < 5.5, "🔒 頭が AS5600 のつまみ（5.5）より高い");
// 🔴 芯のずれを入れた正しい式。前は WALL_YP - NUT_T で 0.6 と出ていたが実寸は 0.30 だった
assert((B3_WALL_YP + B3_WALL_YN) / 2 - B3_NUT_T >= 0.55,
       "ナットの床が薄い（実寸 = (WALL_YP + WALL_YN)/2 - NUT_T）");
assert(min(B3_EAR_T) - B3_CB_H >= 1.5, "耳がザグリに食われて薄い（頭が抜ける）");
// 足の +Y の縁 ↔ ザグリ（φ4.2・芯は B3_BLK_DY[0]）の間に残る肉。ここが足の最薄部
assert(B3_BLK_XI > B3_TUB_OX / 2, "ブロックがバスタブに食い込んでいる（入らない）");
// 🔴 2026-08-30 ユーザー「押し子にあたってんじゃん」。ツバは ±FLG_L/2 で上下に動く
assert(B3_BLK_XI >= B3_WIN_L / 2, "ブロックがツバの部屋に入っている ⇒ 押し子に当たる");
assert(B3_FLG_L > B3_OPN_L, "ツバが天板の口より狭い（再掲・掛かりが消える）");
assert(B3_V_SCR_X - B3_NUT_AF / 2 > B3_WIN_L / 2, "ナットの溝がツバの部屋を食っている");
assert(B3_NUT_Z1 < B3_Z_LIP_B - 0.5, "ナットの溝が天板の裏を突き抜けている");
assert(b3_ear_z0(0) >= B3_Z_TUB_B && b3_ear_z0(1) >= B3_Z_TUB_B, "耳がバスタブの底より下に出ている");
assert(B3_BLK_FLR >= 0.6, "ナットを載せる床が薄い");
// 🔴 ブロックの内面 ↔ ナットの溝 の肉（刷る前の検算で 0.370 が出た所）
// 六角は二面幅を X に向けているので、X の半幅は (二面幅 + 見込み)/2
assert(B3_V_SCR_X - (B3_NUT_AF + B3_SHRINK) / 2 - B3_BLK_XI >= 0.42,
       "ブロックの内面とナットの溝の間の肉が薄い（0.42 未満）");
assert(B3_BLK_XO - B3_V_SCR_X >= (B3_NUT_AF + B3_SHRINK) / 2,
       "ナットが溝からはみ出す");
assert(B3_Z_LIP_B - B3_SKIRT_Z > 0.2, "裾の高さが 0 以下（Z の定義順を間違えている）");
assert(B3_SKIRT_Z >= B3_Z_WIN_B + B3_TRAVEL, "押し切ると裾がツバの部屋から出る");
