//    差すのは壁を降ろした直後（充電線を挿す前）。
BLU_W    = 5.0;                 // 棚と耳の X 幅（壁の内面から。他の棚と同じ）
BLU_Y0   = 45.0; BLU_Y1 = 50.4; // 棚と耳の Y（帯の前端 50.5 の 0.1 手前まで）
BLU_BOT  = 20.8;                // 棚の底 ＝ M2×4 の先が止まる面（ここが余り 0 を決める）
BLU_TOP  = 24.4;                // 棚の天面 ＝ 耳の底
BLU_SKIN = 1.6;                 // 棚の天面 ↔ ナットの上面（締める力を受ける肉。4 層）
BLU_PTOP = 26.4;                // 耳と座の天面（耳の厚み 2.0）
BLU_PY1  = 56.5;                // 座（帯の上の増し肉）の後端
BLU_SCR  = [LW_X + BLU_W / 2, (BLU_Y0 + BLU_Y1) / 2];   // ビスとナットの中心 [4.194, 47.7]
function blu_slot_z0() = BLU_TOP - BLU_SKIN - NUT_SLOT_H;   // 21.1 溝の床（棚の底まで 0.3）
// 壁側の棚（左の壁の内面に立つ。ナットは −Y ＝ 前の面から差して上下の肉で閉じ込める）
module brg_ledge_up() difference() {
    color("#b6c0cc") translate([LW_X, BLU_Y0, BLU_BOT]) cube([BLU_W, BLU_Y1 - BLU_Y0, BLU_TOP - BLU_BOT]);
    translate([BLU_SCR[0], BLU_SCR[1], blu_slot_z0()]) rotate([0, 0, 30]) hex_pocket(NUT_SLOT_H);
    translate([BLU_SCR[0] - NUT_SLOT_W / 2, BLU_Y0 - 0.01, blu_slot_z0()])
        cube([NUT_SLOT_W, BLU_SCR[1] + 0.01 - BLU_Y0, NUT_SLOT_H]);
    translate([BLU_SCR[0], BLU_SCR[1], BLU_BOT - 1]) cylinder(d = SCR_D, h = BLU_TOP - BLU_BOT + 2, $fn = 24);
}
// ブリッジ側: 帯の左端の増し肉（帯の上面 → 耳の天面）と、棚に載る耳。
// 🔒 2026-08-26 ユーザー「面取りして欲しい。このブリッジに乗ってるものは全部面取りしているので。
//    ブリッジ接地面はくれぐれも切り込みのようにならないように」: 素の直方体をやめ、他の座（brg_pads）と同じ
//    45°（BRG_CH）＋ 角 R（BRG_RD）にした。溝を作らない手当ては 2 か所:
//      ・座は**下 1.0 を帯の中に埋める**（Z 22.4 から立てる）。継ぎ目 23.4 に 45° の稜が出ない
//      ・耳は**後ろを座の中へ 1.0 差し込む**（Y は BRG_Y0 + 1.0 まで）。耳の底の 45° が座の側面を切らない
//    残る 45° は「耳の底の自由な周り（棚に載る面の縁）」と「天面 26.4」だけで、どちらも継ぎ目ではない
BLU_BURY = 1.0;                 // 座を帯へ埋める深さ ／ 耳を座へ差し込む深さ
module brg_up_pad() {
    prism_z(BAT_Z - BLU_BURY, BLU_PTOP - BAT_Z + BLU_BURY, BRG_CH) smooth2d(0, BRG_RD)     // 座（帯と面で繋がる）
        translate([LW_X, BRG_Y0]) square([BLU_W, BLU_PY1 - BRG_Y0]);
    prism_z(BLU_TOP, BLU_PTOP - BLU_TOP, BRG_CH) smooth2d(0, BRG_RD)                       // 耳（棚の上に載る）
        translate([LW_X, BLU_Y0]) square([BLU_W, BRG_Y0 + BLU_BURY - BLU_Y0]);
}
module brg_up_cuts() {
    translate([BLU_SCR[0], BLU_SCR[1], BLU_TOP - 1]) cylinder(d = SCR_D, h = BLU_PTOP - BLU_TOP + 2, $fn = 24);
    translate([BLU_SCR[0], BLU_SCR[1], BLU_PTOP - SCR_CBT]) cylinder(d = SCR_CB, h = SCR_CBT + 1, $fn = 32);
}
// 🔴 2026-08-26 右の腕は 2 段。まっすぐな 1 枚だと、降ろす途中で **XIAO の束の車線**（上段 Y 29.9・Z 27.13 の
//    X 55.35〜76.01 と、下段 Y 30.4・Z 11.9 の X 73.0〜81.09。束の幅ぶん Y 28.4〜31.5 を占める）を上から踏む（570mm³）。
//    ⇒ 内側（X 53〜78）は Y 32.0 から後ろだけの細い帯にして車線を跨がず、壁ぎわ（X 78〜）だけ幅を戻してビスを置く。
//    内側が Y 34.6 で止まるのはハブのハウジング（Y 34.67〜）を避けるため。
// 🔒 2026-08-26 ユーザー「危険で折れやすくて、見た目も悪くて意味もあんまりない、こんなものに価値はありません」:
//    右の壁まで渡していた長い腕（幅 2.6・厚み 2.0 で 25mm の片持ち。XIAO の束と AS5600 の口の 3.17 の隙間を通していた）を廃止。
//    3 点目は上の BLU_*（帯の左端の上）へ移した
BRG_ARMS = [[LW_X, 30.5, BAT_X0 - 2.5, 36.5]];                       // 左の腕（皿の左縁 13 → 左の壁）
function brg_ldg_x0(a) = (a[0] < 0) ? LW_X : IN_X - BRG_LDG_W;
function brg_scr(a)    = [(a[0] < 0) ? LW_X + BRG_LDG_W / 2 : IN_X - BRG_LDG_W / 2, a[3]];
function brg_pad_x0(a) = (a[0] < 0) ? LW_X : IN_X - BRG_PAD_W;
// 🔴 2026-08-26 ユーザー「上から落として上から締めたら上に抜けますよね」: 初版はナットを棚の**上面**の
//    ポケットに置いていた。それだと締めても「頭 ─ 腕 ─ ナット」を挟むだけで棚が挟まれず、
//    逆さにすればビスとナットごと腕が抜ける ＝ **留まっていなかった**（v3 の nut_ledge も同じ形）。
//    ⇒ 留め帯の座と同じ **横から差す捕捉溝** に替えた。棚の上の肉 BRG_LDG_SKIN を残してその下に六角の穴を開け、
//      棚の Y の面まで幅 NUT_SLOT_W の通路でつなぐ。ナットは横から差し、上下の肉で閉じ込められる。
//      締める順は 頭 → 腕 2.4 → 棚の肉 1.6 → ナット で、棚ごと締まる。ビスを通した後はナットは通路へ戻れない。
BRG_LDG_SKIN = 1.6;   // 棚の上面 ↔ ナットの上面（締める力を受ける肉。4 層）
function brg_slot_z0(a) = BRG_ZB - BRG_LDG_SKIN - NUT_SLOT_H;   // 溝の床（18.1）
// 通路を抜く向き: +1 = +Y の面へ（3 か所とも +Y 側が空いている。左 36.5〜42・右前 36〜45・右後ろ 62.9〜）
module brg_ledges(side) for (a = BRG_ANCH) if (a[0] == side) difference() {
    color("#b6c0cc") translate([brg_ldg_x0(a), a[1], BRG_ZB - BRG_LDG_H]) cube([BRG_LDG_W, a[2] - a[1], BRG_LDG_H]);
    translate([brg_scr(a)[0], brg_scr(a)[1], brg_slot_z0(a)]) rotate([0, 0, 30]) hex_pocket(NUT_SLOT_H);   // ナットの座（二面幅を Y に向ける）
    translate([brg_scr(a)[0] - NUT_SLOT_W / 2, brg_scr(a)[1], brg_slot_z0(a)])
        cube([NUT_SLOT_W, a[2] + 0.01 - brg_scr(a)[1], NUT_SLOT_H]);                                        // 差し込む通路（+Y の面へ）
    translate([brg_scr(a)[0], brg_scr(a)[1], BRG_ZB - BRG_LDG_H - 1]) cylinder(d = SCR_D, h = BRG_LDG_H + 2, $fn = 24);
}
// ブリッジ側: ビスの座（腕の上の増し肉。下 1.0 は皿の中に埋めて、面取りが継ぎ目に溝を作らないようにする）
module brg_pads() for (a = BRG_ANCH)
    prism_z(BRG_ZB + BRG_T - 1.0, BRG_PAD_T + 1.0, BRG_CH) smooth2d(0, BRG_RD)
        translate([brg_pad_x0(a), a[4]]) square([BRG_PAD_W, a[5] - a[4]]);
module brg_anchor_cuts() for (a = BRG_ANCH) {
    translate([brg_scr(a)[0], brg_scr(a)[1], BRG_ZB - 1]) cylinder(d = SCR_D, h = BRG_T + BRG_PAD_T + 2, $fn = 24);                   // 通し穴
    translate([brg_scr(a)[0], brg_scr(a)[1], BRG_ZB + BRG_T + BRG_PAD_T - SCR_CBT]) cylinder(d = SCR_CB, h = SCR_CBT + 1, $fn = 32);  // 頭の座ぐり
}
// ビスとナットの現物（検査と絵に出す。M2×6・頭 φ3.0 × 1.3 ✅実測・ナット 二面幅 4.0 × 1.6）
module brg_hw() color("#8892a0") for (a = BRG_ANCH) {
    translate([brg_scr(a)[0], brg_scr(a)[1], BRG_ZB + BRG_T + BRG_PAD_T - SCR_CBT]) {
        cylinder(d = 3.0, h = 1.3, $fn = 24);                        // 頭（座ぐりの底に座る）
        translate([0, 0, -6]) cylinder(d = 2.0, h = 6, $fn = 24);    // 軸 M2×6
    }
    translate([brg_scr(a)[0], brg_scr(a)[1], BRG_ZB - BRG_LDG_SKIN - 1.6]) rotate([0, 0, 30]) hex_pocket_af(4.0, 1.6);   // 締めて溝の天井（棚の肉の裏）へ上がったナット
}
// 🔴 2026-08-26 3 本目（帯の左端の耳）は BRG_ANCH ではなく BLU_* で描いているのでこのループに入っておらず、
//    W="brghw" の当たり検査の対象外だった。ネジも別に置く。
module brg_hw_up() color("#8892a0") {
    translate([BLU_SCR[0], BLU_SCR[1], BLU_PTOP - SCR_CBT]) {
        cylinder(d = 3.0, h = 1.3, $fn = 24);                        // 頭
        translate([0, 0, -4]) cylinder(d = 2.0, h = 4, $fn = 24);    // 軸 M2×4（🔴 2026-08-26 M2×6 だと先が棚の底から 2.0 出ていた）
    }
    translate([BLU_SCR[0], BLU_SCR[1], BLU_TOP - BLU_SKIN - 1.6]) rotate([0, 0, 30]) hex_pocket_af(4.0, 1.6);
}
// 土手（レール）の区間。⊓ の足が座る区間だけ途切れる。ツバの溝を彫るのに帯の側からも要るので変数に出した
RAIL_SEG_L = [[21.45, 33.2], [42.2, 52.6], [58.6, BAT_Y0 + lipo_size()[0]]];              // 左（A の足の後ろから）
RAIL_SEG_R = [[BAT_Y0, 15.45], [21.45, 33.2], [42.2, 52.6], [58.6, BAT_Y0 + lipo_size()[0]]];   // 右
function rail_segs(right) = right ? RAIL_SEG_R : RAIL_SEG_L;
module brg_v4() color("#c9d0d8") difference() {
  union() {
    prism_z(BAT_Z - BRG_T, BRG_T, BRG_CH) smooth2d(BRG_FL, BRG_RD) brg_plate2d();
    brg_pads();
    brg_up_pad();     // 3 点目（帯の左端の上・BLU_*）
    // brg_tc_press();   // 🔒 2026-08-27 左の壁へ移した（case_v4.scad の lwall_v4）
    // 🔒 2026-08-25 ユーザー「A は作らない代わりに電池のレール」: 皿の縁に立つ土手（厚み2・高さ4・電池へ 0.5 逃げ）。
    //   ⊓ の足が座る区間（Y 15.45〜21.45・33.2〜42.2・52.6〜58.6）だけ途切れる
    for (s = RAIL_SEG_L)
        prism_y(s[0], s[1] - s[0], BRG_CH) smooth2d(BRG_FLB, BRG_RD) brg_rail2d(false);   // 左のレール（A の足の後ろから）
    for (s = RAIL_SEG_R)
        prism_y(s[0], s[1] - s[0], BRG_CH) smooth2d(BRG_FLB, BRG_RD) brg_rail2d(true);    // 右のレール
    // 🔒 2026-08-26 ユーザー「別パーツにした方がいいかもしれないね」: 脚と返しは brg_front() へ出た（下）
  }
  tab_slots();         // 留め帯のツバを受ける溝（土手を X に貫通・下の TAB_*）
  brg_anchor_cuts();   // 箱へ留める M2 の通し穴＋座ぐり（壁の棚に載る 2 か所）
  brg_up_cuts();       // 3 点目（帯の左端の上）の通し穴＋座ぐり
  brgf_cuts();         // 前板: 首を通す抜き（皿を貫通）とフランジの掘り込み
  brg_j2_cut();        // 🔒 2026-08-26 ユーザー ①: 皿の前左の角を J2 ソケットの外へ欠く（下の BRGJ2_*）
}
// 🔒 2026-08-26 ユーザー ①「1 で」: 皿の前左の角を欠いて ReSpeaker の **J2（スピーカーのソケット・X 〜10.08）**を逃がす。
//   出どころ: 🔒 同日の「バッテリー自体のってるブリッジの帯ごと左に 4mm 移動」（BAT_DX +1 → −3）で皿の左縁が
//   13.0 → 9.0 になり、4 のうち最後の 1.08 がソケットの実体に乗っていた（静止で 7mm³）。
//   組む順の掃引 CHK="brg" でしか出ない当たりで、静止の検査（chk_all ほか）は全部 0 のまま素通りしていた。
//   欠くのは**皿（Z 21.4〜23.4）だけ**。左の土手は Y 21.45 から始まるので触れない。
//   代金は留め帯 A の左足（X 9.0〜11.0・Y 15.45〜23.45）の座で、Y 15.45〜16.9 の 1.45mm だけ幅 2.0 → 0.8 になる。
//   ⬜ 同じ X の**プラグ＋線の確保空間**（Y 25.03 まで）へは 17mm³ 残る。あれは「基板面から 15」の仮の包絡
//      （CASE-V4-LOG.md §2）なので、PHR-2 の尻の実測が出るまで保留する——というのがユーザーの ① の選択。
//   帯ごと右へ戻す手は落ちている: 板を +0.5 で天面の部品に 0.13mm³・+1.1 で 3.49mm³ 当たり、
//   4mm 左移動が解いた「つまみの島の柱が INA/PowerBoost の板に乗る」問題が戻る。
BRGJ2_X = 10.2;    // 欠きの右端。J2 ソケットの右端 10.08 ＋ 0.12
BRGJ2_Y = 16.9;    // 欠きの奥。ソケットの奥 16.87 ＋ 0.03（皿の前縁は BAT_Y0 = 12.9）
module brg_j2_cut() translate([-1, BAT_Y0 - 1, BRG_ZB - 1])
    cube([BRGJ2_X + 1, BRGJ2_Y - BAT_Y0 + 1, BRG_T + 1]);

// ---- 前板 ＝ 電池の前ガード（返し）＋ 前の脚。ブリッジから切り離した別部品 ----
//   🔒 2026-08-26 ユーザー「こりゃー別パーツにした方がいいかもしれないね」「普通に T 字にしておくだけでもいい」
//      「ブリッジ側に 1mm 掘り込みをいれ、この板を 1.5mm で（作れば）実質の厚みは 0.5mm 増えるだけでしょう」
//      「特にネジは要らないと思うのです」
//   きっかけは刷る向き: ブリッジは皿と脚が直角に付いた L なので、どちらの面を下にしても片方が宙に浮いた。
//   切り離すと、ブリッジは皿を伏せて・前板は箱の中と同じ姿で立てて、どちらも支え無しで刷れる。
//   ネジ無しで止まる理屈（上と下の 2 点で挟む）:
//     下 = 床の溝（深さ 2.5・脚 2.0 に対して ±0.25）が足を Y で挟む
//     上 = 皿を貫く抜きに首を通し、皿の裏の掘り込み（深さ 1.0）へフランジを差す。
//          **前へ倒れようとするとフランジの背が掘り込みの天井（Z 22.5）に当たって止まり**、
//          **後ろへ倒れようとすると首の背が抜きの奥（Y 15.1）に当たって止まる**
//   組む順: 前板を床の溝へ差してから、ブリッジを真上から降ろす（掘り込みがフランジに被さる）
//   🔴 2026-08-26 ユーザー「バッテリー下の板、短くない?」「バッテリを押さえる壁くらいの長さは要る」
//      「これだと面というか点で支える」: 初版はフランジを 1.5 厚にして 0.5 を皿の裏へ出していたため、
//      皿の裏の住人（ハブの口から出た線の曲がりの頭 Z 21.1・Y 16.7 から）に当たらない Y 16.4 までしか伸ばせなかった。
//      **厚みを掘り込みと同じ 1.0 にして丸ごと沈める**と出っ張りが 0 になり、長さの制限が消える。
BRGF_T    = 1.0;   // フランジの厚み ＝ 掘り込みの深さ（皿の裏へは出ない）
BRGF_SINK = 1.0;   // 掘り込みの深さ。皿 2.0 のうち上に 1.0 残る
BRGF_D    = 6.0;   // フランジの奥行き（Y 14.9〜20.9）＝ 返しの高さ 6 と同じ。皿の裏の住人とは
                   //    上下に 0.3 離れる（住人の頭 21.1 ↔ 皿の裏 21.4。フランジは皿の中なので触れない）
BRGF_CL   = 0.2;   // はめ合いの逃げ（片側）
BRGF_RD   = 0.4;   // 出隅の角 R。返し（厚み 1.0）が消えない上限
BRGF_CH   = 0.4;   // X の端の面取り（3 本の押し出しで同じ値にする。返しの厚み 1.0 に入る上限）
// 断面（Y-Z）。🔴 2026-08-26 ユーザー「パキっと折りたいなら別だけど、こんな意匠いらないよね」:
//   3 本の押し出しに分けていたら、継ぎ目（Z 23.4）に V 溝が 1 本通っていた。出どころは角 R ではなく
//   **面取り（ext_ch）**——あれは押し出しの端を落とすと同時に、断面の角も同じ量だけ丸める。
//   → 断面を 1 つにまとめて**素の押し出し 1 本**にした。継ぎ目が無いので溝も出ない。前面（Y 12.9）は
//     Z 0〜29.4 が 1 枚の平らな面になり、寝かせて刷ることもできる。
// 断面（Y-Z）。🔴 2026-08-26 ユーザー「パキっと折りたいなら別だけど、こんな意匠いらないよね」:
//   3 本の押し出しに分けていたら、継ぎ目（Z 23.4）に V 溝が 1 本通っていた。出どころは角 R ではなく
//   **面取り（ext_ch）**——あれは押し出しの端を落とすと同時に、断面の角も同じ量だけ丸める。
//   🔴 ユーザー「ここ以外は丸めればいいんだよ」（フランジを指して）: 本体（脚＋返し）は 1 枚の断面に
//   角 R と面取りを掛け、**フランジだけは角を落とさない**（掘り込みの天井と面で当たるのが仕事なので）。
module brgf_body2d() {
    translate([BAT_Y0, 0]) square([BRG_T, BAT_Z]);              // 脚＋首（Y 12.9〜14.9・床から皿の天面 23.4 まで）
    translate([BAT_Y0, BAT_Z]) square([1.0, lipo_size()[2]]);   // 返し（Y 12.9〜13.9・高さ 6・脚の前面と面一）
}
module brgf_fin2d() translate([BAT_Y0 + BRG_T - 0.6, BAT_Z - BRG_T - (BRGF_T - BRGF_SINK)])
    square([BRGF_D + 0.6, BRGF_T]);                             // フランジ（Y 14.3〜20.9・Z 21.4〜22.4。脚へ 0.6 重ねる）
// 🔴 2026-08-26 ユーザー「肝心の段差部分は角丸になっちゃってる」: 電池が座る面（Y 13.9〜14.9・Z 23.4）の
//    奥の角は、断面を尖らせても **ext_ch（面取り）が断面の角も 0.4 丸める**ので丸くなる。
//    座のぶんは面取りを通さない素の押し出しで足して、平らな面と直角の段差に戻す
module brgf_seat2d() translate([BAT_Y0 + 1.0, BAT_Z - 1.0]) square([BRG_T - 1.0, 1.0]);   // Y 13.9〜14.9・Z 22.4〜23.4
module brg_front() color("#c9d0d8") {
    //   🔴 角 R は 0.4（BRG_RD の 0.5 ではない）。smooth2d は先に R だけ縮めるので、
    //      0.5 だと厚み 1.0 の**返しが消える**（2026-08-26 に実際に消して、ユーザーに指摘された）
    prism_x(LEG_X0, LEG4W, BRGF_CH) smooth2d(0, BRGF_RD) brgf_body2d();
    //   フランジは面取りも掛けないので、本体の面取りのぶん（両端 0.4）だけ X を詰めて中に収める
    translate([LEG_X0 + BRGF_CH, 0, 0]) rotate([90, 0, 90])
        linear_extrude(LEG4W - 2 * BRGF_CH) { brgf_fin2d(); brgf_seat2d(); }
}
module brgf_cuts() {
    translate([LEG_X0 - BRGF_CL, BAT_Y0 - 1.0, BAT_Z - BRG_T - 1])
        cube([LEG4W + 2 * BRGF_CL, BRG_T + 1.0 + BRGF_CL, BRG_T + 2]);          // 首を通す抜き（Y 11.9〜15.1・皿を貫通）
    translate([LEG_X0 - BRGF_CL, BAT_Y0 + BRG_T + BRGF_CL, BAT_Z - BRG_T - 1])
        cube([LEG4W + 2 * BRGF_CL, BRGF_D, 1 + BRGF_SINK + 0.1]);               // 掘り込み（Y 15.1〜16.6・天井 Z 22.5）
}

// ---- 留め帯 3 本（🔒 2026-08-25 ユーザー・写真＋断面図「結束バンドのように（v2 のトンネル役）。
//      3 枚のうち 1 枚は PowerBoost と電力計を同時に留める」）----
//   ロの字断面で「皿＋電池」を抱き、天面に基板が載る。側・天は厚み 2.0。
//   底の帯だけ厚み 1.0（Z 20.4〜21.4）: 皿の裏の階は線の頭 20.2 まで住人が居て、全域で 1.2 しか無いため。切り欠きは無し。
//   Y は住人を避けて走査で決めた: A=25.2（電力計）・B=34（境目またぎ・2 枚同時）・C=44（PowerBoost）。
//   ⚠ 写真の「PB の 8 ピン列の端（Y 〜55）」は壁〜壁の帯（Y 50.5〜）と交差するため C は 44 に前倒し
// 🔴 2026-08-25 ユーザー「穴に全然乗ってない」→ 帯は基板の取付穴の真下に置き直し（穴の Y: 電力計 18.5/34.1・PB 39.3/41.3/54.5/57.1）。
//   B = ロの字（Y 33.2〜42.2・幅 9）: 電力計の後穴＋PB の前の対角 2 穴を同時に留める（🔒「2 つを同時に付ける板」）。
//   C = ⊓（Y 52.6〜58.6・幅 6・足は皿の縁の上）: PB の後ろ 2 穴。壁〜壁の帯（Y 50.5〜）と交差するため下は巻かず、足を皿に載せる。
//   A（電力計の前穴 Y 18.5）は ⬜ 保留: 左の足場が J2 プラグ空間（X 5.1〜12.1・Y 〜25）に占領されていて素直に立たない。
STRAP_T = 2;
module strap_loop(y0, w) difference() {   // ロの字: 皿（X 7〜47）ごと抱く。底の帯は厚み 1.0
    translate([BAT_X0 - 5.0, y0, BAT_Z - BRG_T - 1.0]) cube([lipo_size()[1] + 10, w, 1.0 + BRG_T + lipo_size()[2] + STRAP_T]);
    translate([BAT_X0 - 3.0, y0 - 1, BAT_Z - BRG_T]) cube([lipo_size()[1] + 6, w + 2, BRG_T + lipo_size()[2]]);
}
STRAP_CH = 0.5; STRAP_RD = 0.5;   // 面取り・出隅の角 R
STRAP_FL = 0.5;   // 入隅の R。⊓ の内側の 2 か所は電池との隙間が X で 0.5 なので、そこに収めれば電池に当たらない
module strap2d() {   // ⊓ の断面（X-Z）
    for (x = [BAT_X0 - 2.5, BAT_X0 + lipo_size()[1] + 0.5]) translate([x, BAT_Z]) square([STRAP_T, lipo_size()[2] + STRAP_T]);
    translate([BAT_X0 - 2.5, BAT_Z + lipo_size()[2]]) square([lipo_size()[1] + 5, STRAP_T]);
}
// ---- ツバ（🔒 2026-08-26 ユーザー・絵 2 枚「テトリスの T 字・横からしか入れられないように」）----
//   足の前後（±Y）にツバを出し、土手を X に貫通させた溝へ差す。ツバの上に土手の肉（1.4）が乗るので
//   真上へは抜けない。ツバが前後どちらにも出ているので Y へも差せない。開いているのは X だけ ＝ 横差し。
//   🔒 ユーザー「上からは入れられなくなって良いのです」——上からの落とし込みは廃止。
//   🔒 ユーザー「このアイデアはバッテリー自体が楔になるという事なんです」:
//     差した後に電池（X 15.5〜50.5）を後ろのハッチから入れると、足（X 13〜15 / 51〜53）と電池の隙間は
//     左右 0.5 になる。ツバの掛かりは 2.0 なので、電池が入っている限り横へ戻せない ＝ ネジも繋ぎも要らない。
// 🔒 2026-08-26 ユーザー「印刷を考慮するならこうだ」（3 枚目の絵）: ツバは足の**一番下**。
//   足の裏とツバの裏が同じ面（Z 23.4 ＝ 皿の上）になるので、下に肉は残さない。土手は上にだけ肉を残す。
TAB_L   = 2.0;    // ツバの長さ（Y）＝ 掛かり。差すときの横移動もこの量
TAB_Z0  = BAT_Z;  // ツバの下面 ＝ 足の裏 ＝ 皿の上（23.4）
TAB_H   = 2.0;    // ツバの高さ。TAB_L と同じ ＝ 上面がちょうど 45°（土手 23.4〜27.4 のうち上に 1.8 残る）
TAB_CL  = 0.2;    // 溝の逃げ（上と奥。下は皿なので取らない）
TAB_MIN = 3.5;    // これより短い土手には彫らない（右の Y 12.9〜15.45 ＝ 2.55 が該当。A の前は前後とも無し）
function foot_x(right) = right ? BAT_X0 + lipo_size()[1] + 0.5 : BAT_X0 - 2.5;
function tab_front(y0, right) = len([for (s = rail_segs(right)) if (abs(s[1] - y0) < 0.01 && s[1] - s[0] >= TAB_MIN) 1]) > 0;
function tab_rear(y1, right)  = len([for (s = rail_segs(right)) if (abs(s[0] - y1) < 0.01 && s[1] - s[0] >= TAB_MIN) 1]) > 0;
function tab_front_any(y0) = tab_front(y0, false) || tab_front(y0, true);
function tab_rear_any(y1)  = tab_rear(y1, false) || tab_rear(y1, true);
function strap_ya(s) = s[0] - (tab_front_any(s[0]) ? TAB_L : 0);              // 帯 1 本の Y の端（ツバ込み・印刷の切り出し用）
function strap_yb(s) = s[0] + s[1] + (tab_rear_any(s[0] + s[1]) ? TAB_L : 0);
//   ツバは 0.6 だけ帯の中へ食い込ませる（prism_y の面取りで凹んだ端の面を、ツバの高さの所だけ埋める）
// 🔒 2026-08-26 ユーザー「帯を下にして印刷するならこうすれば確実だ」（4 枚目の絵）:
//   ツバの上面を 45° に削る（下が一番長く、上へ行くほど短い）。帯は足を下にして刷ると
//   上へすぼまる形になり、土手側の溝の天井も同じ 45° になるので、どちらも支えが要らない。
module tab_solid(y0, w, right, rear) hull() {   // 下の面（全長）と上の稜（長さ 0）を結ぶ
    translate([foot_x(right), rear ? y0 + w - 0.6 : y0 - TAB_L, TAB_Z0]) cube([STRAP_T, TAB_L + 0.6, 0.01]);
    translate([foot_x(right), rear ? y0 + w - 0.6 : y0, TAB_Z0 + TAB_H - 0.01]) cube([STRAP_T, 0.6, 0.01]);
}
module strap_tabs(y0, w) for (right = [false, true]) {
    if (tab_front(y0, right))     tab_solid(y0, w, right, false);
    if (tab_rear(y0 + w, right))  tab_solid(y0, w, right, true);
}
//   溝は土手を X に貫通させる（＝ 横からどちら向きにでも差せる）。奥行きは掛かり ＋ 逃げ
module tab_slot(y0, w, right, rear) hull() {   // ツバと同じく天井が 45°。X は土手を貫通（← 横から差せる理由）
    x = foot_x(right) - 1;
    yl = rear ? y0 + w - 0.1 : y0 - TAB_L - TAB_CL;   // 下の面（一番奥まで）
    yu = rear ? y0 + w - 0.1 : y0 - TAB_CL;           // 上の稜
    translate([x, yl, TAB_Z0]) cube([STRAP_T + 2, TAB_L + TAB_CL + 0.1, 0.01]);
    translate([x, yu, TAB_Z0 + TAB_H + TAB_CL - 0.01]) cube([STRAP_T + 2, TAB_CL + 0.1, 0.01]);
}
module tab_slots() for (s = STRAP_BANDS) for (right = [false, true]) {
    if (tab_front(s[0], right))          tab_slot(s[0], s[1], right, false);
    if (tab_rear(s[0] + s[1], right))    tab_slot(s[0], s[1], right, true);
}
module strap_u(y0, w) {   // ⊓: 足（厚み2）は皿の縁の上（Z 23.4〜）・天板は電池の上
    prism_y(y0, w, STRAP_CH) smooth2d(STRAP_FL, STRAP_RD) strap2d();
    strap_tabs(y0, w);
}
// 🔒 2026-08-25 ユーザー「B を C と同じ ⊓ に揃える」→ 右壁寄せ +6 で「A も作れる?」→ 作れたので A も ⊓ で復活
//   A = Y 15.45〜21.45（電力計の前穴 18.5 が中心）・B = 33.2〜42.2・C = 52.6〜58.6
STRAP_BANDS = [[15.45, 6], [33.2, 9], [52.6, 6]];   // A / B / C（幅は取付穴をまたぐ量）
// ---- 傾斜の座とネジ（🔒 2026-08-25 ユーザー「固定具作って下さい」→「ネジにしないと逆さまにしたら落ちちゃう」）----
//   🔴 THETA = 10° は板の座標を回しただけで、前縁の下は空だった（PowerBoost 3.97・電流計 3.49 浮き）。
//   帯 A/B/C の天板の上に、板の裏の面と同じ 10° の面を持つ座を立てて**全面で受け**、取付穴 6 つを M2 で締める。
//   ネジは板に直角（＝座の面に直角）。ナットは天板の**裏**＝電池を入れる前に落とし込む（樹脂にネジを切らず貫通＋ナット・CASE-V3 §4）。
//   ⚠ 板の後ろ側の穴 2 つ（電流計 Y 34.05・PB Y 57.12）は蝶番のすぐ脇で座がほぼ 0。天板 2.0 とあわせて 2.4 しか無く、
//     ナット 1.8 を掘ると残りは 0.6 台になる。上は板の面（Z 31.4）・下は電池の頭（Z 29.4）で、ここは作図ではなく現物の限界。
SEAT_GAP = 0.3;   // 座の面を板の裏から下げる量。裏の足（電流計の L ヘッダ 1.2・PB の 8 ピン列 1.0）はこれで全部逃げる
SEAT_PAD_D = 5.0;   // ビスの座（パッド）の径。ここだけ板の裏に届く
//   穴は板そのものの座標（ina_holes / pb_mount）をそのまま使う。frame の中では板の原点＝後縁の蝶番で、
//   local +y が板に沿って前（＝持ち上がる側）へ進む。板を動かせば穴も座もネジも一緒に動く。
// 🔴 ネジは**鉛直**に立てる（板に直角ではない）。直角にするとナットが 10° 傾き、
//   角が天板の裏（Z 29.4）から 0.35 はみ出して**電池の頭を突く**（seathw 6mm³ で出た）。
//   鉛直ならナットは天板の裏に平らに座る。頭は 10° の板に片当たりになるが、M2 の頭 φ3.0 では実害が出ない。
function seat_d(hy, th = THETA, lift = BOARD_LIFT) = hy * sin(th) + STRAP_T + lift;   // 板の裏から天板の裏までの**鉛直**距離（板の持ち上げ込み）
module seat_vert(th = THETA) rotate([0, 0, 180]) rotate([th, 0, 0]) children();   // frame の回転を打ち消して世界の鉛直に戻す
//   🔴 座は素の cube で作る。prism_y（ext_ch → roof）を通すと ① roof は実験機能で GUI 既定では無効
//   ② プレビューの CSG 正規化が跳ね上がる。板の footprint で切るので X の端は天板の内側に収まり、面取りは見えない
module seat_cols() for (s = STRAP_BANDS)
    translate([BAT_X0 - 2.5, s[0], BAT_Z + lipo_size()[2] + STRAP_T - 1.0]) cube([lipo_size()[1] + 5, s[1], 11.0]);   // 天板へ 1.0 食い込ませて継ぎ目を埋める
module board_under(h = 20) {   // 板の裏の面より下（板の footprint だけ）
    ina_frame() translate([0, 0, -h]) cube([ina_size()[0], ina_size()[1], h]);
    pb_frame()  translate([0, 0, -h]) cube([PB_L, PB_W, h]);
}
// 🔴 2026-08-25 板の裏の足を「板の CSG を 7 方向にずらして引く」で逃がしたら、プレビューの正規化が
//   20 万要素を超えて**空の木**になった（ユーザーの画面が真っ白）。逃げ方を変える:
//   座の面は板の裏から SEAT_GAP だけ下げ、板はビスの 6 か所のパッドだけで受ける。
//   こうすると裏の足（電流計の L ヘッダ 1.2・PB の 8 ピン列 1.0）は掘らなくても全部逃げる。
module seat_pads() intersection() {   // ビスの真下だけ板の裏まで立ち上がる座（パッド）
    union() {
        for (h = ina_holes()) ina_frame() translate([h[0], h[1], 0]) seat_vert(INA_THETA) translate([0, 0, -20]) cylinder(d = SEAT_PAD_D, h = 20, $fn = 24);
        for (h = pb_mount())  pb_frame()  translate([h[0], h[1], 0]) seat_vert(THETA)     translate([0, 0, -20]) cylinder(d = SEAT_PAD_D, h = 20, $fn = 24);
    }
    board_under();
}
module seats_v4() intersection() {
    union() { translate([0, 0, -SEAT_GAP]) board_under(); seat_pads(); }
    seat_cols();
}
// 🔴 2026-08-25 ポケットの**深さ**が掛かりを決める。ナットは締めると天井まで登り、そこで止まる（＝天井が
//   ナットの居場所）。深さ 1.8 のままだと、持ち上がる側の 3 穴は天井が低すぎて M2×6 の先が届かず、掛かりが
//   0.67 / 1.02 / 1.10mm しか無かった。座は板の裏まで詰まっているので、天井は上げられる:
//   深さ ＝ seat_d − 0.6（天井の上に肉 0.6 を残す）で頭打ち 2.8。これで 6 穴とも掛かりは満（1.6）になる。
//   ⚠ 0.6 は蝶番寄りの 3 穴の現物の限界（天板 2.0 ＋ 座 0.39〜0.90 しか無い）。この 3 穴は深さ 1.8 のまま
SEAT_NUT_DEEP = 2.8;   // ポケットの深さの上限
SEAT_NUT_TOP  = 0.6;   // 天井の上に残す肉
function seat_nut_d(hy, th = THETA, lift = BOARD_LIFT) = max(NUT_T, min(SEAT_NUT_DEEP, seat_d(hy, th, lift) - SEAT_NUT_TOP));   // 天板の裏からのポケットの深さ
// ---- 横から差すナットの捕捉溝（2026-08-25 ユーザー「留め帯の形状を変えても構いません・パーツを追加してもいい」）----
//   下向きのポケットは帯を起こすとナットが落ちる。**横穴**に替えると落ちない: 六角の穴を高さ 1.7 で開け、
//   帯の一番近い面まで幅 4.3 の通路でつなぐ。ナットは横から差して、上（天井）と下（床）の肉で閉じ込められる。
//   🔴 向きを上下ひっくり返すのは不可（ナットが締める物の反対の端に無いと座を挟めない）。横は成立する。
//   締める力は天井が受けるが、天井は**板とナットの間で押されるだけ**（曲げではない）なので薄くてよい。
//   床は荷重を持たない——ナットが落ちないための縁。
//   ⚠ 通路は板の面が 10° 傾いている分だけ天井を下げる。前（−Y）へ抜くときは面が上がるので六角の分だけ、
//     後ろ（+Y）へ抜くときは通路の長さの分だけ下がる。
NUT_SLOT_H     = 1.7;      // 溝の高さ（ナットの実物 1.6 ＋ 0.1）
NUT_SLOT_TOP   = 0.4;      // ナットの上に残す肉（2 層。押されるだけなので曲げの肉は要らない）
NUT_SLOT_FLOOR = 0.3;      // ナットの下に残す肉（荷重を持たない縁。天井を優先して薄くした）
NUT_SLOT_W     = NUT_AF;   // 通路の幅（ポケットと同じ 4.3）
function band_of(y) = [for (b = STRAP_BANDS) if (y >= b[0] - 0.01 && y <= b[0] + b[1] + 0.01) b][0];
function slot_out(y) = (y - band_of(y)[0] <= band_of(y)[0] + band_of(y)[1] - y) ? -1 : 1;   // 近い方の面へ抜く（−1 = 前）
function slot_len(y) = (slot_out(y) < 0) ? (y - band_of(y)[0]) : (band_of(y)[0] + band_of(y)[1] - y);
function slot_ceil(y, th = THETA) = NUT_SLOT_TOP + ((slot_out(y) > 0) ? (slot_len(y) + 1) : NUT_AF / cos(30) / 2) * tan(th);
function slot_ok(hy, y, th = THETA, lift = BOARD_LIFT) = seat_d(hy, th, lift) - slot_ceil(y, th) - NUT_SLOT_H >= NUT_SLOT_FLOOR;   // 肉が足りる穴だけ横穴にする
function seat_nut_ceil(hy, y, th = THETA, lift = BOARD_LIFT) = slot_ok(hy, y, th, lift) ? -slot_ceil(y, th) : -seat_d(hy, th, lift) + seat_nut_d(hy, th, lift);   // 締めたときのナットの上面
function seat_scr_l(hy, y) = 4;   // 🔒 6 本とも M2×4（天井を上げたので長さは 1 種類で足りる）
module seat_hole(hy, wy, th = THETA, lift = BOARD_LIFT) seat_vert(th) {   // 通し穴＋ナットの居場所（どちらも鉛直）
    translate([0, 0, -seat_d(hy, th, lift) - 3]) cylinder(d = SCR_D, h = seat_d(hy, th, lift) + 6, $fn = 24);
    if (slot_ok(hy, wy, th, lift)) {                         // 横から差す捕捉溝
        z0 = -slot_ceil(wy, th) - NUT_SLOT_H;
        l  = slot_len(wy) + 1;
        translate([0, 0, z0]) rotate([0, 0, 30]) hex_pocket(NUT_SLOT_H);            // 二面幅を X へ（通路の壁が回り止め）
        translate([-NUT_SLOT_W / 2, slot_out(wy) > 0 ? 0 : -l, z0]) cube([NUT_SLOT_W, l, NUT_SLOT_H]);   // 通路
    } else {                                                 // ⚠ 肉が足りない蝶番寄りの 2 穴は下向きのポケットのまま
        translate([0, 0, -seat_d(hy, th, lift) - 3]) hex_pocket(seat_nut_d(hy, th, lift) + 3);
    }
}
// 穴の世界の Y（帯のどの面が近いかを決めるのに要る）。frame は 180° 回っているので local +y ＝ 世界 −Y
function ina_frame_y() = PAIR_Y0 + ina_size()[1];
function pb_frame_y()  = PAIR_Y0 + ina_size()[1] + 0.5 + PB_W;
function ina_hole_wy(hy) = ina_frame_y() - hy * cos(INA_THETA);
function pb_hole_wy(hy)  = pb_frame_y()  - hy * cos(THETA);
module seat_screws() {
    for (h = ina_holes()) ina_frame() translate([h[0], h[1], 0]) seat_hole(h[1], ina_hole_wy(h[1]), INA_THETA, INA_LIFT);
    for (h = pb_mount())  pb_frame()  translate([h[0], h[1], 0]) seat_hole(h[1], pb_hole_wy(h[1]), THETA);
}
module seat_bolt(hy, t, wy, th = THETA, lift = BOARD_LIFT) seat_vert(th) {   // 🔴 現物の長さで描く（旧版は「入る上限の長さ」を描いていた＝実在しないネジ）
    l = seat_scr_l(hy, wy);
    color("#8899aa") { translate([0, 0, t]) cylinder(d = 3.0, h = 1.3, $fn = 24);       // 頭 ✅ φ3.0 × 1.3
