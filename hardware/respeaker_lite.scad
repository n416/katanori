// ReSpeaker Lite のモック（筐体設計用の当て板）
//
// **筐体・スタンドを設計するときは、必ずこれを呼んで CAD の中で当てること。**
// 刷ってから当たりを見つけるのをやめるために作った（2026-08-04）。
// 数字の一覧は docs/RESPEAKER-LITE.md（このファイルと同時に更新する）。
//
//   use <respeaker_lite.scad>
//   respeaker_lite();          // 基板＋部品
//   respeaker_mating_space();  // ケーブル・プラグが要る空間（筐体はこちらも開ける）
//   関数 respeaker_L() / respeaker_H() / respeaker_T() で外形を参照できる
//
// ---- 教訓（2026-08-04・全部この日に実際やった）----
//   1. **位置は実測でしか置かない・動かさない。** 公式画像と製品写真の読みで
//      USB-Cの向きを2回ひっくり返した
//   2. **寸法を置いたら、その部品として有り得る大きさか見る。** 幅5mmのUSB-Cを置いていた
//   3. この機体は基板シルク **V1.1**。公式ピンアウト図は **V1.0**。図は根拠にならない
//
// ---- 座標系（docs/RESPEAKER-LITE.md の基準の向き）----
//   X : 0 〜 86   … 「左から」。X=0 が左端（XIAOのUSB-Cが張り出す側）
//   Z : 0 〜 34   … 「下から」。Z=0 が下辺
//   Y : 0 〜 1.25 … 板厚。**XIAO面は Y=0 の面（部品は -Y へ出る）／
//       マイク面は Y=1.25 の面（部品は +Y へ出る）**
//   スイッチ位置の「マイク面の短辺右から」は、鏡の関係でこの座標系のXと同じ値になる
//
//   🚫 2026-08-04 鏡像事故（**二度と起こさない。絶対**）: 当初「XIAO面=Y1.25」で
//     組んでいたが、これは「XIAO面を手前にしてX=0が左」と**両立しない**
//     （モデル全体が鏡像になる）。面のYの割り当てと「左」の定義は、組で利き手を決める。
//     鏡像が特に危険な理由（ユーザー明言）: **一瞬正しく見えるため、ユーザーが
//     その画面を基準に座標を伝え返し、入力データ自体が汚染される。**
//     ルール: この座標系・面割り当てを変更したら、**XIAO面ビューを実物写真と並べて
//     照合するまで、このファイルを使う設計を書かない。** 照合済み: 2026-08-04
//     （ヘッダー左・USB-C右上・ジャック右下・穴2つの位置まで一致を確認）。
//     面ラベル「XIAO」と上矢印は消さないこと（鏡文字に見えたら裏を見ている）。
//
// ---- 格付け ----
//   ✅ ユーザー実測 / ⚠ 推測（画像読み含む） / ⬜ 未取得
//   **⚠ の上に位置の決まった穴・締め代を作らない。窓・長穴・開放で逃がす。**
//
// ---- ⬜ まだ入っていない物 ----
//   - u.FLアンテナの同軸（黒）。XIAO付近から出て上へ伸びている（実物写真）。
//     経路・固定は未定。筐体では必ず考慮する
//   - ジャックの筒の突き出し量・USB-C(ReSpeaker)の上への出っ張り量（下の⚠）
//   - 中央領域の面ごとの振り分け（下の⚠。対称と仮定して描いている）

$fn = 64;

// ============================================================
// ✅ 基板そのもの
// ============================================================
BOARD_L = 86.0;     // 📄 公式仕様（横方向。実測と矛盾なし）
// 縦の経緯: 一度32と記録 → **再実測で34**（2026-08-04・これが確定値）。
// ⚠ 公式仕様の35より1mm短い。理由は不明のまま記録しておく（角のR・仕様の丸めなど。
//    新ボード到着時に写真1枚で照合する）
BOARD_H = 34.0;     // ✅ ユーザー再実測 2026-08-04
BOARD_T = 1.25;     // ✅ ユーザー実測 2026-08-03（標準の1.6ではない）

function respeaker_L() = BOARD_L;
function respeaker_H() = BOARD_H;
function respeaker_T() = BOARD_T;

HOLE_D = 1.0;                     // ✅ M1
HOLE_A = [ 2.5, BOARD_H - 2.5];   // ✅ 隅の穴（左2.5 / 上2.5）
HOLE_B = [60.0, 2.5];             // ✅ もう一方（左60 / 下2.5）

// ============================================================
// ✅ 中央領域（旧称「6mm領域」・2026-08-04改称。基板＋表面実装部品。ダイオード・LSI）
//    「X 32〜65・下辺から上辺まで全域」
//    ⚠ 面ごとの振り分けは未取得 → 対称と仮定して描く。
//      **この領域を掴む・挟む設計は、振り分けを測るまで作らない**
// ============================================================
CENTER_T  = 4.8;                  // ✅ ユーザー実測（約4.8・2026-08-04訂正）。
                                  // 当初の「6.0」は実測ではなく「掴みに十分な幅」の指定値
                                  // だったため、名称も「中央領域」へ改称（2026-08-04）
CENTER_X0 = 32.0;  CENTER_X1 = 65.0;   // ✅
CENTER_Z0 =  0.0;  CENTER_Z1 = BOARD_H; // ✅ 全域（32に追従）

// ============================================================
// ✅ ピンヘッダー（XIAO面・左端側）2列
//    ソケットを挿した状態で X 2〜20、1列の厚み(Z)2mm、
//    下から8mm の列と上から8mm の列。高さ10mm（この機体で最も高い）
//    ⚠ XIAO本体はこの下に埋もれるのでモックに入れない
// ============================================================
HDR_H  = 10.0;
HDR_X0 = 2.0;    HDR_X1 = 20.0;
HDR_T  = 2.0;
HDR_Z  = [8.0 - HDR_T / 2, BOARD_H - 8.0 - HDR_T / 2];

// ============================================================
// ✅ マイク面のスイッチ（Usr / Mute）
//    右から1.5と9 / 下から3.5 / 高さ3.5 / 奥行き3 / 幅5
//    （2026-08-04 に座へ当たって挿さらなかった張本人）
// ============================================================
SW_H  = 3.5;   SW_W = 5.0;   SW_D = 3.0;
SW_Z0 = 3.5;   SW_X = [1.5, 9.0];

// ============================================================
// USB-C（ReSpeaker側）
//    ✅ **上の長辺・開口は上向き。縁からは飛び出さず、1.5mm引っ込んでいる**
//      （2026-08-04。一度「1.5mm飛び出す」と逆に読んで訂正された）
//    導出: 上端 Z = 34 − 1.5 = 32.5（✅）。Z方向の長さ8は当初実測 23〜31 のスパンを
//    据え置き（⚠ 下端はその導出値）
//    ⚠ X 76〜88（右端を2mm越える）は当初実測のまま。上辺配置との整合は現物で要確認
// ============================================================
USBC_X0 = 76.0;  USBC_X1 = 88.0;
USBC_Z0 = BOARD_H - 1.5 - 8.0;   // = 24.5 ⚠導出
USBC_Z1 = BOARD_H - 1.5;         // = 32.5 ✅
USBC_H  = 3.2;   // ⚠ 基板面からの立ち上がり

// ============================================================
// ✅ スピーカーソケット（2026-08-04 訂正）:
//    右端は基板右端から1mm → X1 = 85（✅）
//    USB-Cとの間が2mm → 上端 Z = 24.5 − 2 = 22.5（⚠ USB-C下端の導出に連動）
//    下端 Z=12 は当初実測（23〜12）の値を据え置き（✅）
//    ⚠ X0 は「幅5」（当初実測 76〜81 のスパン）を据え置いた仮値
//    高さ10（コネクタを挿した状態）。線の余裕まで見ると15
// ============================================================
SPK_X0 = 80.0;  SPK_X1 = 85.0;
SPK_Z0 = 12.0;  SPK_Z1 = 22.5;
SPK_H  = 10.0;  SPK_CLEAR_H = 15.0;

// ============================================================
// ✅ 3.5mmジャック: X 68〜83 / Z 3〜10 / 高さ5（XIAO面・下辺沿い）
//    （2026-08-04 訂正。当初 61〜82 と伝えられたが本体21mmは部品として長すぎた。
//     訂正後の15mmは典型的なジャック長で、右端の縦積みとも整合する）
//    ✅ 筒は右端から突き出す。⚠ 量は未測 → 5mm と仮置き
// ============================================================
JACK_X0 = 68.0;  JACK_X1 = 83.0;
JACK_Z0 =  3.0;  JACK_Z1 = 10.0;
JACK_H  =  5.0;
JACK_BARREL_D   = 6.5;   // ⚠
JACK_BARREL_OUT = 5.0;   // ⚠ 右端(86)からの突き出し。実測で置き換える

// XIAOのUSB-C（左端から張り出す）
XIAO_USB_OUT = 3.0;   // ⚠
XIAO_USB_Z   = 14.0;  // ⚠ 下端
XIAO_USB_H   = 3.2;   // ⚠

// 挿さる物の長さ（⚠ 全部推測。実測で置き換える）
JACK_PLUG_OUT  = 20.0;
USBC_CABLE_OUT = 25.0;

// ---------------- 描画 ----------------
// f: -1 = マイク面側へ出る（+Y） / +1 = XIAO面側へ出る（-Y）
module face_box(x0, x1, z0, z1, h, f) {
    y = (f > 0) ? -h : BOARD_T;
    translate([x0, y, z0]) cube([x1 - x0, h, z1 - z0]);
}

module board_only() {
    difference() {
        cube([BOARD_L, BOARD_T, BOARD_H]);
        for (p = [HOLE_A, HOLE_B])
            translate([p[0], -1, p[1]])
                rotate([-90, 0, 0]) cylinder(d = HOLE_D, h = BOARD_T + 2);
    }
}

module respeaker_lite() {
    color("#2b6b3f") board_only();

    // 中央領域（⚠ 対称仮定）
    color("#444") translate([CENTER_X0, (BOARD_T - CENTER_T) / 2, CENTER_Z0])
        cube([CENTER_X1 - CENTER_X0, CENTER_T, CENTER_Z1 - CENTER_Z0]);

    // ピンヘッダー 2列
    color("#777") for (z = HDR_Z) face_box(HDR_X0, HDR_X1, z, z + HDR_T, HDR_H, +1);

    // USB-C（右上の角の keep-out）
    color("#9cf") face_box(USBC_X0, USBC_X1, USBC_Z0, USBC_Z1, USBC_H, +1);
    // スピーカーソケット
    color("#eee") face_box(SPK_X0, SPK_X1, SPK_Z0, SPK_Z1, SPK_H, +1);
    // 3.5mmジャック（本体＋右へ突き出す筒⚠）
    color("#333") face_box(JACK_X0, JACK_X1, JACK_Z0, JACK_Z1, JACK_H, +1);
    color("#333") translate([JACK_X1, -JACK_H / 2, (JACK_Z0 + JACK_Z1) / 2])
        rotate([0, 90, 0]) cylinder(d = JACK_BARREL_D, h = (BOARD_L - JACK_X1) + JACK_BARREL_OUT);

    // マイク面のスイッチ2個
    color("#c33") for (x = SW_X)
        face_box(x, x + SW_W, SW_Z0, SW_Z0 + SW_D, SW_H, -1);

    // XIAOのUSB-C（左端から張り出す・XIAO面側）
    color("#9cf") translate([-XIAO_USB_OUT, -XIAO_USB_H, XIAO_USB_Z])
        cube([XIAO_USB_OUT, XIAO_USB_H, 9]);
}

// 挿さる物・線が要る空間。**筐体はここも開ける。**
module respeaker_mating_space() {
    color("#f80", 0.3) {
        // スピーカーの線: 面から15mmまで ✅
        face_box(SPK_X0, SPK_X1, SPK_Z0, SPK_Z1, SPK_CLEAR_H, +1);
        // ジャックのプラグ: 筒の先から右へ ⚠
        translate([BOARD_L + JACK_BARREL_OUT, -JACK_H / 2, (JACK_Z0 + JACK_Z1) / 2])
            rotate([0, 90, 0]) cylinder(d = 10, h = JACK_PLUG_OUT);
        // ReSpeakerのUSB-C: 口は縁より1.5mm内側。挿したケーブルは上へ抜ける ✅向き / ⚠量
        translate([USBC_X0, -(USBC_H + 3), USBC_Z1])
            cube([USBC_X1 - USBC_X0, USBC_H + 3, USBC_CABLE_OUT]);
        // XIAOのUSB-C: 左端から左へ ⚠
        translate([-XIAO_USB_OUT - USBC_CABLE_OUT, -(XIAO_USB_H + 3), XIAO_USB_Z])
            cube([USBC_CABLE_OUT, XIAO_USB_H + 3, 9]);
    }
}

// 上方向の印（単体表示のときだけ。OpenSCADの視点で上下を取り違えないため）
module up_marker() {
    color("#d22") translate([BOARD_L / 2, BOARD_T / 2, BOARD_H + 4]) {
        cylinder(d = 1.5, h = 5);
        translate([0, 0, 5]) cylinder(d1 = 5, d2 = 0, h = 5);
    }
}

// 面のラベル（単体表示のときだけ）。XIAO面側から見ると「XIAO」と読める。
// **鏡文字に見えたら、いま見ているのはマイク面（裏）。**
module face_label() {
    color("#d22") translate([BOARD_L / 2 - 10, -0.5, BOARD_H + 3])
        rotate([90, 0, 0]) linear_extrude(1) text("XIAO", size = 6);
}

respeaker_lite();
up_marker();
face_label();
