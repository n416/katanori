// つまみユニット v5 ── 島は座金＋タブ・留めは上からのねじ2本・抜け止めはEリング（2026-08-19）
//
//   openscad -o knob.stl -D 'part="knob"' hardware/knob_v5.scad   // つまみ（1個）
//   openscad -o wall.stl -D 'part="wall"' hardware/knob_v5.scad   // 島（1個）
//   openscad -o deck.stl -D 'part="deck"' hardware/knob_v5.scad   // 卓上テスト用の天板
//   （part 未指定なら組み立てビュー。part="explode" で分解図）
//
// ============================================================
// なぜ v4 を捨てたか（ユーザーの指摘。2026-08-19）
// ============================================================
// v4 の輪は矛盾していた。**レールとして精度を求められるのに圧入をしているせいで歪む。**
// へこみの穴の側壁は刷った面なので必ず荒れていて、設計では消せない。圧入すれば輪は
// その形を写して歪む。逃げを作れば留め具が無いので、側面を削ればポロポロ外れる。
// さらに輪の厚み 1.2 とツメの高さ 1.3 がほぼ等しく、縦の逃げが無かった。
// 歪みがそのまま縦に効いて、ツメが床を擦って回らなくなった（実機）。
//
// v5 の骨子と、誰が決めたか:
//   ・島はどこにも押し付けない。**圧入ゼロ**（ユーザー・3回言わせた）
//   ・島は上下に挟まれていて落ちようがない。留めはダボで足りる（ユーザー）
//   ・抜け止めは半月ではなくステンレスのEリング（ユーザー・再三）
//   ・限界止めはタブ（当たり面）だけが持つ。**ねじは限界止めを兼ねない**
//   ・外側の輪とスリットは廃止（ユーザー「歪む壁に壁を建てるな」）。島は座金＋タブ1枚
//   ・島の厚み＝ねじ頭＋薄い底、天板側を厚くして飲む（ユーザー）
//   ・軸 φ7、ねじの半径、Eリング呼び6 … **AIが決めた値**。
//     ユーザーの決定ではない。おかしければ遠慮なく動かすこと
//
// ============================================================
// 2026-08-19（同日・2回目のユーザー指示）で変えた4点
// ============================================================
//   ① 天板のダボ台座（床の掘り残し3点）を削除。へこみの床は全面フラット
//   ② 限界止めのねじ位置（タブの中心・286度）をやめる。タブは当たり面としてだけ残る
//   ③ 島を留めるねじを**2本**にして左右（±X）へ。島がその径で足りないので φ20 → φ22
//   ④ 太った島がツメの道を塞ぐので、ツメを外へ 1.0 動かし、へこみの壁と
//      つまみの外径を**半径で 1.0 ずつ**広げた（へこみ φ26.2 → φ28.2 /
//      つまみ φ25 → φ27）。⚠ 壁を広げたのはユーザー指示「横壁は荒れるから」で、
//      ツメと壁のすき間 1.4mm を現行と同じに保つため
//
// 🔴 このとき AI は「本体水平方向に2個のねじ」を**ねじの軸が水平＝横から刺す**と
//    読み違えた。正しくは**2本の並びの方向**。読み違えたまま「ツメの通り道を
//    横切るので不可能」という報告を2回出した。回る物の通り道にねじを立てる形が
//    出てきた時点で、読みの方を疑うこと。
//
// ---- 組む順 ----
//   ⓪ リードの足を両端とも下へ曲げてから、裏の穴から押し棒で押し込む（肩当たりまで）
//   ① 島をへこみに置く（タブの向きを合わせるだけ。ダボも座も無い）
//   ② 左右のねじ2本を上から締める（M2.5 ナイロン。頭は島に沈む）
//   ③ つまみを上から挿す（軸はまっすぐ。島の穴を素通り）
//   ④ 天板の裏から、軸の溝にEリングを横から差す。🔒 **向きは ±Y のみ**（口を手前に）。
//      ⚠ ±X から入れると島のねじの胴（±7.9, 0）に当たる。柱の細い区間も通す。
//      ✅ 2026-08-20 に実体で検査した（part="eringpath" が空／"eringpathx" は非空）
//   ⑤ AS5600 基板を柱に留める
//
// ---- 🔒 治具から引き継ぐ実績値（作り直さない）----
//   SHRINK 0.1 / MAG_D 4.10 / BORE_CLEAR 0.25 / CHIP_GAP 1.1
//   HOLE_PITCH 17.0 / SLOT_LEN 2.0 / STANDOFF_D 6.0
//
// ---- 手持ち・調達 ----
//   ✅ M2.5 ナイロンねじ（なべ）… 頭の高さ 3.0（2026-08-19 実測）。📄 長さ 6mm・頭 φ5.0
//   ⬜ ステンレス Eリング … ユーザーが購入予定。軸 φ7 なので**呼び6**。
//      📄 適用軸 7〜9・溝径 6.0・厚さ 0.8・溝幅 0.9・外径 12〜13 — **記憶なので、
//      届いた実物で溝径・厚さ・外径を照合してから刷る**（外径は echo ⑤ の通り道に効く）
//
// ---- リードスイッチ: 横・水平・磁石の高さ（🔒 ユーザー 2026-08-19・最終）----
//   🔒 出発点: **下（床の中）ではぎりぎりだから横に出す**（ユーザー）。
//   🔴 AI は「水平にして」を「床下の穴に戻す」と誤読して一度戻した。正しくは
//   「横の位置のまま、水平に寝かせて磁石に近づける」。以後これが正。
//     ・磁石は軸を接線方向へ（円板を立てる＝v4 と同じ）。中心 r 9.40・外縁 r 12.40
//       🔴 2026-08-20 差し戻し。08-19 に「軸を半径方向＝面が正対」に変えていたが、
//          その向きは**2箇所で鳴る**（ユーザーがテスタで再現）。詳細は下の節
//     ・リードは水平・接線方向。へこみの壁のすぐ外（y 14.5〜17.75）、**磁石と同じ高さ**
//       （z -0.5〜-3.75。天井は見える面の下 0.5）
//     ・接点 (0, 16.125, -2.13) ↔ 磁石の外縁（r 12.40・z -2.45〜+3.55）＝
//       **真横に 3.73mm**。⚠ 「閉じるのは5mm」は**正対で測った値なので当てにしない。**
//       B向きの閉じる距離は未測定（⬜ TODO）。v4 の 4.69mm より近い側なのは確か
//     ・挿し方は下から圧入のまま: 裏 -9.0 から 3.95 角の呼び込み → z -4.0 から
//       3.25 角（✅実績値）の座 → 天井 -0.5 で突き当たり
//     ・押し込み量は**段付きの押し棒**（part="rod"）。肩が増し肉の裏に当たったら終い
//     ・足は両端から。挿す前に根元 2mm 残して下へ曲げ、両脇の縦の溝から裏へ。
//       ⚠ モールドの際で曲げると足の付け根が傷む（2mm 残す）
//       🔴 2026-08-21 訂正: ここは長らく「ガラス」と書いていたが、**現物は樹脂モールドの
//          角物**（ユーザー）。3.25mm 角の座に入る時点で丸いガラス管ではない
//   ⚠ 磁石とリードの間: 磁石の面 12.51 →（すき間）→ へこみの壁 14.1 →（肉 0.4）→ 14.5
//
// ---- ⬜ まだ入っていないもの ----
//   ・刷り直したらゼロ点を取り直す（knobzero）

part = "all";
raft = (part == "deck");   // サポートの床。刷るときだけ。-D raft=true/false
$fn  = 96;

use <parts.scad>   // magnet_reed() / as5600()

// ---- 治具から引き継ぐ ----
SHRINK     = 0.1;
MAG_D      = 4.10;
MAG_DEPTH  = 2.2;
BORE_CLEAR = 0.25;         // 🔒 軸受けの遊び（直径）。入口逃がしとセットで成立する値
PCB        = 23.0;
PCB_T      = 1.6;
CHIP_H     = 1.1;
CHIP_GAP   = 1.1;
HOLE_PITCH = 17.0;
SLOT_LEN   = 2.0;
STANDOFF_D = 6.0;
M2_D       = 2.0 + SHRINK + 0.3;
M2_NUT_AF  = 4.0 + 0.3;
M2_NUT_T   = 1.6;
M2_SHELF   = 1.2;
STANDOFF_D_LO = 8.0;

// ---- 手持ちの M2.5 ナイロン（島を留めるのに2本使う。⬜ 在庫の本数を確認）----
M25_HEAD_D = 5.0;          // ⚠ 未実測（2026-08-15 のメモ）
M25_HEAD_T = 3.0;          // ✅ 2026-08-19 実測
M25_LEN    = 6.0;          // 📄 2026-08-15 のメモ。⚠ 変わったら echo ③ を見ること

// ---- M2.5 のナット（2026-08-21・貫通＋ナットへ移行。ユーザー指示「6角形を掘る」）----
// 🔒 樹脂にネジを切らない。[DIMENSIONS.md](../docs/DIMENSIONS.md) 418行に既にある方針
//    （「樹脂にネジを切らず、貫通＋ナットにする」）。天板の下穴 φ2.1 はこれに反していた
M25_NUT_AF = 5.0;          // ✅ 2026-08-21 実測（二面幅）。規格値と一致
M25_NUT_T  = 2.0;          // ✅ 2026-08-21 実測（厚み）。規格値と一致＝薄型ではない

// ---- つまみ ----
GRIP_D   = 27.0;           // 25 → 27（④・半径で +1.0。へこみの壁を広げた分）
GRIP_H   = 8.0;
RIB_N    = 0;
RIB_D    = 0;
GRIP_GAP = 0;              // 🔒 持ち手の裏は島の上面に乗る（重さの受け）。グリスはこの面
// 軸。まっすぐ1本。φ7 は AI が決めた値: 磁石ポケット φ4.10 の壁が (7−4.1)/2 = 1.45 に
// なる（φ6 の 0.95 は折れた実績、実証済みは φ8 の 1.95。8 だと島の穴を通したとき
// 軸受けがゆるくなり過ぎる）。⚠ 1.45 は未実証。割れたら MAG_D 4.2＋接着へ
SHAFT_D  = 7.0;

// ---- Eリング（⬜ 実物照合まで 📄）----
// 📄 JIS B 2804 の呼び6（2026-08-20 に規格表で照合。実物を待たずに机上で取れた）:
//    適用軸径 7〜9 ／ 厚さ t 0.8 ／ 溝径 d2 6.05 ／ 溝幅 m 0.9
//    → 軸 φ7 は適用範囲の**下限ちょうど**。t は一致。溝径・溝幅は下記のとおり僅差
ERING_GRV_D  = 6.0;        // ✅ 規格 6.05 に対し 0.05 きつい側。刷りの誤差以下
ERING_GRV_W  = 0.95;       // ✅ 規格 m 0.9 に対し 0.05 広い。引き上げ量を作るための意図的な遊び
// ✅ 2026-08-21、**実物で合格**。刷ったつまみの溝に呼び６のリングがばっちり付いた（ユーザー）。
//    溝径・溝幅はこのまま。**触らない。**
//    🔴 AI は「張り出しが膚らむと溝幅 0.95 − リング厚 0.8 の遊び 0.15 を食う」と心配したが、
//    E リングは**爪が食い込むまで押し込む**部品なので、その読み方が間違い。
//    溝の平面度も同じ理由で判定に使えない
ERING_T      = 0.8;        // ✅ 規格と一致
// ✅ 2026-08-20 確定。**呼び6 の外径は 12.0**（ユーザー・セットの現物）。
// 🔴 この日、14.0 という値でひと騒ぎした。原因は**呼びの取り違え**で、測っていたのは
//    セットに入っていた**呼び7**（外径 14）だった。**E リングの「呼び」は溝径であって
//    軸径ではない。** 軸 φ7 に使うのは呼び6（適用軸 7〜9）で、呼び7 は適用軸が太すぎる。
//    ⚠ AI はどの径を聞いているのかを図で示さないまま数字だけ求め、返ってきた 14.0 を
//      「写真では 11〜12mm」と称して否定した。その読みは捏造で、取り消した。
//    ⚠ 57行目のメモには 08-19 の時点で「外径 12〜13」と書いてあった。AI はそれを
//      読まずに「12.7 は仮の値」と言い続けた。**自分のメモを先に読むこと。**
ERING_OD     = 12.0;       // ✅ 呼び6・実物（2026-08-20）
ERING_PLAY   = 0.3;        // リングと受け面のすき間＝つまみを引ける量

// ---- 天板 ----
DECK_T = 2.5;
// 🔴 2026-08-21: 一度 6.5 → 8.0 にしたが、**戻して段差にした**（ユーザー判断）。
//    経緯: ナットの六角ポケットを掘る肉が足りず（天井 0.1mm）、板全体を 8.0 に厚くした。
//    ところが**筐体の座は knob_station_add() そのもの**（case_v2.scad 1729行）なので、
//    厚くした外周の角が PowerBoost の実装へ 13.68mm3 噛み、筐体側を削る羽目になった。
//    🔒 **厚みが要るのは軸まわりだけ**（ねじは半径 7.9・六角の外縁でも 10.96）。
//    ⇒ 外周は 6.5 のままで、中央に段（BOSS）を足す。筐体側の削りは要らなくなった
PAD_T  = 6.5;              // 外周の厚み。⚠ ナットが入るのは下の段（BOSS）の中
HOLE_D = SHAFT_D + SHRINK + 0.9;   // 8.0 通し穴。⚠ 軸受けではない（軸受けは島の穴）
// 44 → 30（2026-08-19・ユーザー指示「左右の幅を縮める」。筐体設計が knob_bay_x() で使う）。
// その後 ④ で 32 へ戻した。X に要るのは AS5600 の柱の外縁 ±13.5 と、へこみ ±14.1。
// ±16 で壁 1.9・柱の外縁まで 2.5 残る
PAD_X  = 32.0;             // 30 → 32。へこみが r14.1 になったので壁 1.9 を保つ
// 🔴 2026-08-21、37 → 39（**ユーザーが 🔒 を解いて許可**）。
//    理由: リードの穴の外周側の壁が、**押し込む力が一番かかる入口（裏面）で 0.40mm** しかなく、
//    実機で「薄すぎて押し込みの際に負ける」（ユーザー・スクリーンショットで指示）。
//    座の壁 0.70 より入口が薄いという最悪の配置だった。39 で入口 1.40／座 1.70 になる。
//    ⚠ 穴の側（REED_LOOSE）から取る手も測ったが、取れるのは 0.40 → 0.70 だけで、
//      しかも y 方向の呼び込みがゼロになる。**押し込みで負けているのに入りにくくする**ので却下。
// 🔒 以前の注記（有効なまま）: **外形を動かすと case_v2 の座（knob_bay_y）へ伝わる。**
//    外形は外の都合の数字なので、次に動かすときも必ずユーザーに聞くこと。
//    ⬜ case_v2 側に余地があるかは別途確認する（この版では case_v2 を触っていない）
PAD_Y  = 39.0;             // 35 → 37 → 39。リードの穴は y 14.5〜18.1（入口）
DISH_D = GRIP_D + RIB_D + 1.2;   // 28.2（r14.1）
DISH_T = 2.5;

// ---- リード用磁石（持ち手の裏から挿す・🔒 軸は接線方向＝リードの長手と平行）----
// 🔒 2026-08-20 ユーザーが実測して決着。**面をリードに正対させると2箇所で鳴る。**
//    08-19 に一度「軸を半径方向へ」（＝正対）に変えたが、それは 08-16 の実測を
//    読み違えたもので、08-20 に同じ現象を再現して差し戻した。v4 の向きへ戻す。
//    ⚠ この向きは二度と変えない。変えるなら先にテスタで「鳴る箇所が1つ」を見ること
MAG2_PART_D = 6.0;
MAG2_D  = MAG2_PART_D + 0.3;   // ✅ ゲージ3列目
MAG2_T  = 2.2;
STOP_OFF_ANG = 10;
// 中心の半径。⚠ AI が決めた値。B向きでは円板の**直径 6.3 が半径方向に立つ**ので、
//    ポケットの角は（x ±1.01, y MAG2_R+3.15）。持ち手の外周 13.5 までの壁を
//    **v4 の実績値 0.91mm** に合わせると MAG2_R = 9.40（磁石の外縁 r12.40）。
//    ⚠ 圧入の押しは厚み方向＝**接線方向**なので、この外壁は押されない（v4 と同じ）
MAG2_R  = 9.40;            // 🔒 08-20 の差し戻し。11.5(A向き) → 9.40(B向き)
MAG2_ANG = 90 - STOP_OFF_ANG;
MAG2_SEAT_Z  = MAG2_PART_D + 0.05 - MAG2_D / 2;
MAG2_SLOT_W  = 2.02;       // ✅ ゲージ点1。🔒 SHRINK を足さない
// B向きでは外を向いているのは平らな面ではなく円板の**外縁**。名前はそのまま使う
MAG2_FACE_R  = MAG2_R + MAG2_PART_D / 2;   // 12.40 磁石の外縁（リードに一番近い点）

// ---- リードスイッチ（横・水平・磁石の高さ。下から圧入）----
// 🔴 2026-08-21: ここに付いていた「✅ v4 の実績値」は**私の誤り**。v4 のそれは
//    開いた溝（knob_v4.scad:269「溝の断面。部品は 3.2 角（📄 2026-08-16 の寸法図）」）で、
//    閉じた圧入の座ではない。しかも v4 の ⬜ に「リードスイッチ一式」とあるとおり、
//    v4 でリードを入れたことは一度も無い。**実物で確かめた値ではなかった。**
//    ✅ 実機（2026-08-21・ユーザー）: 裏から押したら**途中で止まって入らない**。
//    部品 3.2 角（📄）＋ docs/PRINT.md の縮み 0.1 → 焼き上がりの座 ≈ 3.15 ＝ 部品より小さい。
//    🔴 訂正: 「一度も確かめていない」は誤り。docs/KNOB-ENCODER.md:117 に
//       「溝の圧入 3.25（部品 3.2角）✅ 2026-08-16 ゲージ fit_gauge.scad 点2」がある。
//       ✅ が付いているのは**片側が開いた溝**で、v5 は**四方を囲んだ 8.5mm の深穴**。
//       同じ 3.25 でも囲まれたほうがきつく出る。値ではなく条件が違う。
//    ⬜ 天板を刷り直すときに決める（part="reedgauge" を用意してあるが、まだ刷らない）
// ✅ 3.30 = fit_gauge.scad の指示どおりの値。ゲージの記録は 点2=3.25（落ちない中で
//    いちばんきつい穴）で、同ファイルに「ゲージの噛み代 3.6mm に対し本番は 14.3mm 噛む
//    ので、ちょうどに感じたら**一段ゆるい方**を採ること」と書いてある。一段ゆるい＝点3＝3.30。
//    3.25 のまま書き戻されていなかった（2026-08-21 に気付いて修正）。
//    ⬜ **未解決**: fit_gauge の作法は「穴は全部貫通・袋穴にするな」。この座は天井 -0.5 で
//       閉じた袋穴で、作法に反している。天井で押し込み量を止める設計と衝突する
REED_W      = 3.30;        // 圧入の座の角
REED_BODY_L = 14.0;
REED_L      = REED_BODY_L + 0.3;   // 14.3 穴の長手（本体＋逃げ）
REED_IN     = 14.5;        // 穴の内側の面の y。へこみの壁 14.1 との肉は x=0 で 0.4
REED_TOP    = -0.5;        // 突き当たりの天井。見える面の下の肉 0.5
REED_LOOSE  = 0.30;        // 呼び込みの広げ（+Y と ±X のみ）。0.35 → 0.30（2026-08-21・
                           //   座を 3.30 にしたぶんを外形でなくここで吸う）
REED_TIGHT_H = 3.5;        // 圧入の座の高さ（-4.0 〜 -0.5）
LEAD_CH_W   = 1.4;         // 両端の足（下へ曲げたもの）を通す縦の溝

// ---- 島（厚い座金＋タブ。留めは上からのねじ2本だけ）----
WALL_T   = 3.9;            // 🔒 縦の逃げの本体（ユーザー案の厚み）
ISL_OD   = 22.0;           // 20 → 22（③）。ねじのザグリを島の肉に収めるため。
                           //    へこみ 28.2 との間は 3.1mm 空く（＝側壁に触れない）
ISL_BORE = SHAFT_D + SHRINK + BORE_CLEAR;   // 7.35 軸受け（半月の実績値を引き継ぐ）
BORE_RELIEF = 0.3;         // 入口逃がし（プレート側の過硬化。半月で実証済みのペア）
RELIEF_T = 0.3;            // 床の掘り下げ。島は床から 0.3 浮く（⬜ 下の注記）
// 🔒 ダボは廃止（2026-08-19・ユーザー「荒れる面に複雑な細工をしない」）。
//    ①（同日2回目）で**ダボ台座＝床の掘り残し3点も削除**した。へこみの床は全面フラット。
//    ダボと座の仕事は、左右のねじ2本が全部引き受けている:
//      位置決め・回り止め・抜け止め … ねじ2本（1本ではねじを軸に回れるが、2本は回れない）
//      向き決め … 2つの下穴が合う向きは1つだけ
//      裏返し防止 … 裏返すとザグリが下を向き、ねじが締められない
// ⬜ **床は 0.3 低いので、締めると島は 0.3 下がって支柱の痕に乗る。**
//    許すなら RELIEF_T を 0 にして床を島の底の高さに上げる（痕が全部効くようになる）。
//    どちらもユーザーの決定が要る。echo ② が数字を出す

// ---- 回転の限界止め（島のタブ。②でねじは外した。タブは当たり面だけ）----
// 🔒 可動域は 315度ちょうど。超えるとファームが 0%＝無音に倒れる。
// タブは島と一体（厚み3.9）。ツメが当たるのはタブの側面。
STOP_ANG   = 270;          // 当たり面の角度（時計回り側。v4 と同じ）
TAB_ARC    = 32;           // 🔒 タブの角度幅。ねじが抜けても**動かさない**。
                           //    LUG_ARC と足して 45 ＝ 可動域 315 を作っている数字
TAB_R1     = 13.0;         // タブの外径。へこみの壁 14.1 と 1.1 空く
LUG_ARC    = 45 - TAB_ARC; // 13度 → 可動域 315 ちょうど。⚠ ツメは幅約2.9mmと薄い
LUG_R0     = 11.5;         // ツメの内側。島の外径 11.0 と 0.5 空く（④で外へ 1.0）
LUG_R1     = 12.7;         // ツメの外側。へこみの壁 14.1 と 1.4 空く（🔒 荒れる面なので
                           //    このすき間は削らない。ユーザー指示で壁ごと外へ出した）
STOP_T     = 1.3;          // ツメの高さ＝掛かり

// ---- 島を留める上からのねじ2本（ユーザー指示③・2026-08-19）----
// 🔒 「本体水平方向に2個」＝**2本の並びが左右**という意味。ねじ自身は上から下へ挿す。
// 半径 7.9 を決めているのは**Eリング**。ねじの先は天板の裏へ 3.0mm 出るので（SCR_TIP_Z）、
// そこに居るリング（外径 12.7・r6.35）を避ける必要がある。上から見た都合だけなら
// r6.84 まで内へ寄せられて島の拡大も不要だったが、リングがそれを許さない。
//   内へ寄せる下限 … ザグリの内縁が軸受けの穴 3.675 に当たる → 6.78
//   外へ出す上限 … ザグリの外縁が島の外径 11.0 に当たる → 7.9（肉 0.4）／ 肉ゼロでも 8.3
//   リングの下限 … 6.35 ＋ 胴の半径 1.25 ＋ すき間 0.3 → 7.9
// ⚠ 2026-08-20 に「この位置は消えた」と書いた段落があったが、**取り消した（2026-08-21）**。
//    根拠にしていたリング外径 14.0 は**呼び7 を測った誤り**で、同じ日に 12.0 で決着している
//    （127〜148行 ／ [TODO.md](../docs/TODO.md) A-3）。r 6.0 なら半径 7.9 で 0.65mm 空く。
//    **ねじの位置 7.9 は生きている。** 消し忘れたコメントで別の判断をしないこと。
// 🔴 **2026-08-21、下穴 2.1 は誤りと確定。** これは鋼のタップ下穴（M2.5 = 2.05）の数字で、
//    ねじが自分で溝を切る前提。噛ませる相手は PLA で、ねじは**ナイロン**なので溝を切る前に
//    ねじが負ける。そもそも [DIMENSIONS.md](../docs/DIMENSIONS.md) 418行に
//    「樹脂にネジを切らず、貫通＋ナットにする」と既に書いてあった。**貫通＋ナットへ移す。**
//    🔴 ただし**ナットは E リングに当たる**。M2.5 ナット（二面幅 5.0）を裏 z -9 に置くと、
//       内側は平面で r5.40・角で r5.01 まで来る。リングの外周は r6.0（z -10.1〜-9.3）。
//       → **半径で 0.6mm（角なら 1.0mm）食い込む。** ねじの胴だけなら 0.65mm 空いていたのが、
//       ナットの分だけ足りない。⬜ どう逃がすかは未決（AI が勝手に決めない）
// 🔒 天板は**通し穴**。ねじは天板に噛まない（噛むのは裏の六角ポケットのナット）
// ✅ 2026-08-21、**実物で確認**。ユーザーが刷ってあった天板の下穴をドリル φ3.0 で開け直し、
//    M2.5 ナイロンねじが通った（2.5mm のドリルが無くて 3.0 を使ったとのこと）。
//    計算上の逃げ 3.0 と、手で開けた穴が一致している
SCR_THRU    = 2.5 + SHRINK + 0.4;      // 3.0 島側の逃げ SCR_D と同じ寸法
NUT_POCK_AF = M25_NUT_AF + 0.3;        // 5.3 ✅「六角ポケットは呼び+0.3 でジャスト」の実績値
NUT_POCK_T  = M25_NUT_T + 0.2;         // 2.2 ナットは**裏面と面一**に沈む（下へ出さない）
// ポケットの天井＝ねじがナットを引き上げて突き当たる面。ここが薄いと抜ける
// ---- 中央の段（BOSS）。2026-08-21。ナットを埋める肉をここだけで稼ぐ ----
// 🔒 外周を厚くしないのは、**筐体の座がこの形そのもの**だから（PAD_T の注記）。
//    外周を下へ伸ばすと PowerBoost に当たる。中央だけなら当たらない
// ⚠ 径は六角ポケットの外縁（半径 7.9 ＋ 角 3.06 ＝ 10.96）を包むこと。echo ③a が検算する
BOSS_D      = 23.0;                    // 段の外径
BOSS_T      = 1.5;                     // 段の高さ（以前は板全体をこの分厚くしていた）
SCREW_R    = 7.9;
SCREW_ANG  = [0, 180];     // 🔒 左右。タブ（270〜302度）にもリードの穴（+Y）にも掛からない
// 📌 **ハの字（外向きに倒す）＝作業ではない。記録だけ。**（2026-08-21）
//    ⚠ ユーザーは明言している: 「これはもちろんやれって話じゃない。**理屈がおかしいと
//      色々壊れるから**って話だよ」。**ねじは垂直のまま・形は変更していない。**
//      ここを残すのは、下の 🔴 と同じ誤りを AI が繰り返さないため。
//    狙いは、ねじの先を外へ逃がして E リングの通り道（いま片側 0.65mm）を広げること。
//    🔴 AI は最初「効かない（最大 +0.22mm）」と報告したが、**それは誤り**。
//       「島の外周に 0.4mm の肉を必ず残す」という条件を AI が勝手に固定していたせいで、
//       倒すたびに頭を内へ寄せる羽目になり、稼ぎが相殺されていた。頭を 7.9 に置いたまま
//       倒せば話は別で、**軸受け側はほとんど動かない**（効くのは島の外周だけ）:
//         傾き  リングの逃げ   軸受けまでの肉   島の外周の肉
//          0度      0.65mm         1.53mm          0.40mm
//          5度      1.07mm         1.51mm          0.08mm  ← 無傷で稼げる上限
//         10度      1.48mm         1.48mm         -0.26mm  ← ザグリが島の縁に開く
//         20度      2.32mm         1.35mm         -1.05mm
//    島の縁が開いた先に当たる物は無い（島 r11 → へこみの壁 r14.1 まで 3.1mm）。
//    失うのは頭の座の一部と、そこの縁の強度だけ。
//    ⚠ ユーザーは別途「斜め穴は精度が出しづらい」とも言っている。ただし**この穴は刷るので、
//      手で開ける話ではない**（実物をドリルで開けたのは φ2.1 が誤りだったせいの応急処置）
//    ⚠ **ユーザーの評価は「構造的には効く」**（2026-08-21）: 「抜けづらくなるしね。ただ
//      **精度が出せないからダメだろう**ってのが私の意見」。つまり却下の理由は**精度の1点**で、
//      構造は否定されていない。⚠ AI が上で数えたのはリングの逃げだけで、**抜け止めの効きは
//      数えていない**。「効かない」と読める書き方をしていたが、それは逃げの話でしかない。
//    ⬜ 未検証の問い（会話に出さず、必要になったらここから拾う）: 釘やダボの「ハの字は
//      抜けにくい」は、**ねじ＋ナットで締めたこの構成にもそのまま効くのか**。
//      いまは頭とナットの締結で、抜けは軸方向の引張として効いている
//    📌 採用も検討もしていない。**この段の価値は数字ではなく、AI の理屈が壊れていた事実**
SCR_CB_D   = M25_HEAD_D + 0.4;         // 5.4
SCR_CB_T   = 3.5;          // 頭3.0が 0.5 沈む。底 0.4 が残る
SCR_D      = 2.5 + SHRINK + 0.4;       // 3.0 島側の通し穴（逃げ。頭が島を押し下げて留める）

// ---- AS5600 の柱 ----
// 🔒 下端（ナットの座 3.5）は v4 のまま。その上は**細い丸柱 φ3.6** に絞る。
//    理由: Eリングは横からしか入らない。柱が太いと、リングが柱のあいだを通れない。
//    v4 で柱を外へ開いていた理由（ツメとの干渉）は、ツメが天板の上へ移った時点で消えている
POST_XY_LO = HOLE_PITCH / 2;   // 8.5 基板の穴の位置（ここは動かせない）
POST_THIN  = 3.6;          // 細い区間の径。⚠ echo ⑤ でリングの通り道を必ず見る
POST_STRAIGHT = 3.5;       // 🔒 下端はまっすぐ（M2 ナットの座を彫る区間）

// ---- 面取り ----
GRIP_CH = 0.8;
CH_S    = 0.3;

// ---- Z（天板の見える面 = 0、+Z が外）----
Z_DISH     = -DISH_T;                    // -2.5  へこみの底＝島の上面
Z_GRIP_B   = Z_DISH + GRIP_GAP;          // -2.5  持ち手の裏（島に乗る）
Z_DECK_BOT = -DECK_T;                    // -2.5
Z_PAD_BOT  = -(DECK_T + PAD_T);          // -9.0  外周の裏。柱・リードの穴・押し棒はここ
Z_BOSS_BOT = Z_PAD_BOT - BOSS_T;         // -10.5 段の裏＝**Eリングの受け面**・ナットの底
Z_WALL_T   = Z_DISH;                     // -2.5  島の上面
Z_WALL_B   = Z_WALL_T - WALL_T;          // -6.4  島の下面
Z_RELIEF   = Z_WALL_B - RELIEF_T;        // -6.7  掘り下げた床
// ポケットの天井＝ねじがナットを引き上げて突き当たる面。ここが締結力を全部受ける
NUT_ROOF   = Z_RELIEF - (Z_BOSS_BOT + NUT_POCK_T);   // 1.6 ⚠ echo ③b が見る
RELIEF_D   = RELIEF_T;
Z_LUG_B    = Z_GRIP_B - STOP_T;          // -3.8
Z_GRV_T    = Z_BOSS_BOT - ERING_PLAY;    // -10.8 溝の上端（受け面は段の裏）
Z_GRV_B    = Z_GRV_T - ERING_GRV_W;      // -10.25 溝の下端
Z_CONE_B   = -13.7;                      // 円錐が φ7 に達する高さ＝磁石ポケットの天井
// 🔒 基板から下は v4 と同じ数字に合わせる（箱側の当て板を動かさないため）
Z_MAG_BOT  = -15.9;                      // 磁石の下面＝軸の下端
Z_MAG2_TOP = Z_GRIP_B + MAG2_SEAT_Z + MAG2_D / 2;   // 3.55
Z_MAG2_BOT = Z_MAG2_TOP - MAG2_PART_D;              // -2.45
Z_CHIP_TOP = Z_MAG_BOT - CHIP_GAP;       // -17.0
Z_PCB_TOP  = Z_CHIP_TOP - CHIP_H;        // -18.1
Z_PCB_BOT  = Z_PCB_TOP - PCB_T;          // -19.7
SCR_TIP_Z  = (Z_WALL_T - SCR_CB_T) - M25_LEN;   // -12.0 ねじの先（増し肉を貫通して下へ出る）

function knob_deep()   = -Z_PCB_BOT;             // 19.7（v4 と同じ）
function knob_grip_h() = Z_GRIP_B + GRIP_H;      // 5.5
function knob_dish_d() = DISH_D;   // 筐体はこれで置き場所を決める（🔒 数字を二重に持たない）
function knob_bay_x()  = PAD_X;
function knob_bay_y()  = PAD_Y;
function knob_pad_h()  = DECK_T + PAD_T;

function post_inner_r() =
    sqrt(pow(HOLE_PITCH / 2 - SLOT_LEN / 2, 2) + pow(HOLE_PITCH / 2, 2)) - STANDOFF_D / 2;

// ---- 角の面取り ----
module ch_top(r, z, c) {
    translate([0, 0, z - c]) difference() {
        cylinder(r = r + 3, h = c + 0.01);
        cylinder(r1 = r, r2 = r - c, h = c);
    }
}
module ch_bot(r, z, c) {
    translate([0, 0, z - 0.01]) difference() {
        cylinder(r = r + 3, h = c + 0.02);
        translate([0, 0, 0.01]) cylinder(r1 = r - c, r2 = r, h = c);
    }
}
module ch_hole_top(r, z, c) {
    translate([0, 0, z - c]) cylinder(r1 = r, r2 = r + c, h = c + 0.01);
}
module arc_block(r0, r1, a, z0, z1) {
    translate([0, 0, z0]) rotate_extrude(angle = a)
        translate([r0, 0]) square([r1 - r0, z1 - z0]);
}

// ============================================================
// つまみ（1部品）
// ============================================================
// cone=true … 溝の下を磁石まで円錐にする（ユーザー案・2026-08-21）
// cone=false … 段のまま（失敗した現物と同じ形）。柱の対照実験用
// 🔒 **正は段（cone = false）。2026-08-21 夕、ユーザーが実機で決定。**
//    円錐版は E リングが傾いたので落とした（下の 🔴 を見ること）。
//    比較したいときだけ part="knobcone"。**既定は段。**
KNOB_CONE = false;
module knob_part(cone = KNOB_CONE) {
    difference() {
        union() {
            translate([0, 0, Z_GRIP_B]) {
                cylinder(d = GRIP_D, h = GRIP_H);
                if (RIB_N > 0) for (i = [0 : RIB_N - 1]) rotate([0, 0, i * 360 / RIB_N])
                    translate([GRIP_D / 2, 0, 0]) cylinder(d = RIB_D, h = GRIP_H);
            }
            // 軸。まっすぐ1本
            translate([0, 0, Z_MAG_BOT])
                cylinder(d = SHAFT_D, h = Z_GRIP_B - Z_MAG_BOT + 0.01);
            // 回転のツメ。持ち手の裏から下ろす。限界止めのねじの胴に当たる。
            // 🔒 位置は v4 と同じ（当たり面 270度）。ずらすのは磁石（MAG2_ANG）の側
            rotate([0, 0, STOP_ANG - LUG_ARC])
                arc_block(LUG_R0, LUG_R1, LUG_ARC, Z_GRIP_B - STOP_T, Z_GRIP_B);
        }
        // Eリングの溝。上の面（Z_GRV_T）は φ7 の肩。下は円錐（下の union 側）に置き換えた
        translate([0, 0, Z_GRV_B]) difference() {
            cylinder(d = SHAFT_D + 2, h = ERING_GRV_W);
            translate([0, 0, -0.01]) cylinder(d = ERING_GRV_D, h = ERING_GRV_W + 0.02);
        }
        // 🔒 2026-08-21・ユーザー案「磁石の所まで円錐にすればいい」。
        //    溝の下を段（φ6→φ7）で戻すのをやめ、磁石ポケットの天井まで円錐で太らせる。
        //    ・段だと幅 0.5mm の平らな面が支え無しで宙に出る。実機で軸がここでずれた
        //    ・v4 の段B が既に同じ考え方（🔒「止めは平らな段ではなくテーパになり、
        //      半月の内穴の縁に食い込んで止まる」）。抜け止めはテーパの楔で成立する
        //    ・φ7 を超えないので、島の穴 φ7.35 を素通りする条件は変わらない
        // 🔴 **2026-08-21 夕、実機で覆った（ユーザー）。** 同日昼の 🔒「円錐は実績ありの形状
        //    だから今の形がいい／試験の結果に関わらず段には戻さない」は**取り消し**。
        //    実物での所見はこの2つ:
        //      ・円錐版（part="knob"）… 印刷は「抜群に綺麗」。**しかし E リングが傾く。**
        //        溝の下面が斜面なので、リングの下が平らな面に座らない
        //      ・段版（part="knobplain"）… **サポート無しで綺麗に出力できた**
        //    ⇒ 円錐を入れた理由（「段だと幅 0.5mm の平らな面が支え無しで宙に出て刷れない」）は
        //      **実物で否定された**。前回の失敗は形ではなく**宙で刷った治具の屑**だった、
        //      というのがユーザーの結論。⬜ どちらを正にするかは下の part の行を見ること
        //       ⚠ 同日、前回の失敗の主因は**宙で刷った治具の屑**だった可能性が高いと判明
        //       （つまみが根本から曲がり、島まで歪んでいた＝形では説明できない）。
        //       それでも円錐を残すのは、v4 の実績があって段より確実に良い形だから
        if (cone) translate([0, 0, Z_CONE_B]) difference() {
            cylinder(d = SHAFT_D + 2, h = Z_GRV_B - Z_CONE_B + 0.01);
            cylinder(d1 = SHAFT_D, d2 = ERING_GRV_D, h = Z_GRV_B - Z_CONE_B + 0.01);
        }
        // 磁石ポケット（AS5600用 φ4.10 × 2.2）。⚠ 壁 1.45（未実証）
        translate([0, 0, Z_MAG_BOT - 0.01]) cylinder(d = MAG_D, h = MAG_DEPTH + 0.01);
        // 🔒 押し出し穴・空気穴・入口逃がしは開けない（v4 の経緯。抜くのは磁石で吸う）
        // リード用磁石。🔒 **円板を立てて、軸をリードの長手方向（接線）へ向ける。**
        //   ⚠ 面をリードに正対させる（軸を半径方向にする）と、リードの真正面が
        //     不感帯になり、真ん中を挟んで**2箇所**で鳴る。2026-08-16 と 08-20 の
        //     2回、ユーザーがテスタの導通レンジで実測して確認している。
        //   上半分は円筒の座、下半分は差し込みの通路。持ち手の裏から立てて押し込む
        rotate([0, 0, MAG2_ANG - 90]) {
            translate([0, MAG2_R, Z_GRIP_B + MAG2_SEAT_Z]) rotate([0, 90, 0])
                // ⚠ $fn=48 だと多角形の対辺が 6.287 になり、逃げ 0.3 を 0.013 食う
                cylinder(d = MAG2_D, h = MAG2_SLOT_W, center = true, $fn = 96);
            translate([-MAG2_SLOT_W / 2, MAG2_R - MAG2_D / 2, Z_GRIP_B - 0.01])
                cube([MAG2_SLOT_W, MAG2_D, MAG2_SEAT_Z + 0.01]);
            hull() {   // 口の面取り。⚠ Y（進行方向）だけ広げる。厚み方向（X）は噛み代
                translate([-MAG2_SLOT_W / 2, MAG2_R - MAG2_D / 2 - 0.3, Z_GRIP_B - 0.01])
                    cube([MAG2_SLOT_W, MAG2_D + 0.6, 0.01]);
                translate([-MAG2_SLOT_W / 2, MAG2_R - MAG2_D / 2, Z_GRIP_B + 0.4])
                    cube([MAG2_SLOT_W, MAG2_D, 0.01]);
            }
        }
        // 向きの印。🔒 +Y のまま動かさない
        translate([-1, GRIP_D / 4, Z_GRIP_B + GRIP_H - 0.8]) cube([2, GRIP_D / 4, 1]);
        ch_top(GRIP_D / 2 + RIB_D / 2, Z_GRIP_B + GRIP_H, GRIP_CH);
        ch_bot(GRIP_D / 2 + RIB_D / 2, Z_GRIP_B, CH_S);
        ch_bot(SHAFT_D / 2, Z_MAG_BOT, CH_S);
    }
}


// ============================================================
// 刷るときの柱（part="knob" のときだけ生える。刷ったら折って捨てる）
// 🔒 ユーザー指示（2026-08-21）: CHITUBOX のサポートは使わない。天板の支柱と同じく作図する。
//    実機で軸が E リングの溝の位置で横へずれた（写真）。軸は持ち手からぶら下がる
//    片持ちで、溝が一番細い（φ6・28mm²）。そこを毎層の剥離力が曲げる。
//
// ---- 掴んでよい面・いけない面（2026-08-21 に数えた）----
//   ✅ 軸の溝より下（z -10.25 〜 -15.9）… 島の穴も天板の穴も通らない。空中に浮くだけ
//   ✅ 持ち手の外周 φ27 … へこみの壁 14.1 まで半径 0.6mm ある（痕 0.3 の実績の倍）
//   🔴 持ち手の**平らな裏**（r 3.5〜13.2）… 島の上面に全面で乗る受け面。タブ（r10〜13）も
//      回ればどの角度にも来る。**ここに柱を立てない・横切らせない**（ユーザー指摘）
//   🔴 E リングの溝 ／ ツメ（r 11.5〜12.7・257〜270度）／ 軸の溝より上（軸受け）
//
// ---- 形 ----
//   ① 縦の脚 φ0.8 … 中心 r 13.7。持ち手の外周（13.5）へ 0.2 食い込み、内側の縁は 13.3。
//      平らな裏の 13.2 に触れない。これが「まっすぐ斜めに引けない」理由
//   ② 斜めの腕 φ1.4 … 裏面より下（z -4.0）から軸へ。水平から約39度
//   ③ 軸への取り付きは φ0.8 に絞る（折るところ）
// ============================================================
KPROP_ANG   = [0, 120, 240];   // ツメ 257〜270 と 磁石スリット（r6.0〜12.9・約70〜85度）を外す
// 🔴 2026-08-21・1回目の案を破棄。脚を持ち手の外周へ 0.2mm 食い込ませ、縦に 4.5mm
//    溶かし付けていた（ユーザー指摘「取り外せないだろう」）。天板の支柱が折れるのは
//    先が 0.8 の**点**で当たっているからで、面で溶接したら折れない。
//    2回目: 柱は**プレートに直に立てる**。つまみに触るのは軸の1点だけ
KPROP_R      = 15.3;           // 柱の中心半径。φ2.0 なら内縁 14.3 で持ち手 13.5 に触れない
KPROP_D      = 2.0;            // 柱の胴（宙に立つだけなので太くてよい）
KPROP_FOOT_D = 3.4;            // プレートに付く足。外縁 17.0 / 内縁 13.6（持ち手に触れない）
KPROP_FOOT_H = 1.5;
KPROP_PLATE_Z = Z_GRIP_B + GRIP_H;   // 5.5 プレートの面（刷る向きでの上）
KPROP_ARM_D  = 1.4;
KPROP_TIP_D  = 0.8;            // 軸に当たる点。ここだけが跡になる
KPROP_KNEE_Z = -4.0;           // 折れ点。持ち手の裏 -2.5・ツメの先 -3.8 より下
// 🔒 柱が付くのは**段のまま（cone=false）の軸**だけ。円錐と柱を同時に足すと、
//    どちらが効いたのか分からない（ユーザー指摘・2026-08-21）
KPROP_TIP_R  = SHAFT_D / 2 - 0.2;     // 3.3（垂直の軸 φ7 へ 0.2 食い込む）
// ⚠ 溝を刷った**すぐ後ろ**で捕まえないと意味が無い。1回目は -12.5 に置いていて、
//    溝を過ぎてから 2.25mm 分、先が首だけでぶら下がる時間ができていた
KPROP_TIP_Z  = -11.2;          // 溝の下端 -10.25 のすぐ下（逃げ 0.35）

module kprop_one(a) {
    rotate([0, 0, a]) {
        translate([KPROP_R, 0, KPROP_PLATE_Z - KPROP_FOOT_H])
            cylinder(d1 = KPROP_D, d2 = KPROP_FOOT_D, h = KPROP_FOOT_H);
        translate([KPROP_R, 0, KPROP_KNEE_Z])
            cylinder(d = KPROP_D, h = KPROP_PLATE_Z - KPROP_FOOT_H - KPROP_KNEE_Z + 0.01);
        hull() {
            translate([KPROP_R, 0, KPROP_KNEE_Z]) sphere(d = KPROP_ARM_D, $fn = 24);
            translate([KPROP_TIP_R + 1.6, 0, KPROP_TIP_Z - 1.0]) sphere(d = KPROP_ARM_D, $fn = 24);
        }
        hull() {
            translate([KPROP_TIP_R + 1.6, 0, KPROP_TIP_Z - 1.0]) sphere(d = KPROP_ARM_D, $fn = 24);
            translate([KPROP_TIP_R, 0, KPROP_TIP_Z]) sphere(d = KPROP_TIP_D, $fn = 24);
        }
    }
}
module kprops() { for (a = KPROP_ANG) kprop_one(a); }

// 触ってはいけない面のかたまり。kprops() との交わりが空なら合格。
// 🔒 2回目からは**持ち手そのものを丸ごと**入れる（外周も裏も、触れたら失格）
module kprop_keepout() {
    translate([0, 0, Z_GRIP_B]) cylinder(d = GRIP_D, h = GRIP_H);         // 持ち手 まるごと
    translate([0, 0, Z_GRV_B - 0.2])
        cylinder(d = SHAFT_D + 0.6, h = (Z_GRV_T - Z_GRV_B) + 0.4);     // E リングの溝
    rotate([0, 0, STOP_ANG - LUG_ARC])
        arc_block(LUG_R0 - 0.2, LUG_R1 + 0.2, LUG_ARC, Z_LUG_B - 0.2, Z_GRIP_B + 0.01);
    translate([0, 0, Z_GRIP_B]) difference() {                           // 持ち手の平らな裏
        cylinder(r = 13.2, h = 0.02);
        translate([0, 0, -0.01]) cylinder(d = SHAFT_D - 0.01, h = 0.04);
    }
    translate([0, 0, Z_GRV_T]) difference() {                            // 軸受けを通る区間
        cylinder(d = SHAFT_D + 0.6, h = Z_GRIP_B - Z_GRV_T);
        translate([0, 0, -0.01]) cylinder(d = SHAFT_D - 0.01,
            h = Z_GRIP_B - Z_GRV_T + 0.02);
    }
}
module kprop_check() { intersection() { kprops(); kprop_keepout(); } }


// ============================================================
// リードの座のゲージ（part="reedgauge"）── 2026-08-21
//   天板と**同じ向き・同じ深さ・同じ絞り**で座だけ4種。刷ったらリードを裏から押す。
//   ⬜ **まだ刷らない。** 既存の実績（KNOB-ENCODER.md:117）で足りるか先に見ること。
//   🔒 角を落としてある側が1列目。そこから順に REEDG_W の並び
// ============================================================
REEDG_W   = [3.25, 3.35, 3.45, 3.55];   // 1列目 3.25 は現行＝対照（入らないはず）
REEDG_PIT = 6.5;
REEDG_X   = 24.0;

module reed_pocket_at(w) {
    hull() {
        translate([-REED_L / 2 - REED_LOOSE, -w / 2 - REED_LOOSE, Z_PAD_BOT - 1])
            cube([REED_L + 2 * REED_LOOSE, w + 2 * REED_LOOSE, 1 + 0.01]);
        translate([-REED_L / 2, -w / 2, REED_TOP - REED_TIGHT_H])
            cube([REED_L, w, 0.01]);
    }
    translate([-REED_L / 2, -w / 2, REED_TOP - REED_TIGHT_H - 0.01])
        cube([REED_L, w, REED_TIGHT_H + 0.01]);
    for (sx = [-1, 1])
        translate([sx * (REED_L / 2 + LEAD_CH_W / 2) - LEAD_CH_W / 2,
                   -LEAD_CH_W / 2, Z_PAD_BOT - 0.01])
            cube([LEAD_CH_W, LEAD_CH_W, -(Z_PAD_BOT) + REED_TOP + 0.01]);
}
module reed_gauge() {
    n = len(REEDG_W);
    yl = n * REEDG_PIT;
    difference() {
        translate([-REEDG_X / 2, -yl / 2, Z_PAD_BOT]) cube([REEDG_X, yl, -Z_PAD_BOT]);
        for (i = [0 : n - 1])
            translate([0, -yl / 2 + REEDG_PIT * (i + 0.5), 0]) reed_pocket_at(REEDG_W[i]);
        // 1列目を示す角落とし
        translate([-REEDG_X / 2, -yl / 2, Z_PAD_BOT - 1]) rotate([0, 0, 45])
            translate([-3, -3, 0]) cube([6, 6, -Z_PAD_BOT + 2]);
    }
}

// ============================================================
// リード用磁石の通り道の検査（v4 から。空なら通れる）
// ============================================================
module mag2_solid(zc) {
    rotate([0, 0, MAG2_ANG - 90]) translate([0, MAG2_R, zc]) rotate([0, 90, 0])
        cylinder(d = MAG2_PART_D, h = MAG2_SLOT_W - 0.04, center = true, $fn = 96);
}
module magnet_path_check() {
    intersection() {
        knob_part();
        hull() {
            mag2_solid(Z_GRIP_B - MAG2_PART_D / 2 - 1);
            mag2_solid(Z_MAG2_BOT + MAG2_PART_D / 2 - 0.05);
        }
    }
}

// ============================================================
// 島（ただの厚い座金・part="wall"）
//   仕事は4つ: へこみの底の面・軸受け・つまみの重さ受け・限界止め（タブ）。
//   外周はどこにも触れない（圧入ゼロ）。位置と回り止めは左右のねじ2本が持つ。
//   🔒 刷る向き: 上面（へこみの底）をプレートに直置き。ザグリは上を向いて開く
// ============================================================
module wall_part() {
    difference() {
        union() {
            translate([0, 0, Z_WALL_B]) cylinder(d = ISL_OD, h = WALL_T);
            // タブ（限界止め）。島と一体・全厚。ツメはこの側面に当たる
            rotate([0, 0, STOP_ANG])
                arc_block(ISL_OD / 2 - 1, TAB_R1, TAB_ARC, Z_WALL_B, Z_WALL_T);
        }
        // 軸受けの穴（🔒 半月の実績値ペアを引き継ぐ）
        translate([0, 0, Z_WALL_B - 1]) cylinder(d = ISL_BORE, h = WALL_T + 2);
        // 入口逃がし（上面＝プレート側の過硬化）。軸の挿し込みの案内も兼ねる
        translate([0, 0, Z_WALL_T - BORE_RELIEF])
            cylinder(d1 = ISL_BORE, d2 = ISL_BORE + 1.2, h = BORE_RELIEF + 0.01);
        ch_top(ISL_OD / 2, Z_WALL_T, CH_S);
        // 留めねじ2本（左右）。上からザグリ、下まで通し穴。どちらも逃げで、
        // 島を押さえるのは頭。⚠ ザグリの外の肉は 0.4mm しかない（echo ③）
        for (a = SCREW_ANG) rotate([0, 0, a]) translate([SCREW_R, 0, 0]) {
            translate([0, 0, Z_WALL_T - SCR_CB_T])
                cylinder(d = SCR_CB_D, h = SCR_CB_T + 0.01);
            translate([0, 0, Z_WALL_B - 0.01]) cylinder(d = SCR_D, h = WALL_T + 0.02);
            ch_hole_top(SCR_CB_D / 2, Z_WALL_T, 0.2);
        }
    }
}

// ============================================================
// 天板側 ── 筐体の天板に union / difference で組み込む
// ============================================================
module knob_station_add() {
    translate([-PAD_X / 2, -PAD_Y / 2, Z_PAD_BOT]) cube([PAD_X, PAD_Y, PAD_T]);
    // 中央の段。ナットの六角ポケットはこの中だけに掘る（外周は薄いまま）
    translate([0, 0, Z_BOSS_BOT]) cylinder(d = BOSS_D, h = BOSS_T + 0.01);
    for (x = [-1, 1], y = [-1, 1]) difference() {
        post_solid(x, y);
        translate([x * POST_XY_LO, y * POST_XY_LO, 0]) {
            translate([0, 0, Z_PCB_TOP - 1]) hull() for (s = [-1, 1])
                translate([s * SLOT_LEN / 2, 0, 0])
                    cylinder(d = M2_D, h = M2_SHELF + 1.01);
            translate([0, 0, Z_PCB_TOP + M2_SHELF]) {
                hull() for (s = [-1, 1]) translate([s * SLOT_LEN / 2, 0, 0])
                    cylinder(d = M2_NUT_AF / cos(30), h = M2_NUT_T + 0.2, $fn = 6);
                scale([x, 1, 1]) translate([0, -M2_NUT_AF / 2, 0])
                    cube([9, M2_NUT_AF, M2_NUT_T + 0.2]);
                hull() for (s = [-1, 1]) translate([s * SLOT_LEN / 2, 0, 0])
                    cylinder(d = M2_D, h = M2_NUT_T + 2);
            }
        }
    }
}

module post_oval(h, d) {
    hull() for (s = [-1, 1]) translate([s * SLOT_LEN / 2, 0, 0])
        cylinder(d = d, h = h);
}

// 柱: 下からナットの座（小判 φ8 × 3.5）→ 45度で絞る → 細い丸柱 φ3.6 で増し肉へ。
// 🔒 細くするのは Eリングの通り道のため（echo ⑤）。基板は 3g なので強度は足りる
module post_solid(x, y) {
    translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_TOP]) {
        post_oval(POST_STRAIGHT, STANDOFF_D_LO);
        hull() {
            translate([0, 0, POST_STRAIGHT - 0.01]) post_oval(0.01, STANDOFF_D_LO);
            translate([0, 0, POST_STRAIGHT + (STANDOFF_D_LO - POST_THIN) / 2])
                cylinder(d = POST_THIN, h = 0.01);
        }
        translate([0, 0, POST_STRAIGHT + (STANDOFF_D_LO - POST_THIN) / 2])
            cylinder(d = POST_THIN, h = Z_PAD_BOT - Z_PCB_TOP - POST_STRAIGHT
                                        - (STANDOFF_D_LO - POST_THIN) / 2 + 0.01);
    }
}

module knob_station_cut() {
    // 通し穴（軸 φ7 が通るだけ）
    translate([0, 0, Z_BOSS_BOT - 1]) cylinder(d = HOLE_D, h = -Z_BOSS_BOT + 2);
    // 見える面のへこみ。島の下面まで一気に落とす
    translate([0, 0, Z_WALL_B]) cylinder(d = DISH_D, h = -Z_WALL_B + 1);
    ch_hole_top(DISH_D / 2, 0, CH_S);
    // 床の掘り下げ。①でダボ台座（掘り残し3点）を削除したので、ここは全面フラット
    translate([0, 0, Z_RELIEF]) cylinder(d = DISH_D + 0.02, h = RELIEF_D + 0.01);
    // リードの穴（横・水平・磁石の高さ）。へこみの壁のすぐ外。
    // 裏 -9.0 から呼び込み（3.95角）で上がり、z -4.0 から圧入の座（3.25角）、
    // 天井 -0.5 で突き当たる。⚠ へこみの壁との肉は x=0 で 0.4（端ほど厚くなる）
    hull() {
        // 🔴 2026-08-21: 呼び込みの広げは **+Y と ±X だけ**。以前は -Y（へこみ側）にも
        //    0.35 広がっていて、へこみの床の高さで肉が 0.21mm まで落ちていた。
        //    実機でそこが消えて、へこみとリードの穴が1つの大穴になった
        translate([-REED_L / 2 - REED_LOOSE, REED_IN, Z_PAD_BOT - 1])
            cube([REED_L + 2 * REED_LOOSE, REED_W + REED_LOOSE, 1 + 0.01]);
        translate([-REED_L / 2, REED_IN, REED_TOP - REED_TIGHT_H])
            cube([REED_L, REED_W, 0.01]);
    }
    translate([-REED_L / 2, REED_IN, REED_TOP - REED_TIGHT_H - 0.01])
        cube([REED_L, REED_W, REED_TIGHT_H + 0.01]);
    // 足の通り道（両端・縦）。下へ曲げた足がここを通って裏へ出る
    for (sx = [-1, 1]) translate([sx * (REED_L / 2 + LEAD_CH_W / 2),
            REED_IN + REED_W / 2 - LEAD_CH_W / 2, Z_PAD_BOT - 0.01])
        translate([-LEAD_CH_W / 2, 0, 0])
            cube([LEAD_CH_W, LEAD_CH_W, -(Z_PAD_BOT) + REED_TOP + 0.01]);
    // 留めねじ2本。天板は**通し穴**で、裏から六角ポケットへナットを落として締める。
    // 🔒 E リングは裏面（Z_PAD_BOT）より下の z -9.3〜-10.25 を横に滑って入る。だから
    //    **ナットが裏面より下へ出ないこと**が、リングに当たらない条件そのもの。
    //    ポケットは裏面から上へ NUT_POCK_T 掘るだけで、下へは 1mm も出さない（echo ③）
    for (a = SCREW_ANG) rotate([0, 0, a]) {
        translate([SCREW_R, 0, Z_BOSS_BOT - 1])
            cylinder(d = SCR_THRU, h = -Z_BOSS_BOT + 2);
        // 六角は**平面を内側へ向ける**（角を向けると軸の通し穴までの肉が 0.84 まで落ちる）
        translate([SCREW_R, 0, Z_BOSS_BOT - 0.01]) rotate([0, 0, 30])
            cylinder(d = NUT_POCK_AF / cos(30), h = NUT_POCK_T + 0.01, $fn = 6);
    }
}

// ============================================================
// へこみの天井を支える柱（モデルに組み込む・v4 から）
// 🔴 スライサーのサポートが効かなかったので、モデルに入れてある（ユーザー実測）。消さない
// 🔒 v5 では床の全面が「島の下 0.3mm」なので、痕が 0.3 未満ならどこでも無害。
//    立てないのはダボの座3つと、限界止めのねじの下穴の周りだけ
// ============================================================
DECK_PROP_D   = 1.4;
DECK_PROP_TIP = 0.8;
DECK_RAFT_T = 0.3;
// 🔴 2026-08-21、13.0 → 11.0（ユーザー指示）。**ラフトが天面と離れていなかった。**
//    ラフトはへこみの口＝**天面と同じ平面**に居る。壁まで 1.1mm ではニッパーが入らず、
//    刃が天面に乗って切ることになり、見える面がガタガタになる（ユーザー・実機）。
//    11.0 にすると隙間 3.1mm。⚠ 縮めた分の支柱は落とす（下の prop_zone）。
//    へこみの天井の外周は**壁そのものが支えている**ので、外側の支柱は元々効きが薄い。
//    残る無支持のさしわたしは echo ⑦b が出す（4mm を超えたら天井がカールする実績値）
DECK_RAFT_R = 11.0;
DECK_PROP_P   = 3.0;       // ⚠ 隣まで 4mm を超えない（天井がカールする実績値）
DECK_RING_N   = 14;
DECK_RING_R   = HOLE_D / 2 + DECK_PROP_D / 2 + 0.25;
function ring_pt(k) = [DECK_RING_R * cos(k * 360 / DECK_RING_N + 7),
                       DECK_RING_R * sin(k * 360 / DECK_RING_N + 7)];
function far_from_ring(x, y) =
    min([for (k = [0 : DECK_RING_N - 1]) norm([x, y] - ring_pt(k))])
        > DECK_PROP_D + 0.4;
// ①で座が消えたので、支柱が避けるのは**ねじの下穴2本の周りだけ**になった
function prop_ok(x, y) =
    min([for (a = SCREW_ANG)
         norm([x - SCREW_R * cos(a), y - SCREW_R * sin(a)])])
        > SCR_THRU / 2 + DECK_PROP_D / 2 + 0.6;
// リードの穴はへこみの外（y > 14.5）なので、支柱には関係しない
function prop_zone(x, y) =
    let (r = sqrt(x * x + y * y))
    r >= DECK_RING_R
    && r < DISH_D / 2 - DECK_PROP_D / 2 - 0.3
    // 2026-08-21 追加。支柱の**円が丸ごと**ラフトに載る条件。
    // ⚠ これは体裁の規則であって、不具合の修正ではない。
    //    🔴 AI は当初「12 本がラフトの外に立っていて宙で刷られていた（屑の出どころ）」と
    //    報告したが、**それは嘘だった**。`prop_zone` を Python で書き直した出力を
    //    モデルの事実として喋ったもので、書き直しが合っていなかった（本数からして
    //    61 対 48 で違った）。元の STL を直接数えた結果は「はみ出し 5 本・すべて中心は
    //    ラフトの上・最大 0.70mm の庇」で、**浮いている支柱は 1 本も無かった**（ユーザー指摘）
    && (!raft || r <= DECK_RAFT_R - DECK_PROP_D / 2 - 0.2)
    && prop_ok(x, y);

module one_prop(x, y) {
    translate([x, y, Z_RELIEF]) {
        cylinder(d1 = DECK_PROP_TIP, d2 = DECK_PROP_D, h = 0.4);
        translate([0, 0, 0.4]) cylinder(d = DECK_PROP_D,
            h = -Z_RELIEF - (raft ? DECK_RAFT_T : 0) - 0.4 + 0.01);
    }
}

// 🔴 2026-08-21 追加。ラフトを 13.0 → 11.0 に縮めたら、格子の目が縁まで届かず
//    一番外の支柱が r9.0 で止まり、壁までの無支持が 4.4mm（実績の上限 4.0）を超えた。
//    格子を細かくすると全面の痕が増えるので、**外周に輪を1本だけ足す**（内側の輪と同じ作り）
DECK_ORING_R = DECK_RAFT_R - DECK_PROP_D / 2 - 0.2;      // 10.1 ラフトに載る一番外
DECK_ORING_N = round(2 * PI * DECK_ORING_R / DECK_PROP_P);   // 隣まで約 3mm
function oring_pt(k) = [DECK_ORING_R * cos(k * 360 / DECK_ORING_N + 3),
                        DECK_ORING_R * sin(k * 360 / DECK_ORING_N + 3)];
function grid_pts() = [
    let (n = ceil((DISH_D / 2) / DECK_PROP_P) + 1)
    for (j = [-n : n], i = [-n : n])
    let (x = i * DECK_PROP_P + (j % 2 == 0 ? 0 : DECK_PROP_P / 2),
         y = j * DECK_PROP_P * 0.866)
    if (prop_zone(x, y) && far_from_ring(x, y)) [x, y]];
// 格子の点と重ならないものだけ残す（重なっても害は無いが、痕を無駄に太らせない）
function oring_pts() = [
    for (k = [0 : DECK_ORING_N - 1])
    let (p = oring_pt(k))
    if (prop_zone(p[0], p[1])
        && min([for (g = grid_pts()) norm(p - g)]) > DECK_PROP_D + 0.4) p];

module deck_props() {
    if (raft) translate([0, 0, -DECK_RAFT_T]) cylinder(r = DECK_RAFT_R, h = DECK_RAFT_T);
    for (k = [0 : DECK_RING_N - 1]) {
        pt = ring_pt(k);
        if (prop_zone(pt[0], pt[1])) one_prop(pt[0], pt[1]);
    }
    for (p = grid_pts())  one_prop(p[0], p[1]);
    for (p = oring_pts()) one_prop(p[0], p[1]);
}

module deck_test(props = true) {
    difference() {
        union() {
            translate([-PAD_X / 2, -PAD_Y / 2, Z_DECK_BOT])
                cube([PAD_X, PAD_Y, DECK_T]);
            knob_station_add();
        }
        knob_station_cut();
    }
    if (props) deck_props();
}

// ============================================================
// 組み立てビュー
// ============================================================
// ============================================================
// E リング（実形状。2026-08-20 に代役から差し替え）
// ============================================================
// 🔴 それまでは ering_proxy() という「外径だけ合わせたスリット入りの円板」だった。
//    ③⑤ の検査は外径しか使っていないので数字は正しかったが、**絵で爪が見えず、
//    磁石にはある「実体で通り道を見る検査」がリングには無かった**（ユーザー指摘）。
//    リングも組む順④で横から差し込む部品なので、磁石と同じ検査を持つべきだった。
//
// 寸法の出どころ:
//   ✅ ERING_OD 12.0 … 実物（呼び6）
//   📄 ERING_BORE 6.05 … JIS の溝径 d2
//   ✅ ERING_T 0.8 … 実物・規格とも一致
//   ⬜ 下の3つは**絵の形を作るために AI が置いた値**。現物とは照合していない。
//      ⚠ ③⑤ と ⑧ の判定はこの3つに依存しない（効くのは外径だけ）。
//      絵の見た目と、口の向きの当たりだけがこれで決まる
ERING_BORE   = 6.05;       // 📄 爪の先が作る内側の円（規格 d2）
ERING_RELIEF = 8.6;        // ⬜ 爪と爪のあいだの逃げ径
ERING_PRONG  = 38;         // ⬜ 爪1つの角度幅
ERING_GAP_W  = 4.0;        // ⬜ 口の幅（平行な2面のあいだ）。⚠ 現物と未照合の置き値
ERING_PRONG_ANG = [90, 210, 330];   // 爪の位置。口(270度)は 210 と 330 のあいだ

module ering_wedge(a0, a1, r) {
    polygon(concat([[0, 0]],
                   [for (a = [a0 : 3 : a1]) [r * cos(a), r * sin(a)]],
                   [[r * cos(a1), r * sin(a1)]]));
}
module ering_profile() {
    difference() {
        circle(d = ERING_OD);
        // 内側の逃げ。3つの爪だけ ERING_BORE まで残す
        difference() {
            circle(d = ERING_RELIEF);
            for (a = ERING_PRONG_ANG) intersection() {
                ering_wedge(a - ERING_PRONG / 2, a + ERING_PRONG / 2, ERING_RELIEF);
                difference() { circle(d = ERING_RELIEF); circle(d = ERING_BORE); }
            }
        }
        // 口。🔒 実物は**平行な2面**で切られている（放射状の楔ではない）
        translate([-ERING_GAP_W / 2, -ERING_OD, 0]) square([ERING_GAP_W, ERING_OD]);
    }
}
// 溝に嵌まった位置。⚠ 口の向きは組む順④の差し込み方向（+Y から入れる）に合わせる
module ering_part(ang = 0) {
    rotate([0, 0, ang]) translate([0, 0, Z_GRV_T - ERING_T])
        linear_extrude(ERING_T) ering_profile();
}
// ⚠ 当たり検査への注記（2026-08-21 に書き直し）: 以前ここには「ねじの胴 φ2.5 が天板の
//    下穴 φ2.1 へ食い込むのは意図した重なり」と書いてあった。**その下穴は廃止した。**
//    天板は通し穴 φ3.0 になったので、ねじと天板はもう重ならない。噛むのはナットだけで、
//    ねじとナットの重なり（ねじ山の分）は当たり検査に出るのが正しい
module stop_screws() {   // 島を留めるねじ2本（頭はザグリの中）
    for (a = SCREW_ANG) rotate([0, 0, a])
        translate([SCREW_R, 0, Z_WALL_T - SCR_CB_T]) {
            cylinder(d = M25_HEAD_D, h = M25_HEAD_T);
            translate([0, 0, -M25_LEN]) cylinder(d = 2.5, h = M25_LEN);
        }
}
// 裏の六角ポケットに落ちたナット2個（実物どおりの位置。当たり検査に出す）
module stop_nuts() {
    for (a = SCREW_ANG) rotate([0, 0, a])
        translate([SCREW_R, 0, Z_BOSS_BOT]) rotate([0, 0, 30])
            cylinder(d = M25_NUT_AF / cos(30), h = M25_NUT_T, $fn = 6);
}

module assembly(show_deck = true) {
    color("#d8dde3") knob_part();
    color("#e03131") wall_part();
    if (show_deck) color("#9aa5b1", 0.75) deck_test(props = false);
    color("#e8e8e8") stop_screws();
    color("#b8b8b8") stop_nuts();
    color("#c0c0c0") ering_part();
    translate([0, 0, Z_PCB_BOT]) as5600(show_connector = false);
    color("#e8e8e8") for (x = [-1, 1], y = [-1, 1])
        translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_BOT]) {
            translate([0, 0, -1.3]) cylinder(d = 3.8, h = 1.3);
            cylinder(d = 2.0, h = PCB_T + M2_SHELF + M2_NUT_T);
        }
    color("#888") for (x = [-1, 1], y = [-1, 1])
        translate([x * POST_XY_LO, y * POST_XY_LO, Z_PCB_TOP + M2_SHELF])
            cylinder(d = M2_NUT_AF / cos(30), h = M2_NUT_T, $fn = 6);
    color("#bbb") translate([0, 0, Z_MAG_BOT]) cylinder(d = 4.0, h = 2.0);
    // ⚠ 絵も B向き（軸は +X＝接線）。ポケットと同じ角度へ回す。
    //    ここが実物と違うと、当たり検査は効いていても目で見て気付けない
    color("#c0392b") rotate([0, 0, MAG2_ANG - 90])
        translate([-magnet_reed_t() / 2, MAG2_R, Z_MAG2_BOT + MAG2_PART_D / 2])
            rotate([0, 90, 0]) magnet_reed();
}

module exploded() {
    translate([0, 0, 30]) color("#d8dde3") knob_part();
    translate([0, 0, 14]) color("#e03131") wall_part();
    translate([0, 0, -14]) color("#c0c0c0") ering_part();
    translate([0, 0, -20]) color("#e8e8e8") stop_screws();
    color("#9aa5b1", 0.8) deck_test();
    translate([0, 0, -30]) {
        color("#2b6b3f") translate([-PCB / 2, -PCB / 2, Z_PCB_BOT]) cube([PCB, PCB, PCB_T]);
        color("#333") translate([-2.5, -2, Z_PCB_TOP]) cube([5, 4, CHIP_H]);
    }
    translate([0, 0, 24]) color("#bbb") translate([0, 0, Z_MAG_BOT]) cylinder(d = 4.0, h = 2.0);
}

// ============================================================
// 押し棒（part="rod"）── リードの押し込み量のゲージ
//   板。上の面でリードの底を押す。肩が増し肉の裏に当たるまで押したら、
//   リードの底はちょうど z -3.75（＝圧入の座に全高が入った位置）。
//   ⚠ 座が 3.25 で掴む。曲げた足は板の脇へ逃げる
// ============================================================
// 🔴 2026-08-21・ユーザー指摘「この工具いらなくない？」＝そのとおり。**刷らない。**
//    押し込む深さは穴の天井（REED_TOP -0.5）がすでに決めている。肩が裏 -9.0 に当たった
//    ときのリードの底 -3.75 は、天井に突き当たった位置と同じ。ゲージとして足すものが無い。
//    奥へ届かせる棒が要るだけなら平らな物で足りる。
//    形は残すが、プレートには載せないこと
ROD_NOSE  = (REED_TOP - REED_W) - Z_PAD_BOT;   // 5.25 肩から先の長さ
ROD_SHLD  = 2.0;                               // 肩（当たり面）
// 🔴 柄は 18.0 だった。**根拠ゼロ。私が置いただけ**（ユーザー指摘 2026-08-21）。
//    しかも全高 25.25 がプレートで一番高く、印刷の層数を決めていた。
//    つまみ（21.40）より低くなるように詰める → 全高 21.0
ROD_GRIP  = 13.75;
ROD_BOT   = -(ROD_GRIP + ROD_SHLD);            // -15.75 部品の下端
module rod_part() {
    difference() {
        union() {
            translate([-6, -1.25, 0]) cube([12, 2.5, ROD_NOSE]);            // 先（穴に入る板）
            translate([-8, -4, -ROD_SHLD]) cube([16, 8, ROD_SHLD]);         // 肩
            translate([-8, -4, ROD_BOT]) cube([16, 8, ROD_GRIP + 0.01]);    // 柄
        }
        // 🔴 2026-08-21 修正: 以前は先の板（厚み 2.5）の真ん中まで貫いていて、
        //    片側 0.25mm しか残らず、実績の薄壁下限 0.3mm を割っていた。肩から下で止める
        translate([0, 0, ROD_BOT - 1]) cylinder(d = 2.0, h = -ROD_BOT + 1);
    }
}
// ⬜ 2026-08-21 に見つけた2点（**まだ直していない。ユーザーの指示待ち**）:
//   ・上の φ2 は z 4 まで伸びていて、先の板（厚み 2.5）の真ん中を貫いている。
//     残る肉は片側 0.25mm ＝ 押し出し 1 本ぶんに足りない。刷ると板の中央が割れて出る。
//     穴の名前は「下の足の逃げ」だが、足が出るのは x ±7.85（LEAD_CH_W の位置）で、
//     板は ±6 しかない。真ん中の穴は足の逃げになっていない
//   ・肩と柄は 16mm 幅（±8）なので、裏へ出た足（x ±7.85）を踏む

// ---- 印刷の向き ----
//   つまみ: 🔒 持ち手の天面をプレートに直置き（軸が上）。サポートはゼロ。
//     🔴 **つまみを1個だけでプレートに置かない。**（2026-08-21・実機で失敗）
//        持ち手が終わる高さ 8.0 から上は φ7 の軸だけで、1層 38mm²・13.4mm 続く。
//        溝（14.8〜15.75）では φ6 の 28mm² まで細り、15.75 で幅 0.5 の張り出しが
//        空中に出る。1個だけだと1層1秒を切って固まる前に次が乗り、**この段で軸が
//        中央からズレた**。押し棒（part="rod"・高さ 25.25）を同じプレートに並べるか、
//        スライサの最小レイヤー時間を 10〜15秒にする
//   島:     🔒 上面（へこみの底）をプレートに直置き。ダボが上を向いて生える。
//   天板:   🔒 見える面をプレートに直置き。傾けない・浮かせない。支柱は刷ったら折る
// ============================================================
// E リングの通り道の検査（2026-08-20 追加。磁石と同じ作り。空なら通れる）
// ============================================================
// 🔒 リングは天板の裏（段の裏 z -10.5 の下・溝は z -11.75〜-10.8）を**横に滑らせて**入れる。
//    その高さに居て邪魔になり得るのは2つだけ:
//      ・AS5600 の柱の細い区間 φ3.6（±8.5, ±8.5）
//      ・島を留めるねじの胴 φ2.5（±7.9, 0）が段の裏へ 1.5mm 出た先
// ⚠ **2026-08-21、実物での所見（ユーザー）。** 天板の穴をドリル φ3.0 で開け直してねじを
//    通したところ、E リングの出し入れが「非常に難しかった」。ねじの先は (±7.9, 0)＝リングが
//    滑って来る道の真横に立っていて、逃げは片側 0.65mm しかない。
// 🔒 **ただしユーザーの判定は「工作できないほどの難易度ではない・大丈夫」。**
//    「手で 0.3mm くらいの精度は出せる」とのことで、**0.65mm はこの人の手の範囲内**。
//    → **ねじは 6mm のまま。短くしない。** 検査 ③c もこの前提で ⚠ 止まり（不合格にしない）
// ⚠ 検査への教訓は残す: `eringpath` が空なのは「当たらない」であって「組める」ではない。
//    AI はそれを「通る」と報告した。**隙間の数字を必ず併記すること**（③c が出す）
// ⚠ **差し込む向きは ±Y しかない。** ±X から入れるとねじの胴を正面から轢く
//    （ねじは y=0 に居るので、リングの中心線がねじに重なる）。
//    part="eringpathx" がそれで、**あちらは空にならないのが正しい。**
ERING_IN_Y = 22;           // 差し込みの開始位置（完全に外）

module ering_obstacles() {
    for (x = [-1, 1], y = [-1, 1]) post_solid(x, y);
    for (a = SCREW_ANG) rotate([0, 0, a])
        translate([SCREW_R, 0, SCR_TIP_Z]) cylinder(d = 2.5, h = Z_BOSS_BOT - SCR_TIP_Z);
    // 🔴 2026-08-21 追加。ナットは胴より 2.5mm 太いので、**ねじが通ってもナットは当たる**。
    //    裏面と面一に沈めたのはそのため。この検査が「沈めた」を実体で証明する
    stop_nuts();
}
// ⚠ hull() は C の口を埋めるので、**実物より太った経路**になる。
//    つまり「空＝通る」は強い結論（保守側で通った）だが、
//    「非空＝当たる」は保守側の判定であって証明ではない。X の方はそう読むこと。
module ering_sweep(dir) {
    hull() {   // 口は進行方向の逆を向く（軸が口から入る）
        ering_part(dir > 0 ? 0 : 180);
        translate([0, dir * ERING_IN_Y, 0]) ering_part(dir > 0 ? 0 : 180);
    }
}
module ering_path_check(dir = 1) {
    intersection() { ering_obstacles(); ering_sweep(dir); }
}
module ering_path_check_x() {
    intersection() {
        ering_obstacles();
        hull() { ering_part(90); translate([ERING_IN_Y, 0, 0]) ering_part(90); }
    }
}

if      (part == "knob")    rotate([180, 0, 0])
                                translate([0, 0, -(Z_GRIP_B + GRIP_H)]) knob_part();
// 🔴 柱（kprops）は part から外した。2026-08-21、ユーザー案の円錐が原因そのものを
//    消したので不要。AI が描いた逃げの構造で、実機で試してもいない。
//    見たいときだけ part="kprop" ／ 当たり検査は part="kpropcheck"
else if (part == "reedgauge") rotate([180, 0, 0]) reed_gauge();
else if (part == "kprop")      kprops();
// 🔒 対照（2026-08-21・ユーザー指摘）。前回の失敗は、宙で刷った治具の屑を
//    踏んだせいかもしれない（**軸は溝だけでなく根本から曲がっている**）。
//    形をいじらない現物どおりの1枚が無いと、円錐も柱も効いたかどうか判定できない
else if (part == "knobcone") rotate([180, 0, 0])    // 対照: 円錐（E リングが傾いた版）
                                translate([0, 0, -(Z_GRIP_B + GRIP_H)])
                                knob_part(cone = true);
else if (part == "knobprop") rotate([180, 0, 0])   // 段のまま＋柱
                                translate([0, 0, -(Z_GRIP_B + GRIP_H)])
                                { knob_part(cone = false); kprops(); }
else if (part == "kpropcheck") kprop_check();
else if (part == "deck")    rotate([180, 0, 0]) deck_test();
else if (part == "wall")    translate([0, 0, Z_WALL_T]) rotate([180, 0, 0]) wall_part();
// 🔴 2026-08-21: ここが 22 だった。rod_part() の底は -20 なので STL が **プレートから
//    2.0mm 浮いた**（実測: knob_v5_rod.stl の Z が 2.00〜27.25）。宙で刷って崩れた。
else if (part == "rod")     translate([0, 0, -ROD_BOT]) rod_part();   // 🔒 下端をプレートへ（式で出す。数字を直書きしない）
else if (part == "magpath")    magnet_path_check();
else if (part == "ering")      ering_part();
else if (part == "eringpath")  ering_path_check(1);
else if (part == "eringpathx") ering_path_check_x();
else if (part == "explode") exploded();
else                        assembly();

// ============================================================
// 検査（echo）
// ============================================================
echo(str("柱の高さ ", Z_PAD_BOT - Z_PCB_TOP, "mm / 磁石とチップ ", CHIP_GAP, "mm"));
// ---- ① 軸方向（Eリング）----
LIFT = ERING_PLAY + (ERING_GRV_W - ERING_T);
echo(str("① 引き上げ ", LIFT, "mm（受けまで ", ERING_PLAY, " ＋ 溝の遊び ",
         ERING_GRV_W - ERING_T, "）/ ツメの掛かり ", STOP_T, " → 余裕 ",
         STOP_T - LIFT, "mm ⚠ 負なら限界止めを越えられる"));
CONE_ANG  = atan(((SHAFT_D - ERING_GRV_D) / 2) / (Z_GRV_B - Z_CONE_B));
CONE_DROP = ((ERING_BORE - ERING_GRV_D) / 2) / tan(CONE_ANG);
if (!KNOB_CONE) {
    echo(str("   🔒 溝の下は**段**（φ", ERING_GRV_D, " → φ", SHAFT_D, " が z ", Z_GRV_B,
             " で戻る）。リングの下面が平らな肩に座る ／ 張り出しは片側 ",
             (SHAFT_D - ERING_GRV_D) / 2, "mm"));
    echo(str("   ↑ 抜け止めは平らな肩。引き上げは ", LIFT,
             "mm のみ（円錐だと楔に食い込む分 ", CONE_DROP, "mm が足される）",
             " ／ ツメの掛かり ", STOP_T, " → 余裕 ", STOP_T - LIFT, "mm"));
    echo(str("   ✅ 2026-08-21 実機: サポート無しで綺麗に出力できた（ユーザー）。",
             "「段は幅 ", (SHAFT_D - ERING_GRV_D) / 2,
             "mm の平らな面が宙に出るから刷れない」という以前の想定は否定された"));
} else {
    echo(str("   ⚠ 対照の円錐版（part=\"knobcone\"）: φ", ERING_GRV_D, "（z ", Z_GRV_B,
             "）→ φ", SHAFT_D, "（z ", Z_CONE_B, "）＝ 垂直から ", CONE_ANG, "度"));
    echo(str("   🔴 **この版は E リングが傾く**（2026-08-21 実機・ユーザー）。",
             "溝の下面が斜面でリングが平らに座らない。引き上げも ", LIFT, " + ", CONE_DROP,
             " = ", LIFT + CONE_DROP, "mm へ増える ／ 余裕 ", STOP_T - LIFT - CONE_DROP, "mm"));
