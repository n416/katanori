// リード用磁石の穴の幅を決め直す試験板 ── 2026-08-31
//
//   openscad -o hardware/stl/test/mag_slot_gauge.stl hardware/mag_slot_gauge.scad
//
// 🔴 2026-08-31、このファイルには**同じ名前の先代があったが、私が読まずに上書きして
//    消してしまった**（git の未追跡ファイルで、復元できなかった）。中身は不明である。
//    もし先代で決まっていたことがあれば、ここには引き継がれていない。
//
// 何のために作るか
//   つまみ（knob_v5.scad）の、リード用磁石を入れる穴の幅を決め直すため。
//   いまの幅 2.02 は、実物で「押し込んでも一番奥まで入らず（1mm ほど手前で止まる）、
//   しかも二度と取り出せない」という状態になっている。過去の版でもずっと同じで、
//   磁石を取り出すにはつまみを壊すしかなかった（✅ 2026-08-31 ユーザー）。
//
// なぜ既存の fit_gauge.scad を使い直さないか
//   あちらの穴は板厚 4.0mm の貫通穴で、つまみの穴は深さ 6.05mm の行き止まりである。
//   掴む長さも、奥に空気と樹脂の逃げ場があるかどうかも違う。条件の違う物で出た
//   「2.02 が一番きつくて入る／2.07 はスカスカ」という判定を、つまみへ持ち込めない。
//   fit_gauge.scad:10 には「穴は全部貫通。袋穴にすると圧入した磁石が二度と出てこない」
//   と書いてあるのに、つまみの穴だけが行き止まりのまま残っている。
//
// この板が写しているもの（つまみの穴と同じにしてある）
//   ・入口から一番奥までの深さ 6.05mm
//   ・断面 … 手前は幅 W × 6.3 の角穴、奥は直径 6.3 の丸（磁石の円板がそこへ座る）
//   ・行き止まりであること
//   ・刷る向き … 入口が上を向く
//   ・入口の面取り … 磁石が進む向きだけ 0.3 広げる（幅の方向は広げない＝そこが締め代）
//   ・一番奥から板の裏までの肉 1.95mm
//
// つまみと違えてある点（1つだけ・理由あり）
//   一番奥に直径 1.0mm の穴を通してある。ここへピンを差して磁石を押し戻すためで、
//   これが無いと試した磁石が板から戻ってこない（＝いま現物で起きていること）。
//   磁石が触れる面は削っていないので、締まり具合そのものは変わらない。
//
// 幅の選び方
//   2.02 を1枚入れてあるのは対照のため。ここで現物と同じ「奥まで入らない・戻らない」が
//   再現しなければ、この板は現物を写せていないので、他の枚の結果も信用できない。
//   残りは 2.07 から 2.57 まで 0.05 刻み。答えの位置が分かっていないので広く取った。
//   （枚数を絞るより刷り直しのほうが手間が大きい、というユーザーの判断・2026-08-31）
//
// 見かた
//   「入るか」ではなく **「一番奥まで入って、なおかつ押し戻せるか」** で選ぶ。
//   細い方から順に押し込むと、
//     入らない → 途中で止まる → 奥まで入るが戻せない → 奥まで入って押せば戻る → ゆるい
//   と並ぶはずなので、**「奥まで入って押せば戻る」で一番細いもの**を採る。
//   ⚠「ゆるい」の判定は、板を逆さにして磁石が落ちるかどうかで見る。

$fn = 96;

// ---- 磁石（実物）----
MAG_D = 6.0;     // 直径 📄 リードスイッチ付属 φ6×2
MAG_T = 2.02;    // 厚み ✅ 2026-08-16 実測

// ---- 試す幅と、側面に彫る文字 ----
W_SET = [2.02, 2.07, 2.12, 2.17, 2.22, 2.27, 2.32, 2.37, 2.42, 2.47, 2.52, 2.57];
W_LBL = ["202","207","212","217","222","227","232","237","242","247","252","257"];
COLS  = 6;       // 1 列に並べる枚数

// ---- つまみの穴から写した寸法 ----
BORE_D  = 6.3;    // 穴の直径（磁石の直径 ＋ 0.3）
SEAT_Z  = 2.90;   // 入口から、丸い奥の中心までの距離
DEPTH   = SEAT_Z + BORE_D / 2;   // 6.05 入口から一番奥まで
ROOF    = 1.95;   // 一番奥から板の裏までの肉（つまみと同じ）
MOUTH_R = 0.3;    // 入口の面取り（磁石が進む向きだけ）
MOUTH_H = 0.4;

// ---- 板 ----
BLK_X   = 11.0;   // 幅の方向。穴の両脇に 4.4mm ほど残す（撓んで手応えが変わらないように）
BLK_Y   = 10.0;   // 磁石の直径の方向。穴の両脇に 1.85mm 残る
BLK_Z   = DEPTH + ROOF;    // 8.0 つまみの持ち手の厚みと同じ
PITCH_X = 14.0;
PITCH_Y = 14.0;

PUSH_D  = 1.0;    // 一番奥へ通す穴。ピンで磁石を押し戻す
LBL_H   = 3.0;    // 側面に彫る文字の高さ
LBL_DEEP= 0.4;

BAR_W   = 2.0;    // 連結棒。ニッパーで切り離す。⚠ 奥の縁へ寄せる（真ん中だと押し戻す穴を塞ぐ）
BAR_H   = 1.5;

// 1 枚ぶんの穴。入口は上（z = BLK_Z）を向く
module slot(w) {
    translate([-w / 2, -BORE_D / 2, BLK_Z - SEAT_Z])          // 手前の角穴
        cube([w, BORE_D, SEAT_Z + 0.01]);
    translate([0, 0, BLK_Z - SEAT_Z]) rotate([0, 90, 0])      // 奥の丸（円板が座る）
        cylinder(d = BORE_D, h = w, center = true);
    hull() {                                                   // 入口の面取り
        translate([-w / 2, -BORE_D / 2 - MOUTH_R, BLK_Z - 0.01])
            cube([w, BORE_D + 2 * MOUTH_R, 0.01]);
        translate([-w / 2, -BORE_D / 2, BLK_Z - MOUTH_H])
            cube([w, BORE_D, 0.01]);
    }
    translate([0, 0, -0.01]) cylinder(d = PUSH_D, h = ROOF + 1);   // 押し戻す穴
}

// 幅の数値を側面に彫る（例: 2.17 → "217"）。out = +1 なら奥の面、−1 なら手前の面。
// 🔒 どちらの列も**板の外を向いた面**に彫る。内向きだと列同士で隠れて読めない
module label(s, out) {
    translate([0, out * (BLK_Y / 2 - LBL_DEEP), 2.2]) rotate([90, 0, out > 0 ? 180 : 0])
        linear_extrude(LBL_DEEP + 0.01)
            text(s, size = LBL_H, halign = "center", valign = "baseline");
}

module block(i) {
    difference() {
        translate([-BLK_X / 2, -BLK_Y / 2, 0]) cube([BLK_X, BLK_Y, BLK_Z]);
        slot(W_SET[i]);
        label(W_LBL[i], floor(i / COLS) == 0 ? 1 : -1);   // 奥の列は +Y、手前の列は −Y へ
    }
}

module gauge() {
    for (i = [0 : len(W_SET) - 1])
        translate([(i % COLS) * PITCH_X, -floor(i / COLS) * PITCH_Y, 0]) block(i);
    // 連結棒（列ごとに1本・奥の縁へ寄せる）
    for (r = [0 : ceil(len(W_SET) / COLS) - 1])
        translate([-BLK_X / 2, -r * PITCH_Y + BLK_Y / 2 - BAR_W, 0])
            cube([(COLS - 1) * PITCH_X + BLK_X, BAR_W, BAR_H]);
}

gauge();

ROWS = ceil(len(W_SET) / COLS);
echo(str("試験板: ", len(W_SET), " 枚 ／ 幅 ", W_SET[0], " 〜 ", W_SET[len(W_SET) - 1],
         " を 0.05 刻み（磁石の厚み ", MAG_T, "）"));
echo(str("  締め代（幅 − 磁石の厚み）: ", [for (w = W_SET) w - MAG_T]));
echo(str("  穴: 入口から一番奥まで ", DEPTH, "mm ／ 断面は 幅 × ", BORE_D,
         " の角穴 ＋ 直径 ", BORE_D, " の丸（つまみと同じ）"));
echo(str("  1 枚: ", BLK_X, " × ", BLK_Y, " × ", BLK_Z,
         " ／ 盤面 ", (COLS - 1) * PITCH_X + BLK_X, " × ", (ROWS - 1) * PITCH_Y + BLK_Y, "mm"));
echo(str("  一番奥から裏までの肉 ", ROOF, "mm ／ 押し戻す穴 φ", PUSH_D,
         " ／ 対照の 1 枚 = ", W_SET[0]));
