node_modules
dist

# ビルド成果物 (simulator/build.bat で再生成できるためコミットしない)
*.o
*.obj
*.exe
bin/

# PlatformIO (実機ファームのビルド成果物・DLしたツールチェーン)
.pio/

# Python
__pycache__/
*.pyc

# シリアルモニタの取りっぱなしログ（読んだ中身は POWER.md / TODO.md へ書き写す）
firmware/serial.log

# 使い捨ての検査・試作STL（317ファイル・17MB）
hardware/scratch/
_access_tmp/

# 刷る前の検算で出した使い捨てSTL
hardware/_pf/

# 刷るぞー の測定キャッシュ（絶対パスと mtime で作る派生物。他人の環境では当たらない）
surugo/.measure_cache.json
surugo/.heat_cache/

# v5 の検査の作業場（tools/props_gen.py・ribs_gen.py・manual_v5/ が書く。413 ファイル・172MB）
hardware/_tmp_v5/

# Freerouting の zip（展開した物は hardware/frozen/v6/pcb/freerouting/ にコミットしてある。zip は二重になるので入れない）
#   🔒 ユーザー 2026-09-15: 展開した実行ファイル（141MB）はコミットする。2 か所の PC で clone するだけで route.py が動くように
hardware/frozen/v6/pcb/freerouting.zip
#   上の *.exe・bin/ に掛からないように戻す（実行ファイルと同梱の Java の DLL）
!hardware/frozen/v6/pcb/freerouting/freerouting.exe
!hardware/frozen/v6/pcb/freerouting/runtime/bin/

# MuJoCo の模型の出力（スクリプトと XML は入れる・絵と数表は焼き直せる）
hardware/sim/*/*.gif
hardware/sim/*/*.png
hardware/sim/*/*.npy
hardware/sim/*/*.txt
hardware/sim/m2_sorter/emgi/

# v6 の当たり検査の出力（_v6_gear_chk.py が焼き直す）
hardware/frozen/v6/chk/*.stl
hardware/frozen/v6/chk/*.echo

# 自動配線の実行時に出るログ（2026-09-14）
en/

# 基板の道具が書き出す途中のファイル（Voice PE のネットリストなど）
hardware/pcb/build/
hardware/_tmp_v61n/
hardware/_tmp_v61man/

# KiCad が開いているあいだ置く鍵（~<名>.kicad_pcb.lck など）。
#   閉じると消えるが、落ちると残る。中身は開いている人の名前と PC 名
~*.lck

# KiCad 9 が kicad-cli を呼ぶたびに作る自動スナップショット置き場（中身は空・こちらでは使わない）
.history/

# 掃引検査の作業場（tools/sweep_chk.py が書く OFF と JSON）
hardware/_tmp_sweep/
