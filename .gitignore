node_modules
dist

# ビルド成果物 (simulator/build.bat で再生成できるためコミットしない)
*.o
*.obj
*.exe
bin/

# PlatformIO (実機ファームのビルド成果物・DLしたツールチェーン)
.pio/

# Python
__pycache__/
*.pyc

# シリアルモニタの取りっぱなしログ（読んだ中身は POWER.md / TODO.md へ書き写す）
firmware/serial.log

# 使い捨ての検査・試作STL（317ファイル・17MB）
hardware/scratch/
_access_tmp/

# 刷る前の検算で出した使い捨てSTL
hardware/_pf/

# 刷るぞー の測定キャッシュ（絶対パスと mtime で作る派生物。他人の環境では当たらない）
surugo/.measure_cache.json
surugo/.heat_cache/

# v5 の検査の作業場（tools/props_gen.py・ribs_gen.py・manual_v5/ が書く。413 ファイル・172MB）
hardware/_tmp_v5/

# Freerouting は展開しただけの実行ファイル（141MB）。route.py がこの場所を読む
hardware/frozen/v6/pcb/freerouting/
hardware/frozen/v6/pcb/freerouting.zip

# MuJoCo の模型の出力（スクリプトと XML は入れる・絵と数表は焼き直せる）
hardware/sim/*/*.gif
hardware/sim/*/*.png
hardware/sim/*/*.npy
hardware/sim/*/*.txt
hardware/sim/m2_sorter/emgi/

# v6 の当たり検査の出力（_v6_gear_chk.py が焼き直す）
hardware/frozen/v6/chk/*.stl
hardware/frozen/v6/chk/*.echo

# 自動配線の実行時に出るログ（2026-09-14）
en/
